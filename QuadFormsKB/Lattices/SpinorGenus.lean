/-
# The spinor genus of a lattice over $\mathcal O_F$

**Layer:** lattices in $(V, Q) = (F^n, Q)$ over a number field $F$, with the action of $O(V)(\mathbb A_f)$
(`Lattices/ClassSet.lean`) and the spinor kernels (`Lattices/SpinorKernel.lean`).

**Defines**
* `spnGroup Q` $= O(V)\,O'(V_{\mathbb A_f}) \le O(V)(\mathbb A_f)$ (a subgroup since $O'(V_{\mathbb A_f})$ is normal);
* `latSpinorGenus Q L` $= \mathrm{spn}(L) = \{\sigma\,\Sigma L : \sigma \in O(V),\ \Sigma \in O'(V_{\mathbb A_f})\}$
  (O'Meara 1963, §102A, p. 298; the AWS notes' abstract `AWS.spinorGenus` with $\Gamma = O(V)$,
  $\kappa = O'(V_{\mathbb A_f})$);
* `SameSpinorGenus Q L M`: $M \in \mathrm{spn}(L)$.

**Proves**
* `sameSpinorGenus_iff`: $\mathrm{spn}(L) = O(V)\,O'(V_{\mathbb A_f})\cdot L$, so `SameSpinorGenus` is an
  equivalence relation;
* `class_subset_latSpinorGenus`, `latSpinorGenus_subset_genus`: $\mathrm{cls}(L) \subseteq \mathrm{spn}(L) \subseteq
  \mathrm{gen}(L)$ (O'Meara §102A, p. 298);
* `dosetEquivSpinorGenera`: the spinor genera in $\mathrm{gen}(L)$ are in bijection with the double cosets
  $O(V)O'(V_{\mathbb A_f})\backslash O(V)(\mathbb A_f)/O(\hat L)$.

*Convention.* The repo's genus and class use the full $O(V)$ (improper isometries allowed), so this is O'Meara's
spinor genus $\mathrm{spn}(L)$, not the proper spinor genus $\mathrm{spn}^+(L)$ (which uses $O^+(V)$).
-/
import QuadFormsKB.Lattices.SpinorKernel

open NumberField IsDedekindDomain

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.Lattices

variable {F : Type*} [Field F] [NumberField F] {n : ℕ} (Q : QuadForm F n)

instance spinorKernelAf_isNormal : (spinorKernelAf Q).Normal := spinorKernelAf_normal Q

/-- **$O(V)\,O'(V_{\mathbb A_f})$**, the subgroup of $O(V)(\mathbb A_f)$ generated by the rational points and the adelic
spinor kernel; it equals the product set (`mem_spnGroup`). -/
@[kb "omeara1963" "§102B, proof of 102:7, step 1, pp. 300–301"]
def spnGroup : Subgroup (OAf Q) := ratPoints Q ⊔ spinorKernelAf Q

theorem mem_spnGroup {g : OAf Q} :
    g ∈ spnGroup Q ↔ ∃ γ : orthGroup Q F, ∃ k ∈ spinorKernelAf Q, g = diagF Q γ * k := by
  rw [← SetLike.mem_coe, spnGroup, Subgroup.mul_normal]
  constructor
  · rintro ⟨_, ⟨γ, rfl⟩, k, hk, rfl⟩
    exact ⟨γ, k, hk, rfl⟩
  · rintro ⟨γ, k, hk, rfl⟩
    exact ⟨_, ⟨γ, rfl⟩, k, hk, rfl⟩

theorem ratPoints_le_spnGroup : ratPoints Q ≤ spnGroup Q := le_sup_left

theorem spinorKernelAf_le_spnGroup : spinorKernelAf Q ≤ spnGroup Q := le_sup_right

/-- **The spinor genus** $\mathrm{spn}(L) = \{\sigma\,\Sigma L : \sigma \in O(V),\ \Sigma \in O'(V_{\mathbb A_f})\}$
(O'Meara 1963, §102A, p. 298): the abstract `AWS.spinorGenus` (AWS notes §3.5, p. 53) with $\Gamma = O(V)$ and
$\kappa = O'(V_{\mathbb A_f})$ acting on lattices. -/
@[kb "omeara1963" "§102A, p. 298 (spn L)"]
def latSpinorGenus (L : Lat F n) : Set (Lat F n) :=
  @AWS.spinorGenus (OAf Q) (Lat F n) _ (latAction Q) (ratPoints Q) (spinorKernelAf Q) L

/-- **Same spinor genus:** $M \in \mathrm{spn}(L)$. -/
@[kb "omeara1963" "§102A, p. 298"]
def SameSpinorGenus (L M : Lat F n) : Prop := M ∈ latSpinorGenus Q L

@[kb "omeara1963" "§102A, p. 298 (spinor genus through split rotations)"]
theorem mem_latSpinorGenus {L M : Lat F n} :
    M ∈ latSpinorGenus Q L ↔
      ∃ γ : orthGroup Q F, ∃ k ∈ spinorKernelAf Q, M = latSMul Q (diagF Q γ) (latSMul Q k L) := by
  constructor
  · rintro ⟨_, ⟨γ, rfl⟩, k, hk, rfl⟩
    exact ⟨γ, k, hk, rfl⟩
  · rintro ⟨γ, k, hk, rfl⟩
    exact ⟨_, ⟨γ, rfl⟩, k, hk, rfl⟩

/-- **$\mathrm{spn}(L) = O(V)\,O'(V_{\mathbb A_f}) \cdot L$:** $M$ is in the spinor genus of $L$ iff $M = gL$ for some
$g$ in the subgroup `spnGroup Q`. -/
@[kb "omeara1963" "§102A, p. 298 (spinor genus through split rotations)"]
theorem sameSpinorGenus_iff {L M : Lat F n} :
    SameSpinorGenus Q L M ↔ ∃ g ∈ spnGroup Q, latSMul Q g L = M := by
  let _ : MulAction (OAf Q) (Lat F n) := latAction Q
  rw [SameSpinorGenus, mem_latSpinorGenus]
  constructor
  · rintro ⟨γ, k, hk, rfl⟩
    exact ⟨diagF Q γ * k, (mem_spnGroup Q).mpr ⟨γ, k, hk, rfl⟩, mul_smul (diagF Q γ) k L⟩
  · rintro ⟨g, hg, rfl⟩
    obtain ⟨γ, k, hk, rfl⟩ := (mem_spnGroup Q).mp hg
    exact ⟨γ, k, hk, mul_smul (diagF Q γ) k L⟩

@[kb "omeara1963" "§102A, p. 298 (partition into spinor genera); cassels1978 Ch. 11, Lemma 1.4, p. 200"]
theorem SameSpinorGenus.refl (L : Lat F n) : SameSpinorGenus Q L L :=
  (sameSpinorGenus_iff Q).mpr ⟨1, (spnGroup Q).one_mem, (latAction Q).one_smul L⟩

@[kb "omeara1963" "§102A, p. 298 (partition into spinor genera); cassels1978 Ch. 11, Lemma 1.4, p. 200"]
theorem SameSpinorGenus.symm {L M : Lat F n} (h : SameSpinorGenus Q L M) : SameSpinorGenus Q M L := by
  let _ : MulAction (OAf Q) (Lat F n) := latAction Q
  obtain ⟨g, hg, rfl⟩ := (sameSpinorGenus_iff Q).mp h
  exact (sameSpinorGenus_iff Q).mpr ⟨g⁻¹, (spnGroup Q).inv_mem hg, inv_smul_smul g L⟩

@[kb "omeara1963" "§102A, p. 298 (partition into spinor genera); cassels1978 Ch. 11, Lemma 1.4, p. 200"]
theorem SameSpinorGenus.trans {L M N : Lat F n} (h : SameSpinorGenus Q L M) (h' : SameSpinorGenus Q M N) :
    SameSpinorGenus Q L N := by
  let _ : MulAction (OAf Q) (Lat F n) := latAction Q
  obtain ⟨g, hg, rfl⟩ := (sameSpinorGenus_iff Q).mp h
  obtain ⟨g', hg', rfl⟩ := (sameSpinorGenus_iff Q).mp h'
  exact (sameSpinorGenus_iff Q).mpr ⟨g' * g, (spnGroup Q).mul_mem hg' hg, mul_smul g' g L⟩

/-- **The class lies in the spinor genus:** isometric lattices are in the same spinor genus
(O'Meara 1963, §102A, p. 298). -/
@[kb "omeara1963" "§102A, p. 298 (cls L ⊆ spn L)"]
theorem IsIsometric.sameSpinorGenus {L M : Lat F n} (h : IsIsometric Q L.1 M.1) : SameSpinorGenus Q L M := by
  obtain ⟨γ, hγ, he⟩ := h
  refine (mem_latSpinorGenus Q).mpr ⟨⟨γ, hγ⟩, 1, (spinorKernelAf Q).one_mem, ?_⟩
  apply Lat.ext
  rw [show latSMul Q 1 L = L from (latAction Q).one_smul L, diagF_smul]
  exact he.symm

/-- **The spinor genus lies in the genus** (O'Meara 1963, §102A, p. 298). -/
@[kb "omeara1963" "§102A, p. 298 (spn L ⊆ gen L)"]
theorem SameSpinorGenus.sameGenus {L M : Lat F n} (h : SameSpinorGenus Q L M) : SameGenus Q L.1 M.1 := by
  let _ : MulAction (OAf Q) (Lat F n) := latAction Q
  have hM : M ∈ MulAction.orbit (OAf Q) L :=
    AWS.spinorGenus_subset_genus (ratPoints Q) (spinorKernelAf Q) L h
  rw [orbit_eq_genus] at hM
  exact hM

/-- $\mathrm{cls}(L) \subseteq \mathrm{spn}(L)$, as sets of lattices. -/
@[kb "omeara1963" "§102A, p. 298 (clsL ⊆ spnL ⊆ genL)"]
theorem class_subset_latSpinorGenus (L : Lat F n) :
    {M : Lat F n | IsIsometric Q L.1 M.1} ⊆ latSpinorGenus Q L :=
  fun _ h => IsIsometric.sameSpinorGenus Q h

/-- $\mathrm{spn}(L) \subseteq \mathrm{gen}(L)$, as sets of lattices. -/
@[kb "omeara1963" "§102A, p. 298 (clsL ⊆ spnL ⊆ genL)"]
theorem latSpinorGenus_subset_genus (L : Lat F n) : latSpinorGenus Q L ⊆ latGenus Q L :=
  fun _ h => SameSpinorGenus.sameGenus Q h

/-! ### Spinor genera in a genus as double cosets -/

/-- **The spinor genera in $\mathrm{gen}(L)$ as double cosets:**
$$O(V)O'(V_{\mathbb A_f})\backslash O(V)(\mathbb A_f)/O(\hat L) \;\simeq\; \{\text{spinor genera in } \mathrm{gen}(L)\},$$
where the right side is the set of $O(V)O'(V_{\mathbb A_f})$-orbits on the genus (`sameSpinorGenus_iff`)
(O'Meara 1963, §102B, proof of 102:7, step 2, p. 301; AWS D16 with $\Gamma = O(V)O'_{\mathbb A}$). -/
@[kb "omeara1963" "§102B, proof of 102:7, step 2, p. 301"]
def dosetEquivSpinorGenera (L : Lat F n) :
    DoubleCoset.Quotient (spnGroup Q : Set (OAf Q)) (locStab Q L) ≃
      @AWS.ClassesInGenus (OAf Q) (Lat F n) _ (latAction Q) (spnGroup Q) L := by
  let _ : MulAction (OAf Q) (Lat F n) := latAction Q
  rw [← stabilizer_eq_locStab Q L]
  exact AWS.dosetEquivClasses (spnGroup Q) L

/-- Two lattices of the genus lie in the same `spnGroup`-orbit iff they are in the same spinor genus. -/
theorem spinorRel_iff (L : Lat F n) (M M' : @MulAction.orbit (OAf Q) (Lat F n) (latAction Q).toSMul L) :
    (@AWS.classSetoid (OAf Q) (Lat F n) _ (latAction Q) (spnGroup Q) L) M M' ↔
      SameSpinorGenus Q (M : Lat F n) (M' : Lat F n) := by
  rw [sameSpinorGenus_iff]
  exact Iff.rfl

end QuadFormsKB.Lattices
