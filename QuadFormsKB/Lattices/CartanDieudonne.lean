/-
# Cartan–Dieudonné: $O(V)$ is generated by symmetries

**Layer:** $V = K^n$ with the form $Q$ = `Q : QuadForm F n` over a field $K \supseteq F$ of characteristic $0$
($K = F$, $F_\mathfrak p$, $\mathbb R$, ...), and $O(V)(K)$ = `orthGroup Q K` (`Lattices/Genus.lean`). The bilinear form is
$B(x, y) = x^{\mathsf T}Hy$ (`qbil`), with $B(x, x) = 2Q(x)$.

**Proves** `exists_symmProd_eq`: if $Q$ is nondegenerate, every $\sigma \in O(V)(K)$ is a product
$\tau_{x_1}\cdots\tau_{x_r}$ of symmetries in anisotropic vectors, with $r \le 2n$ (O'Meara 1963, 43:3
[unverified]; the sharp bound $r \le n$ of Cartan–Dieudonné is not needed here).

*Proof* (no restriction to subspaces). Fix a $B$-orthogonal basis $e_0, \dots, e_{n-1}$ of $V$ (anisotropic since $Q$
is nondegenerate). Inductively find symmetries $\rho$ such that $\rho\sigma$ fixes $e_0, \dots, e_{k-1}$: with
$x = e_k$, $y = \rho\sigma x$ we have $Q(x) = Q(y)$ and $x, y \perp e_0, \dots, e_{k-1}$; either $Q(x - y) \ne 0$ and
$\tau_{x-y}$ maps $y \mapsto x$, or $Q(x + y) \ne 0$ (as $Q(x-y) + Q(x+y) = 4Q(x)$) and $\tau_x\tau_{x+y}$ maps
$y \mapsto x$; both fix $e_0, \dots, e_{k-1}$. At $k = n$, $\rho\sigma = 1$.

Mathlib proves the analogous statement for real inner product spaces (`LinearIsometryEquiv.reflections_generate`);
it does not apply to indefinite forms or to other fields, so this file gives the general field version.
-/
import QuadFormsKB.Lattices.SpinorKernel

open Matrix

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.Lattices

variable {F : Type*} [Field F] [NumberField F] {n : ℕ}

variable (Q : QuadForm F n) (K : Type*) [Field K] [Algebra F K] [CharZero K]

/-- The bilinear form $B(x, y) = x^{\mathsf T} H y$ of $Q$ over $K$ ($H$ = `Q.hessian`). -/
def qbil (x y : Fin n → K) : K := x ⬝ᵥ (Q.hessian.map (algebraMap F K) *ᵥ y)

theorem qbil_comm (x y : Fin n → K) : qbil Q K x y = qbil Q K y x := by
  unfold qbil
  rw [dotProduct_mulVec, ← mulVec_transpose, ← Matrix.transpose_map, QuadForm.hessian_transpose, dotProduct_comm]

theorem qbil_self (x : Fin n → K) : qbil Q K x x = 2 * Q.evalIn K x := (two_mul_evalIn Q x).symm

theorem qbil_add_left (x y z : Fin n → K) : qbil Q K (x + y) z = qbil Q K x z + qbil Q K y z := by
  simp [qbil, add_dotProduct]

theorem qbil_sub_left (x y z : Fin n → K) : qbil Q K (x - y) z = qbil Q K x z - qbil Q K y z := by
  simp [qbil, sub_dotProduct]

theorem qbil_add_right (x y z : Fin n → K) : qbil Q K z (x + y) = qbil Q K z x + qbil Q K z y := by
  simp [qbil, mulVec_add, dotProduct_add]

theorem qbil_sub_right (x y z : Fin n → K) : qbil Q K z (x - y) = qbil Q K z x - qbil Q K z y := by
  simp [qbil, mulVec_sub, dotProduct_sub]

theorem qbil_neg_left (x z : Fin n → K) : qbil Q K (-x) z = -qbil Q K x z := by
  simp [qbil]

theorem qbil_smul_left (c : K) (x z : Fin n → K) : qbil Q K (c • x) z = c * qbil Q K x z := by
  simp [qbil]

theorem two_mul_evalIn_eq (x : Fin n → K) : 2 * Q.evalIn K x = qbil Q K x x := (qbil_self Q K x).symm

theorem symm_mulVec_bil {x : Fin n → K} (hx : Q.evalIn K x ≠ 0) (y : Fin n → K) :
    ((symm Q K x : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ y = y - (qbil Q K x y / Q.evalIn K x) • x := by
  rw [symm_mulVec Q K hx, div_eq_inv_mul]; rfl

theorem symm_fix {x y : Fin n → K} (h : qbil Q K x y = 0) :
    ((symm Q K x : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ y = y := by
  by_cases hx : Q.evalIn K x ≠ 0
  · rw [symm_mulVec_bil Q K hx, h, zero_div, zero_smul, sub_zero]
  · have : symm Q K x = 1 := by ext1; simp [symm, symmGL_of_eq_zero Q K (not_not.mp hx)]
    rw [this]; simp

theorem qbil_orth (σ : orthGroup Q K) (x y : Fin n → K) :
    qbil Q K ((σ : GL (Fin n) K).val *ᵥ x) ((σ : GL (Fin n) K).val *ᵥ y) = qbil Q K x y :=
  bilin_orth Q K σ x y

/-- $\tau_{x-y}(y) = x$ when $Q(x) = Q(y)$ and $Q(x - y) \ne 0$. -/
theorem symm_sub_apply {x y : Fin n → K} (hxy : Q.evalIn K x = Q.evalIn K y) (h : Q.evalIn K (x - y) ≠ 0) :
    ((symm Q K (x - y) : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ y = x := by
  rw [symm_mulVec_bil Q K h]
  have h2 : (2 : K) ≠ 0 := two_ne_zero
  have hQ : Q.evalIn K (x - y) = -qbil Q K (x - y) y := by
    apply mul_left_cancel₀ h2
    have hb : qbil Q K x x = qbil Q K y y := by rw [qbil_self, qbil_self, hxy]
    rw [two_mul_evalIn_eq]
    simp only [qbil_sub_left, qbil_sub_right]
    rw [qbil_comm Q K y x]
    linear_combination hb
  have hb : qbil Q K (x - y) y ≠ 0 := fun h0 => h (by rw [hQ, h0, neg_zero])
  rw [hQ, div_neg, div_self hb]
  simp

/-- $\tau_{x+y}(y) = -x$ when $Q(x) = Q(y)$ and $Q(x + y) \ne 0$. -/
theorem symm_add_apply {x y : Fin n → K} (hxy : Q.evalIn K x = Q.evalIn K y) (h : Q.evalIn K (x + y) ≠ 0) :
    ((symm Q K (x + y) : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ y = -x := by
  rw [symm_mulVec_bil Q K h]
  have h2 : (2 : K) ≠ 0 := two_ne_zero
  have hQ : Q.evalIn K (x + y) = qbil Q K (x + y) y := by
    apply mul_left_cancel₀ h2
    have hb : qbil Q K x x = qbil Q K y y := by rw [qbil_self, qbil_self, hxy]
    rw [two_mul_evalIn_eq]
    simp only [qbil_add_left, qbil_add_right]
    rw [qbil_comm Q K y x]
    linear_combination hb
  have hb : qbil Q K (x + y) y ≠ 0 := fun h0 => h (by rw [hQ, h0])
  rw [← hQ, div_self h, one_smul]
  abel

/-- $\tau_x(-x) = x$. -/
theorem symm_neg_self {x : Fin n → K} (hx : Q.evalIn K x ≠ 0) :
    ((symm Q K x : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ (-x) = x := by
  rw [symm_mulVec_bil Q K hx]
  have : qbil Q K x (-x) = -2 * Q.evalIn K x := by
    rw [qbil_comm, qbil_neg_left, ← two_mul_evalIn_eq]; ring
  rw [this, mul_div_assoc, div_self hx]
  rw [show (-x - (-2 * 1 : K) • x) = x by rw [sub_eq_add_neg, ← neg_smul]; simp; module]

/-- $Q(x - y) + Q(x + y) = 4Q(x)$ when $Q(x) = Q(y)$. -/
theorem evalIn_sub_add_evalIn_add {x y : Fin n → K} (hxy : Q.evalIn K x = Q.evalIn K y) :
    Q.evalIn K (x - y) + Q.evalIn K (x + y) = 4 * Q.evalIn K x := by
  have h2 : (2 : K) ≠ 0 := two_ne_zero
  apply mul_left_cancel₀ h2
  have hb : qbil Q K x x = 2 * Q.evalIn K x := qbil_self Q K x
  have hb' : qbil Q K y y = 2 * Q.evalIn K y := qbil_self Q K y
  rw [mul_add, two_mul_evalIn_eq, two_mul_evalIn_eq]
  simp only [qbil_sub_left, qbil_sub_right, qbil_add_left, qbil_add_right]
  rw [qbil_comm Q K y x]
  linear_combination 2 * hb + 2 * hb' - 4 * hxy

/-- The bilinear form as a Mathlib `BilinForm` (via `Matrix.toBilin'`). -/
def bilForm : LinearMap.BilinForm K (Fin n → K) := Matrix.toBilin' (Q.hessian.map (algebraMap F K))

theorem bilForm_apply (x y : Fin n → K) : bilForm Q K x y = qbil Q K x y := by
  rw [bilForm, Matrix.toBilin'_apply']; rfl

/-- **An orthogonal basis of anisotropic vectors** for a nondegenerate $Q$ over $K$. -/
theorem exists_orthogonal_basis (hQ : Q.Nondegenerate) :
    ∃ e : Module.Basis (Fin n) K (Fin n → K),
      (∀ i j, i ≠ j → qbil Q K (e i) (e j) = 0) ∧ ∀ i, Q.evalIn K (e i) ≠ 0 := by
  have : Invertible (2 : K) := invertibleOfNonzero two_ne_zero
  have hsymm : LinearMap.IsSymm (bilForm Q K) :=
    ⟨fun x y => by simp only [RingHom.id_apply, bilForm_apply]; exact qbil_comm Q K x y⟩
  obtain ⟨v, hv⟩ := LinearMap.BilinForm.exists_orthogonal_basis hsymm
  have hdet : (Q.hessian.map (algebraMap F K)).det ≠ 0 := by
    rw [← RingHom.mapMatrix_apply, ← RingHom.map_det]; exact (map_ne_zero _).mpr hQ
  have hnd : (bilForm Q K).Nondegenerate :=
    (LinearMap.BilinForm.nondegenerate_toBilin'_iff_det_ne_zero).mpr hdet
  have hfr : Module.finrank K (Fin n → K) = n := Module.finrank_fin_fun K
  let e := v.reindex (finCongr hfr)
  refine ⟨e, fun i j hij => ?_, fun i => ?_⟩
  · have := hv (i := (finCongr hfr).symm i) (j := (finCongr hfr).symm j) (by simpa using hij)
    rw [← bilForm_apply]
    simpa [e] using this
  · have h := LinearMap.BilinForm.iIsOrtho.not_isOrtho_basis_self_of_nondegenerate hv hnd ((finCongr hfr).symm i)
    intro h0
    apply h
    rw [bilForm_apply]
    have : v ((finCongr hfr).symm i) = e i := by simp [e]
    rw [this, qbil_self, h0, mul_zero]

/-- A matrix fixing every vector of a basis is the identity. -/
theorem eq_one_of_fix_basis {M : Matrix (Fin n) (Fin n) K} (e : Module.Basis (Fin n) K (Fin n → K))
    (h : ∀ i, M *ᵥ e i = e i) : M = 1 := by
  have : Matrix.toLin' M = LinearMap.id := e.ext fun i => by rw [Matrix.toLin'_apply, h]; rfl
  rw [← Matrix.toLin'_one] at this
  exact Matrix.toLin'.injective this

theorem symmProd_mulVec_cons (x : Fin n → K) (xs : List (Fin n → K)) (y : Fin n → K) :
    ((symmProd Q K (x :: xs) : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ y =
      ((symm Q K x : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ
        (((symmProd Q K xs : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ y) := by
  simp [symmProd, mulVec_mulVec]

/-- **Cartan–Dieudonné (generation form):** for nondegenerate $Q$, every $\sigma \in O(V)(K)$ is a product
$\tau_{x_1}\cdots\tau_{x_r}$ of symmetries in anisotropic vectors (O'Meara 1963, 43:3 [unverified]). -/
@[kb "omeara1963" "43:3 (Cartan–Dieudonné) [unverified]"]
theorem exists_symmProd_eq (hQ : Q.Nondegenerate) (σ : orthGroup Q K) :
    ∃ xs : List (Fin n → K), (∀ x ∈ xs, Q.evalIn K x ≠ 0) ∧ symmProd Q K xs = σ := by
  obtain ⟨e, he, hea⟩ := exists_orthogonal_basis Q K hQ
  -- `M ρ` is the matrix of `ρ`.
  let M : orthGroup Q K → Matrix (Fin n) (Fin n) K := fun ρ => (ρ : GL (Fin n) K).val
  have key : ∀ k ≤ n, ∃ xs : List (Fin n → K), (∀ x ∈ xs, Q.evalIn K x ≠ 0) ∧
      ∀ i : Fin n, i.val < k → M (symmProd Q K xs * σ) *ᵥ e i = e i := by
    intro k
    induction k with
    | zero => intro _; exact ⟨[], by simp, fun i hi => absurd hi (Nat.not_lt_zero _)⟩
    | succ k ih =>
      intro hk
      obtain ⟨xs, hxs, hfix⟩ := ih (Nat.le_of_succ_le hk)
      set ρ := symmProd Q K xs * σ
      set x := e ⟨k, hk⟩
      set y := M ρ *ᵥ x
      have hxy : Q.evalIn K x = Q.evalIn K y := (evalIn_mulVec_of_mem Q ρ.2 x).symm
      have hx : Q.evalIn K x ≠ 0 := hea _
      have hxi : ∀ i : Fin n, i.val < k → qbil Q K x (e i) = 0 := fun i hi =>
        he _ _ (fun h => by rw [← h] at hi; exact lt_irrefl _ hi)
      have hyi : ∀ i : Fin n, i.val < k → qbil Q K y (e i) = 0 := fun i hi => by
        rw [← hfix i hi]; exact (qbil_orth Q K ρ x (e i)).trans (hxi i hi)
      have hMρ : ∀ (zs : List (Fin n → K)) (w : Fin n → K),
          M (symmProd Q K zs * ρ) *ᵥ w = M (symmProd Q K zs) *ᵥ (M ρ *ᵥ w) := fun zs w => by
        simp [M, mulVec_mulVec]
      by_cases hd : Q.evalIn K (x - y) ≠ 0
      · refine ⟨(x - y) :: xs, ?_, fun i hi => ?_⟩
        · intro z hz
          rcases List.mem_cons.mp hz with rfl | hz
          exacts [hd, hxs z hz]
        · have e1 : symmProd Q K ((x - y) :: xs) * σ = symmProd Q K [x - y] * ρ := by
            simp [ρ, symmProd, mul_assoc]
          rw [e1, hMρ]
          simp only [symmProd, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one]
          rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hi | hi
          · rw [hfix i hi]
            exact symm_fix Q K (by rw [qbil_sub_left, hxi i hi, hyi i hi, sub_zero])
          · have : i = ⟨k, hk⟩ := Fin.ext hi
            rw [this]
            exact symm_sub_apply Q K hxy hd
      · have hs : Q.evalIn K (x + y) ≠ 0 := by
          intro h0
          have := evalIn_sub_add_evalIn_add Q K hxy
          rw [not_not.mp hd, h0, add_zero] at this
          exact hx (by
            have h4 : (4 : K) ≠ 0 := by norm_num
            exact (mul_eq_zero.mp this.symm).resolve_left h4)
        refine ⟨x :: (x + y) :: xs, ?_, fun i hi => ?_⟩
        · intro z hz
          rcases List.mem_cons.mp hz with rfl | hz
          · exact hx
          rcases List.mem_cons.mp hz with rfl | hz
          exacts [hs, hxs z hz]
        · have e1 : symmProd Q K (x :: (x + y) :: xs) * σ = symmProd Q K [x, x + y] * ρ := by
            simp [ρ, symmProd, mul_assoc]
          rw [e1, hMρ]
          simp only [symmProd, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one]
          change (M (symm Q K x) * M (symm Q K (x + y))) *ᵥ _ = _
          rw [← mulVec_mulVec]
          rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hi | hi
          · have h1 : qbil Q K (x + y) (e i) = 0 := by rw [qbil_add_left, hxi i hi, hyi i hi, add_zero]
            rw [hfix i hi]
            change M (symm Q K x) *ᵥ (M (symm Q K (x + y)) *ᵥ e i) = e i
            rw [symm_fix Q K h1]
            exact symm_fix Q K (hxi i hi)
          · have : i = ⟨k, hk⟩ := Fin.ext hi
            rw [this]
            change M (symm Q K x) *ᵥ (M (symm Q K (x + y)) *ᵥ y) = x
            rw [symm_add_apply Q K hxy hs]
            exact symm_neg_self Q K hx
  obtain ⟨xs, hxs, hfix⟩ := key n le_rfl
  have h1 : symmProd Q K xs * σ = 1 := by
    ext1; ext1
    exact eq_one_of_fix_basis K e fun i => hfix i i.2
  refine ⟨xs.reverse, fun x hx => hxs x (List.mem_reverse.mp hx), ?_⟩
  rw [symmProd_reverse]
  exact (eq_inv_of_mul_eq_one_right h1).symm

end QuadFormsKB.Lattices
