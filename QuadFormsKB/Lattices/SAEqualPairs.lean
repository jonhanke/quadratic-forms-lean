/-
# Equal-value pairs generate $O'(V)$ when $V$ contains a hyperbolic plane

**Layer:** $V = K^n$ with $Q$ = `Q : QuadForm F n` over a field $K \supseteq F$ of characteristic $0$, its symmetries
$\tau_x$ and spinor kernel $O'(V)(K)$ (`Lattices/SpinorKernel.lean`), the bilinear form $B$ = `qbil Q K`.

**Defines** the set `eqPairSet Q K` of **equal-value pairs** $\tau_u\tau_w$ with $Q(u) = Q(w) \ne 0$ (O'Meara's "short
commutators" $\tau_u\tau_v\tau_u\tau_v = \tau_u\tau_{\tau_v u}$) and the subgroup `eqPairGroup Q K` they generate.

**Proves**
* `eqPairGroup_le_spinorKernel`, `eqPairGroup_normal`: the group is a normal subgroup of $O'(V)$;
* `spinorKernel_le_eqPairGroup`: **if $V$ contains a hyperbolic pair** $e, f$ ($Q(e) = Q(f) = 0$, $B(e, f) = 1$), every
  element of $O'(V)$ is a product of equal-value pairs;
* `exists_hyperbolic_pair`: a nondegenerate isotropic $V$ contains a hyperbolic pair; hence
  `spinorKernel_eq_eqPairGroup` for isotropic $V$.

This is the local input of step 1c of O'Meara's proof of the strong approximation theorem for rotations (O'Meara
1973, 104:4, p. 316: "$O'_n(V_\mathfrak p) = \Omega_n(V_\mathfrak p)$" for isotropic $V_\mathfrak p$, via 55:? and 43:6 [unverified]).
*Simplification:* with $O'(V)$ defined by spinor words (`spinorKernel`), the proof is a direct computation in a
hyperbolic plane $H = Ke + Kf$: with $h_c = e + cf$ ($Q(h_c) = c$), $\tau_{h_a}\tau_{h_b}$ depends only on $b/a$
(`symm_hvec_mul_symm_hvec`), $R(t) = \tau_{h_1}\tau_{h_t}$ is multiplicative, $R(s^2)$ is an equal-value pair, and
$\tau_x\tau_y = (\tau_x\tau_{h_a})\,R(b/a)\,(\tau_{h_b}\tau_y)$ for $a = Q(x)$, $b = Q(y)$. No commutator subgroup or
Witt index theory is needed.
-/
import QuadFormsKB.Lattices.SpinorNorm

open Matrix

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.Lattices

variable {F : Type*} [Field F] [NumberField F] {n : ℕ}

variable (Q : QuadForm F n) (K : Type*) [Field K] [Algebra F K] [CharZero K]

/-! ### Equal-value pairs -/

/-- **Equal-value pairs** $\tau_u\tau_w$ with $Q(u) = Q(w) \ne 0$. -/
def eqPairSet : Set (orthGroup Q K) :=
  {g | ∃ u w : Fin n → K, Q.evalIn K u ≠ 0 ∧ Q.evalIn K u = Q.evalIn K w ∧ g = symm Q K u * symm Q K w}

/-- **The group generated by equal-value pairs.** -/
def eqPairGroup : Subgroup (orthGroup Q K) := Subgroup.closure (eqPairSet Q K)

theorem pair_mem_eqPairSet {u w : Fin n → K} (hu : Q.evalIn K u ≠ 0) (huw : Q.evalIn K u = Q.evalIn K w) :
    symm Q K u * symm Q K w ∈ eqPairSet Q K := ⟨u, w, hu, huw, rfl⟩

theorem pair_mem_eqPairGroup {u w : Fin n → K} (hu : Q.evalIn K u ≠ 0) (huw : Q.evalIn K u = Q.evalIn K w) :
    symm Q K u * symm Q K w ∈ eqPairGroup Q K :=
  Subgroup.subset_closure (pair_mem_eqPairSet Q K hu huw)

theorem eqPairSet_subset_spinorKernel : eqPairSet Q K ⊆ spinorKernel Q K := by
  rintro _ ⟨u, w, hu, huw, rfl⟩
  refine ⟨[u, w], ⟨?_, by simp, ?_⟩, by simp [symmProd]⟩
  · intro x hx
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl
    · exact hu
    · rwa [← huw]
  · refine ⟨Q.evalIn K u, ?_⟩
    simp [valProd, huw]

/-- Equal-value pairs lie in $O'(V)$. -/
theorem eqPairGroup_le_spinorKernel : eqPairGroup Q K ≤ spinorKernel Q K :=
  (Subgroup.closure_le _).mpr (eqPairSet_subset_spinorKernel Q K)

theorem conj_mem_eqPairSet (σ : orthGroup Q K) {g : orthGroup Q K} (hg : g ∈ eqPairSet Q K) :
    σ * g * σ⁻¹ ∈ eqPairSet Q K := by
  obtain ⟨u, w, hu, huw, rfl⟩ := hg
  refine ⟨(σ : GL (Fin n) K).val *ᵥ u, (σ : GL (Fin n) K).val *ᵥ w, ?_, ?_, ?_⟩
  · rwa [evalIn_mulVec_of_mem Q σ.2]
  · rw [evalIn_mulVec_of_mem Q σ.2, evalIn_mulVec_of_mem Q σ.2, huw]
  · rw [← symm_conj, ← symm_conj]; group

/-- **The equal-value pairs generate a normal subgroup** ($\sigma\tau_u\tau_w\sigma^{-1} = \tau_{\sigma u}\tau_{\sigma w}$). -/
theorem eqPairGroup_normal : (eqPairGroup Q K).Normal where
  conj_mem g hg σ := by
    induction hg using Subgroup.closure_induction with
    | mem x hx => exact Subgroup.subset_closure (conj_mem_eqPairSet Q K σ hx)
    | one => simp
    | mul x y _ _ hx hy =>
      have : σ * (x * y) * σ⁻¹ = (σ * x * σ⁻¹) * (σ * y * σ⁻¹) := by group
      rw [this]; exact Subgroup.mul_mem _ hx hy
    | inv x _ hx =>
      have : σ * x⁻¹ * σ⁻¹ = (σ * x * σ⁻¹)⁻¹ := by group
      rw [this]; exact Subgroup.inv_mem _ hx

theorem qbil_smul_right (c : K) (x z : Fin n → K) : qbil Q K x (c • z) = c * qbil Q K x z := by
  rw [qbil_comm, qbil_smul_left, qbil_comm]

/-- $Q(cx) = c^2 Q(x)$. -/
theorem evalIn_smul_sq (c : K) (x : Fin n → K) : Q.evalIn K (c • x) = c ^ 2 * Q.evalIn K x := by
  have h2 : (2 : K) ≠ 0 := two_ne_zero
  apply mul_left_cancel₀ h2
  have h1 := two_mul_evalIn_eq Q K (c • x)
  have h' := two_mul_evalIn_eq Q K x
  rw [qbil_smul_left, qbil_smul_right] at h1
  linear_combination h1 - c ^ 2 * h'

/-- $\tau_{cx} = \tau_x$ for $c \ne 0$. -/
theorem symm_smul {c : K} (hc : c ≠ 0) (x : Fin n → K) : symm Q K (c • x) = symm Q K x := by
  have hQ := evalIn_smul_sq Q K c x
  by_cases hx : Q.evalIn K x = 0
  · have h1 : Q.evalIn K (c • x) = 0 := by rw [hQ, hx, mul_zero]
    ext1; simp [symm, symmGL_of_eq_zero Q K hx, symmGL_of_eq_zero Q K h1]
  · have hcx : Q.evalIn K (c • x) ≠ 0 := by rw [hQ]; exact mul_ne_zero (pow_ne_zero 2 hc) hx
    ext1; ext1
    refine Matrix.toLin'.injective (LinearMap.ext fun y => ?_)
    simp only [Matrix.toLin'_apply]
    rw [symm_mulVec_bil Q K hcx, symm_mulVec_bil Q K hx, qbil_smul_left, hQ, smul_smul]
    congr 2
    field_simp

/-! ### A hyperbolic plane -/

/-- **$R(t) = \tau_{e+f}\tau_{e+tf}$**, a rotation of the hyperbolic plane ($e \mapsto te$, $f \mapsto t^{-1}f$). -/
def hrot (e f : Fin n → K) (t : K) : orthGroup Q K := symm Q K (e + (1 : K) • f) * symm Q K (e + t • f)


section Hyperbolic

variable {Q K} {e f : Fin n → K} (he : Q.evalIn K e = 0) (hf : Q.evalIn K f = 0) (hef : qbil Q K e f = 1)

include he hf hef

theorem qbil_e_e : qbil Q K e e = 0 := by rw [qbil_self, he, mul_zero]
theorem qbil_f_f : qbil Q K f f = 0 := by rw [qbil_self, hf, mul_zero]
theorem qbil_f_e : qbil Q K f e = 1 := by rw [qbil_comm, hef]

/-- $Q(e + cf) = c$. -/
theorem evalIn_hvec (c : K) : Q.evalIn K (e + c • f) = c := by
  have h2 : (2 : K) ≠ 0 := two_ne_zero
  apply mul_left_cancel₀ h2
  rw [two_mul_evalIn_eq]
  simp only [qbil_add_left, qbil_add_right, qbil_smul_left, qbil_smul_right, qbil_e_e he hf hef,
    qbil_f_f he hf hef, qbil_f_e he hf hef, hef]
  ring

/-- $\tau_{e + af}\tau_{e + bf}\,y = y + (t - 1)B(f, y)\,e + (t^{-1} - 1)B(e, y)\,f$ with $t = b/a$. -/
theorem symm_hvec_mul_symm_hvec_mulVec {a b : K} (ha : a ≠ 0) (hb : b ≠ 0) (y : Fin n → K) :
    ((symm Q K (e + a • f) * symm Q K (e + b • f) : orthGroup Q K) : GL (Fin n) K).val *ᵥ y =
      y + ((b / a - 1) * qbil Q K f y) • e + ((a / b - 1) * qbil Q K e y) • f := by
  have hQa : Q.evalIn K (e + a • f) ≠ 0 := by rw [evalIn_hvec he hf hef]; exact ha
  have hQb : Q.evalIn K (e + b • f) ≠ 0 := by rw [evalIn_hvec he hf hef]; exact hb
  change ((symm Q K (e + a • f) : GL (Fin n) K).val * (symm Q K (e + b • f) : GL (Fin n) K).val) *ᵥ y = _
  rw [← mulVec_mulVec, symm_mulVec_bil Q K hQb, symm_mulVec_bil Q K hQa, evalIn_hvec he hf hef,
    evalIn_hvec he hf hef]
  have hee := qbil_e_e he hf hef
  have hff := qbil_f_f he hf hef
  have hfe := qbil_f_e he hf hef
  simp only [qbil_add_left, qbil_add_right, qbil_sub_right, qbil_smul_left, qbil_smul_right, hee, hff, hfe,
    hef]
  ext i
  simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
  field_simp
  ring

/-- **$\tau_{e+af}\tau_{e+bf} = R(b/a)$.** -/
theorem symm_hvec_mul_symm_hvec {a b : K} (ha : a ≠ 0) (hb : b ≠ 0) :
    symm Q K (e + a • f) * symm Q K (e + b • f) = hrot Q K e f (b / a) := by
  have hba : b / a ≠ 0 := div_ne_zero hb ha
  ext1; ext1
  refine Matrix.toLin'.injective (LinearMap.ext fun y => ?_)
  simp only [Matrix.toLin'_apply]
  rw [symm_hvec_mul_symm_hvec_mulVec he hf hef ha hb, hrot,
    symm_hvec_mul_symm_hvec_mulVec he hf hef one_ne_zero hba]
  congr 3 <;> field_simp

/-- $R(s)R(t) = R(st)$. -/
theorem hrot_mul {s t : K} (hs : s ≠ 0) (ht : t ≠ 0) :
    hrot Q K e f s * hrot Q K e f t = hrot Q K e f (s * t) := by
  ext1; ext1
  refine Matrix.toLin'.injective (LinearMap.ext fun y => ?_)
  simp only [Matrix.toLin'_apply]
  change ((hrot Q K e f s : GL (Fin n) K).val * (hrot Q K e f t : GL (Fin n) K).val) *ᵥ y = _
  rw [← mulVec_mulVec, hrot, hrot, hrot, symm_hvec_mul_symm_hvec_mulVec he hf hef one_ne_zero ht,
    symm_hvec_mul_symm_hvec_mulVec he hf hef one_ne_zero hs,
    symm_hvec_mul_symm_hvec_mulVec he hf hef one_ne_zero (mul_ne_zero hs ht)]
  have hee := qbil_e_e he hf hef
  have hff := qbil_f_f he hf hef
  have hfe := qbil_f_e he hf hef
  simp only [qbil_add_right, qbil_smul_right, hee, hff, hfe, hef]
  ext i
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
  field_simp
  ring

/-- $R(s^2)$ is an equal-value pair: $\tau_{e+f}\tau_{s^{-1}(e + s^2f)}$ with $Q = 1$ on both. -/
theorem hrot_sq_mem {s : K} (hs : s ≠ 0) : hrot Q K e f (s ^ 2) ∈ eqPairGroup Q K := by
  rw [hrot, ← symm_smul Q K (inv_ne_zero hs) (e + s ^ 2 • f)]
  apply pair_mem_eqPairGroup
  · rw [evalIn_hvec he hf hef]; exact one_ne_zero
  · rw [evalIn_smul_sq, evalIn_hvec he hf hef, evalIn_hvec he hf hef]
    field_simp

/-- **Two symmetries modulo equal-value pairs:** $\tau_x\tau_y = g\,R(Q(y)/Q(x))$ with $g$ a product of equal-value
pairs. -/
theorem symm_mul_symm_eq {x y : Fin n → K} (hx : Q.evalIn K x ≠ 0) (hy : Q.evalIn K y ≠ 0) :
    ∃ g ∈ eqPairGroup Q K, symm Q K x * symm Q K y = g * hrot Q K e f (Q.evalIn K y / Q.evalIn K x) := by
  set a := Q.evalIn K x
  set b := Q.evalIn K y
  have p1 : symm Q K x * symm Q K (e + a • f) ∈ eqPairGroup Q K :=
    pair_mem_eqPairGroup Q K hx (evalIn_hvec he hf hef a).symm
  have p2 : symm Q K (e + b • f) * symm Q K y ∈ eqPairGroup Q K := by
    apply pair_mem_eqPairGroup Q K
    · rw [evalIn_hvec he hf hef]; exact hy
    · rw [evalIn_hvec he hf hef]
  set R := hrot Q K e f (b / a)
  refine ⟨(symm Q K x * symm Q K (e + a • f)) * (R * (symm Q K (e + b • f) * symm Q K y) * R⁻¹), ?_, ?_⟩
  · exact Subgroup.mul_mem _ p1 ((eqPairGroup_normal Q K).conj_mem _ p2 R)
  · have hm : symm Q K (e + a • f) * symm Q K (e + b • f) = R := symm_hvec_mul_symm_hvec he hf hef hx hy
    have hinv : symm Q K (e + a • f) * symm Q K (e + a • f) = 1 := symm_mul_self Q K _
    have hinv' : symm Q K (e + b • f) * symm Q K (e + b • f) = 1 := symm_mul_self Q K _
    calc symm Q K x * symm Q K y
        = symm Q K x * (symm Q K (e + a • f) * symm Q K (e + a • f)) *
            (symm Q K (e + b • f) * symm Q K (e + b • f)) * symm Q K y := by rw [hinv, hinv']; group
      _ = (symm Q K x * symm Q K (e + a • f)) * (symm Q K (e + a • f) * symm Q K (e + b • f)) *
            (symm Q K (e + b • f) * symm Q K y) := by group
      _ = _ := by rw [hm]; group

/-- Words of even length: $\tau_{x_1}\cdots\tau_{x_{2r}} = g\,R(c)$ with $g$ a product of equal-value pairs and
$c\,Q(x_1)\cdots Q(x_{2r})$ a square. -/
theorem symmProd_eq_mul_hrot : ∀ (xs : List (Fin n → K)), (∀ x ∈ xs, Q.evalIn K x ≠ 0) → Even xs.length →
    ∃ g ∈ eqPairGroup Q K, ∃ c : K, c ≠ 0 ∧ IsSquare (c * valProd Q K xs) ∧
      symmProd Q K xs = g * hrot Q K e f c
  | [], _, _ => ⟨1, Subgroup.one_mem _, 1, one_ne_zero, ⟨1, by simp [valProd]⟩, by
      rw [one_mul, hrot, one_smul, symm_mul_self]; rfl⟩
  | [_], _, h => by simp at h
  | x :: y :: rest, hxs, h => by
    have hx : Q.evalIn K x ≠ 0 := hxs x (by simp)
    have hy : Q.evalIn K y ≠ 0 := hxs y (by simp)
    have hrest : ∀ z ∈ rest, Q.evalIn K z ≠ 0 := fun z hz => hxs z (by simp [hz])
    have hlen : Even rest.length := by
      simp only [List.length_cons] at h
      rwa [show rest.length + 1 + 1 = rest.length + 2 by ring, Nat.even_add, iff_true_intro even_two,
        iff_true] at h
    obtain ⟨g₂, hg₂, c₂, hc₂, ⟨s, hs⟩, hrest_eq⟩ := symmProd_eq_mul_hrot rest hrest hlen
    obtain ⟨g₁, hg₁, h₁⟩ := symm_mul_symm_eq he hf hef hx hy
    set c₁ := Q.evalIn K y / Q.evalIn K x
    have hc₁ : c₁ ≠ 0 := div_ne_zero hy hx
    refine ⟨g₁ * (hrot Q K e f c₁ * g₂ * (hrot Q K e f c₁)⁻¹),
      Subgroup.mul_mem _ hg₁ ((eqPairGroup_normal Q K).conj_mem _ hg₂ _), c₁ * c₂, mul_ne_zero hc₁ hc₂,
      ⟨Q.evalIn K y * s, ?_⟩, ?_⟩
    · have hv : valProd Q K (x :: y :: rest) = Q.evalIn K x * Q.evalIn K y * valProd Q K rest := by
        simp [valProd, mul_assoc]
      rw [hv]
      have : c₁ * c₂ * (Q.evalIn K x * Q.evalIn K y * valProd Q K rest) =
          Q.evalIn K y * Q.evalIn K y * (c₂ * valProd Q K rest) := by
        simp only [c₁]; field_simp
      rw [this, hs]; ring
    · have hsp : symmProd Q K (x :: y :: rest) = symm Q K x * symm Q K y * symmProd Q K rest := by
        simp [symmProd, mul_assoc]
      rw [hsp, h₁, hrest_eq, ← hrot_mul he hf hef hc₁ hc₂]
      group

/-- **If $V_K$ contains a hyperbolic pair, $O'(V_K)$ is generated by equal-value pairs.** -/
theorem spinorKernel_le_eqPairGroup : spinorKernel Q K ≤ eqPairGroup Q K := by
  rintro _ ⟨xs, ⟨hxa, hxe, hsq⟩, rfl⟩
  obtain ⟨g, hg, c, hc, hcs, heq⟩ := symmProd_eq_mul_hrot he hf hef xs hxa hxe
  rw [heq]
  refine Subgroup.mul_mem _ hg ?_
  -- `c` is a square
  obtain ⟨r, hr⟩ := hcs
  obtain ⟨q, hq⟩ := hsq
  have hV : valProd Q K xs ≠ 0 := valProd_ne_zero Q K hxa
  have hq0 : q ≠ 0 := by rintro rfl; exact hV (by rw [hq, mul_zero])
  have hcsq : c = (r / q) ^ 2 := by
    field_simp
    linear_combination hr - c * hq
  rw [hcsq]
  exact hrot_sq_mem he hf hef (by rintro h; rw [h] at hcsq; simp at hcsq; exact hc hcsq)

end Hyperbolic

/-- **A nondegenerate isotropic space contains a hyperbolic pair.** -/
theorem exists_hyperbolic_pair (hQ : Q.Nondegenerate) (hiso : Q.IsotropicIn K) :
    ∃ e f : Fin n → K, Q.evalIn K e = 0 ∧ Q.evalIn K f = 0 ∧ qbil Q K e f = 1 := by
  obtain ⟨x, hx0, hx⟩ := hiso
  have hdet : (Q.hessian.map (algebraMap F K)).det ≠ 0 := by
    have : (Q.hessian.map (algebraMap F K)).det = algebraMap F K Q.hessian.det := by
      rw [RingHom.map_det]; rfl
    rw [this]; exact (map_ne_zero _).mpr hQ
  have hHx : Q.hessian.map (algebraMap F K) *ᵥ x ≠ 0 := by
    intro h
    exact hx0 (Matrix.eq_zero_of_mulVec_eq_zero hdet h)
  -- some `y` with `B(x, y) ≠ 0`
  obtain ⟨y, hy⟩ : ∃ y : Fin n → K, qbil Q K x y ≠ 0 := by
    by_contra hall
    push Not at hall
    apply hHx
    funext i
    have := hall (Pi.single i 1)
    rw [qbil_comm, qbil, single_dotProduct, one_mul] at this
    exact this
  set b := qbil Q K x y
  refine ⟨x, b⁻¹ • y - (Q.evalIn K y / b ^ 2) • x, hx, ?_, ?_⟩
  · have h2 : (2 : K) ≠ 0 := two_ne_zero
    apply mul_left_cancel₀ h2
    rw [two_mul_evalIn_eq]
    simp only [qbil_sub_left, qbil_sub_right, qbil_smul_left]
    have hr : ∀ (c : K) (u z : Fin n → K), qbil Q K u (c • z) = c * qbil Q K u z := fun c u z => by
      rw [qbil_comm, qbil_smul_left, qbil_comm]
    simp only [hr, qbil_self, hx, qbil_comm Q K y x]
    field_simp
    ring
  · have hr : ∀ (c : K) (u z : Fin n → K), qbil Q K u (c • z) = c * qbil Q K u z := fun c u z => by
      rw [qbil_comm, qbil_smul_left, qbil_comm]
    simp only [qbil_sub_right, hr, qbil_self, hx]
    field_simp
    ring

/-- **For isotropic $V_K$ ($Q$ nondegenerate), $O'(V_K)$ is the group generated by equal-value pairs.** -/
theorem spinorKernel_eq_eqPairGroup (hQ : Q.Nondegenerate) (hiso : Q.IsotropicIn K) :
    spinorKernel Q K = eqPairGroup Q K := by
  obtain ⟨e, f, he, hf, hef⟩ := exists_hyperbolic_pair Q K hQ hiso
  exact le_antisymm (spinorKernel_le_eqPairGroup he hf hef) (eqPairGroup_le_spinorKernel Q K)

/-! ### Equal-value pairs and the commutator subgroup $\Omega(V)$ -/

section Commutator

variable {Q}

theorem symm_neg_eq (K : Type*) [Field K] [Algebra F K] [CharZero K] (w : Fin n → K) :
    symm Q K (-w) = symm Q K w := by
  rw [show -w = (-1 : K) • w by simp]
  exact symm_smul Q K (by norm_num) w

/-- For $Q(u) = Q(w) \ne 0$ there is an anisotropic $c$ with $\tau_c u = \pm w$ ($c = w - u$ or $w + u$). -/
theorem exists_symm_apply_eq {K : Type*} [Field K] [Algebra F K] [CharZero K] {u w : Fin n → K}
    (hu : Q.evalIn K u ≠ 0) (huw : Q.evalIn K u = Q.evalIn K w) :
    ∃ c w' : Fin n → K, Q.evalIn K c ≠ 0 ∧ symm Q K w' = symm Q K w ∧ Q.evalIn K w' = Q.evalIn K w ∧
      ((symm Q K c : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ u = w' := by
  by_cases h : Q.evalIn K (w - u) ≠ 0
  · exact ⟨w - u, w, h, rfl, rfl, symm_sub_apply Q K huw.symm h⟩
  · have h4 := evalIn_sub_add_evalIn_add Q K huw.symm
    have h' : Q.evalIn K (w + u) ≠ 0 := by
      intro h0
      rw [not_not.mp h, h0, add_zero, ← huw] at h4
      have : (4 : K) ≠ 0 := by norm_num
      exact hu ((mul_eq_zero.mp h4.symm).resolve_left this)
    refine ⟨w + u, -w, h', symm_neg_eq K w, ?_, symm_add_apply Q K huw.symm h'⟩
    rw [show -w = (-1 : K) • w by simp, evalIn_smul_sq]; ring


/-- **Every equal-value pair is a commutator of two symmetries:** $\tau_u\tau_w = [\tau_u, \tau_c]$ where $\tau_c u = \pm w$. -/
theorem pair_eq_commutator {K : Type*} [Field K] [Algebra F K] [CharZero K] {u w : Fin n → K}
    (hu : Q.evalIn K u ≠ 0) (huw : Q.evalIn K u = Q.evalIn K w) :
    ∃ c : Fin n → K, symm Q K u * symm Q K w =
      symm Q K u * symm Q K c * (symm Q K u)⁻¹ * (symm Q K c)⁻¹ := by
  obtain ⟨c, w', hc, hw'symm, -, hcu⟩ := exists_symm_apply_eq (Q := Q) hu huw
  refine ⟨c, ?_⟩
  rw [symm_inv, symm_inv]
  have h := symm_conj Q K (symm Q K c) u
  rw [symm_inv, hcu, hw'symm] at h
  rw [mul_assoc, mul_assoc, ← mul_assoc (symm Q K c), h]

/-- **Equal-value pairs lie in the commutator subgroup** $\Omega(V) = [O(V), O(V)]$. -/
theorem eqPairGroup_le_commutator (K : Type*) [Field K] [Algebra F K] [CharZero K] :
    eqPairGroup Q K ≤ commutator (↥(orthGroup Q K)) := by
  refine (Subgroup.closure_le _).mpr ?_
  rintro _ ⟨u, w, hu, huw, rfl⟩
  obtain ⟨c, hc⟩ := pair_eq_commutator hu huw
  rw [hc, ← commutatorElement_def]
  exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)

variable (Q)

/-- Symmetries commute modulo equal-value pairs: $\tau_x\tau_y(\tau_y\tau_x)^{-1} = \tau_x\tau_{\tau_y x}$. -/
theorem symm_mul_symm_mul_inv_mem (K : Type*) [Field K] [Algebra F K] [CharZero K] (x y : Fin n → K) :
    symm Q K x * symm Q K y * (symm Q K y * symm Q K x)⁻¹ ∈ eqPairGroup Q K := by
  rw [_root_.mul_inv_rev, symm_inv, symm_inv]
  have h := symm_conj Q K (symm Q K y) x
  rw [symm_inv] at h
  have e : symm Q K x * symm Q K y * (symm Q K x * symm Q K y) =
      symm Q K x * symm Q K (((symm Q K y : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ x) := by
    rw [← h]; group
  rw [e]
  by_cases hx : Q.evalIn K x = 0
  · have h1 : symm Q K x = 1 := by ext1; simp [symm, symmGL_of_eq_zero Q K hx]
    have h2 : Q.evalIn K (((symm Q K y : GL (Fin n) K) : Matrix (Fin n) (Fin n) K) *ᵥ x) = 0 := by
      rw [evalIn_mulVec_of_mem Q (symm Q K y).2, hx]
    have h0 : ∀ z : Fin n → K, Q.evalIn K z = 0 → symm Q K z = 1 := fun z hz => by
      ext1; simp [symm, symmGL_of_eq_zero Q K hz]
    have h3 := h0 _ h2
    rw [h1, h3, mul_one]; exact Subgroup.one_mem _
  · exact pair_mem_eqPairGroup Q K hx (evalIn_mulVec_of_mem Q (symm Q K y).2 x).symm

/-- **The commutator subgroup is generated by equal-value pairs:** $\Omega(V) = [O(V), O(V)] \le$ `eqPairGroup`
(for nondegenerate $Q$: $O(V)$ is generated by symmetries, which commute modulo equal-value pairs). Hence
`eqPairGroup Q K` $= \Omega(V_K)$ (`eqPairGroup_eq_commutator`). -/
theorem commutator_le_eqPairGroup (K : Type*) [Field K] [Algebra F K] [CharZero K] (hQ : Q.Nondegenerate) :
    commutator (↥(orthGroup Q K)) ≤ eqPairGroup Q K := by
  have := eqPairGroup_normal Q K
  set π := QuotientGroup.mk' (eqPairGroup Q K)
  have hgen : ∀ x y : Fin n → K, Commute (π (symm Q K x)) (π (symm Q K y)) := by
    intro x y
    have h := symm_mul_symm_mul_inv_mem Q K x y
    have : π (symm Q K x * symm Q K y * (symm Q K y * symm Q K x)⁻¹) = 1 :=
      (QuotientGroup.eq_one_iff _).mpr h
    rw [map_mul, map_inv, map_mul, map_mul, mul_inv_eq_one] at this
    exact this
  have hlist : ∀ (xs : List (Fin n → K)) (y : Fin n → K), Commute (π (symmProd Q K xs)) (π (symm Q K y)) := by
    intro xs y
    induction xs with
    | nil => simp [symmProd]
    | cons x xs ih =>
      have : symmProd Q K (x :: xs) = symm Q K x * symmProd Q K xs := by simp [symmProd]
      rw [this, map_mul]
      exact (hgen x y).mul_left ih
  have hlist2 : ∀ (xs ys : List (Fin n → K)), Commute (π (symmProd Q K xs)) (π (symmProd Q K ys)) := by
    intro xs ys
    induction ys with
    | nil => simp [symmProd]
    | cons y ys ih =>
      have : symmProd Q K (y :: ys) = symm Q K y * symmProd Q K ys := by simp [symmProd]
      rw [this, map_mul]
      exact (hlist xs y).mul_right ih
  rw [commutator, Subgroup.commutator_le]
  intro g _ h _
  obtain ⟨xs, -, rfl⟩ := exists_symmProd_eq Q K hQ g
  obtain ⟨ys, -, rfl⟩ := exists_symmProd_eq Q K hQ h
  rw [← QuotientGroup.eq_one_iff, ← QuotientGroup.mk'_apply, map_commutatorElement,
    commutatorElement_eq_one_iff_commute]
  exact hlist2 xs ys

/-- **`eqPairGroup` is the commutator subgroup** $\Omega(V_K)$ of $O(V_K)$ (nondegenerate $Q$). -/
theorem eqPairGroup_eq_commutator (K : Type*) [Field K] [Algebra F K] [CharZero K] (hQ : Q.Nondegenerate) :
    eqPairGroup Q K = commutator (↥(orthGroup Q K)) :=
  le_antisymm (eqPairGroup_le_commutator K) (commutator_le_eqPairGroup Q K hQ)

end Commutator

end QuadFormsKB.Lattices
