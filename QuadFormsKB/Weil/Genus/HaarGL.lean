/-
# $\mathrm{GL}_g$-change of variables at a non-archimedean place

**Layer:** local harmonic analysis; completes the interface `IsGLModel` of `Weil/Genus/Model.lean` at a finite place, using
the description `Sg = SBG` of the Schwartz space of $V^g$ from `Weil/Genus/NonArchSg.lean`.

**Setting.** $K$ is a non-archimedean local field (nontrivially normed, ultrametric, proper), $n = 2m$,
$V^g = M_{n\times g}(K)$ (`PtG m g K`, 0-based indices), and $D$ is a `LocalData K` which is a model (`D.IsModel`) with
$D.S = \texttt{SBK}\,K$ (hypothesis `hS`), $D.\psi$ a standard character (`hψ : Analysis.Weil.IsStdChar D.ψ`) and
$D.\mu$ a Haar measure (instance `[D.μ.IsAddHaarMeasure]`; true of the self-dual measure at every finite place).

**Results.**
* `cA m A` (for $A \in \mathrm{GL}_g(K)$): the factor by which the additive automorphism $X \mapsto XA$ of $V^g$ scales Haar
  measure (`MeasureTheory.addEquivAddHaarChar`); multiplicative (`cA_mul`) and `integral_comp_mulRight`:
  $\int F(XA)\,d\mu(X) = \mathrm{cA}(A)^{-1}\int F\,d\mu$ for every Haar measure $\mu$ on $V^g$ and every integrand $F$.
* `cA_eq`: $\mathrm{cA}(A) = |\det A|^{2m}$, where $|\cdot|$ is `D.md`. Proof: both sides are multiplicative in $A$;
  $\mathrm{GL}_g(K)$ is generated by diagonal matrices and transvections (`Matrix.diagonal_transvection_induction_of_det_ne_zero`);
  on diagonal matrices this is the coordinatewise computation `four_comp_diagGL` (with $Y = 0$ and the indicator of the unit
  box, whose integral is nonzero); on a transvection $T(c)$ the factor $\chi(c) = \mathrm{cA}(T(c))$ is additive-to-multiplicative
  (`Tg_add`), invariant under $c \mapsto \lambda c$ (conjugation by $\operatorname{diag}(\lambda, 1, \dots)$, `dI_conj`),
  hence $\chi(1)^2 = \chi(1 + 1)$ forces $\chi = 1$ (`cA_Tg`).
* `four_comp_nonarch`: the change of variables $\int\Phi(XA)\psi(\langle X,Y\rangle)\,d\mu = |\det A|^{-2m}\int\Phi(X)\psi(\langle X, Y\,{}^tA^{-1}\rangle)\,d\mu$
  for every function $\Phi$ (no Fubini or explicit shear computation).
* `isGLModel_nonarch`: `IsGLModel D a g` for every $g$ (unconditional given `hD`, `hS`, `hψ`);
  `isGLModel_V`: the same for `localDataV v` at every finite place $v$ of a number field.

Sources: Weil, Acta Math. 111 (1964), §14 [unverified].
-/
import Mathlib
import QuadFormsKB.Citation
import QuadFormsKB.Weil.Genus.NonArchSg

open MeasureTheory Matrix
open scoped MatrixGroups NNReal

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.WeilRep.Genus

open WeilRep WeilRep.LocalData

section Haar

variable {K : Type*} [NontriviallyNormedField K] [IsUltrametricDist K] [ProperSpace K]
  [MeasurableSpace K] [BorelSpace K] {m g : ℕ}

/-- **Right multiplication by $A \in \mathrm{GL}_g(K)$** as a topological additive automorphism of $V^g = M_{2m\times g}(K)$:
$X \mapsto XA$ (inverse $X \mapsto XA^{-1}$). -/
def mulRightHomeo (A : GL (Fin g) K) : PtG m g K ≃ₜ+ PtG m g K where
  toFun X := X * (A : Matrix (Fin g) (Fin g) K)
  invFun X := X * ((A⁻¹ : GL (Fin g) K) : Matrix (Fin g) (Fin g) K)
  left_inv X := by simp [Matrix.mul_assoc]
  right_inv X := by simp [Matrix.mul_assoc]
  map_add' X Y := Matrix.add_mul X Y _
  continuous_toFun := by fun_prop
  continuous_invFun := by fun_prop

instance instLCPtG : LocallyCompactSpace (PtG m g K) :=
  inferInstanceAs (LocallyCompactSpace (Fin (2 * m) → Fin g → K))
instance instSCPtG : SigmaCompactSpace (PtG m g K) :=
  inferInstanceAs (SigmaCompactSpace (Fin (2 * m) → Fin g → K))

/-- **The modulus of $X \mapsto XA$ on $V^g$:** the positive real factor by which the automorphism `mulRightHomeo A` scales
Haar measure (`MeasureTheory.addEquivAddHaarChar`); $\mu(\{X : XA \in E\}) = \mathrm{cA}(A)^{-1}\mu(E)$. -/
def cA (m : ℕ) (A : GL (Fin g) K) : ℝ≥0 := addEquivAddHaarChar (mulRightHomeo (m := m) A)

/-- The modulus is positive. -/
lemma cA_pos (A : GL (Fin g) K) : 0 < cA m A := addEquivAddHaarChar_pos _

/-- $X \mapsto X(AB)$ is $X \mapsto XA$ followed by $X \mapsto XB$. -/
lemma mulRightHomeo_mul (A B : GL (Fin g) K) :
    mulRightHomeo (m := m) (A * B) = (mulRightHomeo A).trans (mulRightHomeo B) := by
  ext X
  simp [mulRightHomeo, Matrix.mul_assoc]

/-- $\mathrm{cA}(AB) = \mathrm{cA}(A)\mathrm{cA}(B)$. -/
lemma cA_mul (A B : GL (Fin g) K) : cA m (A * B) = cA m A * cA m B := by
  simp only [cA, mulRightHomeo_mul, addEquivAddHaarChar_trans]

/-- $\mathrm{cA}(1) = 1$. -/
lemma cA_one : cA m (1 : GL (Fin g) K) = 1 := by
  have : mulRightHomeo (m := m) (1 : GL (Fin g) K) = ContinuousAddEquiv.refl _ := by
    ext X; simp [mulRightHomeo]
  simp [cA, this]

/-- **Change of variables for $X \mapsto XA$:** for a (regular) Haar measure $\mu$ on $V^g$ and every integrand $F$,
$\int F(XA)\,d\mu(X) = \mathrm{cA}(A)^{-1}\int F\,d\mu$. -/
lemma integral_comp_mulRight (μ : Measure (PtG m g K)) [μ.IsAddHaarMeasure] [μ.Regular]
    (A : GL (Fin g) K) (F : PtG m g K → ℂ) :
    ∫ X, F (X * (A : Matrix (Fin g) (Fin g) K)) ∂μ = ((cA m A : ℝ)⁻¹ : ℝ) • ∫ X, F X ∂μ := by
  have h := addEquivAddHaarChar_smul_map μ (mulRightHomeo (m := m) A)
  have e : ∫ X, F X ∂μ = ∫ X, F X ∂((cA m A) • μ.map (mulRightHomeo (m := m) A)) := by
    rw [cA, h]
  rw [e, integral_smul_nnreal_measure]
  have hm : ∫ X, F X ∂(μ.map (mulRightHomeo (m := m) A)) = ∫ X, F (X * (A : Matrix (Fin g) (Fin g) K)) ∂μ :=
    (mulRightHomeo (m := m) A).toHomeomorph.toMeasurableEquiv.measurableEmbedding.integral_map F
  rw [hm, NNReal.smul_def, smul_smul, inv_mul_cancel₀ (by exact_mod_cast (cA_pos (m := m) A).ne'), one_smul]


/-! ### Transvections -/

/-- **The transvection** $1 + c\,E_{ij}$ ($i \ne j$) as an element of $\mathrm{GL}_g(K)$ (inverse: $c \mapsto -c$). -/
def Tg {i j : Fin g} (hij : i ≠ j) (c : K) : GL (Fin g) K where
  val := transvection i j c
  inv := transvection i j (-c)
  val_inv := by rw [transvection_mul_transvection_same _ _ hij, add_neg_cancel, transvection_zero]
  inv_val := by rw [transvection_mul_transvection_same _ _ hij, neg_add_cancel, transvection_zero]

/-- $T(c + d) = T(c)\,T(d)$. -/
lemma Tg_add {i j : Fin g} (hij : i ≠ j) (c d : K) : Tg hij (c + d) = Tg hij c * Tg hij d :=
  Units.ext (by simp [Tg, transvection_mul_transvection_same _ _ hij])

/-- $T(0) = 1$. -/
lemma Tg_zero {i j : Fin g} (hij : i ≠ j) : Tg (K := K) hij 0 = 1 :=
  Units.ext (by simp [Tg, transvection_zero])

set_option linter.unnecessarySeqFocus false in
set_option linter.unusedTactic false in
/-- The diagonal matrix $\operatorname{diag}(1, \dots, \ell, \dots, 1)$ with $\ell$ in position $i$. -/
def dI (i : Fin g) (l : Kˣ) : GL (Fin g) K :=
  ⟨diagonal fun k => if k = i then (l : K) else 1, diagonal fun k => if k = i then ((l⁻¹ : Kˣ) : K) else 1,
    by rw [diagonal_mul_diagonal]; ext k n; by_cases h : k = i <;> by_cases h' : k = n <;> simp [diagonal_apply, one_apply, h, h'] <;> aesop,
    by rw [diagonal_mul_diagonal]; ext k n; by_cases h : k = i <;> by_cases h' : k = n <;> simp [diagonal_apply, one_apply, h, h'] <;> aesop⟩

/-- Conjugation by $\operatorname{diag}(1,\dots,\ell,\dots,1)$ ($\ell$ in position $i$) scales the transvection parameter:
$d\,T_{ij}(c)\,d^{-1} = T_{ij}(\ell c)$ for $i \ne j$. -/
lemma dI_conj {i j : Fin g} (hij : i ≠ j) (l : Kˣ) (c : K) :
    dI i l * Tg hij c * (dI i l)⁻¹ = Tg hij ((l : K) * c) := by
  apply Units.ext
  show (diagonal fun k => if k = i then (l : K) else 1) * transvection i j c *
    (diagonal fun k => if k = i then ((l⁻¹ : Kˣ) : K) else 1) = transvection i j ((l : K) * c)
  ext k n
  simp only [transvection, mul_diagonal, diagonal_mul, Matrix.add_apply, one_apply, single_apply]
  have hl : (l : K) ≠ 0 := l.ne_zero
  rcases eq_or_ne k i with rfl | hk <;> rcases eq_or_ne n k with rfl | hnk <;>
    rcases eq_or_ne n j with rfl | hnj <;>
    simp_all [hij.symm, eq_comm]

/-- **Transvections have modulus one:** $\mathrm{cA}(T_{ij}(c)) = 1$ (additivity, conjugation invariance, positivity). -/
lemma cA_Tg {i j : Fin g} (hij : i ≠ j) (c : K) : cA m (Tg hij c) = 1 := by
  have hcomm : ∀ (l : Kˣ) (c : K), cA m (Tg hij ((l : K) * c)) = cA m (Tg hij c) := by
    intro l c
    rw [← dI_conj hij l c, cA_mul, cA_mul]
    have h1 : cA m (dI i l) * cA m (dI i l)⁻¹ = 1 := by rw [← cA_mul, mul_inv_cancel, cA_one]
    calc cA m (dI i l) * cA m (Tg hij c) * cA m (dI i l)⁻¹
        = cA m (Tg hij c) * (cA m (dI i l) * cA m (dI i l)⁻¹) := by ring
      _ = _ := by rw [h1, mul_one]
  have h1 : ∀ c : K, c ≠ 0 → cA m (Tg hij c) = cA m (Tg hij (1 : K)) := by
    intro c hc
    have := hcomm (Units.mk0 c hc) (1 : K)
    simpa using this
  have hx : cA m (Tg hij (1 : K)) = 1 := by
    set x := cA m (Tg hij (1 : K))
    have hxx : x * x = cA m (Tg hij ((1 : K) + 1)) := by rw [Tg_add, cA_mul]
    have hxp : 0 < x := cA_pos _
    by_cases h2 : ((1 : K) + 1) = 0
    · rw [h2, Tg_zero, cA_one] at hxx
      have : x ^ 2 = 1 := by rw [sq]; exact hxx
      exact (pow_left_inj₀ hxp.le zero_le_one (by norm_num : 2 ≠ 0)).mp (this.trans (one_pow 2).symm)
    · rw [h1 _ h2] at hxx
      have := mul_right_cancel₀ hxp.ne' (by rw [hxx, one_mul] : x * x = 1 * x)
      exact this
  by_cases hc : c = 0
  · rw [hc, Tg_zero, cA_one]
  · rw [h1 c hc, hx]


/-! ### Haar measure on V^g -/

variable (D : LocalData K) [D.μ.IsAddHaarMeasure]

/-- (Instance plumbing) $V^g$ is pseudo-metrizable (a finite product of such). -/
instance instPMPtG : TopologicalSpace.PseudoMetrizableSpace (PtG m g K) :=
  inferInstanceAs (TopologicalSpace.PseudoMetrizableSpace (Fin (2 * m) → Fin g → K))

/-- The product measure `muG D m g` is an additive Haar measure when `D.μ` is. -/
instance muG_isAddHaar : (muG D m g).IsAddHaarMeasure := by
  unfold muG
  have : SigmaFinite D.μ := inferInstance
  have : (Measure.pi fun _ : Fin g => D.μ).IsAddHaarMeasure := inferInstance
  have : SigmaFinite (Measure.pi fun _ : Fin g => D.μ) := inferInstance
  exact Measure.pi.isAddHaarMeasure _

/-- The product measure `muG D m g` is regular. -/
instance muG_regular : (muG D m g).Regular :=
  Measure.Regular.of_sigmaCompactSpace_of_isLocallyFiniteMeasure _

/-- $\langle XA^{-1}, Y\rangle = \langle X, Y\,{}^tA^{-1}\rangle$ (transposing the matrix factor). -/
lemma BX_mul_inv (a : Fin (2 * m) → Kˣ) (A : GL (Fin g) K) (X Y : PtG m g K) :
    BX a (X * ((A⁻¹ : GL (Fin g) K) : Matrix (Fin g) (Fin g) K)) Y =
      BX a X (Y * (invT A : Matrix (Fin g) (Fin g) K)) := by
  simp only [BX, Matrix.mul_apply, invT_coe, transpose_apply, Finset.mul_sum, Finset.sum_mul]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun j _ => ?_
  ring


/-! ### The modulus of a diagonal matrix -/

variable {D}
variable {a : Fin (2 * m) → Kˣ}

/-- The integral of the unit-box indicator over $V^g$ is nonzero (it is a product of positive volumes). -/
lemma integral_ptG_indicator_ne_zero (hD : D.IsOps) :
    ∫ X, ptG (m := m) (g := g) (fun _ _ => (Metric.closedBall (0 : K) 1).indicator fun _ => (1 : ℂ)) X
      ∂muG D m g ≠ 0 := by
  have h := integral_ptG (a := fun _ => (1 : Kˣ)) hD
    (fun (_ : Fin (2 * m)) (_ : Fin g) => (Metric.closedBall (0 : K) 1).indicator fun _ => (1 : ℂ)) 0
  have e : ∀ X : PtG m g K, ptG (fun (_ : Fin (2 * m)) (_ : Fin g) =>
      (Metric.closedBall (0 : K) 1).indicator fun _ => (1 : ℂ)) X * (D.ψ (BX (fun _ => (1 : Kˣ)) X 0) : ℂ) =
      ptG (fun (_ : Fin (2 * m)) (_ : Fin g) =>
      (Metric.closedBall (0 : K) 1).indicator fun _ => (1 : ℂ)) X := by
    intro X; simp [BX]
  simp only [e] at h
  rw [h]
  refine Finset.prod_ne_zero_iff.mpr fun i _ => Finset.prod_ne_zero_iff.mpr fun j _ => ?_
  have : D.four ((Metric.closedBall (0 : K) 1).indicator fun _ => (1 : ℂ)) (2 * ((1 : Kˣ) : K) * (0 : PtG m g K) i j) =
      ((D.μ.real (Metric.closedBall (0 : K) 1) : ℝ) : ℂ) := by
    simp only [LocalData.four, Matrix.zero_apply, mul_zero, AddChar.map_zero_eq_one, Circle.coe_one, mul_one]
    rw [integral_indicator_const _ Metric.isClosed_closedBall.measurableSet]
    simp
  rw [this]
  have hopen : IsOpen (Metric.closedBall (0 : K) 1) := IsUltrametricDist.isOpen_closedBall _ one_ne_zero
  have hpos : 0 < D.μ (Metric.closedBall (0 : K) 1) := hopen.measure_pos _ ⟨0, by simp⟩
  have hfin : D.μ (Metric.closedBall (0 : K) 1) < ⊤ := (isCompact_closedBall _ _).measure_lt_top
  have : 0 < D.μ.real (Metric.closedBall (0 : K) 1) := ENNReal.toReal_pos hpos.ne' hfin.ne
  exact_mod_cast this.ne'


/-- **The modulus of a diagonal matrix:** $\mathrm{cA}(\operatorname{diag}(d)) = |\det|^{2m}$, by the coordinatewise
`four_comp_diagGL` at $Y = 0$ applied to the indicator of the unit box (`h0` says this indicator is a test function). -/
lemma cA_diagGL (hD : D.IsModel)
    (h0 : (Metric.closedBall (0 : K) 1).indicator (fun _ => (1 : ℂ)) ∈ D.S) (d : Fin g → Kˣ) :
    (cA m (diagGL d) : ℝ) = (D.md ((diagGL d : GL (Fin g) K) : Matrix (Fin g) (Fin g) K).det) ^ (2 * m) := by
  have hDm := hD.toIsOps
  set f : Fin (2 * m) → Fin g → K → ℂ := fun _ _ => (Metric.closedBall (0 : K) 1).indicator fun _ => (1 : ℂ)
  have hΦ : ptG f ∈ Sg D m g := ptG_mem_Sg (fun _ _ => h0)
  have h1 := four_comp_diagGL (a := fun _ => (1 : Kˣ)) hD d hΦ 0
  have h2 := integral_comp_mulRight (m := m) (muG D m g) (diagGL d) (ptG f)
  have hz : ∀ (Z : PtG m g K), (D.ψ (BX (fun _ => (1 : Kˣ)) Z 0) : ℂ) = 1 := fun Z => by simp [BX]
  simp only [Matrix.zero_mul, hz, mul_one] at h1
  rw [h2] at h1
  have hJ := integral_ptG_indicator_ne_zero (D := D) (K := K) (m := m) (g := g) hDm
  rw [Complex.real_smul] at h1
  have h3 := mul_right_cancel₀ hJ h1
  have h4 : (((cA m (diagGL d) : ℝ)) : ℂ)⁻¹ =
      ((((D.md ((diagGL d : GL (Fin g) K) : Matrix (Fin g) (Fin g) K).det) ^ (2 * m) : ℝ)) : ℂ)⁻¹ := by
    push_cast at h3 ⊢
    rw [h3, inv_pow]
  have h5 := inv_injective h4
  exact_mod_cast h5


/-- $|\det(AB)| = |\det A|\,|\det B|$. -/
lemma md_det_mul (hD : D.IsModel) (A B : GL (Fin g) K) :
    D.md (((A * B : GL (Fin g) K) : Matrix (Fin g) (Fin g) K).det) =
      D.md ((A : Matrix (Fin g) (Fin g) K).det) * D.md ((B : Matrix (Fin g) (Fin g) K).det) := by
  have := hD.md_mul (Matrix.GeneralLinearGroup.det A) (Matrix.GeneralLinearGroup.det B)
  simpa [Matrix.GeneralLinearGroup.val_det_apply] using this

/-- **The modulus of $X \mapsto XA$ is $|\det A|^{2m}$** ($n = 2m$) for every $A \in \mathrm{GL}_g(K)$ (diagonal matrices and
transvections generate $\mathrm{GL}_g(K)$; both sides are multiplicative). -/
@[kb "weil1964" "§14 (the modulus of $X \\mapsto XA$ on $V^g$) [unverified]"]
theorem cA_eq (hD : D.IsModel)
    (h0 : (Metric.closedBall (0 : K) 1).indicator (fun _ => (1 : ℂ)) ∈ D.S) (A : GL (Fin g) K) :
    (cA m A : ℝ) = (D.md (A : Matrix (Fin g) (Fin g) K).det) ^ (2 * m) := by
  have hdet : (A : Matrix (Fin g) (Fin g) K).det ≠ 0 := (Matrix.isUnits_det_units A).ne_zero
  refine Matrix.diagonal_transvection_induction_of_det_ne_zero
    (fun M => ∀ B : GL (Fin g) K, (B : Matrix (Fin g) (Fin g) K) = M →
      (cA m B : ℝ) = (D.md (B : Matrix (Fin g) (Fin g) K).det) ^ (2 * m)) (A : Matrix (Fin g) (Fin g) K) hdet
    ?_ ?_ ?_ A rfl
  · intro d hd B hB
    have hd' : ∀ j, d j ≠ 0 := fun j => by
      rw [det_diagonal] at hd
      exact (Finset.prod_ne_zero_iff.mp hd) j (Finset.mem_univ j)
    have : B = diagGL (fun j => Units.mk0 (d j) (hd' j)) := Units.ext (by rw [hB]; rfl)
    rw [this]
    exact cA_diagGL hD h0 _
  · intro t B hB
    have : B = Tg t.hij t.c := Units.ext (by rw [hB]; rfl)
    rw [this, cA_Tg]
    have h1 : ((Tg t.hij t.c : GL (Fin g) K) : Matrix (Fin g) (Fin g) K).det = 1 :=
      det_transvection_of_ne _ _ t.hij _
    rw [h1, md_one hD]
    simp
  · intro M N hM hN hPM hPN B hB
    obtain ⟨B1, hB1⟩ := (Matrix.isUnit_iff_isUnit_det M).mpr (isUnit_iff_ne_zero.mpr hM)
    obtain ⟨B2, hB2⟩ := (Matrix.isUnit_iff_isUnit_det N).mpr (isUnit_iff_ne_zero.mpr hN)
    have : B = B1 * B2 := Units.ext (by rw [hB, Units.val_mul, hB1, hB2])
    have e1 := hPM B1 hB1
    have e2 := hPN B2 hB2
    rw [this, cA_mul, md_det_mul hD, mul_pow, NNReal.coe_mul, e1, e2]


/-- **The change of variables $\int\Phi(XA)\psi(\langle X,Y\rangle)\,d\mu = |\det A|^{-2m}\int\Phi(X)\psi(\langle X,Y\,{}^tA^{-1}\rangle)\,d\mu$**
for every function $\Phi$ (the field `four_comp` of `IsGLModel`), from `cA_eq` and `integral_comp_mulRight` applied to
$F(X) = \Phi(X)\psi(\langle XA^{-1}, Y\rangle)$. -/
@[kb "weil1964" "§14 (the modulus of $X \\mapsto XA$; Fourier transform and $\\mathrm{GL}(X)$) [unverified]"]
theorem four_comp_nonarch (hD : D.IsModel)
    (h0 : (Metric.closedBall (0 : K) 1).indicator (fun _ => (1 : ℂ)) ∈ D.S) (A : GL (Fin g) K)
    (Φ : PtG m g K → ℂ) (Y : PtG m g K) :
    ∫ X, Φ (X * (A : Matrix (Fin g) (Fin g) K)) * (D.ψ (BX a X Y) : ℂ) ∂muG D m g =
      ((D.md (A : Matrix (Fin g) (Fin g) K).det : ℂ)⁻¹) ^ (2 * m) *
        ∫ X, Φ X * (D.ψ (BX a X (Y * (invT A : Matrix (Fin g) (Fin g) K))) : ℂ) ∂muG D m g := by
  have key := integral_comp_mulRight (m := m) (muG D m g) A
    (fun X => Φ X * (D.ψ (BX a (X * ((A⁻¹ : GL (Fin g) K) : Matrix (Fin g) (Fin g) K)) Y) : ℂ))
  have e : ∀ X : PtG m g K, (X * (A : Matrix (Fin g) (Fin g) K)) *
      ((A⁻¹ : GL (Fin g) K) : Matrix (Fin g) (Fin g) K) = X := fun X => by
    rw [Matrix.mul_assoc, ← Units.val_mul, mul_inv_cancel, Units.val_one, Matrix.mul_one]
  simp only [e, BX_mul_inv] at key
  rw [key, cA_eq hD h0, Complex.real_smul]
  push_cast
  rw [inv_pow]

/-- **`IsGLModel` holds for every $g$ at a non-archimedean place:** stability of $\mathcal S(V^g)$ under $\omega(n(B))$ and
$\omega(m(A))$ (`opNg_mem_Sg_nonarch`, `opMg_mem_Sg_nonarch`) and the change of variables (`four_comp_nonarch`).
Hypotheses: `hD : D.IsModel`, `hS : D.S = SBK K` (the test functions are the locally constant compactly supported ones),
`hψ : Analysis.Weil.IsStdChar D.ψ`, and `D.μ` an additive Haar measure (instance). -/
@[kb "weil1964" "§14 ($\\mathcal S(X)$ is stable under $\\mathrm{GL}(X)$; the modulus of $X \\mapsto XA$) [unverified]"]
theorem isGLModel_nonarch (hD : D.IsModel) (hS : D.S = SBK K) (hψ : Analysis.Weil.IsStdChar D.ψ) :
    IsGLModel D a g where
  opN_mem B _ Φ hΦ := opNg_mem_Sg_nonarch hS hψ B hΦ
  opM_mem A Φ hΦ := opMg_mem_Sg_nonarch hS A hΦ
  four_comp A Φ _ Y :=
    four_comp_nonarch hD (by rw [hS]; exact indicator_closedBall_mem_SBK 0 one_pos) A Φ Y

end Haar

section Place

open IsDedekindDomain NumberField Analysis

variable {F : Type} [Field F] [NumberField F] (v : HeightOneSpectrum (𝓞 F))

local notation "Fv" => v.adicCompletion F

/-- **`IsGLModel` for `localDataV v` at every finite place $v$ and every genus $g$** (dyadic places included): the
Schwartz space $\mathcal S(V_v^g)$ of the local Weil representation is stable under $\omega(n(B))$, $\omega(m(A))$, and the
Fourier transform satisfies the $\mathrm{GL}_g(F_v)$ change of variables. Unconditional (`hS` is `rfl`, `hψ` is
`isStdChar_psiV`, `hD` is `isModel_V`, and the self-dual measure is an additive Haar measure). -/
@[kb "weil1964" "§14, §26–28 [unverified]"]
theorem isGLModel_V {m : ℕ} (a : Fin (2 * m) → (Fv)ˣ) (g : ℕ) : IsGLModel (localDataV v) a g := by
  have : (localDataV v).μ.IsAddHaarMeasure := inferInstanceAs ((selfDualV v).IsAddHaarMeasure)
  exact isGLModel_nonarch (isModel_V v) rfl (isStdChar_psiV v)

end Place

