/-
# The genus-$g$ theta series under $\mathrm{Sp}_{2g}(\mathbb Z)$

**Layer:** classical, over $\mathbb Z$, $\mathbb R$, $\mathbb C$.

For $\gamma = \begin{pmatrix}A&B\\C&D\end{pmatrix} \in \mathrm{Sp}_{2g}(\mathbb Z)$ (Mathlib's `symplecticGroup (Fin g) ℤ`,
blocks indexed by `Fin g ⊕ Fin g`) and $Z \in \mathbb H_g$ write
$$j(\gamma, Z) = CZ + D,\qquad \gamma\langle Z\rangle = (AZ + B)(CZ + D)^{-1}\qquad(\texttt{jG},\ \texttt{actG}).$$

**Result.** `thetaG_sp`: let $S \in M_N(\mathbb Z)$ be symmetric, positive definite, with even diagonal and
$\det S = 1$, $N = 2k$ with $4 \mid k$ (for an even unimodular lattice $8 \mid N$ always holds; it is assumed here, not
proved). Assume the named input `SpZGeneration g` ($\mathrm{Sp}_{2g}(\mathbb Z)$ is generated by $J$ and the translations
$\begin{pmatrix}1&B\\0&1\end{pmatrix}$, $B = B^{\mathsf T}$ integral). Then for every $\gamma \in \mathrm{Sp}_{2g}(\mathbb Z)$ and
$Z \in \mathbb H_g$: $\det(CZ + D) \ne 0$, $\gamma\langle Z\rangle \in \mathbb H_g$ and
$$\Theta_S(\gamma\langle Z\rangle) = \det(CZ + D)^k\,\Theta_S(Z),$$
i.e. $\Theta_S$ is a Siegel modular form of weight $k = N/2$ for $\mathrm{Sp}_{2g}(\mathbb Z)$ (holomorphy and the
boundedness condition are not formalized here).

*Proof.* The set of $\gamma$ satisfying the three conclusions for all $Z$ contains $1$ and is closed under products
(the cocycle relation $j(\gamma\delta, Z) = j(\gamma, \delta\langle Z\rangle)\,j(\delta, Z)$ and
$(\gamma\delta)\langle Z\rangle = \gamma\langle\delta\langle Z\rangle\rangle$, pure matrix algebra); it contains $J$
(`thetaG_neg_inv`, $\det(-iZ)^k = \det(Z)^k$ as $4 \mid k$) and the translations (`thetaG_add_int`). Since
$J^{-1} = J^3$ and the inverse of a translation is a translation, the subgroup generated is the submonoid generated.

Sources: Freitag, *Siegelsche Modulfunktionen* (1983), Ch. I and Anhang [unverified]; Klingen, *Introductory lectures on
Siegel modular forms* (1990), §I.2 (generators of $\mathrm{Sp}_n(\mathbb Z)$) and §I.3 (theta series) [unverified].
-/
import Mathlib
import QuadFormsKB.Citation
import QuadFormsKB.Weil.Genus.Theta

open Matrix Complex

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.WeilRep.Genus

variable {g : ℕ}

/-! ### The action of a complex $2g\times2g$ matrix on $g\times g$ matrices -/

/-- The automorphy factor $j(M, Z) = CZ + D$ of $M = \begin{pmatrix}A&B\\C&D\end{pmatrix}$. -/
def jM (M : Matrix (Fin g ⊕ Fin g) (Fin g ⊕ Fin g) ℂ) (Z : Matrix (Fin g) (Fin g) ℂ) : Matrix (Fin g) (Fin g) ℂ :=
  M.toBlocks₂₁ * Z + M.toBlocks₂₂

/-- The fractional linear action $M\langle Z\rangle = (AZ + B)(CZ + D)^{-1}$. -/
def actM (M : Matrix (Fin g ⊕ Fin g) (Fin g ⊕ Fin g) ℂ) (Z : Matrix (Fin g) (Fin g) ℂ) : Matrix (Fin g) (Fin g) ℂ :=
  (M.toBlocks₁₁ * Z + M.toBlocks₁₂) * (jM M Z)⁻¹

@[simp] lemma jM_fromBlocks (A B C D : Matrix (Fin g) (Fin g) ℂ) (Z : Matrix (Fin g) (Fin g) ℂ) :
    jM (fromBlocks A B C D) Z = C * Z + D := by
  simp [jM]

@[simp] lemma actM_fromBlocks (A B C D : Matrix (Fin g) (Fin g) ℂ) (Z : Matrix (Fin g) (Fin g) ℂ) :
    actM (fromBlocks A B C D) Z = (A * Z + B) * (C * Z + D)⁻¹ := by
  simp [actM]

lemma num_eq_actM_mul (M : Matrix (Fin g ⊕ Fin g) (Fin g ⊕ Fin g) ℂ) (Z : Matrix (Fin g) (Fin g) ℂ)
    (h : IsUnit (jM M Z).det) : M.toBlocks₁₁ * Z + M.toBlocks₁₂ = actM M Z * jM M Z := by
  rw [actM, Matrix.mul_assoc, Matrix.nonsing_inv_mul _ h, Matrix.mul_one]

/-- **The cocycle relation** $j(MN, Z) = j(M, N\langle Z\rangle)\,j(N, Z)$. -/
lemma jM_mul (M N : Matrix (Fin g ⊕ Fin g) (Fin g ⊕ Fin g) ℂ) (Z : Matrix (Fin g) (Fin g) ℂ)
    (h : IsUnit (jM N Z).det) : jM (M * N) Z = jM M (actM N Z) * jM N Z := by
  have hN := num_eq_actM_mul N Z h
  have e : jM (M * N) Z = M.toBlocks₂₁ * (N.toBlocks₁₁ * Z + N.toBlocks₁₂) + M.toBlocks₂₂ * jM N Z := by
    rw [← fromBlocks_toBlocks M, ← fromBlocks_toBlocks N, fromBlocks_multiply]
    simp only [jM, toBlocks_fromBlocks₂₁, toBlocks_fromBlocks₂₂, toBlocks_fromBlocks₁₁, toBlocks_fromBlocks₁₂]
    simp only [Matrix.add_mul, Matrix.mul_add, Matrix.mul_assoc]
    abel
  rw [e, hN, ← Matrix.mul_assoc, ← Matrix.add_mul]
  rfl

/-- **Composition of the action** $(MN)\langle Z\rangle = M\langle N\langle Z\rangle\rangle$ when $j(N, Z)$ is invertible. -/
lemma actM_mul (M N : Matrix (Fin g ⊕ Fin g) (Fin g ⊕ Fin g) ℂ) (Z : Matrix (Fin g) (Fin g) ℂ)
    (h : IsUnit (jM N Z).det) : actM (M * N) Z = actM M (actM N Z) := by
  have hN := num_eq_actM_mul N Z h
  have e : (M * N).toBlocks₁₁ * Z + (M * N).toBlocks₁₂ =
      (M.toBlocks₁₁ * actM N Z + M.toBlocks₁₂) * jM N Z := by
    have e1 : (M * N).toBlocks₁₁ * Z + (M * N).toBlocks₁₂ =
        M.toBlocks₁₁ * (N.toBlocks₁₁ * Z + N.toBlocks₁₂) + M.toBlocks₁₂ * jM N Z := by
      rw [← fromBlocks_toBlocks M, ← fromBlocks_toBlocks N, fromBlocks_multiply]
      simp only [jM, toBlocks_fromBlocks₂₁, toBlocks_fromBlocks₂₂, toBlocks_fromBlocks₁₁, toBlocks_fromBlocks₁₂]
      simp only [Matrix.add_mul, Matrix.mul_add, Matrix.mul_assoc]
      abel
    rw [e1, hN, Matrix.add_mul, Matrix.mul_assoc]
  conv_lhs => rw [actM, e, jM_mul M N Z h, Matrix.mul_inv_rev, ← Matrix.mul_assoc, Matrix.mul_assoc _ (jM N Z),
    Matrix.mul_nonsing_inv _ h, Matrix.mul_one]
  rfl

/-! ### $\mathrm{Sp}_{2g}(\mathbb Z)$, its generators and the named input -/

/-- $\mathrm{Sp}_{2g}(\mathbb Z)$ (Mathlib's convention $\gamma J\gamma^{\mathsf T} = J$, $J = \begin{pmatrix}0&-1\\1&0\end{pmatrix}$). -/
abbrev SpZ (g : ℕ) := Matrix.symplecticGroup (Fin g) ℤ

/-- $\gamma \in \mathrm{Sp}_{2g}(\mathbb Z)$ as a complex matrix. -/
def spC (γ : SpZ g) : Matrix (Fin g ⊕ Fin g) (Fin g ⊕ Fin g) ℂ := cZ (γ : Matrix (Fin g ⊕ Fin g) (Fin g ⊕ Fin g) ℤ)

/-- $j(\gamma, Z) = CZ + D$ for $\gamma \in \mathrm{Sp}_{2g}(\mathbb Z)$. -/
def jG (γ : SpZ g) (Z : Matrix (Fin g) (Fin g) ℂ) : Matrix (Fin g) (Fin g) ℂ := jM (spC γ) Z

/-- $\gamma\langle Z\rangle = (AZ + B)(CZ + D)^{-1}$ for $\gamma \in \mathrm{Sp}_{2g}(\mathbb Z)$. -/
def actG (γ : SpZ g) (Z : Matrix (Fin g) (Fin g) ℂ) : Matrix (Fin g) (Fin g) ℂ := actM (spC γ) Z

lemma spC_one : spC (1 : SpZ g) = fromBlocks 1 0 0 1 := by
  rw [fromBlocks_one]
  ext i j
  by_cases h : i = j <;> simp [spC, cZ, Matrix.one_apply, h]

lemma spC_mul (γ δ : SpZ g) : spC (γ * δ) = spC γ * spC δ := by
  simp only [spC, Submonoid.coe_mul]
  exact Matrix.map_mul (f := Int.castRingHom ℂ)

/-- **The translation** $\begin{pmatrix}1&B\\0&1\end{pmatrix} \in \mathrm{Sp}_{2g}(\mathbb Z)$, $B$ integral symmetric. -/
def spNZ (B : Matrix (Fin g) (Fin g) ℤ) (hB : Bᵀ = B) : SpZ g :=
  ⟨fromBlocks 1 B 0 1, by
    rw [SymplecticGroup.fromBlocks_mem_iff]
    refine ⟨by simp, by simp [hB], by simp⟩⟩

/-- **The generators** of $\mathrm{Sp}_{2g}(\mathbb Z)$: $J$ and the translations by integral symmetric $B$. -/
def spZGens (g : ℕ) : Set (SpZ g) :=
  {SymplecticGroup.symJ (Fin g) ℤ} ∪ {γ | ∃ (B : Matrix (Fin g) (Fin g) ℤ) (hB : Bᵀ = B), γ = spNZ B hB}

/-- **Named input: generators of the Siegel modular group.** $\mathrm{Sp}_{2g}(\mathbb Z)$ is generated, as a group, by
$J = \begin{pmatrix}0&-1\\1&0\end{pmatrix}$ and the translations $\begin{pmatrix}1&B\\0&1\end{pmatrix}$, $B$ integral symmetric
(Klingen, *Introductory lectures on Siegel modular forms*, §I.2; Freitag, *Siegelsche Modulfunktionen*, Anhang A5).
Field:
* `closure_eq`: the subgroup generated by `spZGens g` is all of $\mathrm{Sp}_{2g}(\mathbb Z)$. -/
@[kb "klingen1990" "§I.2, Prop. 1 (generators $J$ and the translations of $\\mathrm{Sp}_n(\\mathbb Z)$) [unverified]"]
structure SpZGeneration (g : ℕ) : Prop where
  closure_eq : Subgroup.closure (spZGens g) = ⊤

/-! ### The transformation law -/

section Law

variable {k : ℕ} (S : Matrix (Fin (2 * k)) (Fin (2 * k)) ℤ)

/-- The transformation law at $\gamma$: for every $Z \in \mathbb H_g$, $\det j(\gamma, Z)$ is a unit,
$\gamma\langle Z\rangle \in \mathbb H_g$ and $\Theta_S(\gamma\langle Z\rangle) = \det j(\gamma, Z)^k\,\Theta_S(Z)$. -/
def ThetaLawAt (γ : SpZ g) : Prop :=
  ∀ Z ∈ siegelH g, IsUnit (jG γ Z).det ∧ actG γ Z ∈ siegelH g ∧
    thetaG (S.map ((↑) : ℤ → ℝ)) (actG γ Z) = (jG γ Z).det ^ k * thetaG (S.map ((↑) : ℤ → ℝ)) Z

lemma thetaLawAt_one : ThetaLawAt S (1 : SpZ g) := by
  intro Z hZ
  have hj : jG (1 : SpZ g) Z = 1 := by
    rw [jG, spC_one, jM_fromBlocks]; simp
  have ha : actG (1 : SpZ g) Z = Z := by
    rw [actG, spC_one, actM_fromBlocks]; simp
  rw [hj, ha]
  simp [hZ]

lemma thetaLawAt_mul {γ δ : SpZ g} (hγ : ThetaLawAt S γ) (hδ : ThetaLawAt S δ) : ThetaLawAt S (γ * δ) := by
  intro Z hZ
  obtain ⟨hj, hmem, hθ⟩ := hδ Z hZ
  obtain ⟨hj', hmem', hθ'⟩ := hγ _ hmem
  have hjm : jG (γ * δ) Z = jG γ (actG δ Z) * jG δ Z := by
    simp only [jG, actG, spC_mul]; exact jM_mul _ _ _ hj
  have ham : actG (γ * δ) Z = actG γ (actG δ Z) := by
    simp only [jG, actG, spC_mul] at *; exact actM_mul _ _ _ hj
  refine ⟨?_, ?_, ?_⟩
  · rw [hjm, det_mul]; exact hj'.mul hj
  · rw [ham]; exact hmem'
  · rw [ham, hθ', hθ, hjm, det_mul, mul_pow, mul_assoc]

lemma isUnit_det_of_mem_siegelH {Z : Matrix (Fin g) (Fin g) ℂ} (hZ : Z ∈ siegelH g) : IsUnit Z.det := by
  obtain ⟨P, lam, hP, rfl⟩ := exists_siegel_diag hZ
  have hcP : (cR P).det = (P.det : ℂ) := (Complex.ofRealHom.map_det P).symm
  rw [isUnit_iff_ne_zero, det_mul, det_mul, det_transpose, hcP, det_diagonal]
  refine mul_ne_zero (mul_ne_zero (by exact_mod_cast hP) ?_) (by exact_mod_cast hP)
  refine Finset.prod_ne_zero_iff.mpr fun l _ h => ?_
  have := congrArg Complex.im h
  simp at this

lemma spC_symJ : spC (SymplecticGroup.symJ (Fin g) ℤ) = fromBlocks 0 (-1) 1 0 := by
  simp only [spC, cZ, SymplecticGroup.coe_J, Matrix.J, fromBlocks_map]
  congr 1 <;> ext i j <;> by_cases h : i = j <;> simp [Matrix.one_apply, h]

lemma spC_spNZ (B : Matrix (Fin g) (Fin g) ℤ) (hB : Bᵀ = B) : spC (spNZ B hB) = fromBlocks 1 (cZ B) 0 1 := by
  simp [spC, spNZ, cZ, fromBlocks_map]

/-- The law at $J$: $J\langle Z\rangle = -Z^{-1}$, $j(J, Z) = Z$, from `thetaG_neg_inv` ($4 \mid k$). -/
lemma thetaLawAt_J {S : Matrix (Fin (2 * k)) (Fin (2 * k)) ℤ} (hSsymm : Sᵀ = S)
    (hS : (S.map ((↑) : ℤ → ℝ)).PosDef) (hdet : S.det = 1) (hk : 4 ∣ k) :
    ThetaLawAt S (SymplecticGroup.symJ (Fin g) ℤ) := by
  intro Z hZ
  have hj : jG (SymplecticGroup.symJ (Fin g) ℤ) Z = Z := by
    simp [jG, spC_symJ]
  have ha : actG (SymplecticGroup.symJ (Fin g) ℤ) Z = -Z⁻¹ := by
    simp [actG, spC_symJ]
  rw [hj, ha]
  refine ⟨isUnit_det_of_mem_siegelH hZ, neg_inv_mem_siegelH hZ, ?_⟩
  rw [thetaG_neg_inv k hSsymm hS hdet hZ, det_smul, Fintype.card_fin, mul_pow]
  obtain ⟨t, rfl⟩ := hk
  have : ((-I) ^ g) ^ (4 * t) = 1 := by
    rw [← pow_mul, mul_comm, pow_mul, pow_mul]
    norm_num
  rw [this, one_mul]

/-- The law at a translation: $\begin{pmatrix}1&B\\0&1\end{pmatrix}\langle Z\rangle = Z + B$, $j = 1$, from `thetaG_add_int`. -/
lemma thetaLawAt_spNZ {S : Matrix (Fin (2 * k)) (Fin (2 * k)) ℤ} (hSsymm : Sᵀ = S) (hSeven : ∀ i, Even (S i i))
    (B : Matrix (Fin g) (Fin g) ℤ) (hB : Bᵀ = B) : ThetaLawAt S (spNZ B hB) := by
  intro Z hZ
  have hj : jG (spNZ B hB) Z = 1 := by
    simp [jG, spC_spNZ]
  have ha : actG (spNZ B hB) Z = Z + cZ B := by
    simp [actG, spC_spNZ]
  rw [hj, ha, det_one, one_pow, one_mul, thetaG_add_int hSsymm hSeven hB Z]
  refine ⟨isUnit_one, ⟨?_, ?_⟩, rfl⟩
  · rw [transpose_add, hZ.1, cZ, ← transpose_map, hB]
  · have : (Z + cZ B).map Complex.im = Z.map Complex.im := by
      ext i j; simp [cZ]
    rw [this]; exact hZ.2

lemma symJ_inv : (SymplecticGroup.symJ (Fin g) ℤ)⁻¹ =
    SymplecticGroup.symJ (Fin g) ℤ * SymplecticGroup.symJ (Fin g) ℤ * SymplecticGroup.symJ (Fin g) ℤ := by
  refine inv_eq_of_mul_eq_one_right (Subtype.ext ?_)
  simp only [Submonoid.coe_mul, SymplecticGroup.coe_J, OneMemClass.coe_one, ← Matrix.mul_assoc,
    Matrix.J_squared]
  simp [Matrix.J_squared]

lemma spNZ_inv (B : Matrix (Fin g) (Fin g) ℤ) (hB : Bᵀ = B) :
    (spNZ B hB)⁻¹ = spNZ (-B) (by rw [transpose_neg, hB]) := by
  refine inv_eq_of_mul_eq_one_right (Subtype.ext ?_)
  simp [spNZ, fromBlocks_multiply]

end Law

/-- **The genus-$g$ theta series of an even unimodular lattice is a Siegel modular form of weight $N/2$** (the
transformation law). Let $S \in M_N(\mathbb Z)$ be symmetric positive definite with even diagonal and $\det S = 1$,
$N = 2k$ with $4 \mid k$, and assume the named input `SpZGeneration g`. Then for every
$\gamma = \begin{pmatrix}A&B\\C&D\end{pmatrix} \in \mathrm{Sp}_{2g}(\mathbb Z)$ and $Z \in \mathbb H_g$: $\det(CZ + D) \ne 0$,
$\gamma\langle Z\rangle = (AZ + B)(CZ + D)^{-1} \in \mathbb H_g$, and
$$\Theta_S(\gamma\langle Z\rangle) = \det(CZ + D)^k\,\Theta_S(Z).$$ -/
@[kb "freitag1983" "Ch. I, Anhang (the theta series of an even unimodular lattice is a modular form of weight $m/2$ for $\\mathrm{Sp}_n(\\mathbb Z)$) [unverified]"]
theorem thetaG_sp (hgen : SpZGeneration g) (k : ℕ) {S : Matrix (Fin (2 * k)) (Fin (2 * k)) ℤ} (hSsymm : Sᵀ = S)
    (hSeven : ∀ i, Even (S i i)) (hS : (S.map ((↑) : ℤ → ℝ)).PosDef) (hdet : S.det = 1) (hk : 4 ∣ k)
    (γ : SpZ g) {Z : Matrix (Fin g) (Fin g) ℂ} (hZ : Z ∈ siegelH g) :
    IsUnit (jG γ Z).det ∧ actG γ Z ∈ siegelH g ∧
      thetaG (S.map ((↑) : ℤ → ℝ)) (actG γ Z) = (jG γ Z).det ^ k * thetaG (S.map ((↑) : ℤ → ℝ)) Z := by
  have hmem : γ ∈ (Subgroup.closure (spZGens g)).toSubmonoid := by
    rw [hgen.closure_eq]; trivial
  rw [Subgroup.closure_toSubmonoid] at hmem
  suffices h : ThetaLawAt S γ from h Z hZ
  have hJ := thetaLawAt_J (g := g) hSsymm hS hdet hk
  induction hmem using Submonoid.closure_induction with
  | one => exact thetaLawAt_one S
  | mul x y _ _ hx hy => exact thetaLawAt_mul S hx hy
  | mem x hx =>
  rcases hx with hx | hx
  · rcases hx with rfl | ⟨B, hB, rfl⟩
    · exact hJ
    · exact thetaLawAt_spNZ hSsymm hSeven B hB
  · rw [Set.mem_inv] at hx
    rcases hx with hx | ⟨B, hB, hx⟩
    · rw [Set.mem_singleton_iff] at hx
      rw [← inv_inv x, hx, symJ_inv]
      exact thetaLawAt_mul S (thetaLawAt_mul S hJ hJ) hJ
    · rw [← inv_inv x, hx, spNZ_inv]
      exact thetaLawAt_spNZ hSsymm hSeven _ _

end QuadFormsKB.WeilRep.Genus
