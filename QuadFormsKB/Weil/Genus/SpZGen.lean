/-
# Generators of $\mathrm{Sp}_{2g}(\mathbb Z)$

**Layer:** classical, over $\mathbb Z$.

**Result.** `spZGeneration`: for every $g$, $\mathrm{Sp}_{2g}(\mathbb Z)$ (Mathlib's `symplecticGroup (Fin g) ℤ`) is generated,
as a group, by $J = \begin{pmatrix}0&-1\\1&0\end{pmatrix}$ and the translations
$n(B) = \begin{pmatrix}1&B\\0&1\end{pmatrix}$, $B$ integral symmetric. This proves the named input `SpZGeneration g`
(ThetaSp.lean); `thetaG_sp_uncond` (EightDvd.lean) is the resulting unconditional transformation law.

*Proof.* Let $\Gamma'$ be the subgroup generated. Vectors $v \in \mathbb Z^{2g}$ are indexed by `Fin g ⊕ Fin g`;
write $a_i = v(\mathrm{inl}\,i)$, $c_i = v(\mathrm{inr}\,i)$ and $e_p$ for the standard basis. $\Gamma'$ contains
$n(S)$ ($a \mapsto a + Sc$), $\bar n(T) = \begin{pmatrix}1&0\\T&1\end{pmatrix} = J\,n(-T)\,J^{-1}$ ($c \mapsto c + Ta$) and
the partial $J_i = n(E_{ii})\,\bar n(-E_{ii})\,n(E_{ii})$, which maps $(a_i, c_i) \mapsto (c_i, -a_i)$ and fixes the
other coordinates. For $j < g$, if $M \in \mathrm{Sp}_{2g}(\mathbb Z)$ fixes $e_{\mathrm{inl}\,l}$ for all $l < j$, then
$v = M e_{\mathrm{inl}\,j}$ has $c_l = 0$ for $l < j$ (from $M^{\mathsf T} J M = J$) and, if only one coordinate $a_i$
($i \ge j$) of $v$ in the region $R = \{\mathrm{inl}\,i, \mathrm{inr}\,i : i \ge j\}$ is nonzero, then $a_i = \pm1$ (row
$\mathrm{inl}\,j$ of $M^{-1}$). A Euclidean descent on
$\nu(v) = \sum_{i \ge j} (2|a_i| + 2|c_i| + [c_i \ne 0])$, using only elements of $\Gamma'$ that fix
$e_{\mathrm{inl}\,l}$ for $l < j$, brings $v$ to $e_{\mathrm{inl}\,j}$:
both $a_i, c_i \ne 0$: reduce one modulo the other with $n(tE_{ii})$ or $\bar n(tE_{ii})$; $a_i = 0 \ne c_i$: apply
$J_i$; all $c_i = 0$ and $a_i, a_k \ne 0$: reduce $a_k$ modulo $a_i$ with $J_i\,n(t(E_{ik} + E_{ki}))\,J_i$; at the end
move the entry $\pm1$ to $\mathrm{inl}\,j$, fix its sign with $J_j^2$ and clear $a_l$ ($l < j$) with
$J_j^3\,n(S)\,J_j$. After $g$ steps $M$ fixes every $e_{\mathrm{inl}\,l}$, so $M = n(B)$ with $B$ symmetric. No
induction on $g$ and no generation of $\mathrm{GL}_g(\mathbb Z)$ is needed.

Sources: Klingen, *Introductory lectures on Siegel modular forms* (1990), §I.2, Prop. 1 [unverified]; the proof
here is a direct Euclidean algorithm and differs from Klingen's.
-/
import Mathlib
import QuadFormsKB.Citation
import QuadFormsKB.Weil.Genus.ThetaSp

open Matrix

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.WeilRep.Genus

namespace SpZGen

variable {g : ℕ}

/-- Integral $2g \times 2g$ matrices, indexed by `Fin g ⊕ Fin g`. -/
abbrev MatZ (g : ℕ) := Matrix (Fin g ⊕ Fin g) (Fin g ⊕ Fin g) ℤ

/-- The subgroup generated by $J$ and the translations. -/
abbrev Gam (g : ℕ) : Subgroup (SpZ g) := Subgroup.closure (spZGens g)

/-- The standard basis vector $e_p$ of $\mathbb Z^{2g}$. -/
abbrev ev (p : Fin g ⊕ Fin g) : Fin g ⊕ Fin g → ℤ := Pi.single p 1

lemma mulVec_ev {m : Type*} (A : Matrix m (Fin g ⊕ Fin g) ℤ) (q : Fin g ⊕ Fin g) (p : m) :
    (A *ᵥ ev q) p = A p q := by
  simp [mulVec, dotProduct, Pi.single_apply]

lemma coe_mul_mulVec (γ δ : SpZ g) (v : Fin g ⊕ Fin g → ℤ) :
    (↑(γ * δ) : MatZ g) *ᵥ v = (γ : MatZ g) *ᵥ ((δ : MatZ g) *ᵥ v) := by
  rw [Submonoid.coe_mul, ← mulVec_mulVec]

lemma single_mulVec_apply (i k : Fin g) (t : ℤ) (x : Fin g → ℤ) (p : Fin g) :
    (single i k t *ᵥ x) p = if p = i then t * x k else 0 := by
  rw [single_mulVec, Function.update_apply]
  split_ifs <;> simp

/-! ### The basic elements of $\Gamma'$ -/

lemma spNZ_mem (B : Matrix (Fin g) (Fin g) ℤ) (hB : Bᵀ = B) : spNZ B hB ∈ Gam g :=
  Subgroup.subset_closure (Or.inr ⟨B, hB, rfl⟩)

lemma symJ_mem : SymplecticGroup.symJ (Fin g) ℤ ∈ Gam g :=
  Subgroup.subset_closure (Or.inl rfl)

/-- The lower translation $\bar n(T) = \begin{pmatrix}1&0\\T&1\end{pmatrix}$, $T$ integral symmetric. -/
def spLZ (T : Matrix (Fin g) (Fin g) ℤ) (hT : Tᵀ = T) : SpZ g :=
  ⟨fromBlocks 1 0 T 1, by
    rw [SymplecticGroup.fromBlocks_mem_iff]
    refine ⟨by simp [hT], by simp, by simp⟩⟩

lemma spLZ_eq (T : Matrix (Fin g) (Fin g) ℤ) (hT : Tᵀ = T) :
    spLZ T hT = SymplecticGroup.symJ (Fin g) ℤ * spNZ (-T) (by rw [transpose_neg, hT]) *
      (SymplecticGroup.symJ (Fin g) ℤ)⁻¹ := by
  refine eq_mul_inv_of_mul_eq (Subtype.ext ?_)
  simp [spLZ, spNZ, SymplecticGroup.coe_J, Matrix.J, fromBlocks_multiply]

lemma spLZ_mem (T : Matrix (Fin g) (Fin g) ℤ) (hT : Tᵀ = T) : spLZ T hT ∈ Gam g := by
  rw [spLZ_eq]
  exact mul_mem (mul_mem symJ_mem (spNZ_mem _ _)) (inv_mem symJ_mem)

@[simp] lemma spNZ_mulVec_inl (B : Matrix (Fin g) (Fin g) ℤ) (hB : Bᵀ = B) (v : Fin g ⊕ Fin g → ℤ) (k : Fin g) :
    ((spNZ B hB : MatZ g) *ᵥ v) (Sum.inl k) = v (Sum.inl k) + (B *ᵥ (v ∘ Sum.inr)) k := by
  simp [spNZ, fromBlocks_mulVec]

@[simp] lemma spNZ_mulVec_inr (B : Matrix (Fin g) (Fin g) ℤ) (hB : Bᵀ = B) (v : Fin g ⊕ Fin g → ℤ) (k : Fin g) :
    ((spNZ B hB : MatZ g) *ᵥ v) (Sum.inr k) = v (Sum.inr k) := by
  simp [spNZ, fromBlocks_mulVec]

@[simp] lemma spLZ_mulVec_inl (T : Matrix (Fin g) (Fin g) ℤ) (hT : Tᵀ = T) (v : Fin g ⊕ Fin g → ℤ) (k : Fin g) :
    ((spLZ T hT : MatZ g) *ᵥ v) (Sum.inl k) = v (Sum.inl k) := by
  simp [spLZ, fromBlocks_mulVec]

@[simp] lemma spLZ_mulVec_inr (T : Matrix (Fin g) (Fin g) ℤ) (hT : Tᵀ = T) (v : Fin g ⊕ Fin g → ℤ) (k : Fin g) :
    ((spLZ T hT : MatZ g) *ᵥ v) (Sum.inr k) = (T *ᵥ (v ∘ Sum.inl)) k + v (Sum.inr k) := by
  simp [spLZ, fromBlocks_mulVec]

lemma single_diag_symm (i : Fin g) (t : ℤ) : (single i i t)ᵀ = single i i t := transpose_single i i t

lemma single_pair_symm (i k : Fin g) (t : ℤ) : (single i k t + single k i t)ᵀ = single i k t + single k i t := by
  rw [transpose_add, transpose_single, transpose_single, add_comm]

lemma spLZ_single_inr (i : Fin g) (t : ℤ) (v : Fin g ⊕ Fin g → ℤ) (k : Fin g) :
    ((spLZ (single i i t) (single_diag_symm i t) : MatZ g) *ᵥ v) (Sum.inr k) =
      if k = i then t * v (Sum.inl i) + v (Sum.inr i) else v (Sum.inr k) := by
  rw [spLZ_mulVec_inr, single_mulVec_apply]
  by_cases h : k = i
  · subst h; simp
  · simp [h]

lemma spNZ_single_inl (i : Fin g) (t : ℤ) (v : Fin g ⊕ Fin g → ℤ) (k : Fin g) :
    ((spNZ (single i i t) (single_diag_symm i t) : MatZ g) *ᵥ v) (Sum.inl k) =
      if k = i then v (Sum.inl i) + t * v (Sum.inr i) else v (Sum.inl k) := by
  rw [spNZ_mulVec_inl, single_mulVec_apply]
  by_cases h : k = i
  · subst h; simp
  · simp [h]

/-- The partial $J_i = n(E_{ii})\,\bar n(-E_{ii})\,n(E_{ii})$: $(a_i, c_i) \mapsto (c_i, -a_i)$. -/
def pJ (i : Fin g) : SpZ g :=
  spNZ (single i i 1) (single_diag_symm i 1) * spLZ (single i i (-1)) (single_diag_symm i (-1)) *
    spNZ (single i i 1) (single_diag_symm i 1)

lemma pJ_mem (i : Fin g) : pJ i ∈ Gam g :=
  mul_mem (mul_mem (spNZ_mem _ _) (spLZ_mem _ _)) (spNZ_mem _ _)

@[simp] lemma pJ_mulVec_inl (i : Fin g) (v : Fin g ⊕ Fin g → ℤ) (k : Fin g) :
    ((pJ i : MatZ g) *ᵥ v) (Sum.inl k) = if k = i then v (Sum.inr i) else v (Sum.inl k) := by
  by_cases h : k = i
  · subst h; simp only [pJ, coe_mul_mulVec]; simp [-mulVec_mulVec, single_mulVec_apply]
  · simp only [pJ, coe_mul_mulVec]; simp [-mulVec_mulVec, single_mulVec_apply, h]

@[simp] lemma pJ_mulVec_inr (i : Fin g) (v : Fin g ⊕ Fin g → ℤ) (k : Fin g) :
    ((pJ i : MatZ g) *ᵥ v) (Sum.inr k) = if k = i then -v (Sum.inl i) else v (Sum.inr k) := by
  by_cases h : k = i
  · subst h; simp only [pJ, coe_mul_mulVec]; simp [-mulVec_mulVec, single_mulVec_apply]
  · simp only [pJ, coe_mul_mulVec]; simp [-mulVec_mulVec, single_mulVec_apply, h]

/-- $J_i\,n(t(E_{ik} + E_{ki}))\,J_i$ ($i \ne k$): $a_i \mapsto -a_i$, $c_i \mapsto -c_i - t c_k$,
$a_k \mapsto a_k - t a_i$. -/
def pX (i k : Fin g) (t : ℤ) : SpZ g :=
  pJ i * spNZ (single i k t + single k i t) (single_pair_symm i k t) * pJ i

lemma pX_mem (i k : Fin g) (t : ℤ) : pX i k t ∈ Gam g :=
  mul_mem (mul_mem (pJ_mem _) (spNZ_mem _ _)) (pJ_mem _)

lemma pX_mulVec_inl {i k : Fin g} (hik : i ≠ k) (t : ℤ) (v : Fin g ⊕ Fin g → ℤ) (p : Fin g) :
    ((pX i k t : MatZ g) *ᵥ v) (Sum.inl p) =
      if p = i then -v (Sum.inl i) else if p = k then v (Sum.inl k) - t * v (Sum.inl i) else v (Sum.inl p) := by
  have hki : k ≠ i := Ne.symm hik
  by_cases h1 : p = i
  · subst h1; simp only [pX, coe_mul_mulVec]; simp [-mulVec_mulVec]
  · by_cases h2 : p = k
    · subst h2; simp only [pX, coe_mul_mulVec]; simp [-mulVec_mulVec, add_mulVec, single_mulVec_apply, hki]; ring
    · simp only [pX, coe_mul_mulVec]; simp [-mulVec_mulVec, add_mulVec, single_mulVec_apply, h1, h2]

lemma pX_mulVec_inr {i k : Fin g} (hik : i ≠ k) (t : ℤ) (v : Fin g ⊕ Fin g → ℤ) (p : Fin g) :
    ((pX i k t : MatZ g) *ᵥ v) (Sum.inr p) =
      if p = i then -v (Sum.inr i) - t * v (Sum.inr k) else v (Sum.inr p) := by
  have hki : k ≠ i := Ne.symm hik
  by_cases h1 : p = i
  · subst h1; simp only [pX, coe_mul_mulVec]; simp [-mulVec_mulVec, add_mulVec, single_mulVec_apply, hik, hki]; ring
  · simp only [pX, coe_mul_mulVec]; simp [-mulVec_mulVec, h1]

/-! ### Elements fixing $e_{\mathrm{inl}\,l}$ for $l < j$ -/

/-- `Fixes j M`: $M e_{\mathrm{inl}\,l} = e_{\mathrm{inl}\,l}$ for every $l < j$. -/
def Fixes (j : ℕ) (M : SpZ g) : Prop :=
  ∀ l : Fin g, l.val < j → (M : MatZ g) *ᵥ ev (Sum.inl l) = ev (Sum.inl l)

/-- The elements of $\Gamma'$ fixing $e_{\mathrm{inl}\,l}$ for every $l < j$. -/
def Gj (j : ℕ) : Set (SpZ g) := {γ | γ ∈ Gam g ∧ Fixes j γ}

lemma Gj_mul {j : ℕ} {γ δ : SpZ g} (hγ : γ ∈ Gj j) (hδ : δ ∈ Gj j) : γ * δ ∈ Gj j :=
  ⟨mul_mem hγ.1 hδ.1, fun l hl => by rw [coe_mul_mulVec, hδ.2 l hl, hγ.2 l hl]⟩

lemma fixes_mul {j : ℕ} {γ M : SpZ g} (hγ : Fixes j γ) (hM : Fixes j M) : Fixes j (γ * M) :=
  fun l hl => by rw [coe_mul_mulVec, hM l hl, hγ l hl]

lemma spNZ_mem_Gj (j : ℕ) (B : Matrix (Fin g) (Fin g) ℤ) (hB : Bᵀ = B) : spNZ B hB ∈ Gj j := by
  refine ⟨spNZ_mem B hB, fun l _ => funext fun p => ?_⟩
  rcases p with q | q
  · have : (ev (Sum.inl l) ∘ Sum.inr : Fin g → ℤ) = 0 := by ext; simp
    simp [this]
  · simp

lemma spLZ_mem_Gj {j : ℕ} {i : Fin g} (hi : j ≤ i.val) (t : ℤ) :
    spLZ (single i i t) (single_diag_symm i t) ∈ Gj j := by
  refine ⟨spLZ_mem _ _, fun l hl => funext fun p => ?_⟩
  have hli : i ≠ l := fun h => by subst h; omega
  rcases p with q | q
  · simp
  · simp [single_mulVec_apply, hli]

lemma pJ_mem_Gj {j : ℕ} {i : Fin g} (hi : j ≤ i.val) : pJ i ∈ Gj j := by
  refine ⟨pJ_mem i, fun l hl => funext fun p => ?_⟩
  have hli : l ≠ i := fun h => by subst h; omega
  rcases p with q | q <;> by_cases h : q = i <;> simp [Pi.single_apply, h, Ne.symm hli]

lemma pX_mem_Gj {j : ℕ} {i k : Fin g} (hi : j ≤ i.val) (t : ℤ) : pX i k t ∈ Gj j :=
  Gj_mul (Gj_mul (pJ_mem_Gj hi) (spNZ_mem_Gj j _ _)) (pJ_mem_Gj hi)

/-! ### The column $v = M e_{\mathrm{inl}\,j}$ -/

lemma col_eq {j : ℕ} {M : SpZ g} (hM : Fixes j M) {l : Fin g} (hl : l.val < j) (p : Fin g ⊕ Fin g) :
    (M : MatZ g) p (Sum.inl l) = ev (Sum.inl l) p := by
  rw [← mulVec_ev (M : MatZ g) (Sum.inl l) p, hM l hl]

lemma J_mulVec_inl (v : Fin g ⊕ Fin g → ℤ) (l : Fin g) :
    (Matrix.J (Fin g) ℤ *ᵥ v) (Sum.inl l) = -v (Sum.inr l) := by
  simp [Matrix.J, fromBlocks_mulVec, Matrix.neg_mulVec]

/-- The coordinates $c_l$, $l < j$, of $M e_{\mathrm{inl}\,j}$ vanish (from $M^{\mathsf T} J M = J$). -/
lemma inr_eq_zero {M : SpZ g} (j0 : Fin g) (hM : Fixes j0.val M) {l : Fin g} (hl : l.val < j0.val) :
    ((M : MatZ g) *ᵥ ev (Sum.inl j0)) (Sum.inr l) = 0 := by
  have hT : (M : MatZ g)ᵀ * Matrix.J (Fin g) ℤ * M = Matrix.J (Fin g) ℤ :=
    (SymplecticGroup.mem_iff').mp M.2
  have h := congrFun (congrArg (· *ᵥ ev (Sum.inl j0)) hT) (Sum.inl l)
  rw [J_mulVec_inl, ← mulVec_mulVec, ← mulVec_mulVec, mulVec_transpose] at h
  have hcol : (fun p => (M : MatZ g) p (Sum.inl l)) = ev (Sum.inl l) := funext (col_eq hM hl)
  have hne : l ≠ j0 := fun h => by subst h; omega
  rw [vecMul, hcol, dotProduct_single, J_mulVec_inl] at h
  simpa [Pi.single_apply] using h

lemma coe_inv_mul (M : SpZ g) : (↑(M⁻¹) : MatZ g) * M = 1 := by
  rw [← Submonoid.coe_mul, inv_mul_cancel]; rfl

/-- If, in the region $i \ge j$, only the coordinate $a_i$ of $M e_{\mathrm{inl}\,j}$ can be nonzero, it is a unit. -/
lemma isUnit_of_single {M : SpZ g} (j0 : Fin g) (hM : Fixes j0.val M) (i : Fin g) (_hi : j0 ≤ i)
    (hA : ∀ k : Fin g, j0 ≤ k → k ≠ i → ((M : MatZ g) *ᵥ ev (Sum.inl j0)) (Sum.inl k) = 0)
    (hC : ∀ k : Fin g, j0 ≤ k → ((M : MatZ g) *ᵥ ev (Sum.inl j0)) (Sum.inr k) = 0) :
    IsUnit (((M : MatZ g) *ᵥ ev (Sum.inl j0)) (Sum.inl i)) := by
  set v := (M : MatZ g) *ᵥ ev (Sum.inl j0) with hv
  set N := (↑(M⁻¹) : MatZ g)
  have hNv : N *ᵥ v = ev (Sum.inl j0) := by rw [hv, mulVec_mulVec, coe_inv_mul, one_mulVec]
  have hNl : ∀ l : Fin g, l.val < j0.val → N (Sum.inl j0) (Sum.inl l) = 0 := by
    intro l hl
    have hne : j0 ≠ l := fun h => by subst h; omega
    have : N *ᵥ ev (Sum.inl l) = ev (Sum.inl l) := by
      rw [← hM l hl, mulVec_mulVec, coe_inv_mul, one_mulVec, hM l hl]
    have := congrFun this (Sum.inl j0)
    rw [mulVec_ev] at this
    simpa [Pi.single_apply, hne] using this
  have h1 := congrFun hNv (Sum.inl j0)
  simp only [mulVec, dotProduct, Fintype.sum_sum_type, Pi.single_apply, ite_true] at h1
  have h2 : ∑ x : Fin g, N (Sum.inl j0) (Sum.inr x) * v (Sum.inr x) = 0 := by
    refine Finset.sum_eq_zero fun l _ => ?_
    rcases lt_or_ge l.val j0.val with hl | hl
    · rw [hv, inr_eq_zero j0 hM hl, mul_zero]
    · rw [hC l hl, mul_zero]
  have h3 : ∑ x : Fin g, N (Sum.inl j0) (Sum.inl x) * v (Sum.inl x) =
      N (Sum.inl j0) (Sum.inl i) * v (Sum.inl i) := by
    refine Finset.sum_eq_single i (fun l _ hli => ?_) (by simp)
    rcases lt_or_ge l.val j0.val with hl | hl
    · rw [hNl l hl, zero_mul]
    · rw [hA l hl hli, mul_zero]
  rw [h2, h3, add_zero] at h1
  exact IsUnit.of_mul_eq_one_right _ h1

/-! ### The descent -/

/-- The weight of the pair $(a_i, c_i)$: $2|a_i| + 2|c_i| + [c_i \ne 0]$. -/
def wt (x y : ℤ) : ℕ := 2 * x.natAbs + 2 * y.natAbs + if y = 0 then 0 else 1

/-- The measure $\nu(v) = \sum_{i \ge j} \mathrm{wt}(a_i, c_i)$. -/
def nu (j0 : Fin g) (v : Fin g ⊕ Fin g → ℤ) : ℕ :=
  ∑ k : Fin g, if j0 ≤ k then wt (v (Sum.inl k)) (v (Sum.inr k)) else 0

lemma nu_lt {j0 : Fin g} {v v' : Fin g ⊕ Fin g → ℤ}
    (hle : ∀ k, j0 ≤ k → wt (v' (Sum.inl k)) (v' (Sum.inr k)) ≤ wt (v (Sum.inl k)) (v (Sum.inr k)))
    (k : Fin g) (hk : j0 ≤ k) (hlt : wt (v' (Sum.inl k)) (v' (Sum.inr k)) < wt (v (Sum.inl k)) (v (Sum.inr k))) :
    nu j0 v' < nu j0 v := by
  refine Finset.sum_lt_sum (fun l _ => ?_) ⟨k, Finset.mem_univ _, by simpa [hk] using hlt⟩
  split_ifs with h
  · exact hle l h
  · exact le_rfl

lemma natAbs_emod_lt {b : ℤ} (a : ℤ) (hb : b ≠ 0) : (a % b).natAbs < b.natAbs := by
  have h0 := Int.emod_nonneg a hb
  have h1 := Int.emod_lt a hb
  rw [Int.natCast_natAbs] at h1
  zify
  rw [abs_of_nonneg h0]
  exact h1

lemma add_neg_ediv_mul (a b : ℤ) : a + -(a / b) * b = a % b := by
  rw [Int.emod_def]; ring

lemma wt_lt_of_c (x y y' : ℤ) (hy : y ≠ 0) (h : y'.natAbs < y.natAbs) : wt x y' < wt x y := by
  unfold wt; split_ifs <;> omega

lemma wt_lt_of_a (x x' y : ℤ) (h : x'.natAbs < x.natAbs) : wt x' y ≤ wt x y ∧ wt x' y < wt x y := by
  unfold wt; constructor <;> omega

/-! ### The end of the descent -/

/-- `Reach j v u`: some element of $\Gamma'$ fixing $e_{\mathrm{inl}\,l}$ ($l < j$) maps $v$ to $u$. -/
def Reach (j : ℕ) (v u : Fin g ⊕ Fin g → ℤ) : Prop := ∃ δ : SpZ g, δ ∈ Gj j ∧ (δ : MatZ g) *ᵥ v = u

lemma reach_step {j : ℕ} {v u : Fin g ⊕ Fin g → ℤ} (δ : SpZ g) (hδ : δ ∈ Gj j)
    (h : Reach j ((δ : MatZ g) *ᵥ v) u) : Reach j v u := by
  obtain ⟨γ, hγ, hγu⟩ := h
  exact ⟨γ * δ, Gj_mul hγ hδ, by rw [coe_mul_mulVec, hγu]⟩

/-- The symmetric matrix with $S_{p j} = S_{j p} = x_p$ for $p < j$ and all other entries $0$. -/
def clearM (j0 : Fin g) (x : Fin g → ℤ) : Matrix (Fin g) (Fin g) ℤ :=
  Matrix.of fun p q => if q = j0 then (if p < j0 then x p else 0) else if p = j0 then (if q < j0 then x q else 0) else 0

lemma clearM_symm (j0 : Fin g) (x : Fin g → ℤ) : (clearM j0 x)ᵀ = clearM j0 x := by
  ext p q
  simp only [clearM, transpose_apply, of_apply]
  by_cases hp : p = j0 <;> by_cases hq : q = j0
  · subst hp; subst hq; simp
  · subst hp; simp [hq]
  · subst hq; simp [hp]
  · simp [hp, hq]

/-- $a_j = 1$, $a_k = 0$ for $k > j$, $c = 0$: then $J_j^3\,n(S)\,J_j$ maps $v$ to $e_{\mathrm{inl}\,j}$. -/
lemma reach_one (j0 : Fin g) (v : Fin g ⊕ Fin g → ℤ) (h1 : v (Sum.inl j0) = 1)
    (hA : ∀ k : Fin g, j0 < k → v (Sum.inl k) = 0) (hC : ∀ k : Fin g, v (Sum.inr k) = 0) :
    Reach j0.val v (ev (Sum.inl j0)) := by
  refine reach_step (pJ j0) (pJ_mem_Gj le_rfl) ?_
  set x : Fin g → ℤ := fun p => v (Sum.inl p)
  refine reach_step (spNZ (clearM j0 x) (clearM_symm j0 x)) (spNZ_mem_Gj _ _ _) ?_
  refine reach_step (pJ j0 * pJ j0 * pJ j0) (Gj_mul (Gj_mul (pJ_mem_Gj le_rfl) (pJ_mem_Gj le_rfl))
    (pJ_mem_Gj le_rfl)) ?_
  refine ⟨1, ⟨one_mem _, fun l _ => one_mulVec _⟩, ?_⟩
  have hc : ((pJ j0 : MatZ g) *ᵥ v) ∘ Sum.inr = -Pi.single j0 1 := by
    ext k; by_cases hk : k = j0 <;> simp [hk, h1, hC]
  have hS : ∀ p, (clearM j0 x *ᵥ (((pJ j0 : MatZ g) *ᵥ v) ∘ Sum.inr)) p = -(clearM j0 x p j0) := by
    intro p; rw [hc, mulVec_neg, mulVec_single]; simp
  ext p
  rcases p with k | k
  · simp only [Submonoid.coe_one, one_mulVec, coe_mul_mulVec, pJ_mulVec_inl, pJ_mulVec_inr, spNZ_mulVec_inl,
      spNZ_mulVec_inr, hS]
    rcases lt_trichotomy k j0 with hk | hk | hk
    · have : k ≠ j0 := ne_of_lt hk
      simp [this, clearM, hk, x]
    · subst hk; simp [h1]
    · have : k ≠ j0 := ne_of_gt hk
      simp [this, clearM, hA k hk, not_lt_of_gt hk]
  · simp only [Submonoid.coe_one, one_mulVec, coe_mul_mulVec, pJ_mulVec_inl, pJ_mulVec_inr, spNZ_mulVec_inl,
      spNZ_mulVec_inr, hS]
    by_cases hk : k = j0
    · subst hk; simp [clearM, hC]
    · simp [hk, hC]

/-- $a_j = \pm1$, $a_k = 0$ for $k > j$, $c = 0$. -/
lemma reach_unit (j0 : Fin g) (v : Fin g ⊕ Fin g → ℤ) (hu : IsUnit (v (Sum.inl j0)))
    (hA : ∀ k : Fin g, j0 < k → v (Sum.inl k) = 0) (hC : ∀ k : Fin g, v (Sum.inr k) = 0) :
    Reach j0.val v (ev (Sum.inl j0)) := by
  rcases Int.isUnit_iff.mp hu with h | h
  · exact reach_one j0 v h hA hC
  · refine reach_step (pJ j0 * pJ j0) (Gj_mul (pJ_mem_Gj le_rfl) (pJ_mem_Gj le_rfl)) ?_
    refine reach_one j0 _ ?_ (fun k hk => ?_) (fun k => ?_)
    · simp only [coe_mul_mulVec]; simp [-mulVec_mulVec, h]
    · simp only [coe_mul_mulVec]; simp [-mulVec_mulVec, (ne_of_gt hk), hA k hk]
    · by_cases hk : k = j0 <;> simp only [coe_mul_mulVec] <;> simp [-mulVec_mulVec, hk, hC]

/-- The end of the descent: in the region only $a_i = \pm1$ is nonzero, and $c = 0$. -/
lemma reach_end (j0 i : Fin g) (hi : j0 ≤ i) (v : Fin g ⊕ Fin g → ℤ) (hu : IsUnit (v (Sum.inl i)))
    (hA : ∀ k : Fin g, j0 ≤ k → k ≠ i → v (Sum.inl k) = 0) (hC : ∀ k : Fin g, v (Sum.inr k) = 0) :
    Reach j0.val v (ev (Sum.inl j0)) := by
  by_cases hij : i = j0
  · subst hij
    exact reach_unit i v hu (fun k hk => hA k hk.le (ne_of_gt hk)) hC
  set u := v (Sum.inl i) with hu_def
  have hu2 : u * u = 1 := by rcases Int.isUnit_iff.mp hu with h | h <;> rw [h] <;> norm_num
  have hj0 : v (Sum.inl j0) = 0 := hA j0 le_rfl (Ne.symm hij)
  have hji : j0 ≠ i := Ne.symm hij
  refine reach_step (pX i j0 (-u)) (pX_mem_Gj hi _) ?_
  refine reach_step (pX j0 i (-u)) (pX_mem_Gj le_rfl _) ?_
  refine reach_unit j0 _ ?_ (fun k hk => ?_) (fun k => ?_)
  · rw [pX_mulVec_inl hji]
    simp [pX_mulVec_inl hij, hji, hj0, ← hu_def, hu2]
  · have hk0 : k ≠ j0 := ne_of_gt hk
    rw [pX_mulVec_inl hji]
    by_cases hki : k = i
    · subst hki; simp [pX_mulVec_inl hij, hk0, hji, hj0, ← hu_def, hu2]
    · simp [pX_mulVec_inl hij, hk0, hki, hA k hk.le hki]
  · rw [pX_mulVec_inr hji]
    split_ifs <;> simp [pX_mulVec_inr hij, hC]

/-- **One step**: from $M$ fixing $e_{\mathrm{inl}\,l}$ ($l < j$) to $\gamma M$ also fixing $e_{\mathrm{inl}\,j}$. -/
theorem exists_fix_next (j0 : Fin g) :
    ∀ (n : ℕ) (M : SpZ g), Fixes j0.val M → nu j0 ((M : MatZ g) *ᵥ ev (Sum.inl j0)) = n →
      ∃ γ : SpZ g, γ ∈ Gj j0.val ∧ (↑(γ * M) : MatZ g) *ᵥ ev (Sum.inl j0) = ev (Sum.inl j0) := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro M hM hn
  set v := (M : MatZ g) *ᵥ ev (Sum.inl j0) with hv
  -- reduction by an element δ that lowers ν
  have red : ∀ δ : SpZ g, δ ∈ Gj j0.val → nu j0 ((δ : MatZ g) *ᵥ v) < n →
      ∃ γ : SpZ g, γ ∈ Gj j0.val ∧ (↑(γ * M) : MatZ g) *ᵥ ev (Sum.inl j0) = ev (Sum.inl j0) := by
    intro δ hδ hlt
    obtain ⟨γ, hγ, hγe⟩ := ih _ hlt (δ * M) (fixes_mul hδ.2 hM) (by rw [coe_mul_mulVec])
    exact ⟨γ * δ, Gj_mul hγ hδ, by rw [mul_assoc, hγe]⟩
  -- Case A: a pair $(a_i, c_i)$ with both entries nonzero
  by_cases hA : ∃ i : Fin g, j0 ≤ i ∧ v (Sum.inl i) ≠ 0 ∧ v (Sum.inr i) ≠ 0
  · obtain ⟨i, hi, ha, hc⟩ := hA
    rcases le_or_gt (v (Sum.inl i)).natAbs (v (Sum.inr i)).natAbs with hle | hlt
    · set t := -(v (Sum.inr i) / v (Sum.inl i))
      have key : wt (((spLZ (single i i t) (single_diag_symm _ _) : MatZ g) *ᵥ v) (Sum.inl i))
          (((spLZ (single i i t) (single_diag_symm _ _) : MatZ g) *ᵥ v) (Sum.inr i)) <
          wt (v (Sum.inl i)) (v (Sum.inr i)) := by
        rw [spLZ_mulVec_inl, spLZ_single_inr, ite_eq_left rfl, add_comm, add_neg_ediv_mul]
        exact wt_lt_of_c _ _ _ hc ((natAbs_emod_lt _ ha).trans_le hle)
      refine red (spLZ (single i i t) (single_diag_symm _ _)) (spLZ_mem_Gj hi t) ?_
      rw [← hn]
      refine nu_lt (fun k _ => ?_) i hi key
      by_cases hk : k = i
      · subst hk; exact key.le
      · rw [spLZ_mulVec_inl, spLZ_single_inr, ite_eq_right hk]
    · set t := -(v (Sum.inl i) / v (Sum.inr i))
      have key : wt (((spNZ (single i i t) (single_diag_symm _ _) : MatZ g) *ᵥ v) (Sum.inl i))
          (((spNZ (single i i t) (single_diag_symm _ _) : MatZ g) *ᵥ v) (Sum.inr i)) <
          wt (v (Sum.inl i)) (v (Sum.inr i)) := by
        rw [spNZ_single_inl, spNZ_mulVec_inr, ite_eq_left rfl, add_neg_ediv_mul]
        exact (wt_lt_of_a _ _ _ ((natAbs_emod_lt _ hc).trans hlt)).2
      refine red (spNZ (single i i t) (single_diag_symm _ _)) (spNZ_mem_Gj _ _ _) ?_
      rw [← hn]
      refine nu_lt (fun k _ => ?_) i hi key
      by_cases hk : k = i
      · subst hk; exact key.le
      · rw [spNZ_single_inl, spNZ_mulVec_inr, ite_eq_right hk]
  push Not at hA
  -- Case B: $a_i = 0 \ne c_i$
  by_cases hB : ∃ i : Fin g, j0 ≤ i ∧ v (Sum.inr i) ≠ 0
  · obtain ⟨i, hi, hc⟩ := hB
    have ha : v (Sum.inl i) = 0 := by
      by_contra h; exact hc (hA i hi h)
    refine red (pJ i) (pJ_mem_Gj hi) ?_
    rw [← hn]
    refine nu_lt (fun k _ => ?_) i hi ?_
    · by_cases hk : k = i
      · subst hk; simp only [pJ_mulVec_inl, pJ_mulVec_inr, ha, neg_zero]; unfold wt; simp
      · simp [hk]
    · simp only [pJ_mulVec_inl, pJ_mulVec_inr, ha, neg_zero]; unfold wt; simp [hc]
  push Not at hB
  -- Case C: all $c_i = 0$ and two nonzero $a_i$, $a_k$
  by_cases hCc : ∃ i k : Fin g, j0 ≤ i ∧ j0 ≤ k ∧ i ≠ k ∧ v (Sum.inl i) ≠ 0 ∧ v (Sum.inl k) ≠ 0 ∧
      (v (Sum.inl i)).natAbs ≤ (v (Sum.inl k)).natAbs
  · obtain ⟨i, k, hi, hk, hik, hai, hak, hle⟩ := hCc
    have key : wt (((pX i k (v (Sum.inl k) / v (Sum.inl i)) : MatZ g) *ᵥ v) (Sum.inl k))
        (((pX i k (v (Sum.inl k) / v (Sum.inl i)) : MatZ g) *ᵥ v) (Sum.inr k)) <
        wt (v (Sum.inl k)) (v (Sum.inr k)) := by
      rw [pX_mulVec_inl hik, pX_mulVec_inr hik, ite_eq_right (Ne.symm hik), ite_eq_right (Ne.symm hik), ite_eq_left rfl]
      have : v (Sum.inl k) - v (Sum.inl k) / v (Sum.inl i) * v (Sum.inl i) = v (Sum.inl k) % v (Sum.inl i) := by
        rw [Int.emod_def]; ring
      rw [this]
      exact (wt_lt_of_a _ _ _ ((natAbs_emod_lt _ hai).trans_le hle)).2
    have hlt : nu j0 ((pX i k (v (Sum.inl k) / v (Sum.inl i)) : MatZ g) *ᵥ v) < n := by
      rw [← hn]
      refine nu_lt (fun l _ => ?_) k hk key
      by_cases hl : l = k
      · subst hl; exact key.le
      · by_cases hli : l = i
        · subst hli
          rw [pX_mulVec_inl hik, pX_mulVec_inr hik, ite_eq_left rfl, ite_eq_left rfl, hB l hi, hB k hk]
          unfold wt; simp
        · rw [pX_mulVec_inl hik, pX_mulVec_inr hik, ite_eq_right hli, ite_eq_right hli, ite_eq_right hl]
    exact red _ (pX_mem_Gj hi _) hlt
  push Not at hCc
  -- Case D: in the region only one $a_i$ can be nonzero, and every $c_i = 0$
  have hCall : ∀ k : Fin g, v (Sum.inr k) = 0 := by
    intro k
    rcases lt_or_ge k j0 with hk | hk
    · exact inr_eq_zero j0 hM hk
    · exact hB k hk
  by_cases hE : ∃ i : Fin g, j0 ≤ i ∧ v (Sum.inl i) ≠ 0
  · obtain ⟨i, hi, hai⟩ := hE
    have hothers : ∀ k : Fin g, j0 ≤ k → k ≠ i → v (Sum.inl k) = 0 := by
      intro k hk hki
      by_contra hak
      rcases le_total (v (Sum.inl i)).natAbs (v (Sum.inl k)).natAbs with h | h
      · exact hCc i k hi hk (Ne.symm hki) hai hak |>.not_ge h
      · exact hCc k i hk hi hki hak hai |>.not_ge h
    have hu := isUnit_of_single j0 hM i hi hothers (fun k _ => hCall k)
    obtain ⟨δ, hδ, hδv⟩ := reach_end j0 i hi v hu hothers hCall
    exact ⟨δ, hδ, by rw [coe_mul_mulVec, hδv]⟩
  · push Not at hE
    have hu := isUnit_of_single j0 hM j0 le_rfl (fun k hk _ => hE k hk) (fun k _ => hCall k)
    have h0 := hE j0 le_rfl
    rw [hv] at h0
    rw [h0] at hu
    exact absurd hu not_isUnit_zero

/-! ### Induction on $j$ -/

lemma exists_fixes : ∀ j ≤ g, ∀ M : SpZ g, ∃ γ : SpZ g, γ ∈ Gam g ∧ Fixes j (γ * M)
  | 0, _, M => ⟨1, one_mem _, fun _ hl => absurd hl (Nat.not_lt_zero _)⟩
  | j + 1, hj, M => by
    obtain ⟨γ, hγ, hf⟩ := exists_fixes j (by omega) M
    set j0 : Fin g := ⟨j, by omega⟩
    obtain ⟨δ, hδ, hδe⟩ := exists_fix_next j0 _ (γ * M) hf rfl
    refine ⟨δ * γ, mul_mem hδ.1 hγ, fun l hl => ?_⟩
    rw [mul_assoc]
    rcases Nat.lt_succ_iff_lt_or_eq.mp hl with hl | hl
    · exact fixes_mul hδ.2 hf l hl
    · have : l = j0 := Fin.ext hl
      subst this; exact hδe

/-- An element fixing every $e_{\mathrm{inl}\,l}$ is a translation $n(B)$. -/
lemma mem_of_fixes_all (M : SpZ g) (h : Fixes g M) : M ∈ Gam g := by
  have hcol : ∀ l : Fin g, ∀ p, (M : MatZ g) p (Sum.inl l) = ev (Sum.inl l) p := fun l p => col_eq h l.2 p
  have h11 : (M : MatZ g).toBlocks₁₁ = 1 := by
    ext i l; rw [toBlocks₁₁, of_apply, hcol]; simp [Pi.single_apply, Matrix.one_apply]
  have h21 : (M : MatZ g).toBlocks₂₁ = 0 := by
    ext i l; rw [toBlocks₂₁, of_apply, hcol]; simp
  have hM : (M : MatZ g) = fromBlocks 1 (M : MatZ g).toBlocks₁₂ 0 (M : MatZ g).toBlocks₂₂ := by
    conv_lhs => rw [← fromBlocks_toBlocks (M : MatZ g), h11, h21]
  have hmem := M.2
  rw [hM, SymplecticGroup.fromBlocks_mem_iff] at hmem
  obtain ⟨-, h2, h3⟩ := hmem
  simp only [transpose_one, Matrix.one_mul, transpose_zero, Matrix.zero_mul, sub_zero] at h3
  rw [h3, Matrix.mul_one, transpose_one, Matrix.one_mul] at h2
  have : M = spNZ _ h2 := Subtype.ext (hM.trans (by rw [h3]; rfl))
  rw [this]; exact spNZ_mem _ _

end SpZGen

/-- **$\mathrm{Sp}_{2g}(\mathbb Z)$ is generated by $J$ and the translations.** For every $g$, the subgroup of
$\mathrm{Sp}_{2g}(\mathbb Z)$ generated by $J = \begin{pmatrix}0&-1\\1&0\end{pmatrix}$ and the translations
$\begin{pmatrix}1&B\\0&1\end{pmatrix}$, $B$ integral symmetric, is the whole group; i.e. the named input
`SpZGeneration g` holds. -/
@[kb "klingen1990" "§I.2, Prop. 1 (generators $J$ and the translations of $\\mathrm{Sp}_n(\\mathbb Z)$) [unverified]"]
theorem spZGeneration (g : ℕ) : SpZGeneration g := by
  refine ⟨eq_top_iff.mpr fun M _ => ?_⟩
  obtain ⟨γ, hγ, hf⟩ := SpZGen.exists_fixes g le_rfl M
  have h := SpZGen.mem_of_fixes_all _ hf
  have hM : M = γ⁻¹ * (γ * M) := by group
  rw [hM]
  exact mul_mem (inv_mem hγ) h

end QuadFormsKB.WeilRep.Genus
