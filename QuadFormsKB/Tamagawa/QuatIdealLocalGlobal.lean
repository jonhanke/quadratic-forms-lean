/-
# Left ideals of a maximal order: the local-global correspondence

**Layer:** $F$ a number field, $\mathcal O_F$ a PID, $D = (a,b)_F$ ($ab \ne 0$), $\mathcal O \subset D$ a maximal $\mathcal O_F$-order, $v$ the finite places
with completions $\mathcal O_v$ (`localOrder`).

For a left ideal $J$ of $\mathcal O$ (an `Ideal` of the ring $\mathcal O$; Mathlib's ideals of a noncommutative ring are left ideals) let
$\operatorname{nrd}(J) = (\operatorname{nrd}x : x \in J) \subseteq \mathcal O_F$ (`leftNrdIdeal`) and $J_v = \mathfrak o_v\,\iota_v(J) \subseteq \mathcal O_v$
(`localIdeal`). This file proves
$$\{J : \operatorname{nrd}(J) = (n)\} \;\simeq\; \prod_{v \mid n}\{I \subseteq \mathcal O_v : \operatorname{nrd}(I) = \mathfrak p_v^{v(n)}\},\qquad
  J \mapsto (J_v)_{v\mid n},$$
and hence, with the local counts, that the number of integral left ideals of reduced norm $(n)$
is $\prod_{v\mid n}a_v(v(n))$
(`card_ideal_nrd_eq_prod`): the Euler product of the zeta function $\zeta_{\mathcal O}(s) = \sum_J N(\operatorname{nrd}J)^{-s}$.

**Ingredients.**
* `algebraMap_mem_of_mem_leftNrdIdeal`: $\operatorname{nrd}(J) \subseteq J$ (as $\bar x x = \operatorname{nrd}x$ and $\bar x \in \mathcal O$), so
  $\operatorname{nrd}(J) = (n)$ forces $n\mathcal O \subseteq J$.
* `leftNrdIdeal_localIdeal`: $\operatorname{nrd}(J_v) = \operatorname{nrd}(J)\,\mathfrak o_v$ (approximate an element of $J_v$ of minimal reduced norm by an
  element of $J$; $\operatorname{nrd}(y + \pi^mz) \equiv \operatorname{nrd}(y) \bmod \pi^m$).
* `eq_of_localIdeal_eq` (local-global principle for left ideals containing $n\mathcal O$) and `exists_localIdeal_eq` (existence),
  both by the Chinese remainder theorem in $\mathcal O_F$ (`IsDedekindDomain.exists_forall_sub_mem_ideal`) and weak approximation.

Sources: Voight, *Quaternion Algebras* (2021), Thm. 9.4.9 and Lemma 9.5.3 (local-global dictionary for lattices, with completions),
Def. 16.3.1 (reduced norm of a lattice), Prop. 26.3.9 and (26.3.12) (multiplicativity and Euler product of $\zeta_{\mathcal O}$), §26.4 (the
local-global bijection for ideals of prime-power norm); locators checked in the author's PDF.
-/
import QuadFormsKB.Tamagawa.QuatOrderIdeals

open NumberField IsDedekindDomain Quaternion

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.QuatOrder

open QuadFormsKB.Quat QuadFormsKB.LocalDensity.NF IsLocalization

/-! ### Reduced norms lie in the ideal -/

section Basic

variable {R K : Type*} [CommRing R] [IsDomain R] [Field K] [Algebra R K] [IsFractionRing R K] [IsIntegrallyClosed R]
  {a b : K}

theorem star_smul_quat {K : Type*} [Field K] {a b : K} (c : K) (x : ℍ[K,a,b]) : star (c • x) = c • star x := by
  ext <;> simp

theorem star_eq_trd_sub (x : ℍ[K,a,b]) : star x = algebraMap K ℍ[K,a,b] (trd x) - x := by
  rw [QuaternionAlgebra.star_eq_two_re_sub, trd, zero_mul, add_zero]; rfl

/-- **Orders are closed under conjugation:** $\bar x = \operatorname{trd}(x) - x \in \mathcal O$. -/
theorem star_mem_of_isOrder {O : Subalgebra R ℍ[K,a,b]} (hO : IsOrder R K O) {x : ℍ[K,a,b]} (hx : x ∈ O) :
    star x ∈ O := by
  obtain ⟨t, ht⟩ := (isInteger_trd_nrd hO hx).1
  rw [star_eq_trd_sub, ← ht, ← IsScalarTower.algebraMap_apply]
  exact O.sub_mem (O.algebraMap_mem t) hx

/-- **The reduced norm ideal lies in the ideal:** for a left ideal $J$ of an order $\mathcal O$ and $r \in \operatorname{nrd}(J)$,
$r \in J$ (since $\bar xx = \operatorname{nrd}(x)$ with $\bar x \in \mathcal O$). -/
theorem algebraMap_mem_of_mem_leftNrdIdeal {O : Subalgebra R ℍ[K,a,b]} (hO : IsOrder R K O) (J : Ideal O) {r : R}
    (hr : r ∈ leftNrdIdeal J) : algebraMap R O r ∈ J := by
  induction hr using Submodule.span_induction with
  | mem s hs =>
    obtain ⟨x, hx, hs⟩ := hs
    have h1 : algebraMap R O s = ⟨star (x : ℍ[K,a,b]), star_mem_of_isOrder hO x.2⟩ * x := by
      apply Subtype.ext
      rw [Subalgebra.coe_mul, star_mul_eq_nrd, ← hs]
      simp only [Subalgebra.coe_algebraMap]
      rw [IsScalarTower.algebraMap_apply R K ℍ[K,a,b]]; rfl
    rw [h1]; exact J.mul_mem_left _ hx
  | zero => rw [map_zero]; exact J.zero_mem
  | add s t _ _ hs ht => rw [map_add]; exact J.add_mem hs ht
  | smul c s _ hs =>
    rw [smul_eq_mul, map_mul]
    exact J.mul_mem_left _ hs

/-- If $\operatorname{nrd}(J) = (n)$ then $n\mathcal O \subseteq J$. -/
theorem smul_mem_of_leftNrdIdeal_eq {O : Subalgebra R ℍ[K,a,b]} (hO : IsOrder R K O) {J : Ideal O} {n : R}
    (hJ : leftNrdIdeal J = Ideal.span {n}) (x : O) : x * algebraMap R O n ∈ J :=
  J.mul_mem_left _ (algebraMap_mem_of_mem_leftNrdIdeal hO J (hJ ▸ Ideal.mem_span_singleton_self n))

end Basic

/-! ### Ideals in a Noetherian valuation ring generated by a set -/

section ValSpan

variable {R : Type*} [CommRing R] [IsDomain R] [ValuationRing R] [IsNoetherianRing R]

/-- In a Noetherian valuation ring the ideal generated by a nonempty set $S$ is generated by one element of $S$. -/
theorem exists_span_eq_span_singleton {S : Set R} (hS : S.Nonempty) :
    ∃ s ∈ S, Ideal.span S = Ideal.span {s} := by
  let T : Set (Ideal R) := {J | ∃ s ∈ S, J = Ideal.span {s}}
  obtain ⟨_, ⟨s0, hs0, rfl⟩, hmax⟩ :=
    set_has_maximal_iff_noetherian.2 inferInstance T (let ⟨s, hs⟩ := hS; ⟨_, s, hs, rfl⟩)
  refine ⟨s0, hs0, le_antisymm ?_ (Ideal.span_mono (Set.singleton_subset_iff.2 hs0))⟩
  rw [Ideal.span_le]
  intro t ht
  have : Ideal.span {t} ≤ Ideal.span {s0} := by
    rcases (ValuationRing.le_total_ideal (A := R)).total (Ideal.span {t}) (Ideal.span {s0}) with h | h
    · exact h
    · rcases h.lt_or_eq with h' | h'
      · exact absurd h' (hmax _ ⟨t, ht, rfl⟩)
      · exact h'.ge
  exact this (Ideal.mem_span_singleton_self t)

end ValSpan

/-! ### Arithmetic of $\mathcal O_F$ at finitely many places -/

section Arith

variable {F : Type} [Field F] [NumberField F] [IsPrincipalIdealRing (𝓞 F)]

/-- **Divisibility is local:** if $\iota_v(\alpha) \mid \iota_v(\beta)$ in every $\mathfrak o_v$ then $\alpha \mid \beta$ in $\mathcal O_F$ ($\alpha \ne 0$). -/
theorem dvd_of_forall_ι_dvd {α β : 𝓞 F} (hα : α ≠ 0) (h : ∀ v : HeightOneSpectrum (𝓞 F), ι v α ∣ ι v β) :
    α ∣ β := by
  have hαF : algebraMap (𝓞 F) F α ≠ 0 := (map_ne_zero_iff _ (IsFractionRing.injective (𝓞 F) F)).2 hα
  set x : F := algebraMap (𝓞 F) F β / algebraMap (𝓞 F) F α
  have hx : ∀ v : HeightOneSpectrum (𝓞 F), v.valuation F x ≤ 1 := by
    intro v
    obtain ⟨c, hc⟩ := h v
    have hαv : algebraMap (v.adicCompletionIntegers F) (v.adicCompletion F) (ι v α) ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 (ι_ne_zero v hα)
    have hxc : (x : v.adicCompletion F) = algebraMap (v.adicCompletionIntegers F) (v.adicCompletion F) c := by
      have e1 : ∀ r : 𝓞 F, ((algebraMap (𝓞 F) F r : F) : v.adicCompletion F) =
          algebraMap (v.adicCompletionIntegers F) (v.adicCompletion F) (ι v r) := fun r => rfl
      have : (x : v.adicCompletion F) = ((algebraMap (𝓞 F) F β : F) : v.adicCompletion F) /
          ((algebraMap (𝓞 F) F α : F) : v.adicCompletion F) := by
        simp only [x]; exact map_div₀ (algebraMap F (v.adicCompletion F)) _ _
      rw [this, e1, e1, hc, map_mul, mul_div_cancel_left₀ _ hαv]
    rw [← HeightOneSpectrum.valuedAdicCompletion_eq_valuation', hxc]
    exact c.2
  obtain ⟨y, hy⟩ := HeightOneSpectrum.mem_integers_of_valuation_le_one (K := F) x hx
  refine ⟨y, IsFractionRing.injective (𝓞 F) F ?_⟩
  rw [map_mul, hy]
  simp only [x]
  field_simp

theorem exists_span_ι_eq (v : HeightOneSpectrum (𝓞 F)) {n : 𝓞 F} (hn : n ≠ 0) :
    ∃ e : ℕ, Ideal.span {ι v n} = Ideal.span {π v ^ e} :=
  IsDiscreteValuationRing.ideal_eq_span_pow_irreducible
    (by rw [Ne, Ideal.span_singleton_eq_bot]; exact ι_ne_zero v hn) (irreducible_π v)

open Classical in
/-- **The $v$-adic order** of $n \in \mathcal O_F$: $(\iota_v n) = (\varpi^{\operatorname{ord}_v n})$ in $\mathfrak o_v$ ($0$ for $n = 0$). -/
def ordv (v : HeightOneSpectrum (𝓞 F)) (n : 𝓞 F) : ℕ :=
  if hn : n = 0 then 0 else (exists_span_ι_eq v hn).choose

theorem span_ι_eq_ordv (v : HeightOneSpectrum (𝓞 F)) {n : 𝓞 F} (hn : n ≠ 0) :
    Ideal.span {ι v n} = Ideal.span {π v ^ ordv v n} := by
  have h := (exists_span_ι_eq v hn).choose_spec
  simpa [ordv, hn] using h

theorem ι_dvd_ι_iff (v : HeightOneSpectrum (𝓞 F)) {n : 𝓞 F} (hn : n ≠ 0) (m : 𝓞 F) :
    ι v n ∣ ι v m ↔ m ∈ v.asIdeal ^ ordv v n := by
  rw [← Ideal.mem_span_singleton, span_ι_eq_ordv v hn, ι_mem_span_π_pow]

theorem isUnit_ι_of_not_mem {v : HeightOneSpectrum (𝓞 F)} {n : 𝓞 F} (hn : n ∉ v.asIdeal) : IsUnit (ι v n) := by
  by_contra h
  have : ι v n ∈ IsLocalRing.maximalIdeal (v.adicCompletionIntegers F) := h
  rw [(irreducible_π v).maximalIdeal_eq, Ideal.mem_span_singleton, π_dvd_ι_iff] at this
  exact hn this

theorem finite_setOf_mem {n : 𝓞 F} (hn : n ≠ 0) : {v : HeightOneSpectrum (𝓞 F) | n ∈ v.asIdeal}.Finite := by
  have h := Ideal.finite_factors (I := Ideal.span {n}) (by
    rw [Ne, Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot]; exact hn)
  exact h.subset fun v hv => Ideal.dvd_span_singleton.2 hv

/-- The finite set of places $v \mid n$. -/
def primeSupport {n : 𝓞 F} (hn : n ≠ 0) : Finset (HeightOneSpectrum (𝓞 F)) := (finite_setOf_mem hn).toFinset

theorem mem_primeSupport {n : 𝓞 F} (hn : n ≠ 0) {v : HeightOneSpectrum (𝓞 F)} :
    v ∈ primeSupport hn ↔ n ∈ v.asIdeal := by
  rw [primeSupport, Set.Finite.mem_toFinset, Set.mem_ofPred_eq]

/-- **Density:** every $d \in \mathfrak o_v$ is congruent to some $\iota_v(r)$, $r \in \mathcal O_F$, modulo $\varpi^E$. -/
theorem exists_ι_sub_mem_span (v : HeightOneSpectrum (𝓞 F)) (E : ℕ) (d : v.adicCompletionIntegers F) :
    ∃ r : 𝓞 F, d - ι v r ∈ Ideal.span {π v ^ E} := by
  obtain ⟨r, hr⟩ := redHom_surjective v E (Ideal.Quotient.mk _ d)
  exact ⟨r, Ideal.Quotient.eq.1 hr.symm⟩

/-- **Simultaneous approximation (CRT + density):** given finitely many places $v \in S$, exponents $e_v$ and targets
$d_v \in \mathfrak o_v$, there is $r \in \mathcal O_F$ with $\iota_v(r) \equiv d_v \bmod \varpi_v^{e_v}$ for all $v \in S$. -/
theorem exists_approx (S : Finset (HeightOneSpectrum (𝓞 F))) (e : HeightOneSpectrum (𝓞 F) → ℕ)
    (d : ∀ v : HeightOneSpectrum (𝓞 F), v.adicCompletionIntegers F) :
    ∃ r : 𝓞 F, ∀ v ∈ S, d v - ι v r ∈ Ideal.span {π v ^ e v} := by
  have hloc : ∀ v : HeightOneSpectrum (𝓞 F), ∃ rv : 𝓞 F, d v - ι v rv ∈ Ideal.span {π v ^ e v} := by
    intro v
    obtain ⟨rv, hrv⟩ := redHom_surjective v (e v) (Ideal.Quotient.mk _ (d v))
    exact ⟨rv, Ideal.Quotient.eq.1 hrv.symm⟩
  choose rv hrv using hloc
  obtain ⟨y, hy⟩ := IsDedekindDomain.exists_forall_sub_mem_ideal (s := S) (fun v => v.asIdeal) e
    (fun v _ => v.prime) (fun v _ w _ h h' => h (HeightOneSpectrum.ext h')) (fun v => rv v)
  refine ⟨y, fun v hv => ?_⟩
  have h1 : ι v (y - rv v) ∈ Ideal.span {π v ^ e v} := (ι_mem_span_π_pow v _ _).2 (hy v hv)
  have : d v - ι v y = (d v - ι v (rv v)) - ι v (y - rv v) := by rw [map_sub]; ring
  rw [this]
  exact Ideal.sub_mem _ (hrv v) h1

/-- An element lying in $\mathfrak p_v^{\operatorname{ord}_v n}$ for every $v \mid n$ is divisible by $n$. -/
theorem dvd_of_mem_pow {n : 𝓞 F} (hn : n ≠ 0) {m : 𝓞 F}
    (h : ∀ v ∈ primeSupport hn, m ∈ v.asIdeal ^ ordv v n) : n ∣ m :=
  dvd_of_forall_ι_dvd hn fun v => by
    by_cases hv : n ∈ v.asIdeal
    · exact (ι_dvd_ι_iff v hn m).2 (h v ((mem_primeSupport hn).2 hv))
    · exact (isUnit_ι_of_not_mem hv).dvd

theorem genP_pow_mem (v : HeightOneSpectrum (𝓞 F)) (k : ℕ) : genP v ^ k ∈ v.asIdeal ^ k := by
  rw [span_genP]; exact Ideal.pow_mem_pow (Ideal.mem_span_singleton_self _) k

/-- **CRT idempotents:** for $v \in S$ there is $t \in \mathcal O_F$ with $t \equiv 1 \bmod \mathfrak p_v^{e_v}$ and $t \equiv 0 \bmod \mathfrak p_w^{e_w}$
($w \in S$, $w \ne v$). -/
theorem exists_crt_idem (S : Finset (HeightOneSpectrum (𝓞 F))) (e : HeightOneSpectrum (𝓞 F) → ℕ)
    (v : HeightOneSpectrum (𝓞 F)) :
    ∃ t : 𝓞 F, t - 1 ∈ v.asIdeal ^ e v ∧ ∀ w ∈ S, w ≠ v → t ∈ w.asIdeal ^ e w := by
  classical
  obtain ⟨y, hy⟩ := IsDedekindDomain.exists_forall_sub_mem_ideal (s := insert v S) (fun w => w.asIdeal) e
    (fun w _ => w.prime) (fun w _ u _ h h' => h (HeightOneSpectrum.ext h'))
    (fun w => if w.1 = v then 1 else 0)
  refine ⟨y, by simpa using hy v (Finset.mem_insert_self v S), fun w hw hwv => ?_⟩
  simpa [hwv] using hy w (Finset.mem_insert_of_mem hw)

end Arith

/-! ### Completions of left ideals -/

section LocalIdeal

variable {F : Type} [Field F] [NumberField F] {v : HeightOneSpectrum (𝓞 F)} [IsPrincipalIdealRing (𝓞 F)]
  {a b : 𝓞 F}

local notation "Fv" => v.adicCompletion F
local notation "𝔬" => v.adicCompletionIntegers F

theorem nrd_complHom (x : QuatF F a b) : nrd (complHom v a b x) = algebraMap F Fv (nrd x) := by
  simp only [nrd, complHom_re, complHom_imI, complHom_imJ, complHom_imK, map_add, map_sub, map_mul, map_pow]
  rfl

variable {O : Subalgebra (𝓞 F) (QuatF F a b)}

/-- The image $\iota_v(J) \subseteq D_v$ of a left ideal $J$ of $\mathcal O$. -/
def idealImage (J : Ideal O) : Set (QuatV v a b) :=
  (fun x : O => complHom v a b (x : QuatF F a b)) '' (J : Set O)

/-- **The completion $J_v = \mathfrak o_v\,\iota_v(J)$ of a left ideal $J$ of $\mathcal O$**, a left ideal of $\mathcal O_v$. -/
def localIdeal (J : Ideal O) : Ideal (localOrder (v := v) a b O) where
  carrier := {y | (y : QuatV v a b) ∈ Submodule.span 𝔬 (idealImage (v := v) J)}
  add_mem' {x y} hx hy := by
    simp only [Set.mem_ofPred_eq, Subalgebra.coe_add] at *
    exact Submodule.add_mem _ hx hy
  zero_mem' := by
    show ((0 : localOrder (v := v) a b O) : QuatV v a b) ∈ Submodule.span 𝔬 (idealImage (v := v) J)
    rw [ZeroMemClass.coe_zero]; exact Submodule.zero_mem _
  smul_mem' c y hy := by
    have hc : (c : QuatV v a b) ∈ Submodule.span 𝔬 (complHom v a b '' (O : Set (QuatF F a b))) := c.2
    have h : Submodule.span 𝔬 (complHom v a b '' (O : Set (QuatF F a b))) *
        Submodule.span 𝔬 (idealImage (v := v) J) ≤ Submodule.span 𝔬 (idealImage (v := v) J) := by
      rw [Submodule.span_mul_span, Submodule.span_le]
      rintro _ ⟨_, ⟨o, ho, rfl⟩, _, ⟨x, hx, rfl⟩, rfl⟩
      refine Submodule.subset_span ⟨⟨o, ho⟩ * x, J.mul_mem_left _ hx, ?_⟩
      simp only [Subalgebra.coe_mul, map_mul]
    exact h (Submodule.mul_mem_mul hc hy)

theorem mem_localIdeal_iff {J : Ideal O} {y : localOrder (v := v) a b O} :
    y ∈ localIdeal (v := v) J ↔ (y : QuatV v a b) ∈ Submodule.span 𝔬 (idealImage (v := v) J) := by rfl

theorem complHom_mem_span_idealImage {J : Ideal O} {x : O} (hx : x ∈ J) :
    complHom v a b (x : QuatF F a b) ∈ Submodule.span 𝔬 (idealImage (v := v) J) :=
  Submodule.subset_span ⟨x, hx, rfl⟩

/-- **Reduced norms of completions:** $\operatorname{nrd}(J_v) = \operatorname{nrd}(J)\,\mathfrak o_v$ ($\mathcal O$ an order, $\mathcal O_F$ a PID).

*Proof.* $\supseteq$: $\operatorname{nrd}(\iota_vx) = \iota_v(\operatorname{nrd}x)$. $\subseteq$: $\operatorname{nrd}(J_v) = (t)$ with $t = \operatorname{nrd}(y)$ for some
$y \in J_v$; approximating the coefficients of $y = \sum c_k\iota_v(x_k)$ modulo $\varpi^M$ with $M > v(t)$ gives $x \in J$ with
$y - \iota_v(x) \in \varpi^M\mathcal O_v$, hence $\operatorname{nrd}(\iota_vx) \equiv t \bmod \varpi^M$ and $(\operatorname{nrd}(\iota_vx)) = (t)$. -/
@[kb "voight2021" "Def. 16.3.1; Lemma 9.5.3"]
theorem leftNrdIdeal_localIdeal (hO : IsOrder (𝓞 F) F O) (J : Ideal O) :
    leftNrdIdeal (localIdeal (v := v) J) = Ideal.map (ι v) (leftNrdIdeal J) := by
  have hOv := isOrder_localOrder (v := v) hO
  apply le_antisymm
  · -- the local reduced-norm ideal is generated by one value t = nrd y
    obtain ⟨t, ⟨y, hyJ, hyt⟩, hspan⟩ := exists_span_eq_span_singleton (R := 𝔬)
      (S := {r | ∃ x ∈ localIdeal (v := v) J, algebraMap 𝔬 Fv r = nrd (x : QuatV v a b)})
      ⟨0, 0, (localIdeal (v := v) J).zero_mem, by simp [nrd]⟩
    rw [leftNrdIdeal, hspan]
    by_cases ht0 : t = 0
    · rw [ht0, Ideal.span_singleton_eq_bot.2 rfl]; exact bot_le
    obtain ⟨m, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ht0 (irreducible_ι_genP (v := v))
    set ϖ' : 𝔬 := ι v (genP v)
    -- approximate y by an element of J modulo ϖ'^(m+1)
    obtain ⟨N, c, g, hyc⟩ := Submodule.mem_span_set'.1 ((mem_localIdeal_iff).1 hyJ)
    have hg : ∀ k, ∃ x : O, x ∈ J ∧ complHom v a b (x : QuatF F a b) = (g k : QuatV v a b) := fun k => by
      obtain ⟨x, hx, hxg⟩ := (g k).2; exact ⟨x, hx, hxg⟩
    choose xk hxkJ hxk using hg
    have happrox := fun k => exists_ι_sub_eq (v := v) (m + 1) (c k)
    choose r h hrh using happrox
    set x : O := ∑ k, algebraMap (𝓞 F) O (r k) * xk k
    have hxJ : x ∈ J := J.sum_mem fun k _ => J.mul_mem_left _ (hxkJ k)
    set z : QuatV v a b := ∑ k, h k • complHom v a b (xk k : QuatF F a b)
    have hzO : z ∈ localOrder (v := v) a b O :=
      Subalgebra.sum_mem _ fun k _ => Subalgebra.smul_mem _ (mem_localOrder_of_mem a b (xk k).2) _
    have hcx : complHom v a b (x : QuatF F a b) = ∑ k, ι v (r k) • complHom v a b (xk k : QuatF F a b) := by
      simp only [x, AddSubmonoidClass.coe_finsetSum, Subalgebra.coe_mul, map_sum, map_mul]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [Subalgebra.coe_algebraMap, IsScalarTower.algebraMap_apply (𝓞 F) F (QuatF F a b), AlgHom.commutes,
        ← Algebra.smul_def, ι_smul_eq]
    have hyx : (y : QuatV v a b) = complHom v a b (x : QuatF F a b) + ϖ' ^ (m + 1) • z := by
      rw [← hyc, hcx, Finset.smul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [← hxk k, smul_smul, ← hrh k, ← add_smul]
      congr 1; ring
    -- integrality of the pieces
    have hxO : complHom v a b (x : QuatF F a b) ∈ localOrder (v := v) a b O := mem_localOrder_of_mem a b x.2
    obtain ⟨nz, hnz⟩ := (isInteger_trd_nrd hOv hzO).2
    obtain ⟨tz, htz⟩ := (isInteger_trd_nrd hOv (Subalgebra.mul_mem _ hxO
      (star_mem_of_isOrder hOv hzO))).1
    obtain ⟨nx, hnx⟩ := (isInteger_trd_nrd hO x.2).2
    have hnxl : nrd (complHom v a b (x : QuatF F a b)) = algebraMap 𝔬 Fv (ι v nx) := by
      rw [nrd_complHom, ← hnx]; rfl
    have key : t = ι v nx + ϖ' ^ (m + 1) * (ϖ' ^ (m + 1) * nz + tz) := by
      apply IsFractionRing.injective 𝔬 Fv
      rw [hyt, hyx, ← algebraMap_smul Fv (ϖ' ^ (m + 1)) z, nrd_add, nrd_smul, hnxl, star_smul_quat, mul_smul_comm, trd, QuaternionAlgebra.re_smul,
        smul_eq_mul]
      have htz' : 2 * (complHom v a b (x : QuatF F a b) * star z).re = algebraMap 𝔬 Fv tz := by
        rw [htz]; rfl
      rw [← mul_assoc, mul_comm 2, mul_assoc, htz', ← hnz]
      simp only [map_add, map_mul, map_pow]; ring
    -- so nrd(ι x) generates (t)
    have hunit : IsUnit ((u : 𝔬) - ϖ' * (ϖ' ^ (m + 1) * nz + tz)) := by
      have hmem : ϖ' * (ϖ' ^ (m + 1) * nz + tz) ∈ IsLocalRing.maximalIdeal 𝔬 :=
        Ideal.mul_mem_right _ _ ((irreducible_ι_genP (v := v)).maximalIdeal_eq ▸ Ideal.mem_span_singleton_self _)
      by_contra hc
      have h1 : (u : 𝔬) - ϖ' * (ϖ' ^ (m + 1) * nz + tz) ∈ IsLocalRing.maximalIdeal 𝔬 := hc
      have h2 : (u : 𝔬) ∈ IsLocalRing.maximalIdeal 𝔬 := by
        have := Ideal.add_mem _ h1 hmem; rwa [sub_add_cancel] at this
      exact h2 u.isUnit
    have hgen : ι v nx = ϖ' ^ m * ((u : 𝔬) - ϖ' * (ϖ' ^ (m + 1) * nz + tz)) := by
      have : ι v nx = t - ϖ' ^ (m + 1) * (ϖ' ^ (m + 1) * nz + tz) := by rw [key]; ring
      rw [this, hu]; ring
    have hspan_eq : Ideal.span {t} = Ideal.span {ι v nx} := by
      rw [Ideal.span_singleton_eq_span_singleton]
      refine ⟨u⁻¹ * hunit.unit, ?_⟩
      calc t * ↑(u⁻¹ * hunit.unit) = ϖ' ^ m * ((u : 𝔬) * ↑u⁻¹) * ↑hunit.unit := by
            rw [hu, Units.val_mul]; ring
        _ = ι v nx := by rw [Units.mul_inv, mul_one, IsUnit.unit_spec, hgen]
    rw [hspan_eq, Ideal.span_le, Set.singleton_subset_iff]
    exact Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨x, hxJ, hnx⟩)
  · rw [Ideal.map_le_iff_le_comap]
    refine Ideal.span_le.2 ?_
    rintro r ⟨x, hx, hr⟩
    refine Ideal.mem_comap.2 (Ideal.subset_span ⟨⟨_, mem_localOrder_of_mem a b x.2⟩,
      complHom_mem_span_idealImage hx, ?_⟩)
    rw [nrd_complHom, ← hr]; rfl

end LocalIdeal

/-! ### The local-global correspondence for left ideals -/

section LocalGlobal

variable {F : Type} [Field F] [NumberField F] [IsPrincipalIdealRing (𝓞 F)] {a b : 𝓞 F}
  {O : Subalgebra (𝓞 F) (QuatF F a b)}

theorem complHom_algebraMap (v : HeightOneSpectrum (𝓞 F)) (r : 𝓞 F) :
    complHom v a b (algebraMap (𝓞 F) (QuatF F a b) r) =
      algebraMap (v.adicCompletionIntegers F) (QuatV v a b) (ι v r) := by
  rw [IsScalarTower.algebraMap_apply (𝓞 F) F (QuatF F a b), AlgHom.commutes,
    IsScalarTower.algebraMap_apply (v.adicCompletionIntegers F) (v.adicCompletion F) (QuatV v a b),
    IsScalarTower.algebraMap_apply F (v.adicCompletion F) (QuatV v a b)]
  rfl

/-- $\iota_v(n) \in J_v$ when $n \in J$. -/
theorem algebraMap_mem_localIdeal (v : HeightOneSpectrum (𝓞 F)) {J : Ideal O} {n : 𝓞 F}
    (hn : algebraMap (𝓞 F) O n ∈ J) :
    algebraMap (v.adicCompletionIntegers F) (localOrder (v := v) a b O) (ι v n) ∈ localIdeal (v := v) J := by
  rw [mem_localIdeal_iff]
  have := complHom_mem_span_idealImage (v := v) hn
  rwa [Subalgebra.coe_algebraMap, complHom_algebraMap] at this

/-- Multiples of $\iota_v(n)$: if $\iota_v(n) \in I$ (a left ideal of $\mathcal O_v$) then $c\,z \in I$ for all $z \in \mathcal O_v$ and $c \in (\iota_v n)$. -/
theorem smul_mem_of_algebraMap_mem (v : HeightOneSpectrum (𝓞 F)) {I : Ideal (localOrder (v := v) a b O)}
    {n : 𝓞 F} (hn : algebraMap (v.adicCompletionIntegers F) (localOrder (v := v) a b O) (ι v n) ∈ I)
    {c : v.adicCompletionIntegers F} (hc : c ∈ Ideal.span {ι v n}) (z : localOrder (v := v) a b O) : c • z ∈ I := by
  obtain ⟨d, rfl⟩ := Ideal.mem_span_singleton'.1 hc
  have : (d * ι v n) • z = (d • z) * algebraMap _ (localOrder (v := v) a b O) (ι v n) := by
    rw [mul_comm, ← smul_smul, Algebra.smul_def (ι v n), Algebra.commutes]
  rw [this]; exact I.mul_mem_left _ hn

/-- **Units away from $n$:** if $n \in J$ and $v \nmid n$ then $J_v = \mathcal O_v$. -/
theorem localIdeal_eq_top (v : HeightOneSpectrum (𝓞 F)) {J : Ideal O} {n : 𝓞 F}
    (hn : algebraMap (𝓞 F) O n ∈ J) (hv : n ∉ v.asIdeal) : localIdeal (v := v) J = ⊤ := by
  obtain ⟨u, hu⟩ := isUnit_ι_of_not_mem hv
  rw [Ideal.eq_top_iff_one]
  have h1 := smul_mem_of_algebraMap_mem v (algebraMap_mem_localIdeal v hn) (c := ↑u⁻¹ * ι v n)
    (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)) 1
  rwa [← hu, Units.inv_mul, one_smul] at h1

/-- **Coordinates:** if $w \in \mathcal O$ and $\iota_v(w) \in \varpi_v^e\mathcal O_v$ then $w \in \varpi_v^e\mathcal O$. -/
theorem exists_eq_genP_pow_smul (hO : IsOrder (𝓞 F) F O) (v : HeightOneSpectrum (𝓞 F)) {e : ℕ} {w : QuatF F a b}
    (hw : w ∈ O) {z : QuatV v a b} (hz : z ∈ localOrder (v := v) a b O)
    (hwz : complHom v a b w = (π v ^ e) • z) : ∃ w' ∈ O, w = genP v ^ e • w' := by
  classical
  obtain ⟨E⟩ := exists_basis_order hO
  set Eb := complBasis (v := v) E hO
  set sc := E.repr (⟨w, hw⟩ : Subalgebra.toSubmodule O)
  have ht := (mem_localOrder_iff E hO z).1 hz
  choose t ht using ht
  have hcoord : ∀ i, ι v (sc i) = π v ^ e * t i := by
    intro i
    have h1 : Eb.repr (complHom v a b w) i = algebraMap _ (v.adicCompletion F) (ι v (sc i)) := by
      rw [complHom_mem_eq_sum E hw]
      have : ∑ j, ι v (sc j) • complBasisVec (v := v) E j =
          ∑ j, (algebraMap _ (v.adicCompletion F) (ι v (sc j))) • Eb j := by
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [algebraMap_smul (v.adicCompletion F) (ι v (sc j)), complBasis_apply]
      rw [this, Module.Basis.repr_sum_self]
    rw [hwz, ← algebraMap_smul (v.adicCompletion F) (π v ^ e) z, map_smul, Finsupp.smul_apply,
      smul_eq_mul, ← ht i, ← map_mul] at h1
    exact (IsFractionRing.injective _ _ h1).symm
  have hdvd : ∀ i, genP v ^ e ∣ sc i := by
    intro i
    refine genP_pow_dvd_of_ι ?_
    have : ι v (sc i) ∈ Ideal.span {ι v (genP v) ^ e} := by
      rw [span_ι_genP_pow, Ideal.mem_span_singleton]; exact ⟨t i, hcoord i⟩
    exact Ideal.mem_span_singleton.1 this
  choose u hu using hdvd
  refine ⟨∑ i, u i • (E i : QuatF F a b), Subalgebra.sum_mem _ fun i _ => O.smul_mem (E i).2 _, ?_⟩
  rw [mem_O_eq_sum E hw, Finset.smul_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [algebraMap_smul, smul_smul, ← hu i]

/-- **Approximation inside a completion:** if $\iota_v(x) \in J_v$ then for every $E$ there is $y \in J$ with
$\iota_v(x - y) \in \varpi_v^E\mathcal O_v$. -/
theorem exists_approx_mem (v : HeightOneSpectrum (𝓞 F)) {J : Ideal O} {x : O}
    (hx : complHom v a b (x : QuatF F a b) ∈ Submodule.span (v.adicCompletionIntegers F) (idealImage (v := v) J))
    (E : ℕ) : ∃ y ∈ J, ∃ z ∈ localOrder (v := v) a b O,
      complHom v a b ((x : QuatF F a b) - y) = (π v ^ E) • z := by
  obtain ⟨N, c, g, hyc⟩ := Submodule.mem_span_set'.1 hx
  have hg : ∀ k, ∃ y : O, y ∈ J ∧ complHom v a b (y : QuatF F a b) = (g k : QuatV v a b) := fun k => by
    obtain ⟨y, hy, hyg⟩ := (g k).2; exact ⟨y, hy, hyg⟩
  choose yk hykJ hyk using hg
  have happrox := fun k => exists_ι_sub_mem_span v E (c k)
  choose r hr using happrox
  have hr' : ∀ k, ∃ h, c k - ι v (r k) = π v ^ E * h := fun k => Ideal.mem_span_singleton'.1 (hr k) |>.imp
    fun h hh => by rw [← hh, mul_comm]
  choose h hh using hr'
  refine ⟨∑ k, algebraMap (𝓞 F) O (r k) * yk k, J.sum_mem fun k _ => J.mul_mem_left _ (hykJ k),
    ∑ k, h k • complHom v a b (yk k : QuatF F a b),
    Subalgebra.sum_mem _ fun k _ => Subalgebra.smul_mem _ (mem_localOrder_of_mem a b (yk k).2) _, ?_⟩
  rw [map_sub, ← hyc, Finset.smul_sum]
  simp only [AddSubmonoidClass.coe_finsetSum, Subalgebra.coe_mul, map_sum, map_mul, Subalgebra.coe_algebraMap,
    complHom_algebraMap]
  rw [← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [← hyk k, ← Algebra.smul_def, smul_smul, ← hh k, sub_smul]

/-- Multiples of $n$ lie in every left ideal containing $n$. -/
theorem smul_mem_of_dvd {J : Ideal O} {n r : 𝓞 F} (hn : algebraMap (𝓞 F) O n ∈ J) (hr : n ∣ r) (q : O) :
    r • q ∈ J := by
  obtain ⟨c, rfl⟩ := hr
  rw [Algebra.smul_def, show algebraMap (𝓞 F) O (n * c) * q = (algebraMap (𝓞 F) O c * q) * algebraMap (𝓞 F) O n by
    rw [mul_comm n c, map_mul, mul_assoc, Algebra.commutes n q, ← mul_assoc]]
  exact J.mul_mem_left _ hn

/-- **The local-global principle for left ideals containing $n$:** if $n \in J_2$ and $J_{1,v} \subseteq J_{2,v}$ for all $v \mid n$, then
$J_1 \subseteq J_2$.

*Proof.* For $x \in J_1$ and $v \mid n$ approximate: $x - y_v \in \varpi_v^{e_v}\mathcal O$ with $y_v \in J_2$ (`exists_approx_mem`,
`exists_eq_genP_pow_smul`). With CRT idempotents $t_v$, $x = (1 - \sum t_v)x + \sum_v\big(t_vy_v + t_v\varpi_v^{e_v}w_v\big)$ and
$n \mid 1 - \sum t_v$, $n \mid t_v\varpi_v^{e_v}$. -/
@[kb "voight2021" "Thm. 9.4.9"]
theorem le_of_localIdeal_le (hO : IsOrder (𝓞 F) F O) {n : 𝓞 F} (hn : n ≠ 0) {J₁ J₂ : Ideal O}
    (hn2 : algebraMap (𝓞 F) O n ∈ J₂)
    (h : ∀ v ∈ primeSupport hn, localIdeal (v := v) J₁ ≤ localIdeal (v := v) J₂) : J₁ ≤ J₂ := by
  classical
  intro x hx
  set S := primeSupport hn
  have hloc : ∀ v ∈ S, ∃ y : O, y ∈ J₂ ∧ ∃ w : O, x - y = genP v ^ ordv v n • w := by
    intro v hv
    have hxv : complHom v a b (x : QuatF F a b) ∈
        Submodule.span (v.adicCompletionIntegers F) (idealImage (v := v) J₂) :=
      (mem_localIdeal_iff).1 (h v hv (show (⟨_, mem_localOrder_of_mem a b x.2⟩ : localOrder (v := v) a b O) ∈
        localIdeal (v := v) J₁ from complHom_mem_span_idealImage hx))
    obtain ⟨y, hyJ, z, hz, hxyz⟩ := exists_approx_mem v hxv (ordv v n)
    obtain ⟨w', hw', hw⟩ := exists_eq_genP_pow_smul hO v (O.sub_mem x.2 y.2) hz hxyz
    exact ⟨y, hyJ, ⟨w', hw'⟩, Subtype.ext (by rw [Subalgebra.coe_sub, hw]; rfl)⟩
  choose! y hyJ w hxyw using hloc
  have hcrt := fun v => exists_crt_idem S (fun u => ordv u n) v
  choose t ht1 ht0 using hcrt
  have hdiv1 : n ∣ 1 - ∑ v ∈ S, t v := by
    refine dvd_of_mem_pow hn fun u hu => ?_
    have : 1 - ∑ v ∈ S, t v = -(t u - 1) - ∑ v ∈ S.erase u, t v := by
      rw [← Finset.add_sum_erase S t hu]; ring
    rw [this]
    exact Ideal.sub_mem _ ((Ideal.neg_mem_iff _).2 (ht1 u))
      (Ideal.sum_mem _ fun v hv => ht0 v u hu (Finset.ne_of_mem_erase hv).symm)
  have hdiv2 : ∀ v ∈ S, n ∣ t v * genP v ^ ordv v n := by
    intro v hv
    refine dvd_of_mem_pow hn fun u hu => ?_
    by_cases huv : u = v
    · subst huv; exact Ideal.mul_mem_left _ _ (genP_pow_mem u _)
    · exact Ideal.mul_mem_right _ _ (ht0 v u hu huv)
  have key : x = (1 - ∑ v ∈ S, t v) • x + ∑ v ∈ S, (t v • y v + (t v * genP v ^ ordv v n) • w v) := by
    have hterm : ∀ v ∈ S, t v • x = t v • y v + (t v * genP v ^ ordv v n) • w v := by
      intro v hv
      rw [mul_smul, ← hxyw v hv, smul_sub, add_sub_cancel]
    rw [← Finset.sum_congr rfl hterm, sub_smul, one_smul, Finset.sum_smul, sub_add_cancel]
  rw [key]
  refine J₂.add_mem (smul_mem_of_dvd hn2 hdiv1 x) (J₂.sum_mem fun v hv => J₂.add_mem ?_ (smul_mem_of_dvd hn2
    (hdiv2 v hv) _))
  rw [Algebra.smul_def]; exact J₂.mul_mem_left _ (hyJ v hv)

/-- The completion map $\mathcal O \to \mathcal O_v$ as a ring homomorphism. -/
def toLocal (v : HeightOneSpectrum (𝓞 F)) : O →+* localOrder (v := v) a b O where
  toFun x := ⟨complHom v a b (x : QuatF F a b), mem_localOrder_of_mem a b x.2⟩
  map_one' := Subtype.ext (map_one _)
  map_mul' x y := Subtype.ext (map_mul _ _ _)
  map_zero' := Subtype.ext (map_zero _)
  map_add' x y := Subtype.ext (map_add _ _ _)

@[simp] theorem coe_toLocal (v : HeightOneSpectrum (𝓞 F)) (x : O) :
    ((toLocal (a := a) (b := b) (O := O) v x : localOrder (v := v) a b O) : QuatV v a b) =
      complHom v a b (x : QuatF F a b) := rfl

theorem toLocal_mem_localIdeal (v : HeightOneSpectrum (𝓞 F)) {J : Ideal O} {x : O} (hx : x ∈ J) :
    toLocal v x ∈ localIdeal (v := v) J :=
  complHom_mem_span_idealImage hx

/-- **The global left ideal with prescribed completions** $\{x \in \mathcal O : \iota_v(x) \in I_v\ \forall v \in S\}$. -/
def globalIdeal (S : Finset (HeightOneSpectrum (𝓞 F)))
    (I : ∀ v : HeightOneSpectrum (𝓞 F), Ideal (localOrder (v := v) a b O)) : Ideal O :=
  ⨅ v ∈ S, (I v).comap (toLocal v)

theorem mem_globalIdeal {S : Finset (HeightOneSpectrum (𝓞 F))}
    {I : ∀ v : HeightOneSpectrum (𝓞 F), Ideal (localOrder (v := v) a b O)} {x : O} :
    x ∈ globalIdeal S I ↔ ∀ v ∈ S, toLocal v x ∈ I v := by
  simp only [globalIdeal, Submodule.mem_iInf]; rfl

/-- A left ideal of $\mathcal O_v$ contains the $\mathfrak o_v$-span of its elements' images (it is an $\mathfrak o_v$-module). -/
theorem span_le_of_forall_mem (v : HeightOneSpectrum (𝓞 F)) {I : Ideal (localOrder (v := v) a b O)}
    {T : Set (QuatV v a b)} (hT : ∀ q ∈ T, ∃ h : q ∈ localOrder (v := v) a b O, (⟨q, h⟩ : localOrder (v := v) a b O) ∈ I)
    {y : localOrder (v := v) a b O} (hy : (y : QuatV v a b) ∈ Submodule.span (v.adicCompletionIntegers F) T) :
    y ∈ I := by
  have key : ∀ q ∈ Submodule.span (v.adicCompletionIntegers F) T,
      ∃ h : q ∈ localOrder (v := v) a b O, (⟨q, h⟩ : localOrder (v := v) a b O) ∈ I := by
    intro q hq
    induction hq using Submodule.span_induction with
    | mem q hq => exact hT q hq
    | zero => exact ⟨Subalgebra.zero_mem _, by convert I.zero_mem⟩
    | add q r _ _ hq hr =>
      obtain ⟨h1, h1'⟩ := hq; obtain ⟨h2, h2'⟩ := hr
      exact ⟨Subalgebra.add_mem _ h1 h2, by convert I.add_mem h1' h2'⟩
    | smul c q _ hq =>
      obtain ⟨h1, h1'⟩ := hq
      refine ⟨Subalgebra.smul_mem _ h1 c, ?_⟩
      have : (⟨c • q, Subalgebra.smul_mem _ h1 c⟩ : localOrder (v := v) a b O) =
          algebraMap _ (localOrder (v := v) a b O) c * ⟨q, h1⟩ := by
        apply Subtype.ext
        rw [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, ← Algebra.smul_def]
      rw [this]; exact I.mul_mem_left _ h1'
  obtain ⟨h, hI⟩ := key _ hy
  exact hI

set_option maxHeartbeats 1000000 in
/-- **Existence of a global ideal with prescribed completions** (CRT): if $\iota_v(n) \in I_v$ for $v \in S$ ($S$ the places dividing
$n$), then the completions of `globalIdeal S I` are the $I_v$ ($v \in S$). -/
@[kb "voight2021" "Thm. 9.4.9"]
theorem localIdeal_globalIdeal (hO : IsOrder (𝓞 F) F O) {n : 𝓞 F} (hn : n ≠ 0)
    (I : ∀ v : HeightOneSpectrum (𝓞 F), Ideal (localOrder (v := v) a b O))
    (hI : ∀ v ∈ primeSupport hn, algebraMap _ (localOrder (v := v) a b O) (ι v n) ∈ I v)
    (v : HeightOneSpectrum (𝓞 F)) (hv : v ∈ primeSupport hn) :
    localIdeal (v := v) (globalIdeal (primeSupport hn) I) = I v := by
  classical
  set S := primeSupport hn
  have hnJ : algebraMap (𝓞 F) O n ∈ globalIdeal S I := mem_globalIdeal.2 fun w hw => by
    have : toLocal w (algebraMap (𝓞 F) O n) = algebraMap _ (localOrder (v := w) a b O) (ι w n) :=
      Subtype.ext (by rw [coe_toLocal, Subalgebra.coe_algebraMap, complHom_algebraMap]; rfl)
    rw [this]; exact hI w hw
  apply le_antisymm
  · intro y hy
    refine span_le_of_forall_mem v (T := idealImage (v := v) (globalIdeal S I)) ?_ hy
    rintro _ ⟨x, hx, rfl⟩
    exact ⟨mem_localOrder_of_mem a b x.2, mem_globalIdeal.1 hx v hv⟩
  · intro y hy
    obtain ⟨E⟩ := exists_basis_order hO
    set Eb := complBasis (v := v) E hO
    have hEi : ∀ (w : HeightOneSpectrum (𝓞 F)) (i : Fin 4), complBasisVec (v := w) E i ∈ localOrder (v := w) a b O :=
      fun w i => mem_localOrder_of_mem a b (E i).2
    have hd := (mem_localOrder_iff E hO (y : QuatV v a b)).1 y.2
    choose d hd using hd
    -- approximate the coordinates at v, and make them vanish to order e_w at the other w ∈ S
    have h0 := fun i => exists_ι_sub_mem_span v (ordv v n) (d i)
    choose r0 hr0 using h0
    obtain ⟨t, ht1, ht0⟩ := exists_crt_idem S (fun u => ordv u n) v
    set r : Fin 4 → 𝓞 F := fun i => t * r0 i
    obtain ⟨x, hxdef⟩ : ∃ x : O, x = ∑ i, r i • (⟨E i, (E i).2⟩ : O) := ⟨_, rfl⟩
    -- coefficients in (ι_w n) at every w ∈ S
    have hcoef_w : ∀ w ∈ S, w ≠ v → ∀ i, ι w (r i) ∈ Ideal.span {ι w n} := by
      intro w hw hwv i
      rw [span_ι_eq_ordv w hn, ι_mem_span_π_pow]
      exact Ideal.mul_mem_right _ _ (ht0 w hw hwv)
    have hcoef_v : ∀ i, ι v (r i) - d i ∈ Ideal.span {ι v n} := by
      intro i
      rw [span_ι_eq_ordv v hn]
      have e1 : ι v (t - 1) ∈ Ideal.span {π v ^ ordv v n} := (ι_mem_span_π_pow v _ _).2 (ht1)
      have : ι v (r i) - d i = ι v (t - 1) * ι v (r0 i) - (d i - ι v (r0 i)) := by
        simp only [r, map_mul, map_sub, map_one]; ring
      rw [this]
      exact Ideal.sub_mem _ (Ideal.mul_mem_right _ _ e1) (hr0 i)
    have hloc_x : ∀ w, toLocal w x = ∑ i, ι w (r i) • (⟨complBasisVec (v := w) E i, hEi w i⟩ :
        localOrder (v := w) a b O) := by
      intro w
      apply Subtype.ext
      rw [coe_toLocal, hxdef, AddSubmonoidClass.coe_finsetSum, map_sum, AddSubmonoidClass.coe_finsetSum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Subalgebra.coe_smul, Subalgebra.coe_smul]
      erw [complHom_int_smul]; rfl
    have hy_sum : y = ∑ i, d i • (⟨complBasisVec (v := v) E i, hEi v i⟩ : localOrder (v := v) a b O) := by
      apply Subtype.ext
      rw [← Eb.sum_repr (y : QuatV v a b), AddSubmonoidClass.coe_finsetSum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Subalgebra.coe_smul, ← hd i, algebraMap_smul, complBasis_apply]
    have hdiff : toLocal v x - y = ∑ i, (ι v (r i) - d i) • (⟨complBasisVec (v := v) E i, hEi v i⟩ :
        localOrder (v := v) a b O) := by
      rw [hloc_x, hy_sum, ← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl fun i _ => (sub_smul _ _ _).symm
    have hxJ : x ∈ globalIdeal S I := by
      rw [mem_globalIdeal]
      intro w hw
      by_cases hwv : w = v
      · subst hwv
        have : toLocal w x = y + (toLocal w x - y) := by abel
        rw [this, hdiff]
        exact (I w).add_mem hy ((I w).sum_mem fun i _ => smul_mem_of_algebraMap_mem w (hI w hw) (hcoef_v i) _)
      · rw [hloc_x]
        exact (I w).sum_mem fun i _ => smul_mem_of_algebraMap_mem w (hI w hw) (hcoef_w w hw hwv i) _
    have : y = toLocal v x - (toLocal v x - y) := by abel
    rw [this, hdiff]
    refine Ideal.sub_mem _ (toLocal_mem_localIdeal v hxJ) ((localIdeal (v := v) _).sum_mem fun i _ => ?_)
    exact smul_mem_of_algebraMap_mem v (algebraMap_mem_localIdeal v hnJ) (hcoef_v i) _

/-- **The reduced norm of a left ideal is determined locally:** if $n \in J$ and $\operatorname{nrd}(J_v) = (\iota_vn)$ for all $v \mid n$,
then $\operatorname{nrd}(J) = (n)$. -/
theorem leftNrdIdeal_eq_of_local (hO : IsOrder (𝓞 F) F O) {n : 𝓞 F} (hn : n ≠ 0) {J : Ideal O}
    (hnJ : algebraMap (𝓞 F) O n ∈ J)
    (h : ∀ v ∈ primeSupport hn, leftNrdIdeal (localIdeal (v := v) J) = Ideal.span {ι v n}) :
    leftNrdIdeal J = Ideal.span {n} := by
  obtain ⟨α, hα'⟩ := (IsPrincipalIdealRing.principal (leftNrdIdeal J)).principal
  have hα : leftNrdIdeal J = Ideal.span {α} := hα'
  have hloc : ∀ v : HeightOneSpectrum (𝓞 F), Ideal.span {ι v α} = Ideal.span {ι v n} := by
    intro v
    have h1 : leftNrdIdeal (localIdeal (v := v) J) = Ideal.span {ι v α} := by
      rw [leftNrdIdeal_localIdeal hO, hα, Ideal.map_span, Set.image_singleton]
    by_cases hv : n ∈ v.asIdeal
    · rw [← h1, h v ((mem_primeSupport hn).2 hv)]
    · rw [← h1, Ideal.span_singleton_eq_top.2 (isUnit_ι_of_not_mem hv), Ideal.eq_top_iff_one]
      refine Ideal.subset_span ⟨1, ?_, by simp [nrd]⟩
      rw [localIdeal_eq_top v hnJ hv]; exact Submodule.mem_top
  have hα0 : α ≠ 0 := by
    rintro rfl
    have hmem : n ^ 2 ∈ leftNrdIdeal J := Ideal.subset_span ⟨_, hnJ, by
      rw [Subalgebra.coe_algebraMap, IsScalarTower.algebraMap_apply (𝓞 F) F (QuatF F a b), nrd_algebraMap,
        map_pow]⟩
    rw [hα, Ideal.mem_span_singleton, zero_dvd_iff] at hmem
    exact hn (pow_eq_zero_iff (by norm_num) |>.1 hmem)
  rw [hα, Ideal.span_singleton_eq_span_singleton]
  refine associated_of_dvd_dvd (dvd_of_forall_ι_dvd hα0 fun v => ?_) (dvd_of_forall_ι_dvd hn fun v => ?_)
  · exact Ideal.mem_span_singleton.1 ((hloc v) ▸ Ideal.mem_span_singleton_self (ι v n))
  · exact Ideal.mem_span_singleton.1 ((hloc v).symm ▸ Ideal.mem_span_singleton_self (ι v α))

/-- A left ideal of $\mathcal O_v$ with reduced norm $(\iota_vn)$ contains $\iota_v(n)$. -/
theorem algebraMap_mem_of_leftNrdIdeal_eq (hO : IsOrder (𝓞 F) F O) (v : HeightOneSpectrum (𝓞 F)) {n : 𝓞 F}
    {I : Ideal (localOrder (v := v) a b O)} (hI : leftNrdIdeal I = Ideal.span {ι v n}) :
    algebraMap _ (localOrder (v := v) a b O) (ι v n) ∈ I :=
  algebraMap_mem_of_mem_leftNrdIdeal (R := v.adicCompletionIntegers F) (isOrder_localOrder hO) I
    (by rw [hI]; exact Ideal.mem_span_singleton_self _)

open Classical in
/-- Extend a family of local ideals indexed by $v \in S$ by $\mathcal O_v$ outside $S$. -/
def famExt (S : Finset (HeightOneSpectrum (𝓞 F)))
    (I : (v : S) → Ideal (localOrder (v := v.1) a b O)) (v : HeightOneSpectrum (𝓞 F)) :
    Ideal (localOrder (v := v) a b O) :=
  if h : v ∈ S then I ⟨v, h⟩ else ⊤

theorem famExt_of_mem {S : Finset (HeightOneSpectrum (𝓞 F))}
    {I : (v : S) → Ideal (localOrder (v := v.1) a b O)} {v : HeightOneSpectrum (𝓞 F)} (h : v ∈ S) :
    famExt S I v = I ⟨v, h⟩ := by
  simp only [famExt, h, dite_true]

theorem algebraMap_mem_globalIdeal {S : Finset (HeightOneSpectrum (𝓞 F))}
    {I : ∀ v : HeightOneSpectrum (𝓞 F), Ideal (localOrder (v := v) a b O)} {n : 𝓞 F}
    (hI : ∀ v ∈ S, algebraMap _ (localOrder (v := v) a b O) (ι v n) ∈ I v) :
    algebraMap (𝓞 F) O n ∈ globalIdeal S I := mem_globalIdeal.2 fun w hw => by
  have : toLocal w (algebraMap (𝓞 F) O n) = algebraMap _ (localOrder (v := w) a b O) (ι w n) :=
    Subtype.ext (by rw [coe_toLocal, Subalgebra.coe_algebraMap, complHom_algebraMap]; rfl)
  rw [this]; exact hI w hw

/-- The family of local ideals of reduced norm $(\iota_vn)$, $v \mid n$. -/
abbrev LocalFam {n : 𝓞 F} (hn : n ≠ 0) (O : Subalgebra (𝓞 F) (QuatF F a b)) :=
  (v : primeSupport hn) → {I : Ideal (localOrder (v := v.1) a b O) // leftNrdIdeal I = Ideal.span {ι v.1 n}}

/-- The global ideal attached to a family of local ideals. -/
def globalOfFam {n : 𝓞 F} (hn : n ≠ 0) (I : LocalFam hn O) : Ideal O :=
  globalIdeal (primeSupport hn) (famExt (primeSupport hn) fun v => (I v).1)

theorem famExt_algebraMap_mem (hO : IsOrder (𝓞 F) F O) {n : 𝓞 F} (hn : n ≠ 0) (I : LocalFam hn O) :
    ∀ v ∈ primeSupport hn, algebraMap _ (localOrder (v := v) a b O) (ι v n) ∈
      famExt (primeSupport hn) (fun v => (I v).1) v := fun v hv => by
  rw [famExt_of_mem hv]; exact algebraMap_mem_of_leftNrdIdeal_eq hO v (I ⟨v, hv⟩).2

theorem localIdeal_globalOfFam (hO : IsOrder (𝓞 F) F O) {n : 𝓞 F} (hn : n ≠ 0) (I : LocalFam hn O)
    (v : primeSupport hn) : localIdeal (v := v.1) (globalOfFam hn I) = (I v).1 := by
  rw [globalOfFam, localIdeal_globalIdeal hO hn _ (famExt_algebraMap_mem hO hn I) v.1 v.2, famExt_of_mem v.2]

theorem leftNrdIdeal_globalOfFam (hO : IsOrder (𝓞 F) F O) {n : 𝓞 F} (hn : n ≠ 0) (I : LocalFam hn O) :
    leftNrdIdeal (globalOfFam hn I) = Ideal.span {n} :=
  leftNrdIdeal_eq_of_local hO hn (algebraMap_mem_globalIdeal (famExt_algebraMap_mem hO hn I)) fun v hv => by
    rw [localIdeal_globalOfFam hO hn I ⟨v, hv⟩]; exact (I ⟨v, hv⟩).2

/-- The family of completions of a left ideal of reduced norm $(n)$. -/
def famOfIdeal (hO : IsOrder (𝓞 F) F O) {n : 𝓞 F} (hn : n ≠ 0)
    (J : {J : Ideal O // leftNrdIdeal J = Ideal.span {n}}) : LocalFam hn O := fun v =>
  ⟨localIdeal (v := v.1) J.1, by rw [leftNrdIdeal_localIdeal hO, J.2, Ideal.map_span, Set.image_singleton]⟩

theorem globalOfFam_famOfIdeal (hO : IsOrder (𝓞 F) F O) {n : 𝓞 F} (hn : n ≠ 0)
    (J : {J : Ideal O // leftNrdIdeal J = Ideal.span {n}}) : globalOfFam hn (famOfIdeal hO hn J) = J.1 := by
  have hnJ : algebraMap (𝓞 F) O n ∈ J.1 :=
    algebraMap_mem_of_mem_leftNrdIdeal hO J.1 (by rw [J.2]; exact Ideal.mem_span_singleton_self _)
  have hnJ' := algebraMap_mem_globalIdeal (famExt_algebraMap_mem hO hn (famOfIdeal hO hn J))
  have hleq : ∀ v ∈ primeSupport hn, localIdeal (v := v) (globalOfFam hn (famOfIdeal hO hn J)) =
      localIdeal (v := v) J.1 := fun v hv => localIdeal_globalOfFam hO hn _ ⟨v, hv⟩
  exact le_antisymm (le_of_localIdeal_le hO hn hnJ fun v hv => (hleq v hv).le)
    (le_of_localIdeal_le hO hn hnJ' fun v hv => (hleq v hv).ge)

/-- **The local-global correspondence for left ideals of given reduced norm** ($\mathcal O$ an order, $\mathcal O_F$ a PID, $n \ne 0$):
$$\{J \subseteq \mathcal O : \operatorname{nrd}(J) = (n)\} \;\simeq\; \prod_{v \mid n}\{I \subseteq \mathcal O_v : \operatorname{nrd}(I) = (\iota_vn)\},\qquad J \mapsto (J_v)_v.$$

Source: Voight 2021, Thm. 9.4.9, Lemma 9.5.3, §26.4 (first display) and Prop. 26.3.9. -/
@[kb "voight2021" "Thm. 9.4.9"]
def idealLocalEquiv (hO : IsOrder (𝓞 F) F O) {n : 𝓞 F} (hn : n ≠ 0) :
    {J : Ideal O // leftNrdIdeal J = Ideal.span {n}} ≃ LocalFam hn O where
  toFun := famOfIdeal hO hn
  invFun I := ⟨globalOfFam hn I, leftNrdIdeal_globalOfFam hO hn I⟩
  left_inv J := Subtype.ext (globalOfFam_famOfIdeal hO hn J)
  right_inv I := funext fun v => Subtype.ext (localIdeal_globalOfFam hO hn I v)

open Classical in
/-- **The number of left ideals of a maximal order with given reduced norm** ($\mathcal O_F$ a PID, $ab \ne 0$, $n \ne 0$):
$$\#\{J \subseteq \mathcal O : \operatorname{nrd}(J) = (n)\} = \prod_{v \mid n}a_v(\operatorname{ord}_vn),\qquad
  a_v(k) = \begin{cases}1 & v \in \operatorname{Ram}(D)\\ \sum_{i=0}^k(N\mathfrak p_v)^i & \text{otherwise}\end{cases}$$
(`card_localOrder_ideal`). Equivalently, $\zeta_{\mathcal O}(s) = \sum_J N(\operatorname{nrd}J)^{-s}$ has the Euler product
$\prod_v\sum_ka_v(k)N\mathfrak p_v^{-ks} = \zeta_F(s)\zeta_F(s-1)\prod_{\mathfrak p \in \operatorname{Ram}(D)}(1 - N\mathfrak p^{1-s})$
(`hasSum_localFactor_split`, `hasSum_localFactor_ramified`).

Source: Voight 2021, Prop. 26.3.9, (26.3.12), Lemma 26.4.1, Cor. 26.4.7; Thm. 9.4.9. -/
@[kb "voight2021" "Prop. 26.3.9; Lemma 26.4.1"]
theorem card_ideal_nrd_eq (ha : a ≠ 0) (hb : b ≠ 0) (hO : IsMaximalOrder (𝓞 F) F O) {n : 𝓞 F} (hn : n ≠ 0) :
    Nat.card {J : Ideal O // leftNrdIdeal J = Ideal.span {n}} =
      ∏ v ∈ primeSupport hn,
        (if IsRamifiedAt (algebraMap (𝓞 F) F a) (algebraMap (𝓞 F) F b) (NFPlace.finite v) then 1
          else ∑ i ∈ Finset.range (ordv v n + 1), Ideal.absNorm v.asIdeal ^ i) := by
  rw [Nat.card_congr (idealLocalEquiv hO.1 hn), Nat.card_pi, ← Finset.prod_coe_sort (primeSupport hn)]
  refine Finset.prod_congr rfl fun v _ => ?_
  rw [span_ι_eq_ordv v.1 hn]
  exact card_localOrder_ideal ha hb hO (ordv v.1 n)

end LocalGlobal

