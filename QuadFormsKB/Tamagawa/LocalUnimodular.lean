/-
# The local weights do not depend on the representative: a local proof

**Layer:** an abstract group (index ratios of commensurable subgroups), then the groups $O(Q')(F_\mathfrak p)$ acting on
lattices of $F_\mathfrak p^N$ (`Lattices/`).

The local weight $w_\mathfrak p(M) = [K_0' : K_0'\cap K_M]/[K_M : K_0'\cap K_M]$ (`locWeight`) is the ratio $\mu(K_0')/\mu(K_M)$ of the
Haar measures of two compact open subgroups of $H = O(Q')(F_\mathfrak p)$. For $h \in H$, $K_{hM} = hK_Mh^{-1}$, so
$w(hM) = \Delta(h)\,w(M)$ with $\Delta(h) = \mu(K_0')/\mu(hK_0'h^{-1})$ the modular function of $H$. This file proves $\Delta = 1$
**locally**, at every prime (dyadic included), for every nondegenerate $Q'$: $\Delta$ is multiplicative (`relRatio_mul`, the
cocycle identity for index ratios of commensurable subgroups), it is $1$ on involutions ($\Delta(\tau)^2 = \Delta(\tau^2) = 1$), and
$H$ is generated by reflections (Cartan–Dieudonné, in the form: an isometry fixing the first $j$ vectors of an orthogonal
basis is a product of at most two reflections and an isometry fixing the first $j + 1$; cf. O'Meara 1963, 43:3, p. 102, whose proof is different;
Artin, *Geometric Algebra*, Ch. III [unverified]).

**Proves**
* `relRatio`, `relRatio_eq_of_le`, `relRatio_mul`, `relRatio_map` (index ratios of commensurable subgroups);
* `finite_sandwich_loc`, `relIndex_stabLat_ne_zero` (**stabilizers of local lattices are commensurable**);
* `modRatio_mul`, `modRatio_eq_one_of_involution`, **`modRatio_eq_one`** ($\Delta \equiv 1$ on $O(Q')(F_\mathfrak p)$);
* **`locWeightInvariant_local`**: `LocWeightInvariant` at every prime, with no global hypothesis.
-/
import QuadFormsKB.Tamagawa.LocalOrbitalBad

open Matrix MulAction

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.Tamagawa

open NumberField IsDedekindDomain Lattices LocalDensity QuadForm

/-! ### Index ratios of commensurable subgroups -/

section RelRatio

variable {G : Type*} [Group G]

/-- **The index ratio** $r(A, B) = [A : A\cap B]/[B : A\cap B]$ ($= \mu(A)/\mu(B)$ for a Haar measure $\mu$ when $A$, $B$ are
commensurable compact open subgroups). -/
def relRatio (A B : Subgroup G) : ℝ := (B.relIndex A : ℝ) / (A.relIndex B : ℝ)

/-- $r(A, B) = [A : D]/[B : D]$ for any $D \le A \cap B$ of finite index in $A$ and $B$. -/
theorem relRatio_eq_of_le {A B D : Subgroup G} (hD : D ≤ A ⊓ B) (hA : D.relIndex A ≠ 0) : relRatio A B = (D.relIndex A : ℝ) / (D.relIndex B : ℝ) := by
  have e1 := Subgroup.relIndex_mul_relIndex D (A ⊓ B) A hD inf_le_left
  have e2 := Subgroup.relIndex_mul_relIndex D (A ⊓ B) B hD inf_le_right
  rw [Subgroup.inf_relIndex_left] at e1
  rw [Subgroup.inf_relIndex_right] at e2
  have h0 : D.relIndex (A ⊓ B) ≠ 0 := by
    intro h; apply hA; rw [← e1, h, zero_mul]
  unfold relRatio
  rw [← e1, ← e2]
  push_cast
  have : (D.relIndex (A ⊓ B) : ℝ) ≠ 0 := by exact_mod_cast h0
  rw [mul_div_mul_left _ _ this]

/-- **Commensurable** subgroups: $A\cap B$ has finite index in $A$ and in $B$. -/
def Commens (A B : Subgroup G) : Prop := B.relIndex A ≠ 0 ∧ A.relIndex B ≠ 0

/-- **The cocycle identity** $r(A, B)\,r(B, C) = r(A, C)$ for pairwise commensurable $A, B, C$. -/
theorem relRatio_mul {A B C : Subgroup G} (hAB : Commens A B) (hBC : Commens B C) (hAC : Commens A C) :
    relRatio A B * relRatio B C = relRatio A C := by
  set D := A ⊓ B ⊓ C
  have hDA : D.relIndex A ≠ 0 := by
    refine Subgroup.relIndex_inf_ne_zero ?_ hAC.1
    rw [Subgroup.inf_relIndex_left]; exact hAB.1
  have hDB : D.relIndex B ≠ 0 := by
    refine Subgroup.relIndex_inf_ne_zero ?_ hBC.1
    rw [Subgroup.inf_relIndex_right]; exact hAB.2
  have hDC : D.relIndex C ≠ 0 := by
    refine Subgroup.relIndex_inf_ne_zero ?_ (by rw [Subgroup.relIndex_self]; exact one_ne_zero)
    exact Subgroup.relIndex_inf_ne_zero hAC.2 hBC.2
  rw [relRatio_eq_of_le (show D ≤ A ⊓ B from inf_le_left) hDA,
    relRatio_eq_of_le (show D ≤ B ⊓ C from le_inf (inf_le_left.trans inf_le_right) inf_le_right) hDB,
    relRatio_eq_of_le (show D ≤ A ⊓ C from le_inf (inf_le_left.trans inf_le_left) inf_le_right) hDA]
  have : (D.relIndex B : ℝ) ≠ 0 := by exact_mod_cast hDB
  field_simp

theorem relRatio_map {G' : Type*} [Group G'] {f : G →* G'} (hf : Function.Injective f) (A B : Subgroup G) :
    relRatio (A.map f) (B.map f) = relRatio A B := by
  unfold relRatio
  rw [Subgroup.relIndex_map_map_of_injective _ _ hf, Subgroup.relIndex_map_map_of_injective _ _ hf]

theorem relRatio_self (A : Subgroup G) : relRatio A A = 1 := by
  simp [relRatio]

theorem relRatio_pos {A B : Subgroup G} (h : Commens A B) : 0 < relRatio A B := by
  unfold relRatio
  have h1 : (0 : ℝ) < B.relIndex A := by exact_mod_cast Nat.pos_of_ne_zero h.1
  have h2 : (0 : ℝ) < A.relIndex B := by exact_mod_cast Nat.pos_of_ne_zero h.2
  positivity

theorem Commens.symm {A B : Subgroup G} (h : Commens A B) : Commens B A := ⟨h.2, h.1⟩

theorem Commens.map {G' : Type*} [Group G'] {f : G →* G'} (hf : Function.Injective f) {A B : Subgroup G}
    (h : Commens A B) : Commens (A.map f) (B.map f) := by
  unfold Commens
  rw [Subgroup.relIndex_map_map_of_injective _ _ hf, Subgroup.relIndex_map_map_of_injective _ _ hf]
  exact h

end RelRatio


/-! ### Stabilizers of local lattices are commensurable -/

section Commens

open WithZero

variable {F : Type*} [Field F] [NumberField F] {N : ℕ} (v : HeightOneSpectrum (𝓞 F))

theorem mem_ball_smul_iff {j t : ℤ} (y : Fin N → v.adicCompletion F) :
    ϖk v t • y ∈ (ball v (j + t) : Submodule (v.adicCompletionIntegers F) (Fin N → v.adicCompletion F)) ↔
      y ∈ (ball v j : Submodule (v.adicCompletionIntegers F) (Fin N → v.adicCompletion F)) := by
  simp only [mem_ball, Pi.smul_apply, smul_eq_mul, map_mul, valued_ϖk]
  refine forall_congr' fun i => ?_
  rw [show -(j + t) = -t + -j by ring, exp_add]
  constructor
  · intro h; exact le_of_mul_le_mul_left h (by simp)
  · intro h; exact mul_le_mul_right h _

/-- **Finitely many lattices between two boxes** $\mathfrak p^a\mathfrak o^N \subseteq \Lambda \subseteq \mathfrak p^{-a}\mathfrak o^N$: they are determined by
their images in $\mathfrak p^{-a}\mathfrak o^N/\mathfrak p^{a}\mathfrak o^N \cong (\mathfrak o/\varpi^{2a})^N$. -/
theorem finite_sandwich_loc (a : ℕ) :
    {Λ : Submodule (v.adicCompletionIntegers F) (Fin N → v.adicCompletion F) |
      ball v a ≤ Λ ∧ Λ ≤ ball v (-a)}.Finite := by
  classical
  set R := v.adicCompletionIntegers F
  set I := Ideal.span {NF.π v ^ (2 * a)}
  -- the code of a lattice: the classes of `ϖ^a y` mod `π^(2a)`, `y ∈ Λ`
  have hint : ∀ y : Fin N → v.adicCompletion F, y ∈ (ball v (-a) : Submodule R _) →
      ∀ i, Valued.v ((ϖk v a • y) i) ≤ 1 := by
    intro y hy i
    have := (mem_ball_smul_iff v (j := -a) (t := a) y).mpr hy i
    simpa using this
  let code : Submodule R (Fin N → v.adicCompletion F) → Set (Fin N → R ⧸ I) := fun Λ =>
    {ζ | ∃ y ∈ Λ, ∃ hy : ∀ i, Valued.v ((ϖk v a • y) i) ≤ 1,
      ζ = fun i => Ideal.Quotient.mk I (toO v _ (hy i))}
  have := DVR.finite_vec (ι := Fin N) (NF.π v) (NF.irreducible_π v) (2 * a)
  refine Set.Finite.of_finite_image (f := code) (Set.toFinite _) ?_
  -- injectivity
  have hle : ∀ Λ Λ', (ball v a ≤ Λ ∧ Λ ≤ ball v (-a)) → (ball v a ≤ Λ' ∧ Λ' ≤ ball v (-a)) →
      code Λ ⊆ code Λ' → Λ ≤ Λ' := by
    intro Λ Λ' hΛ hΛ' hc y hy
    obtain ⟨y', hy', hy'v, he⟩ := hc ⟨y, hy, hint y (hΛ.2 hy), rfl⟩
    -- `ϖ^a (y - y') ≡ 0 mod π^(2a)`, so `y - y' ∈ ball a ⊆ Λ'`
    have hd : y - y' ∈ (ball v a : Submodule R _) := by
      intro i
      have h1 := congrFun he i
      rw [Ideal.Quotient.eq, Ideal.mem_span_singleton] at h1
      obtain ⟨s, hs⟩ := h1
      have h2 : ((toO v _ (hint y (hΛ.2 hy) i) : R) : v.adicCompletion F) - (toO v _ (hy'v i) : R) =
          ((NF.π v ^ (2 * a) * s : R) : v.adicCompletion F) := by
        rw [← hs]; rfl
      simp only [toO, Pi.smul_apply, smul_eq_mul] at h2
      have h3 : Valued.v (ϖk v a * (y i - y' i)) ≤ exp (-(2 * a : ℤ)) := by
        rw [mul_sub, h2]
        push_cast
        rw [map_mul, map_pow, NF.valued_π, ← WithZero.exp_nsmul]
        calc exp ((2 * a) • (-1 : ℤ)) * Valued.v ((s : R) : v.adicCompletion F) ≤ exp ((2 * a) • (-1 : ℤ)) * 1 :=
              mul_le_mul_right ((HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mp s.2) _
          _ = exp (-(2 * a : ℤ)) := by rw [mul_one]; congr 1; simp
      rw [map_mul, valued_ϖk] at h3
      show Valued.v (y i - y' i) ≤ exp (-(a : ℤ))
      have : exp (-(a : ℤ)) * Valued.v (y i - y' i) ≤ exp (-(a : ℤ)) * exp (-(a : ℤ)) := by
        rw [← exp_add]; convert h3 using 2; ring
      exact le_of_mul_le_mul_left this (by simp)
    have := Λ'.add_mem hy' (hΛ'.1 hd)
    rwa [add_sub_cancel] at this
  intro Λ hΛ Λ' hΛ' heq
  exact le_antisymm (hle Λ Λ' hΛ hΛ' heq.le) (hle Λ' Λ hΛ' hΛ heq.ge)

variable {G : Type*} [Group G] (ψ : G →* GL (Fin N) (v.adicCompletion F))

/-- The stabilizer of a local lattice $\Lambda$ in $G$, acting through $\psi$. -/
def stabLat (Λ : Submodule (v.adicCompletionIntegers F) (Fin N → v.adicCompletion F)) : Subgroup G where
  carrier := {g | locAct v (ψ g) Λ = Λ}
  mul_mem' {a b} ha hb := by
    simp only [Set.mem_ofPred_eq] at ha hb ⊢
    rw [map_mul, locAct_mul, hb, ha]
  one_mem' := by simp [locAct_one]
  inv_mem' {a} ha := by
    simp only [Set.mem_ofPred_eq] at ha ⊢
    rw [map_inv, locAct_eq_iff, inv_inv, ha]

/-- **Stabilizers of local lattices are commensurable** (the orbit of $\Lambda_2$ under $\mathrm{Stab}(\Lambda_1)$ lies between two fixed
boxes, so it is finite, `finite_sandwich_loc`). -/
theorem relIndex_stabLat_ne_zero {Λ₁ Λ₂ : Submodule (v.adicCompletionIntegers F) (Fin N → v.adicCompletion F)}
    (h₁ : Λ₁.IsLattice (v.adicCompletion F)) (h₂ : Λ₂.IsLattice (v.adicCompletion F)) :
    (stabLat v ψ Λ₂).relIndex (stabLat v ψ Λ₁) ≠ 0 := by
  classical
  obtain ⟨k₁, hk₁, hk₁'⟩ := exists_local_bounds v h₁
  obtain ⟨k₂, hk₂, hk₂'⟩ := exists_local_bounds v h₂
  set k := max k₁ k₂
  have hb1 : ball v k ≤ Λ₁ := (ball_anti v (by simp [k] : (k₁ : ℤ) ≤ k)).trans hk₁
  have hb1' : Λ₁ ≤ ball v (-k) := hk₁'.trans (ball_anti v (by simp [k] : -(k : ℤ) ≤ -k₁))
  have hb2 : ball v k ≤ Λ₂ := (ball_anti v (by simp [k] : (k₂ : ℤ) ≤ k)).trans hk₂
  have hb2' : Λ₂ ≤ ball v (-k) := hk₂'.trans (ball_anti v (by simp [k] : -(k : ℤ) ≤ -k₂))
  -- every translate of `Λ₂` by `Stab(Λ₁)` lies between `ball (3k)` and `ball (-3k)`
  have hbound : ∀ g ∈ stabLat v ψ Λ₁, ball v (3 * k : ℕ) ≤ locAct v (ψ g) Λ₂ ∧
      locAct v (ψ g) Λ₂ ≤ ball v (-(3 * k : ℕ)) := by
    intro g hg
    have hg' : locAct v (ψ g) Λ₁ = Λ₁ := hg
    constructor
    · intro y hy
      -- `ϖ^(-2k) y ∈ ball k ⊆ Λ₁ = gΛ₁`
      have hy0 : ϖk v (-(2 * k : ℤ)) • y ∈ (ball v k : Submodule _ _) := by
        have := (mem_ball_smul_iff v (j := (3 * k : ℕ)) (t := -(2 * k : ℤ)) y).mpr hy
        convert this using 2; push_cast; ring
      have hy1 := hb1 hy0
      rw [← hg'] at hy1
      obtain ⟨w, hw, hwy⟩ := hy1
      have hw2 : ϖk v (2 * k : ℤ) • w ∈ Λ₂ := by
        apply hb2
        have := (mem_ball_smul_iff v (j := -(k : ℤ)) (t := (2 * k : ℤ)) w).mpr (hb1' hw)
        convert this using 2; ring
      refine ⟨_, hw2, ?_⟩
      show (ψ g).val *ᵥ (ϖk v (2 * k : ℤ) • w) = y
      rw [mulVec_smul, show (ψ g).val *ᵥ w = ϖk v (-(2 * k : ℤ)) • y from hwy, smul_smul, ϖk_mul]
      simp
    · rintro _ ⟨z, hz, rfl⟩
      have hz1 : ϖk v (2 * k : ℤ) • z ∈ Λ₁ := by
        apply hb1
        have := (mem_ball_smul_iff v (j := -(k : ℤ)) (t := (2 * k : ℤ)) z).mpr (hb2' hz)
        convert this using 2; ring
      have hz2 : (ψ g).val *ᵥ (ϖk v (2 * k : ℤ) • z) ∈ Λ₁ := by
        rw [← hg']; exact ⟨_, hz1, rfl⟩
      rw [mulVec_smul] at hz2
      have := (mem_ball_smul_iff v (j := -((3 * k : ℕ) : ℤ)) (t := (2 * k : ℤ)) ((ψ g).val *ᵥ z)).mp
        (by convert hb1' hz2 using 2; push_cast; ring)
      exact this
  -- the quotient `Stab(Λ₁) / Stab(Λ₁) ∩ Stab(Λ₂)` injects into the finite set of sandwiched lattices
  set S₁ := stabLat v ψ Λ₁
  set T := {Λ : Submodule (v.adicCompletionIntegers F) (Fin N → v.adicCompletion F) |
      ball v (3 * k : ℕ) ≤ Λ ∧ Λ ≤ ball v (-(3 * k : ℕ))}
  have hT : T.Finite := finite_sandwich_loc v (3 * k)
  have hwd : ∀ a b : S₁, a⁻¹ * b ∈ (stabLat v ψ Λ₂).subgroupOf S₁ →
      locAct v (ψ a) Λ₂ = locAct v (ψ b) Λ₂ := by
    intro a b hab
    rw [Subgroup.mem_subgroupOf] at hab
    have hab' : locAct v (ψ ((a : G)⁻¹ * b)) Λ₂ = Λ₂ := hab
    rw [map_mul, locAct_mul, map_inv, locAct_eq_iff, inv_inv] at hab'
    exact hab'.symm
  let φq : S₁ ⧸ (stabLat v ψ Λ₂).subgroupOf S₁ → T :=
    Quotient.lift (fun a => ⟨locAct v (ψ a) Λ₂, hbound a a.2⟩)
      (fun a b hab => Subtype.ext (hwd a b (QuotientGroup.leftRel_apply.mp hab)))
  have hinj : Function.Injective φq := by
    intro a b hab
    induction a using Quotient.inductionOn' with | h a => ?_
    induction b using Quotient.inductionOn' with | h b => ?_
    apply Quotient.sound'
    rw [QuotientGroup.leftRel_apply, Subgroup.mem_subgroupOf]
    have h1 : locAct v (ψ a) Λ₂ = locAct v (ψ b) Λ₂ := congrArg Subtype.val hab
    show locAct v (ψ ((a : G)⁻¹ * b)) Λ₂ = Λ₂
    rw [map_mul, locAct_mul, ← h1, map_inv, locAct_inv_locAct]
  have : Finite T := hT.to_subtype
  have : Finite (S₁ ⧸ (stabLat v ψ Λ₂).subgroupOf S₁) := Finite.of_injective φq hinj
  exact Subgroup.index_ne_zero_of_finite

theorem commens_stabLat {Λ₁ Λ₂ : Submodule (v.adicCompletionIntegers F) (Fin N → v.adicCompletion F)}
    (h₁ : Λ₁.IsLattice (v.adicCompletion F)) (h₂ : Λ₂.IsLattice (v.adicCompletion F)) :
    Commens (stabLat v ψ Λ₁) (stabLat v ψ Λ₂) :=
  ⟨relIndex_stabLat_ne_zero v ψ h₁ h₂, relIndex_stabLat_ne_zero v ψ h₂ h₁⟩

theorem stabLat_map_conj (g : G) (Λ : Submodule (v.adicCompletionIntegers F) (Fin N → v.adicCompletion F)) :
    (stabLat v ψ Λ).map (MulAut.conj g).toMonoidHom = stabLat v ψ (locAct v (ψ g) Λ) := by
  ext x
  rw [Subgroup.mem_map_equiv (f := MulAut.conj g), MulAut.conj_symm_apply]
  show locAct v (ψ (g⁻¹ * x * g)) Λ = Λ ↔ locAct v (ψ x) (locAct v (ψ g) Λ) = locAct v (ψ g) Λ
  rw [map_mul, map_mul, map_inv, locAct_mul, locAct_mul, locAct_eq_iff, inv_inv]

end Commens


/-! ### The modular ratio of $O(Q')(F_\mathfrak p)$ is trivial (Cartan–Dieudonné) -/

section Modular

variable {F : Type*} [Field F] [NumberField F] {n : ℕ} (v : HeightOneSpectrum (𝓞 F)) (Q' : QuadForm F n)

local notation "Fv" => v.adicCompletion F
local notation "Qv" => Q'.map (algebraMap F (v.adicCompletion F))

theorem std_isLattice :
    (std v : Submodule (v.adicCompletionIntegers F) (Fin n → v.adicCompletion F)).IsLattice (v.adicCompletion F) :=
  isLattice_of_bounds v le_rfl le_rfl

theorem stdStab_eq_stabLat : stdStab Q' v = stabLat v (orthGroup Q' (v.adicCompletion F)).subtype (std v) := by
  ext g; rfl

/-- **The modular ratio** $\Delta(h) = r(K_0', hK_0'h^{-1}) = \mu(K_0')/\mu(hK_0'h^{-1})$ of $H = O(Q')(F_\mathfrak p)$, $K_0' = O(\mathfrak o_\mathfrak p^n)$. -/
def modRatio (h : orthGroup Q' (v.adicCompletion F)) : ℝ :=
  relRatio (stdStab Q' v) ((stdStab Q' v).map (MulAut.conj h).toMonoidHom)

theorem stdStab_map_conj (h : orthGroup Q' (v.adicCompletion F)) :
    (stdStab Q' v).map (MulAut.conj h).toMonoidHom =
      stabLat v (orthGroup Q' (v.adicCompletion F)).subtype
        (locAct v ((orthGroup Q' (v.adicCompletion F)).subtype h) (std v)) := by
  rw [stdStab_eq_stabLat, stabLat_map_conj]

theorem commens_std (g h : orthGroup Q' (v.adicCompletion F)) :
    Commens (stabLat v (orthGroup Q' (v.adicCompletion F)).subtype
        (locAct v ((orthGroup Q' (v.adicCompletion F)).subtype g) (std v)))
      (stabLat v (orthGroup Q' (v.adicCompletion F)).subtype
        (locAct v ((orthGroup Q' (v.adicCompletion F)).subtype h) (std v))) :=
  commens_stabLat v _ (locAct_isLattice _ (std_isLattice v)) (locAct_isLattice _ (std_isLattice v))

/-- **$\Delta$ is multiplicative** (the cocycle identity for index ratios and their invariance under conjugation). -/
theorem modRatio_mul (g h : orthGroup Q' (v.adicCompletion F)) :
    modRatio v Q' (g * h) = modRatio v Q' g * modRatio v Q' h := by
  set ψ := (orthGroup Q' (v.adicCompletion F)).subtype
  have h1 : stdStab Q' v = stabLat v ψ (locAct v (ψ 1) (std v)) := by
    rw [stdStab_eq_stabLat, map_one, locAct_one]
  unfold modRatio
  rw [stdStab_map_conj, stdStab_map_conj, stdStab_map_conj, h1]
  have e : relRatio (stabLat v ψ (locAct v (ψ g) (std v))) (stabLat v ψ (locAct v (ψ (g * h)) (std v))) =
      relRatio (stabLat v ψ (locAct v (ψ 1) (std v))) (stabLat v ψ (locAct v (ψ h) (std v))) := by
    rw [map_mul, locAct_mul, ← stabLat_map_conj, ← stabLat_map_conj, relRatio_map (MulAut.conj g).injective,
      map_one, locAct_one]
  rw [← e, relRatio_mul (commens_std v Q' 1 g) (commens_std v Q' g (g * h)) (commens_std v Q' 1 (g * h))]

theorem modRatio_one : modRatio v Q' 1 = 1 := by
  unfold modRatio
  rw [map_one]
  have : (stdStab Q' v).map (1 : MulAut (orthGroup Q' (v.adicCompletion F))).toMonoidHom = stdStab Q' v := by
    ext x; simp
  rw [this, relRatio_self]

theorem modRatio_pos (h : orthGroup Q' (v.adicCompletion F)) : 0 < modRatio v Q' h := by
  unfold modRatio
  rw [stdStab_map_conj, stdStab_eq_stabLat]
  have := commens_std v Q' 1 h
  rw [map_one, locAct_one] at this
  exact relRatio_pos this

/-- **$\Delta = 1$ on involutions:** $\Delta(\tau)^2 = \Delta(\tau^2) = 1$ and $\Delta > 0$. -/
theorem modRatio_eq_one_of_involution {τ : orthGroup Q' (v.adicCompletion F)} (hτ : τ * τ = 1) :
    modRatio v Q' τ = 1 := by
  have h1 := modRatio_mul v Q' τ τ
  rw [hτ, modRatio_one] at h1
  have h2 := modRatio_pos v Q' τ
  nlinarith [h1, h2]

/-! #### Reflections -/

theorem reflMat_mul_self {A : Type*} [CommRing A] {x w : Fin n → A} (h : w ⬝ᵥ x = 2) :
    QuadForm.reflMat x w * QuadForm.reflMat x w = 1 := by
  rw [QuadForm.reflMat, sub_mul, mul_sub, mul_sub, one_mul, mul_one, one_mul, vecMulVec_mul_vecMulVec, h]
  ext i j
  simp [vecMulVec_apply, two_smul]
  ring

theorem eval_map_mulVec_orth (k : orthGroup Q' (v.adicCompletion F)) (z : Fin n → v.adicCompletion F) :
    (Qv).eval ((k : GL (Fin n) (v.adicCompletion F)).val *ᵥ z) = (Qv).eval z := by
  rw [← evalIn_eq_eval_map, ← evalIn_eq_eval_map]
  exact evalIn_mulVec_of_mem Q' k.2 z

theorem bil_eq_polar (u y : Fin n → v.adicCompletion F) :
    ((Qv).hessian *ᵥ u) ⬝ᵥ y = (Qv).eval (u + y) - (Qv).eval u - (Qv).eval y := by
  rw [eval_polar, hess_dot_comm, dotProduct_comm]

theorem bil_mulVec_orth (k : orthGroup Q' (v.adicCompletion F)) (u y : Fin n → v.adicCompletion F) :
    ((Qv).hessian *ᵥ ((k : GL (Fin n) (v.adicCompletion F)).val *ᵥ u)) ⬝ᵥ
        ((k : GL (Fin n) (v.adicCompletion F)).val *ᵥ y) = ((Qv).hessian *ᵥ u) ⬝ᵥ y := by
  rw [bil_eq_polar, bil_eq_polar, ← mulVec_add, eval_map_mulVec_orth, eval_map_mulVec_orth, eval_map_mulVec_orth]

/-- **The reflection** $\tau_u \in O(Q')(F_\mathfrak p)$ in an anisotropic vector $u$. -/
def reflElt (u : Fin n → v.adicCompletion F) (hu : (Qv).eval u ≠ 0) : orthGroup Q' (v.adicCompletion F) :=
  have hw : (Qv).hessian *ᵥ u = (Qv).eval u • (((Qv).eval u)⁻¹ • ((Qv).hessian *ᵥ u)) := by
    rw [smul_smul, mul_inv_cancel₀ hu, one_smul]
  have hsq : ((Qv).eval u)⁻¹ • ((Qv).hessian *ᵥ u) ⬝ᵥ u = 2 := by
    rw [smul_dotProduct, dotProduct_comm, dotProduct_hessian_self, smul_eq_mul, mul_left_comm,
      inv_mul_cancel₀ hu, mul_one]
  ⟨⟨QuadForm.reflMat u (((Qv).eval u)⁻¹ • ((Qv).hessian *ᵥ u)),
      QuadForm.reflMat u (((Qv).eval u)⁻¹ • ((Qv).hessian *ᵥ u)), reflMat_mul_self hsq, reflMat_mul_self hsq⟩,
    mem_orthGroup_of_evalIn Q' fun z => by
      rw [evalIn_eq_eval_map, evalIn_eq_eval_map]
      exact QuadForm.eval_reflMat (Qv) hw z⟩

theorem reflElt_mulVec (u : Fin n → v.adicCompletion F) (hu : (Qv).eval u ≠ 0) (y : Fin n → v.adicCompletion F) :
    ((reflElt v Q' u hu : orthGroup Q' _) : GL (Fin n) (v.adicCompletion F)).val *ᵥ y =
      y - (((Qv).eval u)⁻¹ * (((Qv).hessian *ᵥ u) ⬝ᵥ y)) • u := by
  show QuadForm.reflMat u _ *ᵥ y = _
  rw [QuadForm.reflMat_mulVec, smul_dotProduct, smul_eq_mul]

theorem reflElt_mul_self (u : Fin n → v.adicCompletion F) (hu : (Qv).eval u ≠ 0) :
    reflElt v Q' u hu * reflElt v Q' u hu = 1 := by
  apply Subtype.ext; apply Units.ext
  show QuadForm.reflMat u _ * QuadForm.reflMat u _ = 1
  refine reflMat_mul_self ?_
  rw [smul_dotProduct, dotProduct_comm, dotProduct_hessian_self, smul_eq_mul, mul_left_comm,
    inv_mul_cancel₀ hu, mul_one]

theorem reflElt_fix (u : Fin n → v.adicCompletion F) (hu : (Qv).eval u ≠ 0) {y : Fin n → v.adicCompletion F}
    (hy : ((Qv).hessian *ᵥ u) ⬝ᵥ y = 0) :
    ((reflElt v Q' u hu : orthGroup Q' _) : GL (Fin n) (v.adicCompletion F)).val *ᵥ y = y := by
  rw [reflElt_mulVec, hy, mul_zero, zero_smul, sub_zero]

theorem modRatio_reflElt (u : Fin n → v.adicCompletion F) (hu : (Qv).eval u ≠ 0) :
    modRatio v Q' (reflElt v Q' u hu) = 1 :=
  modRatio_eq_one_of_involution v Q' (reflElt_mul_self v Q' u hu)

end Modular


/-! ### Cartan–Dieudonné: $\Delta \equiv 1$ -/

section CD

variable {F : Type*} [Field F] [NumberField F] {n : ℕ} (v : HeightOneSpectrum (𝓞 F)) (Q' : QuadForm F n)

local notation "Fv" => v.adicCompletion F
local notation "Qv" => Q'.map (algebraMap F (v.adicCompletion F))

/-- **The modular ratio of $O(Q')(F_\mathfrak p)$ is trivial** (every prime, dyadic included; $Q'$ nondegenerate): $O(Q')(F_\mathfrak p)$
is generated by reflections (Cartan–Dieudonné: with an orthogonal basis $b_0, \dots, b_{n-1}$, an isometry fixing $b_0, \dots, b_{j-1}$
becomes one fixing $b_0, \dots, b_j$ after composing with $\tau_{y - x}$, or with $\tau_x\tau_{y+x}$ when $Q(y - x) = 0$, where
$x = b_j$, $y = gx$), and $\Delta$ is a homomorphism to $\mathbb R_{>0}$ that is $1$ on involutions (cf. O'Meara 1963, 43:3,
p. 102; Artin, *Geometric Algebra*, Thm. 3.20 [unverified]). -/
@[kb "omeara1963" "§43B, 43:3, p. 102 (generation by symmetries)"]
theorem modRatio_eq_one (hQ' : Q'.Nondegenerate) (g : orthGroup Q' (v.adicCompletion F)) :
    modRatio v Q' g = 1 := by
  classical
  set H := (Qv).hessian
  have hdet : H.det ≠ 0 := by
    rw [show H = Q'.hessian.map (algebraMap F (v.adicCompletion F)) from hessian_map _ _,
      ← RingHom.mapMatrix_apply, ← RingHom.map_det]
    exact (map_ne_zero _).mpr hQ'
  set Bf : LinearMap.BilinForm (v.adicCompletion F) (Fin n → v.adicCompletion F) := Matrix.toBilin' H
  have hBf : ∀ x y, Bf x y = (H *ᵥ x) ⬝ᵥ y := fun x y => by
    rw [Matrix.toBilin'_apply', dotProduct_comm, hess_dot_comm]
  have hsymm : Bf.IsSymm := LinearMap.BilinForm.isSymm_def.mpr fun x y => by rw [hBf, hBf, hess_dot_comm]
  let _ : Invertible (2 : v.adicCompletion F) := invertibleOfNonzero two_ne_zero
  obtain ⟨b, hb⟩ := LinearMap.BilinForm.exists_orthogonal_basis (LinearMap.BilinForm.isSymm_iff.mp hsymm)
  have hb' : ∀ i j, i ≠ j → (H *ᵥ b i) ⬝ᵥ b j = 0 := fun i j hij => by rw [← hBf]; exact hb hij
  -- the basis vectors are anisotropic
  have hani : ∀ i, (Qv).eval (b i) ≠ 0 := by
    intro i h0
    have hall : ∀ j, (H *ᵥ b i) ⬝ᵥ b j = 0 := by
      intro j
      by_cases hij : i = j
      · subst hij; rw [dotProduct_comm, dotProduct_hessian_self, h0, mul_zero]
      · exact hb' i j hij
    have hy : ∀ y, (H *ᵥ b i) ⬝ᵥ y = 0 := by
      intro y
      rw [← b.sum_repr y, dotProduct_sum]
      exact Finset.sum_eq_zero fun j _ => by rw [dotProduct_smul, hall j, smul_zero]
    have hzero : H *ᵥ b i = 0 := by
      funext k
      have := hy (Pi.single k 1)
      rwa [dotProduct_single, mul_one] at this
    exact b.ne_zero i (Matrix.eq_zero_of_mulVec_eq_zero hdet hzero)
  -- downward induction on the number of fixed basis vectors
  have key : ∀ d j, Fintype.card (Fin (Module.finrank (v.adicCompletion F) (Fin n → v.adicCompletion F))) - j = d →
      ∀ g : orthGroup Q' (v.adicCompletion F),
        (∀ i : Fin (Module.finrank (v.adicCompletion F) (Fin n → v.adicCompletion F)), i.val < j →
          (g : GL (Fin n) (v.adicCompletion F)).val *ᵥ b i = b i) → modRatio v Q' g = 1 := by
    intro d
    induction d with
    | zero =>
      intro j hj g hg
      have hfix : ∀ i, (g : GL (Fin n) (v.adicCompletion F)).val *ᵥ b i = b i :=
        fun i => hg i (by have := i.2; simp only [Fintype.card_fin] at hj; omega)
      have hlin : Matrix.toLin' (g : GL (Fin n) (v.adicCompletion F)).val = LinearMap.id :=
        b.ext fun i => by rw [Matrix.toLin'_apply, hfix i, LinearMap.id_apply]
      have hg1 : g = 1 := by
        apply Subtype.ext; apply Units.ext
        show (g : GL (Fin n) (v.adicCompletion F)).val = (1 : Matrix (Fin n) (Fin n) (v.adicCompletion F))
        exact Matrix.toLin'.injective (by rw [hlin, Matrix.toLin'_one])
      rw [hg1, modRatio_one]
    | succ d ih =>
      intro j hj g hg
      have hjlt : j < Module.finrank (v.adicCompletion F) (Fin n → v.adicCompletion F) := by
        simp only [Fintype.card_fin] at hj; omega
      set i₀ : Fin (Module.finrank (v.adicCompletion F) (Fin n → v.adicCompletion F)) := ⟨j, hjlt⟩
      set x := b i₀
      set y := (g : GL (Fin n) (v.adicCompletion F)).val *ᵥ x
      have hQy : (Qv).eval y = (Qv).eval x := eval_map_mulVec_orth v Q' g x
      have hQx : (Qv).eval x ≠ 0 := hani i₀
      have hx0 : ∀ i : Fin (Module.finrank (v.adicCompletion F) (Fin n → v.adicCompletion F)), i.val < j →
          (H *ᵥ x) ⬝ᵥ b i = 0 := by
        intro i hi
        refine hb' i₀ i fun h => ?_
        rw [← h] at hi; exact absurd hi (lt_irrefl _)
      have hy0 : ∀ i : Fin (Module.finrank (v.adicCompletion F) (Fin n → v.adicCompletion F)), i.val < j →
          (H *ᵥ y) ⬝ᵥ b i = 0 := by
        intro i hi
        rw [← hg i hi, bil_mulVec_orth]; exact hx0 i hi
      -- `Q(y + t x) = Q(y) + t B(y, x) + t^2 Q(x)`
      set Bxy := (H *ᵥ y) ⬝ᵥ x
      have hyy : (H *ᵥ y) ⬝ᵥ y = 2 * (Qv).eval y := by rw [dotProduct_comm, dotProduct_hessian_self]
      have hxx : (H *ᵥ x) ⬝ᵥ x = 2 * (Qv).eval x := by rw [dotProduct_comm, dotProduct_hessian_self]
      have hxy : (H *ᵥ x) ⬝ᵥ y = Bxy := hess_dot_comm _ x y
      have hQm : (Qv).eval (y - x) = (Qv).eval y - Bxy + (Qv).eval x := by
        have := eval_add_smul_gen (Qv) y x (-1)
        rw [neg_one_smul, ← sub_eq_add_neg] at this
        rw [this]; ring
      have hQp : (Qv).eval (y + x) = (Qv).eval y + Bxy + (Qv).eval x := by
        have := eval_add_smul_gen (Qv) y x 1
        rw [one_smul] at this
        rw [this]; ring
      -- the new isometry fixes `b₀, …, b_j`
      have hstep : ∀ τ : orthGroup Q' (v.adicCompletion F), modRatio v Q' τ = 1 →
          (τ : GL (Fin n) (v.adicCompletion F)).val *ᵥ y = x →
          (∀ i : Fin (Module.finrank (v.adicCompletion F) (Fin n → v.adicCompletion F)), i.val < j →
            (τ : GL (Fin n) (v.adicCompletion F)).val *ᵥ b i = b i) → modRatio v Q' g = 1 := by
        intro τ hτ hτy hτfix
        have hfix' : ∀ i : Fin (Module.finrank (v.adicCompletion F) (Fin n → v.adicCompletion F)), i.val < j + 1 →
            ((τ * g : orthGroup Q' (v.adicCompletion F)) : GL (Fin n) (v.adicCompletion F)).val *ᵥ b i = b i := by
          intro i hi
          simp only [Subgroup.coe_mul, Units.val_mul, ← mulVec_mulVec]
          rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hi | hi
          · rw [hg i hi, hτfix i hi]
          · have : i = i₀ := Fin.ext hi
            rw [this]; exact hτy
        have := ih (j + 1) (by omega) (τ * g) hfix'
        rwa [modRatio_mul, hτ, one_mul] at this
      by_cases hd : (Qv).eval (y - x) ≠ 0
      · -- one reflection, in `y - x`
        refine hstep (reflElt v Q' (y - x) hd) (modRatio_reflElt v Q' _ hd) ?_ fun i hi => ?_
        · rw [reflElt_mulVec]
          have hB : (H *ᵥ (y - x)) ⬝ᵥ y = (Qv).eval (y - x) := by
            rw [mulVec_sub, sub_dotProduct, hyy, hxy, hQm, hQy]; ring
          rw [hB, inv_mul_cancel₀ hd, one_smul]; abel
        · refine reflElt_fix v Q' _ hd ?_
          rw [mulVec_sub, sub_dotProduct, hy0 i hi, hx0 i hi, sub_zero]
      · -- two reflections, in `y + x` and in `x`
        push Not at hd
        have hBxy : Bxy = 2 * (Qv).eval x := by
          have := hQm; rw [hd, hQy] at this; linear_combination this
        have hsum : (Qv).eval (y + x) ≠ 0 := by
          rw [hQp, hBxy, hQy]
          have : (4 : v.adicCompletion F) ≠ 0 := by norm_num
          intro h; apply hQx
          have h' : 4 * (Qv).eval x = 0 := by linear_combination h
          exact (mul_eq_zero.mp h').resolve_left this
        have hτ₁ : ((reflElt v Q' (y + x) hsum : orthGroup Q' _) : GL (Fin n) (v.adicCompletion F)).val *ᵥ y = -x := by
          rw [reflElt_mulVec]
          have hB : (H *ᵥ (y + x)) ⬝ᵥ y = (Qv).eval (y + x) := by
            rw [mulVec_add, add_dotProduct, hyy, hxy, hQp, hQy]; ring
          rw [hB, inv_mul_cancel₀ hsum, one_smul]; abel
        have hτ₂ : ((reflElt v Q' x hQx : orthGroup Q' _) : GL (Fin n) (v.adicCompletion F)).val *ᵥ (-x) = x := by
          rw [reflElt_mulVec, dotProduct_neg, hxx]
          have hc : ((Qv).eval x)⁻¹ * -(2 * (Qv).eval x) = -2 := by field_simp
          rw [hc, neg_smul, sub_neg_eq_add, two_smul]; abel
        refine hstep (reflElt v Q' x hQx * reflElt v Q' (y + x) hsum)
          (by rw [modRatio_mul, modRatio_reflElt, modRatio_reflElt, one_mul]) ?_ fun i hi => ?_
        · simp only [Subgroup.coe_mul, Units.val_mul, ← mulVec_mulVec]
          rw [hτ₁, hτ₂]
        · simp only [Subgroup.coe_mul, Units.val_mul, ← mulVec_mulVec]
          rw [reflElt_fix v Q' _ hsum (by rw [mulVec_add, add_dotProduct, hy0 i hi, hx0 i hi, add_zero]),
            reflElt_fix v Q' _ hQx (hx0 i hi)]
  exact key _ 0 rfl g fun i hi => absurd hi (Nat.not_lt_zero _)

end CD


/-! ### The local weights do not depend on the representative -/

section Invariance

variable {F : Type*} [Field F] [NumberField F] {n : ℕ} (v : HeightOneSpectrum (𝓞 F))

/-- **`LocWeightInvariant` at every prime, locally** (any nondegenerate $Q'$, dyadic primes included, no global hypothesis):
$w(hM) = r(K_0', hK_Mh^{-1}) = r(K_0', hK_0'h^{-1})\,r(hK_0'h^{-1}, hK_Mh^{-1}) = \Delta(h)\,w(M) = w(M)$ (`relRatio_mul`, `relRatio_map`,
`modRatio_eq_one`); all the subgroups are stabilizers of local lattices, hence commensurable (`commens_stabLat`). -/
@[kb "weil1982" "§3.5 (independence of the representative) [unverified locator]"]
theorem locWeightInvariant_local (m : F) (Q' : QuadForm F n) (hQ' : Q'.Nondegenerate) :
    LocWeightInvariant v m Q' := by
  refine ⟨fun h M => ?_⟩
  set ψ : orthGroup Q' (v.adicCompletion F) →* GL (Fin (n + 1)) (v.adicCompletion F) :=
    (orthGroup (splitForm m Q') (v.adicCompletion F)).subtype.comp (orthEmb m Q' (v.adicCompletion F))
  have hstab : ∀ N : LocCompSet v m Q', stabilizer (orthGroup Q' (v.adicCompletion F)) N = stabLat v ψ N.1 := by
    intro N
    ext g
    rw [mem_stabilizer_iff]
    constructor
    · intro hg; exact congrArg Subtype.val hg
    · intro hg; exact Subtype.ext hg
  have hlat : ∀ N : LocCompSet v m Q', N.1.IsLattice (v.adicCompletion F) := by
    intro N
    obtain ⟨g, hg⟩ := N.2.1
    rw [← hg]; exact locAct_isLattice _ (std_isLattice v)
  have hK₀ : stdStab Q' v = stabLat v ψ (locStdPt v m Q').1 := by
    rw [← hstab, stabilizer_locStdPt]
  have hmod := modRatio_eq_one v Q' hQ' h
  unfold modRatio at hmod
  show relRatio (stdStab Q' v) (stabilizer _ (h • M)) = relRatio (stdStab Q' v) (stabilizer _ M)
  rw [stabilizer_smul_eq_stabilizer_map_conj]
  have hc1 : Commens (stdStab Q' v) ((stdStab Q' v).map (MulAut.conj h).toMonoidHom) := by
    rw [hK₀, stabLat_map_conj]; exact commens_stabLat v ψ (hlat _) (locAct_isLattice _ (hlat _))
  have hc2 : Commens ((stdStab Q' v).map (MulAut.conj h).toMonoidHom)
      ((stabilizer (orthGroup Q' (v.adicCompletion F)) M).map (MulAut.conj h).toMonoidHom) := by
    rw [hK₀, hstab, stabLat_map_conj, stabLat_map_conj]
    exact commens_stabLat v ψ (locAct_isLattice _ (hlat _)) (locAct_isLattice _ (hlat _))
  have hc3 : Commens (stdStab Q' v)
      ((stabilizer (orthGroup Q' (v.adicCompletion F)) M).map (MulAut.conj h).toMonoidHom) := by
    rw [hK₀, hstab, stabLat_map_conj]; exact commens_stabLat v ψ (hlat _) (locAct_isLattice _ (hlat _))
  rw [← relRatio_mul hc1 hc2 hc3, hmod, one_mul, relRatio_map (MulAut.conj h).injective]

/-- **`LocalTypeOrbitCount` at every prime, purely locally** (Weil 1982, §3.4 [unverified]): for $m \ne 0$ and $Q_0'$
nondegenerate, at **every** finite prime (dyadic primes and primes dividing $m$ included), with no global hypothesis,
$W_\mathfrak p\,|O(Q\bmod\varpi^k)\,e_0| = \#\{x \bmod \varpi^k : Q(x)\equiv m\}$ for $k \gg 0$. -/
@[kb "weil1982" "§3.4 (orbits of the local fibration, every prime) [unverified]"]
theorem localTypeOrbitCount_local (m₀ : 𝓞 F) (hm : m₀ ≠ 0) (Q₀' : QuadForm (𝓞 F) n)
    (hQ' : Q₀'.Nondegenerate) : LocalTypeOrbitCount v Q₀' m₀ := by
  have hQF : (Q₀'.map (algebraMap (𝓞 F) F)).Nondegenerate := by
    rw [QuadForm.Nondegenerate, hessian_map, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
    exact (map_ne_zero_iff _ RingOfIntegers.coe_injective).mpr hQ'
  exact localTypeOrbitCount_of_invariant v m₀ hm Q₀' hQ' (locWeightInvariant_local v _ _ hQF)

/-- **Weil's local orbital identity at every prime, purely locally** (Weil 1982, §3.4 [unverified]; Kitaoka 1993, §6.8
[unverified]): $W_\mathfrak p\,\alpha_\mathfrak p(L, L)\,|2m|_\mathfrak p^{\,n} = \alpha_\mathfrak p(L', L')\,\beta_\mathfrak p(L, m)$ for $m \ne 0$, $Q_0'$
nondegenerate, every finite prime (dyadic included). -/
@[kb "weil1982" "§3.4 (local fibration, every prime) [unverified]"]
theorem localOrbitalIdentityAt_local (m₀ : 𝓞 F) (hm : m₀ ≠ 0) (Q₀' : QuadForm (𝓞 F) n)
    (hQ' : Q₀'.Nondegenerate) : LocalOrbitalIdentityAt v Q₀' m₀ :=
  localOrbitalIdentityAt_of_orbitCount v m₀ hm Q₀' hQ' (localTypeOrbitCount_local v m₀ hm Q₀' hQ')

end Invariance

/-! ### Consequences: the local identity at every prime, and the global statements without `hbad` -/

section Final

variable {F : Type} [Field F] [NumberField F] {n : ℕ}

theorem nondegenerate_of_posDef_split (m₀ : 𝓞 F) (Q₀' : QuadForm (𝓞 F) n)
    (hpd : IsTotallyPosDef ((splitForm m₀ Q₀').map (algebraMap (𝓞 F) F))) : Q₀'.Nondegenerate := by
  rw [map_splitForm_alg] at hpd
  exact nondegenerate_of_map (isTotallyPosDef_of_splitForm hpd).nondegenerate

/-- **The `LocalOrbitalIdentity` without `hbad`** (convergent Euler products): every local identity is now a theorem. -/
@[kb "weil1982" "§3.4-3.5 (local fibration, product over p) [unverified locator]"]
theorem localOrbitalIdentity_of_conv (m₀ : 𝓞 F) (hm : m₀ ≠ 0) (Q₀' : QuadForm (𝓞 F) n)
    (hpd : IsTotallyPosDef ((splitForm m₀ Q₀').map (algebraMap (𝓞 F) F)))
    (hLi : IsIntegral ((splitForm m₀ Q₀').map (algebraMap (𝓞 F) F)) (stdLat F (n + 1)).1)
    (hb : Multipliable fun v => NF.siegelDensity v Q₀' Q₀')
    (hβ : Multipliable fun v => NF.localDensity v (splitForm m₀ Q₀') m₀) :
    LocalOrbitalIdentity Q₀' m₀ :=
  localOrbitalIdentity_of_local m₀ hm Q₀' hpd hLi (fun v _ => localOrbitalIdentityAt_local v m₀ hm Q₀' (nondegenerate_of_posDef_split m₀ Q₀' hpd)) hb hβ

/-- **The `LocalOrbitalIdentity` without `hbad`** ($n \ge 3$), given the mass formula in rank $n$ (which makes
$\prod_\mathfrak p\alpha_\mathfrak p(L') \ne 0$; the Euler products converge in every rank $\ne 0, 2$). -/
@[kb "weil1982" "§3.4-3.5 (local fibration, product over p) [unverified locator]"]
theorem localOrbitalIdentity' (m₀ : 𝓞 F) (hm : m₀ ≠ 0) (Q₀' : QuadForm (𝓞 F) n) (hn : 3 ≤ n)
    (hpd : IsTotallyPosDef ((splitForm m₀ Q₀').map (algebraMap (𝓞 F) F)))
    (hLi : IsIntegral ((splitForm m₀ Q₀').map (algebraMap (𝓞 F) F)) (stdLat F (n + 1)).1)
    (hIH : MassFormulaHolds Q₀') : LocalOrbitalIdentity Q₀' m₀ :=
  localOrbitalIdentity_of_massFormula m₀ hm Q₀' hn hpd hLi
    (fun v _ => localOrbitalIdentityAt_local v m₀ hm Q₀' (nondegenerate_of_posDef_split m₀ Q₀' hpd)) hIH

/-- **Weil's induction step, with the local identity proved at every prime** ($n \ge 3$): Siegel's formula for $m$ and the
mass formula in rank $n$ give the mass formula in rank $n + 1$. -/
@[kb "weil1982" "§4.5, pp. 100-109 (induction on m); Thm. 4.5.1, p. 109"]
theorem massFormula_succ' (m₀ : 𝓞 F) (hm : m₀ ≠ 0) (Q₀' : QuadForm (𝓞 F) n) (hn : 3 ≤ n)
    (hpd : IsTotallyPosDef ((splitForm m₀ Q₀').map (algebraMap (𝓞 F) F)))
    (hLi : IsIntegral ((splitForm m₀ Q₀').map (algebraMap (𝓞 F) F)) (stdLat F (n + 1)).1)
    (hS : SiegelFormulaAt (splitForm m₀ Q₀') m₀) (hIH : MassFormulaHolds Q₀') :
    MassFormulaHolds (splitForm m₀ Q₀') :=
  massFormula_succ_of_local m₀ hm Q₀' hn hpd hLi hS (fun v _ => localOrbitalIdentityAt_local v m₀ hm Q₀' (nondegenerate_of_posDef_split m₀ Q₀' hpd)) hIH

/-- **$\tau(SO) = 2$ in rank $n + 1$** from Siegel's formula for $m$ and the mass formula in rank $n$ ($n \ge 3$); no local input. -/
@[kb "weil1982" "Thm. 4.5.1, p. 109 (τ(SO) = 2 for m ≥ 3)"]
theorem tamagawaNumberTwo_succ' (m₀ : 𝓞 F) (hm : m₀ ≠ 0) (Q₀' : QuadForm (𝓞 F) n) (hn : 3 ≤ n)
    (hpd : IsTotallyPosDef ((splitForm m₀ Q₀').map (algebraMap (𝓞 F) F)))
    (hLi : IsIntegral ((splitForm m₀ Q₀').map (algebraMap (𝓞 F) F)) (stdLat F (n + 1)).1)
    (hS : SiegelFormulaAt (splitForm m₀ Q₀') m₀) (hIH : MassFormulaHolds Q₀') :
    TamagawaNumberTwo (splitForm m₀ Q₀') :=
  tamagawaNumberTwo_succ_of_local m₀ hm Q₀' hn hpd hLi hS
    (fun v _ => localOrbitalIdentityAt_local v m₀ hm Q₀' (nondegenerate_of_posDef_split m₀ Q₀' hpd)) hIH

/-- **Siegel's formula for $m$ from $\tau(SO) = 2$ in ranks $n + 1$ and $n$** ($n \ge 3$, $Q$ totally positive definite with
$\mathcal O_F^{n+1}$ integral): the direction used for the frame identity, now with no local input (the local orbital identity holds at every prime,
`localOrbitalIdentityAt_local`). -/
@[kb "weil1982" "§4.5, p. 100 (τ(G) = 2 is equivalent to Siegel's main theorem); Thm. 4.5.1, p. 109"]
theorem siegelFormulaAt_of_tamagawa' (m₀ : 𝓞 F) (hm : m₀ ≠ 0) (Q₀' : QuadForm (𝓞 F) n) (hn : 3 ≤ n)
    (hpd : IsTotallyPosDef ((splitForm m₀ Q₀').map (algebraMap (𝓞 F) F)))
    (hLi : IsIntegral ((splitForm m₀ Q₀').map (algebraMap (𝓞 F) F)) (stdLat F (n + 1)).1)
    (hτ : TamagawaNumberTwo (splitForm m₀ Q₀')) (hτ' : TamagawaNumberTwo Q₀') :
    SiegelFormulaAt (splitForm m₀ Q₀') m₀ :=
  siegelFormulaAt_of_tamagawa m₀ hm Q₀' hn hpd hLi (fun v _ => localOrbitalIdentityAt_local v m₀ hm Q₀' (nondegenerate_of_posDef_split m₀ Q₀' hpd)) hτ hτ'

end Final

end QuadFormsKB.Tamagawa
