/-
# Local left ideal counts of maximal quaternion orders

**Layer:** $R$ a discrete valuation ring with uniformizer $\pi$ (for the applications $R = \mathfrak o_v$).

The local factor of the zeta function $\zeta_{\mathcal O}(s) = \sum_{J}N(J)^{-s}$ of a maximal order $\mathcal O$ at a finite place $v$ is the
generating function of the numbers
$$a_v(k) = \#\{J \subseteq \mathcal O_v \text{ integral left ideal} : \operatorname{nrd}(J) = \mathfrak p_v^k\}$$
(Voight 2021, (26.3.13) and Lemma 26.4.1; locators checked in the author's PDF): $a_v(k) = \sum_{i=0}^kq^i$ if $D_v \cong M_2(F_v)$ (split) and $a_v(k) = 1$ if
$D_v$ is a division algebra (ramified), $q = N\mathfrak p_v$. This file proves both counts.

**Contents.**
* *Lattices in $R^2$.* `detIdeal M` $= (\det(x,y) : x, y \in M)$ for an $R$-submodule $M \subseteq R^2$; the Hermite lattices
  `hnf a b c` $= R(\pi^a, c) + R(0, \pi^b)$ have `detIdeal` $= (\pi^{a+b})$ (`detIdeal_hnf`), every $M$ with `detIdeal M` $= (\pi^k)$ is
  one of them (`exists_eq_hnf`), uniquely up to $c \bmod \pi^b$ (`hnf_eq_hnf_iff`). Hence
  `latticeEquiv`: $\{M : \operatorname{detIdeal}M = (\pi^k)\} \simeq \Sigma_{b\le k}R/\pi^bR$ (Hermite normal form).
* *Left ideals of $M_2(R)$.* `rowSpace`, `ofRowSpace`: left ideals of $M_2(R)$ are the matrices with rows in a submodule
  $M \subseteq R^2$ (`leftIdealEquiv`), and the reduced-norm ideal $(\det X : X \in I)$ is `detIdeal M` (`matNrdIdeal_ofRowSpace`). So
  $\#\{I : \operatorname{nrd}(I) = (\pi^k)\} = \sum_{b=0}^k\#R/\pi^bR$ (`card_matIdeal`).

Sources: Voight, *Quaternion Algebras* (2021), (26.3.13) (the local factors $\zeta_{\mathcal O_v}(s)$), Lemma 26.4.1 (the counts; (b) is
stated for right ideals with lower-triangular elementary-divisor form $\begin{pmatrix}\pi^u & 0\\ c & \pi^v\end{pmatrix}$, $c \in R/\mathfrak p^v$; here
left ideals and the transposed row form), Cor. 26.4.7, Ex. 3.3.3 ($\operatorname{nrd} = \det$ on $M_2$).
-/
import QuadFormsKB.Tamagawa.QuatOrderGlobal
import QuadFormsKB.Tamagawa.LocalRankFive

open Polynomial Quaternion

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.QuatOrder

open Submodule QuadFormsKB.Quat

/-! ### Lattices in $R^2$ over a DVR: the Hermite normal form -/

section Lattices

variable {R : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] {π : R}

/-- The $2\times2$ determinant $x_0y_1 - x_1y_0$ of two vectors of $R^2$. -/
def det2 (x y : Fin 2 → R) : R := x 0 * y 1 - x 1 * y 0

/-- **The determinant ideal** of a submodule $M \subseteq R^2$: generated by the determinants $\det(x, y)$, $x, y \in M$
(the index ideal $[R^2 : M]_R$ for $M$ of full rank). -/
def detIdeal (M : Submodule R (Fin 2 → R)) : Ideal R :=
  Ideal.span {d | ∃ x ∈ M, ∃ y ∈ M, d = det2 x y}

/-- **The Hermite lattice** $R(\pi^a, c) + R(0, \pi^b) \subseteq R^2$. -/
def hnf (π : R) (a b : ℕ) (c : R) : Submodule R (Fin 2 → R) :=
  span R {![π ^ a, c], ![0, π ^ b]}

theorem mem_hnf {a b : ℕ} {c : R} {x : Fin 2 → R} :
    x ∈ hnf π a b c ↔ ∃ r t : R, x = ![r * π ^ a, r * c + t * π ^ b] := by
  rw [hnf, mem_span_pair]
  constructor
  · rintro ⟨r, t, rfl⟩
    exact ⟨r, t, by ext i; fin_cases i <;> simp⟩
  · rintro ⟨r, t, rfl⟩
    exact ⟨r, t, by ext i; fin_cases i <;> simp⟩

theorem det2_hnf {a b : ℕ} {c : R} {x y : Fin 2 → R} (hx : x ∈ hnf π a b c) (hy : y ∈ hnf π a b c) :
    π ^ (a + b) ∣ det2 x y := by
  obtain ⟨r, t, rfl⟩ := mem_hnf.1 hx
  obtain ⟨r', t', rfl⟩ := mem_hnf.1 hy
  exact ⟨r * t' - t * r', by simp [det2]; ring⟩

/-- `detIdeal (hnf a b c)` $= (\pi^{a+b})$. -/
theorem detIdeal_hnf (a b : ℕ) (c : R) : detIdeal (hnf π a b c) = Ideal.span {π ^ (a + b)} := by
  apply le_antisymm
  · rw [detIdeal, Ideal.span_le]
    rintro d ⟨x, hx, y, hy, rfl⟩
    exact Ideal.mem_span_singleton.2 (det2_hnf hx hy)
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    refine Ideal.subset_span ⟨![π ^ a, c], subset_span (by simp), ![0, π ^ b], subset_span (by simp), ?_⟩
    simp [det2, pow_add]

/-- In a DVR, $(\pi^m) = (\pi^n)$ forces $m = n$ for a uniformizer $\pi$. -/
theorem pow_eq_of_span_eq (hπ : Irreducible π) {m n : ℕ}
    (h : Ideal.span {π ^ m} = Ideal.span {π ^ n}) : m = n := by
  have h1 : π ^ n ∣ π ^ m := Ideal.mem_span_singleton.1 (h ▸ Ideal.mem_span_singleton_self _)
  have h2 : π ^ m ∣ π ^ n := Ideal.mem_span_singleton.1 (h.symm ▸ Ideal.mem_span_singleton_self _)
  rw [pow_dvd_pow_iff hπ.ne_zero hπ.not_isUnit] at h1 h2
  omega

theorem hnf_congr {a b : ℕ} {c c' : R} (h : π ^ b ∣ c - c') : hnf π a b c = hnf π a b c' := by
  obtain ⟨u, hu⟩ := h
  have key : ∀ c c' : R, ∀ u : R, c - c' = π ^ b * u → hnf π a b c ≤ hnf π a b c' := by
    intro c c' u hu x hx
    obtain ⟨r, t, rfl⟩ := mem_hnf.1 hx
    refine mem_hnf.2 ⟨r, t + r * u, ?_⟩
    ext i; fin_cases i
    · simp
    · simp; linear_combination r * hu
  exact le_antisymm (key c c' u hu) (key c' c (-u) (by linear_combination -hu))

/-- **Every lattice of determinant ideal $(\pi^k)$ is a Hermite lattice:** if `detIdeal M` $= (\pi^k)$ then
$M = R(\pi^{k-b}, c) + R(0, \pi^b)$ for some $b \le k$ and $c \in R$. -/
theorem exists_eq_hnf (hπ : Irreducible π) {k : ℕ} {M : Submodule R (Fin 2 → R)}
    (hM : detIdeal M = Ideal.span {π ^ k}) : ∃ b ≤ k, ∃ c : R, M = hnf π (k - b) b c := by
  classical
  have hπk : π ^ k ≠ 0 := pow_ne_zero _ hπ.ne_zero
  -- the projection to the first coordinate
  set P : Ideal R := M.map (LinearMap.proj 0) with hP
  have hP0 : P ≠ ⊥ := by
    intro h0
    have hall : ∀ x ∈ M, x 0 = 0 := fun x hx => by
      have : x 0 ∈ P := ⟨x, hx, rfl⟩
      rw [h0] at this; exact this
    have : detIdeal M = ⊥ := by
      rw [detIdeal, Ideal.span_eq_bot]
      rintro d ⟨x, hx, y, hy, rfl⟩
      simp [det2, hall x hx, hall y hy]
    rw [hM, Ideal.span_singleton_eq_bot] at this
    exact hπk this
  obtain ⟨a, ha⟩ := IsDiscreteValuationRing.ideal_eq_span_pow_irreducible hP0 hπ
  obtain ⟨m0, hm0M, hm0⟩ : ∃ m0 ∈ M, m0 0 = π ^ a := by
    have : π ^ a ∈ P := by rw [ha]; exact Ideal.mem_span_singleton_self _
    obtain ⟨m0, hm0, h⟩ := this
    exact ⟨m0, hm0, h⟩
  -- the second-coordinate ideal
  set P2 : Ideal R := M.comap (LinearMap.single R (fun _ : Fin 2 => R) 1) with hP2
  have hmem2 : ∀ s : R, s ∈ P2 ↔ ![0, s] ∈ M := by
    intro s
    have : (LinearMap.single R (fun _ : Fin 2 => R) 1 s : Fin 2 → R) = ![0, s] := by
      ext i; fin_cases i <;> simp
    rw [hP2, Submodule.mem_comap, this]
  -- every element of M is r m0 + (0, s) with s ∈ P2
  have hdecomp : ∀ x ∈ M, ∃ r : R, x 0 = r * π ^ a ∧ x 1 - r * m0 1 ∈ P2 := by
    intro x hx
    have hx0 : x 0 ∈ P := ⟨x, hx, rfl⟩
    rw [ha] at hx0
    obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.1 hx0
    refine ⟨r, hr.symm, (hmem2 _).2 ?_⟩
    have : ![0, x 1 - r * m0 1] = x - r • m0 := by
      ext i; fin_cases i
      · simp [← hr, hm0]
      · simp
    rw [this]
    exact M.sub_mem hx (M.smul_mem _ hm0M)
  have hP20 : P2 ≠ ⊥ := by
    intro h0
    have hline : ∀ x ∈ M, ∃ r : R, x = r • m0 := by
      intro x hx
      obtain ⟨r, hr0, hr1⟩ := hdecomp x hx
      rw [h0, Ideal.mem_bot, sub_eq_zero] at hr1
      exact ⟨r, by ext i; fin_cases i <;> simp [hr0, hr1, hm0]⟩
    have : detIdeal M = ⊥ := by
      rw [detIdeal, Ideal.span_eq_bot]
      rintro d ⟨x, hx, y, hy, rfl⟩
      obtain ⟨r, rfl⟩ := hline x hx
      obtain ⟨r', rfl⟩ := hline y hy
      simp [det2]; ring
    rw [hM, Ideal.span_singleton_eq_bot] at this
    exact hπk this
  obtain ⟨b, hb⟩ := IsDiscreteValuationRing.ideal_eq_span_pow_irreducible hP20 hπ
  have hM_eq : M = hnf π a b (m0 1) := by
    apply le_antisymm
    · intro x hx
      obtain ⟨r, hr0, hr1⟩ := hdecomp x hx
      rw [hb] at hr1
      obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.1 hr1
      refine mem_hnf.2 ⟨r, t, ?_⟩
      ext i; fin_cases i
      · simp [hr0]
      · simp; linear_combination -ht
    · rw [hnf, span_le]
      intro z hz
      rcases hz with rfl | rfl
      · have : ![π ^ a, m0 1] = m0 := by ext i; fin_cases i <;> simp [hm0]
        rw [this]; exact hm0M
      · exact (hmem2 _).1 (by rw [hb]; exact Ideal.mem_span_singleton_self _)
  have hk : a + b = k := by
    have := hM
    rw [hM_eq, detIdeal_hnf] at this
    exact pow_eq_of_span_eq hπ this
  refine ⟨b, by omega, m0 1, ?_⟩
  rw [hM_eq, show k - b = a by omega]

/-- **Uniqueness of the Hermite normal form** (for fixed $a + b$): $R(\pi^a, c) + R(0,\pi^b) = R(\pi^{a'}, c') + R(0, \pi^{b'})$ with
$a + b = a' + b'$ iff $b = b'$ and $c \equiv c' \bmod \pi^b$. -/
theorem hnf_eq_hnf_iff (hπ : Irreducible π) {a b a' b' : ℕ} {c c' : R} (hab : a + b = a' + b') :
    hnf π a b c = hnf π a' b' c' ↔ b = b' ∧ π ^ b ∣ c - c' := by
  constructor
  · intro h
    have h1 : ![π ^ a', c'] ∈ hnf π a b c := by rw [h]; exact subset_span (by simp)
    have h2 : ![π ^ a, c] ∈ hnf π a' b' c' := by rw [← h]; exact subset_span (by simp)
    obtain ⟨r, t, hrt⟩ := mem_hnf.1 h1
    obtain ⟨r', t', hrt'⟩ := mem_hnf.1 h2
    have e1 := congrFun hrt 0
    have e2 := congrFun hrt' 0
    simp only [Matrix.cons_val_zero] at e1 e2
    have ha : a = a' := by
      have d1 : π ^ a ∣ π ^ a' := ⟨r, by rw [e1]; ring⟩
      have d2 : π ^ a' ∣ π ^ a := ⟨r', by rw [e2]; ring⟩
      rw [pow_dvd_pow_iff hπ.ne_zero hπ.not_isUnit] at d1 d2
      omega
    subst ha
    have hb : b = b' := by omega
    subst hb
    have hr : r = 1 := by
      have : π ^ a * (r - 1) = 0 := by linear_combination -e1
      rcases mul_eq_zero.1 this with h0 | h0
      · exact absurd h0 (pow_ne_zero _ hπ.ne_zero)
      · exact sub_eq_zero.1 h0
    subst hr
    have e3 := congrFun hrt 1
    simp only [Matrix.cons_val_one, Matrix.cons_val_fin_one, one_mul] at e3
    exact ⟨rfl, ⟨-t, by linear_combination -e3⟩⟩
  · rintro ⟨rfl, h⟩
    have : a = a' := by omega
    subst this
    exact hnf_congr h

/-- **The Hermite normal form as a bijection:** the lattices $M \subseteq R^2$ with `detIdeal M` $= (\pi^k)$ correspond to pairs
$(b, c)$ with $b \le k$ and $c \in R/\pi^bR$, via $M = R(\pi^{k-b}, c) + R(0, \pi^b)$. -/
def latticeEquiv (hπ : Irreducible π) (k : ℕ) :
    (Σ b : Fin (k + 1), R ⧸ Ideal.span {π ^ (b : ℕ)}) ≃ {M : Submodule R (Fin 2 → R) // detIdeal M = Ideal.span {π ^ k}} :=
  Equiv.ofBijective
    (fun p => ⟨hnf π (k - p.1) p.1 (Quotient.out p.2), by
      rw [detIdeal_hnf, Nat.sub_add_cancel (Nat.lt_succ_iff.1 p.1.2)]⟩)
    (by
      constructor
      · rintro ⟨b, c⟩ ⟨b', c'⟩ h
        have h' := congrArg Subtype.val h
        simp only at h'
        have hb := Nat.lt_succ_iff.1 b.2
        have hb' := Nat.lt_succ_iff.1 b'.2
        obtain ⟨hbb, hc⟩ := (hnf_eq_hnf_iff hπ (by omega)).1 h'
        have hbb' : b = b' := Fin.ext hbb
        subst hbb'
        have : c = c' := by
          rw [← Quotient.out_eq c, ← Quotient.out_eq c']
          exact Ideal.Quotient.eq.2 (Ideal.mem_span_singleton.2 hc)
        rw [this]
      · rintro ⟨M, hM⟩
        obtain ⟨b, hb, c, rfl⟩ := exists_eq_hnf hπ hM
        refine ⟨⟨⟨b, Nat.lt_succ_iff.2 hb⟩, Ideal.Quotient.mk _ c⟩, Subtype.ext ?_⟩
        simp only
        apply hnf_congr
        exact Ideal.mem_span_singleton.1 (Ideal.Quotient.eq.1 (Quotient.out_eq _)))

end Lattices

/-! ### Left ideals of $M_2(R)$ -/

section MatIdeals

variable {R : Type*} [CommRing R]

/-- The reduced-norm ideal of a left ideal $I$ of $M_2(R)$: $(\det X : X \in I)$. -/
def matNrdIdeal (I : Ideal (Matrix (Fin 2) (Fin 2) R)) : Ideal R := Ideal.span {d | ∃ X ∈ I, d = X.det}

/-- The rows of the left ideal $I$: $\{x \in R^2 : \begin{pmatrix} x \\ 0\end{pmatrix} \in I\}$. -/
def rowSpace (I : Ideal (Matrix (Fin 2) (Fin 2) R)) : Submodule R (Fin 2 → R) where
  carrier := {x | Matrix.of ![x, 0] ∈ I}
  add_mem' {x y} hx hy := by
    have : Matrix.of ![x + y, 0] = Matrix.of ![x, 0] + Matrix.of ![y, 0] := by
      ext i j; fin_cases i <;> simp
    simp only [Set.mem_setOf_eq] at *
    rw [this]; exact I.add_mem hx hy
  zero_mem' := by
    have : Matrix.of ![(0 : Fin 2 → R), 0] = 0 := by ext i j; fin_cases i <;> simp
    simp only [Set.mem_setOf_eq]; rw [this]; exact I.zero_mem
  smul_mem' c x hx := by
    have : Matrix.of ![c • x, 0] = Matrix.scalar (Fin 2) c * Matrix.of ![x, 0] := by
      ext i j; fin_cases i <;> simp [Matrix.mul_apply, Fin.sum_univ_two]
    simp only [Set.mem_setOf_eq] at *
    rw [this]; exact I.mul_mem_left _ hx

/-- The left ideal of matrices whose rows lie in $M$. -/
def ofRowSpace (M : Submodule R (Fin 2 → R)) : Ideal (Matrix (Fin 2) (Fin 2) R) where
  carrier := {X | ∀ i, X i ∈ M}
  add_mem' {X Y} hX hY i := M.add_mem (hX i) (hY i)
  zero_mem' i := M.zero_mem
  smul_mem' C X hX i := by
    have : (C • X) i = ∑ j, C i j • X j := by
      ext l; simp [Matrix.mul_apply, Finset.sum_apply]
    rw [this]
    exact M.sum_mem fun j _ => M.smul_mem _ (hX j)

theorem single_row_mul (I : Ideal (Matrix (Fin 2) (Fin 2) R)) {X : Matrix (Fin 2) (Fin 2) R} (hX : X ∈ I) (i : Fin 2) :
    Matrix.of ![X i, 0] ∈ I := by
  have : Matrix.of ![X i, 0] = Matrix.single 0 i 1 * X := by
    ext l j; fin_cases l <;> simp [Matrix.mul_apply, Fin.sum_univ_two, Matrix.single_apply] <;>
      fin_cases i <;> simp
  rw [this]; exact I.mul_mem_left _ hX

theorem ofRowSpace_rowSpace (I : Ideal (Matrix (Fin 2) (Fin 2) R)) : ofRowSpace (rowSpace I) = I := by
  ext X
  constructor
  · intro hX
    have : X = Matrix.of ![X 0, 0] + Matrix.single 1 0 1 * Matrix.of ![X 1, 0] := by
      ext l j; fin_cases l <;> simp [Matrix.mul_apply, Fin.sum_univ_two, Matrix.single_apply]
    rw [this]
    exact I.add_mem (hX 0) (I.mul_mem_left _ (hX 1))
  · intro hX i
    exact single_row_mul I hX i

theorem rowSpace_ofRowSpace (M : Submodule R (Fin 2 → R)) : rowSpace (ofRowSpace M) = M := by
  ext x
  constructor
  · intro hx; exact hx 0
  · intro hx i
    fin_cases i
    · exact hx
    · exact M.zero_mem

/-- **Left ideals of $M_2(R)$ are the row-space ideals:** $I \mapsto$ `rowSpace I` is a bijection onto the $R$-submodules of $R^2$
(Voight 2021, Ex. 10.5.2 and §10.5 for the analogous statement over a field). -/
def leftIdealEquiv : Ideal (Matrix (Fin 2) (Fin 2) R) ≃ Submodule R (Fin 2 → R) where
  toFun := rowSpace
  invFun := ofRowSpace
  left_inv := ofRowSpace_rowSpace
  right_inv := rowSpace_ofRowSpace

/-- **The reduced norm of a row-space ideal is the determinant ideal of its rows.** -/
theorem matNrdIdeal_ofRowSpace (M : Submodule R (Fin 2 → R)) : matNrdIdeal (ofRowSpace M) = detIdeal M := by
  apply le_antisymm
  · rw [matNrdIdeal, Ideal.span_le]
    rintro d ⟨X, hX, rfl⟩
    refine Ideal.subset_span ⟨X 0, hX 0, X 1, hX 1, ?_⟩
    rw [Matrix.det_fin_two, det2]
  · rw [detIdeal, Ideal.span_le]
    rintro d ⟨x, hx, y, hy, rfl⟩
    refine Ideal.subset_span ⟨Matrix.of ![x, y], fun i => by fin_cases i <;> simpa, ?_⟩
    rw [Matrix.det_fin_two, det2]; simp

theorem matNrdIdeal_eq (I : Ideal (Matrix (Fin 2) (Fin 2) R)) : matNrdIdeal I = detIdeal (rowSpace I) := by
  conv_lhs => rw [← ofRowSpace_rowSpace I]
  exact matNrdIdeal_ofRowSpace _

/-- **The split local count** (Voight 2021, Lemma 26.4.1(b)): over a DVR $R$ with uniformizer $\pi$, the left ideals $I$ of
$M_2(R)$ with reduced norm $(\pi^k)$ are in bijection with $\Sigma_{b\le k}R/\pi^bR$; in particular, when the residue field is
finite of order $q$, there are $\sum_{b=0}^kq^b$ of them. -/
def matIdealEquiv [IsDomain R] [IsDiscreteValuationRing R] {π : R} (hπ : Irreducible π) (k : ℕ) :
    {I : Ideal (Matrix (Fin 2) (Fin 2) R) // matNrdIdeal I = Ideal.span {π ^ k}} ≃
      (Σ b : Fin (k + 1), R ⧸ Ideal.span {π ^ (b : ℕ)}) :=
  (leftIdealEquiv.subtypeEquiv fun I => by rw [matNrdIdeal_eq]; rfl).trans (latticeEquiv hπ k).symm

end MatIdeals

/-! ### The reduced norm under $D \cong M_2(K)$ -/

section NrdDet

variable {K : Type*} [Field K] {a b : K}

theorem nrd_pow (x : ℍ[K,a,b]) (k : ℕ) : nrd (x ^ k) = nrd x ^ k := by
  induction k with
  | zero => simp [nrd]
  | succ k ih => rw [pow_succ, nrd_mul, ih, pow_succ]

/-- **Algebra isomorphisms $D \cong M_2(K)$ carry the reduced norm to the determinant:** $\det\varphi(x) = \operatorname{nrd}(x)$.

*Proof.* $x^2 = \operatorname{trd}(x)x - \operatorname{nrd}(x)$ and Cayley–Hamilton $X^2 = \operatorname{tr}(X)X - \det(X)$ for $X = \varphi(x)$ give
$(\operatorname{trd}x - \operatorname{tr}X)X = (\operatorname{nrd}x - \det X)\cdot1$; if the traces differ, $X$ and hence $x$ are scalars $c$, and both
sides are $c^2$. -/
@[kb "voight2021" "Ex. 3.3.3 (nrd = det on M_2)"]
theorem det_algEquiv (φ : ℍ[K,a,b] ≃ₐ[K] Matrix (Fin 2) (Fin 2) K) (x : ℍ[K,a,b]) : (φ x).det = nrd x := by
  set X := φ x
  have h1 : X * X = trd x • X - algebraMap K _ (nrd x) := by
    rw [← map_mul, mul_self_eq, map_sub, map_smul, AlgEquiv.commutes]
  have h2 := mul_self_eq_trace_det X
  have h3 : (trd x - X.trace) • X = algebraMap K _ (nrd x - X.det) := by
    rw [sub_smul, map_sub]
    exact sub_eq_sub_iff_sub_eq_sub.1 (h1.symm.trans h2)
  by_cases ht : trd x = X.trace
  · rw [ht, sub_self, zero_smul] at h3
    have h4 := congrFun (congrFun h3.symm 0) 0
    simp [Matrix.algebraMap_matrix_apply] at h4
    linear_combination -h4
  · have hne : trd x - X.trace ≠ 0 := sub_ne_zero.2 ht
    set c := (trd x - X.trace)⁻¹ * (nrd x - X.det)
    have hX : X = algebraMap K _ c := by
      have : X = (trd x - X.trace)⁻¹ • algebraMap K _ (nrd x - X.det) := by
        rw [← h3, smul_smul, inv_mul_cancel₀ hne, one_smul]
      rw [this, Algebra.smul_def, ← map_mul]
    have hx : x = algebraMap K _ c := by
      apply φ.injective
      rw [AlgEquiv.commutes]; exact hX
    rw [hX, hx]
    simp [Matrix.det_fin_two, Matrix.algebraMap_matrix_apply, nrd, QuaternionAlgebra.algebraMap_eq]
    ring

end NrdDet

/-! ### Left ideals of local orders and their reduced norms -/

section LocalIdeals

variable {R K : Type*} [CommRing R] [Field K] [Algebra R K] {a b : K}

/-- **The reduced norm of a left ideal** $I$ of an $R$-order $\mathcal O \subseteq (a,b)_K$: the ideal of $R$ generated by the reduced norms
of the elements of $I$ (for `valOrder` this is the `nrdIdeal`). -/
def leftNrdIdeal {O : Subalgebra R ℍ[K,a,b]} (I : Ideal O) : Ideal R :=
  Ideal.span {r | ∃ x ∈ I, algebraMap R K r = nrd (x : ℍ[K,a,b])}

theorem nrdIdeal_eq_leftNrdIdeal [IsDomain R] [ValuationRing R] [HenselianLocalRing R] [IsFractionRing R K]
    (hdiv : ∀ x : ℍ[K,a,b], nrd x = 0 → x = 0) (I : Ideal (valOrder (R := R) hdiv)) :
    nrdIdeal hdiv I = leftNrdIdeal I := rfl

/-- **The ramified local count:** if $D = (a,b)_K$ is a division algebra over the fraction field of a Henselian DVR $R$ with
uniformizer $\pi$ and some $y \in D$ has $\operatorname{nrd}(y) = \pi$, then for each $k$ there is exactly one left ideal of the
valuation ring $\mathcal O$ with reduced norm $(\pi^k)$, namely $\mathcal Oy^k$.

Source: Voight 2021, 13.3.10 and Lemma 26.4.1 (ramified case). -/
@[kb "voight2021" "Lemma 26.4.1"]
theorem card_valOrder_ideal [IsDomain R] [IsDiscreteValuationRing R] [HenselianLocalRing R] [IsFractionRing R K]
    (hdiv : ∀ x : ℍ[K,a,b], nrd x = 0 → x = 0) {π : R} {y : ℍ[K,a,b]} (hy : nrd y = algebraMap R K π) (k : ℕ) :
    Nat.card {I : Ideal (valOrder (R := R) hdiv) // leftNrdIdeal I = Ideal.span {π ^ k}} = 1 := by
  rw [Nat.card_eq_one_iff_unique]
  have hyO : y ^ k ∈ valOrder (R := R) hdiv := ⟨π ^ k, by rw [nrd_pow, hy, map_pow]⟩
  refine ⟨⟨fun I J => Subtype.ext (eq_of_nrdIdeal_eq hdiv (I.2.trans J.2.symm))⟩, ⟨⟨Ideal.span {⟨y ^ k, hyO⟩}, ?_⟩⟩⟩
  rw [← nrdIdeal_eq_leftNrdIdeal]
  exact nrdIdeal_span_singleton hdiv _ (by rw [map_pow, ← hy, ← nrd_pow])

/-- Transport of left ideals along a ring isomorphism $\psi : \mathcal O \cong M_2(R)$ that carries $\operatorname{nrd}$ to $\det$. -/
theorem leftNrdIdeal_comap {O : Subalgebra R ℍ[K,a,b]} (ψ : O ≃+* Matrix (Fin 2) (Fin 2) R)
    (hinj : Function.Injective (algebraMap R K))
    (hψ : ∀ x : O, algebraMap R K (ψ x).det = nrd (x : ℍ[K,a,b])) (I : Ideal O) :
    leftNrdIdeal I = matNrdIdeal (Ideal.comap ψ.symm I) := by
  rw [leftNrdIdeal, matNrdIdeal]
  congr 1
  ext r
  constructor
  · rintro ⟨x, hx, hr⟩
    refine ⟨ψ x, by simpa using hx, hinj ?_⟩
    rw [hr, hψ]
  · rintro ⟨X, hX, rfl⟩
    refine ⟨ψ.symm X, hX, ?_⟩
    rw [← hψ (ψ.symm X), RingEquiv.apply_symm_apply]

/-- **Left ideals transported along $\psi$**, with their reduced norms. -/
def leftIdealEquivOfRingEquiv {O : Subalgebra R ℍ[K,a,b]} (ψ : O ≃+* Matrix (Fin 2) (Fin 2) R)
    (hinj : Function.Injective (algebraMap R K))
    (hψ : ∀ x : O, algebraMap R K (ψ x).det = nrd (x : ℍ[K,a,b])) (J : Ideal R) :
    {I : Ideal O // leftNrdIdeal I = J} ≃ {I : Ideal (Matrix (Fin 2) (Fin 2) R) // matNrdIdeal I = J} where
  toFun I := ⟨Ideal.comap ψ.symm I.1, by rw [← leftNrdIdeal_comap ψ hinj hψ]; exact I.2⟩
  invFun I := ⟨Ideal.comap ψ I.1, by
    rw [leftNrdIdeal_comap ψ hinj hψ]
    have : Ideal.comap ψ.symm (Ideal.comap ψ I.1) = I.1 := by
      ext X; simp only [Ideal.mem_comap, RingEquiv.apply_symm_apply]
    rw [this]; exact I.2⟩
  left_inv I := Subtype.ext (by ext x; simp only [Ideal.mem_comap, RingEquiv.symm_apply_apply])
  right_inv I := Subtype.ext (by ext X; simp only [Ideal.mem_comap, RingEquiv.apply_symm_apply])

end LocalIdeals

/-! ### The local counts at the completions of a maximal order -/

section Completions

open NumberField IsDedekindDomain QuadFormsKB.LocalDensity.NF

variable {F : Type} [Field F] [NumberField F] {v : HeightOneSpectrum (𝓞 F)} [IsPrincipalIdealRing (𝓞 F)]
  {a b : 𝓞 F}

local notation "Fv" => v.adicCompletion F
local notation "𝔬" => v.adicCompletionIntegers F

/-- The ring isomorphism $M_2(\mathfrak o_v) \cong$ `matOrder` (entrywise inclusion). -/
def matOrderEquiv : Matrix (Fin 2) (Fin 2) 𝔬 ≃ₐ[𝔬] matOrder 𝔬 Fv :=
  AlgEquiv.ofInjective (AlgHom.mapMatrix (Algebra.ofId 𝔬 Fv)) (by
    intro X Y h
    refine Matrix.ext fun i j => ?_
    have := congrFun (congrFun h i) j
    simp only [AlgHom.mapMatrix_apply, Matrix.map_apply, Algebra.ofId_apply] at this
    exact IsFractionRing.injective 𝔬 Fv this)

instance finite_quot_π_pow (b : ℕ) : Finite (𝔬 ⧸ Ideal.span {π v ^ b}) :=
  Nat.finite_of_card_ne_zero (by
    rw [card_quot_π_pow]
    exact pow_ne_zero _ ((Ideal.absNorm_ne_zero_iff_mem_nonZeroDivisors).2
      (mem_nonZeroDivisors_of_ne_zero v.ne_bot)))

theorem matOrderEquiv_apply (X : Matrix (Fin 2) (Fin 2) 𝔬) :
    ((matOrderEquiv (v := v) X : matOrder 𝔬 Fv) : Matrix (Fin 2) (Fin 2) Fv) = X.map (algebraMap 𝔬 Fv) := rfl

/-- **The split local count:** at a finite place $v$ where $D_v \cong M_2(F_v)$, the completion $\mathcal O_v$ of a maximal order has
exactly $\sum_{b=0}^k(N\mathfrak p_v)^b$ left ideals of reduced norm $\mathfrak p_v^k$.

Source: Voight 2021, Lemma 26.4.1(b) (right ideals there; left ideals here, by transposition). -/
@[kb "voight2021" "Lemma 26.4.1"]
theorem card_localOrder_ideal_split {O : Subalgebra (𝓞 F) (QuatF F a b)} (hO : IsMaximalOrder (𝓞 F) F O)
    (hsplit : Nonempty (QuatV v a b ≃ₐ[Fv] Matrix (Fin 2) (Fin 2) Fv)) (k : ℕ) :
    Nat.card {I : Ideal (localOrder (v := v) a b O) // leftNrdIdeal I = Ideal.span {π v ^ k}} =
      ∑ i ∈ Finset.range (k + 1), Ideal.absNorm v.asIdeal ^ i := by
  obtain ⟨φ, hφ⟩ := exists_algEquiv_localOrder_eq_matOrder hO hsplit
  -- ψ : O_v ≃ M_2(𝔬)
  let e1 := (φ.restrictScalars 𝔬).subalgebraMap (localOrder (v := v) a b O)
  let e2 := Subalgebra.equivOfEq _ _ hφ
  let ψ : localOrder (v := v) a b O ≃+* Matrix (Fin 2) (Fin 2) 𝔬 :=
    ((e1.trans e2).trans (matOrderEquiv (v := v)).symm).toRingEquiv
  have hψ : ∀ x : localOrder (v := v) a b O, algebraMap 𝔬 Fv (ψ x).det = nrd (x : QuatV v a b) := by
    intro x
    have h1 : ((matOrderEquiv (v := v) (ψ x) : matOrder 𝔬 Fv) : Matrix (Fin 2) (Fin 2) Fv) = φ x := by
      change ((matOrderEquiv (v := v) ((matOrderEquiv (v := v)).symm (e2 (e1 x))) : matOrder 𝔬 Fv) :
        Matrix (Fin 2) (Fin 2) Fv) = φ x
      rw [AlgEquiv.apply_symm_apply]; rfl
    rw [← det_algEquiv φ, ← h1, matOrderEquiv_apply, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
  rw [Nat.card_congr ((leftIdealEquivOfRingEquiv ψ (IsFractionRing.injective 𝔬 Fv) hψ _).trans
    (matIdealEquiv (irreducible_π v) k)), Nat.card_sigma, Fin.sum_univ_eq_sum_range
      (fun b => Nat.card (𝔬 ⧸ Ideal.span {π v ^ b})) (k + 1)]
  exact Finset.sum_congr rfl fun b _ => card_quot_π_pow v b

/-- **The ramified local count:** at a finite place $v$ where $D_v$ is a division algebra, the completion $\mathcal O_v$ of a maximal
order has exactly one left ideal of each reduced norm $\mathfrak p_v^k$.

Source: Voight 2021, Lemma 26.4.1 (ramified case). -/
@[kb "voight2021" "Lemma 26.4.1"]
theorem card_localOrder_ideal_ramified (ha : a ≠ 0) (hb : b ≠ 0) {O : Subalgebra (𝓞 F) (QuatF F a b)}
    (hO : IsMaximalOrder (𝓞 F) F O) (hdiv : ∀ x : QuatV v a b, nrd x = 0 → x = 0) (k : ℕ) :
    Nat.card {I : Ideal (localOrder (v := v) a b O) // leftNrdIdeal I = Ideal.span {π v ^ k}} = 1 := by
  have heq := localOrder_eq_valOrder ha hb hO hdiv
  have hπ0 : algebraMap 𝔬 Fv (π v) ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective 𝔬 Fv)).2 (irreducible_π v).ne_zero
  obtain ⟨y, hy⟩ := QuadFormsKB.Quat.exists_nrd_eq_finite' (a := (a : F)) (b := (b : F))
    ((map_ne_zero_iff _ (IsFractionRing.injective (𝓞 F) F)).2 ha)
    ((map_ne_zero_iff _ (IsFractionRing.injective (𝓞 F) F)).2 hb) v hπ0
  rw [← card_valOrder_ideal (R := 𝔬) hdiv hy k]
  have key : ∀ O₁ O₂ : Subalgebra 𝔬 (QuatV v a b), O₁ = O₂ →
      Nat.card {I : Ideal O₁ // leftNrdIdeal I = Ideal.span {π v ^ k}} =
        Nat.card {I : Ideal O₂ // leftNrdIdeal I = Ideal.span {π v ^ k}} := by
    rintro _ _ rfl; rfl
  exact key _ _ heq

/-- $D$ is ramified at the finite place $v$ (`Quat.IsRamifiedAt`) iff $D_v$ has no nonzero element of reduced norm $0$. -/
theorem isRamifiedAt_finite_iff :
    IsRamifiedAt (algebraMap (𝓞 F) F a) (algebraMap (𝓞 F) F b) (NFPlace.finite v) ↔
      ∀ x : QuatV v a b, nrd x = 0 → x = 0 := by
  change (∀ x : QuatV v a b, x ≠ 0 → IsUnit x) ↔ _
  constructor
  · intro h x hx
    by_contra h0
    exact (isUnit_iff_nrd_ne_zero x).1 (h x h0) hx
  · intro h x hx
    exact (isUnit_iff_nrd_ne_zero x).2 fun h0 => hx (h x h0)

open Classical in
/-- **The local ideal counts of a maximal order** ($\mathcal O_F$ a PID, $ab \ne 0$): for every finite place $v$ and $k \ge 0$,
$$a_v(k) = \#\{I \subseteq \mathcal O_v \text{ left ideal} : \operatorname{nrd}(I) = \mathfrak p_v^k\} =
  \begin{cases}1 & v \in \operatorname{Ram}(D),\\ \sum_{i=0}^k(N\mathfrak p_v)^i & \text{otherwise.}\end{cases}$$

Source: Voight 2021, Lemma 26.4.1 and (26.3.13). -/
@[kb "voight2021" "Lemma 26.4.1"]
theorem card_localOrder_ideal (ha : a ≠ 0) (hb : b ≠ 0) {O : Subalgebra (𝓞 F) (QuatF F a b)}
    (hO : IsMaximalOrder (𝓞 F) F O) (k : ℕ) :
    Nat.card {I : Ideal (localOrder (v := v) a b O) // leftNrdIdeal I = Ideal.span {π v ^ k}} =
      if IsRamifiedAt (algebraMap (𝓞 F) F a) (algebraMap (𝓞 F) F b) (NFPlace.finite v) then 1
      else ∑ i ∈ Finset.range (k + 1), Ideal.absNorm v.asIdeal ^ i := by
  split_ifs with h
  · exact card_localOrder_ideal_ramified ha hb hO (isRamifiedAt_finite_iff.1 h) k
  · rw [isRamifiedAt_finite_iff] at h
    push Not at h
    obtain ⟨x, hx0, hx⟩ := h
    have ha' : algebraMap 𝔬 Fv (ι v a) ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective 𝔬 Fv)).2 (ι_ne_zero v ha)
    have hb' : algebraMap 𝔬 Fv (ι v b) ≠ 0 :=
      (map_ne_zero_iff _ (IsFractionRing.injective 𝔬 Fv)).2 (ι_ne_zero v hb)
    have h2 := two_ne_zero_of_algebra (F := F) Fv
    exact card_localOrder_ideal_split hO ((nonempty_algEquiv_matrix_iff h2 ha' hb').2
      ((hilbertSymbol_eq_one_iff_exists_nrd_eq_zero h2 ha' hb').2 ⟨x, hx, hx0⟩)) k

end Completions

/-! ### The local zeta factors -/

section LocalZetaFactor

/-- **The split local factor** $\sum_{k\ge0}\big(\sum_{i=0}^kq^i\big)X^k = \frac{1}{(1-X)(1-qX)}$ ($q \ge 1$, $0 \le X$, $qX < 1$); with
$X = N\mathfrak p^{-2s}$ this is $\zeta_{\mathcal O_v}(s) = (1 - N\mathfrak p^{-2s})^{-1}(1 - N\mathfrak p^{1-2s})^{-1}$ (Voight 2021, Cor. 26.4.7). -/
theorem hasSum_localFactor_split {q X : ℝ} (hq : 1 ≤ q) (hX : 0 ≤ X) (hqX : q * X < 1) :
    HasSum (fun k : ℕ => (∑ i ∈ Finset.range (k + 1), q ^ i) * X ^ k) ((1 - q * X)⁻¹ * (1 - X)⁻¹) := by
  have hX1 : X < 1 := lt_of_le_of_lt (by nlinarith) hqX
  have hqX0 : 0 ≤ q * X := mul_nonneg (by linarith) hX
  have hf : Summable fun i : ℕ => ‖(q * X) ^ i‖ := by
    simpa [abs_of_nonneg hqX0, abs_of_nonneg (pow_nonneg hqX0 _)] using
      summable_geometric_of_lt_one hqX0 hqX
  have hg : Summable fun i : ℕ => ‖X ^ i‖ := by
    simpa [abs_of_nonneg (pow_nonneg hX _)] using summable_geometric_of_lt_one hX hX1
  have h := hasSum_sum_range_mul_of_summable_norm hf hg
  rw [tsum_geometric_of_lt_one hqX0 hqX, tsum_geometric_of_lt_one hX hX1] at h
  convert h using 1
  funext k
  rw [Finset.sum_mul]
  refine Finset.sum_congr rfl fun i hi => ?_
  have hik : i ≤ k := Nat.lt_succ_iff.1 (Finset.mem_range.1 hi)
  rw [mul_pow, mul_assoc, ← pow_add, Nat.add_sub_cancel' hik]

/-- **The ramified local factor** $\sum_{k\ge0}X^k = (1-X)^{-1}$; with $X = N\mathfrak p^{-2s}$, $\zeta_{\mathcal O_v}(s) = (1 - N\mathfrak p^{-2s})^{-1}$. -/
theorem hasSum_localFactor_ramified {X : ℝ} (hX : 0 ≤ X) (hX1 : X < 1) :
    HasSum (fun k : ℕ => (1 : ℝ) * X ^ k) (1 - X)⁻¹ := by
  simpa using hasSum_geometric_of_lt_one hX hX1

end LocalZetaFactor

end QuadFormsKB.QuatOrder
