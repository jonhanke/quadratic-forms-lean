/-
# Scaling left ideals of a quaternion order by ideals of $\mathcal O_F$

**Layer:** $F$ a number field (any class number), $D = (a,b)_F$, $\mathcal O \subset D$ an $\mathcal O_F$-order, $J$ a left ideal of $\mathcal O$,
$\mathfrak a$ an ideal of $\mathcal O_F$. The left ideal $\mathfrak aJ$ (`scaleIdeal 𝔞 J`, the $\mathcal O_F$-span of $\{rx : r \in \mathfrak a, x \in J\}$) has
* `colon_scaleIdeal`: $(\mathcal O : \mathfrak aJ) = \{\beta : \mathfrak a\beta \subseteq (\mathcal O:J)\}$ (i.e. $\mathfrak a^{-1}(\mathcal O:J)$);
* **`leftNrdIdeal_scaleIdeal`**: $\operatorname{nrd}(\mathfrak aJ) = \mathfrak a^2\operatorname{nrd}(J)$ (using `span_sq_eq_sq`: $\mathfrak a^2$ is generated by the squares
  $r^2$, $r \in \mathfrak a$, in a Dedekind domain);
* `idealRel_scaleIdeal`: $J \sim J' \Rightarrow \mathfrak aJ \sim \mathfrak aJ'$, and `idealRel_scaleIdeal_principal`: $\mathfrak b(\mathfrak aJ) \sim J$ if $\mathfrak b\mathfrak a$ is principal;
* `rStab_scaleIdeal`: the right-order units of $\mathfrak aJ$ are those of $J$ (when $\mathfrak a$ is invertible up to a principal ideal).

Hence $[J] \mapsto [\mathfrak aJ]$ is a well-defined injective map on the (finite) set of left ideal classes (`classScale`, `classScale_injective`): the
action of $\mathrm{Cl}(F)$ used in the averaging argument of `EichlerMassNF`. No basis of $\mathcal O$, $J$ or $\mathfrak a$, no generator of $\mathfrak a$.

Source: Voight, *Quaternion Algebras* (2021), §16.6 and (26.5.8)–(26.5.10) (there the class-group action is implicit in the adelic
double coset count); the "squares generate $\mathfrak a^2$" lemma is standard.
-/
import QuadFormsKB.Tamagawa.QuatEpsteinIdealNF
import QuadFormsKB.Tamagawa.QuatClassFiniteNF

open NumberField Quaternion
open scoped nonZeroDivisors

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.QuatOrder

open QuadFormsKB.Quat

attribute [-instance] NumberField.RingOfIntegers.instAlgebra

namespace Gen

/-! ### Squares generate $\mathfrak a^2$ in a Dedekind domain -/

section Squares

variable {R : Type*} [CommRing R] [IsDedekindDomain R]

/-- **The squares of elements of $\mathfrak a$ generate $\mathfrak a^2$** ($R$ Dedekind). If $\mathfrak a^2\mathfrak c$ were the span with a prime
$\mathfrak p \mid \mathfrak c$, pick $r \in \mathfrak a\setminus\mathfrak a\mathfrak p$; then $(r) = \mathfrak a\mathfrak d$, $\mathfrak p\nmid\mathfrak d$, but $(r^2) \subseteq \mathfrak a^2\mathfrak p$. -/
theorem span_sq_eq_sq (𝔞 : Ideal R) : Ideal.span {x | ∃ r ∈ 𝔞, x = r ^ 2} = 𝔞 ^ 2 := by
  classical
  set S := Ideal.span {x | ∃ r ∈ 𝔞, x = r ^ 2}
  have hle : S ≤ 𝔞 ^ 2 := Ideal.span_le.2 fun x ⟨r, hr, hx⟩ => hx ▸ Ideal.pow_mem_pow hr 2
  rcases eq_or_ne 𝔞 ⊥ with h0 | h0
  · subst h0
    rw [Ideal.bot_pow two_ne_zero] at hle ⊢
    exact le_bot_iff.1 hle
  obtain ⟨𝔠, h𝔠⟩ := Ideal.dvd_iff_le.2 hle
  by_cases h𝔠1 : 𝔠 = ⊤
  · rw [h𝔠, h𝔠1, Ideal.mul_top]
  obtain ⟨𝔭, h𝔭max, h𝔠𝔭⟩ := Ideal.exists_le_maximal 𝔠 h𝔠1
  have h𝔭0 : 𝔭 ≠ ⊥ := by
    intro h; subst h
    have : 𝔠 = ⊥ := le_bot_iff.1 h𝔠𝔭
    have hS0 : S = ⊥ := by rw [h𝔠, this, Ideal.mul_bot]
    -- but S contains r^2 for any nonzero r ∈ 𝔞
    obtain ⟨r, hr, hr0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot h0
    have : r ^ 2 ∈ S := Ideal.subset_span ⟨r, hr, rfl⟩
    rw [hS0, Ideal.mem_bot] at this
    exact hr0 (pow_eq_zero_iff two_ne_zero |>.1 this)
  have hprime : Prime 𝔭 := Ideal.prime_of_isPrime h𝔭0 h𝔭max.isPrime
  have hlt : 𝔞 * 𝔭 < 𝔞 := by
    refine lt_of_le_of_ne (Ideal.mul_le_inf.trans inf_le_left) fun h => ?_
    have : 𝔞 * 𝔭 = 𝔞 * ⊤ := by rw [Ideal.mul_top]; exact h
    exact h𝔭max.ne_top (mul_left_cancel₀ h0 this)
  obtain ⟨r, hr𝔞, hr𝔭⟩ := IsConcreteLE.exists_of_lt hlt
  obtain ⟨𝔡, h𝔡⟩ := Ideal.dvd_iff_le.2 ((Ideal.span_singleton_le_iff_mem _).2 hr𝔞)
  have hnd : ¬ 𝔭 ∣ 𝔡 := by
    rintro ⟨𝔢, rfl⟩
    apply hr𝔭
    have : Ideal.span {r} ≤ 𝔞 * 𝔭 := by rw [h𝔡, ← mul_assoc]; exact Ideal.mul_le_inf.trans inf_le_left
    exact (Ideal.span_singleton_le_iff_mem _).1 this
  have hr2 : r ^ 2 ∈ 𝔞 ^ 2 * 𝔭 := by
    have h1 : r ^ 2 ∈ S := Ideal.subset_span ⟨r, hr𝔞, rfl⟩
    rw [h𝔠] at h1
    exact Ideal.mul_mono_right h𝔠𝔭 h1
  have hspan : Ideal.span {r ^ 2} = 𝔞 ^ 2 * 𝔡 ^ 2 := by
    rw [← Ideal.span_singleton_pow, h𝔡, mul_pow]
  have hdvd : 𝔞 ^ 2 * 𝔭 ∣ 𝔞 ^ 2 * 𝔡 ^ 2 := by
    rw [← hspan]; exact Ideal.dvd_iff_le.2 ((Ideal.span_singleton_le_iff_mem _).2 hr2)
  have h𝔞2 : 𝔞 ^ 2 ≠ 0 := pow_ne_zero 2 h0
  have h' : 𝔭 ∣ 𝔡 ^ 2 := (mul_dvd_mul_iff_left h𝔞2).1 hdvd
  exact absurd (hprime.dvd_of_dvd_pow h') hnd

end Squares

/-! ### The scaled set $\mathfrak aS$ and the scaled ideal $\mathfrak aJ$ -/

section Scale

variable {F : Type} [Field F] [NumberField F] {a b : 𝓞 F}
  {O : Subalgebra (𝓞 F) ℍ[F,algebraMap (𝓞 F) F a,algebraMap (𝓞 F) F b]}

/-- **$\mathfrak aS$**: the $\mathcal O_F$-span of $\{r y : r \in \mathfrak a, y \in S\}$. -/
def scaleSet (𝔞 : Ideal (𝓞 F)) (S : Set (QuatF F a b)) : Submodule (𝓞 F) (QuatF F a b) :=
  Submodule.span (𝓞 F) {z | ∃ r ∈ 𝔞, ∃ y ∈ S, z = r • y}

theorem smul_mem_scaleSet {𝔞 : Ideal (𝓞 F)} {S : Set (QuatF F a b)} {r : 𝓞 F} (hr : r ∈ 𝔞) {y : QuatF F a b}
    (hy : y ∈ S) : r • y ∈ scaleSet 𝔞 S :=
  Submodule.subset_span ⟨r, hr, y, hy, rfl⟩

theorem scaleSet_le_order {𝔞 : Ideal (𝓞 F)} {S : Set (QuatF F a b)} (hS : S ⊆ O) :
    ∀ z ∈ scaleSet 𝔞 S, z ∈ O := by
  intro z hz
  induction hz using Submodule.span_induction with
  | mem z hz => obtain ⟨r, -, y, hy, rfl⟩ := hz; exact O.smul_mem (hS hy) r
  | zero => exact O.zero_mem
  | add x y _ _ hx hy => exact O.add_mem hx hy
  | smul c x _ hx => exact O.smul_mem hx c

theorem mul_mem_scaleSet {𝔞 : Ideal (𝓞 F)} {J : Ideal O} {o : QuatF F a b} (ho : o ∈ O) :
    ∀ z ∈ scaleSet 𝔞 (idealSet J), o * z ∈ scaleSet 𝔞 (idealSet J) := by
  intro z hz
  induction hz using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨r, hr, y, hy, rfl⟩ := hz
    rw [mul_smul_comm]; exact smul_mem_scaleSet hr (mul_mem_idealSet ho hy)
  | zero => rw [mul_zero]; exact Submodule.zero_mem _
  | add x y _ _ hx hy => rw [mul_add]; exact Submodule.add_mem _ hx hy
  | smul c x _ hx => rw [mul_smul_comm]; exact Submodule.smul_mem _ c hx

/-- **The left ideal $\mathfrak aJ$.** -/
def scaleIdeal (𝔞 : Ideal (𝓞 F)) (J : Ideal O) : Ideal O where
  carrier := {x : O | (x : QuatF F a b) ∈ scaleSet 𝔞 (idealSet J)}
  add_mem' := fun {x y} hx hy => by
    simp only [Set.mem_ofPred_eq, Subalgebra.coe_add] at hx hy ⊢
    exact Submodule.add_mem _ hx hy
  zero_mem' := by
    simp only [Set.mem_ofPred_eq, Subalgebra.coe_zero]; exact Submodule.zero_mem _
  smul_mem' := fun c x hx => by
    simp only [Set.mem_ofPred_eq, smul_eq_mul, Subalgebra.coe_mul] at hx ⊢
    exact mul_mem_scaleSet c.2 _ hx

theorem idealSet_scaleIdeal (𝔞 : Ideal (𝓞 F)) (J : Ideal O) :
    idealSet (scaleIdeal 𝔞 J) = scaleSet 𝔞 (idealSet J) := by
  ext z
  constructor
  · rintro ⟨_, hz⟩; exact hz
  · intro hz; exact ⟨scaleSet_le_order (idealSet_subset J) z hz, hz⟩

/-- $\mathfrak a(S\beta) = (\mathfrak aS)\beta$. -/
theorem scaleSet_rTrans (𝔞 : Ideal (𝓞 F)) (S : Set (QuatF F a b)) (β : QuatF F a b) :
    (scaleSet 𝔞 (rTrans S β) : Set (QuatF F a b)) = rTrans (scaleSet 𝔞 S) β := by
  have : scaleSet 𝔞 (rTrans S β) = (scaleSet 𝔞 S).map (LinearMap.mulRight (𝓞 F) β) := by
    rw [scaleSet, scaleSet, Submodule.map_span]
    congr 1
    ext z
    constructor
    · rintro ⟨r, hr, _, ⟨y, hy, rfl⟩, rfl⟩
      exact ⟨r • y, ⟨r, hr, y, hy, rfl⟩, by simp⟩
    · rintro ⟨_, ⟨r, hr, y, hy, rfl⟩, rfl⟩
      exact ⟨r, hr, y * β, ⟨y, hy, rfl⟩, by simp⟩
  rw [this, Submodule.map_coe]; rfl

/-- **$J \sim J' \Rightarrow \mathfrak aJ \sim \mathfrak aJ'$.** -/
theorem idealRel_scaleIdeal (𝔞 : Ideal (𝓞 F)) {J J' : Ideal O} (h : IdealRel J J') :
    IdealRel (scaleIdeal 𝔞 J) (scaleIdeal 𝔞 J') := by
  obtain ⟨β, hβ⟩ := h
  refine ⟨β, ?_⟩
  rw [idealSet_scaleIdeal, idealSet_scaleIdeal, hβ, scaleSet_rTrans]

/-- $\mathfrak b(\mathfrak aS) = (\mathfrak b\mathfrak a)S$. -/
theorem scaleSet_scaleSet (𝔞 𝔟 : Ideal (𝓞 F)) (S : Set (QuatF F a b)) :
    scaleSet 𝔟 (scaleSet 𝔞 S) = scaleSet (𝔟 * 𝔞) S := by
  apply le_antisymm
  · rw [scaleSet, Submodule.span_le]
    rintro _ ⟨r', hr', z, hz, rfl⟩
    show r' • z ∈ scaleSet (𝔟 * 𝔞) S
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨r, hr, y, hy, rfl⟩ := hz
      rw [smul_smul]; exact smul_mem_scaleSet (Ideal.mul_mem_mul hr' hr) hy
    | zero => rw [smul_zero]; exact Submodule.zero_mem _
    | add x y _ _ hx hy => rw [smul_add]; exact Submodule.add_mem _ hx hy
    | smul c x _ hx => rw [smul_comm]; exact Submodule.smul_mem _ c hx
  · rw [scaleSet, Submodule.span_le]
    rintro _ ⟨m, hm, y, hy, rfl⟩
    refine Submodule.mul_induction_on (C := fun m => m • y ∈ scaleSet 𝔟 (scaleSet 𝔞 S : Set (QuatF F a b))) hm
      (fun r' hr' r hr => ?_) (fun x z hx hz => ?_)
    · rw [mul_smul]
      exact smul_mem_scaleSet hr' (smul_mem_scaleSet hr hy)
    · rw [add_smul]; exact Submodule.add_mem _ hx hz

/-- $(\mu)N = N\mu$ for an $\mathcal O_F$-submodule $N$. -/
theorem scaleSet_span_singleton (μ : 𝓞 F) (N : Submodule (𝓞 F) (QuatF F a b)) :
    (scaleSet (Ideal.span {μ}) (N : Set (QuatF F a b)) : Set (QuatF F a b)) =
      rTrans N (algebraMap (𝓞 F) (QuatF F a b) μ) := by
  have hcomm : ∀ y : QuatF F a b, y * algebraMap (𝓞 F) (QuatF F a b) μ = μ • y := fun y => by
    rw [Algebra.smul_def, Algebra.commutes]
  ext z
  constructor
  · intro hz
    change z ∈ scaleSet (Ideal.span {μ}) (N : Set (QuatF F a b)) at hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨r, hr, y, hy, rfl⟩ := hz
      obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.1 hr
      exact ⟨t • y, N.smul_mem t hy, by show t • y * _ = _; rw [hcomm, smul_smul, mul_comm]⟩
    | zero => exact ⟨0, N.zero_mem, zero_mul _⟩
    | add x y _ _ hx hy =>
      obtain ⟨x', hx', rfl⟩ := hx; obtain ⟨y', hy', rfl⟩ := hy
      exact ⟨x' + y', N.add_mem hx' hy', add_mul _ _ _⟩
    | smul c x _ hx =>
      obtain ⟨x', hx', rfl⟩ := hx
      exact ⟨c • x', N.smul_mem c hx', smul_mul_assoc _ _ _⟩
  · rintro ⟨y, hy, rfl⟩
    show y * algebraMap (𝓞 F) (QuatF F a b) μ ∈ scaleSet (Ideal.span {μ}) (N : Set (QuatF F a b))
    rw [hcomm]
    exact smul_mem_scaleSet (Ideal.mem_span_singleton_self μ) hy

/-- The left ideal $J$ as an $\mathcal O_F$-submodule of $D$. -/
def idealSub (J : Ideal O) : Submodule (𝓞 F) (QuatF F a b) where
  carrier := idealSet J
  add_mem' := add_mem_idealSet
  zero_mem' := zero_mem_idealSet J
  smul_mem' := fun c x hx => by
    rw [Algebra.smul_def]; exact mul_mem_idealSet (O.algebraMap_mem c) hx

theorem coe_idealSub (J : Ideal O) : (idealSub J : Set (QuatF F a b)) = idealSet J := rfl

/-- $N\gamma$ as an $\mathcal O_F$-submodule. -/
def rTransSub (N : Submodule (𝓞 F) (QuatF F a b)) (γ : QuatF F a b) : Submodule (𝓞 F) (QuatF F a b) :=
  N.map (LinearMap.mulRight (𝓞 F) γ)

theorem coe_rTransSub (N : Submodule (𝓞 F) (QuatF F a b)) (γ : QuatF F a b) :
    (rTransSub N γ : Set (QuatF F a b)) = rTrans N γ := by
  rw [rTransSub, Submodule.map_coe]; rfl

theorem algebraMap_ne_zero_quat {μ : 𝓞 F} (hμ : μ ≠ 0) : algebraMap (𝓞 F) (QuatF F a b) μ ≠ 0 := by
  intro h
  have h1 : nrd (algebraMap (𝓞 F) (QuatF F a b) μ) = (algebraMap (𝓞 F) F μ) ^ 2 := by
    rw [IsScalarTower.algebraMap_apply (𝓞 F) F (QuatF F a b), QuaternionAlgebra.algebraMap_eq]; exact nrd_coe _
  rw [h] at h1
  have : algebraMap (𝓞 F) F μ = 0 := by
    have h2 : (algebraMap (𝓞 F) F μ) ^ 2 = 0 := by rw [← h1]; simp [nrd]
    exact pow_eq_zero_iff two_ne_zero |>.1 h2
  exact hμ ((map_eq_zero_iff _ (IsFractionRing.injective (𝓞 F) F)).1 this)

/-- A nonzero $\mu \in \mathcal O_F$ as a unit of $D$. -/
def unitOf {μ : 𝓞 F} (hμ : μ ≠ 0) : (QuatF F a b)ˣ :=
  ((isUnit_iff_nrd_ne_zero _).2 fun h => by
    have h1 : nrd (algebraMap (𝓞 F) (QuatF F a b) μ) = (algebraMap (𝓞 F) F μ) ^ 2 := by
      rw [IsScalarTower.algebraMap_apply (𝓞 F) F (QuatF F a b), QuaternionAlgebra.algebraMap_eq]; exact nrd_coe _
    rw [h1] at h
    exact hμ ((map_eq_zero_iff _ (IsFractionRing.injective (𝓞 F) F)).1 (pow_eq_zero_iff two_ne_zero |>.1 h))).unit

theorem unitOf_val {μ : 𝓞 F} (hμ : μ ≠ 0) :
    ((unitOf (a := a) (b := b) hμ : (QuatF F a b)ˣ) : QuatF F a b) = algebraMap (𝓞 F) (QuatF F a b) μ := rfl

/-- **$\mathfrak b(\mathfrak aJ) = \mu J \sim J$** when $\mathfrak b\mathfrak a = (\mu)$, $\mu \ne 0$. -/
theorem idealRel_scaleIdeal_principal {𝔞 𝔟 : Ideal (𝓞 F)} {μ : 𝓞 F} (hμ : μ ≠ 0) (h : 𝔟 * 𝔞 = Ideal.span {μ})
    (J : Ideal O) : IdealRel J (scaleIdeal 𝔟 (scaleIdeal 𝔞 J)) := by
  refine ⟨unitOf hμ, ?_⟩
  rw [idealSet_scaleIdeal, idealSet_scaleIdeal, scaleSet_scaleSet, h, ← coe_idealSub, scaleSet_span_singleton,
    unitOf_val]

/-- **The right-order units of $\mathfrak aJ$ are those of $J$** (if $\mathfrak b\mathfrak a = (\mu)$ for some $\mathfrak b$, $\mu \ne 0$). -/
theorem rStab_scaleIdeal {𝔞 𝔟 : Ideal (𝓞 F)} {μ : 𝓞 F} (hμ : μ ≠ 0) (h : 𝔟 * 𝔞 = Ideal.span {μ}) (J : Ideal O) :
    rStab (scaleIdeal 𝔞 J) = rStab J := by
  ext γ
  rw [mem_rStab, mem_rStab, idealSet_scaleIdeal, ← scaleSet_rTrans]
  constructor
  · intro hγ
    have h1 := congrArg (fun N : Submodule (𝓞 F) (QuatF F a b) =>
        ((scaleSet 𝔟 (N : Set (QuatF F a b)) : Submodule (𝓞 F) (QuatF F a b)) : Set (QuatF F a b)))
      (SetLike.coe_injective hγ : scaleSet 𝔞 (rTrans (idealSet J) γ) = scaleSet 𝔞 (idealSet J))
    simp only [scaleSet_scaleSet, h] at h1
    rw [← coe_idealSub, ← coe_rTransSub, scaleSet_span_singleton, scaleSet_span_singleton, coe_rTransSub,
      coe_idealSub, rTrans_rTrans] at h1
    have h2 := congrArg (fun S => rTrans S ((unitOf (a := a) (b := b) hμ)⁻¹ : (QuatF F a b)ˣ)) h1
    simp only [rTrans_rTrans] at h2
    rwa [← unitOf_val hμ, mul_assoc, Units.mul_inv, mul_one, rTrans_one] at h2
  · intro hγ; rw [hγ]

/-- **The colon of $\mathfrak aJ$**: $\beta \in (\mathcal O:\mathfrak aJ) \iff r\beta \in (\mathcal O:J)$ for all $r \in \mathfrak a$. -/
theorem colon_scaleIdeal (𝔞 : Ideal (𝓞 F)) (J : Ideal O) (β : QuatF F a b) :
    β ∈ colon (scaleIdeal 𝔞 J) ↔ ∀ r ∈ 𝔞, r • β ∈ colon J := by
  constructor
  · intro hβ r hr x hx
    rw [mul_smul_comm, ← smul_mul_assoc]
    exact hβ _ (by rw [idealSet_scaleIdeal]; exact smul_mem_scaleSet hr hx)
  · intro h z hz
    rw [idealSet_scaleIdeal] at hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨r, hr, y, hy, rfl⟩ := hz
      rw [smul_mul_assoc, ← mul_smul_comm]; exact h r hr y hy
    | zero => rw [zero_mul]; exact O.zero_mem
    | add x y _ _ hx hy => rw [add_mul]; exact O.add_mem hx hy
    | smul c x _ hx => rw [smul_mul_assoc]; exact O.smul_mem hx c

/-! ### The reduced norm of $\mathfrak aJ$ -/

/-- $\operatorname{nrd}(x+y) = \operatorname{nrd}x + \operatorname{nrd}y + \operatorname{trd}(x\bar y)$. -/
theorem nrd_add (x y : QuatF F a b) : nrd (x + y) = nrd x + nrd y + trd (x * star y) := by
  simp only [nrd, trd, QuaternionAlgebra.re_mul, QuaternionAlgebra.re_add, QuaternionAlgebra.imI_add,
    QuaternionAlgebra.imJ_add, QuaternionAlgebra.imK_add, QuaternionAlgebra.re_star, QuaternionAlgebra.imI_star,
    QuaternionAlgebra.imJ_star, QuaternionAlgebra.imK_star]
  ring

/-- $t \in F$ lies in (the image of) the ideal $\mathfrak c$ of $\mathcal O_F$. -/
def InIdl (𝔠 : Ideal (𝓞 F)) (t : F) : Prop := ∃ r ∈ 𝔠, algebraMap (𝓞 F) F r = t

theorem InIdl.add {𝔠 : Ideal (𝓞 F)} {s t : F} (hs : InIdl 𝔠 s) (ht : InIdl 𝔠 t) : InIdl 𝔠 (s + t) := by
  obtain ⟨r, hr, rfl⟩ := hs; obtain ⟨r', hr', rfl⟩ := ht
  exact ⟨r + r', 𝔠.add_mem hr hr', map_add _ _ _⟩

theorem InIdl.sub {𝔠 : Ideal (𝓞 F)} {s t : F} (hs : InIdl 𝔠 s) (ht : InIdl 𝔠 t) : InIdl 𝔠 (s - t) := by
  obtain ⟨r, hr, rfl⟩ := hs; obtain ⟨r', hr', rfl⟩ := ht
  exact ⟨r - r', 𝔠.sub_mem hr hr', map_sub _ _ _⟩

theorem InIdl.zero (𝔠 : Ideal (𝓞 F)) : InIdl 𝔠 0 := ⟨0, 𝔠.zero_mem, map_zero _⟩

theorem InIdl.mul_left {𝔠 : Ideal (𝓞 F)} {t : F} (ht : InIdl 𝔠 t) (c : 𝓞 F) : InIdl 𝔠 (algebraMap (𝓞 F) F c * t) := by
  obtain ⟨r, hr, rfl⟩ := ht
  exact ⟨c * r, 𝔠.mul_mem_left c hr, map_mul _ _ _⟩

theorem inIdl_nrd (hO : IsOrder (𝓞 F) F O) {J : Ideal O} {y : QuatF F a b} (hy : y ∈ idealSet J) :
    InIdl (leftNrdIdeal J) (nrd y) := by
  obtain ⟨hyO, hyJ⟩ := hy
  obtain ⟨r, hr⟩ := (isInteger_trd_nrd hO hyO).2
  exact ⟨r, Ideal.subset_span ⟨⟨y, hyO⟩, hyJ, hr⟩, hr⟩

theorem trd_add (x y : QuatF F a b) : trd (x + y) = trd x + trd y := by simp [trd]; ring

theorem trd_smul_int (c : 𝓞 F) (x : QuatF F a b) : trd (c • x) = algebraMap (𝓞 F) F c * trd x := by
  rw [trd, trd, QuaternionAlgebra.re_smul, Algebra.smul_def]; ring

theorem trd_zero' : trd (0 : QuatF F a b) = 0 := by simp [trd]

theorem inIdl_trd_mul_star (hO : IsOrder (𝓞 F) F O) {J : Ideal O} {y y' : QuatF F a b} (hy : y ∈ idealSet J)
    (hy' : y' ∈ idealSet J) : InIdl (leftNrdIdeal J) (trd (y * star y')) := by
  have h : trd (y * star y') = nrd (y + y') - nrd y - nrd y' := by rw [nrd_add]; ring
  rw [h]
  exact ((inIdl_nrd hO (add_mem_idealSet hy hy')).sub (inIdl_nrd hO hy)).sub (inIdl_nrd hO hy')

theorem inIdl_trd_scale (hO : IsOrder (𝓞 F) F O) {𝔞 : Ideal (𝓞 F)} {J : Ideal O} {z z' : QuatF F a b}
    (hz : z ∈ scaleSet 𝔞 (idealSet J)) (hz' : z' ∈ scaleSet 𝔞 (idealSet J)) :
    InIdl (𝔞 ^ 2 * leftNrdIdeal J) (trd (z * star z')) := by
  induction hz using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨r, hr, y, hy, rfl⟩ := hz
    induction hz' using Submodule.span_induction with
    | mem z' hz' =>
      obtain ⟨r', hr', y', hy', rfl⟩ := hz'
      obtain ⟨t, ht, ht'⟩ := inIdl_trd_mul_star hO hy hy'
      refine ⟨r * r' * t, Ideal.mul_mem_mul (by rw [sq]; exact Ideal.mul_mem_mul hr hr') ht, ?_⟩
      rw [QuaternionAlgebra.star_smul, smul_mul_smul_comm, trd_smul_int, map_mul, map_mul, ht']
    | zero => rw [star_zero, mul_zero, trd_zero']; exact InIdl.zero _
    | add x x' _ _ hx hx' => rw [star_add, mul_add, trd_add]; exact hx.add hx'
    | smul c x _ hx => rw [QuaternionAlgebra.star_smul, mul_smul_comm, trd_smul_int]; exact hx.mul_left c
  | zero => rw [zero_mul, trd_zero']; exact InIdl.zero _
  | add x x' _ _ hx hx' => rw [add_mul, trd_add]; exact hx.add hx'
  | smul c x _ hx => rw [smul_mul_assoc, trd_smul_int]; exact hx.mul_left c

theorem inIdl_nrd_scale (hO : IsOrder (𝓞 F) F O) {𝔞 : Ideal (𝓞 F)} {J : Ideal O} {z : QuatF F a b}
    (hz : z ∈ scaleSet 𝔞 (idealSet J)) : InIdl (𝔞 ^ 2 * leftNrdIdeal J) (nrd z) := by
  induction hz using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨r, hr, y, hy, rfl⟩ := hz
    obtain ⟨t, ht, ht'⟩ := inIdl_nrd hO hy
    refine ⟨r ^ 2 * t, Ideal.mul_mem_mul (Ideal.pow_mem_pow hr 2) ht, ?_⟩
    rw [map_mul, map_pow, ht', ← algebraMap_smul F r y, nrd_smul]
  | zero => rw [show nrd (0 : QuatF F a b) = 0 by simp [nrd]]; exact InIdl.zero _
  | add x x' hx hx' ihx ihx' => rw [nrd_add]; exact (ihx.add ihx').add (inIdl_trd_scale hO hx hx')
  | smul c x _ hx =>
    rw [← algebraMap_smul F c x, nrd_smul, ← map_pow]; exact hx.mul_left (c ^ 2)

/-- **$\operatorname{nrd}(\mathfrak aJ) = \mathfrak a^2\operatorname{nrd}(J)$.** -/
theorem leftNrdIdeal_scaleIdeal (hO : IsOrder (𝓞 F) F O) (𝔞 : Ideal (𝓞 F)) (J : Ideal O) :
    leftNrdIdeal (scaleIdeal 𝔞 J) = 𝔞 ^ 2 * leftNrdIdeal J := by
  apply le_antisymm
  · rw [leftNrdIdeal, Ideal.span_le]
    rintro r ⟨x, hx, hr⟩
    obtain ⟨t, ht, ht'⟩ := inIdl_nrd_scale hO (z := (x : QuatF F a b)) hx
    have : t = r := IsFractionRing.injective (𝓞 F) F (ht'.trans hr.symm)
    exact this ▸ ht
  · rw [← span_sq_eq_sq, leftNrdIdeal, Ideal.span_mul_span, Ideal.span_le]
    rintro _ ⟨s, ⟨r, hr, rfl⟩, m, ⟨x, hx, hm⟩, rfl⟩
    refine Ideal.subset_span ⟨⟨r • (x : QuatF F a b), O.smul_mem x.2 r⟩, ?_, ?_⟩
    · show r • (x : QuatF F a b) ∈ scaleSet 𝔞 (idealSet J)
      exact smul_mem_scaleSet hr (coe_mem_idealSet.2 hx)
    · show algebraMap (𝓞 F) F (r ^ 2 * m) = nrd (r • (x : QuatF F a b))
      rw [map_mul, map_pow, hm, ← algebraMap_smul F r (x : QuatF F a b), nrd_smul]

theorem leftNrdIdeal_scaleIdeal_ne_bot (hO : IsOrder (𝓞 F) F O) {𝔞 : Ideal (𝓞 F)} (h𝔞 : 𝔞 ≠ ⊥) {J : Ideal O}
    (hJ : leftNrdIdeal J ≠ ⊥) : leftNrdIdeal (scaleIdeal 𝔞 J) ≠ ⊥ := by
  rw [leftNrdIdeal_scaleIdeal hO]
  exact mul_ne_zero (pow_ne_zero 2 h𝔞) hJ

theorem absNorm_leftNrdIdeal_scaleIdeal (hO : IsOrder (𝓞 F) F O) (𝔞 : Ideal (𝓞 F)) (J : Ideal O) :
    Ideal.absNorm (leftNrdIdeal (scaleIdeal 𝔞 J)) = Ideal.absNorm 𝔞 ^ 2 * Ideal.absNorm (leftNrdIdeal J) := by
  rw [leftNrdIdeal_scaleIdeal hO, map_mul, map_pow]

/-- A nonzero ideal of $\mathcal O_F$ times some ideal is principal and nonzero. -/
theorem exists_mul_eq_span {𝔞 : Ideal (𝓞 F)} (h𝔞 : 𝔞 ≠ ⊥) :
    ∃ (𝔟 : Ideal (𝓞 F)) (μ : 𝓞 F), μ ≠ 0 ∧ 𝔟 * 𝔞 = Ideal.span {μ} := by
  obtain ⟨μ, hμ, hμ0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot h𝔞
  obtain ⟨𝔟, h𝔟⟩ := Ideal.dvd_iff_le.2 ((Ideal.span_singleton_le_iff_mem _).2 hμ)
  exact ⟨𝔟, μ, hμ0, by rw [mul_comm, ← h𝔟]⟩

/-! ### The action on ideal classes -/

/-- **The class map** $[J] \mapsto [\mathfrak aJ]$ on left ideal classes. -/
def classScale (𝔞 : Ideal (𝓞 F)) : Quotient (idealSetoid O) → Quotient (idealSetoid O) :=
  Quotient.map (scaleIdeal 𝔞) fun _ _ h => idealRel_scaleIdeal 𝔞 h

theorem classScale_mk (𝔞 : Ideal (𝓞 F)) (J : Ideal O) :
    classScale 𝔞 (Quotient.mk (idealSetoid O) J) = Quotient.mk (idealSetoid O) (scaleIdeal 𝔞 J) := rfl

/-- **The class map of a nonzero ideal is injective** (it has the left inverse $[J] \mapsto [\mathfrak bJ]$, $\mathfrak b\mathfrak a$ principal). -/
theorem classScale_injective {𝔞 : Ideal (𝓞 F)} (h𝔞 : 𝔞 ≠ ⊥) : Function.Injective (classScale (O := O) 𝔞) := by
  obtain ⟨𝔟, μ, hμ, h⟩ := exists_mul_eq_span h𝔞
  have hleft : ∀ x, classScale 𝔟 (classScale (O := O) 𝔞 x) = x := by
    intro x
    induction x using Quotient.inductionOn with
    | h J => exact (Quotient.sound (idealRel_scaleIdeal_principal hμ h J)).symm
  exact Function.LeftInverse.injective hleft

/-- **The right-order unit index is unchanged**: $[\Gamma_{\mathfrak aJ} : \mathcal O_F^\times] = [\Gamma_J : \mathcal O_F^\times]$. -/
theorem index_centralUnitsIn_scaleIdeal {𝔞 : Ideal (𝓞 F)} (h𝔞 : 𝔞 ≠ ⊥) (J : Ideal O) :
    (centralUnitsIn (R := 𝓞 F) (scaleIdeal 𝔞 J)).index = (centralUnitsIn (R := 𝓞 F) J).index := by
  obtain ⟨𝔟, μ, hμ, h⟩ := exists_mul_eq_span h𝔞
  unfold centralUnitsIn
  rw [← Subgroup.relIndex, ← Subgroup.relIndex, rStab_scaleIdeal hμ h J]

end Scale

