/-
# The octonions as a Clifford module: $\mathrm{Spin}_7$ acts on $\mathbb O$ by isometries of the norm

The first algebraic step of the route $\mathrm{Spin}_7\to S^7$ with fibre $G_2$ for $\tau(G_2) = 1$. For an octonion algebra
$\mathbb O = (a, b, c)_K$ over a field $K$ (`Tamagawa/Exceptional/Octonion.lean`) with pure part
$\mathbb O_0 = \ker T$ (`Octonion.pureOct`):

* `normQF`: the norm $N$ as a Mathlib quadratic form on $\mathbb O$ (any commutative ring), and `pureNormQF`, its
  restriction to $\mathbb O_0$, the 7-dimensional form $\langle -a,-b,ab,-c,ac,bc,-abc\rangle$.
* `G2.toIsometryEquiv`: every $g\in G_2(K)$ restricts to an isometry of $(\mathbb O_0, N)$.
* `cliffordAction`: left multiplication $L_x(y) = xy$ ($x\in\mathbb O_0$) satisfies $L_x^2 = -N(x)$ (alternativity),
  so it extends to a $K$-algebra homomorphism $C(\mathbb O_0, -N)\to\operatorname{End}_K(\mathbb O)$: $\mathbb O$ is a module
  for the Clifford algebra of $(\mathbb O_0, -N)$ (Springer–Veldkamp 2000, §3.6 [unverified locator]).
* `norm_cliffordAction_spin` (**$\mathrm{Spin}_7$ acts by isometries**): every element $u$ of Mathlib's
  `spinGroup` (indeed of `pinGroup`) of $(\mathbb O_0, -N)$ acts on $\mathbb O$ preserving $N$. *Proof:* on the
  Lipschitz group (generated by the invertible vectors), $u$ multiplies $N$ by a scalar $t(u)$ with
  $\bar u u = u\bar u = t(u)$ (for a vector $m$: $t = N(m)$, by the composition law); on $\mathrm{Pin}$,
  $\bar uu = 1$ forces $t(u) = 1$.

So $\mathrm{Spin}(\mathbb O_0, -N)$ acts on the 8-dimensional quadratic space $(\mathbb O, N)$ by isometries
(the spin representation of $\mathrm{Spin}_7$); its action on the sphere $\{N = 1\}$, transitive with stabilizer
of $1$ equal to $G_2$, is the remaining algebraic input of route O1 (not formalized here).

Sources: Springer–Veldkamp, *Octonions, Jordan Algebras and Exceptional Groups* (2000), §3.6 [unverified
locator].
-/
import QuadFormsKB.Tamagawa.Exceptional.G2
import Mathlib.LinearAlgebra.CliffordAlgebra.SpinGroup

open Quaternion

set_option linter.unreachableTactic false
set_option linter.unusedTactic false

noncomputable section

namespace QuadFormsKB.Exceptional

open Octonion CliffordAlgebra

section Ring

variable {R : Type*} [CommRing R] {a b c : R}

namespace Octonion

theorem polar_norm_eq (x y : Octonion R a b c) :
    QuadraticMap.polar norm x y = polar x y := rfl

theorem polar_add_left (x x' y : Octonion R a b c) :
    polar (x + x') y = polar x y + polar x' y := by
  simp only [polar]; oct_coords; ring

theorem polar_smul_left (t : R) (x y : Octonion R a b c) :
    polar (t • x) y = t * polar x y := by
  simp only [polar]; oct_coords; ring

end Octonion

variable (R a b c) in
/-- **The norm of $\mathbb O = (a,b,c)_R$ as a quadratic form** (Mathlib's `QuadraticForm`):
$N(p + q\ell) = \operatorname{nrd}(p) - c\operatorname{nrd}(q)$, the Pfister form $\langle 1,-a,-b,ab,-c,ac,bc,-abc\rangle$
(`Octonion.norm_eq_coords`). -/
@[kb "springerveldkamp2000" "§1.10"]
def normQF : QuadraticForm R (Octonion R a b c) :=
  QuadraticMap.ofPolar norm
    (fun t x => by rw [Octonion.norm_smul, smul_eq_mul, sq])
    (fun x x' y => by
      simp only [polar_norm_eq]; exact Octonion.polar_add_left x x' y)
    (fun t x y => by simp only [polar_norm_eq, smul_eq_mul]; exact Octonion.polar_smul_left t x y)

@[simp] theorem normQF_apply (x : Octonion R a b c) : normQF R a b c x = norm x := rfl

end Ring

section Field

variable {K : Type*} [Field K] {a b c : K}


variable (K a b c) in
/-- **The norm form of the pure octonions** $(\mathbb O_0, N)$: the 7-dimensional quadratic form
$\langle -a,-b,ab,-c,ac,bc,-abc\rangle$. -/
@[kb "springerveldkamp2000" "§1.10"]
def pureNormQF : QuadraticForm K (pureOct K a b c) :=
  (normQF K a b c).comp (pureOct K a b c).subtype

@[simp] theorem pureNormQF_apply (x : pureOct K a b c) :
    pureNormQF K a b c x = norm (x : Octonion K a b c) := rfl

/-- **$G_2(K)$ acts on $(\mathbb O_0, N)$ by isometries**: the restriction of $g\in G_2(K)$ to the pure
octonions as an isometry equivalence of Mathlib quadratic forms (injective in $g$ when $2\ne0$,
`G2.toPure_injective`). -/
@[kb "springerveldkamp2000" "§2.3"]
def G2.toIsometryEquiv (g : G2 K a b c) :
    (pureNormQF K a b c).IsometryEquiv (pureNormQF K a b c) where
  toLinearEquiv := G2.toPure g
  map_app' v := by simp only [pureNormQF_apply]; exact G2.norm_toPure g v

/-- Left multiplication by a pure octonion, $x\mapsto L_x = (y\mapsto xy)$. -/
def leftMul : pureOct K a b c →ₗ[K] Module.End K (Octonion K a b c) where
  toFun x :=
    { toFun := fun y => (x : Octonion K a b c) * y
      map_add' := fun y z => Octonion.mul_add _ y z
      map_smul' := fun t y => Octonion.mul_smul t _ y }
  map_add' x y := by
    ext z : 1; simp only [Submodule.coe_add, LinearMap.coe_mk, AddHom.coe_mk, LinearMap.add_apply]
    exact Octonion.add_mul _ _ z
  map_smul' t x := by
    ext z : 1; simp only [SetLike.val_smul, LinearMap.coe_mk, AddHom.coe_mk, RingHom.id_apply,
      LinearMap.smul_apply]
    exact Octonion.smul_mul t _ z

@[simp] theorem leftMul_apply (x : pureOct K a b c) (y : Octonion K a b c) :
    leftMul x y = (x : Octonion K a b c) * y := rfl

/-- $L_x^2 = -N(x)$ for pure $x$ (left alternativity and $x^2 = -N(x)$). -/
theorem leftMul_sq (x : pureOct K a b c) :
    leftMul x * leftMul x = algebraMap K _ ((-pureNormQF K a b c) x) := by
  ext y : 1
  simp only [Module.End.mul_apply, leftMul_apply, neg_apply, pureNormQF_apply,
    Module.algebraMap_end_apply]
  rw [mul_mul_self_left, sq_of_trace_eq_zero (Octonion.mem_pure.mp x.2), smul_eq_scalar_mul]
  oct_ring

/-- **$\mathbb O$ is a Clifford module**: the $K$-algebra homomorphism
$C(\mathbb O_0, -N)\to\operatorname{End}_K(\mathbb O)$ extending $x\mapsto L_x$. -/
@[kb "springerveldkamp2000" "§3.6"]
def cliffordAction : CliffordAlgebra (-pureNormQF K a b c) →ₐ[K] Module.End K (Octonion K a b c) :=
  CliffordAlgebra.lift _ ⟨leftMul, leftMul_sq⟩

@[simp] theorem cliffordAction_ι (x : pureOct K a b c) (y : Octonion K a b c) :
    cliffordAction (ι _ x) y = (x : Octonion K a b c) * y := by
  simp [cliffordAction]

/-- The Clifford algebra of $(\mathbb O_0, -N)$. -/
local notation "Cl" => CliffordAlgebra (-pureNormQF K a b c)

/-- On the Lipschitz group, $u$ multiplies the norm by a scalar $t$ with $\bar uu = u\bar u = t$. -/
theorem lipschitz_scale {u : (CliffordAlgebra (-pureNormQF K a b c))ˣ}
    (hu : u ∈ lipschitzGroup (-pureNormQF K a b c)) :
    ∃ t : K, (∀ y, Octonion.norm (cliffordAction (u : Cl) y) = t * Octonion.norm y) ∧
      star (u : Cl) * (u : Cl) = algebraMap K _ t ∧
      (u : Cl) * star (u : Cl) = algebraMap K _ t := by
  induction hu using Subgroup.closure_induction with
  | mem v hv =>
    obtain ⟨m, hm⟩ := hv
    refine ⟨norm (m : Octonion K a b c), fun y => ?_, ?_, ?_⟩
    · rw [← hm, cliffordAction_ι, Octonion.norm_mul]
    · rw [← hm, star_ι, neg_mul, ι_sq_scalar, neg_apply, map_neg, neg_neg,
        pureNormQF_apply]
    · rw [← hm, star_ι, mul_neg, ι_sq_scalar, neg_apply, map_neg, neg_neg,
        pureNormQF_apply]
  | one =>
    exact ⟨1, fun y => by simp, by simp, by simp⟩
  | mul u v _ _ hu hv =>
    obtain ⟨s, hs1, hs2, hs3⟩ := hu
    obtain ⟨t, ht1, ht2, ht3⟩ := hv
    refine ⟨s * t, fun y => ?_, ?_, ?_⟩
    · simp only [Units.val_mul, map_mul, Module.End.mul_apply]
      rw [hs1, ht1]; ring
    · simp only [Units.val_mul, star_mul]
      rw [mul_assoc, ← mul_assoc (star (u : Cl)), hs2, ← Algebra.smul_def,
        mul_smul_comm, ht2, Algebra.smul_def, ← map_mul]
    · simp only [Units.val_mul, star_mul]
      rw [mul_assoc, ← mul_assoc (v : Cl), ht3, ← Algebra.smul_def,
        mul_smul_comm, hs3, Algebra.smul_def, ← map_mul, mul_comm t s]
  | inv u _ hu =>
    obtain ⟨t, ht1, ht2, ht3⟩ := hu
    have hinv : ∀ y, cliffordAction (u : Cl) (cliffordAction (↑u⁻¹ : Cl) y)
        = y := by
      intro y
      rw [← Module.End.mul_apply, ← map_mul, Units.mul_inv, map_one, Module.End.one_apply]
    have ht0 : t ≠ 0 := by
      intro h0
      have := ht1 (cliffordAction (↑u⁻¹ : Cl) 1)
      rw [hinv, h0, zero_mul] at this
      have h1 : norm (1 : Octonion K a b c) = 1 := by oct_coords; ring
      rw [h1] at this; exact one_ne_zero this
    -- `star u = t • u⁻¹`
    have hstar : star (u : Cl) = algebraMap K _ t * (↑u⁻¹ : Cl) := by
      calc star (u : Cl) = star (u : Cl) * u * ↑u⁻¹ := by
            rw [mul_assoc, Units.mul_inv, _root_.mul_one]
        _ = _ := by rw [ht2]
    have hss : star (↑u⁻¹ : Cl) * star (u : Cl) = 1 := by
      rw [← star_mul, Units.mul_inv, star_one]
    have hss' : star (u : Cl) * star (↑u⁻¹ : Cl) = 1 := by
      rw [← star_mul, Units.inv_mul, star_one]
    have hinvt : algebraMap K Cl t⁻¹ *
        algebraMap K _ t = 1 := by
      rw [← map_mul, inv_mul_cancel₀ ht0, map_one]
    refine ⟨t⁻¹, fun y => ?_, ?_, ?_⟩
    · have := ht1 (cliffordAction (↑u⁻¹ : Cl) y)
      rw [hinv] at this
      rw [this, ← mul_assoc, inv_mul_cancel₀ ht0, _root_.one_mul]
    · rw [hstar, ← Algebra.smul_def, mul_smul_comm] at hss
      calc star (↑u⁻¹ : Cl) * ↑u⁻¹ = (t⁻¹ * t) • (star (↑u⁻¹ : Cl) * ↑u⁻¹) := by
            rw [inv_mul_cancel₀ ht0, one_smul]
        _ = t⁻¹ • (1 : Cl) := by rw [← smul_smul, hss]
        _ = algebraMap K Cl t⁻¹ := by rw [Algebra.smul_def, _root_.mul_one]
    · rw [hstar, ← Algebra.smul_def, smul_mul_assoc] at hss'
      calc (↑u⁻¹ : Cl) * star (↑u⁻¹ : Cl) = (t⁻¹ * t) • ((↑u⁻¹ : Cl) * star (↑u⁻¹ : Cl)) := by
            rw [inv_mul_cancel₀ ht0, one_smul]
        _ = t⁻¹ • (1 : Cl) := by rw [← smul_smul, hss']
        _ = algebraMap K Cl t⁻¹ := by rw [Algebra.smul_def, _root_.mul_one]

/-- **$\mathrm{Pin}(\mathbb O_0, -N)$, in particular $\mathrm{Spin}_7$, acts on $(\mathbb O, N)$ by isometries.** -/
@[kb "springerveldkamp2000" "§3.6"]
theorem norm_cliffordAction_pin {u : CliffordAlgebra (-pureNormQF K a b c)}
    (hu : u ∈ pinGroup (-pureNormQF K a b c)) (y : Octonion K a b c) :
    Octonion.norm (cliffordAction u y) = Octonion.norm y := by
  obtain ⟨⟨v, hv, rfl⟩, hunit⟩ := hu
  obtain ⟨t, ht1, ht2, -⟩ := lipschitz_scale hv
  have h1 : star (v : Cl) * v = 1 := Unitary.star_mul_self_of_mem hunit
  have ht : t = 1 := by
    have := congrArg (fun z => cliffordAction z (1 : Octonion K a b c)) (ht2.symm.trans h1)
    simp only [AlgHom.commutes, Module.algebraMap_end_apply, map_one, Module.End.one_apply] at this
    have := congrArg (fun z : Octonion K a b c => z.fst.re) this
    simp only [fst_smul, fst_one, QuaternionAlgebra.re_smul, QuaternionAlgebra.re_one,
      smul_eq_mul, _root_.mul_one] at this
    exact this
  simpa [ht] using ht1 y

/-- **$\mathrm{Spin}_7$ acts on $(\mathbb O, N)$ by isometries**: every $u$ in Mathlib's `spinGroup` of
$(\mathbb O_0, -N)$ acts on the octonions preserving the norm (the spin representation). -/
@[kb "springerveldkamp2000" "§3.6"]
theorem norm_cliffordAction_spin {u : CliffordAlgebra (-pureNormQF K a b c)}
    (hu : u ∈ spinGroup (-pureNormQF K a b c)) (y : Octonion K a b c) :
    Octonion.norm (cliffordAction u y) = Octonion.norm y :=
  norm_cliffordAction_pin (spinGroup.mem_pin hu) y

end Field

end QuadFormsKB.Exceptional
