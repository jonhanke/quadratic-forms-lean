import QuadFormsKB.Tamagawa.Measure.Weil.SL2Prim
import QuadFormsKB.Weil.SL2Cells

/-!
# The fibration (Tamagawa) measure on $\mathrm{SL}_2(\mathbb A_F)$

$F$ any number field. Through the coordinates $\Psi : P\times\mathbb A_F\xrightarrow{\sim}\mathrm{SL}_2(\mathbb A_F)$,
$\Psi(y, x) = s(y)\,n(x)$ (`coordEquiv`, `SL2Section.lean`), we define
$$ \mu_T := \Psi_*\big(dy|_P\otimes dx\big), $$
with $dy$ the self-dual measure on $\mathbb A_F^2$ (`muAddVec`, $\operatorname{vol}(\mathbb A_F^2/F^2) = 1$) and $dx$ the
self-dual measure on $\mathbb A_F\cong N(\mathbb A_F)$ (`muAdd`, $\operatorname{vol}(\mathbb A_F/F) = 1$). This is Weil's
compatibility of Tamagawa measures with the fibration $\mathrm{SL}_2\to\mathrm{SL}_2/N\cong\mathbb A^2\setminus0$
(AAG §2.4, Thm 2.4.3: the Tamagawa measure of $G$ is the product of those of $G/H$ and $H$ when the gauge forms are
compatible; here $\omega_{\mathrm{SL}_2} = \omega_{\mathbb A^2}\wedge\omega_N$ for $g\mapsto(ge_1, x)$).

* **`map_mul_left_muT`**: $\mu_T$ is left invariant (left translation is a skew product over the
  $\mathrm{SL}_2(\mathbb A_F)$-action on $\mathbb A_F^2$, which preserves $dy$ because $\det = 1$, `map_mulVec_muAddVec`).
* **`muT_eq_smul_haar`**, **`isHaarMeasure_muT`**: $\mu_T = c\cdot\mu_{\mathrm{Haar}}$ with $0 < c < \infty$, so $\mu_T$ is
  a Haar measure. Finiteness of $c$: the explicit relatively compact neighbourhood `slNbhd` has finite $\mu_T$-measure;
  positivity: $P$ is conull (`muAddVec_compl_primSet`).
* **`modularCharacter_slEmb`**: the modular character of $\mathrm{SL}_2(\mathbb A_F)$ is trivial on $\mathrm{SL}_2(F)$
  (generated by $n(b)$, $m(t)$, $w$, `SL2.induction_on`; $\Delta(n(b))^3 = 1$ from $m(2)n(b)m(2)^{-1} = n(4b)$, then the
  Bruhat relation), hence $\mu_T$ is invariant under the right action of $\mathrm{SL}_2(F)$ (`smulInvariantMeasure_muT`):
  the measure on Weil's $G_{\mathbb A}/G_k$ is well defined.
-/

open IsDedekindDomain NumberField MeasureTheory Filter Topology NumberField.mixedEmbedding
open QuadFormsKB.WeilRep
open scoped ENNReal NNReal Pointwise Classical MatrixGroups

set_option linter.unusedSectionVars false

namespace QuadFormsKB.Tamagawa.Measure.Weil

noncomputable section

variable {F : Type} [Field F] [NumberField F]

local notation "AF" => FiniteAdeleRing (𝓞 F) F

/-! ### The measure on the primitive set -/

variable (F) in
/-- The self-dual measure $dy$ restricted to the primitive set $P$ (as a measure on the subtype). -/
def dyP : Measure (primSet F) := (muAddVec F (Fin 2)).comap Subtype.val

theorem measurableEmbedding_primSet_val :
    MeasurableEmbedding (Subtype.val : primSet F → AdeleSpace F (Fin 2)) :=
  MeasurableEmbedding.subtype_coe measurableSet_primSet

theorem dyP_apply (s : Set (primSet F)) : dyP F s = muAddVec F (Fin 2) (Subtype.val '' s) :=
  measurableEmbedding_primSet_val.comap_apply _ _

instance : SigmaFinite (muAddVec F (Fin 2)) := by unfold muAddVec; infer_instance

instance : SigmaFinite (dyP F) := by
  refine ⟨⟨{ set := fun n => Subtype.val ⁻¹' spanningSets (muAddVec F (Fin 2)) n,
              set_mem := fun _ => trivial,
              finite := fun n => ?_,
              spanning := ?_ }⟩⟩
  · rw [dyP_apply]
    exact lt_of_le_of_lt (measure_mono (Set.image_preimage_subset _ _)) (measure_spanningSets_lt_top _ n)
  · rw [← Set.preimage_iUnion, iUnion_spanningSets, Set.preimage_univ]

theorem dyP_univ : dyP F Set.univ = muAddVec F (Fin 2) Set.univ := by
  rw [dyP_apply, Set.image_univ, Subtype.range_coe]
  refine le_antisymm (measure_mono (Set.subset_univ _)) ?_
  calc muAddVec F (Fin 2) Set.univ ≤ muAddVec F (Fin 2) (primSet F) + muAddVec F (Fin 2) (primSet F)ᶜ := by
        rw [← Set.union_compl_self (primSet F)]; exact measure_union_le _ _
    _ = muAddVec F (Fin 2) (primSet F) := by rw [muAddVec_compl_primSet, add_zero]

/-! ### The measure $\mu_T$ -/

variable (F) in
/-- **The fibration measure** $\mu_T = \Psi_*(dy|_P\otimes dx)$ on $\mathrm{SL}_2(\mathbb A_F)$, $\Psi(y, x) = s(y)n(x)$.
By AAG Thm 2.4.3 this is the Tamagawa measure of $\mathrm{SL}_2$ (compatible with the fibration over
$\mathbb A^2\setminus 0$ with fibre $N\cong\mathbb G_a$; Weil's convergence factors are $\lambda_v = 1$). -/
@[kb "weil1982" "§2.4, Thm 2.4.3 (Tamagawa measures and fibrations) [unverified page]; §2.3, p. 21 (λ_v = 1 for SL₂)"]
def muT : Measure (SL2A F) := ((dyP F).prod (muAdd F)).map (ofCoord F)

instance : SigmaFinite (muT F) := (coordEquiv F).symm.sigmaFinite_map

theorem muT_apply {s : Set (SL2A F)} (hs : MeasurableSet s) :
    muT F s = ((dyP F).prod (muAdd F)) (ofCoord F ⁻¹' s) :=
  Measure.map_apply measurable_ofCoord hs

/-! ### Left invariance -/

theorem map_mulVec_SL2A (g₀ : SL2A F) :
    Measure.map (Matrix.mulVec (g₀ : Matrix (Fin 2) (Fin 2) (Adeles F))) (muAddVec F (Fin 2)) =
      muAddVec F (Fin 2) := by
  have h := map_mulVec_muAddVec (F := F) (ι := Fin 2) (Matrix.SpecialLinearGroup.toGL g₀)
  have hdet : Matrix.GeneralLinearGroup.det (Matrix.SpecialLinearGroup.toGL g₀) = 1 :=
    Units.ext (by rw [Matrix.SpecialLinearGroup.coeToGL_det])
  rw [hdet, ideleNorm_one, inv_one, ENNReal.ofReal_one, one_smul] at h
  exact h

theorem mulVec_mem_primSet (g₀ : SL2A F) {y : AdeleSpace F (Fin 2)} (hy : y ∈ primSet F) :
    Matrix.mulVec (g₀ : Matrix (Fin 2) (Fin 2) (Adeles F)) y ∈ primSet F := by
  rw [← col_sec hy, ← col_mul]; exact col_mem_primSet _

/-- The base map of the skew product: $y\mapsto g_0y$ on $P$. -/
def baseMap (g₀ : SL2A F) (y : primSet F) : primSet F := (toCoord F (g₀ * sec y)).1

theorem baseMap_val (g₀ : SL2A F) (y : primSet F) :
    ((baseMap g₀ y : primSet F) : AdeleSpace F (Fin 2)) =
      Matrix.mulVec (g₀ : Matrix (Fin 2) (Fin 2) (Adeles F)) y := by
  show col (g₀ * sec y) = _
  rw [col_mul, col_sec y.2]

theorem measurable_baseMap (g₀ : SL2A F) : Measurable (baseMap g₀) :=
  measurable_fst.comp (measurable_toCoord.comp ((measurable_sec.comp measurable_subtype_coe).const_mul g₀))

theorem measurePreserving_baseMap (g₀ : SL2A F) : MeasurePreserving (baseMap g₀) (dyP F) (dyP F) := by
  refine ⟨measurable_baseMap g₀, Measure.ext fun t ht => ?_⟩
  rw [Measure.map_apply (measurable_baseMap g₀) ht, dyP_apply, dyP_apply]
  have hset : Subtype.val '' (baseMap g₀ ⁻¹' t) =
      Matrix.mulVec (g₀ : Matrix (Fin 2) (Fin 2) (Adeles F)) ⁻¹' (Subtype.val '' t) := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact ⟨baseMap g₀ y, hy, baseMap_val g₀ y⟩
    · rintro ⟨z, hz, hzx⟩
      have hx : x ∈ primSet F := by
        have : x = Matrix.mulVec ((g₀⁻¹ : SL2A F) : Matrix (Fin 2) (Fin 2) (Adeles F)) z := by
          rw [hzx, Matrix.mulVec_mulVec, ← Matrix.SpecialLinearGroup.coe_mul, inv_mul_cancel,
            Matrix.SpecialLinearGroup.coe_one, Matrix.one_mulVec]
        rw [this]; exact mulVec_mem_primSet _ z.2
      refine ⟨⟨x, hx⟩, ?_, rfl⟩
      show baseMap g₀ ⟨x, hx⟩ ∈ t
      have : baseMap g₀ ⟨x, hx⟩ = z := Subtype.ext (by rw [baseMap_val]; exact hzx.symm)
      rw [this]; exact hz
  have hmeas : MeasurableSet (Subtype.val '' t : Set (AdeleSpace F (Fin 2))) :=
    measurableEmbedding_primSet_val.measurableSet_image.mpr ht
  have hmv : Measurable (Matrix.mulVec (g₀ : Matrix (Fin 2) (Fin 2) (Adeles F))) :=
    (show Continuous fun x : AdeleSpace F (Fin 2) => Matrix.mulVec (g₀ : Matrix (Fin 2) (Fin 2) (Adeles F)) x from
      continuous_const.matrix_mulVec continuous_id).measurable
  rw [hset, ← Measure.map_apply hmv hmeas, map_mulVec_SL2A]

/-- **$\mu_T$ is left invariant.** In coordinates, $g_0\Psi(y, x) = \Psi(g_0y,\ x + \beta(g_0, y))$, a skew product over
the measure-preserving map $y\mapsto g_0y$ with translations in the fibre. -/
@[kb "weil1982" "§2.4, Thm 2.4.3 [unverified page]; continuous unfolding SL₂ ⊃ N"]
theorem map_mul_left_muT (g₀ : SL2A F) : Measure.map (g₀ * ·) (muT F) = muT F := by
  have hgm : Measurable (Function.uncurry fun (y : primSet F) (x : Adeles F) =>
      (toCoord F (g₀ * sec (y : AdeleSpace F (Fin 2)))).2 + x) := by
    have h1 : Measurable fun y : primSet F => (toCoord F (g₀ * sec (y : AdeleSpace F (Fin 2)))).2 :=
      measurable_snd.comp (measurable_toCoord.comp ((measurable_sec.comp measurable_subtype_coe).const_mul g₀))
    exact (h1.comp measurable_fst).add measurable_snd
  have hT := (measurePreserving_baseMap g₀).skew_product (μc := muAdd F) (μd := muAdd F) hgm
    (Filter.Eventually.of_forall fun y => map_add_left_eq_self (muAdd F) _)
  have hcomp : ∀ p : primSet F × Adeles F, g₀ * ofCoord F p =
      ofCoord F (baseMap g₀ p.1, (toCoord F (g₀ * sec (p.1 : AdeleSpace F (Fin 2)))).2 + p.2) := by
    intro p
    rw [← ofCoord_toCoord (g₀ * ofCoord F p), toCoord_mul_ofCoord]
    rfl
  have hmeasT := hT.measurable
  have e1 : Measure.map (g₀ * ·) (muT F) = Measure.map (fun p => g₀ * ofCoord F p) ((dyP F).prod (muAdd F)) :=
    Measure.map_map (measurable_const_mul g₀) measurable_ofCoord
  have e2 : (fun p => g₀ * ofCoord F p) = ofCoord F ∘ (fun p : primSet F × Adeles F =>
      (baseMap g₀ p.1, (toCoord F (g₀ * sec (p.1 : AdeleSpace F (Fin 2)))).2 + p.2)) := funext hcomp
  rw [e1, e2, ← Measure.map_map measurable_ofCoord hmeasT, hT.map_eq]
  rfl

instance : (muT F).IsMulLeftInvariant := ⟨map_mul_left_muT⟩

/-! ### Comparison with Haar measure -/

/-- The second coordinate in matrix form: $x = (s(y)^{-1}g)_{01} = D\,b - B\,d$. -/
theorem toCoord_snd_eq (g : SL2A F) :
    (toCoord F g).2 = (secDInf (col g), secDFin (col g)) * (g : Matrix (Fin 2) (Fin 2) (Adeles F)) 0 1 -
      (secBInf (col g), secBFin (col g)) * (g : Matrix (Fin 2) (Fin 2) (Adeles F)) 1 1 := by
  have hy := col_mem_primSet g
  show (((sec (col g))⁻¹ * g : SL2A F) : Matrix (Fin 2) (Fin 2) (Adeles F)) 0 1 = _
  rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_inv]
  have hsec : ((sec (col g) : SL2A F) : Matrix (Fin 2) (Fin 2) (Adeles F)) = secMat (col g) := by
    simp only [sec, hy, ↓reduceDIte]; rfl
  rw [hsec, Matrix.adjugate_fin_two, Matrix.mul_apply, Fin.sum_univ_two]
  simp [secMat, sub_eq_add_neg]
  rw [← Prod.neg_mk, neg_mul]

theorem norm_comp_le_of_norm_lt {a : mixedSpace F} {r : ℝ} (h : ‖a‖ < r) :
    (∀ w, ‖a.1 w‖ < r) ∧ ∀ w, ‖a.2 w‖ < r :=
  ⟨fun w => lt_of_le_of_lt ((norm_le_pi_norm _ w).trans (norm_fst_le a)) h,
    fun w => lt_of_le_of_lt ((norm_le_pi_norm _ w).trans (norm_snd_le a)) h⟩

/-- Archimedean local estimate on the neighbourhood of $1$: if $|a - 1| < 1/2$, $|b| < 1/4$, $|c| < 1/4$, then the
section uses the branch $\begin{pmatrix}a&0\\c&a^{-1}\end{pmatrix}$ and $|D b - B d| = |b/a| \le 1$. -/
theorem loc_estimate {K : Type*} [NormedField K] {a b c d : K} (ha : ‖a - 1‖ < 1 / 2) (hb : ‖b‖ < 1 / 4)
    (hc : ‖c‖ < 1 / 4) : ‖locD (Metric.closedBall 0 1) a c * b - locB (Metric.closedBall 0 1) a c * d‖ ≤ 1 := by
  have ha' : 1 / 2 < ‖a‖ := by
    have := norm_sub_norm_le (1 : K) (1 - a)
    rw [norm_one, sub_sub_cancel, norm_sub_rev] at this
    linarith
  have ha0 : a ≠ 0 := by rintro rfl; simp at ha'; linarith
  have hca : c * a⁻¹ ∈ Metric.closedBall (0 : K) 1 := by
    rw [Metric.mem_closedBall, dist_zero_right, norm_mul, norm_inv]
    rw [← div_eq_mul_inv, div_le_one (by linarith)]
    linarith
  have hcond : a ≠ 0 ∧ c * a⁻¹ ∈ Metric.closedBall (0 : K) 1 := ⟨ha0, hca⟩
  simp only [locD, locB, if_pos hcond, zero_mul, sub_zero, norm_mul, norm_inv]
  rw [← div_eq_inv_mul, div_le_one (by linarith)]
  linarith

theorem toCoord_snd_mem_of_mem_slNbhd {g : SL2A F} (hg : g ∈ slNbhd F) :
    (toCoord F g).2 ∈ Metric.closedBall (0 : mixedSpace F) 1 ×ˢ OHat := by
  obtain ⟨hf, h00, h01, h10, h11⟩ := hg
  rw [toCoord_snd_eq]
  set a := (g : Matrix (Fin 2) (Fin 2) (Adeles F)) 0 0
  set b := (g : Matrix (Fin 2) (Fin 2) (Adeles F)) 0 1
  set c := (g : Matrix (Fin 2) (Fin 2) (Adeles F)) 1 0
  set d := (g : Matrix (Fin 2) (Fin 2) (Adeles F)) 1 1
  have hcol0 : col g 0 = a := rfl
  have hcol1 : col g 1 = c := rfl
  refine ⟨?_, fun v => ?_⟩
  · rw [Metric.mem_closedBall, dist_zero_right, Prod.norm_def]
    have ha1 := norm_comp_le_of_norm_lt (a := a.1 - 1) h00
    have hb1 := norm_comp_le_of_norm_lt h01
    have hc1 := norm_comp_le_of_norm_lt h10
    refine max_le ((pi_norm_le_iff_of_nonneg zero_le_one).mpr fun w => ?_)
      ((pi_norm_le_iff_of_nonneg zero_le_one).mpr fun w => ?_)
    · show ‖locD ballR ((col g 0).1.1 w) ((col g 1).1.1 w) * b.1.1 w -
          locB ballR ((col g 0).1.1 w) ((col g 1).1.1 w) * d.1.1 w‖ ≤ 1
      rw [hcol0, hcol1]
      exact loc_estimate (ha1.1 w) (hb1.1 w) (hc1.1 w)
    · show ‖locD ballC ((col g 0).1.2 w) ((col g 1).1.2 w) * b.1.2 w -
          locB ballC ((col g 0).1.2 w) ((col g 1).1.2 w) * d.1.2 w‖ ≤ 1
      rw [hcol0, hcol1]
      exact loc_estimate (ha1.2 w) (hb1.2 w) (hc1.2 w)
  · -- finite places: every `(a_v, c_v)` is primitive, so the section is integral
    have hdet : (g : Matrix (Fin 2) (Fin 2) (Adeles F)).det = 1 := g.2
    rw [Matrix.det_fin_two] at hdet
    have hprim : ∀ v, IsPrim (valV v) ((col g 0).2 v) ((col g 1).2 v) := fun v =>
      isPrim_of_det (valV v) (hf 0 0 v) (hf 0 1 v) (hf 1 0 v) (hf 1 1 v)
        (congrArg (fun z : Adeles F => z.2 v) hdet)
    have hev : ∀ᶠ v in cofinite, IsPrim (valV v) ((col g 0).2 v) ((col g 1).2 v) :=
      Filter.Eventually.of_forall hprim
    show valV v (secDFin (col g) v * b.2 v - secBFin (col g) v * d.2 v) ≤ 1
    rw [secDFin_apply, secBFin_apply, if_pos hev, if_pos hev]
    refine (Valuation.map_sub _ _ _).trans (max_le ?_ ?_)
    · rw [Valuation.map_mul]
      exact mul_le_one' (locD_integral (valV v) (hprim v)) (hf 0 1 v)
    · rw [Valuation.map_mul]
      exact mul_le_one' (locB_integral (valV v) (hprim v)) (hf 1 1 v)

/-- $\mu_T(\text{slNbhd}) < \infty$. -/
theorem muT_slNbhd_lt_top : muT F (slNbhd F) < ∞ := by
  set B : Set (AdeleSpace F (Fin 2)) := Set.univ.pi fun _ => Metric.closedBall (0 : mixedSpace F) 2 ×ˢ OHat
  set X : Set (Adeles F) := Metric.closedBall (0 : mixedSpace F) 1 ×ˢ OHat
  have hBc : IsCompact B := isCompact_univ_pi fun _ => (isCompact_closedBall _ _).prod isCompact_OHat
  have hXc : IsCompact X := (isCompact_closedBall _ _).prod isCompact_OHat
  have hsub : ofCoord F ⁻¹' slNbhd F ⊆ (Subtype.val ⁻¹' B) ×ˢ X := by
    intro p hp
    have hp' : ofCoord F p ∈ slNbhd F := hp
    have hpe : toCoord F (ofCoord F p) = p := toCoord_ofCoord p
    refine ⟨?_, ?_⟩
    · rw [← hpe]
      intro i _
      exact slNbhd_subset_slBox hp' i 0
    · rw [← hpe]; exact toCoord_snd_mem_of_mem_slNbhd hp'
  rw [muT_apply isOpen_slNbhd.measurableSet]
  refine lt_of_le_of_lt (measure_mono hsub) ?_
  rw [Measure.prod_prod, dyP_apply]
  refine ENNReal.mul_lt_top (lt_of_le_of_lt (measure_mono (Set.image_preimage_subset _ _)) hBc.measure_lt_top)
    hXc.measure_lt_top

theorem muT_univ_ne_zero : muT F Set.univ ≠ 0 := by
  rw [muT_apply MeasurableSet.univ, Set.preimage_univ, ← Set.univ_prod_univ, Measure.prod_prod, dyP_univ]
  exact mul_ne_zero (NeZero.ne _) (NeZero.ne _)

variable (F) in
/-- A fixed Haar measure on $\mathrm{SL}_2(\mathbb A_F)$. -/
def haarSL2 : Measure (SL2A F) := Measure.haar

instance : (haarSL2 F).IsHaarMeasure := by unfold haarSL2; infer_instance

variable (F) in
/-- The comparison constant $c = \mu_T(U)/\mu_{\mathrm{Haar}}(U)$. -/
def cT : ℝ≥0∞ := muT F (slNbhd F) / haarSL2 F (slNbhd F)

/-- **$\mu_T$ is a Haar measure**: $\mu_T = c\,\mu_{\mathrm{Haar}}$ (uniqueness of left-invariant σ-finite measures). -/
theorem muT_eq_smul_haar : muT F = cT F • haarSL2 F :=
  measure_eq_div_smul (μ' := muT F) (ν' := haarSL2 F) (s := slNbhd F)
    (haar_slNbhd_pos_lt_top (haarSL2 F)).1 (haar_slNbhd_pos_lt_top (haarSL2 F)).2

theorem cT_ne_top : cT F ≠ ∞ :=
  ENNReal.div_ne_top muT_slNbhd_lt_top.ne (haar_slNbhd_pos_lt_top (haarSL2 F)).1

theorem cT_ne_zero : cT F ≠ 0 := by
  intro h
  apply muT_univ_ne_zero (F := F)
  rw [muT_eq_smul_haar, h, zero_smul, Measure.coe_zero, Pi.zero_apply]

/-- **$\mu_T$ is a Haar measure on $\mathrm{SL}_2(\mathbb A_F)$.** -/
@[kb "weil1982" "§2.4, Thm 2.4.3 [unverified page]"]
theorem isHaarMeasure_muT : (muT F).IsHaarMeasure := by
  rw [muT_eq_smul_haar]
  exact Measure.IsHaarMeasure.smul _ cT_ne_zero cT_ne_top

instance : (muT F).IsHaarMeasure := isHaarMeasure_muT

instance : (muT F).Regular := Measure.Regular.of_sigmaCompactSpace_of_isLocallyFiniteMeasure _

/-! ### The modular character is trivial on $\mathrm{SL}_2(F)$ -/

theorem nnreal_eq_one_of_pow {x : ℝ≥0} {n : ℕ} (hn : n ≠ 0) (h : x ^ n = 1) : x = 1 :=
  (pow_eq_one_iff_of_nonneg (zero_le : 0 ≤ x) hn).mp h

/-- **The modular character of $\mathrm{SL}_2(\mathbb A_F)$ is trivial on $\mathrm{SL}_2(F)$.** -/
@[kb "weil1982" "§2.4, p. 23 (G_𝔸/G_k carries an invariant measure) [unverified locator]"]
theorem modularCharacter_slEmb (γ : SL(2, F)) : Measure.modularCharacter (slEmb F γ) = 1 := by
  set χ : SL(2, F) →* ℝ≥0 := Measure.modularCharacter.comp (slEmb F)
  have hpos : ∀ g, 0 < χ g := fun g => Measure.modularCharacterFun_pos _
  have hconj : ∀ g h : SL(2, F), χ (g * h * g⁻¹) = χ h := fun g h => by
    rw [map_mul, map_mul, map_inv, mul_comm (χ g), mul_assoc, mul_inv_cancel₀ (hpos g).ne', mul_one]
  have h2 : (2 : F) ≠ 0 := two_ne_zero
  -- `χ(n(b)) = 1`
  have hn : ∀ b : F, χ (nMat b) = 1 := by
    intro b
    have h4 : χ (nMat (4 * b)) = χ (nMat b) := by
      have := hconj (mMat (Units.mk0 2 h2)) (nMat b)
      rw [mMat_nMat, mul_assoc, mul_inv_cancel, mul_one] at this
      convert this using 3
      simp; norm_num
    have hpow : χ (nMat (4 * b)) = χ (nMat b) ^ 4 := by
      rw [show 4 * b = b + b + b + b by ring, nMat_add, nMat_add, nMat_add, map_mul, map_mul, map_mul]
      ring
    rw [h4] at hpow
    have h3 : χ (nMat b) ^ 3 = 1 := by
      have hne := (hpos (nMat b)).ne'
      have : χ (nMat b) * χ (nMat b) ^ 3 = χ (nMat b) * 1 := by
        calc χ (nMat b) * χ (nMat b) ^ 3 = χ (nMat b) ^ 4 := by ring
          _ = χ (nMat b) := hpow.symm
          _ = χ (nMat b) * 1 := (mul_one _).symm
      exact mul_left_cancel₀ hne this
    exact nnreal_eq_one_of_pow (by norm_num) h3
  -- the Bruhat relation gives `χ(m(-b⁻¹)) = χ(w)`
  have hmw : ∀ {b : F} (hb : b ≠ 0), χ (mMat (Units.mk0 (-b⁻¹) (by simpa using hb))) = χ wMat := by
    intro b hb
    have := congrArg χ (wMat_nMat_wMat hb)
    simp only [map_mul, hn, mul_one, one_mul] at this
    exact (mul_right_cancel₀ (hpos wMat).ne' this).symm
  have hw : χ wMat = 1 := by
    have h1 := congrArg χ (wMat_mul_wMat (k := F))
    have h2' := hmw (b := (1 : F)) one_ne_zero
    have e : (Units.mk0 (-(1 : F)⁻¹) (by simp) : Fˣ) = -1 := Units.ext (by simp)
    rw [e] at h2'
    rw [map_mul, h2'] at h1
    have hne := (hpos wMat).ne'
    exact mul_left_cancel₀ hne (by rw [mul_one]; exact h1)
  have hm : ∀ t : Fˣ, χ (mMat t) = 1 := by
    intro t
    have hb : (-(t : F)⁻¹) ≠ 0 := by simp
    have := hmw hb
    have e : (Units.mk0 (-(-(t : F)⁻¹)⁻¹) (by simpa using hb) : Fˣ) = t := Units.ext (by simp)
    rw [e, hw] at this
    exact this
  have key : ∀ g : SL(2, F), χ g = 1 := by
    intro g
    induction g using SL2.induction_on with
    | h1 => exact map_one χ
    | hn g b ih => rw [map_mul, ih, hn, one_mul]
    | hm g t ih => rw [map_mul, ih, hm, one_mul]
    | hw g ih => rw [map_mul, ih, hw, one_mul]
  exact key γ

/-- **$\mu_T$ is invariant under the right action of $\mathrm{SL}_2(F)$** ($g\mapsto g\gamma^{-1}$), so it defines the
invariant measure on Weil's $G_{\mathbb A}/G_k$. -/
instance smulInvariantMeasure_muT : SMulInvariantMeasure (SL(2, F)) (SL2A F) (muT F) := by
  refine ⟨fun γ s hs => ?_⟩
  have hmap := Measure.map_right_mul_eq_modularCharacterFun_smul (muT F) (slEmb F γ)⁻¹
  have h1 : Measure.modularCharacterFun (slEmb F γ)⁻¹ = 1 := by
    have := modularCharacter_slEmb (F := F) γ⁻¹
    rwa [map_inv] at this
  rw [h1, one_smul] at hmap
  have : (fun g : SL2A F => γ • g) = (· * (slEmb F γ)⁻¹) := rfl
  rw [this, ← Measure.map_apply (measurable_mul_const _) hs, hmap]

end

end QuadFormsKB.Tamagawa.Measure.Weil
