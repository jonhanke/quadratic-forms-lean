import QuadFormsKB.Tamagawa.Measure.Weil.SLnPrimNull
import QuadFormsKB.Tamagawa.Measure.Weil.SLnBlock
import QuadFormsKB.Tamagawa.Measure.Weil.OrbitFibration
import QuadFormsKB.Tamagawa.Measure.Weil.GLScaling

/-!
# The Tamagawa measure of $\mathrm{SL}_n(\mathbb A_F)$, by induction on $n$

$F$ a number field. Weil's fibration (Weil 1982, §2.4, Lemma 2.4.1, Thm 2.4.3): $\mathrm{SL}_n(\mathbb A_F)$ acts
transitively on the primitive vectors $X\subseteq\mathbb A_F^n$ (`primSetN`, conull) with stabilizer of $e_0$
$$P = \Big\{\begin{pmatrix}1 & c\\ 0 & h\end{pmatrix}\Big\}\cong\mathbb A_F^{n-1}\rtimes\mathrm{SL}_{n-1}(\mathbb A_F),$$
so the gauge form of $\mathrm{SL}_n$ is $dy\wedge\omega_P$ with $\omega_P = \omega_{\mathrm{SL}_{n-1}}\wedge dc$. Accordingly
(**`muSL F k`**, a measure on $\mathrm{SL}_{k+1}(\mathbb A_F)$):
* $\mu_1$ = the point mass on the trivial group $\mathrm{SL}_1(\mathbb A_F)$;
* $\mu_{k+2} = \Psi_*(dy|_X\otimes\mu_P)$, $\Psi(x, p) = s(x)p$ with the measurable section $s$ of `SLnPrim.lean`, and
  $\mu_P$ the image of $\mu_{k+1}\otimes dc$ under $(h, c)\mapsto\operatorname{blk}(h, c)$ (`muP`); $dy$, $dc$ are the
  self-dual measures (`muAddVec`).

**`good_muSL`**: for every $k$, $\mu_{k+1}$ is σ-finite, nonzero, left invariant, and invariant under right
translation by $\mathrm{SL}_{k+1}(F)$ (so it defines Weil's invariant measure on $G_{\mathbb A}/G_k$). Right invariance:
right translation by $g$ multiplies a left-invariant measure by a character $c(g)$ (`rightChar`, SLnAdele.lean), which
is $1$ on the $F$-points of $P$ (from the induction hypothesis and $\det = 1$), hence on all their
$\mathrm{SL}_n(F)$-conjugates (the stabilizers of the $e_m$), hence on $\mathrm{SL}_n(F)$, which is generated by
transvections and (for $n\ge3$) diagonal matrices $\operatorname{diag}(\dots,a,\dots,a^{-1},\dots)$, each fixing some $e_m$
(for $n = 2$: Mathlib's `SL2.transvection_induction`).
-/

open IsDedekindDomain NumberField MeasureTheory Filter Topology NumberField.mixedEmbedding Matrix
open scoped ENNReal NNReal Classical MatrixGroups

set_option linter.unusedSectionVars false

namespace QuadFormsKB.Tamagawa.Measure.Weil.SLn

noncomputable section

variable {F : Type} [Field F] [NumberField F] {k : ℕ}

instance sigmaFinite_muAddVec {ι : Type} [Fintype ι] : SigmaFinite (muAddVec F ι) := by
  unfold muAddVec; infer_instance

instance isAddHaarMeasure_muAddVec {ι : Type} [Fintype ι] : (muAddVec F ι).IsAddHaarMeasure := by
  unfold muAddVec; infer_instance

/-! ### $\mathrm{SL}_n(\mathbb A_F)$ acting on $\mathbb A_F^n$ and on the primitive vectors -/

/-- $\mathrm{SL}_n(\mathbb A_F)$ preserves the self-dual measure of $\mathbb A_F^n$. -/
theorem map_mulVec_SLnA {m : ℕ} (g : SLnA F (Fin m)) :
    Measure.map (Matrix.mulVec (g : Matrix (Fin m) (Fin m) (Adeles F))) (muAddVec F (Fin m)) = muAddVec F (Fin m) := by
  have h := map_mulVec_muAddVec (F := F) (ι := Fin m) (Matrix.SpecialLinearGroup.toGL g)
  have hdet : Matrix.GeneralLinearGroup.det (Matrix.SpecialLinearGroup.toGL g) = 1 :=
    Units.ext (by rw [Matrix.SpecialLinearGroup.coeToGL_det])
  rw [hdet, ideleNorm_one, inv_one, ENNReal.ofReal_one, one_smul] at h
  exact h

theorem measurable_mulVec_adele {m : ℕ} (M : Matrix (Fin m) (Fin m) (Adeles F)) :
    Measurable fun y : AdeleSpace F (Fin m) => M *ᵥ y :=
  (continuous_const.matrix_mulVec continuous_id).measurable

instance smulInvariantMeasure_muAddVec {m : ℕ} :
    SMulInvariantMeasure (SLnA F (Fin m)) (AdeleSpace F (Fin m)) (muAddVec F (Fin m)) := by
  refine ⟨fun g t ht => ?_⟩
  have : (fun y : AdeleSpace F (Fin m) => g • y) = Matrix.mulVec (g : Matrix (Fin m) (Fin m) (Adeles F)) := rfl
  rw [this, ← Measure.map_apply (measurable_mulVec_adele _) ht, map_mulVec_SLnA]

theorem smul_eq_mulVec {m : ℕ} (g : SLnA F (Fin m)) (y : AdeleSpace F (Fin m)) :
    g • y = (g : Matrix (Fin m) (Fin m) (Adeles F)) *ᵥ y := rfl

theorem mulVec_mem_primSetN (g : SLnA F (Fin (k + 2))) {y : AdeleSpace F (Fin (k + 2))} (hy : y ∈ primSetN F k) :
    (g : Matrix (Fin (k + 2)) (Fin (k + 2)) (Adeles F)) *ᵥ y ∈ primSetN F k := by
  rw [← col_secN hy, ← col_mul]; exact col_mem_primSetN _

variable (F k) in
/-- The primitive vectors as a sub-$\mathrm{SL}_n(\mathbb A_F)$-set of $\mathbb A_F^n$. -/
def primSub : SubMulAction (SLnA F (Fin (k + 2))) (AdeleSpace F (Fin (k + 2))) where
  carrier := primSetN F k
  smul_mem' g _ hy := mulVec_mem_primSetN g hy

variable (F k) in
/-- $X$ = the primitive vectors, as a type. -/
abbrev PX : Type := primSub F k

theorem measurableSet_primSub : MeasurableSet ((primSub F k : Set (AdeleSpace F (Fin (k + 2))))) :=
  measurableSet_primSetN

theorem col_one : col (1 : SLnA F (Fin (k + 2))) = Pi.single 0 1 := by
  funext r
  simp only [col, Matrix.SpecialLinearGroup.coe_one, Matrix.one_apply, Pi.single_apply]

variable (F k) in
/-- The base point $e_0\in X$. -/
def e0X : PX F k := ⟨col 1, col_mem_primSetN 1⟩

theorem smul_e0X (g : SLnA F (Fin (k + 2))) : ((g • e0X F k : PX F k) : AdeleSpace F (Fin (k + 2))) = col g := by
  show (g : Matrix (Fin (k + 2)) (Fin (k + 2)) (Adeles F)) *ᵥ col 1 = col g
  rw [← col_mul, mul_one]

variable (F k) in
/-- **The orbit section of $g\mapsto ge_0$** on $\mathrm{SL}_n(\mathbb A_F)$. -/
def orbSec : OrbitSection (SLnA F (Fin (k + 2))) (PX F k) where
  base := e0X F k
  sec y := secN (y : AdeleSpace F (Fin (k + 2)))
  sec_smul y := Subtype.ext (by rw [smul_e0X, col_secN y.2])
  measurable_sec := measurable_secN.comp measurable_subtype_coe
  measurable_orbit := by
    have : (fun g : SLnA F (Fin (k + 2)) => g • e0X F k) = fun g => ⟨col g, col_mem_primSetN g⟩ :=
      funext fun g => Subtype.ext (smul_e0X g)
    rw [this]
    exact measurable_col.subtype_mk

variable (F k) in
/-- $dy|_X$, the self-dual measure restricted to the primitive vectors. -/
def nuX : Measure (PX F k) := (muAddVec F (Fin (k + 2))).comap Subtype.val

instance : SMulInvariantMeasure (SLnA F (Fin (k + 2))) (PX F k) (nuX F k) :=
  smulInvariantMeasure_comap_subMulAction (muAddVec F (Fin (k + 2))) (primSub F k) measurableSet_primSub

instance : SigmaFinite (nuX F k) := sigmaFinite_comap_subtype _ measurableSet_primSub

theorem nuX_apply_univ : nuX F k Set.univ = muAddVec F (Fin (k + 2)) Set.univ := by
  rw [nuX, (MeasurableEmbedding.subtype_coe measurableSet_primSub).comap_apply, Set.image_univ,
    Subtype.range_coe_subtype]
  show muAddVec F (Fin (k + 2)) (primSetN F k) = _
  exact measure_congr (ae_eq_univ.mpr muAddVec_compl_primSetN)

/-! ### The stabilizer of $e_0$ -/

theorem col_eq_mulVec (g : SLnA F (Fin (k + 2))) :
    col g = (g : Matrix (Fin (k + 2)) (Fin (k + 2)) (Adeles F)) *ᵥ Pi.single 0 1 := by
  rw [mulVec_single_one]; rfl

theorem mem_stab_iff (g : SLnA F (Fin (k + 2))) :
    g ∈ (orbSec F k).stab ↔ (g : Matrix (Fin (k + 2)) (Fin (k + 2)) (Adeles F)) *ᵥ Pi.single 0 1 = Pi.single 0 1 := by
  rw [OrbitSection.mem_stab_iff]
  show g • e0X F k = e0X F k ↔ _
  rw [Subtype.ext_iff, smul_e0X, ← col_eq_mulVec]
  show col g = col 1 ↔ _
  rw [col_one]

/-- $(h, c)\mapsto\begin{pmatrix}1 & c\\ 0 & h\end{pmatrix}$ into the stabilizer. -/
def stabMap (p : SLnA F (Fin (k + 1)) × AdeleSpace F (Fin (k + 1))) : (orbSec F k).stab :=
  ⟨blk p.1 p.2, (mem_stab_iff _).2 (blkM_mulVec_single _ _)⟩

/-- The inverse of `stabMap`. -/
def stabInv (q : (orbSec F k).stab) : SLnA F (Fin (k + 1)) × AdeleSpace F (Fin (k + 1)) :=
  (lowBlkSL (q : SLnA F (Fin (k + 2))) ((mem_stab_iff _).1 q.2),
    topRow (q : Matrix (Fin (k + 2)) (Fin (k + 2)) (Adeles F)))

theorem stabMap_stabInv (q : (orbSec F k).stab) : stabMap (stabInv q) = q :=
  Subtype.ext (eq_blk _ ((mem_stab_iff _).1 q.2)).symm

theorem stabInv_stabMap (p : SLnA F (Fin (k + 1)) × AdeleSpace F (Fin (k + 1))) : stabInv (stabMap p) = p := by
  obtain ⟨h, c⟩ := p
  refine Prod.ext (Subtype.ext ?_) rfl
  funext r s; rfl

theorem stabMap_mul (p p' : SLnA F (Fin (k + 1)) × AdeleSpace F (Fin (k + 1))) :
    stabMap p * stabMap p' =
      stabMap (p.1 * p'.1, p'.2 + vecMul p.2 (p'.1 : Matrix (Fin (k + 1)) (Fin (k + 1)) (Adeles F))) :=
  Subtype.ext (blk_mul _ _ _ _)

theorem measurable_stabMap : Measurable (stabMap (F := F) (k := k)) := by
  refine Measurable.subtype_mk (measurable_SLnA_iff.mpr fun r s => ?_)
  refine Fin.cases ?_ (fun r => ?_) r <;> refine Fin.cases ?_ (fun s => ?_) s
  · exact measurable_const
  · exact (measurable_pi_apply s).comp measurable_snd
  · exact measurable_const
  · exact (measurable_SLnA_entry r s).comp measurable_fst

theorem measurable_stabInv : Measurable (stabInv (F := F) (k := k)) := by
  refine Measurable.prodMk (measurable_SLnA_iff.mpr fun r s => ?_) (measurable_pi_iff.mpr fun s => ?_)
  · exact (measurable_SLnA_entry r.succ s.succ).comp measurable_subtype_coe
  · exact (measurable_SLnA_entry 0 s.succ).comp measurable_subtype_coe

/-- $\mathrm{SL}_{n-1}(\mathbb A_F)\times\mathbb A_F^{n-1}\simeq P$ as measurable spaces. -/
def stabEquiv : SLnA F (Fin (k + 1)) × AdeleSpace F (Fin (k + 1)) ≃ᵐ (orbSec F k).stab where
  toFun := stabMap
  invFun := stabInv
  left_inv := stabInv_stabMap
  right_inv := stabMap_stabInv
  measurable_toFun := measurable_stabMap
  measurable_invFun := measurable_stabInv

/-- **The measure of the stabilizer** $\mu_P$: the image of $\mu\otimes dc$ under $(h,c)\mapsto\operatorname{blk}(h,c)$. -/
def muP (μ : Measure (SLnA F (Fin (k + 1)))) : Measure (orbSec F k).stab :=
  (μ.prod (muAddVec F (Fin (k + 1)))).map stabMap

theorem sigmaFinite_muP (μ : Measure (SLnA F (Fin (k + 1)))) [SigmaFinite μ] :
    SigmaFinite (muP (F := F) μ) := by
  have : muP (F := F) μ = (μ.prod (muAddVec F (Fin (k + 1)))).map (stabEquiv (F := F) (k := k)) := rfl
  rw [this]; exact MeasurableEquiv.sigmaFinite_map _

/-- **$\mu_P$ is left invariant**: $\operatorname{blk}(h_0,c_0)\operatorname{blk}(h,c) = \operatorname{blk}(h_0h,\ c + c_0h)$, a
skew product of a left translation and translations. -/
theorem isMulLeftInvariant_muP (μ : Measure (SLnA F (Fin (k + 1)))) [SigmaFinite μ] [μ.IsMulLeftInvariant] :
    (muP (F := F) μ).IsMulLeftInvariant := by
  refine ⟨fun q₀ => ?_⟩
  rw [← stabMap_stabInv q₀]
  set p₀ := stabInv q₀
  have hgm : Measurable (Function.uncurry fun (h : SLnA F (Fin (k + 1))) (c : AdeleSpace F (Fin (k + 1))) =>
      c + vecMul p₀.2 (h : Matrix (Fin (k + 1)) (Fin (k + 1)) (Adeles F))) := by
    have : Measurable fun p : SLnA F (Fin (k + 1)) × AdeleSpace F (Fin (k + 1)) =>
        vecMul p₀.2 (p.1 : Matrix (Fin (k + 1)) (Fin (k + 1)) (Adeles F)) :=
      measurable_pi_iff.mpr fun j => by
        simp only [vecMul, dotProduct]
        exact Finset.measurable_sum _ fun i _ => ((measurable_SLnA_entry i j).comp measurable_fst).const_mul _
    exact measurable_snd.add this
  have hT := (measurePreserving_mul_left μ p₀.1).skew_product (μc := muAddVec F (Fin (k + 1)))
    (μd := muAddVec F (Fin (k + 1))) hgm (Filter.Eventually.of_forall fun h => map_add_right_eq_self _ _)
  have hcomp : (fun q => stabMap p₀ * q) ∘ stabMap = stabMap ∘ (fun p : SLnA F (Fin (k + 1)) ×
      AdeleSpace F (Fin (k + 1)) =>
        (p₀.1 * p.1, p.2 + vecMul p₀.2 (p.1 : Matrix (Fin (k + 1)) (Fin (k + 1)) (Adeles F)))) := by
    funext p; exact stabMap_mul p₀ p
  rw [muP, Measure.map_map (measurable_const_mul _) measurable_stabMap, hcomp,
    ← Measure.map_map measurable_stabMap hT.measurable, hT.map_eq]

/-- $\mathrm{SL}_m(\mathbb A_F)$ preserves the self-dual measure acting on row vectors. -/
theorem map_vecMul_SLnA {m : ℕ} (h : SLnA F (Fin m)) :
    Measure.map (fun c : AdeleSpace F (Fin m) => vecMul c (h : Matrix (Fin m) (Fin m) (Adeles F)))
      (muAddVec F (Fin m)) = muAddVec F (Fin m) := by
  set hT : SLnA F (Fin m) := ⟨(h : Matrix (Fin m) (Fin m) (Adeles F))ᵀ, by rw [det_transpose, h.2]⟩
  have : (fun c : AdeleSpace F (Fin m) => vecMul c (h : Matrix (Fin m) (Fin m) (Adeles F))) =
      Matrix.mulVec (hT : Matrix (Fin m) (Fin m) (Adeles F)) := by
    funext c; exact (mulVec_transpose _ _).symm
  rw [this, map_mulVec_SLnA]

/-- **Right translation by $\operatorname{blk}(h_0, c_0)$ preserves $\mu_P$** when right translation by $h_0$
preserves $\mu$: $\operatorname{blk}(h,c)\operatorname{blk}(h_0,c_0) = \operatorname{blk}(hh_0,\ c_0 + ch_0)$. -/
theorem stabMap_mem_rightInvSub (μ : Measure (SLnA F (Fin (k + 1)))) [SigmaFinite μ]
    {h₀ : SLnA F (Fin (k + 1))} (hh₀ : h₀ ∈ rightInvSub μ) (c₀ : AdeleSpace F (Fin (k + 1))) :
    stabMap (h₀, c₀) ∈ rightInvSub (muP (F := F) μ) := by
  rw [mem_rightInvSub]
  have hcomp : (fun q => q * stabMap (h₀, c₀)) ∘ stabMap = stabMap ∘ Prod.map (fun h => h * h₀)
      (fun c : AdeleSpace F (Fin (k + 1)) =>
        c₀ + vecMul c (h₀ : Matrix (Fin (k + 1)) (Fin (k + 1)) (Adeles F))) := by
    funext p; exact stabMap_mul p (h₀, c₀)
  have hvm : Measurable fun c : AdeleSpace F (Fin (k + 1)) =>
      vecMul c (h₀ : Matrix (Fin (k + 1)) (Fin (k + 1)) (Adeles F)) :=
    (continuous_id.matrix_vecMul continuous_const).measurable
  have hm2 : Measurable fun c : AdeleSpace F (Fin (k + 1)) =>
      c₀ + vecMul c (h₀ : Matrix (Fin (k + 1)) (Fin (k + 1)) (Adeles F)) :=
    measurable_const.add hvm
  have h2 : (muAddVec F (Fin (k + 1))).map (fun c : AdeleSpace F (Fin (k + 1)) =>
      c₀ + vecMul c (h₀ : Matrix (Fin (k + 1)) (Fin (k + 1)) (Adeles F))) = muAddVec F (Fin (k + 1)) := by
    have e : (fun c : AdeleSpace F (Fin (k + 1)) =>
        c₀ + vecMul c (h₀ : Matrix (Fin (k + 1)) (Fin (k + 1)) (Adeles F))) =
        (fun c => c₀ + c) ∘ (fun c : AdeleSpace F (Fin (k + 1)) =>
          vecMul c (h₀ : Matrix (Fin (k + 1)) (Fin (k + 1)) (Adeles F))) := rfl
    rw [e, ← Measure.map_map (measurable_const_add c₀) hvm, map_vecMul_SLnA, map_add_left_eq_self]
  have hh : μ.map (fun h => h * h₀) = μ := hh₀
  rw [muP, Measure.map_map (measurable_mul_const _) measurable_stabMap, hcomp,
    ← Measure.map_map measurable_stabMap ((measurable_mul_const h₀).prodMap hm2),
    ← Measure.map_prod_map _ _ (measurable_mul_const h₀) hm2, h2, hh]

end

end QuadFormsKB.Tamagawa.Measure.Weil.SLn
