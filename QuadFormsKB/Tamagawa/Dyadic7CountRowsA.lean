      [[.sq 1 1, .sq 1 1, .sq 2 1]] (fun x => by simp [famR2, forgetUnit]) 0 1 (by omega : (1 + 1) % 2 = 0) (by omega : (2 + 1) % 2 = 1) 4 (0)
      (by rw [(famR2).minSq_eq]; simp only [famR2, winLens, List.map_cons, List.map_nil, Nat.add_sub_cancel_left, Nat.sub_zero]; decide)
      (by rw [(famR2).minSq_eq]; simp only [famR2, winLens, List.map_cons, List.map_nil, Nat.add_sub_cancel_left, Nat.sub_zero]; decide), hb]
    simp only [famR2, winLens, List.map_cons, List.map_nil, Nat.add_sub_cancel_left, Nat.sub_zero]
    rw [show locNII'L [4] [[.sq 1 1, .sq 1 1, .sq 2 1]] = 1 by decide, show locNIIL [4] [[.sq 1 1, .sq 1 1, .sq 2 1]] = 0 by decide]
    par2_tac
