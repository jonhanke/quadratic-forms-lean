/-- The family of representatives of Table 5.3, row 4. -/
def famR4 (b : ℕ) (h0 : 3 ≤ b) : SqFam (1) (b + 1) where
  ws := [(0, 3), (b, b + 3)]
  L x := [[.sq 1 x.1, .sq 1 x.2.1], [.sq 1 x.2.2]]
  hnd := by nd_tac
  hloc x := by hloc_tac
  hdec x := winDecomp_of (L := [[.sq 1 x.1, .sq 1 x.2.1], [.sq 1 x.2.2]]) (L₀ := [[.sq 1 1, .sq 1 1], [.sq 1 1]]) (by hloc_tac)
    (by simp [forgetUnit]) (by simp only [winLens, List.map_cons, List.map_nil, Nat.add_sub_cancel_left, Nat.sub_zero]; decide)
    (by lt_tac) (by disj_tac) (by cover_tac)
  hforget x y := by simp [forgetUnit]

theorem famR4_A (b : ℕ) (h0 : 3 ≤ b) {u : ℤ} (hu : u ∈ sqUnits) :
    ∑ x ∈ minSq u (1) (b + 1), massWt (b + 3) u (sqL (1) (b + 1) x) = ((3 * (1 / 2) ^ (b + 3) : ℚ) : ℝ) / 4 := by
  have hu' := hu
  simp only [sqUnits, Finset.mem_insert, Finset.mem_singleton] at hu'
  set F := (famR4 (b) (by omega))
  have hlens : winLens F.ws = [3, 3] := by simp [F, famR4, winLens]
  have hL : F.L = fun x => [[.sq 1 x.1, .sq 1 x.2.1], [.sq 1 x.2.2]] := rfl
  have hn2 : locNII'L [3, 3] [[.sq 1 1, .sq 1 1], [.sq 1 1]] = 0 := by decide
  have hn1 : locNIIL [3, 3] [[.sq 1 1, .sq 1 1], [.sq 1 1]] = 0 := by decide
  rw [F.sum_massWt hu (by omega) (by omega) (by omega) (by simp [F, famR4] <;> omega) [[.sq 1 1, .sq 1 1], [.sq 1 1]]
    (fun x => by rw [hL]; simp [forgetUnit]) 6 11664
    (by rw [F.minSq_eq, hlens, hL]; rcases hu' with rfl | rfl | rfl | rfl <;> decide)
    (by rw [F.minSq_eq, hlens, hL]; rcases hu' with rfl | rfl | rfl | rfl <;> decide), hlens, hn2, hn1, show (b + 3) - 1 = b + 2 by omega, show (b + 1) - 1 = b by omega]
  fin_tac

