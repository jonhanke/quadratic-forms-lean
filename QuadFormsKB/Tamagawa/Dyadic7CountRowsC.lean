import QuadFormsKB.Tamagawa.Dyadic7CountGen

/-!
# Paper 7 at $p = 2$: representative families of Table 5.3, rows 18, 19, 5, 6, 10, 11

For each listed row of Hanke's Table 5.3 (arXiv:1109.1054, §5, pp. 21–22; the partial local genus symbols of
Lemma 4.2), the family `famR…` of class representatives with the row's exponents (a window decomposition with explicit
localized lists), and the two class-weighted sums over its first-in-class units:

* `famR…_A`: $\sum \mathrm{massWt} = (\text{row entry of } 4A^*)/4$;
* `famR…_B`: $\sum c_2\cdot\mathrm{massWt} = c_2(D_0(u))\cdot(\text{row entry of } |4B^*|)/4$.

The finite computations (classes of unit tuples under sign walking and oddity fusion, window species, Hasse
invariants) are checked by `decide`. Generated by a script (outside Lean); indices are 0-based.
-/

open Finset

namespace QuadFormsKB.Dyadic7

open QuadFormsKB.ConwaySloane QuadFormsKB.ConwaySloane.Mass Cassels QuadFormsKB.Hanke2011Ternary

/-- The family of representatives of Table 5.3, row 18. -/
def famR18 (b : ℕ) (h0 : 3 ≤ b) : SqFam (b + 1) (b + 3) where
  ws := [(0, 3), (b, b + 5)]
  L x := [[.sq 1 x.1], [.sq 1 x.2.1, .sq 3 x.2.2]]
  hnd := by nd_tac
  hloc x := by hloc_tac
  hdec x := winDecomp_of (L := [[.sq 1 x.1], [.sq 1 x.2.1, .sq 3 x.2.2]]) (L₀ := [[.sq 1 1], [.sq 1 1, .sq 3 1]]) (by hloc_tac)
    (by simp [forgetUnit]) (by simp only [winLens, List.map_cons, List.map_nil, Nat.add_sub_cancel_left, Nat.sub_zero]; decide)
    (by lt_tac) (by disj_tac) (by cover_tac)
  hforget x y := by simp [forgetUnit]

theorem famR18_A (b : ℕ) (h0 : 3 ≤ b) {u : ℤ} (hu : u ∈ sqUnits) :
    ∑ x ∈ minSq u (b + 1) (b + 3), massWt (2 * b + 5) u (sqL (b + 1) (b + 3) x) = ((3 * (1 / 2) ^ (3 * b + 5) : ℚ) : ℝ) / 4 := by
  have hu' := hu
  simp only [sqUnits, Finset.mem_insert, Finset.mem_singleton] at hu'
  set F := (famR18 (b) (by omega))
  have hlens : winLens F.ws = [3, 5] := by simp [F, famR18, winLens]
  have hL : F.L = fun x => [[.sq 1 x.1], [.sq 1 x.2.1, .sq 3 x.2.2]] := rfl
  have hn2 : locNII'L [3, 5] [[.sq 1 1], [.sq 1 1, .sq 3 1]] = 0 := by decide
  have hn1 : locNIIL [3, 5] [[.sq 1 1], [.sq 1 1, .sq 3 1]] = 0 := by decide
  rw [F.sum_massWt hu (by omega) (by omega) (by omega) (by simp [F, famR18] <;> omega) [[.sq 1 1], [.sq 1 1, .sq 3 1]]
    (fun x => by rw [hL]; simp [forgetUnit]) 8 419904
    (by rw [F.minSq_eq, hlens, hL]; rcases hu' with rfl | rfl | rfl | rfl <;> decide)
    (by rw [F.minSq_eq, hlens, hL]; rcases hu' with rfl | rfl | rfl | rfl <;> decide), hlens, hn2, hn1, show (2 * b + 5) - 1 = 2 * b + 4 by omega, show (b + 3) - 1 = b + 2 by omega]
  fin_tac

