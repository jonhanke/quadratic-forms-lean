/-
# The class number formula for orders (Neukirch I (12.12)), proved

**Setting** as in `OrderPicSetup.lean`: $\mathcal O = \mathcal O_E$, $R\subseteq\mathcal O$ a subalgebra over $\mathcal O_F$,
$\mathfrak m\ne0$ an ideal of $\mathcal O$ with $\mathfrak m\subseteq R$.

**Proves** (unconditional)
* `ker_phi_eq`: the kernel of $\varphi:(\mathcal O/\mathfrak m)^\times\to\mathrm{Cl}(R)$ is the subgroup generated by the image
  of $(R/\mathfrak m\cap R)^\times$ and the image of $\mathcal O^\times$;
* `card_ker_phi`: its order is $\#(R/\mathfrak m\cap R)^\times\,[\mathcal O^\times:R^\times]$;
* **`orderClassNumberFormula`**: the named input `OrderClassNumberFormula F E` of `OrderClassNumber.lean` holds:
  $$h(R)\,[\mathcal O_E^\times:R^\times]\,\#(R/\mathfrak m)^\times = h(\mathcal O_E)\,\#(\mathcal O_E/\mathfrak m)^\times,$$
  from the exact sequence
  $1\to R^\times\to\mathcal O^\times\to(\mathcal O/\mathfrak m)^\times/(R/\mathfrak m)^\times\to\mathrm{Pic}(R)\to\mathrm{Pic}(\mathcal O)\to1$
  (`range_phi_eq_ker_psi`, `psi_surjective`);
* **`remark_8_8_corrected_unconditional`**: Hanke's Rem. 8.8 (corrected) with no named input.

Source: Neukirch, *Algebraic Number Theory*, Ch. I, §12, (12.9)–(12.12), pp. 78–79.
-/
import QuadFormsKB.Literature.Hanke2011Structure.OrderPicSurj

open NumberField IsDedekindDomain Module UniqueFactorizationMonoid
open scoped nonZeroDivisors

namespace QuadFormsKB.Hanke2011Structure.OrderCN

set_option linter.unusedSectionVars false
set_option synthInstance.maxHeartbeats 400000

noncomputable section

variable {F : Type} [Field F] [NumberField F] {E : Type} [Field E] [NumberField E] [Algebra F E]
variable {R : Subalgebra (𝓞 F) (𝓞 E)} {𝔪 : Ideal (𝓞 E)}

local notation "ι" => algebraMap (𝓞 E) E

variable (R 𝔪) in
/-- $R/(\mathfrak m\cap R)\to\mathcal O/\mathfrak m$. -/
abbrev qmap : R ⧸ idealIn R 𝔪 →+* 𝓞 E ⧸ 𝔪 := Ideal.quotientMap 𝔪 R.val.toRingHom le_rfl

theorem qmap_mk (r : R) : qmap R 𝔪 (Ideal.Quotient.mk _ r) = Ideal.Quotient.mk 𝔪 (r : 𝓞 E) := rfl

variable (R 𝔪) in
/-- $(R/\mathfrak m\cap R)^\times\to(\mathcal O/\mathfrak m)^\times$. -/
abbrev iotaU : (R ⧸ idealIn R 𝔪)ˣ →* (𝓞 E ⧸ 𝔪)ˣ := Units.map (qmap R 𝔪).toMonoidHom

variable (𝔪) in
/-- $\mathcal O^\times\to(\mathcal O/\mathfrak m)^\times$. -/
abbrev redU : (𝓞 E)ˣ →* (𝓞 E ⧸ 𝔪)ˣ := Units.map (Ideal.Quotient.mk 𝔪).toMonoidHom

theorem iotaU_injective : Function.Injective (iotaU R 𝔪) :=
  Units.map_injective (f := (qmap R 𝔪).toMonoidHom) Ideal.quotientMap_injective

/-- In the finite ring $R/(\mathfrak m\cap R)$, an element that becomes a unit in $\mathcal O/\mathfrak m$ is a unit. -/
theorem isUnit_of_qmap (hm : 𝔪 ≠ ⊥) {a : R ⧸ idealIn R 𝔪} (ha : IsUnit (qmap R 𝔪 a)) : IsUnit a := by
  have : Finite (𝓞 E ⧸ 𝔪) := finite_quot hm
  have : Finite (R ⧸ idealIn R 𝔪) :=
    Finite.of_injective _ (Ideal.quotientMap_injective (I := 𝔪) (f := R.val.toRingHom))
  have hinj : Function.Injective (fun b : R ⧸ idealIn R 𝔪 => a * b) := by
    intro b c hbc
    apply Ideal.quotientMap_injective (I := 𝔪) (f := R.val.toRingHom)
    have h := congrArg (qmap R 𝔪) hbc
    simp only [map_mul] at h
    exact ha.mul_left_cancel h
  obtain ⟨b, hb⟩ := (Finite.injective_iff_surjective.mp hinj) 1
  exact ⟨⟨a, b, hb, by rw [mul_comm]; exact hb⟩, rfl⟩

variable [IsFractionRing R E]

/-- $rR+\mathfrak m = R$ for $r\in R$ invertible modulo $\mathfrak m\cap R$. -/
theorem idealA_of_R (hR : ∀ x ∈ 𝔪, x ∈ R) {r s : R} (hrs : ((r * s : R) : 𝓞 E) - 1 ∈ 𝔪) :
    idealA R 𝔪 (r : 𝓞 E) = 1 := by
  apply le_antisymm
  · intro x hx
    obtain ⟨t, μ, hμ, rfl⟩ := (mem_idealA hR _ x).mp hx
    exact (FractionalIdeal.mem_one_iff R⁰).mpr ⟨t * r + ⟨μ, hR μ hμ⟩, by rw [algebraMap_R_E]; simp⟩
  · intro x hx
    obtain ⟨t, rfl⟩ := (FractionalIdeal.mem_one_iff R⁰).mp hx
    have hμ : (t : 𝓞 E) * (1 - (r * s : R)) ∈ 𝔪 := 𝔪.mul_mem_left _ (by rw [← neg_sub]; exact 𝔪.neg_mem hrs)
    refine (mem_idealA hR _ _).mpr ⟨t * s, _, hμ, ?_⟩
    rw [algebraMap_R_E]
    congr 1
    simp only [Subalgebra.coe_mul]
    ring

/-- $u R+\mathfrak m = uR$ for a unit $u$ of $\mathcal O$. -/
theorem idealA_of_unit (hR : ∀ x ∈ 𝔪, x ∈ R) (u : (𝓞 E)ˣ) :
    idealA R 𝔪 (u : 𝓞 E) = FractionalIdeal.spanSingleton R⁰ (ι u) := by
  apply le_antisymm
  · intro x hx
    obtain ⟨t, μ, hμ, rfl⟩ := (mem_idealA hR _ x).mp hx
    refine (FractionalIdeal.mem_spanSingleton R⁰).mpr
      ⟨t + ⟨(u⁻¹ : (𝓞 E)ˣ) * μ, hR _ (𝔪.mul_mem_left _ hμ)⟩, ?_⟩
    rw [Algebra.smul_def, algebraMap_R_E, ← map_mul]
    congr 1
    simp only [Subalgebra.coe_add]
    rw [add_mul, mul_right_comm, Units.inv_mul, one_mul]
  · intro x hx
    obtain ⟨t, rfl⟩ := (FractionalIdeal.mem_spanSingleton R⁰).mp hx
    refine (mem_idealA hR _ _).mpr ⟨t, 0, 𝔪.zero_mem, ?_⟩
    rw [Algebra.smul_def, algebraMap_R_E, add_zero, map_mul]

theorem rep_congr (hR : ∀ x ∈ 𝔪, x ∈ R) (u : (𝓞 E ⧸ 𝔪)ˣ) {a : 𝓞 E} (ha : Ideal.Quotient.mk 𝔪 a = u) :
    idealA R 𝔪 (rep (u : 𝓞 E ⧸ 𝔪)) = idealA R 𝔪 a :=
  idealA_congr hR (sub_mem_of_mk_eq (by rw [mk_rep, ha]))

/-- **The kernel of $\varphi$** is generated by the images of $(R/\mathfrak m\cap R)^\times$ and $\mathcal O^\times$. -/
theorem ker_phi_eq (hm : 𝔪 ≠ ⊥) (hR : ∀ x ∈ 𝔪, x ∈ R) :
    (phi R 𝔪 hR).ker = (iotaU R 𝔪).range ⊔ (redU 𝔪).range := by
  apply le_antisymm
  · intro u hu
    rw [MonoidHom.mem_ker, phi, MonoidHom.comp_apply, ClassGroup.mk_eq_one_iff] at hu
    obtain ⟨x, hx⟩ := hu.principal
    have hxI : idealA R 𝔪 (rep (u : 𝓞 E ⧸ 𝔪)) = FractionalIdeal.spanSingleton R⁰ x := by
      rw [← coe_phi0 hR, ← FractionalIdeal.coeToSubmodule_inj, hx, FractionalIdeal.coe_spanSingleton]
    -- `x ∈ 𝒪`, and `x` is a unit of `𝒪` since `(aR + 𝔪)𝒪 = 𝒪`
    obtain ⟨o, rfl⟩ := idealA_le_O hR _ (hxI ▸ FractionalIdeal.mem_spanSingleton_self R⁰ x)
    have hext : FractionalIdeal.spanSingleton (𝓞 E)⁰ (ι o) = 1 := by
      rw [← extendedHom_spanSingleton' (R := R), ← hxI]
      exact extendedHom_idealA hR _ (rep_mul_sub_one u)
    have ho1 : (1 : E) ∈ FractionalIdeal.spanSingleton (𝓞 E)⁰ (ι o) := by
      rw [hext]; exact (FractionalIdeal.mem_one_iff _).mpr ⟨1, map_one _⟩
    obtain ⟨o', ho'⟩ := (FractionalIdeal.mem_spanSingleton (𝓞 E)⁰).mp ho1
    rw [Algebra.smul_def, ← map_mul] at ho'
    have hoo' : o * o' = 1 := by
      rw [mul_comm]; exact IsFractionRing.injective (𝓞 E) E (by rw [ho', map_one])
    let ou : (𝓞 E)ˣ := ⟨o, o', hoo', by rw [mul_comm]; exact hoo'⟩
    -- `rep u = r o` with `r ∈ R`
    obtain ⟨r, hr⟩ := (FractionalIdeal.mem_spanSingleton R⁰).mp
      (hxI ▸ mem_idealA_self hR (rep (u : 𝓞 E ⧸ 𝔪)))
    rw [Algebra.smul_def, algebraMap_R_E, ← map_mul] at hr
    have hr' : (r : 𝓞 E) * o = rep (u : 𝓞 E ⧸ 𝔪) := IsFractionRing.injective (𝓞 E) E hr
    have hru : qmap R 𝔪 (Ideal.Quotient.mk _ r) * Ideal.Quotient.mk 𝔪 o = u := by
      rw [qmap_mk, ← map_mul, hr', mk_rep]
    have hunit : IsUnit (qmap R 𝔪 (Ideal.Quotient.mk _ r)) := by
      have : qmap R 𝔪 (Ideal.Quotient.mk _ r) = (u * (redU 𝔪 ou)⁻¹ : (𝓞 E ⧸ 𝔪)ˣ) := by
        rw [Units.val_mul, ← hru]
        simp [ou, redU]
        rw [mul_assoc, ← map_mul, hoo', map_one, mul_one]
      rw [this]; exact Units.isUnit _
    obtain ⟨a, ha⟩ := isUnit_of_qmap hm hunit
    have : u = iotaU R 𝔪 a * redU 𝔪 ou := by
      ext
      rw [Units.val_mul, ← hru]
      simp [iotaU, redU, ha, ou]
    rw [this]
    exact Subgroup.mul_mem_sup ⟨a, rfl⟩ ⟨ou, rfl⟩
  · refine sup_le ?_ ?_
    · rintro _ ⟨a, rfl⟩
      rw [MonoidHom.mem_ker, phi, MonoidHom.comp_apply, ClassGroup.mk_eq_one_iff, coe_phi0]
      obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (a : R ⧸ idealIn R 𝔪)
      obtain ⟨s, hs⟩ := Ideal.Quotient.mk_surjective ((a⁻¹ : (R ⧸ idealIn R 𝔪)ˣ) : R ⧸ idealIn R 𝔪)
      have hrs : r * s - 1 ∈ idealIn R 𝔪 :=
        Ideal.Quotient.eq.mp (by rw [map_mul, hr, hs, Units.mul_inv, map_one])
      rw [rep_congr hR _ (a := (r : 𝓞 E)) (by simp [iotaU, ← hr]),
        idealA_of_R hR (s := s) (by simpa using hrs), ← map_one (FractionalIdeal.spanSingleton R⁰),
        FractionalIdeal.coe_spanSingleton]
      exact ⟨⟨_, rfl⟩⟩
    · rintro _ ⟨v, rfl⟩
      rw [MonoidHom.mem_ker, phi, MonoidHom.comp_apply, ClassGroup.mk_eq_one_iff, coe_phi0, rep_congr hR _ (a := (v : 𝓞 E)) (by simp [redU]),
        idealA_of_unit hR, FractionalIdeal.coe_spanSingleton]
      exact ⟨⟨_, rfl⟩⟩

/-- $\{u\in\mathcal O^\times : u\bmod\mathfrak m\in(R/\mathfrak m\cap R)^\times\} = R^\times$. -/
theorem comap_iotaU_range (hR : ∀ x ∈ 𝔪, x ∈ R) :
    (iotaU R 𝔪).range.comap (redU 𝔪) = (Units.map R.val.toRingHom.toMonoidHom).range := by
  have key : ∀ u : (𝓞 E)ˣ, redU 𝔪 u ∈ (iotaU R 𝔪).range → (u : 𝓞 E) ∈ R := by
    rintro u ⟨a, ha⟩
    obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (a : R ⧸ idealIn R 𝔪)
    have h : Ideal.Quotient.mk 𝔪 (r : 𝓞 E) = Ideal.Quotient.mk 𝔪 (u : 𝓞 E) := by
      rw [← qmap_mk, hr]; exact congrArg Units.val ha
    have hmem := sub_mem_of_mk_eq h.symm
    have := R.add_mem (hR _ hmem) r.2
    simpa using this
  ext u
  simp only [Subgroup.mem_comap, MonoidHom.mem_range]
  constructor
  · intro hu
    have h1 := key u hu
    have h2 := key u⁻¹ (by rw [map_inv]; exact Subgroup.inv_mem _ hu)
    refine ⟨⟨⟨_, h1⟩, ⟨_, h2⟩, Subtype.ext (by simp), Subtype.ext (by simp)⟩, Units.ext rfl⟩
  · rintro ⟨v, rfl⟩
    exact ⟨Units.map (Ideal.Quotient.mk (idealIn R 𝔪)).toMonoidHom v, Units.ext rfl⟩

/-- **$\#\ker\varphi = \#(R/\mathfrak m\cap R)^\times\,[\mathcal O^\times:R^\times]$.** -/
theorem card_ker_phi (hm : 𝔪 ≠ ⊥) (hR : ∀ x ∈ 𝔪, x ∈ R) :
    Nat.card (phi R 𝔪 hR).ker = Nat.card (R ⧸ idealIn R 𝔪)ˣ * unitIndex R := by
  rw [ker_phi_eq hm hR]
  set H0 := (iotaU R 𝔪).range
  set K := H0 ⊔ (redU 𝔪).range
  have hle : H0 ≤ K := le_sup_left
  have h1 : Nat.card (H0.subgroupOf K) * H0.relIndex K = Nat.card K := Subgroup.card_mul_index _
  have h2 : Nat.card (H0.subgroupOf K) = Nat.card (R ⧸ idealIn R 𝔪)ˣ :=
    (Nat.card_congr (Subgroup.subgroupOfEquivOfLe hle).toEquiv).trans
      (Nat.card_congr (MonoidHom.ofInjective iotaU_injective).toEquiv).symm
  have h3 : H0.relIndex K = unitIndex R := by
    rw [show K = (redU 𝔪).range ⊔ H0 from sup_comm _ _, Subgroup.relIndex_sup_right,
      ← Subgroup.index_comap, comap_iotaU_range hR, unitIndex]
  rw [← h1, h2, h3]

/-- **The class number formula for orders** (Neukirch I (12.12)), proved: the named input `OrderClassNumberFormula` of
`OrderClassNumber.lean` holds for every pair of number fields $F\subseteq E$. -/
@[kb "neukirch1999" "Ch. I, (12.12), p. 79"]
theorem orderClassNumberFormula : OrderClassNumberFormula F E := by
  refine ⟨fun R 𝔪 hm hR => ?_⟩
  let _ : IsFractionRing R E := isFractionRing hm hR
  have : Finite (𝓞 E ⧸ 𝔪) := finite_quot hm
  have hG : Nat.card (ClassGroup R) = Nat.card (psi R).ker * classNumber E := by
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup (psi R).ker, mul_comm,
      Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective _ (psi_surjective hm hR)).toEquiv,
      classNumber, Nat.card_eq_fintype_card (α := ClassGroup (𝓞 E))]
  have hrange : Nat.card (phi R 𝔪 hR).range * Nat.card (phi R 𝔪 hR).ker = Nat.card (𝓞 E ⧸ 𝔪)ˣ := by
    rw [Subgroup.card_eq_card_quotient_mul_card_subgroup (phi R 𝔪 hR).ker,
      Nat.card_congr (QuotientGroup.quotientKerEquivRange (phi R 𝔪 hR)).toEquiv]
  rw [← range_phi_eq_ker_psi hm hR] at hG
  rw [card_ker_phi hm hR] at hrange
  rw [hG, ← hrange]
  ring

/-- **Remark 8.8, corrected, unconditional** (Hanke 2011, p. 37; *erratum*): for a quadratic extension
$E/F$, a nonzero ideal $\mathfrak f$ of $\mathcal O_F$ and the order $R = \mathcal O_F+\mathfrak f\mathcal O_E$,
$$h(R)\,[\mathcal O_E^\times : R^\times] = h(\mathcal O_E)\,N(\mathfrak f)\prod_{\mathfrak p\mid\mathfrak f}
\Bigl(1 - \frac{\chi_{E/F}(\mathfrak p)}{N\mathfrak p}\Bigr).$$
This is `remark_8_8_corrected` with its input `OrderClassNumberFormula` discharged by `orderClassNumberFormula`. -/
@[kb "hanke2011structure" "Rem. 8.8, p. 37 (corrected, unconditional)"]
theorem remark_8_8_corrected_unconditional (hdeg : finrank F E = 2) {𝔣 : Ideal (𝓞 F)} (h𝔣 : 𝔣 ≠ ⊥) :
    (Nat.card (ClassGroup (orderOf (E := E) 𝔣)) : ℚ) * unitIndex (orderOf (E := E) 𝔣) =
      classNumber E * Ideal.absNorm 𝔣 *
        ∏ 𝔭 ∈ (factors 𝔣).toFinset, (1 - (chiI E 𝔭 : ℚ) / Ideal.absNorm 𝔭) :=
  remark_8_8_corrected orderClassNumberFormula hdeg h𝔣

end

end QuadFormsKB.Hanke2011Structure.OrderCN

#print axioms QuadFormsKB.Hanke2011Structure.OrderCN.orderClassNumberFormula
#print axioms QuadFormsKB.Hanke2011Structure.OrderCN.remark_8_8_corrected_unconditional
