/-
# Hanke 2011, Lemma 2.5: the ideal $h_n$ of Hessian determinants

J. Hanke, *The structure of masses of rank n quadratic lattices of varying determinant over number fields*,
arXiv:1108.3580 (bib key `hanke2011structure`), §2.

For a quadratic form $Q(x_0,\dots,x_{n-1}) = \sum_{i\le j} c_{ij}x_ix_j$ with coefficients in a commutative ring $R$
(the repository's `QuadForm R n`), the **Hessian matrix** is $H = (\partial^2 Q/\partial x_i\partial x_j) = C + C^{\mathsf T}$
(`QuadForm.hessian`); it is symmetric with even diagonal $2c_{ii}$. Lemma 2.5 of the paper says that the ideal
$$h_n := \sum_{Q} \det H(Q)\,R$$
generated by the Hessian determinants of all $R$-valued forms in $n$ variables is $R$ when $n$ is even and $2R$ when
$n$ is odd. The paper states this for $R = \mathcal O_{\mathfrak p}$ (the completed local rings of a number field $F$,
where every lattice $L_{\mathfrak p}$ is free, so an $\mathcal O_{\mathfrak p}$-valued lattice is a form in
`QuadForm 𝒪_𝔭 n`) and takes the product over $\mathfrak p$; the argument is the same over every commutative ring,
and that is how it is stated here.

* `hessian_det_mem_span_two_of_odd`: for $n$ odd, $\det H(Q) \in 2R$. *Proof:* modulo $2$, $H \equiv C - C^{\mathsf T}$,
  an alternating matrix, whose determinant vanishes in odd dimension over every commutative ring
  (`det_sub_transpose_eq_zero_of_odd`, proved over the universal ring $\mathbb{Z}[c_{ij}]$, where
  $\det A = \det A^{\mathsf T} = \det(-A) = -\det A$ forces $\det A = 0$). The paper argues with the Leibniz formula
  instead (pairing $\sigma$ with $\sigma^{-1}$).
* `exists_hessian_det_eq`: the form $x_0x_{n-1} + x_1x_{n-2} + \cdots$ (plus $x_m^2$ for the middle index $m$ when
  $n = 2m+1$) has Hessian determinant $\pm1$ ($n$ even) or $\pm2$ ($n$ odd); its Hessian is the antidiagonal
  permutation matrix of the paper's proof (with the middle entry $2$ when $n$ is odd).
* `lemma_2_5`: $h_n = R$ for $n$ even and $h_n = 2R$ for $n$ odd (`hessianDetIdeal`).

The first assertion of Lemma 2.5, $I(\det_H(L)) \subseteq \mathcal O_F$, is the statement that the Hessian determinant
of an $\mathcal O_{\mathfrak p}$-valued form lies in $\mathcal O_{\mathfrak p}$, which holds by construction here
(`QuadForm.hessian` has entries in $R$).
-/
import Mathlib
import QuadFormsKB.Citation
import QuadFormsKB.Defs.QuadForm

namespace QuadFormsKB.Hanke2011Structure

open Matrix

variable {R : Type*} [CommRing R] {n : ℕ}

/-- **An alternating matrix of odd size has determinant $0$, over every commutative ring.** For a square matrix $C$
of odd size $n$ over a commutative ring $R$, $\det(C - C^{\mathsf T}) = 0$. -/
theorem det_sub_transpose_eq_zero_of_odd (hn : Odd n) (C : Matrix (Fin n) (Fin n) R) :
    (C - Cᵀ).det = 0 := by
  let U := MvPolynomial (Fin n × Fin n) ℤ
  let X : Matrix (Fin n) (Fin n) U := Matrix.of fun i j => MvPolynomial.X (i, j)
  have hU : (X - Xᵀ).det = 0 := by
    have h1 : (X - Xᵀ)ᵀ = -(X - Xᵀ) := by
      ext i j; simp
    have h2 := congrArg Matrix.det h1
    rw [det_transpose, det_neg, Fintype.card_fin, hn.neg_one_pow] at h2
    have h3 : (2 : U) * (X - Xᵀ).det = 0 := by linear_combination h2
    rcases mul_eq_zero.mp h3 with h | h
    · exact absurd h two_ne_zero
    · exact h
  let φ : U →+* R := MvPolynomial.eval₂Hom (Int.castRingHom R) fun ij => C ij.1 ij.2
  have hmap : φ.mapMatrix (X - Xᵀ) = C - Cᵀ := by
    ext i j
    simp only [RingHom.mapMatrix_apply, map_apply, Matrix.sub_apply, transpose_apply, of_apply, X, φ,
      map_sub]
    rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
  rw [← hmap, ← RingHom.map_det, hU, map_zero]

/-- **Lemma 2.5, odd case: the Hessian determinant is even.** For a quadratic form $Q$ in an odd number $n$ of
variables over a commutative ring $R$, $\det H(Q) \in 2R$, where $H(Q) = C + C^{\mathsf T}$ is the Hessian. -/
@[kb "hanke2011structure" "Lemma 2.5, p. 8 (odd n)"]
theorem hessian_det_mem_span_two_of_odd (hn : Odd n) (Q : QuadForm R n) :
    Q.hessian.det ∈ Ideal.span {(2 : R)} := by
  let π := Ideal.Quotient.mk (Ideal.span {(2 : R)})
  rw [← Ideal.Quotient.eq_zero_iff_mem, RingHom.map_det]
  have h : π.mapMatrix Q.hessian = π.mapMatrix (Q.coeff - Q.coeffᵀ) := by
    ext i j
    simp only [RingHom.mapMatrix_apply, map_apply]
    exact Ideal.Quotient.eq.mpr (Ideal.mem_span_singleton.mpr ⟨Q.coeff j i, by
      simp only [QuadForm.hessian, Matrix.add_apply, Matrix.sub_apply, transpose_apply]; ring⟩)
  rw [h, ← RingHom.map_det, det_sub_transpose_eq_zero_of_odd hn, map_zero]

/-- The coefficients of the form $\sum_{i < n-1-i} x_i x_{n-1-i}\ (+\,x_m^2$ if $n = 2m+1)$: $c_{ij} = 1$ if
$j = n-1-i$ and $i \le j$, and $0$ otherwise (0-based indices). -/
def antidiagCoeff (n : ℕ) : Matrix (Fin n) (Fin n) R :=
  Matrix.of fun i j => if i ≤ j ∧ j = Fin.rev i then 1 else 0

/-- The form $x_0x_{n-1} + x_1x_{n-2} + \cdots$, with $x_m^2$ added when $n = 2m+1$; for $n$ even its Hessian is the
antidiagonal permutation matrix, for $n$ odd the same with middle entry $2$. -/
def antidiagForm (n : ℕ) : QuadForm R n where
  coeff := antidiagCoeff n
  upper := by
    intro i j hij
    simp only [antidiagCoeff, of_apply]
    exact if_neg fun h => absurd h.1 (not_le.mpr hij)

theorem antidiagForm_hessian (n : ℕ) :
    (antidiagForm n : QuadForm R n).hessian =
      (Fin.revPerm.permMatrix R) * Matrix.diagonal fun j : Fin n => if Fin.rev j = j then 2 else 1 := by
  ext i j
  simp only [QuadForm.hessian, antidiagForm, antidiagCoeff, Matrix.add_apply, transpose_apply, of_apply,
    mul_diagonal, Equiv.Perm.permMatrix, PEquiv.toMatrix_apply, Equiv.toPEquiv_apply,
    Option.mem_def, Option.some.injEq, Fin.revPerm_apply]
  have hrev : ∀ a b : Fin n, a = Fin.rev b ↔ b = Fin.rev a := fun a b => by
    constructor <;> intro h <;> simp [h]
  by_cases hj : j = Fin.rev i
  · have hi : i = Fin.rev j := (hrev j i).mp hj
    subst hj
    by_cases hii : Fin.rev i = i
    · have hle : i ≤ Fin.rev i := by rw [hii]
      simp [hii]
      norm_num
    · have hne : i ≠ Fin.rev i := fun h => hii h.symm
      rcases lt_or_gt_of_ne hne with hlt | hlt
      · simp [hlt.le, not_le.mpr hlt, hne, Fin.rev_rev]
      · simp [hlt.le, not_le.mpr hlt, hne, Fin.rev_rev]
  · have hi : ¬ i = Fin.rev j := fun h => hj ((hrev i j).mp h)
    simp [hj, hi, Ne.symm hj]

/-- **The extremal forms of Lemma 2.5's proof.** For every $n$ there is an $R$-valued quadratic form $Q$ in $n$
variables with $\det H(Q) = \pm 1$ if $n$ is even and $\det H(Q) = \pm 2$ if $n$ is odd; precisely
$\det H(Q) = \operatorname{sgn}(\sigma)\cdot 2^{[n \text{ odd}]}$ for the reversal permutation $\sigma(i) = n-1-i$. -/
theorem antidiagForm_hessian_det (n : ℕ) :
    (antidiagForm n : QuadForm R n).hessian.det =
      (Equiv.Perm.sign (Fin.revPerm : Equiv.Perm (Fin n)) : R) * (if Odd n then 2 else 1) := by
  rw [antidiagForm_hessian, det_mul, det_permutation, det_diagonal]
  congr 1
  rw [Finset.prod_ite, Finset.prod_const_one, mul_one, Finset.prod_const]
  have hcard : (Finset.univ.filter fun j : Fin n => Fin.rev j = j).card = if Odd n then 1 else 0 := by
    split_ifs with hn
    · obtain ⟨m, rfl⟩ := hn
      rw [Finset.card_eq_one]
      refine ⟨⟨m, by omega⟩, ?_⟩
      ext j
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_singleton, Fin.ext_iff,
        Fin.val_rev]
      omega
    · rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
      intro j _ h
      have := congrArg Fin.val h
      rw [Fin.val_rev] at this
      exact hn ⟨j.val, by omega⟩
  rw [hcard]
  split_ifs <;> simp

/-- **The ideal $h_n$** generated by the Hessian determinants $\det H(Q)$ of all $R$-valued quadratic forms $Q$ in
$n$ variables over the commutative ring $R$ (the paper's "sum $h_n$ of all such ideals", taken over
$R = \mathcal O_{\mathfrak p}$). -/
def hessianDetIdeal (R : Type*) [CommRing R] (n : ℕ) : Ideal R :=
  Ideal.span {d | ∃ Q : QuadForm R n, Q.hessian.det = d}

/-- **Lemma 2.5** (Hanke). Let $R$ be a commutative ring (in the paper $R = \mathcal O_{\mathfrak p}$ for a prime
$\mathfrak p$ of a number field $F$) and $n \in \mathbb{N}$. The ideal $h_n$ generated by the Hessian determinants
$\det H(Q) = \det(\partial^2Q/\partial x_i\partial x_j)$ of all $R$-valued quadratic forms $Q$ in $n$ variables is
$$h_n = \begin{cases} R & n \text{ even},\\ 2R & n \text{ odd}.\end{cases}$$ -/
@[kb "hanke2011structure" "Lemma 2.5, p. 8"]
theorem lemma_2_5 (n : ℕ) :
    hessianDetIdeal R n = if Odd n then Ideal.span {(2 : R)} else ⊤ := by
  have hsign : ∀ s : ℤˣ, ((s : ℤ) : R) * ((s : ℤ) : R) = 1 := by
    intro s; rcases Int.units_eq_one_or s with rfl | rfl <;> simp
  have hdet := antidiagForm_hessian_det (R := R) n
  have hmem : (antidiagForm n : QuadForm R n).hessian.det ∈ hessianDetIdeal R n :=
    Ideal.subset_span ⟨_, rfl⟩
  split_ifs with hn
  · apply le_antisymm
    · rw [hessianDetIdeal, Ideal.span_le]
      rintro d ⟨Q, rfl⟩
      exact hessian_det_mem_span_two_of_odd hn Q
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      have h2 : (2 : R) = ((Equiv.Perm.sign (Fin.revPerm : Equiv.Perm (Fin n)) : ℤ) : R) *
          (antidiagForm n : QuadForm R n).hessian.det := by
        rw [hdet, if_pos hn, ← mul_assoc, hsign, one_mul]
      rw [SetLike.mem_coe, h2]
      exact Ideal.mul_mem_left _ _ hmem
  · rw [eq_top_iff, ← Ideal.span_singleton_one, Ideal.span_le, Set.singleton_subset_iff]
    have h1 : (1 : R) = ((Equiv.Perm.sign (Fin.revPerm : Equiv.Perm (Fin n)) : ℤ) : R) *
        (antidiagForm n : QuadForm R n).hessian.det := by
      rw [hdet, if_neg hn, mul_one, hsign]
    rw [SetLike.mem_coe, h1]
    exact Ideal.mul_mem_left _ _ hmem

end QuadFormsKB.Hanke2011Structure
