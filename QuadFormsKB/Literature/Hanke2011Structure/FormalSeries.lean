import QuadFormsKB.Literature.Hanke2011Structure.SquareclassSeries

/-!
# Paper 6, §4: formal squareclass series, Euler products, partial series, Remark 4.11

J. Hanke, *The structure of masses of rank n quadratic lattices of varying determinant over number fields*,
arXiv:1108.3580 (`hanke2011structure`), §4, pp. 14–19.

A **formal non-archimedean squareclass series** $F_{X} = \sum_S X(S)/S$, the sum over
$S \in \mathrm{SqCl}(\mathbb A_{F,f}^\times, U_f)$ of formal symbols $S$ (p. 14), is determined by its coefficient
function $X : \mathrm{SqCl}(\mathbb A_{F,f}^\times, U_f) \to K$; in Lean a formal series *is* its coefficient function (as in
`assocDirichlet`, Definition 4.12). This file formalizes:

* `localIncl` — the natural inclusion $\mathrm{SqCl}(F_{\mathfrak p}^\times,\mathcal O_{\mathfrak p}^\times) \hookrightarrow
  \mathrm{SqCl}(\mathbb A_{F,f}^\times, U_f)$ (p. 15), component $S_{\mathfrak p}$ at $\mathfrak p$ and $1$ elsewhere.
* `IsEulerFamily`, `eulerCoeff` — **Euler products** (p. 14): a family of local coefficient functions
  $X_{\mathfrak p}$ on $\mathrm{SqCl}(F_{\mathfrak p}^\times,\mathcal O_{\mathfrak p}^\times)$ that is $1$ on the unit classes for all but
  finitely many $\mathfrak p$ defines the multiplicative coefficient function $X(S) = \prod_{\mathfrak p}X_{\mathfrak p}(S_{\mathfrak p})$,
  the coefficient of $S$ in the formal product $\prod_{\mathfrak p}\sum_{S_{\mathfrak p}}X_{\mathfrak p}(S_{\mathfrak p})/S_{\mathfrak p}$;
  only finitely many factors differ from $1$ (`mulSupport_eulerCoeff_finite`, "required for the multiplicativity to
  make sense formally"), and the Euler factor at $\mathfrak p$ is recovered from $X$ (`eulerCoeff_localIncl`).
* `partialSeries3`, `partialSeries4` — **the partial series away from $\mathbb S$**, eqs. (3) and (4), p. 15, and their
  comparison `partialSeries4_eulerCoeff`: (4) equals $\prod_{\mathfrak p\in\mathbb S}X_{\mathfrak p}(1)$ times (3), so
  (3) $=$ (4) exactly when the local factors are $1$ at the trivial class of the primes of $\mathbb S$
  (`partialSeries3_eq_partialSeries4`); see the clarification below.
* `restrictSeries` — **the restriction** $F_X|_{\mathcal K}$ to a subset $\mathcal K$ (p. 15).
* `unifMonoid` — the multiplicative subset $\langle P\rangle$ generated by the uniformizing family (Theorem 4.8, p. 17);
  `exists_mem_unifMonoid` and `normalizeAdelic_mul_unifMonoid`: every $S$ with $I(S) \subseteq h_n$ lies in
  $\widetilde S\cdot\langle P\rangle$, and the cosets $\widetilde S\cdot\langle P\rangle$ of distinct normalized classes are disjoint
  (`eq_of_mem_coset`); hence `series_eq_restrict`: a series supported on $\{I(S) \subseteq h_n\}$ is, coefficientwise, the
  sum over the normalized $\widetilde S$ of its restrictions to $\widetilde S\cdot\langle P\rangle$ (the shape of Theorem 4.8; the proof
  of Theorem 4.8, p. 18).
* **Remark 4.11** (p. 19): `unifFamily`, the distinguished family $\mathfrak a = \prod\mathfrak p^{\nu_{\mathfrak p}} \mapsto
  \prod_{\mathfrak p}\pi_{\mathfrak p}^{\nu_{\mathfrak p}}$; `canonicalMap` $\lambda'_{\widetilde S}$, the paper's "canonical local" family;
  `remark_4_11_ord`, `remark_4_11_normalize` ($I(\lambda'(\mathfrak a)) = \mathfrak a$ and $\widetilde{\lambda'(\mathfrak a)} = \widetilde S$);
  `remark_4_11_mul_iff` ($\lambda'_{\widetilde S}$ is multiplicative iff $\widetilde S = \prod_{\mathfrak p}\pi_{\mathfrak p}^{\operatorname{ord}_{\mathfrak p}(h_n)}$,
  and then $\lambda'_{\widetilde S} = $ `unifFamily`); `remark_4_11_unique` (a distinguished family has constant
  $\widetilde\lambda$ iff it is `unifFamily`).

*Clarification* (eqs. (3)–(4), p. 15; proposed by the formalization): (3) drops the Euler factors
at $\mathbb S$ (it keeps only the trivial class $(\mathcal O_{\mathfrak p}^\times)^2$ there, with coefficient $1$), while (4)
restricts the full series to the $S$ with $S_{\mathfrak p}$ trivial at $\mathfrak p \in \mathbb S$, whose coefficients still contain
the factors $X_{\mathfrak p}(1)$, $\mathfrak p \in \mathbb S$. They agree when $X_{\mathfrak p}(1) = 1$ for $\mathfrak p \in \mathbb S$ (e.g.
$\mathfrak p \nmid 2$, Lemma 4.7); Theorem 4.8 uses (3) (its coefficients are $\prod_{\mathfrak p\in T\smallsetminus\mathbb S}A^*_{\mathfrak p;n}$,
`LocalMassData.theorem_4_8_global`), and e.g. $A^*_{\mathfrak p;n}(1) = 0$ at $\mathfrak p \mid 2$ for $n$ odd
($\operatorname{ord}_{\mathfrak p}(1) = 0 < \operatorname{ord}_{\mathfrak p}(2)$).

*Clarification* (Remark 4.11, p. 19; proposed by the formalization): Definition 4.9 asks a
distinguished family to be a homomorphism, so $\lambda(\mathcal O_F) = 1$. The map $\lambda'_{\widetilde S}$ of Remark 4.11 has
$I(\lambda'(\mathfrak a)) = \mathfrak a$ and constant normalization $\widetilde S$ for every normalized $\widetilde S$, but it is a homomorphism
only for the single class $\widetilde S = \prod_{\mathfrak p}\pi_{\mathfrak p}^{\operatorname{ord}_{\mathfrak p}(h_n)}$ (for which
$\lambda'(\mathfrak a) = \prod_{\mathfrak p}\pi_{\mathfrak p}^{\nu_{\mathfrak p}}$); so there is exactly **one** distinguished family with
$\widetilde\lambda$ constant, not one for each $\widetilde S$.

Indices are 0-based.
-/

namespace QuadFormsKB.Hanke2011Structure

open IsDedekindDomain NumberField
open scoped nonZeroDivisors

open Classical

noncomputable section

variable {F : Type} [Field F] [NumberField F]

/-! ### Generalities: components eventually units, inclusion of a local class -/

/-- The components of a non-archimedean squareclass are unit classes at all but finitely many primes. -/
theorem eventually_comp_mem_localUnitSqCl (S : AdelicSqCl F) :
    ∀ᶠ v in Filter.cofinite, AdelicSqCl.comp v S ∈ localUnitSqCl F v := by
  have h := (lemma_2_2 S).2
  filter_upwards [h] with v hv
  exact (lemma_2_2_apply S v) ▸ hv

open Classical in
/-- **The natural inclusion** $\mathrm{SqCl}(F_{\mathfrak p}^\times,\mathcal O_{\mathfrak p}^\times) \hookrightarrow
\mathrm{SqCl}(\mathbb A_{F,f}^\times, U_f)$ (§4, p. 15): the class with component $s$ at $\mathfrak p = v$ and $1$ elsewhere. -/
@[kb "hanke2011structure" "§4, p. 15 (the natural inclusion of local squareclasses)"]
def localIncl (v : HeightOneSpectrum (𝓞 F)) : LocalSqCl v →* AdelicSqCl F where
  toFun s := AdelicSqCl.ofLocal (Pi.mulSingle v s) (by
    refine Filter.eventually_cofinite.mpr ((Set.finite_singleton v).subset fun w hw => ?_)
    by_contra hne
    exact hw (by
      show Pi.mulSingle v s w ∈ localUnitSqCl F w
      rw [Pi.mulSingle_eq_of_ne (Set.mem_singleton_iff.not.mp hne)]; exact Subgroup.one_mem _))
  map_one' := AdelicSqCl.ext fun w => by
    rw [AdelicSqCl.comp_ofLocal, Pi.mulSingle_one, map_one]; rfl
  map_mul' s t := AdelicSqCl.ext fun w => by
    rw [map_mul, AdelicSqCl.comp_ofLocal, AdelicSqCl.comp_ofLocal, AdelicSqCl.comp_ofLocal]
    exact congrFun (Pi.mulSingle_mul v s t) w

theorem comp_localIncl (v w : HeightOneSpectrum (𝓞 F)) (s : LocalSqCl v) :
    AdelicSqCl.comp w (localIncl v s) = Pi.mulSingle v s w :=
  AdelicSqCl.comp_ofLocal _ _ w

theorem comp_localIncl_self (v : HeightOneSpectrum (𝓞 F)) (s : LocalSqCl v) :
    AdelicSqCl.comp v (localIncl v s) = s := by
  rw [comp_localIncl, Pi.mulSingle_eq_same]

theorem comp_localIncl_of_ne {v w : HeightOneSpectrum (𝓞 F)} (h : w ≠ v) (s : LocalSqCl v) :
    AdelicSqCl.comp w (localIncl v s) = 1 := by
  rw [comp_localIncl, Pi.mulSingle_eq_of_ne h]

/-! ### Euler products (p. 14) -/

section Euler

variable {K : Type*} [CommMonoid K]

variable (F) in
/-- **An Euler family** (p. 14): local coefficient functions $X_{\mathfrak p}$ on
$\mathrm{SqCl}(F_{\mathfrak p}^\times,\mathcal O_{\mathfrak p}^\times)$ that are $1$ on the unit classes $\mathrm{SqCl}(\mathcal O_{\mathfrak p}^\times)$ for all
but finitely many $\mathfrak p$ ("which is required for the multiplicativity to make sense formally"). -/
@[kb "hanke2011structure" "§4, p. 14 (Euler products: local factors trivial on unit classes almost everywhere)"]
def IsEulerFamily (X : ∀ v : HeightOneSpectrum (𝓞 F), LocalSqCl v → K) : Prop :=
  ∀ᶠ v in Filter.cofinite, ∀ s ∈ localUnitSqCl F v, X v s = 1

/-- **The coefficient of an Euler product** (p. 14): $X(S) = \prod_{\mathfrak p}X_{\mathfrak p}(S_{\mathfrak p})$, the coefficient of $S$
in $\prod_{\mathfrak p}\bigl(\sum_{S_{\mathfrak p}}X_{\mathfrak p}(S_{\mathfrak p})/S_{\mathfrak p}\bigr)$ (a finite product for an Euler family,
`mulSupport_eulerCoeff_finite`). -/
@[kb "hanke2011structure" "§4, p. 14 (Euler product)"]
def eulerCoeff (X : ∀ v : HeightOneSpectrum (𝓞 F), LocalSqCl v → K) (S : AdelicSqCl F) : K :=
  ∏ᶠ v, X v (AdelicSqCl.comp v S)

/-- **Only finitely many Euler factors are nontrivial** at a given $S$ (p. 14). -/
@[kb "hanke2011structure" "§4, p. 14 (finitely many nontrivial factors)"]
theorem mulSupport_eulerCoeff_finite {X : ∀ v : HeightOneSpectrum (𝓞 F), LocalSqCl v → K}
    (hX : IsEulerFamily F X) (S : AdelicSqCl F) :
    (Function.mulSupport fun v => X v (AdelicSqCl.comp v S)).Finite := by
  have h : ∀ᶠ v in Filter.cofinite, X v (AdelicSqCl.comp v S) = 1 := by
    filter_upwards [hX, eventually_comp_mem_localUnitSqCl S] with v hv hS
    exact hv _ hS
  exact h

/-- The Euler product as a finite product over any finite set containing the nontrivial factors. -/
theorem eulerCoeff_eq_prod {X : ∀ v : HeightOneSpectrum (𝓞 F), LocalSqCl v → K} (S : AdelicSqCl F)
    (T : Finset (HeightOneSpectrum (𝓞 F))) (hT : ∀ v ∉ T, X v (AdelicSqCl.comp v S) = 1) :
    eulerCoeff X S = ∏ v ∈ T, X v (AdelicSqCl.comp v S) := by
  unfold eulerCoeff
  refine finprod_eq_prod_of_mulSupport_subset _ fun v hv => ?_
  by_contra h
  exact hv (hT v h)

/-- **The Euler factor at $\mathfrak p$ is determined by the series** (p. 14, "$X_{\mathfrak p,\bullet}(S_{\mathfrak p})$ is defined by
the natural inclusion map"): if every local factor is $1$ at the trivial class, then
$X(\iota_{\mathfrak p}(S_{\mathfrak p})) = X_{\mathfrak p}(S_{\mathfrak p})$. -/
@[kb "hanke2011structure" "§4, p. 14-15 (the Euler factor at p)"]
theorem eulerCoeff_localIncl {X : ∀ v : HeightOneSpectrum (𝓞 F), LocalSqCl v → K} (h1 : ∀ w, X w 1 = 1)
    (v : HeightOneSpectrum (𝓞 F)) (s : LocalSqCl v) : eulerCoeff X (localIncl v s) = X v s := by
  rw [eulerCoeff_eq_prod _ {v} fun w hw => by
    rw [comp_localIncl_of_ne (Finset.notMem_singleton.mp hw), h1], Finset.prod_singleton,
    comp_localIncl_self]

/-- **Multiplicativity** of an Euler product on classes with disjoint supports of nontrivial factors: here, for the
inclusion of a local class at $\mathfrak p$ and a class trivial at $\mathfrak p$. -/
theorem eulerCoeff_localIncl_mul {X : ∀ v : HeightOneSpectrum (𝓞 F), LocalSqCl v → K} (h1 : ∀ w, X w 1 = 1)
    (hX : IsEulerFamily F X) (v : HeightOneSpectrum (𝓞 F)) (s : LocalSqCl v) (S : AdelicSqCl F)
    (hS : AdelicSqCl.comp v S = 1) : eulerCoeff X (localIncl v s * S) = X v s * eulerCoeff X S := by
  obtain ⟨T, hT⟩ := (mulSupport_eulerCoeff_finite hX S).exists_finset_coe
  have hT' : ∀ w ∉ T, X w (AdelicSqCl.comp w S) = 1 := fun w hw => by
    by_contra h
    exact hw (by rw [← Finset.mem_coe, hT]; exact h)
  have hvT : v ∉ T := fun hv => by
    have : v ∈ Function.mulSupport fun w => X w (AdelicSqCl.comp w S) := by rw [← hT]; exact hv
    exact this (by show X v (AdelicSqCl.comp v S) = 1; rw [hS, h1])
  rw [eulerCoeff_eq_prod S T hT', eulerCoeff_eq_prod _ (insert v T) fun w hw => by
      rw [Finset.mem_insert, not_or] at hw
      rw [map_mul, comp_localIncl_of_ne hw.1, one_mul, hT' w hw.2],
    Finset.prod_insert hvT, map_mul, comp_localIncl_self, hS, mul_one]
  congr 1
  refine Finset.prod_congr rfl fun w hw => ?_
  rw [map_mul, comp_localIncl_of_ne (by rintro rfl; exact hvT hw), one_mul]

end Euler

/-! ### Partial series away from $\mathbb S$ (eqs. (3), (4)) and restriction -/

section Partial

variable {K : Type*} [CommMonoidWithZero K]

open Classical in
/-- The local factor $1/(\mathcal O_{\mathfrak p}^\times)^2$ of eq. (3): coefficient $1$ at the trivial class, $0$ elsewhere. -/
def trivFactor (v : HeightOneSpectrum (𝓞 F)) (s : LocalSqCl v) : K := if s = 1 then 1 else 0

open Classical in
/-- The local factors of eq. (3): $1/(\mathcal O_{\mathfrak p}^\times)^2$ at $\mathfrak p \in \mathbb S$, $X_{\mathfrak p}$ elsewhere. -/
def awayFactors (𝕊 : Finset (HeightOneSpectrum (𝓞 F))) (X : ∀ v : HeightOneSpectrum (𝓞 F), LocalSqCl v → K)
    (v : HeightOneSpectrum (𝓞 F)) : LocalSqCl v → K :=
  if v ∈ 𝕊 then trivFactor v else X v

/-- **The partial formal squareclass series away from $\mathbb S$, eq. (3)** (p. 15):
$F^{\mathbb S}_X := \prod_{\mathfrak p\in\mathbb S}\frac{1}{(\mathcal O_{\mathfrak p}^\times)^2}\cdot\prod_{\mathfrak p\notin\mathbb S}\sum_{S_{\mathfrak p}}
\frac{X_{\mathfrak p}(S_{\mathfrak p})}{S_{\mathfrak p}}$; its coefficient at $S$ is $\prod_{\mathfrak p\notin\mathbb S}X_{\mathfrak p}(S_{\mathfrak p})$ if
$S_{\mathfrak p} = 1$ for every $\mathfrak p \in \mathbb S$, and $0$ otherwise (`partialSeries3_apply`). -/
@[kb "hanke2011structure" "§4, eq. (3), p. 15"]
def partialSeries3 (𝕊 : Finset (HeightOneSpectrum (𝓞 F))) (X : ∀ v : HeightOneSpectrum (𝓞 F), LocalSqCl v → K) :
    AdelicSqCl F → K :=
  eulerCoeff (awayFactors 𝕊 X)

open Classical in
/-- **The partial series away from $\mathbb S$, eq. (4)** (p. 15): the terms of $F_Y$ with $S_{\mathfrak p} = (\mathcal O_{\mathfrak p}^\times)^2$
for every $\mathfrak p \in \mathbb S$. -/
@[kb "hanke2011structure" "§4, eq. (4), p. 15"]
def partialSeries4 (𝕊 : Finset (HeightOneSpectrum (𝓞 F))) (Y : AdelicSqCl F → K) (S : AdelicSqCl F) : K :=
  if ∀ v ∈ 𝕊, AdelicSqCl.comp v S = 1 then Y S else 0

open Classical in
/-- **The restriction of a formal squareclass series** to a subset $\mathcal K$ (p. 15):
$F_X|_{\mathcal K} = \sum_{S\in\mathcal K}X(S)/S$. -/
@[kb "hanke2011structure" "§4, p. 15 (restriction to a subset)"]
def restrictSeries (𝒦 : Set (AdelicSqCl F)) (Y : AdelicSqCl F → K) (S : AdelicSqCl F) : K :=
  if S ∈ 𝒦 then Y S else 0

theorem awayFactors_isEulerFamily (𝕊 : Finset (HeightOneSpectrum (𝓞 F)))
    {X : ∀ v : HeightOneSpectrum (𝓞 F), LocalSqCl v → K} (hX : IsEulerFamily F X) :
    IsEulerFamily F (awayFactors 𝕊 X) := by
  have h𝕊 : ∀ᶠ v in Filter.cofinite, v ∉ 𝕊 := 𝕊.finite_toSet.eventually_cofinite_notMem
  filter_upwards [hX, h𝕊] with v hv hv𝕊 s hs
  simp only [awayFactors, if_neg hv𝕊]
  exact hv s hs

open Classical in
/-- **The coefficients of eq. (3)**: $\prod_{\mathfrak p\notin\mathbb S}X_{\mathfrak p}(S_{\mathfrak p})$ if $S$ is trivial at $\mathbb S$, else $0$. -/
theorem partialSeries3_apply (𝕊 : Finset (HeightOneSpectrum (𝓞 F)))
    (X : ∀ v : HeightOneSpectrum (𝓞 F), LocalSqCl v → K) (hX : IsEulerFamily F X) (S : AdelicSqCl F) :
    partialSeries3 𝕊 X S =
      if ∀ v ∈ 𝕊, AdelicSqCl.comp v S = 1 then ∏ᶠ v ∈ (𝕊 : Set _)ᶜ, X v (AdelicSqCl.comp v S) else 0 := by
  obtain ⟨T, hT⟩ := (mulSupport_eulerCoeff_finite hX S).exists_finset_coe
  have hT' : ∀ w ∉ T, X w (AdelicSqCl.comp w S) = 1 := fun w hw => by
    by_contra h
    exact hw (by rw [← Finset.mem_coe, hT]; exact h)
  have hout : ∀ w ∉ T ∪ 𝕊, awayFactors 𝕊 X w (AdelicSqCl.comp w S) = 1 := fun w hw => by
    rw [Finset.mem_union, not_or] at hw
    simp only [awayFactors, if_neg hw.2]
    exact hT' w hw.1
  unfold partialSeries3
  rw [eulerCoeff_eq_prod S (T ∪ 𝕊) hout]
  split_ifs with h
  · rw [finprod_mem_eq_prod_of_subset (s := (𝕊 : Set _)ᶜ) (t := T \ 𝕊) _
      (fun w hw => Finset.mem_coe.mpr (Finset.mem_sdiff.mpr ⟨by
        by_contra hwT
        exact hw.2 (hT' w hwT), hw.1⟩))
      (fun w hw => (Finset.mem_sdiff.mp (Finset.mem_coe.mp hw)).2)]
    rw [← Finset.prod_sdiff (Finset.subset_union_right (s₁ := T) (s₂ := 𝕊)), Finset.union_sdiff_right]
    have h𝕊 : ∏ w ∈ 𝕊, awayFactors 𝕊 X w (AdelicSqCl.comp w S) = 1 := Finset.prod_eq_one fun w hw => by
      simp only [awayFactors, if_pos hw, trivFactor, if_pos (h w hw)]
    rw [h𝕊, mul_one]
    refine Finset.prod_congr rfl fun w hw => ?_
    simp only [awayFactors, if_neg (Finset.mem_sdiff.mp hw).2]
  · push_neg at h
    obtain ⟨w, hw, hne⟩ := h
    refine Finset.prod_eq_zero (Finset.mem_union_right _ hw) ?_
    simp only [awayFactors, if_pos hw, trivFactor, if_neg hne]

/-- **Comparison of eqs. (3) and (4)** (p. 15): for an Euler product $Y = \prod_{\mathfrak p}X_{\mathfrak p}$, the series (4) is
$\prod_{\mathfrak p\in\mathbb S}X_{\mathfrak p}(1)$ times the series (3). -/
@[kb "hanke2011structure" "§4, eqs. (3)-(4), p. 15 (comparison)"]
theorem partialSeries4_eulerCoeff (𝕊 : Finset (HeightOneSpectrum (𝓞 F)))
    (X : ∀ v : HeightOneSpectrum (𝓞 F), LocalSqCl v → K) (hX : IsEulerFamily F X) (S : AdelicSqCl F) :
    partialSeries4 𝕊 (eulerCoeff X) S = (∏ v ∈ 𝕊, X v 1) * partialSeries3 𝕊 X S := by
  classical
  rw [partialSeries3_apply 𝕊 X hX S, partialSeries4]
  split_ifs with h
  · obtain ⟨T, hT⟩ := (mulSupport_eulerCoeff_finite hX S).exists_finset_coe
    have hT' : ∀ w ∉ T, X w (AdelicSqCl.comp w S) = 1 := fun w hw => by
      by_contra h'
      exact hw (by rw [← Finset.mem_coe, hT]; exact h')
    have h𝕊 : ∏ w ∈ 𝕊, X w (AdelicSqCl.comp w S) = ∏ w ∈ 𝕊, X w 1 :=
      Finset.prod_congr rfl fun w hw => by rw [h w hw]
    rw [eulerCoeff_eq_prod S (T ∪ 𝕊) fun w hw => hT' w (Finset.notMem_union.mp hw).1,
      ← Finset.prod_sdiff (Finset.subset_union_right (s₁ := T) (s₂ := 𝕊)), Finset.union_sdiff_right, h𝕊,
      finprod_mem_eq_prod_of_subset (s := (𝕊 : Set _)ᶜ) (t := T \ 𝕊) _
        (fun w hw => Finset.mem_coe.mpr (Finset.mem_sdiff.mpr ⟨by
          by_contra hwT
          exact hw.2 (hT' w hwT), hw.1⟩))
        (fun w hw => (Finset.mem_sdiff.mp (Finset.mem_coe.mp hw)).2), mul_comm]
  · rw [mul_zero]

/-- **Eqs. (3) and (4) agree** when the local factors at the primes of $\mathbb S$ are $1$ at the trivial class (e.g. at
$\mathfrak p \nmid 2$ for $A^*$, $B^*$, by Lemma 4.7). -/
@[kb "hanke2011structure" "§4, eqs. (3)-(4), p. 15 (equality)"]
theorem partialSeries3_eq_partialSeries4 (𝕊 : Finset (HeightOneSpectrum (𝓞 F)))
    (X : ∀ v : HeightOneSpectrum (𝓞 F), LocalSqCl v → K) (hX : IsEulerFamily F X) (h1 : ∀ v ∈ 𝕊, X v 1 = 1) :
    partialSeries3 𝕊 X = partialSeries4 𝕊 (eulerCoeff X) := by
  funext S
  rw [partialSeries4_eulerCoeff 𝕊 X hX S, Finset.prod_congr rfl h1, Finset.prod_const_one, one_mul]

end Partial

/-! ### Powers of the uniformizing classes and the multiplicative set $\langle P\rangle$ -/

section Unif

open Classical in
/-- The class $\prod_{\mathfrak p}\pi_{\mathfrak p}^{k_{\mathfrak p}}$ for an exponent vector $k$ with finite support ($1$ if the
support is infinite; this case is never used). -/
def unifPow (k : HeightOneSpectrum (𝓞 F) → ℤ) : AdelicSqCl F :=
  if h : ∀ᶠ v in Filter.cofinite, k v = 0 then
    AdelicSqCl.ofLocal (fun v => unifSqCl v ^ k v) (by
      filter_upwards [h] with v hv
      rw [hv, zpow_zero]; exact Subgroup.one_mem _)
  else 1

theorem comp_unifPow {k : HeightOneSpectrum (𝓞 F) → ℤ} (hk : ∀ᶠ v in Filter.cofinite, k v = 0)
    (v : HeightOneSpectrum (𝓞 F)) : AdelicSqCl.comp v (unifPow k) = unifSqCl v ^ k v := by
  unfold unifPow
  rw [dif_pos hk]
  exact AdelicSqCl.comp_ofLocal _ _ v

theorem adelicOrd_unifPow {k : HeightOneSpectrum (𝓞 F) → ℤ} (hk : ∀ᶠ v in Filter.cofinite, k v = 0)
    (v : HeightOneSpectrum (𝓞 F)) : adelicOrd v (unifPow k) = k v := by
  rw [adelicOrd, comp_unifPow hk, SqCl.ordZ_zpow]
  have := isUniformizing_unifSqCl v
  unfold IsUniformizing at this
  rw [this, mul_one]

theorem unifPow_add {k l : HeightOneSpectrum (𝓞 F) → ℤ} (hk : ∀ᶠ v in Filter.cofinite, k v = 0)
    (hl : ∀ᶠ v in Filter.cofinite, l v = 0) : unifPow (k + l) = unifPow k * unifPow l := by
  have hkl : ∀ᶠ v in Filter.cofinite, (k + l) v = 0 := by
    filter_upwards [hk, hl] with v h1 h2; simp [h1, h2]
  refine AdelicSqCl.ext fun v => ?_
  rw [map_mul, comp_unifPow hkl, comp_unifPow hk, comp_unifPow hl, Pi.add_apply, zpow_add]

theorem unifPow_neg {k : HeightOneSpectrum (𝓞 F) → ℤ} (hk : ∀ᶠ v in Filter.cofinite, k v = 0) :
    unifPow (-k) = (unifPow k)⁻¹ := by
  have hk' : ∀ᶠ v in Filter.cofinite, (-k) v = 0 := by
    filter_upwards [hk] with v h; simp [h]
  refine AdelicSqCl.ext fun v => ?_
  rw [map_inv, comp_unifPow hk', comp_unifPow hk, Pi.neg_apply, zpow_neg]

theorem unifPow_zero : unifPow (0 : HeightOneSpectrum (𝓞 F) → ℤ) = 1 :=
  AdelicSqCl.ext fun v => by
    rw [comp_unifPow (k := 0) (Filter.Eventually.of_forall fun _ => rfl), map_one, Pi.zero_apply, zpow_zero]

/-- **The normalization in terms of the uniformizing classes** (Definition 4.3):
$\widetilde S = S\cdot\prod_{\mathfrak p}\pi_{\mathfrak p}^{\operatorname{ord}_{\mathfrak p}(h_n) - \operatorname{ord}_{\mathfrak p}(S)}$. -/
theorem normalizeAdelic_eq_mul_unifPow (n : ℕ) (S : AdelicSqCl F) :
    normalizeAdelic n S = S * unifPow (fun v => hOrd v n - adelicOrd v S) := by
  have hk : ∀ᶠ v in Filter.cofinite, hOrd v n - adelicOrd v S = 0 := by
    have hS : ∀ᶠ v in Filter.cofinite, adelicOrd v S = 0 := by
      rw [Filter.eventually_cofinite]
      simpa [supp] using supp_finite S
    filter_upwards [hS, eventually_hOrd_eq_zero n] with v h1 h2
    rw [h1, h2, sub_self]
  refine AdelicSqCl.ext fun v => ?_
  rw [comp_normalizeAdelic, map_mul, comp_unifPow hk]
  rfl

variable (F) in
/-- **The multiplicative subset $\langle P\rangle$** of $\mathrm{SqCl}(\mathbb A_{F,f}^\times, U_f)$ generated by the uniformizing family
$P = \{\pi_{\mathfrak p}\}$ (Theorem 4.8, p. 17), each $\pi_{\mathfrak p}$ included at its own prime. -/
@[kb "hanke2011structure" "Thm. 4.8, p. 17 (the multiplicative subset ⟨P⟩)"]
def unifMonoid : Submonoid (AdelicSqCl F) :=
  Submonoid.closure (Set.range fun v : HeightOneSpectrum (𝓞 F) => localIncl v (unifSqCl v))

theorem normalizeAdelic_mul_localIncl_unif (n : ℕ) (S : AdelicSqCl F) (v : HeightOneSpectrum (𝓞 F)) :
    normalizeAdelic n (S * localIncl v (unifSqCl v)) = normalizeAdelic n S := by
  refine AdelicSqCl.ext fun w => ?_
  rw [comp_normalizeAdelic, comp_normalizeAdelic, map_mul]
  by_cases h : w = v
  · subst h
    rw [comp_localIncl_self]
    have := normalize_mul_zpow (isUniformizing_unifSqCl w) (hOrd w n) (AdelicSqCl.comp w S) 1
    rwa [zpow_one] at this
  · rw [comp_localIncl_of_ne h, mul_one]

/-- **Multiplying by an element of $\langle P\rangle$ does not change the normalization.** -/
theorem normalizeAdelic_mul_unifMonoid (n : ℕ) (S : AdelicSqCl F) {x : AdelicSqCl F} (hx : x ∈ unifMonoid F) :
    normalizeAdelic n (S * x) = normalizeAdelic n S := by
  induction hx using Submonoid.closure_induction generalizing S with
  | mem y hy =>
    obtain ⟨v, rfl⟩ := hy
    exact normalizeAdelic_mul_localIncl_unif n S v
  | one => rw [mul_one]
  | mul y z _ _ hy hz => rw [← mul_assoc, hz, hy]

/-- **The cosets $\widetilde S\cdot\langle P\rangle$ of distinct normalized classes are disjoint** (proof of Theorem 4.8,
p. 18): if $S = \widetilde T x$ with $\widetilde T$ normalized and $x \in \langle P\rangle$, then $\widetilde T = \widetilde S$. -/
@[kb "hanke2011structure" "Thm. 4.8, proof, p. 18 (disjoint cosets)"]
theorem eq_of_mem_coset (n : ℕ) {S T x : AdelicSqCl F} (hT : IsNormalizedAdelic n T) (hx : x ∈ unifMonoid F)
    (hS : S = T * x) : T = normalizeAdelic n S := by
  rw [hS, normalizeAdelic_mul_unifMonoid n T hx]
  refine AdelicSqCl.ext fun v => ?_
  rw [comp_normalizeAdelic]
  exact (normalize_of_isNormalized _ (hT v)).symm

theorem pow_localIncl_mem (v : HeightOneSpectrum (𝓞 F)) (k : ℕ) :
    localIncl v (unifSqCl v ^ k) ∈ unifMonoid F := by
  rw [map_pow]
  exact Submonoid.pow_mem _ (Submonoid.subset_closure (Set.mem_range_self v)) k

/-- An element of $\langle P\rangle$ with prescribed nonnegative exponents on a finite set. -/
theorem prod_localIncl_mem (T : Finset (HeightOneSpectrum (𝓞 F))) (k : HeightOneSpectrum (𝓞 F) → ℕ) :
    ∏ v ∈ T, localIncl v (unifSqCl v ^ k v) ∈ unifMonoid F :=
  Submonoid.prod_mem _ fun v _ => pow_localIncl_mem v (k v)

theorem comp_prod_localIncl (T : Finset (HeightOneSpectrum (𝓞 F))) (k : HeightOneSpectrum (𝓞 F) → ℕ)
    (w : HeightOneSpectrum (𝓞 F)) :
    AdelicSqCl.comp w (∏ v ∈ T, localIncl v (unifSqCl v ^ k v)) = if w ∈ T then unifSqCl w ^ k w else 1 := by
  classical
  rw [map_prod]
  split_ifs with hw
  · rw [← Finset.mul_prod_erase T _ hw, comp_localIncl_self,
      Finset.prod_eq_one fun v hv => comp_localIncl_of_ne (Finset.ne_of_mem_erase hv).symm _, mul_one]
  · exact Finset.prod_eq_one fun v hv => comp_localIncl_of_ne (by rintro rfl; exact hw hv) _

/-- **Every $S$ with $I(S) \subseteq h_n$ lies in $\widetilde S\cdot\langle P\rangle$** (proof of Theorem 4.8, p. 18: "becomes
normalized by dividing by a product of powers of the uniformizing squareclasses"). -/
@[kb "hanke2011structure" "Thm. 4.8, proof, p. 18 (S ∈ S̃·⟨P⟩)"]
theorem exists_mem_unifMonoid (n : ℕ) (S : AdelicSqCl F) (hS : ∀ v, hOrd v n ≤ adelicOrd v S) :
    ∃ x ∈ unifMonoid F, S = normalizeAdelic n S * x := by
  classical
  have hfin : {v | adelicOrd v S - hOrd v n ≠ 0}.Finite := by
    have h1 := supp_finite S
    have h2 : {v : HeightOneSpectrum (𝓞 F) | hOrd v n ≠ 0}.Finite := by
      have := eventually_hOrd_eq_zero (F := F) n
      rw [Filter.eventually_cofinite] at this
      simpa using this
    refine (h1.union h2).subset fun v hv => ?_
    by_contra h
    simp only [Set.mem_union, Set.mem_setOf_eq, supp, not_or, not_not] at h hv
    exact hv (by rw [h.1, h.2, sub_self])
  set T := hfin.toFinset
  set k : HeightOneSpectrum (𝓞 F) → ℕ := fun v => (adelicOrd v S - hOrd v n).toNat
  refine ⟨∏ v ∈ T, localIncl v (unifSqCl v ^ k v), prod_localIncl_mem T k, ?_⟩
  refine AdelicSqCl.ext fun w => ?_
  rw [map_mul, comp_normalizeAdelic, comp_prod_localIncl]
  unfold normalize
  split_ifs with hw
  · rw [mul_assoc, ← zpow_natCast, ← zpow_add]
    have : hOrd w n - SqCl.ordZ (localOrd w) (localUnits_le_ker w) (AdelicSqCl.comp w S) + (k w : ℤ) = 0 := by
      have := hS w
      simp only [k, adelicOrd] at this ⊢
      omega
    rw [this, zpow_zero, mul_one]
  · have h0 : adelicOrd w S - hOrd w n = 0 := by
      by_contra h
      exact hw (hfin.mem_toFinset.mpr h)
    have : hOrd w n - SqCl.ordZ (localOrd w) (localUnits_le_ker w) (AdelicSqCl.comp w S) = 0 := by
      simp only [adelicOrd] at h0; omega
    rw [this, zpow_zero, mul_one, mul_one]

/-- **A series supported on $\{I(S) \subseteq h_n\}$ is the sum of its restrictions to the cosets $\widetilde S\cdot\langle P\rangle$**
(the shape of Theorem 4.8, p. 17, and its proof, p. 18), coefficientwise: the coefficient at $S$ equals the coefficient
of the restriction to the coset of its own normalization $\widetilde S$, and the restriction to the coset of any other
normalized class vanishes at $S$ (`eq_of_mem_coset`). -/
@[kb "hanke2011structure" "Thm. 4.8, p. 17 (decomposition along S̃·⟨P⟩)"]
theorem series_eq_restrict {K : Type*} [CommMonoidWithZero K] (n : ℕ) (Y : AdelicSqCl F → K)
    (hY : ∀ S, Y S ≠ 0 → ∀ v, hOrd v n ≤ adelicOrd v S) (S : AdelicSqCl F) :
    Y S = restrictSeries {S' | ∃ x ∈ unifMonoid F, S' = normalizeAdelic n S * x} Y S ∧
      ∀ T, IsNormalizedAdelic n T → T ≠ normalizeAdelic n S →
        restrictSeries {S' | ∃ x ∈ unifMonoid F, S' = T * x} Y S = 0 := by
  classical
  refine ⟨?_, fun T hT hne => ?_⟩
  · unfold restrictSeries
    split_ifs with h
    · rfl
    · by_contra hne
      exact h (exists_mem_unifMonoid n S (hY S hne))
  · unfold restrictSeries
    rw [if_neg]
    rintro ⟨x, hx, hS⟩
    exact hne (eq_of_mem_coset n hT hx hS)

end Unif

/-! ### Remark 4.11: the canonical "local" distinguished family -/

section Remark411

/-- The exponent $\operatorname{ord}_{\mathfrak p}(\mathfrak a)$ vanishes at all but finitely many primes. -/
theorem eventually_idealOrd_eq_zero (a : Ideal (𝓞 F)) :
    ∀ᶠ v : HeightOneSpectrum (𝓞 F) in Filter.cofinite, idealOrd v a = 0 := by
  classical
  have hfin : {v : HeightOneSpectrum (𝓞 F) | v.asIdeal ∈ UniqueFactorizationMonoid.normalizedFactors a}.Finite := by
    refine Set.Finite.of_finite_image (f := HeightOneSpectrum.asIdeal) ?_
      (fun x _ y _ h => HeightOneSpectrum.ext h)
    refine (UniqueFactorizationMonoid.normalizedFactors a).toFinset.finite_toSet.subset ?_
    rintro _ ⟨v, hv, rfl⟩
    exact Multiset.mem_toFinset.mpr hv
  rw [Filter.eventually_cofinite]
  refine hfin.subset fun v hv => ?_
  by_contra h
  exact hv (by simp [idealOrd, Multiset.count_eq_zero_of_notMem h])

theorem idealOrd_mul (v : HeightOneSpectrum (𝓞 F)) {a b : Ideal (𝓞 F)} (ha : a ≠ 0) (hb : b ≠ 0) :
    idealOrd v (a * b) = idealOrd v a + idealOrd v b := by
  classical
  simp [idealOrd, UniqueFactorizationMonoid.normalizedFactors_mul ha hb, Multiset.count_add]

theorem idealOrd_one (v : HeightOneSpectrum (𝓞 F)) : idealOrd v (1 : Ideal (𝓞 F)) = 0 := by
  simp [idealOrd]

/-- The class $\prod_{\mathfrak p}\pi_{\mathfrak p}^{\operatorname{ord}_{\mathfrak p}(\mathfrak a)}$ of a nonzero ideal. -/
def unifIdeal (a : (Ideal (𝓞 F))⁰) : AdelicSqCl F := unifPow fun v => idealOrd v (a : Ideal (𝓞 F))

theorem unifIdeal_mul (a b : (Ideal (𝓞 F))⁰) : unifIdeal (a * b) = unifIdeal a * unifIdeal b := by
  unfold unifIdeal
  rw [← unifPow_add (eventually_idealOrd_eq_zero _) (eventually_idealOrd_eq_zero _)]
  congr 1
  funext v
  rw [Submonoid.coe_mul, Pi.add_apply,
    idealOrd_mul v (nonZeroDivisors.coe_ne_zero a) (nonZeroDivisors.coe_ne_zero b)]

variable (F) in
/-- **The distinguished family $\mathfrak a \mapsto \prod_{\mathfrak p}\pi_{\mathfrak p}^{\operatorname{ord}_{\mathfrak p}(\mathfrak a)}$** (Remark 4.11 for
$\widetilde S = \prod_{\mathfrak p}\pi_{\mathfrak p}^{\operatorname{ord}_{\mathfrak p}(h_n)}$, the only case in which $\lambda'$ is a homomorphism,
`remark_4_11_mul_iff`). -/
@[kb "hanke2011structure" "Rem. 4.11, p. 19 (the distinguished family a ↦ ∏ π_p^{ν_p})"]
def unifFamily : DistinguishedFamily F where
  toHom :=
    { toFun := unifIdeal
      map_one' := by
        unfold unifIdeal
        simp only [OneMemClass.coe_one, idealOrd_one]
        exact unifPow_zero
      map_mul' := unifIdeal_mul }
  ord_eq a v := adelicOrd_unifPow (eventually_idealOrd_eq_zero _) v

/-- The class $\prod_{\mathfrak p}\pi_{\mathfrak p}^{\operatorname{ord}_{\mathfrak p}(h_n)}$ ($= 1$ for $n$ even; $\prod_{\mathfrak p\mid2}
\pi_{\mathfrak p}^{\operatorname{ord}_{\mathfrak p}(2)}$ for $n$ odd): the normalized class $\widetilde{\lambda(\mathcal O_F)}$ of every
distinguished family. -/
def hClass (n : ℕ) : AdelicSqCl F := unifPow fun v => hOrd v n

theorem isNormalizedAdelic_hClass (n : ℕ) : IsNormalizedAdelic n (hClass (F := F) n) := fun v =>
  adelicOrd_unifPow (eventually_hOrd_eq_zero n) v

/-- **The canonical "local" family** $\lambda'_{\widetilde S,P;n}$ of Remark 4.11 (p. 19):
$\lambda'(\mathfrak a) = \prod_{\mathfrak p}\pi_{\mathfrak p}^{\nu_{\mathfrak p}}\cdot\widetilde S$ for $n$ even and
$\prod_{\mathfrak p}\pi_{\mathfrak p}^{\nu_{\mathfrak p} - \operatorname{ord}_{\mathfrak p}(2)}\cdot\widetilde S$ for $n$ odd, $\mathfrak a = \prod_{\mathfrak p}\mathfrak p^{\nu_{\mathfrak p}}$;
in both cases $\prod_{\mathfrak p}\pi_{\mathfrak p}^{\nu_{\mathfrak p} - \operatorname{ord}_{\mathfrak p}(h_n)}\cdot\widetilde S$. -/
@[kb "hanke2011structure" "Rem. 4.11, p. 19 (λ')"]
def canonicalMap (n : ℕ) (St : AdelicSqCl F) (a : (Ideal (𝓞 F))⁰) : AdelicSqCl F :=
  unifIdeal a * (hClass n)⁻¹ * St

/-- **Remark 4.11: $I(\lambda'(\mathfrak a)) = \mathfrak a$** for a normalized $\widetilde S$. -/
@[kb "hanke2011structure" "Rem. 4.11, p. 19 (I(λ'(a)) = a)"]
theorem remark_4_11_ord (n : ℕ) {St : AdelicSqCl F} (hSt : IsNormalizedAdelic n St) (a : (Ideal (𝓞 F))⁰)
    (v : HeightOneSpectrum (𝓞 F)) : adelicOrd v (canonicalMap n St a) = idealOrd v (a : Ideal (𝓞 F)) := by
  have hinv : adelicOrd v (hClass (F := F) n)⁻¹ = -hOrd v n := by
    have h := adelicOrd_mul v (hClass (F := F) n) (hClass n)⁻¹
    rw [mul_inv_cancel, isNormalizedAdelic_hClass n v] at h
    have h0 : adelicOrd v (1 : AdelicSqCl F) = 0 := by
      rw [adelicOrd, map_one]; simp [SqCl.ordZ]
    omega
  rw [canonicalMap, adelicOrd_mul, adelicOrd_mul, hinv, hSt v, unifIdeal,
    adelicOrd_unifPow (eventually_idealOrd_eq_zero _)]
  ring

/-- **Remark 4.11: $\widetilde{\lambda'(\mathfrak a)} = \widetilde S$** for every $\mathfrak a$ (the normalization of the canonical family is
constant). -/
@[kb "hanke2011structure" "Rem. 4.11, p. 19 (λ̃' is constant)"]
theorem remark_4_11_normalize (n : ℕ) {St : AdelicSqCl F} (hSt : IsNormalizedAdelic n St) (a : (Ideal (𝓞 F))⁰) :
    normalizeAdelic n (canonicalMap n St a) = St := by
  rw [normalizeAdelic_eq_mul_unifPow]
  have hk : ∀ᶠ v in Filter.cofinite, hOrd v n - adelicOrd v (canonicalMap n St a) = 0 := by
    filter_upwards [eventually_hOrd_eq_zero n, eventually_idealOrd_eq_zero (a : Ideal (𝓞 F))] with v h1 h2
    rw [remark_4_11_ord n hSt, h1, h2, sub_self]
  have e : (fun v => hOrd v n - adelicOrd v (canonicalMap n St a)) =
      (fun v => hOrd v n) + -(fun v => idealOrd v (a : Ideal (𝓞 F))) := by
    funext v; rw [remark_4_11_ord n hSt]; simp [sub_eq_add_neg]
  rw [e, unifPow_add (eventually_hOrd_eq_zero n), unifPow_neg (eventually_idealOrd_eq_zero _)]
  · show unifIdeal a * (hClass n)⁻¹ * St * (hClass n * (unifIdeal a)⁻¹) = St
    calc unifIdeal a * (hClass n)⁻¹ * St * (hClass n * (unifIdeal a)⁻¹)
        = St * (unifIdeal a * (unifIdeal a)⁻¹) * (hClass n * (hClass n)⁻¹) := by ac_rfl
      _ = St := by simp
  · filter_upwards [eventually_idealOrd_eq_zero (a : Ideal (𝓞 F))] with v h
    simp [h]

/-- **Remark 4.11: $\lambda'_{\widetilde S}$ is a homomorphism iff $\widetilde S = \prod_{\mathfrak p}\pi_{\mathfrak p}^{\operatorname{ord}_{\mathfrak p}(h_n)}$**, and
then it is `unifFamily` (*Clarification:* for every other normalized $\widetilde S$ the map $\lambda'_{\widetilde S}$ is not a
distinguished family in the sense of Definition 4.9; it fails $\lambda'(\mathcal O_F) = 1$). -/
@[kb "hanke2011structure" "Rem. 4.11, p. 19 (λ' is a homomorphism only for one S̃)"]
theorem remark_4_11_mul_iff (n : ℕ) (St : AdelicSqCl F) :
    (∀ a b : (Ideal (𝓞 F))⁰, canonicalMap n St (a * b) = canonicalMap n St a * canonicalMap n St b) ↔
      St = hClass n := by
  constructor
  · intro h
    have h1 := h 1 1
    have hu : unifIdeal (1 : (Ideal (𝓞 F))⁰) = 1 := (unifFamily F).toHom.map_one
    rw [mul_one] at h1
    unfold canonicalMap at h1
    rw [hu, one_mul] at h1
    have : (hClass (F := F) n)⁻¹ * St = 1 := by
      have h2 : (hClass (F := F) n)⁻¹ * St * ((hClass (F := F) n)⁻¹ * St) = (hClass (F := F) n)⁻¹ * St * 1 := by
        rw [mul_one]; exact h1.symm
      exact mul_left_cancel h2
    rw [inv_mul_eq_one] at this
    exact this.symm
  · rintro rfl a b
    unfold canonicalMap
    rw [unifIdeal_mul]
    simp only [inv_mul_cancel_right]

theorem canonicalMap_hClass (n : ℕ) (a : (Ideal (𝓞 F))⁰) :
    canonicalMap n (hClass n) a = (unifFamily F).toHom a := by
  unfold canonicalMap
  rw [inv_mul_cancel_right]
  rfl

/-- **Remark 4.11: the only distinguished family with constant $\widetilde\lambda$** is `unifFamily`,
$\lambda(\mathfrak a) = \prod_{\mathfrak p}\pi_{\mathfrak p}^{\operatorname{ord}_{\mathfrak p}(\mathfrak a)} = \lambda'_{\widetilde S}(\mathfrak a)$ with
$\widetilde S = \prod_{\mathfrak p}\pi_{\mathfrak p}^{\operatorname{ord}_{\mathfrak p}(h_n)}$; its constant value is that class. -/
@[kb "hanke2011structure" "Rem. 4.11, p. 19 (the only families with λ̃ constant)"]
theorem remark_4_11_unique (n : ℕ) (lam : DistinguishedFamily F) :
    (∀ a, normalizeAdelic n (lam.toHom a) = normalizeAdelic n (lam.toHom 1)) ↔
      ∀ a, lam.toHom a = (unifFamily F).toHom a := by
  have key : ∀ a, normalizeAdelic n (lam.toHom a) = lam.toHom a * hClass n * (unifIdeal a)⁻¹ := by
    intro a
    rw [normalizeAdelic_eq_mul_unifPow]
    have e : (fun v => hOrd v n - adelicOrd v (lam.toHom a)) =
        (fun v => hOrd v n) + -(fun v => idealOrd v (a : Ideal (𝓞 F))) := by
      funext v; rw [lam.ord_eq]; simp [sub_eq_add_neg]
    rw [e, unifPow_add (eventually_hOrd_eq_zero n), unifPow_neg (eventually_idealOrd_eq_zero _), mul_assoc]
    · rfl
    · filter_upwards [eventually_idealOrd_eq_zero (a : Ideal (𝓞 F))] with v h
      simp [h]
  have hu : unifIdeal (1 : (Ideal (𝓞 F))⁰) = 1 := (unifFamily F).toHom.map_one
  constructor
  · intro h a
    have h1 := h a
    rw [key, key, map_one, hu, inv_one, mul_one, one_mul] at h1
    change lam.toHom a = unifIdeal a
    calc lam.toHom a = lam.toHom a * (hClass n * (hClass n)⁻¹) * ((unifIdeal a)⁻¹ * unifIdeal a) := by simp
      _ = lam.toHom a * hClass n * (unifIdeal a)⁻¹ * (hClass n)⁻¹ * unifIdeal a := by ac_rfl
      _ = unifIdeal a := by rw [h1]; simp
  · intro h a
    rw [key, key, h, h, map_one]
    change unifIdeal a * hClass n * (unifIdeal a)⁻¹ = 1 * hClass n * (unifIdeal 1)⁻¹
    rw [hu, one_mul, inv_one, mul_one, mul_comm (unifIdeal a), mul_inv_cancel_right]

end Remark411

end

end QuadFormsKB.Hanke2011Structure
