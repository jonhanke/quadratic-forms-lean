/-
# Hanke 2011, §1.3 and §4: squareclasses, valuations and normalization

J. Hanke, *The structure of masses of rank n quadratic lattices of varying determinant over number fields*,
arXiv:1108.3580 (bib key `hanke2011structure`).

* `SqCl G H` $= G/H^2$, the group of $H$-squareclasses of an abelian group $G$ with subgroup $H$ (§1.3, p. 5);
  $\mathrm{SqCl}(G) := \mathrm{SqCl}(G,G)$, which for $G = K^\times$ is the repository's `Lattices.SqClass K`
  (`sqClTopEquivSqClass`).
* **Valuations.** Given a homomorphism $\operatorname{ord} : G \to \mathbb{Z}$ (written multiplicatively, `ord`) with
  $H \subseteq \ker\operatorname{ord}$, the valuation descends to $\mathrm{SqCl}(G,H)$ (`SqCl.ordZ`); this is the paper's
  $\operatorname{ord}_{\mathfrak p}(S_{\mathfrak p}) := \operatorname{ord}_{\mathfrak p}(\alpha)$ for $S_{\mathfrak p} = \alpha(\mathcal O_{\mathfrak p}^\times)^2$ (§1.3, p. 6). The
  model case is $G = F_{\mathfrak p}^\times$, $H = \mathcal O_{\mathfrak p}^\times$ for a prime $\mathfrak p$ of a number field $F$
  (`LocalSqCl`, `localOrd`); there the associated ideal of Definition 2.4 is $I(S_{\mathfrak p}) = \mathfrak p^{\operatorname{ord}_{\mathfrak p}(S_{\mathfrak p})}$.
* **Definitions 4.1–4.3.** A squareclass is *normalized* (for $n$) if its valuation is $e = \operatorname{ord}_{\mathfrak p}(h_n)$
  ($e = 0$ for $n$ even, $e = \operatorname{ord}_{\mathfrak p}(2)$ for $n$ odd; Lemma 2.5, `lemma_2_5`); $\pi$ is a *uniformizing
  squareclass* if $\operatorname{ord}(\pi) = 1$; the *normalized squareclass* of $S$ is
  $\widetilde S := S\cdot\pi^{\,e - \operatorname{ord}(S)}$ (`normalize`). It is normalized (`ordZ_normalize`), fixes normalized
  classes (`normalize_of_isNormalized`), and is unchanged by multiplying $S$ by powers of $\pi$ (`normalize_mul_zpow`).
* **Remark 4.10, the key identity.** If $G$ is generated by $H$ and a lift of $\pi$ (true for $F_{\mathfrak p}^\times$:
  `localOrd_gen`), then $\widetilde{S\,T^2} = \widetilde S$ for all $S, T$ (`normalize_mul_sq`). This is the local form of
  the paper's $\widetilde{\lambda(ab^2)} = \widetilde{\lambda(a)}$, which makes the map $\widetilde\lambda$ of diagram (13) well defined on
  ideal classes modulo squares.
-/
import Mathlib
import QuadFormsKB.Citation
import QuadFormsKB.Lattices.Local
import QuadFormsKB.Lattices.SpinorNorm

namespace QuadFormsKB.Hanke2011Structure

open WithZero

section General

variable (G : Type*) [CommGroup G] (H : Subgroup G)

/-- **The group of $H$-squareclasses** $\mathrm{SqCl}(G,H) := G/H^2$ of an abelian group $G$ with subgroup $H$, where
$H^2 = \{h^2 : h \in H\}$ (§1.3, p. 5). -/
@[kb "hanke2011structure" "§1.3, p. 5 (SqCl(G,H))"]
def SqCl : Type _ := G ⧸ H.map (powMonoidHom 2)

instance : CommGroup (SqCl G H) := by unfold SqCl; infer_instance

variable {G H}

/-- The class of $g \in G$ in $\mathrm{SqCl}(G,H)$. -/
def SqCl.mk : G →* SqCl G H := QuotientGroup.mk' _

theorem SqCl.mk_surjective : Function.Surjective (SqCl.mk : G → SqCl G H) :=
  QuotientGroup.mk'_surjective _

theorem SqCl.mk_sq_of_mem {h : G} (hh : h ∈ H) : (SqCl.mk (h ^ 2) : SqCl G H) = 1 :=
  (QuotientGroup.eq_one_iff _).mpr ⟨h, hh, rfl⟩

/-- **$\mathrm{SqCl}(K^\times) = \mathrm{SqCl}(K^\times, K^\times)$ is the repository's `Lattices.SqClass K`** ($K^\times$ modulo squares). -/
def sqClTopEquivSqClass (K : Type*) [Field K] : SqCl Kˣ ⊤ ≃* Lattices.SqClass K :=
  QuotientGroup.quotientMulEquivOfEq (MonoidHom.range_eq_map _).symm

section Ord

variable (ord : G →* Multiplicative ℤ) (hH : H ≤ ord.ker)

include hH in
private theorem map_le_ker : H.map (powMonoidHom 2) ≤ ord.ker := by
  rintro _ ⟨h, hh, rfl⟩
  rw [MonoidHom.mem_ker, powMonoidHom_apply, map_pow, hH hh, one_pow]

/-- **The valuation of a squareclass**, $\operatorname{ord}(S) := \operatorname{ord}(\alpha)$ for $S = \alpha H^2$, well defined because
$H \subseteq \ker\operatorname{ord}$ (§1.3, p. 6, for $G = F_{\mathfrak p}^\times$, $H = \mathcal O_{\mathfrak p}^\times$). -/
def SqCl.ordHom : SqCl G H →* Multiplicative ℤ := QuotientGroup.lift _ ord (map_le_ker ord hH)

/-- The valuation of a squareclass as an integer. -/
def SqCl.ordZ (S : SqCl G H) : ℤ := Multiplicative.toAdd (SqCl.ordHom ord hH S)

theorem SqCl.ordZ_mk (g : G) : SqCl.ordZ ord hH (SqCl.mk g) = Multiplicative.toAdd (ord g) := rfl

theorem SqCl.ordZ_mul (S T : SqCl G H) :
    SqCl.ordZ ord hH (S * T) = SqCl.ordZ ord hH S + SqCl.ordZ ord hH T := by
  simp [SqCl.ordZ, map_mul]

theorem SqCl.ordZ_zpow (S : SqCl G H) (k : ℤ) : SqCl.ordZ ord hH (S ^ k) = k * SqCl.ordZ ord hH S := by
  simp [SqCl.ordZ, map_zpow]

/-- **A uniformizing squareclass** (Definition 4.2): $\operatorname{ord}(\pi) = 1$. -/
@[kb "hanke2011structure" "Def. 4.2, p. 15"]
def IsUniformizing (π : SqCl G H) : Prop := SqCl.ordZ ord hH π = 1

/-- **A normalized squareclass** (Definition 4.1): its valuation is $e$, where $e = \operatorname{ord}_{\mathfrak p}(h_n)$ ($0$ for $n$ even,
$\operatorname{ord}_{\mathfrak p}(2)$ for $n$ odd), i.e. its associated ideal is $h_n\mathcal O_{\mathfrak p}$. -/
@[kb "hanke2011structure" "Def. 4.1, p. 15"]
def IsNormalized (e : ℤ) (S : SqCl G H) : Prop := SqCl.ordZ ord hH S = e

/-- **The normalized squareclass** $\widetilde S := S\cdot\pi^{\,e-\operatorname{ord}(S)}$ (Definition 4.3), for a uniformizing class
$\pi$ and $e = \operatorname{ord}_{\mathfrak p}(h_n)$. -/
@[kb "hanke2011structure" "Def. 4.3, p. 15"]
def normalize (π : SqCl G H) (e : ℤ) (S : SqCl G H) : SqCl G H :=
  S * π ^ (e - SqCl.ordZ ord hH S)

variable {ord hH} {π : SqCl G H}

/-- **$\widetilde S$ is normalized** (Definition 4.3: "both are normalized squareclasses in the sense of Definition 4.1"). -/
@[kb "hanke2011structure" "Def. 4.3, p. 15 (normalized)"]
theorem ordZ_normalize (hπ : IsUniformizing ord hH π) (e : ℤ) (S : SqCl G H) :
    IsNormalized ord hH e (normalize ord hH π e S) := by
  have hπ' : SqCl.ordZ ord hH π = 1 := hπ
  unfold IsNormalized normalize
  rw [SqCl.ordZ_mul, SqCl.ordZ_zpow, hπ']
  ring

theorem normalize_of_isNormalized (e : ℤ) {S : SqCl G H} (hS : IsNormalized ord hH e S) :
    normalize ord hH π e S = S := by
  have hS' : SqCl.ordZ ord hH S = e := hS
  unfold normalize; rw [hS', sub_self, zpow_zero, mul_one]

theorem normalize_mul_zpow (hπ : IsUniformizing ord hH π) (e : ℤ) (S : SqCl G H) (k : ℤ) :
    normalize ord hH π e (S * π ^ k) = normalize ord hH π e S := by
  have hπ' : SqCl.ordZ ord hH π = 1 := hπ
  unfold normalize
  rw [SqCl.ordZ_mul, SqCl.ordZ_zpow, hπ', mul_one, mul_assoc, ← zpow_add]
  congr 2; ring

/-- **Remark 4.10, local form:** if every element of $G$ is $\pi_0^k h$ with $h \in H$ for a fixed lift $\pi_0$ of the
uniformizing class $\pi$, then $\widetilde{S\,T^2} = \widetilde S$. -/
@[kb "hanke2011structure" "Rem. 4.10, p. 18-19"]
theorem normalize_mul_sq (hπ : IsUniformizing ord hH π) {π₀ : G} (hπ₀ : SqCl.mk π₀ = π)
    (hgen : ∀ g : G, ∃ k : ℤ, ∃ h ∈ H, g = π₀ ^ k * h) (e : ℤ) (S T : SqCl G H) :
    normalize ord hH π e (S * T ^ 2) = normalize ord hH π e S := by
  obtain ⟨t, rfl⟩ := SqCl.mk_surjective T
  obtain ⟨k, h, hh, rfl⟩ := hgen t
  have : (SqCl.mk (π₀ ^ k * h) : SqCl G H) ^ 2 = π ^ (2 * k) := by
    rw [← map_pow, mul_pow, map_mul, SqCl.mk_sq_of_mem hh, mul_one, ← zpow_natCast, ← zpow_mul,
      map_zpow, hπ₀]
    congr 1; push_cast; ring
  rw [this, normalize_mul_zpow hπ]

end Ord

end General

/-! ### The local squareclass group $\mathrm{SqCl}(F_{\mathfrak p}^\times, \mathcal O_{\mathfrak p}^\times)$ -/

section Local

open IsDedekindDomain NumberField

variable {F : Type*} [Field F] [NumberField F] (v : HeightOneSpectrum (𝓞 F))

/-- The unit group $\mathcal O_{\mathfrak p}^\times$ as a subgroup of $F_{\mathfrak p}^\times$. -/
noncomputable def localUnits : Subgroup (v.adicCompletion F)ˣ :=
  (Units.map (v.adicCompletionIntegers F).subtype.toMonoidHom).range

/-- **The local integral squareclass group** $\mathrm{SqCl}(F_{\mathfrak p}^\times, \mathcal O_{\mathfrak p}^\times)$ at a prime $\mathfrak p$ of
the number field $F$ (§1.3, p. 6; Lemma 2.2's local factors). -/
@[kb "hanke2011structure" "§1.3, p. 6 (SqCl(F_p^×, O_p^×))"]
abbrev LocalSqCl : Type _ := SqCl (v.adicCompletion F)ˣ (localUnits v)

/-- **The valuation $\operatorname{ord}_{\mathfrak p}$ on $F_{\mathfrak p}^\times$**: $\operatorname{ord}_{\mathfrak p}(x) = -\log v(x)$, so that a
uniformizer has valuation $1$ (Mathlib's adic valuation takes the value $e^{-1}$ on a uniformizer). -/
noncomputable def localOrd : (v.adicCompletion F)ˣ →* Multiplicative ℤ where
  toFun x := Multiplicative.ofAdd (-log (Valued.v (x : v.adicCompletion F)))
  map_one' := by simp
  map_mul' x y := by
    rw [Units.val_mul, map_mul, log_mul ((Valuation.ne_zero_iff _).mpr x.ne_zero)
      ((Valuation.ne_zero_iff _).mpr y.ne_zero)]
    simp only [neg_add, ofAdd_add]

theorem localUnits_le_ker : localUnits v ≤ (localOrd v).ker := by
  rintro _ ⟨u, rfl⟩
  rw [MonoidHom.mem_ker]
  have h1 : Valued.v ((u : v.adicCompletionIntegers F) : v.adicCompletion F) ≤ 1 := u.1.2
  have h2 : Valued.v (((u⁻¹ : (v.adicCompletionIntegers F)ˣ) : v.adicCompletionIntegers F) :
      v.adicCompletion F) ≤ 1 := (u⁻¹).1.2
  have hmul : Valued.v ((u : v.adicCompletionIntegers F) : v.adicCompletion F) *
      Valued.v (((u⁻¹ : (v.adicCompletionIntegers F)ˣ) : v.adicCompletionIntegers F) :
        v.adicCompletion F) = 1 := by
    rw [← map_mul, ← Subring.coe_mul, ← Units.val_mul, mul_inv_cancel, Units.val_one,
      Subring.coe_one, map_one]
  have hv : Valued.v ((u : v.adicCompletionIntegers F) : v.adicCompletion F) = 1 := by
    by_contra hne
    have hlt := lt_of_le_of_ne h1 hne
    have := mul_lt_one_of_lt_of_le hlt h2
    rw [hmul] at this
    exact lt_irrefl _ this
  change Multiplicative.ofAdd (-log (Valued.v _)) = 1
  simp [hv]

/-- Every $x \in F_{\mathfrak p}^\times$ is $\pi_0^k u$ with $u \in \mathcal O_{\mathfrak p}^\times$, for the uniformizer
$\pi_0$ = `Lattices.unifF` of $F$ at $\mathfrak p$ (so that Remark 4.10's key identity applies locally). -/
theorem localOrd_gen :
    ∀ x : (v.adicCompletion F)ˣ, ∃ k : ℤ, ∃ h ∈ localUnits v,
      x = (Units.mk0 (algebraMap F (v.adicCompletion F) (Lattices.unifF v))
        (by simpa using Lattices.unifF_ne_zero v)) ^ k * h := by
  intro x
  set π₀ := Units.mk0 (algebraMap F (v.adicCompletion F) (Lattices.unifF v))
    (by simpa using Lattices.unifF_ne_zero v)
  obtain ⟨k, hk⟩ := Lattices.exists_valued_eq_exp v x.ne_zero
  refine ⟨-k, π₀ ^ k * x, ?_, by group⟩
  have hval : Valued.v ((π₀ ^ k * x : (v.adicCompletion F)ˣ) : v.adicCompletion F) = 1 := by
    rw [Units.val_mul, Units.val_zpow_eq_zpow_val, map_mul, Units.val_mk0, ← map_zpow₀,
      Lattices.valued_unifF_zpow, hk, ← exp_add]
    simp
  have hinv : Valued.v (((π₀ ^ k * x)⁻¹ : (v.adicCompletion F)ˣ) : v.adicCompletion F) = 1 := by
    rw [Units.val_inv_eq_inv_val, map_inv₀, hval, inv_one]
  let u : (v.adicCompletionIntegers F)ˣ :=
    { val := ⟨_, (HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mpr hval.le⟩
      inv := ⟨_, (HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mpr hinv.le⟩
      val_inv := Subtype.ext (Units.mul_inv (π₀ ^ k * x))
      inv_val := Subtype.ext (Units.inv_mul (π₀ ^ k * x)) }
  exact ⟨u, Units.ext rfl⟩

end Local

end QuadFormsKB.Hanke2011Structure
