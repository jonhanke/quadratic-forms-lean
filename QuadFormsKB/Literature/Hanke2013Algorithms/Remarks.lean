/-
# Hanke 2013, Remarks 3.3, 4.7 and Algorithm 3.4

J. Hanke, *Algorithms for computing maximal lattices in bilinear (and quadratic) spaces over number fields*,
Contemp. Math. 587 (2013); source used: arXiv:1208.2481v3 (bib key `hanke2013algorithms`), Remark 3.3 and
Algorithm 3.4 (p. 8), Remark 4.7 (p. 17).

**Algorithm 3.4** (local–global construction of lattices; the paper refers to the constructive proof of O'Meara 81:14):
given local lattices $L'_{\mathfrak p}\subseteq F_{\mathfrak p}^n$ that agree with the localizations of one global lattice $L'$
for almost all $\mathfrak p$, there is exactly one global lattice $L$ with $L_{\mathfrak p} = L'_{\mathfrak p}$ for all $\mathfrak p$
(`algorithm_3_4`; the construction is the library's `Lattices.LocFamily.glue`, O'Meara 81:14). **Remark 3.3**: in
particular, a lattice can be changed at a finite set $S$ of primes and kept elsewhere (`remark_3_3`). Here
$V = F^n$ (coordinates), $F$ a number field.

Remark 4.7 explains why Algorithm 4.6 needs $2$ unramified: in O'Meara's language (§82E, p. 227) the norm ideal
$\mathfrak n(L)$ and the scale ideal $\mathfrak s(L)$ satisfy $2\mathfrak s(L)\subseteq\mathfrak n(L)\subseteq\mathfrak s(L)$
(`remark_4_7`, from the library's O'Meara §82E), and both containments can be strict at a prime $\mathfrak p$ with
$\mathrm{ord}_{\mathfrak p}(2) > 1$. Only the containments are formalized; the strictness claim (an existence claim for
ramified dyadic primes) and the outlook to a future algorithm are not.
-/
import QuadFormsKB.Literature.OMeara.Sec82
import QuadFormsKB.Lattices.Local
import QuadFormsKB.Citation

open QuadraticMap Submodule
open scoped Pointwise

noncomputable section

namespace QuadFormsKB.Hanke2013Algorithms

open QuadFormsKB.OMeara

variable {R : Type*} [CommRing R] {F : Type*} [Field F] [Algebra R F] [Invertible (2 : F)]
variable {V : Type*} [AddCommGroup V] [Module F V] [Module R V] [IsScalarTower R F V]
variable (Q : QuadraticForm F V)

/-- **Remark 4.7** (Hanke 2013, p. 17, citing O'Meara §82E, p. 227): for every lattice $L$,
$2\mathfrak s(L)\subseteq\mathfrak n(L)\subseteq\mathfrak s(L)$, with $\mathfrak s$ the scale (`OMeara.scale`, generated by the
values of O'Meara's bilinear form $B$, $B(x,x) = Q(x)$) and $\mathfrak n$ the norm (`OMeara.normIdeal`). -/
@[kb "hanke2013algorithms" "Remark 4.7, p. 17 (2s(L_p) ⊆ n(L_p) ⊆ s(L_p))"]
theorem remark_4_7 (L : Submodule R V) :
    (2 : F) • scale Q L ≤ normIdeal Q L ∧ normIdeal Q L ≤ scale Q L := by
  refine ⟨?_, normIdeal_le_scale Q L⟩
  rintro _ ⟨c, hc, rfl⟩
  exact two_mul_mem_normIdeal Q hc

section LocalGlobal

open NumberField IsDedekindDomain QuadFormsKB.Lattices

variable {F : Type*} [Field F] [NumberField F] {n : ℕ}

/-- **Algorithm 3.4** (Hanke 2013, p. 8, via O'Meara 81:14): local lattices $M_{\mathfrak p}\subseteq F_{\mathfrak p}^n$ (for all
non-zero primes $\mathfrak p$) with $M_{\mathfrak p} = L'_{\mathfrak p}$ for all but finitely many $\mathfrak p$, for a fixed global
lattice $L'$, are the localizations of exactly one global lattice $L$. The algorithm is the gluing
$L = \{x : x\in M_{\mathfrak p}\text{ for all }\mathfrak p\}$ (`LocFamily.glue`). -/
@[kb "hanke2013algorithms" "Algorithm 3.4, p. 8 (local–global construction of lattices, O'Meara 81:14)"]
theorem algorithm_3_4 (M : ∀ w : HeightOneSpectrum (𝓞 F), Submodule (w.adicCompletionIntegers F) (Fin n → w.adicCompletion F))
    (hM : ∀ w, (M w).IsLattice (w.adicCompletion F)) {L' : Submodule (𝓞 F) (Fin n → F)} (hL' : L'.IsLattice F)
    (hcompat : ∀ᶠ w in Filter.cofinite, M w = loc w L') :
    ∃! L : Submodule (𝓞 F) (Fin n → F), L.IsLattice F ∧ ∀ v, loc v L = M v :=
  LocFamily.existsUnique_loc_eq
    { M := M
      isLattice := hM
      eventually_std := by
        filter_upwards [hcompat, loc_eventually_std hL'] with w h1 h2
        rw [h1, h2] }

open Classical in
/-- **Remark 3.3** (Hanke 2013, p. 8): for a global lattice $L$, a finite set $S$ of primes and local lattices $L'_{\mathfrak p}$
($\mathfrak p\in S$), there is exactly one global lattice $L''$ with $L''_{\mathfrak p} = L'_{\mathfrak p}$ for $\mathfrak p\in S$ and
$L''_{\mathfrak p} = L_{\mathfrak p}$ for $\mathfrak p\notin S$ (by Algorithm 3.4). -/
@[kb "hanke2013algorithms" "Remark 3.3, p. 8 (changing a lattice at finitely many primes)"]
theorem remark_3_3 {L : Submodule (𝓞 F) (Fin n → F)} (hL : L.IsLattice F) (S : Set (HeightOneSpectrum (𝓞 F)))
    (hS : S.Finite)
    (N : ∀ w : HeightOneSpectrum (𝓞 F), Submodule (w.adicCompletionIntegers F) (Fin n → w.adicCompletion F))
    (hN : ∀ w ∈ S, (N w).IsLattice (w.adicCompletion F)) :
    ∃! L'' : Submodule (𝓞 F) (Fin n → F), L''.IsLattice F ∧ ∀ v, loc v L'' = if v ∈ S then N v else loc v L := by
  refine algorithm_3_4 (fun w => if w ∈ S then N w else loc w L) (fun w => ?_) hL ?_
  · by_cases hw : w ∈ S
    · simp only [hw, ite_true]; exact hN w hw
    · simp only [hw, ite_false]; exact loc_isLattice w hL
  · filter_upwards [hS.eventually_cofinite_notMem] with w hw
    simp [hw]

end LocalGlobal

end QuadFormsKB.Hanke2013Algorithms
