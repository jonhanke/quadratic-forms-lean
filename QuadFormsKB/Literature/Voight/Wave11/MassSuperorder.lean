/-
# Proposition 26.6.4: the mass of a suborder at one place (Voight)

Source: J. Voight, *Quaternion Algebras*, Graduate Texts in Mathematics 288, Springer 2021 (key `voight2021`): Proposition 26.6.4 (p. 445), with
the local-global dictionary for lattices (Theorem 9.4.9) and the class set of an order (17.1, Definition 26.1.4).

**Setting.** $F$ a totally real number field, $R = \mathbb Z_F$, $B = (a,b)_F$ = `QuatF F a b` totally definite,
$\mathcal O \subseteq \mathcal O'$ orders of $B$ with $\mathcal O_{\mathfrak q} = \mathcal O'_{\mathfrak q}$ for every prime
$\mathfrak q \ne \mathfrak p$. The class set $\operatorname{Cls}\mathcal O$ = `ClsO O` is the set of classes $[J]$ of nonzero
locally principal left ideals $J \subseteq \mathcal O$ under $J \sim J\beta$, and
$\operatorname{mass}(\operatorname{Cls}\mathcal O) = \sum_{[J]}[\Gamma_J : R^\times]^{-1}$ = `clsMass O`, with
$\Gamma_J = \{\gamma \in B^\times : J\gamma = J\}$ the unit group of the right order of $J$ (left and right are exchanged
with respect to the book, as everywhere in the library; see `Voight.classMass`).

**Proof** (Voight's proof of 26.6.4, written out).
1. *Extension.* $J \mapsto \mathcal O'J$ (`extIdeal`) sends nonzero locally principal left $\mathcal O$-ideals to nonzero locally
   principal left $\mathcal O'$-ideals, since $(\mathcal O'J)_v = \mathcal O'_v\alpha_v$ when $J_v = \mathcal O_v\alpha_v$
   (`idealSet_localIdeal_extIdeal`), and commutes with $J \mapsto J\beta$. This gives the class map
   $\Phi : \operatorname{Cls}\mathcal O \to \operatorname{Cls}\mathcal O'$ (`clsMap`).
2. *Fibres.* Fix a class of $\operatorname{Cls}\mathcal O'$ and a representative $D$ with $D \subseteq \mathcal O$ (multiply by
   a suitable $m \in R$, `exists_deep`). The fibre of $\Phi$ over $[D]$ is the set of orbits of $\Gamma_D$ on
   $X(D) = \{J : \mathcal O'J = D\}$ (`fibreEquiv`), and the stabilizer of $J$ is $\Gamma_J \le \Gamma_D$.
3. *Local count.* With $D_{\mathfrak p} = \mathcal O'_{\mathfrak p}\alpha'$, the map
   $u \mapsto$ (the ideal with completions $D_v$ at $v \ne \mathfrak p$ and $\mathcal O_{\mathfrak p}u\alpha'$ at $\mathfrak p$)
   induces a bijection $\mathcal O^\times_{\mathfrak p}\backslash\mathcal O'^\times_{\mathfrak p} \simeq X(D)$ (gluing of ideals,
   `Gen.localIdeal_globalIdeal`; uniqueness, `Gen.le_of_localIdeal_le`), so
   $\#X(D) = [\mathcal O'^\times_{\mathfrak p} : \mathcal O^\times_{\mathfrak p}]$ (`card_X`), which is finite (`localUnitIndex_ne_zero`).
4. *Orbit-stabilizer.* $\sum_{[J] \in \Phi^{-1}[D]}[\Gamma_J : R^\times]^{-1}
   = \sum_{\text{orbits}}[\Gamma_D : \Gamma_J][\Gamma_D : R^\times]^{-1} = \#X(D)\,[\Gamma_D : R^\times]^{-1}$, and summing over
   $\operatorname{Cls}\mathcal O'$ gives the proposition (`massSuperorder`).

**Contents.** `massSuperorder : Wave6.MassSuperorder F` for every number field $F$ (proved, standard axioms), hence also
`Wave3.MassSuborderOnePlace F`.
-/
import QuadFormsKB.Literature.Voight.Wave10.MaximalMass
import QuadFormsKB.Literature.Voight.Wave5.EmbeddingCount
import QuadFormsKB.Literature.Voight.Wave3.Statements
import QuadFormsKB.Tamagawa.TernaryGlueNF

set_option linter.unusedSectionVars false

open NumberField IsDedekindDomain Quaternion

noncomputable section

namespace QuadFormsKB.Voight.Wave11

open QuadFormsKB.Quat QuadFormsKB.QuatOrder QuadFormsKB.Voight QuadFormsKB.Voight.Wave4 QuadFormsKB.Voight.Wave9
  QuadFormsKB.Lattices QuadFormsKB.LocalDensity.NF QuadFormsKB.Tamagawa

variable {F : Type} [Field F] [NumberField F] {a b : 𝓞 F}

/-! ### Extension of left ideals from $\mathcal O$ to $\mathcal O' \supseteq \mathcal O$ -/

section Ext

variable {O O' : Subalgebra (𝓞 F) (QuatF F a b)}

/-- **The extended ideal** $\mathcal O'J$: the left ideal of $\mathcal O'$ generated by a left ideal $J$ of
$\mathcal O \subseteq \mathcal O'$. -/
def extIdeal (h : O ≤ O') (J : Ideal O) : Ideal O' :=
  Ideal.span ((Subalgebra.inclusion h) '' (J : Set O))

theorem idealSet_subset_extIdeal (h : O ≤ O') (J : Ideal O) : idealSet J ⊆ idealSet (extIdeal h J) := by
  rintro x ⟨hx, hJ⟩
  exact ⟨h hx, Ideal.subset_span ⟨⟨x, hx⟩, hJ, rfl⟩⟩

theorem extIdeal_le (h : O ≤ O') {J : Ideal O} {J' : Ideal O'} (hJ : idealSet J ⊆ idealSet J') :
    extIdeal h J ≤ J' := by
  refine Ideal.span_le.2 ?_
  rintro _ ⟨x, hx, rfl⟩
  exact coe_mem_idealSet.1 (hJ (coe_mem_idealSet.2 hx))

theorem extIdeal_rTrans_subset (h : O ≤ O') {J J₂ : Ideal O} {β : QuatF F a b}
    (hβ : idealSet J₂ = rTrans (idealSet J) β) :
    idealSet (extIdeal h J₂) ⊆ rTrans (idealSet (extIdeal h J)) β := by
  rintro y ⟨hy, hspan⟩
  have key : ∀ z : O', z ∈ extIdeal h J₂ → (z : QuatF F a b) ∈ rTrans (idealSet (extIdeal h J)) β := by
    intro z hz
    induction hz using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨x, hx, rfl⟩ := hx
      have : (x : QuatF F a b) ∈ rTrans (idealSet J) β := hβ ▸ coe_mem_idealSet.2 hx
      obtain ⟨w, hw, hwx⟩ := this
      exact ⟨w, idealSet_subset_extIdeal h J hw, hwx⟩
    | zero => exact ⟨0, zero_mem_idealSet _, by simp⟩
    | add x y _ _ hx hy =>
      obtain ⟨w, hw, hwx⟩ := hx
      obtain ⟨w', hw', hwy⟩ := hy
      refine ⟨w + w', add_mem_idealSet hw hw', ?_⟩
      simp only at hwx hwy ⊢
      rw [Subalgebra.coe_add, ← hwx, ← hwy, add_mul]
    | smul c x _ hx =>
      obtain ⟨w, hw, hwx⟩ := hx
      refine ⟨(c : QuatF F a b) * w, mul_mem_idealSet c.2 hw, ?_⟩
      simp only at hwx ⊢
      rw [smul_eq_mul, Subalgebra.coe_mul, ← hwx, mul_assoc]
  exact key ⟨y, hy⟩ hspan

/-- **Extension commutes with right translation**: $\mathcal O'(J\beta) = (\mathcal O'J)\beta$. -/
theorem idealSet_extIdeal_rTrans (h : O ≤ O') {J J₂ : Ideal O} {β : (QuatF F a b)ˣ}
    (hβ : idealSet J₂ = rTrans (idealSet J) β) :
    idealSet (extIdeal h J₂) = rTrans (idealSet (extIdeal h J)) β := by
  refine le_antisymm (extIdeal_rTrans_subset h hβ) ?_
  have hβ' : idealSet J = rTrans (idealSet J₂) ((β⁻¹ : (QuatF F a b)ˣ) : QuatF F a b) := by
    rw [hβ, rTrans_rTrans, Units.mul_inv, rTrans_one]
  have := extIdeal_rTrans_subset h hβ'
  intro y hy
  obtain ⟨z, hz, rfl⟩ := hy
  obtain ⟨w, hw, rfl⟩ := this hz
  simpa [mul_assoc] using hw

theorem idealRel_extIdeal (h : O ≤ O') {J J₂ : Ideal O} (hr : IdealRel J J₂) :
    IdealRel (extIdeal h J) (extIdeal h J₂) := by
  obtain ⟨β, hβ⟩ := hr
  exact ⟨β, idealSet_extIdeal_rTrans h hβ⟩

theorem extIdeal_ne_bot (h : O ≤ O') {J : Ideal O} (hJ : J ≠ ⊥) : extIdeal h J ≠ ⊥ := by
  obtain ⟨x, hxJ, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hJ
  intro hb
  have := idealSet_subset_extIdeal h J (coe_mem_idealSet.2 hxJ)
  obtain ⟨h1, h2⟩ := this
  rw [hb, Ideal.mem_bot] at h2
  have h3 : (x : QuatF F a b) = 0 := congrArg Subtype.val h2
  exact hx0 (Subtype.ext h3)

theorem idealRel_ne_bot {O : Subalgebra (𝓞 F) (QuatF F a b)} {J J₂ : Ideal O} (hr : IdealRel J J₂) (hJ : J ≠ ⊥) :
    J₂ ≠ ⊥ := by
  obtain ⟨β, hβ⟩ := hr
  obtain ⟨x, hxJ, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hJ
  intro hb
  have hmem : (x : QuatF F a b) * β ∈ idealSet J₂ := by rw [hβ]; exact ⟨x, coe_mem_idealSet.2 hxJ, rfl⟩
  obtain ⟨h1, h2⟩ := hmem
  rw [hb, Ideal.mem_bot] at h2
  have h3 : (x : QuatF F a b) * β = 0 := congrArg Subtype.val h2
  rw [Units.mul_left_eq_zero] at h3
  exact hx0 (Subtype.ext h3)

end Ext

/-! ### Completions of the extended ideal -/

section Local

variable {O O' : Subalgebra (𝓞 F) (QuatF F a b)} (v : HeightOneSpectrum (𝓞 F))

local notation "𝔬" => v.adicCompletionIntegers F

/-- The right translate $\Lambda\alpha$ of an $\mathfrak o_v$-order, as an $\mathfrak o_v$-submodule. -/
def rTransSubV (Λ : Subalgebra 𝔬 (QuatV v a b)) (α : QuatV v a b) : Submodule 𝔬 (QuatV v a b) :=
  (Subalgebra.toSubmodule Λ).map (LinearMap.mulRight 𝔬 α)

theorem coe_rTransSubV (Λ : Subalgebra 𝔬 (QuatV v a b)) (α : QuatV v a b) :
    (rTransSubV v Λ α : Set (QuatV v a b)) = rTrans (Λ : Set (QuatV v a b)) α := by
  ext y
  constructor
  · rintro ⟨z, hz, rfl⟩; exact ⟨z, hz, rfl⟩
  · rintro ⟨z, hz, rfl⟩; exact ⟨z, hz, rfl⟩

theorem idealImage_subset_extIdeal (h : O ≤ O') (J : Ideal O) :
    idealImage (v := v) J ⊆ idealImage (v := v) (extIdeal h J) := by
  rintro _ ⟨x, hx, rfl⟩
  exact ⟨Subalgebra.inclusion h x, Ideal.subset_span ⟨x, hx, rfl⟩, rfl⟩

/-- **Completion of the extended ideal**: if $J_v = \mathcal O_v\alpha$ then $(\mathcal O'J)_v = \mathcal O'_v\alpha$. -/
theorem idealSet_localIdeal_extIdeal (h : O ≤ O') {J : Ideal O} {α : QuatV v a b}
    (hJ : idealSet (localIdeal (v := v) J) = rTrans (localOrder (v := v) a b O : Set (QuatV v a b)) α) :
    idealSet (localIdeal (v := v) (extIdeal h J)) = rTrans (localOrder (v := v) a b O' : Set (QuatV v a b)) α := by
  have hmono := Wave6.localOrder_mono v h
  erw [idealSet_localIdeal_eq_span v] at hJ
  erw [idealSet_localIdeal_eq_span v]
  apply le_antisymm
  · rw [← coe_rTransSubV]
    refine Submodule.span_le.2 ?_
    rintro _ ⟨x, hx, rfl⟩
    rw [coe_rTransSubV]
    have key : ∀ z : O', z ∈ extIdeal h J →
        complHom v a b (z : QuatF F a b) ∈ rTrans (localOrder (v := v) a b O' : Set (QuatV v a b)) α := by
      intro z hz
      induction hz using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨x, hx, rfl⟩ := hx
        have : complHom v a b (x : QuatF F a b) ∈ rTrans (localOrder (v := v) a b O : Set (QuatV v a b)) α := by
          rw [← hJ]; exact Submodule.subset_span ⟨x, hx, rfl⟩
        obtain ⟨o, ho, hox⟩ := this
        exact ⟨o, hmono ho, hox⟩
      | zero =>
        refine ⟨0, Subalgebra.zero_mem _, ?_⟩
        simp only
        rw [zero_mul, ZeroMemClass.coe_zero, map_zero]
      | add x y _ _ hx hy =>
        obtain ⟨w, hw, hwx⟩ := hx
        obtain ⟨w', hw', hwy⟩ := hy
        refine ⟨w + w', Subalgebra.add_mem _ hw hw', ?_⟩
        simp only at hwx hwy ⊢
        rw [Subalgebra.coe_add, map_add, ← hwx, ← hwy, add_mul]
      | smul c x _ hx =>
        obtain ⟨w, hw, hwx⟩ := hx
        refine ⟨complHom v a b (c : QuatF F a b) * w,
          Subalgebra.mul_mem _ (mem_localOrder_of_mem a b c.2) hw, ?_⟩
        simp only at hwx ⊢
        rw [smul_eq_mul, Subalgebra.coe_mul, map_mul, ← hwx, mul_assoc]
    exact key x hx
  · rintro _ ⟨o, ho, rfl⟩
    have hα : α ∈ (Submodule.span 𝔬 (idealImage (v := v) J) : Set (QuatV v a b)) := by
      rw [hJ]; exact ⟨1, Subalgebra.one_mem _, one_mul _⟩
    have hα' : α ∈ idealSet (localIdeal (v := v) (extIdeal h J)) := by
      erw [idealSet_localIdeal_eq_span v]
      exact Submodule.span_mono (idealImage_subset_extIdeal v h J) hα
    have := mul_mem_idealSet ho hα'
    erw [idealSet_localIdeal_eq_span v] at this
    exact this

theorem isLocPrincipal_extIdeal (h : O ≤ O') {J : Ideal O} (hJ : IsLocPrincipal J) :
    IsLocPrincipal (extIdeal h J) := by
  intro v
  obtain ⟨α, hα⟩ := hJ v
  exact ⟨α, idealSet_localIdeal_extIdeal v h hα⟩

end Local

/-! ### The class map $\operatorname{Cls}\mathcal O \to \operatorname{Cls}\mathcal O'$ and the weights -/

section ClassMap

variable {O O' : Subalgebra (𝓞 F) (QuatF F a b)}

/-- Nonzero and locally principal. -/
abbrev Good (J : Ideal O) : Prop := J ≠ ⊥ ∧ IsLocPrincipal J

theorem Good.of_idealRel {J J₂ : Ideal O} (hr : IdealRel J J₂) (hJ : Good J) : Good J₂ :=
  ⟨idealRel_ne_bot hr hJ.1, Wave7.IsLocPrincipal.of_idealRel hr hJ.2⟩

theorem idealRel_out_mk (J : Ideal O) : IdealRel J (Quotient.mk (idealSetoid O) J).out :=
  IdealRel.symm (Quotient.mk_out (s := idealSetoid O) J)

/-- The class of a good ideal, as an element of $\operatorname{Cls}\mathcal O$. -/
def clsOf (J : Ideal O) (hJ : Good J) : ClsO O :=
  ⟨Quotient.mk (idealSetoid O) J, Good.of_idealRel (idealRel_out_mk J) hJ⟩

theorem clsOf_eq_iff {J J₂ : Ideal O} (hJ : Good J) (hJ₂ : Good J₂) : clsOf J hJ = clsOf J₂ hJ₂ ↔ IdealRel J J₂ := by
  constructor
  · intro he
    exact Quotient.exact (congrArg Subtype.val he)
  · intro hr
    exact Subtype.ext (Quotient.sound hr)

theorem clsOf_out (c : ClsO O) : clsOf c.1.out c.2 = c :=
  Subtype.ext (Quotient.out_eq c.1)

/-- **The class map** $[J] \mapsto [\mathcal O'J]$. -/
def clsMap (h : O ≤ O') (c : ClsO O) : ClsO O' :=
  clsOf (extIdeal h c.1.out) ⟨extIdeal_ne_bot h c.2.1, isLocPrincipal_extIdeal h c.2.2⟩

theorem clsMap_clsOf (h : O ≤ O') {J : Ideal O} (hJ : Good J) :
    clsMap h (clsOf J hJ) = clsOf (extIdeal h J) ⟨extIdeal_ne_bot h hJ.1, isLocPrincipal_extIdeal h hJ.2⟩ := by
  exact (clsOf_eq_iff _ _).2 (idealRel_extIdeal h (idealRel_out_mk J)).symm

/-- The weight $[\Gamma_J : R^\times]$. -/
abbrev wt (J : Ideal O) : ℕ := (centralUnitsIn (R := 𝓞 F) J).index

theorem wt_eq_relIndex (J : Ideal O) : wt J = (centralUnits (𝓞 F) (algebraMap (𝓞 F) F a) (algebraMap (𝓞 F) F b)).relIndex (rStab J) := rfl

theorem rStab_eq_map {J J₂ : Ideal O} {β : (QuatF F a b)ˣ} (hβ : idealSet J₂ = rTrans (idealSet J) β) :
    rStab J₂ = (rStab J).map (MulAut.conj β⁻¹).toMonoidHom := by
  ext γ
  rw [Subgroup.mem_map]
  constructor
  · intro hγ
    refine ⟨β * γ * β⁻¹, ?_, by simp [MulAut.conj_apply, mul_assoc]⟩
    rw [mem_rStab] at hγ ⊢
    have hβ' : idealSet J = rTrans (idealSet J₂) ((β⁻¹ : (QuatF F a b)ˣ) : QuatF F a b) := by
      rw [hβ, rTrans_rTrans, Units.mul_inv, rTrans_one]
    rw [hβ', rTrans_rTrans]
    have : ((β⁻¹ : (QuatF F a b)ˣ) : QuatF F a b) * ((β * γ * β⁻¹ : (QuatF F a b)ˣ) : QuatF F a b) =
        (γ : QuatF F a b) * ((β⁻¹ : (QuatF F a b)ˣ) : QuatF F a b) := by
      simp only [Units.val_mul, ← mul_assoc, Units.inv_mul, one_mul]
    rw [this, ← rTrans_rTrans, hγ]
  · rintro ⟨δ, hδ, rfl⟩
    rw [mem_rStab] at hδ ⊢
    have : ((MulAut.conj β⁻¹).toMonoidHom δ : QuatF F a b) =
        ((β⁻¹ : (QuatF F a b)ˣ) : QuatF F a b) * δ * β := by
      simp [MulAut.conj_apply]
    rw [this, hβ, rTrans_rTrans, ← mul_assoc, ← mul_assoc, Units.mul_inv, one_mul, ← rTrans_rTrans, hδ]

theorem centralUnits_map_conj (β : (QuatF F a b)ˣ) :
    (centralUnits (𝓞 F) (algebraMap (𝓞 F) F a) (algebraMap (𝓞 F) F b)).map (MulAut.conj β⁻¹).toMonoidHom =
      centralUnits (𝓞 F) (algebraMap (𝓞 F) F a) (algebraMap (𝓞 F) F b) := by
  ext γ
  rw [Subgroup.mem_map]
  constructor
  · rintro ⟨δ, ⟨u, rfl⟩, rfl⟩
    refine ⟨u, Units.ext ?_⟩
    simp only [MulEquiv.toMonoidHom_eq_coe, MonoidHom.coe_ofClass, MulAut.conj_apply, Units.val_mul]
    simp only [RingHom.toMonoidHom_eq_coe, Units.coe_map, MonoidHom.coe_ofClass]
    rw [← Algebra.commutes, mul_assoc, Units.mul_inv, mul_one]
  · rintro ⟨u, rfl⟩
    refine ⟨Units.map (algebraMap (𝓞 F) (QuatF F a b)).toMonoidHom u, ⟨u, rfl⟩, Units.ext ?_⟩
    simp only [MulEquiv.toMonoidHom_eq_coe, MonoidHom.coe_ofClass, MulAut.conj_apply, Units.val_mul]
    simp only [RingHom.toMonoidHom_eq_coe, Units.coe_map, MonoidHom.coe_ofClass]
    rw [← Algebra.commutes, mul_assoc, Units.mul_inv, mul_one]

/-- **The weight is a class invariant**: $[\Gamma_{J\beta} : R^\times] = [\Gamma_J : R^\times]$. -/
theorem wt_eq_of_idealRel {J J₂ : Ideal O} (hr : IdealRel J J₂) : wt J₂ = wt J := by
  obtain ⟨β, hβ⟩ := hr
  rw [wt_eq_relIndex, wt_eq_relIndex, rStab_eq_map hβ]
  conv_lhs => rw [← centralUnits_map_conj β]
  exact Subgroup.relIndex_map_map_of_injective _ _ (MulEquiv.injective _)

end ClassMap

/-! ### Scalars in ideals and in the conductor of $\mathcal O \subseteq \mathcal O'$ -/

section Scalars

variable {O O' : Subalgebra (𝓞 F) (QuatF F a b)}

/-- A nonzero left ideal of an order of a totally definite algebra contains a nonzero scalar ($\operatorname{nrd}x = \bar xx$). -/
theorem exists_scalar_mem [IsTotallyReal F] (hdef : IsTotDefinite a b) (hO : IsOrder (𝓞 F) F O) {J : Ideal O}
    (hJ : J ≠ ⊥) : ∃ n : 𝓞 F, n ≠ 0 ∧ algebraMap (𝓞 F) O n ∈ J := by
  obtain ⟨x, hxJ, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hJ
  have hx0' : (x : QuatF F a b) ≠ 0 := fun h => hx0 (Subtype.ext h)
  have hn : nrd (x : QuatF F a b) ≠ 0 := fun h => hx0' (eq_zero_of_nrd_eq_zero hdef h)
  obtain ⟨r, hr⟩ := (isInteger_trd_nrd hO x.2).2
  refine ⟨r, ?_, algebraMap_mem_of_mem_leftNrdIdeal hO J (Ideal.subset_span ⟨x, hxJ, hr⟩)⟩
  rintro rfl
  apply hn
  rw [← hr, map_zero]

theorem algebraMap_ne_zero {n : 𝓞 F} (hn : n ≠ 0) : algebraMap (𝓞 F) O n ≠ 0 := by
  intro h
  have h1 : ((algebraMap (𝓞 F) O n : O) : QuatF F a b) = 0 := by rw [h]; rfl
  rw [Subalgebra.coe_algebraMap, IsScalarTower.algebraMap_apply (𝓞 F) F (QuatF F a b)] at h1
  have h2 : algebraMap (𝓞 F) F n = 0 := (algebraMap F (QuatF F a b)).injective (h1.trans (map_zero _).symm)
  exact hn ((map_eq_zero_iff _ (IsFractionRing.injective (𝓞 F) F)).1 h2)

/-- Every quaternion has a nonzero multiple in an order (no class number hypothesis). -/
theorem exists_mul_mem_order (hO : IsOrder (𝓞 F) F O) (z : QuatF F a b) :
    ∃ n : 𝓞 F, n ≠ 0 ∧ algebraMap (𝓞 F) F n • z ∈ O := by
  have hz : z ∈ Submodule.span F (O : Set (QuatF F a b)) := hO.span ▸ Submodule.mem_top
  induction hz using Submodule.span_induction with
  | mem y hy => exact ⟨1, one_ne_zero, by rw [map_one, one_smul]; exact hy⟩
  | zero => exact ⟨1, one_ne_zero, by rw [smul_zero]; exact O.zero_mem⟩
  | add y w _ _ hy hw =>
    obtain ⟨n, hn, hny⟩ := hy; obtain ⟨m, hm, hmw⟩ := hw
    refine ⟨n * m, mul_ne_zero hn hm, ?_⟩
    rw [smul_add, map_mul]
    refine O.add_mem ?_ ?_
    · rw [mul_comm, mul_smul, algebraMap_smul F m]
      exact O.smul_mem hny m
    · rw [mul_smul, algebraMap_smul F n]
      exact O.smul_mem hmw n
  | smul c y _ hy =>
    obtain ⟨n, hn, hny⟩ := hy
    obtain ⟨p, q, hq, rfl⟩ := IsFractionRing.div_surjective (A := 𝓞 F) c
    have hq0 : q ≠ 0 := nonZeroDivisors.ne_zero hq
    refine ⟨q * n, mul_ne_zero hq0 hn, ?_⟩
    have hqF : algebraMap (𝓞 F) F q ≠ 0 := (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 hq0
    have : algebraMap (𝓞 F) F (q * n) • ((algebraMap (𝓞 F) F p / algebraMap (𝓞 F) F q) • y) =
        p • (algebraMap (𝓞 F) F n • y) := by
      rw [smul_smul, ← algebraMap_smul F p (algebraMap (𝓞 F) F n • y), smul_smul, map_mul]
      congr 1; field_simp
    rw [this]; exact O.smul_mem hny p

theorem algebraMap_mul_eq_smul (n : 𝓞 F) (x : QuatF F a b) :
    algebraMap (𝓞 F) (QuatF F a b) n * x = algebraMap (𝓞 F) F n • x := by
  rw [Algebra.smul_def, IsScalarTower.algebraMap_apply (𝓞 F) F (QuatF F a b)]

/-- **A scalar carrying $\mathcal O'$ into $\mathcal O$**: for orders $\mathcal O \subseteq \mathcal O'$ and a prime $\mathfrak p$
there is $0 \ne m \in \mathfrak p$ with $m\mathcal O' \subseteq \mathcal O$. -/
theorem exists_conductor_scalar (hO : IsOrder (𝓞 F) F O) (hO' : IsOrder (𝓞 F) F O') (𝔭 : HeightOneSpectrum (𝓞 F)) :
    ∃ m : 𝓞 F, m ≠ 0 ∧ m ∈ 𝔭.asIdeal ∧ ∀ x ∈ O', algebraMap (𝓞 F) (QuatF F a b) m * x ∈ O := by
  classical
  obtain ⟨s, hs⟩ := hO'.fg
  have hgen : ∀ g : s, ∃ n : 𝓞 F, n ≠ 0 ∧ algebraMap (𝓞 F) F n • (g : QuatF F a b) ∈ O :=
    fun g => exists_mul_mem_order hO g
  choose n hn hnO using hgen
  obtain ⟨t, ht, ht0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot 𝔭.ne_bot
  obtain ⟨m₀, hm₀def⟩ : ∃ m₀ : 𝓞 F, m₀ = ∏ g : s, n g := ⟨_, rfl⟩
  have hm₀ : m₀ ≠ 0 := hm₀def ▸ Finset.prod_ne_zero_iff.2 fun g _ => hn g
  refine ⟨t * m₀, mul_ne_zero ht0 hm₀, 𝔭.asIdeal.mul_mem_right _ ht, fun x hx => ?_⟩
  have hx' : x ∈ (Subalgebra.toSubmodule O' : Submodule (𝓞 F) (QuatF F a b)) := hx
  rw [← hs] at hx'
  rw [algebraMap_mul_eq_smul]
  clear hx
  induction hx' using Submodule.span_induction with
  | mem y hy =>
    have : t * m₀ = (t * ∏ g ∈ Finset.univ.erase ⟨y, hy⟩, n g) * n ⟨y, hy⟩ := by
      rw [hm₀def, ← Finset.mul_prod_erase _ _ (Finset.mem_univ ⟨y, hy⟩)]; ring
    rw [this, map_mul, mul_smul, algebraMap_smul F]
    exact O.smul_mem (hnO ⟨y, hy⟩) _
  | zero => rw [smul_zero]; exact O.zero_mem
  | add y w _ _ hy hw => rw [smul_add]; exact O.add_mem hy hw
  | smul c y _ hy =>
    rw [smul_comm]
    exact O.smul_mem hy c

end Scalars

/-! ### Local facts -/

section LocalFacts

/-- In a ring, two right translates $\Lambda\alpha_1 = \Lambda\alpha_2$ by units differ by a unit of $\Lambda$. -/
theorem exists_unit_of_rTrans_eq {K : Type*} [Field K] {c₁ c₂ : K} {R : Type*} [CommRing R] [Algebra R ℍ[K, c₁, c₂]]
    (Λ : Subalgebra R ℍ[K, c₁, c₂]) {α₁ α₂ : (ℍ[K, c₁, c₂])ˣ}
    (h : rTrans (Λ : Set ℍ[K, c₁, c₂]) α₁ = rTrans (Λ : Set ℍ[K, c₁, c₂]) α₂) :
    ∃ u : Λˣ, ((u : Λ) : ℍ[K, c₁, c₂]) * α₂ = α₁ := by
  have h1 : (α₁ : ℍ[K, c₁, c₂]) ∈ rTrans (Λ : Set ℍ[K, c₁, c₂]) α₂ := h ▸ ⟨1, Λ.one_mem, one_mul _⟩
  have h2 : (α₂ : ℍ[K, c₁, c₂]) ∈ rTrans (Λ : Set ℍ[K, c₁, c₂]) α₁ := h.symm ▸ ⟨1, Λ.one_mem, one_mul _⟩
  obtain ⟨c, hc, hc1⟩ := h1
  obtain ⟨c', hc', hc2⟩ := h2
  have e1 : c * c' = 1 := by
    have : c * c' * (α₁ : ℍ[K, c₁, c₂]) = 1 * α₁ := by
      simp only at hc1 hc2; rw [mul_assoc, hc2, hc1, one_mul]
    exact (Units.mul_left_inj α₁).1 this
  have e2 : c' * c = 1 := by
    have : c' * c * (α₂ : ℍ[K, c₁, c₂]) = 1 * α₂ := by
      simp only at hc1 hc2; rw [mul_assoc, hc1, hc2, one_mul]
    exact (Units.mul_left_inj α₂).1 this
  exact ⟨⟨⟨c, hc⟩, ⟨c', hc'⟩, Subtype.ext e1, Subtype.ext e2⟩, hc1⟩

theorem rTrans_unit_self {K : Type*} [Field K] {c₁ c₂ : K} {R : Type*} [CommRing R] [Algebra R ℍ[K, c₁, c₂]]
    (Λ : Subalgebra R ℍ[K, c₁, c₂]) (u : Λˣ) :
    rTrans (Λ : Set ℍ[K, c₁, c₂]) ((u : Λ) : ℍ[K, c₁, c₂]) = Λ := by
  ext y
  constructor
  · rintro ⟨z, hz, rfl⟩; exact Λ.mul_mem hz (u : Λ).2
  · intro hy
    refine ⟨y * (((u⁻¹ : Λˣ) : Λ) : ℍ[K, c₁, c₂]), Λ.mul_mem hy (u⁻¹ : Λˣ).1.2, ?_⟩
    simp only
    rw [mul_assoc, ← Subalgebra.coe_mul, Units.inv_mul, OneMemClass.coe_one, mul_one]

theorem ideal_le_of_idealSet_subset {K : Type*} [Field K] {c₁ c₂ : K} {R : Type*} [CommRing R]
    [Algebra R ℍ[K, c₁, c₂]] {Λ : Subalgebra R ℍ[K, c₁, c₂]} {I I' : Ideal Λ} (h : idealSet I ⊆ idealSet I') :
    I ≤ I' := fun x hx => coe_mem_idealSet.1 (h (coe_mem_idealSet.2 hx))

theorem idealSet_span_singleton {K : Type*} [Field K] {c₁ c₂ : K} {R : Type*} [CommRing R]
    [Algebra R ℍ[K, c₁, c₂]] {Λ : Subalgebra R ℍ[K, c₁, c₂]} (x : Λ) :
    idealSet (Ideal.span {x}) = rTrans (Λ : Set ℍ[K, c₁, c₂]) (x : ℍ[K, c₁, c₂]) := by
  ext y
  constructor
  · rintro ⟨hy, hyx⟩
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.1 hyx
    exact ⟨c, c.2, by simp only; rw [← Subalgebra.coe_mul, hc]⟩

  · rintro ⟨c, hc, rfl⟩
    exact ⟨Λ.mul_mem hc x.2, Ideal.mem_span_singleton'.2 ⟨⟨c, hc⟩, rfl⟩⟩

variable {O O' : Subalgebra (𝓞 F) (QuatF F a b)}

/-- **Equality of ideals is local**: two left ideals containing nonzero scalars with the same completions are equal. -/
theorem ideal_eq_of_local (hO : IsOrder (𝓞 F) F O) {J₁ J₂ : Ideal O} {n₁ n₂ : 𝓞 F} (hn₁ : n₁ ≠ 0) (hn₂ : n₂ ≠ 0)
    (h₁ : algebraMap (𝓞 F) O n₁ ∈ J₁) (h₂ : algebraMap (𝓞 F) O n₂ ∈ J₂)
    (h : ∀ v : HeightOneSpectrum (𝓞 F), idealSet (localIdeal (v := v) J₁) = idealSet (localIdeal (v := v) J₂)) :
    J₁ = J₂ :=
  le_antisymm (Gen.le_of_localIdeal_le hO hn₂ h₂ fun v _ => ideal_le_of_idealSet_subset (h v).le)
    (Gen.le_of_localIdeal_le hO hn₁ h₁ fun v _ => ideal_le_of_idealSet_subset (h v).ge)

/-- If $m\mathcal O' \subseteq \mathcal O$ then $\iota_v(m)\mathcal O'_v \subseteq \mathcal O_v$. -/
theorem mul_mem_localOrder_of (v : HeightOneSpectrum (𝓞 F)) {m : 𝓞 F}
    (hm : ∀ x ∈ O', algebraMap (𝓞 F) (QuatF F a b) m * x ∈ O) {y : QuatV v a b}
    (hy : y ∈ localOrder (v := v) a b O') :
    algebraMap (v.adicCompletionIntegers F) (QuatV v a b) (ι v m) * y ∈ localOrder (v := v) a b O := by
  have hy' : y ∈ Submodule.span (v.adicCompletionIntegers F) (complHom v a b '' (O' : Set (QuatF F a b))) := hy
  clear hy
  induction hy' using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨x, hx, rfl⟩ := hz
    rw [← Gen.complHom_algebraMap, ← map_mul]
    exact mem_localOrder_of_mem a b (hm x hx)
  | zero => rw [mul_zero]; exact Subalgebra.zero_mem _
  | add y w _ _ hy hw => rw [mul_add]; exact Subalgebra.add_mem _ hy hw
  | smul c y _ hy =>
    rw [mul_smul_comm]
    exact Subalgebra.smul_mem _ hy c

/-- A left ideal contained in $\mathcal O$ has completions contained in $\mathcal O_v$. -/
theorem idealSet_localIdeal_subset_of (v : HeightOneSpectrum (𝓞 F)) {D : Ideal O'}
    (hD : idealSet D ⊆ O) : idealSet (localIdeal (v := v) D) ⊆ localOrder (v := v) a b O := by
  erw [idealSet_localIdeal_eq_span v]
  have : Submodule.span (v.adicCompletionIntegers F) (idealImage (v := v) D) ≤
      Subalgebra.toSubmodule (localOrder (v := v) a b O) := by
    refine Submodule.span_le.2 ?_
    rintro _ ⟨x, hx, rfl⟩
    exact mem_localOrder_of_mem a b (hD (coe_mem_idealSet.2 hx))
  exact this

end LocalFacts

/-! ### Gluing: the ideals over a fixed $D$ -/

section Glue

variable {O O' : Subalgebra (𝓞 F) (QuatF F a b)} {𝔭 : HeightOneSpectrum (𝓞 F)}

/-- The data of Proposition 26.6.4: orders $\mathcal O \subseteq \mathcal O'$ agreeing away from $\mathfrak p$, and a scalar
$0 \ne m \in \mathfrak p$ with $m\mathcal O' \subseteq \mathcal O$. -/
structure Data (O O' : Subalgebra (𝓞 F) (QuatF F a b)) (𝔭 : HeightOneSpectrum (𝓞 F)) where
  le : O ≤ O'
  hO : IsOrder (𝓞 F) F O
  hO' : IsOrder (𝓞 F) F O'
  hloc : ∀ v, v ≠ 𝔭 → localOrder (v := v) a b O = localOrder (v := v) a b O'
  m : 𝓞 F
  hm0 : m ≠ 0
  hm𝔭 : m ∈ 𝔭.asIdeal
  hmO : ∀ x ∈ O', algebraMap (𝓞 F) (QuatF F a b) m * x ∈ O

/-- A representative $D \subseteq \mathcal O$ of a class of $\operatorname{Cls}\mathcal O'$, with a nonzero scalar
$n_0 \in D$ and a local generator $D_{\mathfrak p} = \mathcal O'_{\mathfrak p}\alpha$. -/
structure Deep (O O' : Subalgebra (𝓞 F) (QuatF F a b)) (𝔭 : HeightOneSpectrum (𝓞 F)) where
  D : Ideal O'
  good : Good D
  deep : idealSet D ⊆ O
  n₀ : 𝓞 F
  hn₀ : n₀ ≠ 0
  hn₀D : algebraMap (𝓞 F) O' n₀ ∈ D
  α : (QuatV 𝔭 a b)ˣ
  hα : idealSet (localIdeal (v := 𝔭) D) = rTrans (localOrder (v := 𝔭) a b O' : Set (QuatV 𝔭 a b)) α

variable (d : Data O O' 𝔭) (E : Deep O O' 𝔭)

/-- The scalar $n = m n_0 \in D \cap \mathfrak p$. -/
def Data.n : 𝓞 F := d.m * E.n₀

theorem Data.n_ne_zero : d.n E ≠ 0 := mul_ne_zero d.hm0 E.hn₀

theorem Data.n_mem_𝔭 : d.n E ∈ 𝔭.asIdeal := 𝔭.asIdeal.mul_mem_right _ d.hm𝔭

theorem Data.n_mem_D : algebraMap (𝓞 F) O' (d.n E) ∈ E.D := by
  rw [Data.n, map_mul]; exact E.D.mul_mem_left _ E.hn₀D

/-- The completion at $v \ne \mathfrak p$ of $D$, as a left ideal of $\mathcal O_v \subseteq \mathcal O'_v$. -/
def Data.famBase : ∀ v : HeightOneSpectrum (𝓞 F), Ideal (localOrder (v := v) a b O) := fun v =>
  Ideal.comap (Subalgebra.inclusion (Wave6.localOrder_mono v d.le)) (localIdeal (v := v) E.D)

open Classical in
/-- The family of local ideals: $D_v$ at $v \ne \mathfrak p$ and $s$ at $\mathfrak p$. -/
def Data.fam (s : Ideal (localOrder (v := 𝔭) a b O)) : ∀ v : HeightOneSpectrum (𝓞 F), Ideal (localOrder (v := v) a b O) :=
  Function.update (d.famBase E) 𝔭 s

/-- **The glued ideal** with completions $D_v$ ($v \ne \mathfrak p$) and $s$ (at $\mathfrak p$). -/
def Data.glue (s : Ideal (localOrder (v := 𝔭) a b O)) : Ideal O :=
  globalIdeal (Gen.primeSupport (d.n_ne_zero E)) (d.fam E s)

theorem Data.idealSet_famBase {v : HeightOneSpectrum (𝓞 F)} (hv : v ≠ 𝔭) :
    idealSet (d.famBase E v) = idealSet (localIdeal (v := v) E.D) := by
  ext y
  constructor
  · rintro ⟨hy, hyD⟩
    exact ⟨Wave6.localOrder_mono v d.le hy, hyD⟩
  · rintro ⟨hy, hyD⟩
    have hy' : y ∈ localOrder (v := v) a b O := by rw [d.hloc v hv]; exact hy
    exact ⟨hy', hyD⟩

theorem Data.fam_ne {s : Ideal (localOrder (v := 𝔭) a b O)} {v : HeightOneSpectrum (𝓞 F)} (hv : v ≠ 𝔭) :
    d.fam E s v = d.famBase E v := by
  classical
  rw [Data.fam, Function.update_of_ne hv]

theorem Data.fam_self {s : Ideal (localOrder (v := 𝔭) a b O)} : d.fam E s 𝔭 = s := by
  classical
  rw [Data.fam, Function.update_self]

theorem Data.algebraMap_mem_fam {s : Ideal (localOrder (v := 𝔭) a b O)}
    (hs : algebraMap _ (localOrder (v := 𝔭) a b O) (ι 𝔭 (d.n E)) ∈ s) (v : HeightOneSpectrum (𝓞 F)) :
    algebraMap _ (localOrder (v := v) a b O) (ι v (d.n E)) ∈ d.fam E s v := by
  by_cases hv : v = 𝔭
  · subst hv; rw [d.fam_self E]; exact hs
  · rw [d.fam_ne E hv, Data.famBase, Ideal.mem_comap]
    have := Gen.algebraMap_mem_localIdeal v (d.n_mem_D E)
    convert this using 1
    exact Subtype.ext rfl

theorem Data.n_mem_glue {s : Ideal (localOrder (v := 𝔭) a b O)}
    (hs : algebraMap _ (localOrder (v := 𝔭) a b O) (ι 𝔭 (d.n E)) ∈ s) :
    algebraMap (𝓞 F) O (d.n E) ∈ d.glue E s :=
  Gen.algebraMap_mem_globalIdeal fun v _ => d.algebraMap_mem_fam E hs v

/-- **The completions of the glued ideal** are the prescribed ones, at every place. -/
theorem Data.localIdeal_glue {s : Ideal (localOrder (v := 𝔭) a b O)}
    (hs : algebraMap _ (localOrder (v := 𝔭) a b O) (ι 𝔭 (d.n E)) ∈ s) (v : HeightOneSpectrum (𝓞 F)) :
    localIdeal (v := v) (d.glue E s) = d.fam E s v := by
  by_cases hv : v ∈ Gen.primeSupport (d.n_ne_zero E)
  · exact Gen.localIdeal_globalIdeal d.hO (d.n_ne_zero E) _ (fun w _ => d.algebraMap_mem_fam E hs w) v hv
  · have hnv : d.n E ∉ v.asIdeal := fun h => hv ((Gen.mem_primeSupport _).2 h)
    have hv𝔭 : v ≠ 𝔭 := by rintro rfl; exact hnv (d.n_mem_𝔭 E)
    rw [Gen.localIdeal_eq_top v (d.n_mem_glue E hs) hnv, d.fam_ne E hv𝔭, Data.famBase,
      Gen.localIdeal_eq_top v (d.n_mem_D E) hnv, Ideal.comap_top]

/-- The local generator $x_u = u\alpha$ at $\mathfrak p$, for $u \in \mathcal O'^\times_{\mathfrak p}$. -/
def Deep.xu (u : (localOrder (v := 𝔭) a b O')ˣ) : (QuatV 𝔭 a b)ˣ :=
  Units.map (localOrder (v := 𝔭) a b O').val.toMonoidHom u * E.α

theorem Deep.coe_xu (u : (localOrder (v := 𝔭) a b O')ˣ) :
    ((E.xu u : (QuatV 𝔭 a b)ˣ) : QuatV 𝔭 a b) = ((u : localOrder (v := 𝔭) a b O') : QuatV 𝔭 a b) * E.α := rfl

theorem Deep.xu_mem (u : (localOrder (v := 𝔭) a b O')ˣ) :
    ((E.xu u : (QuatV 𝔭 a b)ˣ) : QuatV 𝔭 a b) ∈ localOrder (v := 𝔭) a b O := by
  refine idealSet_localIdeal_subset_of 𝔭 E.deep ?_
  rw [E.hα, Deep.coe_xu]
  exact ⟨_, (u : localOrder (v := 𝔭) a b O').2, rfl⟩

/-- The local ideal $\mathcal O_{\mathfrak p}u\alpha$. -/
def Deep.sU (u : (localOrder (v := 𝔭) a b O')ˣ) : Ideal (localOrder (v := 𝔭) a b O) :=
  Ideal.span {⟨_, E.xu_mem u⟩}

theorem Deep.idealSet_sU (u : (localOrder (v := 𝔭) a b O')ˣ) :
    idealSet (E.sU u) = rTrans (localOrder (v := 𝔭) a b O : Set (QuatV 𝔭 a b)) (E.xu u) :=
  idealSet_span_singleton _

theorem Data.n_mem_sU (u : (localOrder (v := 𝔭) a b O')ˣ) :
    algebraMap _ (localOrder (v := 𝔭) a b O) (ι 𝔭 (d.n E)) ∈ E.sU u := by
  -- ι(n₀) ∈ D_𝔭 = O'_𝔭 α = O'_𝔭 u α, so ι(n) = ι(m) ι(n₀) ∈ ι(m) O'_𝔭 x_u ⊆ O_𝔭 x_u
  have h0 : complHom 𝔭 a b (algebraMap (𝓞 F) (QuatF F a b) E.n₀) ∈ idealSet (localIdeal (v := 𝔭) E.D) := by
    erw [idealSet_localIdeal_eq_span 𝔭]
    exact Submodule.subset_span ⟨_, E.hn₀D, rfl⟩
  rw [E.hα] at h0
  obtain ⟨o, ho, hoα⟩ := h0
  simp only at hoα
  set w : QuatV 𝔭 a b := o * (((u⁻¹ : (localOrder (v := 𝔭) a b O')ˣ) : localOrder (v := 𝔭) a b O') : QuatV 𝔭 a b)
  have hw : w ∈ localOrder (v := 𝔭) a b O' := Subalgebra.mul_mem _ ho (u⁻¹ : (localOrder (v := 𝔭) a b O')ˣ).1.2
  have hc := mul_mem_localOrder_of 𝔭 d.hmO hw
  have key : algebraMap (𝔭.adicCompletionIntegers F) (QuatV 𝔭 a b) (ι 𝔭 (d.n E)) =
      (algebraMap (𝔭.adicCompletionIntegers F) (QuatV 𝔭 a b) (ι 𝔭 d.m) * w) *
        ((E.xu u : (QuatV 𝔭 a b)ˣ) : QuatV 𝔭 a b) := by
    rw [Deep.coe_xu, Data.n, map_mul, map_mul]
    simp only [w, mul_assoc]
    rw [← mul_assoc ((((u⁻¹ : (localOrder (v := 𝔭) a b O')ˣ) : localOrder (v := 𝔭) a b O') : QuatV 𝔭 a b)),
      ← Subalgebra.coe_mul, Units.inv_mul, OneMemClass.coe_one, one_mul, hoα, Gen.complHom_algebraMap]
  refine Ideal.mem_span_singleton'.2 ⟨⟨_, hc⟩, Subtype.ext ?_⟩
  rw [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, key]

/-- The glued ideal $G(u)$. -/
def Data.G (u : (localOrder (v := 𝔭) a b O')ˣ) : Ideal O := d.glue E (E.sU u)

theorem Data.localIdeal_G (u : (localOrder (v := 𝔭) a b O')ˣ) (v : HeightOneSpectrum (𝓞 F)) :
    localIdeal (v := v) (d.glue E (E.sU u)) = d.fam E (E.sU u) v :=
  d.localIdeal_glue E (d.n_mem_sU E u) v

theorem Data.idealSet_localIdeal_G_self (u : (localOrder (v := 𝔭) a b O')ˣ) :
    idealSet (localIdeal (v := 𝔭) (d.glue E (E.sU u))) =
      rTrans (localOrder (v := 𝔭) a b O : Set (QuatV 𝔭 a b)) (E.xu u) := by
  rw [d.localIdeal_G E u, d.fam_self E, E.idealSet_sU]

theorem Data.idealSet_localIdeal_G_ne (u : (localOrder (v := 𝔭) a b O')ˣ) {v : HeightOneSpectrum (𝓞 F)}
    (hv : v ≠ 𝔭) : idealSet (localIdeal (v := v) (d.glue E (E.sU u))) = idealSet (localIdeal (v := v) E.D) := by
  rw [d.localIdeal_G E u, d.fam_ne E hv, d.idealSet_famBase E hv]

theorem Data.n_mem_G (u : (localOrder (v := 𝔭) a b O')ˣ) :
    algebraMap (𝓞 F) O (d.n E) ∈ d.glue E (E.sU u) :=
  d.n_mem_glue E (d.n_mem_sU E u)

theorem Data.good_G (u : (localOrder (v := 𝔭) a b O')ˣ) : Good (d.glue E (E.sU u)) := by
  refine ⟨fun hb => algebraMap_ne_zero (O := O) (d.n_ne_zero E) ?_, fun v => ?_⟩
  · have := d.n_mem_G E u
    rwa [hb, Ideal.mem_bot] at this
  · by_cases hv : v = 𝔭
    · subst hv; exact ⟨E.xu u, d.idealSet_localIdeal_G_self E u⟩
    · obtain ⟨β, hβ⟩ := E.good.2 v
      refine ⟨β, ?_⟩
      rw [d.idealSet_localIdeal_G_ne E u hv, hβ, d.hloc v hv]

theorem Data.n_mem_ext {J : Ideal O} {n : 𝓞 F} (hn : algebraMap (𝓞 F) O n ∈ J) :
    algebraMap (𝓞 F) O' n ∈ extIdeal d.le J := by
  have h1 := idealSet_subset_extIdeal d.le J (coe_mem_idealSet.2 hn)
  rw [Subalgebra.coe_algebraMap] at h1
  rw [← coe_mem_idealSet, Subalgebra.coe_algebraMap]
  exact h1

theorem Data.ext_G (u : (localOrder (v := 𝔭) a b O')ˣ) : extIdeal d.le (d.glue E (E.sU u)) = E.D := by
  refine ideal_eq_of_local d.hO' (d.n_ne_zero E) (d.n_ne_zero E) (d.n_mem_ext (d.n_mem_G E u)) (d.n_mem_D E)
    fun v => ?_
  by_cases hv : v = 𝔭
  · subst hv
    rw [idealSet_localIdeal_extIdeal v d.le (d.idealSet_localIdeal_G_self E u), E.hα, Deep.coe_xu,
      ← rTrans_rTrans, rTrans_unit_self]
  · obtain ⟨β, hβ⟩ := E.good.2 v
    have hG : idealSet (localIdeal (v := v) (d.glue E (E.sU u))) =
        rTrans (localOrder (v := v) a b O : Set (QuatV v a b)) β := by
      rw [d.idealSet_localIdeal_G_ne E u hv, hβ, d.hloc v hv]
    rw [idealSet_localIdeal_extIdeal v d.le hG, hβ]

/-- The subgroup $\mathcal O_{\mathfrak p}^\times \le \mathcal O'^\times_{\mathfrak p}$. -/
abbrev Data.U : Subgroup (localOrder (v := 𝔭) a b O')ˣ :=
  (Units.map (Subalgebra.inclusion (Wave6.localOrder_mono 𝔭 d.le)).toMonoidHom).range

theorem Data.sU_eq (u u' : (localOrder (v := 𝔭) a b O')ˣ) (h : u' * u⁻¹ ∈ d.U) : E.sU u = E.sU u' := by
  obtain ⟨w, hw⟩ := h
  have hu' : u' = Units.map (Subalgebra.inclusion (Wave6.localOrder_mono 𝔭 d.le)).toMonoidHom w * u := by
    rw [hw, inv_mul_cancel_right]
  apply idealSet_injective
  rw [E.idealSet_sU, E.idealSet_sU, Deep.coe_xu, Deep.coe_xu, hu']
  have : (((Units.map (Subalgebra.inclusion (Wave6.localOrder_mono 𝔭 d.le)).toMonoidHom w * u :
      (localOrder (v := 𝔭) a b O')ˣ) : localOrder (v := 𝔭) a b O') : QuatV 𝔭 a b) =
      ((w : localOrder (v := 𝔭) a b O) : QuatV 𝔭 a b) * ((u : localOrder (v := 𝔭) a b O') : QuatV 𝔭 a b) := rfl
  rw [this, mul_assoc, ← rTrans_rTrans _ ((w : localOrder (v := 𝔭) a b O) : QuatV 𝔭 a b), rTrans_unit_self]

theorem Data.G_eq_iff (u u' : (localOrder (v := 𝔭) a b O')ˣ) :
    d.glue E (E.sU u) = d.glue E (E.sU u') ↔ u' * u⁻¹ ∈ d.U := by
  constructor
  · intro he
    have h1 : idealSet (localIdeal (v := 𝔭) (d.glue E (E.sU u))) =
        idealSet (localIdeal (v := 𝔭) (d.glue E (E.sU u'))) := by rw [he]
    rw [d.idealSet_localIdeal_G_self, d.idealSet_localIdeal_G_self] at h1
    obtain ⟨w, hw⟩ := exists_unit_of_rTrans_eq _ h1.symm
    have hw' : ((w : localOrder (v := 𝔭) a b O) : QuatV 𝔭 a b) * ((u : localOrder (v := 𝔭) a b O') : QuatV 𝔭 a b) =
        ((u' : localOrder (v := 𝔭) a b O') : QuatV 𝔭 a b) := by
      rw [Deep.coe_xu, Deep.coe_xu, ← mul_assoc] at hw
      exact (Units.mul_left_inj E.α).1 hw
    refine ⟨w, Units.ext (Subtype.ext ?_)⟩
    show ((w : localOrder (v := 𝔭) a b O) : QuatV 𝔭 a b) =
      ((u' : localOrder (v := 𝔭) a b O') : QuatV 𝔭 a b) *
        (((u⁻¹ : (localOrder (v := 𝔭) a b O')ˣ) : localOrder (v := 𝔭) a b O') : QuatV 𝔭 a b)
    rw [← hw', mul_assoc, ← Subalgebra.coe_mul, Units.mul_inv, OneMemClass.coe_one, mul_one]
  · intro h
    rw [d.sU_eq E u u' h]

/-- The ideals over $D$: nonzero locally principal left $\mathcal O$-ideals $J$ with $\mathcal O'J = D$. -/
abbrev Data.X : Type := {J : Ideal O // Good J ∧ extIdeal d.le J = E.D}

/-- $u \mapsto G(u)$. -/
def Data.Gx (u : (localOrder (v := 𝔭) a b O')ˣ) : d.X E := ⟨d.glue E (E.sU u), d.good_G E u, d.ext_G E u⟩

theorem Data.exists_G_eq [IsTotallyReal F] (hdef : IsTotDefinite a b) (J : d.X E) : ∃ u, d.Gx E u = J := by
  obtain ⟨J, hJ, hJD⟩ := J
  obtain ⟨αJ, hαJ⟩ := hJ.2 𝔭
  have h1 := idealSet_localIdeal_extIdeal 𝔭 d.le hαJ
  rw [hJD, E.hα] at h1
  obtain ⟨u, hu⟩ := exists_unit_of_rTrans_eq _ h1.symm
  refine ⟨u, Subtype.ext ?_⟩
  obtain ⟨n₁, hn₁, hn₁J⟩ := exists_scalar_mem hdef d.hO hJ.1
  refine ideal_eq_of_local d.hO (d.n_ne_zero E) hn₁ (d.n_mem_G E u) hn₁J fun v => ?_
  change idealSet (localIdeal (v := v) (d.glue E (E.sU u))) = idealSet (localIdeal (v := v) J)
  by_cases hv : v = 𝔭
  · subst hv
    rw [d.idealSet_localIdeal_G_self, hαJ, Deep.coe_xu, hu]
  · obtain ⟨β, hβ⟩ := hJ.2 v
    have h2 := idealSet_localIdeal_extIdeal v d.le hβ
    rw [hJD] at h2
    rw [d.idealSet_localIdeal_G_ne E u hv, h2, hβ, d.hloc v hv]

/-- **The ideals over $D$ are counted by $\mathcal O_{\mathfrak p}^\times\backslash\mathcal O'^\times_{\mathfrak p}$.** -/
def Data.xEquiv [IsTotallyReal F] (hdef : IsTotDefinite a b) : Quotient (QuotientGroup.rightRel d.U) ≃ d.X E :=
  Equiv.ofBijective
    (Quotient.lift (d.Gx E) fun u u' h =>
      Subtype.ext ((d.G_eq_iff E u u').2 (QuotientGroup.rightRel_apply.1 h)))
    ⟨fun x y hxy => by
      induction x using Quotient.inductionOn with
      | h u =>
        induction y using Quotient.inductionOn with
        | h u' =>
          exact Quotient.sound (QuotientGroup.rightRel_apply.2 ((d.G_eq_iff E u u').1 (congrArg Subtype.val hxy))),
     fun J => by
      obtain ⟨u, hu⟩ := d.exists_G_eq E hdef J
      exact ⟨Quotient.mk _ u, hu⟩⟩

theorem Data.card_X [IsTotallyReal F] (hdef : IsTotDefinite a b) :
    Nat.card (d.X E) = Wave6.localUnitIndex 𝔭 d.le := by
  rw [← Nat.card_congr (d.xEquiv E hdef), Wave6.localUnitIndex, Subgroup.index,
    Nat.card_congr (QuotientGroup.quotientRightRelEquivQuotientLeftRel d.U)]


end Glue

/-! ### The local unit index is finite -/

section FiniteIndex

variable {O O' : Subalgebra (𝓞 F) (QuatF F a b)} {𝔭 : HeightOneSpectrum (𝓞 F)} (d : Data O O' 𝔭)

theorem complHom_smul_ringOfIntegers (v : HeightOneSpectrum (𝓞 F)) (r : 𝓞 F) (x : QuatF F a b) :
    complHom v a b (r • x) = ι v r • complHom v a b x := by
  rw [← algebraMap_smul F r x, complHom_smul_int]

/-- The completion of a finitely generated order is spanned by the images of finitely many generators. -/
theorem exists_fun_sum_eq (v : HeightOneSpectrum (𝓞 F)) {s : Finset (QuatF F a b)}
    (hs : Submodule.span (𝓞 F) (s : Set (QuatF F a b)) = Subalgebra.toSubmodule O') {y : QuatV v a b}
    (hy : y ∈ localOrder (v := v) a b O') :
    ∃ e : s → v.adicCompletionIntegers F, ∑ x : s, e x • complHom v a b (x : QuatF F a b) = y := by
  have hle : Submodule.span (v.adicCompletionIntegers F) (complHom v a b '' (O' : Set (QuatF F a b))) ≤
      Submodule.span (v.adicCompletionIntegers F) (Set.range fun x : s => complHom v a b (x : QuatF F a b)) := by
    refine Submodule.span_le.2 ?_
    rintro _ ⟨z, hz, rfl⟩
    have hz' : z ∈ Submodule.span (𝓞 F) (s : Set (QuatF F a b)) := by rw [hs]; exact hz
    clear hz
    induction hz' using Submodule.span_induction with
    | mem x hx => exact Submodule.subset_span ⟨⟨x, hx⟩, rfl⟩
    | zero => rw [map_zero]; exact Submodule.zero_mem _
    | add x w _ _ hx hw => rw [map_add]; exact Submodule.add_mem _ hx hw
    | smul r x _ hx => rw [complHom_smul_ringOfIntegers]; exact Submodule.smul_mem _ _ hx
  exact (Submodule.mem_span_range_iff_exists_fun _).1 (hle hy)

theorem finite_quot_ι (v : HeightOneSpectrum (𝓞 F)) {m : 𝓞 F} (hm : m ≠ 0) :
    Finite (v.adicCompletionIntegers F ⧸ Ideal.span {ι v m}) := by
  rw [Gen.span_ι_eq_cI v hm]
  infer_instance

/-- A subalgebra spanned by finitely many elements has finite quotient by $c$ when $R/(c)$ is finite. -/
theorem finite_quot_of_span {K : Type*} [Field K] {c₁ c₂ : K} {R : Type*} [CommRing R]
    [Algebra R ℍ[K, c₁, c₂]] {Λ' : Subalgebra R ℍ[K, c₁, c₂]} {ι' : Type*} [Fintype ι'] (g : ι' → Λ') (c : R)
    (hg : ∀ y : Λ', ∃ e : ι' → R, ∑ i, e i • g i = y) [Finite (R ⧸ Ideal.span {c})] :
    Finite (Λ' ⧸ Ideal.span {algebraMap R Λ' c}) := by
  classical
  let φ : (ι' → R ⧸ Ideal.span {c}) → Λ' ⧸ Ideal.span {algebraMap R Λ' c} := fun f =>
    Submodule.Quotient.mk (∑ i, (Quotient.out (f i)) • g i)
  refine Finite.of_surjective φ fun q => ?_
  induction q using Submodule.Quotient.induction_on with
  | H y =>
    obtain ⟨e, he⟩ := hg y
    refine ⟨fun i => Ideal.Quotient.mk _ (e i), ?_⟩
    show Submodule.Quotient.mk _ = Submodule.Quotient.mk _
    rw [Submodule.Quotient.eq, ← he, ← Finset.sum_sub_distrib]
    refine Submodule.sum_mem _ fun i _ => ?_
    rw [← sub_smul]
    have hmem : Quotient.out (Ideal.Quotient.mk (Ideal.span {c}) (e i)) - e i ∈ Ideal.span {c} := by
      rw [← Ideal.Quotient.eq, Ideal.Quotient.mk_out]
    obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.1 hmem
    rw [← ht, mul_smul, Algebra.smul_def c (g i), Algebra.commutes, ← smul_mul_assoc]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)

/-- **Finite unit index from a conductor**: if $c\Lambda' \subseteq \Lambda$ and $\Lambda'/c\Lambda'$ is finite, then
$[\Lambda'^\times : \Lambda^\times] < \infty$ (units congruent modulo $c\Lambda'$ lie in the same coset). -/
theorem index_ne_zero_of_conductor {K : Type*} [Field K] {c₁ c₂ : K} {R : Type*} [CommRing R]
    [Algebra R ℍ[K, c₁, c₂]] {Λ Λ' : Subalgebra R ℍ[K, c₁, c₂]} (h : Λ ≤ Λ') (c : R)
    (hc : ∀ y ∈ Λ', algebraMap R ℍ[K, c₁, c₂] c * y ∈ Λ)
    (hfin : Finite (Λ' ⧸ Ideal.span {algebraMap R Λ' c})) :
    (Units.map (Subalgebra.inclusion h).toMonoidHom).range.index ≠ 0 := by
  classical
  set U := (Units.map (Subalgebra.inclusion h).toMonoidHom).range
  have key : ∀ u u' : Λ'ˣ, (Submodule.Quotient.mk (u : Λ') : Λ' ⧸ Ideal.span {algebraMap R Λ' c}) =
      Submodule.Quotient.mk (u' : Λ') → u' * u⁻¹ ∈ U := by
    intro u u' huu
    rw [Submodule.Quotient.eq] at huu
    obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.1 huu
    have hr' : ((r : ℍ[K, c₁, c₂])) * algebraMap R ℍ[K, c₁, c₂] c =
        ((u : Λ') : ℍ[K, c₁, c₂]) - ((u' : Λ') : ℍ[K, c₁, c₂]) := by
      have := congrArg Subtype.val hr
      rw [Subalgebra.coe_mul, Subalgebra.coe_algebraMap, AddSubgroupClass.coe_sub] at this
      exact this
    have hu1 : ((u : Λ') : ℍ[K, c₁, c₂]) * (((u⁻¹ : Λ'ˣ) : Λ') : ℍ[K, c₁, c₂]) = 1 := by
      rw [← Subalgebra.coe_mul, Units.mul_inv, OneMemClass.coe_one]
    have hu2 : (((u⁻¹ : Λ'ˣ) : Λ') : ℍ[K, c₁, c₂]) * ((u : Λ') : ℍ[K, c₁, c₂]) = 1 := by
      rw [← Subalgebra.coe_mul, Units.inv_mul, OneMemClass.coe_one]
    have hu1' : ((u' : Λ') : ℍ[K, c₁, c₂]) * (((u'⁻¹ : Λ'ˣ) : Λ') : ℍ[K, c₁, c₂]) = 1 := by
      rw [← Subalgebra.coe_mul, Units.mul_inv, OneMemClass.coe_one]
    have hu2' : (((u'⁻¹ : Λ'ˣ) : Λ') : ℍ[K, c₁, c₂]) * ((u' : Λ') : ℍ[K, c₁, c₂]) = 1 := by
      rw [← Subalgebra.coe_mul, Units.inv_mul, OneMemClass.coe_one]
    have hcomm : (r : ℍ[K, c₁, c₂]) * algebraMap R ℍ[K, c₁, c₂] c = algebraMap R ℍ[K, c₁, c₂] c * r :=
      (Algebra.commutes _ _).symm
    have e1 : ((u' : Λ') : ℍ[K, c₁, c₂]) * (((u⁻¹ : Λ'ˣ) : Λ') : ℍ[K, c₁, c₂]) =
        1 - algebraMap R ℍ[K, c₁, c₂] c * ((r : ℍ[K, c₁, c₂]) * (((u⁻¹ : Λ'ˣ) : Λ') : ℍ[K, c₁, c₂])) := by
      have : ((u' : Λ') : ℍ[K, c₁, c₂]) = ((u : Λ') : ℍ[K, c₁, c₂]) - (r : ℍ[K, c₁, c₂]) *
          algebraMap R ℍ[K, c₁, c₂] c := by rw [hr']; abel
      rw [this, sub_mul, hu1, hcomm, mul_assoc]
    have e2 : ((u : Λ') : ℍ[K, c₁, c₂]) * (((u'⁻¹ : Λ'ˣ) : Λ') : ℍ[K, c₁, c₂]) =
        1 + algebraMap R ℍ[K, c₁, c₂] c * ((r : ℍ[K, c₁, c₂]) * (((u'⁻¹ : Λ'ˣ) : Λ') : ℍ[K, c₁, c₂])) := by
      have : ((u : Λ') : ℍ[K, c₁, c₂]) = ((u' : Λ') : ℍ[K, c₁, c₂]) + (r : ℍ[K, c₁, c₂]) *
          algebraMap R ℍ[K, c₁, c₂] c := by rw [hr']; abel
      rw [this, add_mul, hu1', hcomm, mul_assoc]
    have m1 : ((u' : Λ') : ℍ[K, c₁, c₂]) * (((u⁻¹ : Λ'ˣ) : Λ') : ℍ[K, c₁, c₂]) ∈ Λ := by
      rw [e1]
      exact Subalgebra.sub_mem _ (Subalgebra.one_mem _) (hc _ (Subalgebra.mul_mem _ r.2 (u⁻¹ : Λ'ˣ).1.2))
    have m2 : ((u : Λ') : ℍ[K, c₁, c₂]) * (((u'⁻¹ : Λ'ˣ) : Λ') : ℍ[K, c₁, c₂]) ∈ Λ := by
      rw [e2]
      exact Subalgebra.add_mem _ (Subalgebra.one_mem _) (hc _ (Subalgebra.mul_mem _ r.2 (u'⁻¹ : Λ'ˣ).1.2))
    have p1 : (((u' : Λ') : ℍ[K, c₁, c₂]) * (((u⁻¹ : Λ'ˣ) : Λ') : ℍ[K, c₁, c₂])) *
        (((u : Λ') : ℍ[K, c₁, c₂]) * (((u'⁻¹ : Λ'ˣ) : Λ') : ℍ[K, c₁, c₂])) = 1 := by
      rw [mul_assoc, ← mul_assoc (((u⁻¹ : Λ'ˣ) : Λ') : ℍ[K, c₁, c₂]), hu2, one_mul, hu1']
    have p2 : (((u : Λ') : ℍ[K, c₁, c₂]) * (((u'⁻¹ : Λ'ˣ) : Λ') : ℍ[K, c₁, c₂])) *
        (((u' : Λ') : ℍ[K, c₁, c₂]) * (((u⁻¹ : Λ'ˣ) : Λ') : ℍ[K, c₁, c₂])) = 1 := by
      rw [mul_assoc, ← mul_assoc (((u'⁻¹ : Λ'ˣ) : Λ') : ℍ[K, c₁, c₂]), hu2', one_mul, hu1]
    exact ⟨⟨⟨_, m1⟩, ⟨_, m2⟩, Subtype.ext p1, Subtype.ext p2⟩, Units.ext (Subtype.ext rfl)⟩
  have hQ : Finite (Quotient (QuotientGroup.rightRel U)) := by
    let φ : Λ'ˣ → Λ' ⧸ Ideal.span {algebraMap R Λ' c} := fun u => Submodule.Quotient.mk (u : Λ')
    refine Finite.of_surjective (fun y : Set.range φ => (Quotient.mk _ (Classical.choose y.2) :
      Quotient (QuotientGroup.rightRel U))) fun q => ?_
    induction q using Quotient.inductionOn with
    | h u =>
      refine ⟨⟨φ u, u, rfl⟩, Quotient.sound (QuotientGroup.rightRel_apply.2 ?_)⟩
      have := Classical.choose_spec (⟨u, rfl⟩ : φ u ∈ Set.range φ)
      exact key _ _ this
  haveI : Finite ((Λ'ˣ) ⧸ U) := Finite.of_equiv _ (QuotientGroup.quotientRightRelEquivQuotientLeftRel U)
  exact Subgroup.index_ne_zero_of_finite

/-- **$[\mathcal O'^\times_{\mathfrak p} : \mathcal O^\times_{\mathfrak p}] < \infty$**, from $m\mathcal O' \subseteq \mathcal O$
and the finiteness of $\mathcal O'_{\mathfrak p}/m\mathcal O'_{\mathfrak p}$. -/
theorem Data.localUnitIndex_ne_zero : Wave6.localUnitIndex 𝔭 d.le ≠ 0 := by
  obtain ⟨s, hs⟩ := d.hO'.fg
  have hsO : ∀ x ∈ s, x ∈ O' := fun x hx => hs.le (Submodule.subset_span hx)
  haveI := finite_quot_ι 𝔭 d.hm0
  have hfin := finite_quot_of_span (Λ' := localOrder (v := 𝔭) a b O')
    (fun x : s => (⟨complHom 𝔭 a b (x : QuatF F a b), mem_localOrder_of_mem a b (hsO x x.2)⟩ :
      localOrder (v := 𝔭) a b O')) (ι 𝔭 d.m) fun y => by
      obtain ⟨e, he⟩ := exists_fun_sum_eq 𝔭 hs y.2
      refine ⟨e, Subtype.ext ?_⟩
      rw [← he, AddSubmonoidClass.coe_finsetSum]
      rfl
  exact index_ne_zero_of_conductor (Wave6.localOrder_mono 𝔭 d.le) (ι 𝔭 d.m)
    (fun y hy => mul_mem_localOrder_of 𝔭 d.hmO hy) hfin

end FiniteIndex

/-! ### The fibres of the class map -/

section Fibre

variable {O O' : Subalgebra (𝓞 F) (QuatF F a b)} {𝔭 : HeightOneSpectrum (𝓞 F)} (d : Data O O' 𝔭) (E : Deep O O' 𝔭)

theorem Data.mem_colon (J : d.X E) (γ : rStab E.D) :
    (((γ : (QuatF F a b)ˣ)⁻¹ : (QuatF F a b)ˣ) : QuatF F a b) ∈ colon J.1 := by
  intro x hx
  have hx' : x ∈ idealSet E.D := J.2.2 ▸ idealSet_subset_extIdeal d.le J.1 hx
  have : x * (((γ : (QuatF F a b)ˣ)⁻¹ : (QuatF F a b)ˣ) : QuatF F a b) ∈ idealSet E.D := by
    rw [← mem_rStab.1 ((rStab E.D).inv_mem γ.2)]
    exact ⟨x, hx', rfl⟩
  exact E.deep this

/-- $J \mapsto J\gamma^{-1}$ for $\gamma \in \Gamma_D$, on the ideals over $D$. -/
def Data.act (γ : rStab E.D) (J : d.X E) : d.X E :=
  ⟨rmulIdeal J.1 (((γ : (QuatF F a b)ˣ)⁻¹ : (QuatF F a b)ˣ) : QuatF F a b),
    Good.of_idealRel ⟨(γ : (QuatF F a b)ˣ)⁻¹, idealSet_rmulIdeal (d.mem_colon E J γ)⟩ J.2.1, by
      apply idealSet_injective
      rw [idealSet_extIdeal_rTrans d.le (β := (γ : (QuatF F a b)ˣ)⁻¹) (idealSet_rmulIdeal (d.mem_colon E J γ)),
        J.2.2]
      exact mem_rStab.1 ((rStab E.D).inv_mem γ.2)⟩

theorem Data.idealSet_act (γ : rStab E.D) (J : d.X E) :
    idealSet (d.act E γ J).1 = rTrans (idealSet J.1) (((γ : (QuatF F a b)ˣ)⁻¹ : (QuatF F a b)ˣ) : QuatF F a b) :=
  idealSet_rmulIdeal (d.mem_colon E J γ)

instance Data.mulAction : MulAction (rStab E.D) (d.X E) where
  smul := d.act E
  one_smul J := by
    apply Subtype.ext; apply idealSet_injective
    change idealSet (d.act E 1 J).1 = _
    rw [d.idealSet_act]
    simp [rTrans_one]
  mul_smul γ δ J := by
    apply Subtype.ext; apply idealSet_injective
    change idealSet (d.act E (γ * δ) J).1 = idealSet (d.act E γ (d.act E δ J)).1
    rw [d.idealSet_act, d.idealSet_act, d.idealSet_act, rTrans_rTrans]
    simp [mul_inv_rev]

theorem Data.smul_def (γ : rStab E.D) (J : d.X E) : γ • J = d.act E γ J := rfl

theorem Data.rStab_le (J : d.X E) : rStab J.1 ≤ rStab (extIdeal d.le J.1) := by
  intro γ hγ
  rw [mem_rStab] at hγ ⊢
  rw [← idealSet_extIdeal_rTrans d.le (β := γ) hγ.symm]

theorem Data.rStab_le_D (J : d.X E) : rStab J.1 ≤ rStab E.D := by
  have := d.rStab_le E J
  rwa [J.2.2] at this

theorem Data.mem_stabilizer_iff (J : d.X E) (γ : rStab E.D) :
    γ ∈ MulAction.stabilizer (rStab E.D) J ↔ (γ : (QuatF F a b)ˣ) ∈ rStab J.1 := by
  rw [MulAction.mem_stabilizer_iff, d.smul_def]
  constructor
  · intro h
    have h1 : idealSet (d.act E γ J).1 = idealSet J.1 := by rw [h]
    rw [d.idealSet_act] at h1
    have : ((γ : (QuatF F a b)ˣ)⁻¹ : (QuatF F a b)ˣ) ∈ rStab J.1 := h1
    simpa using (rStab J.1).inv_mem this
  · intro h
    apply Subtype.ext; apply idealSet_injective
    rw [d.idealSet_act]
    exact (rStab J.1).inv_mem h

theorem Data.stabilizer_eq (J : d.X E) :
    MulAction.stabilizer (rStab E.D) J = (rStab J.1).subgroupOf (rStab E.D) := by
  ext γ
  rw [d.mem_stabilizer_iff, Subgroup.mem_subgroupOf]

theorem Data.card_orbit (J : d.X E) :
    Nat.card (MulAction.orbit (rStab E.D) J) = (rStab J.1).relIndex (rStab E.D) := by
  rw [Nat.card_coe_set_eq, ← MulAction.index_stabilizer, d.stabilizer_eq]
  rfl

theorem Data.wt_D_eq (J : d.X E) : wt E.D = (rStab J.1).relIndex (rStab E.D) * wt J.1 := by
  rw [wt_eq_relIndex, wt_eq_relIndex, mul_comm,
    Subgroup.relIndex_mul_relIndex _ _ _ (centralUnits_le_rStab J.1) (d.rStab_le_D E J)]

theorem Data.clsMap_clsOf_X (J : d.X E) : clsMap d.le (clsOf J.1 J.2.1) = clsOf E.D E.good := by
  rw [clsMap_clsOf]
  exact (clsOf_eq_iff _ _).2 (by rw [J.2.2]; exact idealRel_refl _)

/-- The fibre of the class map over $[D]$. -/
abbrev Data.fibre : Type := {c : ClsO O // clsMap d.le c = clsOf E.D E.good}

/-- **The fibre is the orbit space** $\Gamma_D\backslash X(D)$. -/
def Data.fibreEquiv : MulAction.orbitRel.Quotient (rStab E.D) (d.X E) ≃ d.fibre E :=
  Equiv.ofBijective
    (Quotient.lift (fun J : d.X E => (⟨clsOf J.1 J.2.1, d.clsMap_clsOf_X E J⟩ : d.fibre E)) fun J J₂ h => by
      obtain ⟨γ, hγ⟩ := h
      simp only at hγ
      subst hγ
      apply Subtype.ext
      show clsOf (γ • J₂).1 (γ • J₂).2.1 = clsOf J₂.1 J₂.2.1
      refine (clsOf_eq_iff _ _).2 ?_
      rw [d.smul_def]
      exact IdealRel.symm (⟨(γ : (QuatF F a b)ˣ)⁻¹, d.idealSet_act E γ J₂⟩ : IdealRel J₂.1 (d.act E γ J₂).1))
    ⟨fun x y hxy => by
      induction x using Quotient.inductionOn with
      | h J =>
        induction y using Quotient.inductionOn with
        | h J₂ =>
          have h1 : clsOf J.1 J.2.1 = clsOf J₂.1 J₂.2.1 := congrArg Subtype.val hxy
          obtain ⟨β, hβ⟩ := (clsOf_eq_iff _ _).1 h1
          have hβD : β ∈ rStab E.D := by
            rw [mem_rStab]
            have := idealSet_extIdeal_rTrans d.le hβ
            rw [J.2.2, J₂.2.2] at this
            exact this.symm
          refine Quotient.sound ⟨(⟨β, hβD⟩ : rStab E.D), ?_⟩
          apply Subtype.ext; apply idealSet_injective
          show idealSet (d.act E ⟨β, hβD⟩ J₂).1 = _
          rw [d.idealSet_act, hβ, rTrans_rTrans]
          simp [rTrans_one],
     fun c => by
      obtain ⟨c, hc⟩ := c
      obtain ⟨β, hβ⟩ : IdealRel (extIdeal d.le c.1.out) E.D := (clsOf_eq_iff _ _).1 hc
      have hcol : (β : QuatF F a b) ∈ colon c.1.out := by
        intro x hx
        have : x * β ∈ idealSet E.D := by
          rw [hβ]; exact ⟨x, idealSet_subset_extIdeal d.le _ hx, rfl⟩
        exact E.deep this
      have hJset := idealSet_rmulIdeal hcol
      have hJgood : Good (rmulIdeal c.1.out β) := Good.of_idealRel ⟨β, hJset⟩ c.2
      have hJext : extIdeal d.le (rmulIdeal c.1.out β) = E.D := by
        apply idealSet_injective
        rw [idealSet_extIdeal_rTrans d.le hJset, hβ]
      refine ⟨Quotient.mk _ ⟨rmulIdeal c.1.out β, hJgood, hJext⟩, Subtype.ext ?_⟩
      show clsOf _ hJgood = c
      conv_rhs => rw [← clsOf_out c]
      exact (clsOf_eq_iff _ _).2 (IdealRel.symm (⟨β, hJset⟩ : IdealRel c.1.out (rmulIdeal c.1.out β)))⟩

theorem Data.fibreEquiv_mk (J : d.X E) : ((d.fibreEquiv E (Quotient.mk _ J)).1 : ClsO O) = clsOf J.1 J.2.1 := rfl

/-- **Mass of a fibre**: $\sum_{[J] \in \Phi^{-1}[D]}[\Gamma_J : R^\times]^{-1} = \#X(D)\,[\Gamma_D : R^\times]^{-1}$. -/
theorem Data.sum_fibre [Finite (d.X E)] :
    ∑' c : d.fibre E, (((wt c.1.1.out : ℕ) : ℝ))⁻¹ = (Nat.card (d.X E) : ℝ) * ((wt E.D : ℕ) : ℝ)⁻¹ := by
  classical
  haveI : Fintype (d.X E) := Fintype.ofFinite _
  haveI : Finite (MulAction.orbitRel.Quotient (rStab E.D) (d.X E)) := Quotient.finite _
  haveI : Fintype (MulAction.orbitRel.Quotient (rStab E.D) (d.X E)) := Fintype.ofFinite _
  rw [← (d.fibreEquiv E).tsum_eq, tsum_fintype]
  have hterm : ∀ ω : MulAction.orbitRel.Quotient (rStab E.D) (d.X E),
      (((wt (d.fibreEquiv E ω).1.1.out : ℕ) : ℝ))⁻¹ =
        (Nat.card (MulAction.orbit (rStab E.D) ω.out) : ℝ) * ((wt E.D : ℕ) : ℝ)⁻¹ := by
    intro ω
    have hω : d.fibreEquiv E ω = d.fibreEquiv E (Quotient.mk _ ω.out) := by rw [Quotient.out_eq]
    rw [hω, d.fibreEquiv_mk]
    have hw : wt (clsOf ω.out.1 ω.out.2.1).1.out = wt ω.out.1 :=
      wt_eq_of_idealRel (idealRel_out_mk ω.out.1)
    rw [hw, d.wt_D_eq E ω.out, d.card_orbit]
    have hk : (rStab ω.out.1).relIndex (rStab E.D) ≠ 0 := by
      rw [← d.card_orbit]
      exact Nat.card_ne_zero.2 ⟨⟨ω.out, MulAction.mem_orbit_self _⟩, inferInstance⟩
    by_cases hw0 : wt ω.out.1 = 0
    · rw [hw0]; simp
    · push_cast
      field_simp
  rw [Finset.sum_congr rfl fun ω _ => hterm ω, ← Finset.sum_mul]
  congr 1
  rw [Nat.card_congr (MulAction.selfEquivSigmaOrbits (rStab E.D) (d.X E)), Nat.card_sigma]
  push_cast
  rfl

end Fibre

/-! ### Proposition 26.6.4 -/

section Main

variable {O O' : Subalgebra (𝓞 F) (QuatF F a b)} {𝔭 : HeightOneSpectrum (𝓞 F)}

/-- The unit $m \in B^\times$ for $0 \ne m \in R$. -/
def scalarUnit {m : 𝓞 F} (hm : m ≠ 0) : (QuatF F a b)ˣ :=
  Units.map (algebraMap F (QuatF F a b)).toMonoidHom
    (Units.mk0 (algebraMap (𝓞 F) F m) ((map_ne_zero_iff _ (IsFractionRing.injective (𝓞 F) F)).2 hm))

theorem coe_scalarUnit {m : 𝓞 F} (hm : m ≠ 0) :
    ((scalarUnit (a := a) (b := b) hm : (QuatF F a b)ˣ) : QuatF F a b) = algebraMap (𝓞 F) (QuatF F a b) m := by
  rw [scalarUnit, Units.coe_map, Units.val_mk0, IsScalarTower.algebraMap_apply (𝓞 F) F (QuatF F a b)]
  rfl

theorem Data.mem_colon_scalar (d : Data O O' 𝔭) (J : Ideal O') :
    (algebraMap (𝓞 F) (QuatF F a b) d.m) ∈ colon J := by
  intro x hx
  rw [← Algebra.commutes]
  exact O'.mul_mem (O'.algebraMap_mem _) (idealSet_subset J hx)

/-- **A deep representative** of a class $c \in \operatorname{Cls}\mathcal O'$: $D = J m \subseteq \mathcal O$ for $J$ the
chosen representative. -/
def Data.deepOf [IsTotallyReal F] (hdef : IsTotDefinite a b) (d : Data O O' 𝔭) (c : ClsO O') : Deep O O' 𝔭 :=
  let D := rmulIdeal c.1.out (algebraMap (𝓞 F) (QuatF F a b) d.m)
  have hset : idealSet D = rTrans (idealSet c.1.out) (scalarUnit (a := a) (b := b) d.hm0) := by
    rw [coe_scalarUnit]; exact idealSet_rmulIdeal (d.mem_colon_scalar _)
  have hgood : Good D := Good.of_idealRel ⟨_, hset⟩ c.2
  have hn := exists_scalar_mem hdef d.hO' hgood.1
  have hα := hgood.2 𝔭
  { D := D
    good := hgood
    deep := by
      intro y hy
      rw [hset] at hy
      obtain ⟨x, hx, rfl⟩ := hy
      simp only
      rw [coe_scalarUnit, ← Algebra.commutes]
      exact d.hmO x (idealSet_subset _ hx)
    n₀ := hn.choose
    hn₀ := hn.choose_spec.1
    hn₀D := hn.choose_spec.2
    α := hα.choose
    hα := hα.choose_spec }

theorem Data.clsOf_deepOf [IsTotallyReal F] (hdef : IsTotDefinite a b) (d : Data O O' 𝔭) (c : ClsO O') :
    clsOf (d.deepOf hdef c).D (d.deepOf hdef c).good = c := by
  conv_rhs => rw [← clsOf_out c]
  have hr : IdealRel c.1.out (d.deepOf hdef c).D := ⟨scalarUnit (a := a) (b := b) d.hm0, by
    rw [coe_scalarUnit]; exact idealSet_rmulIdeal (d.mem_colon_scalar _)⟩
  exact (clsOf_eq_iff _ _).2 (IdealRel.symm hr)


theorem Data.wt_deepOf [IsTotallyReal F] (hdef : IsTotDefinite a b) (d : Data O O' 𝔭) (c : ClsO O') :
    wt (d.deepOf hdef c).D = wt c.1.out := by
  refine wt_eq_of_idealRel ⟨scalarUnit (a := a) (b := b) d.hm0, ?_⟩
  rw [coe_scalarUnit]; exact idealSet_rmulIdeal (d.mem_colon_scalar _)

theorem Data.clsMass_eq [IsTotallyReal F] (hdef : IsTotDefinite a b) (d : Data O O' 𝔭) :
    clsMass O = (Wave6.localUnitIndex 𝔭 d.le : ℝ) * clsMass O' := by
  set N := Wave6.localUnitIndex 𝔭 d.le
  have hN := d.localUnitIndex_ne_zero
  -- the mass of each fibre
  have hfib : ∀ c' : ClsO O', ∑' c : {c : ClsO O // clsMap d.le c = c'}, (((wt c.1.1.out : ℕ) : ℝ))⁻¹ =
      (N : ℝ) * ((wt c'.1.out : ℕ) : ℝ)⁻¹ := by
    intro c'
    set E := d.deepOf hdef c'
    haveI : Finite (d.X E) := Nat.finite_of_card_ne_zero (by rw [d.card_X E hdef]; exact hN)
    have h := d.sum_fibre E
    rw [d.card_X E hdef, d.wt_deepOf hdef c'] at h
    rw [← h]
    have he : clsOf E.D E.good = c' := d.clsOf_deepOf hdef c'
    exact (congrArg (fun t => ∑' c : {c : ClsO O // clsMap d.le c = t}, (((wt c.1.1.out : ℕ) : ℝ))⁻¹) he).symm
  -- assemble with nonnegative sums in `ℝ≥0∞`
  have hnn : ∀ c : ClsO O, 0 ≤ (((wt c.1.out : ℕ) : ℝ))⁻¹ := fun c => by positivity
  have hnn' : ∀ c : ClsO O', 0 ≤ (((wt c.1.out : ℕ) : ℝ))⁻¹ := fun c => by positivity
  have key : ∑' c : ClsO O, ENNReal.ofReal (((wt c.1.out : ℕ) : ℝ))⁻¹ =
      ENNReal.ofReal N * ∑' c' : ClsO O', ENNReal.ofReal (((wt c'.1.out : ℕ) : ℝ))⁻¹ := by
    rw [← (Equiv.sigmaFiberEquiv (clsMap d.le)).tsum_eq, ENNReal.tsum_sigma', ← ENNReal.tsum_mul_left]
    refine tsum_congr fun c' => ?_
    have hfin : Finite {c : ClsO O // clsMap d.le c = c'} := by
      set E := d.deepOf hdef c'
      haveI : Finite (d.X E) := Nat.finite_of_card_ne_zero (by rw [d.card_X E hdef]; exact hN)
      have he : clsOf E.D E.good = c' := d.clsOf_deepOf hdef c'
      have : Finite (d.fibre E) := Finite.of_equiv _ (d.fibreEquiv E)
      exact he ▸ this

    haveI := Fintype.ofFinite {c : ClsO O // clsMap d.le c = c'}
    rw [← ENNReal.ofReal_mul (Nat.cast_nonneg _), ← hfib c', tsum_fintype, tsum_fintype,
      ENNReal.ofReal_sum_of_nonneg fun c _ => hnn c.1]
    rfl
  have hfin1 : ∀ c : ClsO O, ENNReal.ofReal (((wt c.1.out : ℕ) : ℝ))⁻¹ ≠ ⊤ := fun _ => ENNReal.ofReal_ne_top
  have hfin2 : ∀ c : ClsO O', ENNReal.ofReal (((wt c.1.out : ℕ) : ℝ))⁻¹ ≠ ⊤ := fun _ => ENNReal.ofReal_ne_top
  have e1 : clsMass O = (∑' c : ClsO O, ENNReal.ofReal (((wt c.1.out : ℕ) : ℝ))⁻¹).toReal := by
    rw [ENNReal.tsum_toReal_eq hfin1]
    exact tsum_congr fun c => (ENNReal.toReal_ofReal (hnn c)).symm
  have e2 : clsMass O' = (∑' c : ClsO O', ENNReal.ofReal (((wt c.1.out : ℕ) : ℝ))⁻¹).toReal := by
    rw [ENNReal.tsum_toReal_eq hfin2]
    exact tsum_congr fun c => (ENNReal.toReal_ofReal (hnn' c)).symm
  rw [e1, e2, key, ENNReal.toReal_mul, ENNReal.toReal_ofReal (Nat.cast_nonneg _)]

/-- **Proposition 26.6.4** (Voight 2021, p. 445), proved: for a totally real number field $F$, orders
$\mathcal O \subseteq \mathcal O'$ of a totally definite $B = (a,b)_F$ that agree at every prime $\mathfrak q \ne \mathfrak p$,
$$\operatorname{mass}(\operatorname{Cls}\mathcal O) = [\mathcal O'^\times_{\mathfrak p} : \mathcal O^\times_{\mathfrak p}]\,
\operatorname{mass}(\operatorname{Cls}\mathcal O').$$ -/
@[kb "voight2021" "Proposition 26.6.4, p. 445"]
theorem massSuperorder (F : Type) [Field F] [NumberField F] : Wave6.MassSuperorder F := by
  intro hF a b _ _ hdef O O' hO hO' h 𝔭 hloc
  haveI := hF
  obtain ⟨m, hm0, hm𝔭, hmO⟩ := exists_conductor_scalar hO hO' 𝔭
  exact (⟨h, hO, hO', hloc, m, hm0, hm𝔭, hmO⟩ : Data O O' 𝔭).clsMass_eq hdef

end Main

/-! ### Consequences: the Eichler mass formula without inputs -/

section Consequences

/-- **Proposition 26.6.4**, the Wave 3 statement (`Wave3.MassSuborderOnePlace`), for a totally real number field
(the setting of Voight §26: the statement itself omits "totally real"). -/
@[kb "voight2021" "Proposition 26.6.4, p. 445"]
theorem massSuborderOnePlace (F : Type) [Field F] [NumberField F] [IsTotallyReal F] :
    Wave3.MassSuborderOnePlace F := by
  intro a b ha hb hdef O O' hO hO' hle v hloc
  exact massSuperorder F inferInstance a b ha hb hdef O O' hO hO' hle v hloc

/-- **Theorem 25.1.1** (Voight 2021, = Theorem 25.3.15), proved: for a definite quaternion algebra $B$ over
$\mathbb Q$ of discriminant $D$ and every maximal order $\mathcal O \subset B$,
$\sum_{[J] \in \operatorname{Cls}\mathcal O}1/w_J = \varphi(D)/12$. -/
@[kb "voight2021" "Theorem 25.1.1, p. 415; Theorem 25.3.15, p. 422"]
theorem eichlerMassFormulaRat : EichlerMassFormulaRat :=
  Wave10.eichlerMassFormulaRat_of (massSuperorder ℚ)

/-- **Theorem 25.3.18** (Voight 2021), proved: Eichler's mass formula for Eichler
orders of every level $M$ of a definite quaternion algebra over $\mathbb Q$. -/
@[kb "voight2021" "Theorem 25.3.18, p. 423"]
theorem eichlerMassFormulaEichlerOrdersRat : EichlerMassFormulaEichlerOrdersRat :=
  Wave10.eichlerMassFormulaEichlerOrdersRat_of_massSuperorder (massSuperorder ℚ)

/-- **Theorem 26.1.12** with level $R$ (maximal orders), proved for every maximal order when $\mathbb Z_F$ is a
principal ideal domain ($F$ totally real; the general case is open). -/
@[kb "voight2021" "Main Theorem 26.1.5, p. 432; Theorem 26.1.12, p. 433"]
theorem eichlerMassFormulaMaximal_pid (F : Type) [Field F] [NumberField F] [IsTotallyReal F]
    [IsPrincipalIdealRing (𝓞 F)] : EichlerMassFormulaMaximal F :=
  Wave10.eichlerMassFormulaMaximal_of (massSuperorder F)

/-- **Theorem 26.1.12** (Voight 2021), proved for a totally real number field whose ring of integers is a
principal ideal domain: Eichler's mass formula for Eichler orders of every level. -/
@[kb "voight2021" "Theorem 26.1.12, p. 433"]
theorem eichlerMassFormulaEichlerOrders_pid (F : Type) [Field F] [NumberField F] [IsTotallyReal F]
    [IsPrincipalIdealRing (𝓞 F)] : EichlerMassFormulaEichlerOrders F :=
  Wave10.eichlerMassFormulaEichlerOrders_of_massSuperorder (massSuperorder F)

/-- **Theorem 26.1.12** (Voight 2021) over every totally real number field, conditional only on the maximal-order
formula `EichlerMassFormulaMaximal F` (which is proved when $\mathbb Z_F$ is a principal ideal domain,
`eichlerMassFormulaMaximal_pid`). -/
@[kb "voight2021" "Theorem 26.1.12, p. 433"]
theorem eichlerMassFormulaEichlerOrders_of_maximal (F : Type) [Field F] [NumberField F] [IsTotallyReal F]
    (Hmax : EichlerMassFormulaMaximal F) : EichlerMassFormulaEichlerOrders F :=
  Wave10.eichlerMassFormulaEichlerOrders_of (massSuperorder F) Hmax

end Consequences

end QuadFormsKB.Voight.Wave11

