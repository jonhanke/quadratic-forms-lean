/-
# Local Eichler orders: the pair of maximal orders and the normalizer (Voight, 23.4-23.5)

Source: J. Voight, *Quaternion Algebras*, Graduate Texts in Mathematics 288, Springer 2021 (key `voight2021`): Proposition 23.4.3 (iv) (p. 382),
23.4.13 and Proposition 23.4.14 (p. 384), Lemma 23.5.2 (p. 386).

**Setting.** $R$ is a discrete valuation ring with fraction field $F$ (Lean: `K`) and uniformizer $\pi$; $B = \mathrm M_2(F)$.
*Update:* the book assumes $R$ complete ("$R$ is local", 23.2.1); completeness is never used here. Matrix entries are indexed
$0, 1$. For $j \ge 0$, $\mathcal O_j := D_j\,\mathrm M_2(R)\,D_j^{-1}$ with $D_j = \operatorname{diag}(1, \pi^j)$
(`conjMatOrder`), i.e. the matrices $\begin{pmatrix} R & \pi^{-j}R \\ \pi^jR & R\end{pmatrix}$; $\mathcal O_0 = \mathrm M_2(R)$.
The standard Eichler order of level $\pi^e$ is $\mathcal O_0(\pi^e) = \begin{pmatrix} R & R \\ \pi^eR & R\end{pmatrix}
= \mathrm M_2(R) \cap \mathcal O_e$ (`stdEichlerOrder`, `stdEichlerOrder_eq_inf`, Lemma 23.5.15).

**Contents** (all proved).
* `map_conj_matOrder_eq_iff` (**Lemma 23.5.2**, in matrix form): $P\,\mathrm M_2(R)\,P^{-1} = \mathrm M_2(R)$ iff
  $P \in F^\times\mathrm{GL}_2(R)$. With $L = R^2$ and $M = PL$ this is the book's "$\operatorname{End}_R(L) =
  \operatorname{End}_R(M)$ iff $M = aL$ for some $a \in F^\times$" ($\operatorname{End}_R(PL) = P\,\mathrm M_2(R)\,P^{-1}$,
  and $PL = aL$ iff $a^{-1}P \in \mathrm{GL}_2(R)$).
* `isMaximalOrder_and_le_iff`: the maximal orders containing $\mathcal O_0(\pi^e)$ are exactly $\mathcal O_j$,
  $0 \le j \le e$ (the vertices of the path from $[R^2]$ to $[R \oplus \pi^eR]$ in the Bruhat–Tits tree).
* `stdEichlerOrder_eq_inf_iff` and `IsEichler.eq_or_eq_of_inf_eq` (**Proposition 23.4.3 (iv)**): an Eichler order is the
  intersection of a uniquely determined (unordered) pair of maximal orders; for $\mathcal O_0(\pi^e)$ the pair is
  $\{\mathrm M_2(R), \mathcal O_e\}$.
* `alElt` (**23.4.13**): the element $\varpi = \begin{pmatrix} 0 & 1 \\ \pi^e & 0 \end{pmatrix}$ with $\varpi^2 = \pi^e$,
  which normalizes $\mathcal O_0(\pi^e)$ and exchanges $\mathrm M_2(R)$ and $\mathcal O_e$.
* `eichlerNormalizer`, `scalarUnits`, `index_scalarUnits_eichlerNormalizer` (**Proposition 23.4.14**, first part): for
  $e \ge 1$, $N_{B^\times}(\mathcal O)/(F^\times\mathcal O^\times)$ has order $2$, generated by the class of $\varpi$, so it is
  $\cong \mathbb Z/2\mathbb Z$.
-/
import QuadFormsKB.Literature.Voight.Wave4.EichlerStructure

set_option linter.unusedSectionVars false

open Matrix

noncomputable section

namespace QuadFormsKB.Voight.Wave5

open QuadFormsKB.QuatOrder QuadFormsKB.Voight.Wave3 QuadFormsKB.Voight.Wave4 IsLocalization

variable {R K : Type*} [CommRing R] [IsDomain R] [Field K] [Algebra R K] [IsFractionRing R K]

/-- Conjugation $x \mapsto PxQ$ ($Q = P^{-1}$) as an $R$-algebra map of $\mathrm M_2(F)$. -/
abbrev conjMap (P Q : Matrix (Fin 2) (Fin 2) K) (hPQ : P * Q = 1) (hQP : Q * P = 1) :
    Matrix (Fin 2) (Fin 2) K →ₐ[R] Matrix (Fin 2) (Fin 2) K :=
  ((conjAlgEquiv P Q hPQ hQP : Matrix (Fin 2) (Fin 2) K →ₐ[K] Matrix (Fin 2) (Fin 2) K).restrictScalars R)

theorem conjMap_injective {P Q : Matrix (Fin 2) (Fin 2) K} (hPQ : P * Q = 1) (hQP : Q * P = 1) :
    Function.Injective (conjMap (R := R) P Q hPQ hQP) :=
  (conjAlgEquiv P Q hPQ hQP).injective

/-- A right inverse of a matrix with a left inverse is that left inverse. -/
theorem eq_of_mul_eq_one {P Q Q' : Matrix (Fin 2) (Fin 2) K} (hQP : Q * P = 1) (hPQ' : P * Q' = 1) : Q = Q' := by
  calc Q = Q * (P * Q') := by rw [hPQ', mul_one]
    _ = Q' := by rw [← mul_assoc, hQP, one_mul]

/-- Conjugating by $P$ and then by $P^{-1}$ is the identity on subalgebras. -/
theorem map_map_conj {P Q : Matrix (Fin 2) (Fin 2) K} (hPQ : P * Q = 1) (hQP : Q * P = 1)
    {S : Subalgebra R (Matrix (Fin 2) (Fin 2) K)} : (S.map (conjMap P Q hPQ hQP)).map (conjMap Q P hQP hPQ) = S := by
  ext x
  rw [mem_map_conj hQP hPQ, mem_map_conj hPQ hQP]
  rw [show Q * (P * x * Q) * P = x by simp only [← mul_assoc, hQP, one_mul]; rw [mul_assoc, hQP, mul_one]]

theorem isInteger_algebraMap (r : R) : IsInteger R (algebraMap R K r) := ⟨r, rfl⟩

theorem algebraMap_ne_zero {r : R} (hr : r ≠ 0) : algebraMap R K r ≠ 0 :=
  (map_ne_zero_iff _ (IsFractionRing.injective R K)).2 hr

/-- `conjMatOrder hπ 0 = M_2(R)`. -/
theorem conjMatOrder_zero {π : R} (hπ : π ≠ 0) : conjMatOrder (K := K) hπ 0 = matOrder R K := by
  ext x
  rw [mem_conjMatOrder]
  have h1 : diagQ (K := K) π 0 = 1 := by ext i j; fin_cases i <;> fin_cases j <;> simp [diagQ]
  have h2 : diagP (K := K) π 0 = 1 := by ext i j; fin_cases i <;> fin_cases j <;> simp [diagP]
  rw [h1, h2, one_mul, mul_one]

/-- Membership in $\mathcal O_j$: $x_{00}, x_{11} \in R$, $\pi^j x_{01} \in R$, $\pi^{-j}x_{10} \in R$. -/
theorem mem_conjMatOrder_iff {π : R} (hπ : π ≠ 0) (j : ℕ) (x : Matrix (Fin 2) (Fin 2) K) :
    x ∈ conjMatOrder hπ j ↔ IsInteger R (x 0 0) ∧ IsInteger R (x 0 1 * algebraMap R K π ^ j) ∧
      IsInteger R ((algebraMap R K π ^ j)⁻¹ * x 1 0) ∧ IsInteger R (x 1 1) := by
  have h : algebraMap R K π ^ j ≠ 0 := pow_ne_zero _ (algebraMap_ne_zero hπ)
  rw [mem_conjMatOrder, mem_matOrder]
  have hc : ∀ i k, (diagQ π j * x * diagP π j : Matrix (Fin 2) (Fin 2) K) i k =
      ![1, (algebraMap R K π ^ j)⁻¹] i * x i k * ![1, algebraMap R K π ^ j] k := fun i k => by
    simp [Matrix.diagonal_mul, Matrix.mul_diagonal]
  simp only [Fin.forall_fin_two, hc]
  simp only [Fin.isValue, Matrix.cons_val_zero, one_mul, mul_one, Matrix.cons_val_one]
  have : (algebraMap R K π ^ j)⁻¹ * x 1 1 * algebraMap R K π ^ j = x 1 1 := by field_simp
  rw [this]; tauto

variable [IsDiscreteValuationRing R]

/-! ### Lemma 23.5.2: the normalizer of $\mathrm M_2(R)$ -/

/-- **Lemma 23.5.2** (Voight 2021), in matrix form: for $P \in \mathrm{GL}_2(F)$ (inverse $Q$),
$P\,\mathrm M_2(R)\,P^{-1} = \mathrm M_2(R)$ iff $P = c\,U$ with $c \in F^\times$ and $U \in \mathrm{GL}_2(R)$. In the book's
terms: for the lattices $L = R^2$ and $M = PL$, $\operatorname{End}_R(L) = \operatorname{End}_R(M)$ iff $M = cL$ for some
$c \in F^\times$. -/
@[kb "voight2021" "Lemma 23.5.2, p. 386"]
theorem map_conj_matOrder_eq_iff {π : R} (hπ : Irreducible π) {P Q : Matrix (Fin 2) (Fin 2) K} (hPQ : P * Q = 1)
    (hQP : Q * P = 1) :
    (matOrder R K).map (conjMap P Q hPQ hQP) = matOrder R K ↔
      ∃ (c : K) (U U' : Matrix (Fin 2) (Fin 2) R), c ≠ 0 ∧ U * U' = 1 ∧ U' * U = 1 ∧ P = c • mapR U := by
  have hπ0 := hπ.ne_zero
  constructor
  · intro h
    obtain ⟨c, e, U, U', V, V', hc, hU, hU', hV, hV', hP⟩ := exists_eq_smul_mul_diag_mul (K := K) hπ hPQ
    rw [mapR_mul, mapR_mul, mapR_diagR] at hP
    have hPQ' : P * (c⁻¹ • (mapR V' * diagQ π e * mapR U')) = 1 := by
      rw [hP, Matrix.smul_mul, Matrix.mul_smul, smul_smul, mul_inv_cancel₀ hc, one_smul]
      calc mapR (K := K) U * diagP π e * mapR V * (mapR V' * diagQ π e * mapR U')
          = mapR (K := K) U * diagP π e * (mapR V * mapR V') * diagQ π e * mapR U' := by simp only [mul_assoc]
        _ = 1 := by
          rw [← mapR_mul V, hV, mapR_one, mul_one, mul_assoc (mapR U), diagP_mul_diagQ hπ0, mul_one, ← mapR_mul, hU,
            mapR_one]
    have hQ := eq_of_mul_eq_one hQP hPQ'
    have hx : mapR U * Matrix.single (1 : Fin 2) (0 : Fin 2) (1 : K) * mapR U' ∈ matOrder R K :=
      (matOrder R K).mul_mem ((matOrder R K).mul_mem (mapR_mem_matOrder U) (single_mem_matOrder 1 0))
        (mapR_mem_matOrder U')
    rw [← h, mem_map_conj hPQ hQP] at hx
    have hconj : Q * (mapR U * Matrix.single (1 : Fin 2) (0 : Fin 2) (1 : K) * mapR U') * P =
        mapR V' * (diagQ π e * Matrix.single (1 : Fin 2) (0 : Fin 2) (1 : K) * diagP π e) * mapR V := by
      rw [hQ, hP, Matrix.smul_mul, Matrix.smul_mul, Matrix.mul_smul, smul_smul, inv_mul_cancel₀ hc, one_smul]
      calc mapR (K := K) V' * diagQ π e * mapR U' * (mapR U * Matrix.single (1 : Fin 2) (0 : Fin 2) 1 * mapR U') * (mapR U * diagP π e * mapR V)
          = mapR (K := K) V' * diagQ π e * (mapR U' * mapR U) * Matrix.single (1 : Fin 2) (0 : Fin 2) 1 * (mapR U' * mapR U) * diagP π e *
              mapR V := by simp only [mul_assoc]
        _ = _ := by rw [← mapR_mul U', hU', mapR_one]; simp only [mul_one, mul_assoc]
    rw [hconj, conj_mem_matOrder_iff hV' hV, mem_matOrder] at hx
    obtain ⟨r, hr⟩ := hx 1 0
    have h10 : (diagQ π e * Matrix.single (1 : Fin 2) (0 : Fin 2) (1 : K) * diagP π e : Matrix (Fin 2) (Fin 2) K) 1 0 = (algebraMap R K π ^ e)⁻¹ := by
      simp [Matrix.diagonal_mul, Matrix.mul_diagonal]
    rw [h10] at hr
    have he : e = 0 := by
      by_contra he
      have hpe : algebraMap R K π ^ e ≠ 0 := pow_ne_zero _ (algebraMap_ne_zero hπ0)
      have h1 : algebraMap R K (r * π ^ e) = algebraMap R K 1 := by
        rw [map_mul, map_pow, hr, map_one, inv_mul_cancel₀ hpe]
      have h2 := IsFractionRing.injective R K h1
      obtain ⟨k, rfl⟩ : ∃ k, e = k + 1 := ⟨e - 1, by omega⟩
      apply hπ.not_isUnit
      exact IsUnit.of_mul_eq_one (r * π ^ k) (by linear_combination h2)
    subst he
    refine ⟨c, U * V, V' * U', hc, ?_, ?_, ?_⟩
    · rw [mul_assoc, ← mul_assoc V, hV, one_mul, hU]
    · rw [mul_assoc, ← mul_assoc U', hU', one_mul, hV']
    · rw [hP, mapR_mul]
      congr 1
      have : diagP (K := K) π 0 = 1 := by
        ext i j; fin_cases i <;> fin_cases j <;> simp [diagP]
      rw [this, mul_one]
  · rintro ⟨c, U, U', hc, hU, hU', rfl⟩
    have hQ : Q = c⁻¹ • mapR U' := eq_of_mul_eq_one hQP (by
      rw [Matrix.smul_mul, Matrix.mul_smul, smul_smul, mul_inv_cancel₀ hc, one_smul, ← mapR_mul, hU, mapR_one])
    ext x
    rw [mem_map_conj hPQ hQP, hQ]
    rw [Matrix.smul_mul, Matrix.smul_mul, Matrix.mul_smul, smul_smul, inv_mul_cancel₀ hc, one_smul]
    exact conj_mem_matOrder_iff hU' hU x

/-! ### The maximal orders containing $\mathcal O_0(\pi^e)$ and Proposition 23.4.3 (iv) -/

/-- **The maximal orders containing $\mathcal O_0(\pi^e)$** (Voight 2021, proof of Proposition 23.4.3 and 23.5.4-23.5.15):
a subalgebra $\mathcal O' \subseteq \mathrm M_2(F)$ is a maximal order containing $\mathcal O_0(\pi^e)$ iff
$\mathcal O' = \mathcal O_j = \operatorname{diag}(1,\pi^j)\,\mathrm M_2(R)\operatorname{diag}(1,\pi^j)^{-1}$ for some
$0 \le j \le e$. -/
@[kb "voight2021" "Proposition 23.4.3, p. 382"]
theorem isMaximalOrder_and_le_iff {π : R} (hπ : Irreducible π) (e : ℕ) (O' : Subalgebra R (Matrix (Fin 2) (Fin 2) K)) :
    (IsMaximalOrder R K O' ∧ stdEichlerOrder R K π e ≤ O') ↔ ∃ j ≤ e, O' = conjMatOrder hπ.ne_zero j := by
  have hπ0 := hπ.ne_zero
  have hπK : algebraMap R K π ≠ 0 := algebraMap_ne_zero hπ0
  constructor
  · rintro ⟨hM, hle⟩
    have hO := hM.1
    have hD : ∀ r s : R, diagK r s ∈ O' := fun r s => hle (by
      rw [mem_stdEichlerOrder]
      refine ⟨fun i j => ⟨!![r, 0; 0, s] i j, rfl⟩, 0, ?_⟩
      simp)
    obtain ⟨u, hu0, hu⟩ := exists_eq_span_of_fg (entryIdeal_fg hO hD 0 1) (entryIdeal_ne_bot hO hD 0 1)
    have h1 : (1 : K) ∈ entryIdeal O' 0 1 := hle (by
      rw [mem_stdEichlerOrder]
      exact ⟨mem_matOrder.1 (single_mem_matOrder (R := R) 0 1), 0, by simp⟩)
    have hpe : algebraMap R K π ^ e ∈ entryIdeal O' 1 0 := hle (by
      rw [mem_stdEichlerOrder]
      refine ⟨fun i j => ⟨Matrix.single (1 : Fin 2) (0 : Fin 2) (π ^ e) i j, ?_⟩, 1, by simp⟩
      simp only [Matrix.single_apply]
      split_ifs <;> simp)
    have hu1 : u ∈ entryIdeal O' 0 1 := by rw [hu]; exact Submodule.mem_span_singleton_self u
    rw [hu, Submodule.mem_span_singleton] at h1
    obtain ⟨a0, ha0⟩ := h1
    have ha0' : algebraMap R K a0 * u = 1 := by rw [← Algebra.smul_def]; exact ha0
    have ha00 : a0 ≠ 0 := by rintro rfl; simp at ha0'
    obtain ⟨j, v, hv⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ha00 hπ
    have hv0 : algebraMap R K (v : R) ≠ 0 := algebraMap_ne_zero v.ne_zero
    have hu_eq : u = (algebraMap R K (v : R) * algebraMap R K π ^ j)⁻¹ := by
      rw [← map_pow, ← map_mul, ← hv]; exact eq_inv_of_mul_eq_one_right ha0'
    have hint : IsInteger R (algebraMap R K π ^ e * u) :=
      (mem_entryIdeal_diag_iff hO hD 1 _).1 (entryIdeal_mul_mem hpe hu1)
    have hje : j ≤ e := by
      obtain ⟨b, hb⟩ := hint
      by_contra hje
      push Not at hje
      have h2 : b * v * π ^ j = π ^ e := by
        apply IsFractionRing.injective R K
        rw [map_mul, map_mul, map_pow, map_pow, hb, hu_eq]
        field_simp
      obtain ⟨k, rfl⟩ : ∃ k, j = e + 1 + k := ⟨j - (e + 1), by omega⟩
      have h3 : π ^ e * (π * (b * v * π ^ k) - 1) = 0 := by linear_combination h2
      rcases mul_eq_zero.1 h3 with h | h
      · exact pow_ne_zero _ hπ0 h
      · exact hπ.not_isUnit (IsUnit.of_mul_eq_one (b * v * π ^ k) (sub_eq_zero.1 h))
    refine ⟨j, hje, ?_⟩
    have hle' : O' ≤ conjMatOrder hπ0 j := by
      intro x hx
      have hx' := (mem_iff_forall_single hD x).1 hx
      rw [mem_conjMatOrder_iff]
      refine ⟨(mem_entryIdeal_diag_iff hO hD 0 _).1 (hx' 0 0), ?_, ?_, (mem_entryIdeal_diag_iff hO hD 1 _).1 (hx' 1 1)⟩
      · have h01 := hx' 0 1
        rw [hu, Submodule.mem_span_singleton] at h01
        obtain ⟨r, hr⟩ := h01
        refine ⟨r * ↑v⁻¹, ?_⟩
        rw [map_mul, map_units_inv, ← hr, hu_eq, Algebra.smul_def]
        field_simp
      · obtain ⟨s, hs⟩ := (mem_entryIdeal_diag_iff hO hD 1 _).1 (entryIdeal_mul_mem (hx' 1 0) hu1)
        refine ⟨s * v, ?_⟩
        rw [map_mul, hs, hu_eq]
        field_simp
    have hC : IsMaximalOrder R K (conjMatOrder (K := K) hπ0 j) :=
      (isMaximalOrder_matOrder (R := R) (K := K)).map (conjAlgEquiv (diagP π j) (diagQ π j)
        (diagP_mul_diagQ hπ0 j) (diagQ_mul_diagP hπ0 j))
    exact (hM.2 _ hC.1 hle').symm
  · rintro ⟨j, hj, rfl⟩
    refine ⟨(isMaximalOrder_matOrder (R := R) (K := K)).map (conjAlgEquiv (diagP π j) (diagQ π j)
        (diagP_mul_diagQ hπ0 j) (diagQ_mul_diagP hπ0 j)), fun x hx => ?_⟩
    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hj
    rw [mem_stdEichlerOrder] at hx
    obtain ⟨hxi, r, hr⟩ := hx
    rw [mem_conjMatOrder_iff]
    refine ⟨hxi 0 0, ?_, ?_, hxi 1 1⟩
    · obtain ⟨p, hp⟩ := hxi 0 1
      exact ⟨p * π ^ j, by rw [map_mul, map_pow, hp]⟩
    · refine ⟨π ^ k * r, ?_⟩
      rw [hr, map_mul, map_mul, map_pow, map_pow, pow_add]
      field_simp

/-- **Proposition 23.4.3 (iv) for the standard Eichler order** (Voight 2021): if $\mathcal O_1, \mathcal O_2$ are maximal
orders, then $\mathcal O_0(\pi^e) = \mathcal O_1 \cap \mathcal O_2$ iff $\{\mathcal O_1, \mathcal O_2\} = \{\mathrm M_2(R), \mathcal O_e\}$. -/
@[kb "voight2021" "Proposition 23.4.3, p. 382"]
theorem stdEichlerOrder_eq_inf_iff {π : R} (hπ : Irreducible π) (e : ℕ) {O₁ O₂ : Subalgebra R (Matrix (Fin 2) (Fin 2) K)}
    (h₁ : IsMaximalOrder R K O₁) (h₂ : IsMaximalOrder R K O₂) :
    stdEichlerOrder R K π e = O₁ ⊓ O₂ ↔
      (O₁ = matOrder R K ∧ O₂ = conjMatOrder hπ.ne_zero e) ∨ (O₁ = conjMatOrder hπ.ne_zero e ∧ O₂ = matOrder R K) := by
  have hπ0 := hπ.ne_zero
  have hπK : algebraMap R K π ≠ 0 := algebraMap_ne_zero hπ0
  constructor
  · intro h
    obtain ⟨j₁, hj₁, rfl⟩ := (isMaximalOrder_and_le_iff hπ e O₁).1 ⟨h₁, h ▸ inf_le_left⟩
    obtain ⟨j₂, hj₂, rfl⟩ := (isMaximalOrder_and_le_iff hπ e O₂).1 ⟨h₂, h ▸ inf_le_right⟩
    have hmin : j₁ = 0 ∨ j₂ = 0 := by
      by_contra hne
      push Not at hne
      have hmem : ∀ j, 1 ≤ j → Matrix.single (0 : Fin 2) (1 : Fin 2) (algebraMap R K π)⁻¹ ∈ conjMatOrder (K := K) hπ0 j := by
        intro j hj
        obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hj
        rw [mem_conjMatOrder_iff]
        refine ⟨⟨0, by simp⟩, ⟨π ^ k, ?_⟩, ⟨0, by simp⟩, ⟨0, by simp⟩⟩
        simp only [Matrix.single_apply_same, map_pow, pow_add]
        field_simp
      have hx : Matrix.single (0 : Fin 2) (1 : Fin 2) (algebraMap R K π)⁻¹ ∈ stdEichlerOrder R K π e := by
        rw [h, Algebra.mem_inf]
        exact ⟨hmem _ (Nat.one_le_iff_ne_zero.2 hne.1), hmem _ (Nat.one_le_iff_ne_zero.2 hne.2)⟩
      obtain ⟨r, hr⟩ := ((mem_stdEichlerOrder.1 hx).1 0 1)
      simp only [Matrix.single_apply_same] at hr
      have : r * π = 1 := IsFractionRing.injective R K (by rw [map_mul, hr, map_one, inv_mul_cancel₀ hπK])
      exact hπ.not_isUnit (IsUnit.of_mul_eq_one_right r this)
    have hmax : j₁ = e ∨ j₂ = e := by
      by_contra hne
      push Not at hne
      obtain ⟨e', rfl⟩ : ∃ e', e = e' + 1 := ⟨e - 1, by omega⟩
      have hmem : ∀ j, j ≤ e' → Matrix.single (1 : Fin 2) (0 : Fin 2) (algebraMap R K π ^ e') ∈ conjMatOrder (K := K) hπ0 j := by
        intro j hj
        obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hj
        rw [mem_conjMatOrder_iff]
        refine ⟨⟨0, by simp⟩, ⟨0, by simp⟩, ⟨π ^ k, ?_⟩, ⟨0, by simp⟩⟩
        simp only [Matrix.single_apply_same, map_pow, pow_add]
        field_simp
      have hx : Matrix.single (1 : Fin 2) (0 : Fin 2) (algebraMap R K π ^ e') ∈ stdEichlerOrder R K π (e' + 1) := by
        rw [h, Algebra.mem_inf]
        exact ⟨hmem _ (by omega), hmem _ (by omega)⟩
      obtain ⟨r, hr⟩ := (mem_stdEichlerOrder.1 hx).2
      simp only [Matrix.single_apply_same] at hr
      have hr' : π ^ e' = π ^ (e' + 1) * r := IsFractionRing.injective R K (by rw [map_pow, hr])
      have : π ^ e' * (π * r - 1) = 0 := by linear_combination (-1 : R) * hr'
      rcases mul_eq_zero.1 this with h0 | h0
      · exact pow_ne_zero _ hπ0 h0
      · exact hπ.not_isUnit (IsUnit.of_mul_eq_one r (sub_eq_zero.1 h0))
    rcases hmin with rfl | rfl <;> rcases hmax with h' | h'
    · subst h'
      obtain rfl : j₂ = 0 := by omega
      exact Or.inl ⟨conjMatOrder_zero hπ0, rfl⟩
    · subst h'; exact Or.inl ⟨conjMatOrder_zero hπ0, rfl⟩
    · subst h'; exact Or.inr ⟨rfl, conjMatOrder_zero hπ0⟩
    · subst h'
      obtain rfl : j₁ = 0 := by omega
      exact Or.inr ⟨rfl, conjMatOrder_zero hπ0⟩
  · rintro (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩)
    · exact stdEichlerOrder_eq_inf hπ0 e
    · rw [inf_comm]; exact stdEichlerOrder_eq_inf hπ0 e

/-- **Proposition 23.4.3 (iv)** (Voight 2021): an Eichler order $\mathcal O \subseteq \mathrm M_2(F)$ is the intersection
of a uniquely determined (unordered) pair of maximal orders: if $\mathcal O = \mathcal O_1 \cap \mathcal O_2 =
\mathcal O_1' \cap \mathcal O_2'$ with all four maximal, then $\{\mathcal O_1', \mathcal O_2'\} = \{\mathcal O_1, \mathcal O_2\}$. -/
@[kb "voight2021" "Proposition 23.4.3, p. 382"]
theorem IsEichler.eq_or_eq_of_inf_eq {π : R} (hπ : Irreducible π) {O₁ O₂ O₁' O₂' : Subalgebra R (Matrix (Fin 2) (Fin 2) K)}
    (h₁ : IsMaximalOrder R K O₁) (h₂ : IsMaximalOrder R K O₂) (h₁' : IsMaximalOrder R K O₁')
    (h₂' : IsMaximalOrder R K O₂') (h : O₁ ⊓ O₂ = O₁' ⊓ O₂') :
    (O₁' = O₁ ∧ O₂' = O₂) ∨ (O₁' = O₂ ∧ O₂' = O₁) := by
  obtain ⟨e, P, Q, hPQ, hQP, hO⟩ := localEichlerStructure hπ (O₁ ⊓ O₂) ⟨O₁, O₂, h₁, h₂, rfl⟩
  set f := conjMap (R := R) Q P hQP hPQ
  have hf := conjMap_injective (R := R) hQP hPQ
  have hstd : stdEichlerOrder R K π e = (O₁ ⊓ O₂).map f := by rw [hO, map_map_conj]
  have hstd' : stdEichlerOrder R K π e = (O₁' ⊓ O₂').map f := by rw [← h, hstd]
  rw [Algebra.map_inf _ hf] at hstd hstd'
  have m₁ := h₁.map (conjAlgEquiv Q P hQP hPQ)
  have m₂ := h₂.map (conjAlgEquiv Q P hQP hPQ)
  have m₁' := h₁'.map (conjAlgEquiv Q P hQP hPQ)
  have m₂' := h₂'.map (conjAlgEquiv Q P hQP hPQ)
  have inj : ∀ {S T : Subalgebra R (Matrix (Fin 2) (Fin 2) K)}, S.map f = T.map f → S = T :=
    fun hST => Subalgebra.map_injective hf hST
  rcases (stdEichlerOrder_eq_inf_iff hπ e m₁ m₂).1 hstd with ⟨a1, a2⟩ | ⟨a1, a2⟩ <;>
    rcases (stdEichlerOrder_eq_inf_iff hπ e m₁' m₂').1 hstd' with ⟨b1, b2⟩ | ⟨b1, b2⟩
  · exact Or.inl ⟨inj (b1.trans a1.symm), inj (b2.trans a2.symm)⟩
  · exact Or.inr ⟨inj (b1.trans a2.symm), inj (b2.trans a1.symm)⟩
  · exact Or.inr ⟨inj (b1.trans a2.symm), inj (b2.trans a1.symm)⟩
  · exact Or.inl ⟨inj (b1.trans a1.symm), inj (b2.trans a2.symm)⟩

/-! ### 23.4.13: the element $\varpi$ -/

/-- **The element $\varpi$ of 23.4.13** (Voight 2021): $\varpi = \begin{pmatrix} 0 & 1 \\ \pi^e & 0 \end{pmatrix}
\in \mathcal O_0(\pi^e)$. -/
@[kb "voight2021" "23.4.13, p. 384"]
def alElt (π : R) (e : ℕ) : Matrix (Fin 2) (Fin 2) K := !![0, 1; algebraMap R K π ^ e, 0]

/-- The inverse $\varpi^{-1} = \begin{pmatrix} 0 & \pi^{-e} \\ 1 & 0 \end{pmatrix}$. -/
def alEltInv (π : R) (e : ℕ) : Matrix (Fin 2) (Fin 2) K := !![0, (algebraMap R K π ^ e)⁻¹; 1, 0]

theorem alElt_mul_alEltInv {π : R} (hπ : π ≠ 0) (e : ℕ) : alElt (K := K) π e * alEltInv π e = 1 := by
  have h : algebraMap R K π ^ e ≠ 0 := pow_ne_zero _ (algebraMap_ne_zero hπ)
  ext i j; fin_cases i <;> fin_cases j <;> simp [alElt, alEltInv, h]

theorem alEltInv_mul_alElt {π : R} (hπ : π ≠ 0) (e : ℕ) : alEltInv (K := K) π e * alElt π e = 1 := by
  have h : algebraMap R K π ^ e ≠ 0 := pow_ne_zero _ (algebraMap_ne_zero hπ)
  ext i j; fin_cases i <;> fin_cases j <;> simp [alElt, alEltInv, h]

/-- **23.4.13** (Voight 2021): $\varpi^2 = \pi^e$. -/
@[kb "voight2021" "23.4.13, p. 384"]
theorem alElt_mul_self (π : R) (e : ℕ) :
    alElt (K := K) π e * alElt π e = algebraMap K (Matrix (Fin 2) (Fin 2) K) (algebraMap R K π ^ e) := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [alElt, Matrix.algebraMap_matrix_apply]

theorem alElt_mem (π : R) (e : ℕ) : alElt (K := K) π e ∈ stdEichlerOrder R K π e := by
  rw [mem_stdEichlerOrder]
  refine ⟨fun i j => ?_, 1, by simp [alElt]⟩
  fin_cases i <;> fin_cases j
  · exact ⟨0, by simp [alElt]⟩
  · exact ⟨1, by simp [alElt]⟩
  · exact ⟨π ^ e, by simp [alElt]⟩
  · exact ⟨0, by simp [alElt]⟩

theorem alEltInv_mul_mul_alElt {π : R} (hπ : π ≠ 0) {e : ℕ} (x : Matrix (Fin 2) (Fin 2) K) :
    alEltInv π e * x * alElt π e =
      !![x 1 1, (algebraMap R K π ^ e)⁻¹ * x 1 0; algebraMap R K π ^ e * x 0 1, x 0 0] := by
  have h : algebraMap R K π ^ e ≠ 0 := pow_ne_zero _ (algebraMap_ne_zero hπ)
  conv_lhs => rw [Matrix.eta_fin_two x]
  simp only [alElt, alEltInv, Matrix.mul_fin_two]
  ext i j
  fin_cases i <;> fin_cases j <;> simp <;> field_simp

/-- **23.4.13** (Voight 2021): $\varpi$ exchanges the two maximal orders: $\varpi\,\mathrm M_2(R)\,\varpi^{-1} = \mathcal O_e$. -/
@[kb "voight2021" "23.4.13, p. 384"]
theorem map_alElt_matOrder {π : R} (hπ : π ≠ 0) (e : ℕ) :
    (matOrder R K).map (conjMap _ _ (alElt_mul_alEltInv hπ e) (alEltInv_mul_alElt hπ e)) = conjMatOrder hπ e := by
  ext x
  rw [mem_map_conj, alEltInv_mul_mul_alElt hπ, mem_matOrder, mem_conjMatOrder_iff]
  simp only [Fin.forall_fin_two, Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.head_cons]
  rw [mul_comm (algebraMap R K π ^ e)]
  tauto

/-- **23.4.13** (Voight 2021): $\varpi\,\mathcal O_e\,\varpi^{-1} = \mathrm M_2(R)$. -/
@[kb "voight2021" "23.4.13, p. 384"]
theorem map_alElt_conjMatOrder {π : R} (hπ : π ≠ 0) (e : ℕ) :
    (conjMatOrder hπ e).map (conjMap _ _ (alElt_mul_alEltInv (K := K) hπ e) (alEltInv_mul_alElt hπ e)) =
      matOrder R K := by
  have h : algebraMap R K π ^ e ≠ 0 := pow_ne_zero _ (algebraMap_ne_zero hπ)
  ext x
  rw [mem_map_conj, alEltInv_mul_mul_alElt hπ, mem_matOrder, mem_conjMatOrder_iff]
  simp only [Fin.forall_fin_two, Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.head_cons]
  have e1 : (algebraMap R K π ^ e)⁻¹ * x 1 0 * algebraMap R K π ^ e = x 1 0 := by field_simp
  have e2 : (algebraMap R K π ^ e)⁻¹ * (algebraMap R K π ^ e * x 0 1) = x 0 1 := by field_simp
  rw [e1, e2]
  tauto

/-- **23.4.13** (Voight 2021): $\varpi$ normalizes $\mathcal O_0(\pi^e)$, so $\varpi\mathcal O_0(\pi^e) =
\mathcal O_0(\pi^e)\varpi$ is a two-sided ideal. -/
@[kb "voight2021" "23.4.13, p. 384"]
theorem map_alElt_stdEichlerOrder {π : R} (hπ : π ≠ 0) (e : ℕ) :
    (stdEichlerOrder R K π e).map (conjMap _ _ (alElt_mul_alEltInv (K := K) hπ e) (alEltInv_mul_alElt hπ e)) =
      stdEichlerOrder R K π e := by
  rw [stdEichlerOrder_eq_inf hπ, Algebra.map_inf _ (conjMap_injective _ _), map_alElt_matOrder,
    map_alElt_conjMatOrder, inf_comm]

/-! ### Proposition 23.4.14: the normalizer -/

/-- **The normalizer** $N_{B^\times}(\mathcal O_0(\pi^e)) = \{g \in \mathrm{GL}_2(F) : g\,\mathcal O_0(\pi^e)\,g^{-1} =
\mathcal O_0(\pi^e)\}$. -/
@[kb "voight2021" "Proposition 23.4.14, p. 384"]
def eichlerNormalizer (R K : Type*) [CommRing R] [IsDomain R] [Field K] [Algebra R K] [IsFractionRing R K]
    (π : R) (e : ℕ) : Subgroup (Matrix (Fin 2) (Fin 2) K)ˣ where
  carrier := {g | ∀ x, x ∈ stdEichlerOrder R K π e ↔ (g : Matrix (Fin 2) (Fin 2) K) * x * ↑g⁻¹ ∈ stdEichlerOrder R K π e}
  mul_mem' {g h} hg hh x := by
    rw [hh x, hg]
    simp only [Units.val_mul, _root_.mul_inv_rev, mul_assoc]
  one_mem' x := by simp
  inv_mem' {g} hg x := by
    rw [inv_inv, hg (((g⁻¹ : (Matrix (Fin 2) (Fin 2) K)ˣ) : Matrix (Fin 2) (Fin 2) K) * x * (g : Matrix (Fin 2) (Fin 2) K))]
    rw [show (g : Matrix (Fin 2) (Fin 2) K) * (↑g⁻¹ * x * ↑g) * ↑g⁻¹ = x by simp [mul_assoc]]

/-- **The subgroup $F^\times\mathcal O^\times$** of $\mathrm{GL}_2(F)$, $\mathcal O = \mathcal O_0(\pi^e)$: the $g = c\,u$ with
$c \in F^\times$ and $u, u^{-1} \in \mathcal O$. -/
@[kb "voight2021" "Proposition 23.4.14, p. 384"]
def scalarUnits (R K : Type*) [CommRing R] [IsDomain R] [Field K] [Algebra R K] [IsFractionRing R K]
    (π : R) (e : ℕ) : Subgroup (Matrix (Fin 2) (Fin 2) K)ˣ where
  carrier := {g | ∃ c : K, c ≠ 0 ∧ c⁻¹ • (g : Matrix (Fin 2) (Fin 2) K) ∈ stdEichlerOrder R K π e ∧
    c • ((g⁻¹ : (Matrix (Fin 2) (Fin 2) K)ˣ) : Matrix (Fin 2) (Fin 2) K) ∈ stdEichlerOrder R K π e}
  mul_mem' {g h} := by
    rintro ⟨c, hc, h1, h2⟩ ⟨d, hd, h3, h4⟩
    refine ⟨c * d, mul_ne_zero hc hd, ?_, ?_⟩
    · have := (stdEichlerOrder R K π e).mul_mem h1 h3
      rw [Matrix.smul_mul, Matrix.mul_smul, smul_smul] at this
      simpa [mul_comm, mul_inv] using this
    · have := (stdEichlerOrder R K π e).mul_mem h4 h2
      rw [Matrix.smul_mul, Matrix.mul_smul, smul_smul] at this
      simpa [mul_comm] using this
  one_mem' := ⟨1, one_ne_zero, by simpa using (stdEichlerOrder R K π e).one_mem,
    by simpa using (stdEichlerOrder R K π e).one_mem⟩
  inv_mem' {g} := by
    rintro ⟨c, hc, h1, h2⟩
    refine ⟨c⁻¹, inv_ne_zero hc, ?_, ?_⟩
    · simpa using h2
    · simpa using h1

theorem scalarUnits_le (π : R) (e : ℕ) : scalarUnits R K π e ≤ eichlerNormalizer R K π e := by
  rintro g ⟨c, hc, h1, h2⟩ x
  set O := stdEichlerOrder R K π e
  have key : (g : Matrix (Fin 2) (Fin 2) K) * x * ((g⁻¹ : (Matrix (Fin 2) (Fin 2) K)ˣ) : Matrix (Fin 2) (Fin 2) K) =
      (c⁻¹ • (g : Matrix (Fin 2) (Fin 2) K)) * x * (c • ((g⁻¹ : (Matrix (Fin 2) (Fin 2) K)ˣ) : Matrix (Fin 2) (Fin 2) K)) := by
    simp only [Matrix.smul_mul, Matrix.mul_smul, smul_smul, inv_mul_cancel₀ hc, mul_inv_cancel₀ hc, one_smul]
  constructor
  · intro hx; rw [key]; exact O.mul_mem (O.mul_mem h1 hx) h2
  · intro hx
    have : x = (c • ((g⁻¹ : (Matrix (Fin 2) (Fin 2) K)ˣ) : Matrix (Fin 2) (Fin 2) K)) *
        ((g : Matrix (Fin 2) (Fin 2) K) * x * ((g⁻¹ : (Matrix (Fin 2) (Fin 2) K)ˣ) : Matrix (Fin 2) (Fin 2) K)) *
        (c⁻¹ • (g : Matrix (Fin 2) (Fin 2) K)) := by
      simp only [Matrix.smul_mul, Matrix.mul_smul, smul_smul, mul_inv_cancel₀ hc, inv_mul_cancel₀ hc, one_smul, ← mul_assoc,
        Units.inv_mul, one_mul]
      rw [mul_assoc, Units.inv_mul, mul_one]
    rw [this]; exact O.mul_mem (O.mul_mem h2 hx) h1

/-- The element $\varpi$ as a unit of $\mathrm M_2(F)$. -/
def alUnit {π : R} (hπ : π ≠ 0) (e : ℕ) : (Matrix (Fin 2) (Fin 2) K)ˣ :=
  ⟨alElt π e, alEltInv π e, alElt_mul_alEltInv hπ e, alEltInv_mul_alElt hπ e⟩

/-- Membership in the normalizer is invariance of $\mathcal O_0(\pi^e)$ under conjugation. -/
theorem mem_eichlerNormalizer_iff {π : R} {e : ℕ} (g : (Matrix (Fin 2) (Fin 2) K)ˣ) :
    g ∈ eichlerNormalizer R K π e ↔
      (stdEichlerOrder R K π e).map (conjMap (g : Matrix (Fin 2) (Fin 2) K) ↑g⁻¹ g.mul_inv g.inv_mul) =
        stdEichlerOrder R K π e := by
  constructor
  · intro hg
    ext x
    rw [mem_map_conj, hg (((g⁻¹ : (Matrix (Fin 2) (Fin 2) K)ˣ) : Matrix (Fin 2) (Fin 2) K) * x * (g : Matrix (Fin 2) (Fin 2) K))]
    rw [show (g : Matrix (Fin 2) (Fin 2) K) * (↑g⁻¹ * x * ↑g) * ↑g⁻¹ = x by
      simp only [← mul_assoc, Units.mul_inv, one_mul]; rw [mul_assoc, Units.mul_inv, mul_one]]
  · intro hg x
    conv_rhs => rw [← hg]
    rw [mem_map_conj]
    rw [show (↑g⁻¹ : Matrix (Fin 2) (Fin 2) K) * (↑g * x * ↑g⁻¹) * ↑g = x by
      simp only [← mul_assoc, Units.inv_mul, one_mul]; rw [mul_assoc, Units.inv_mul, mul_one]]

theorem alUnit_mem {π : R} (hπ : π ≠ 0) (e : ℕ) : alUnit (K := K) hπ e ∈ eichlerNormalizer R K π e := by
  rw [mem_eichlerNormalizer_iff]
  exact map_alElt_stdEichlerOrder hπ e

/-- For $e \ge 1$, $\varpi \notin F^\times\mathcal O^\times$. -/
theorem alUnit_not_mem {π : R} (hπ : Irreducible π) {e : ℕ} (he : 1 ≤ e) :
    alUnit (K := K) hπ.ne_zero e ∉ scalarUnits R K π e := by
  rintro ⟨c, hc, h1, h2⟩
  change c⁻¹ • alElt (K := K) π e ∈ _ at h1
  change c • alEltInv (K := K) π e ∈ _ at h2
  obtain ⟨t, ht⟩ := (mem_stdEichlerOrder.1 h1).1 0 1
  obtain ⟨s, hs⟩ := (mem_stdEichlerOrder.1 h2).1 0 1
  simp only [alElt, alEltInv, Matrix.smul_apply, Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero,
    Matrix.cons_val_one, Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.head_cons, smul_eq_mul, mul_one] at ht hs
  have hpe : algebraMap R K π ^ e ≠ 0 := pow_ne_zero _ (algebraMap_ne_zero hπ.ne_zero)
  have : s * t * π ^ e = 1 := IsFractionRing.injective R K (by
    rw [map_mul, map_mul, map_pow, hs, ht, map_one]; field_simp)
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le he
  exact hπ.not_isUnit (IsUnit.of_mul_eq_one (s * t * π ^ k) (by rw [← this]; ring))

/-- Composition of conjugations: conjugating by $AB$ is conjugating by $B$, then by $A$. -/
theorem map_conjMap_mul {A A' B B' : Matrix (Fin 2) (Fin 2) K} (hA : A * A' = 1) (hA' : A' * A = 1) (hB : B * B' = 1)
    (hB' : B' * B = 1) (hAB : A * B * (B' * A') = 1) (hAB' : B' * A' * (A * B) = 1)
    (S : Subalgebra R (Matrix (Fin 2) (Fin 2) K)) :
    S.map (conjMap (A * B) (B' * A') hAB hAB') = (S.map (conjMap B B' hB hB')).map (conjMap A A' hA hA') := by
  ext x
  rw [mem_map_conj, mem_map_conj, mem_map_conj]
  simp only [mul_assoc]

/-- An element of $F$ whose square is integral is integral ($R$ integrally closed). -/
theorem isInteger_of_sq {x : K} (h : IsInteger R (x ^ 2)) : IsInteger R x := by
  obtain ⟨r, hr⟩ := h
  have hint : IsIntegral R (x ^ 2) := hr ▸ isIntegral_algebraMap
  exact IsIntegrallyClosed.isIntegral_iff.1 (hint.of_pow two_pos)

/-- An element of $\mathrm{GL}_2(F)$ preserving both $\mathrm M_2(R)$ and $\mathcal O_e$ lies in $F^\times\mathcal O_0(\pi^e)^\times$. -/
theorem mem_scalarUnits_of_fix {π : R} (hπ : Irreducible π) (e : ℕ) (g : (Matrix (Fin 2) (Fin 2) K)ˣ)
    (hM : (matOrder R K).map (conjMap (g : Matrix (Fin 2) (Fin 2) K) ↑g⁻¹ g.mul_inv g.inv_mul) = matOrder R K)
    (hC : (conjMatOrder hπ.ne_zero e).map (conjMap (g : Matrix (Fin 2) (Fin 2) K) ↑g⁻¹ g.mul_inv g.inv_mul) =
      conjMatOrder hπ.ne_zero e) :
    g ∈ scalarUnits R K π e := by
  have hπ0 := hπ.ne_zero
  set G := (g : Matrix (Fin 2) (Fin 2) K)
  set G' := ((g⁻¹ : (Matrix (Fin 2) (Fin 2) K)ˣ) : Matrix (Fin 2) (Fin 2) K)
  have hGG' : G * G' = 1 := g.mul_inv
  have hG'G : G' * G = 1 := g.inv_mul
  obtain ⟨c, U, U', hc, hU, hU', hG⟩ := (map_conj_matOrder_eq_iff hπ hGG' hG'G).1 hM
  set D := diagP (K := K) π e
  set D' := diagQ (K := K) π e
  have hDD' : D * D' = 1 := diagP_mul_diagQ hπ0 e
  have hD'D : D' * D = 1 := diagQ_mul_diagP hπ0 e
  have hGD : G * D * (D' * G') = 1 := by
    rw [mul_assoc, ← mul_assoc D, hDD', one_mul, hGG']
  have hGD' : D' * G' * (G * D) = 1 := by
    rw [mul_assoc, ← mul_assoc G', hG'G, one_mul, hD'D]
  have hX : D' * (G * D) * (D' * G' * D) = 1 := by
    calc D' * (G * D) * (D' * G' * D) = D' * (G * (D * D') * G') * D := by simp only [mul_assoc]
      _ = 1 := by rw [hDD', mul_one, hGG', mul_one, hD'D]
  have hX' : D' * G' * D * (D' * (G * D)) = 1 := by
    calc D' * G' * D * (D' * (G * D)) = D' * (G' * (D * D') * G) * D := by simp only [mul_assoc]
      _ = 1 := by rw [hDD', mul_one, hG'G, mul_one, hD'D]
  have hCG : ((matOrder R K).map (conjMap D D' hDD' hD'D)).map (conjMap G G' hGG' hG'G) =
      (matOrder R K).map (conjMap D D' hDD' hD'D) := hC
  have hN : (matOrder R K).map (conjMap (D' * (G * D)) (D' * G' * D) hX hX') = matOrder R K := by
    rw [map_conjMap_mul hD'D hDD' hGD hGD' hX hX', map_conjMap_mul hGG' hG'G hDD' hD'D hGD hGD', hCG,
      map_map_conj]
  obtain ⟨c', V, V', hc', hV, hV', hG2⟩ := (map_conj_matOrder_eq_iff hπ hX hX').1 hN
  set t := c⁻¹ * c'
  have ht0 : t ≠ 0 := mul_ne_zero (inv_ne_zero hc) hc'
  have hDUD : D' * mapR U * D = t • mapR V := by
    have h1 : D' * (G * D) = c • (D' * mapR U * D) := by
      rw [hG]; simp only [Matrix.smul_mul, Matrix.mul_smul, mul_assoc]
    rw [h1] at hG2
    calc D' * mapR U * D = c⁻¹ • (c • (D' * mapR U * D)) := by rw [smul_smul, inv_mul_cancel₀ hc, one_smul]
      _ = t • mapR V := by rw [hG2, smul_smul]
  have hmd : ∀ W : Matrix (Fin 2) (Fin 2) R, (mapR (K := K) W).det = algebraMap R K W.det :=
    fun W => (RingHom.map_det (algebraMap R K) W).symm
  have hdd : D'.det * D.det = 1 := by rw [← Matrix.det_mul, hD'D, Matrix.det_one]
  have hdetU : IsUnit U.det := IsUnit.of_mul_eq_one U'.det (by rw [← Matrix.det_mul, hU, Matrix.det_one])
  have hdetV : IsUnit V.det := IsUnit.of_mul_eq_one V'.det (by rw [← Matrix.det_mul, hV, Matrix.det_one])
  have hkey : t ^ 2 * algebraMap R K V.det = algebraMap R K U.det := by
    have := congrArg Matrix.det hDUD
    rw [Matrix.det_smul, Fintype.card_fin, hmd, Matrix.det_mul, Matrix.det_mul, hmd] at this
    rw [← this]
    linear_combination (algebraMap R K U.det) * hdd
  have hunit : ∀ {r : R} (hr : IsUnit r), algebraMap R K r * algebraMap R K ↑hr.unit⁻¹ = 1 := fun hr => by
    rw [← map_mul, IsUnit.mul_val_inv, map_one]
  have ht : IsInteger R t := isInteger_of_sq ⟨U.det * ↑hdetV.unit⁻¹, by
    rw [map_mul, ← hkey, mul_assoc, hunit hdetV, mul_one]⟩
  have ht' : IsInteger R t⁻¹ := isInteger_of_sq ⟨V.det * ↑hdetU.unit⁻¹, by
    have hU0 : algebraMap R K U.det ≠ 0 := algebraMap_ne_zero hdetU.ne_zero
    have hV0 : algebraMap R K V.det ≠ 0 := algebraMap_ne_zero hdetV.ne_zero
    have hu' : algebraMap R K ↑hdetU.unit⁻¹ = (algebraMap R K U.det)⁻¹ := by
      rw [map_units_inv, IsUnit.unit_spec]
    rw [map_mul, hu', ← hkey]
    field_simp⟩
  have hO : ∀ {W W' : Matrix (Fin 2) (Fin 2) R} {s : K}, IsInteger R s →
      D' * mapR W * D = s • mapR W' → mapR (K := K) W ∈ stdEichlerOrder R K π e := by
    intro W W' s hs h
    rw [stdEichlerOrder_eq_inf hπ0, Algebra.mem_inf, mem_conjMatOrder]
    refine ⟨mapR_mem_matOrder W, ?_⟩
    change D' * mapR W * D ∈ _
    obtain ⟨s0, rfl⟩ := hs
    rw [h, algebraMap_smul]
    exact (matOrder R K).smul_mem (mapR_mem_matOrder W') s0
  refine ⟨c, hc, ?_, ?_⟩
  · have : c⁻¹ • G = mapR U := by rw [hG, smul_smul, inv_mul_cancel₀ hc, one_smul]
    rw [this]; exact hO ht hDUD
  · have hG' : G' = c⁻¹ • mapR U' := eq_of_mul_eq_one hG'G (by
      rw [hG, Matrix.smul_mul, Matrix.mul_smul, smul_smul, mul_inv_cancel₀ hc, one_smul, ← mapR_mul, hU, mapR_one])
    have : c • G' = mapR U' := by rw [hG', smul_smul, mul_inv_cancel₀ hc, one_smul]
    rw [this]
    refine hO (W' := V') ht' (eq_of_mul_eq_one (P := D' * mapR U * D) ?_ ?_)
    · calc D' * mapR U' * D * (D' * mapR U * D) = D' * (mapR U' * (D * D') * mapR U) * D := by simp only [mul_assoc]
        _ = 1 := by rw [hDD', mul_one, ← mapR_mul, hU', mapR_one, mul_one, hD'D]
    · rw [hDUD, Matrix.smul_mul, Matrix.mul_smul, smul_smul, mul_inv_cancel₀ ht0, one_smul, ← mapR_mul, hV, mapR_one]

/-- Every element of the normalizer lies in $F^\times\mathcal O^\times$ or in $F^\times\mathcal O^\times\varpi^{-1}$. -/
theorem mem_or_mul_mem_of_mem_normalizer {π : R} (hπ : Irreducible π) (e : ℕ) {g : (Matrix (Fin 2) (Fin 2) K)ˣ}
    (hg : g ∈ eichlerNormalizer R K π e) :
    g ∈ scalarUnits R K π e ∨ g * alUnit hπ.ne_zero e ∈ scalarUnits R K π e := by
  have hπ0 := hπ.ne_zero
  rw [mem_eichlerNormalizer_iff] at hg
  set G := (g : Matrix (Fin 2) (Fin 2) K)
  set f := conjMap (R := R) G ↑g⁻¹ g.mul_inv g.inv_mul
  have hf := conjMap_injective (R := R) g.mul_inv g.inv_mul
  have hmax := (isMaximalOrder_matOrder (R := R) (K := K))
  have hCmax : IsMaximalOrder R K (conjMatOrder (K := K) hπ0 e) :=
    hmax.map (conjAlgEquiv (diagP π e) (diagQ π e) (diagP_mul_diagQ hπ0 e) (diagQ_mul_diagP hπ0 e))
  have h1 := hmax.map (conjAlgEquiv G ↑g⁻¹ g.mul_inv g.inv_mul)
  have h2 := hCmax.map (conjAlgEquiv G ↑g⁻¹ g.mul_inv g.inv_mul)
  have hstd : stdEichlerOrder R K π e = (matOrder R K).map f ⊓ (conjMatOrder hπ0 e).map f := by
    rw [← Algebra.map_inf _ hf, ← stdEichlerOrder_eq_inf hπ0, hg]
  rcases (stdEichlerOrder_eq_inf_iff hπ e h1 h2).1 hstd with ⟨a1, a2⟩ | ⟨a1, a2⟩
  · exact Or.inl (mem_scalarUnits_of_fix hπ e g a1 a2)
  · right
    have e1 := map_conjMap_mul (R := R) g.mul_inv g.inv_mul (alElt_mul_alEltInv hπ0 e) (alEltInv_mul_alElt hπ0 e)
      (g * alUnit hπ0 e).mul_inv (g * alUnit hπ0 e).inv_mul
    apply mem_scalarUnits_of_fix hπ e
    · refine (e1 _).trans ?_
      rw [map_alElt_matOrder hπ0, a2]
    · refine (e1 _).trans ?_
      rw [map_alElt_conjMatOrder hπ0, a1]

/-- **Proposition 23.4.14** (Voight 2021), first part: for $e \ge 1$,
$N_{B^\times}(\mathcal O)/(F^\times\mathcal O^\times) \cong \mathbb Z/2\mathbb Z$ for $\mathcal O = \mathcal O_0(\pi^e)$, i.e.
$F^\times\mathcal O^\times$ has index $2$ in the normalizer, and the nontrivial class is that of $\varpi$
(`alUnit_mem`, `alUnit_not_mem`). -/
@[kb "voight2021" "Proposition 23.4.14, p. 384"]
theorem index_scalarUnits_eichlerNormalizer {π : R} (hπ : Irreducible π) {e : ℕ} (he : 1 ≤ e) :
    ((scalarUnits R K π e).subgroupOf (eichlerNormalizer R K π e)).index = 2 := by
  rw [Subgroup.index_eq_two_iff]
  refine ⟨⟨alUnit hπ.ne_zero e, alUnit_mem hπ.ne_zero e⟩, fun ⟨b, hb⟩ => ?_⟩
  simp only [Subgroup.mem_subgroupOf, Subgroup.coe_mul]
  rcases mem_or_mul_mem_of_mem_normalizer hπ e hb with h | h
  · refine Or.inr ⟨h, fun h' => alUnit_not_mem (K := K) hπ he ?_⟩
    have := (scalarUnits R K π e).mul_mem ((scalarUnits R K π e).inv_mem h) h'
    simpa using this
  · refine Or.inl ⟨h, fun h' => alUnit_not_mem (K := K) hπ he ?_⟩
    have := (scalarUnits R K π e).mul_mem ((scalarUnits R K π e).inv_mem h') h
    simpa using this

end QuadFormsKB.Voight.Wave5
