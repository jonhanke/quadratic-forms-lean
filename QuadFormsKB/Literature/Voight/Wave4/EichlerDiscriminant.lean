/-
# The discriminant of the standard Eichler order (Voight, 23.4.12)

Source: J. Voight, *Quaternion Algebras*, Graduate Texts in Mathematics 288, Springer 2021 (key `voight2021`), 23.4.12 (p. 384): the standard
Eichler order $\mathcal O_0(\pi^e) = \begin{pmatrix} R & R \\ \pi^e R & R\end{pmatrix} \subseteq \mathrm M_2(K)$
(`Wave3.stdEichlerOrder`) has reduced discriminant $\operatorname{discrd}\mathcal O_0(\pi^e) = \mathfrak p^e$, $\mathfrak p = \pi R$.

**Contents.** The matrices $E_{00}, E_{01}, \pi^e E_{10}, E_{11}$ (`stdEichlerBasis`; entries indexed $0,1$) form an
$R$-basis of $\mathcal O_0(\pi^e)$ (`stdEichlerBasisR`). The reduced trace of $\mathrm M_2(K)$ is the matrix trace, so
the Gram determinant of the trace form $(x,y) \mapsto \operatorname{trd}(xy)$ in this basis is
$\det(\operatorname{trd}(f_pf_q)) = -\pi^{2e}$ (`det_gram_stdEichlerBasis`). Its class modulo $(R^\times)^2$ does not depend on the
basis (`det_gram_basis`), and $\operatorname{discrd}$ is the ideal whose square is generated by this determinant, i.e.
$\operatorname{discrd}\mathcal O_0(\pi^e) = (\pi^e)$.
-/
import QuadFormsKB.Literature.Voight.Wave3.EichlerLocal

set_option linter.unusedSectionVars false

open Matrix

noncomputable section

namespace QuadFormsKB.Voight.Wave4

open QuadFormsKB.QuatOrder QuadFormsKB.Voight.Wave3 IsLocalization

variable {R K : Type*} [CommRing R] [IsDomain R] [Field K] [Algebra R K] [IsFractionRing R K]

/-- **The standard basis of $\mathcal O_0(\pi^e)$** (Voight 2021, 23.4.12): the matrices $E_{00}, E_{01}, \pi^e E_{10},
E_{11}$ of $\mathrm M_2(K)$, in this order (`Matrix.single`, 0-based indices). -/
def stdEichlerBasis (π : R) (e : ℕ) : Fin 4 → Matrix (Fin 2) (Fin 2) K :=
  ![Matrix.single 0 0 1, Matrix.single 0 1 1, Matrix.single 1 0 (algebraMap R K π ^ e), Matrix.single 1 1 1]

/-- Each matrix of `stdEichlerBasis` lies in the standard Eichler order $\mathcal O_0(\pi^e)$. -/
theorem stdEichlerBasis_mem (π : R) (e : ℕ) (i : Fin 4) :
    stdEichlerBasis (K := K) π e i ∈ stdEichlerOrder R K π e := by
  have hint : ∀ (p q : Fin 2) (r : R), (∀ i j, IsInteger R ((Matrix.single p q (algebraMap R K r) : Matrix (Fin 2) (Fin 2) K) i j)) := by
    intro p q r i j
    by_cases h : p = i ∧ q = j
    · obtain ⟨rfl, rfl⟩ := h
      exact ⟨r, by simp⟩
    · exact ⟨0, by rw [map_zero]; exact (Matrix.single_apply_of_ne _ _ _ _ _ h).symm⟩
  fin_cases i
  · refine ⟨fun i j => ?_, 0, ?_⟩
    · simpa [stdEichlerBasis] using hint 0 0 1 i j
    · simp [stdEichlerBasis]
  · refine ⟨fun i j => ?_, 0, ?_⟩
    · simpa [stdEichlerBasis] using hint 0 1 1 i j
    · simp [stdEichlerBasis]
  · refine ⟨fun i j => ?_, 1, ?_⟩
    · simpa [stdEichlerBasis, ← map_pow] using hint 1 0 (π ^ e) i j
    · simp [stdEichlerBasis]
  · refine ⟨fun i j => ?_, 0, ?_⟩
    · simpa [stdEichlerBasis] using hint 1 1 1 i j
    · simp [stdEichlerBasis]

variable {π : R} {e : ℕ}

/-- The $R$-linear combination map $(c_i) \mapsto \sum_i c_i f_i$ for $f$ = `stdEichlerBasis`. -/
def stdEichlerComb (π : R) (e : ℕ) : (Fin 4 → R) →ₗ[R] Matrix (Fin 2) (Fin 2) K :=
  Fintype.linearCombination R (stdEichlerBasis (K := K) π e)

theorem stdEichlerComb_apply (π : R) (e : ℕ) (c : Fin 4 → R) :
    stdEichlerComb (K := K) π e c = !![algebraMap R K (c 0), algebraMap R K (c 1);
      algebraMap R K (π ^ e * c 2), algebraMap R K (c 3)] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    (simp [stdEichlerComb, Fintype.linearCombination_apply, Fin.sum_univ_four, stdEichlerBasis,
      Matrix.add_apply]) <;> (try simp [Algebra.smul_def]) <;> (try ring1)

theorem stdEichlerComb_mem (π : R) (e : ℕ) (c : Fin 4 → R) :
    stdEichlerComb (K := K) π e c ∈ Subalgebra.toSubmodule (stdEichlerOrder R K π e) := by
  rw [stdEichlerComb, Fintype.linearCombination_apply]
  exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (stdEichlerBasis_mem π e i)

/-- The combination map, with codomain the submodule underlying $\mathcal O_0(\pi^e)$. -/
def stdEichlerCombS (π : R) (e : ℕ) :
    (Fin 4 → R) →ₗ[R] Subalgebra.toSubmodule (stdEichlerOrder R K π e) :=
  LinearMap.codRestrict _ (stdEichlerComb (K := K) π e) (stdEichlerComb_mem π e)

theorem stdEichlerCombS_bijective (hπ : π ≠ 0) : Function.Bijective (stdEichlerCombS (K := K) π e) := by
  have inj := IsFractionRing.injective R K
  constructor
  · intro c d h
    have h' : stdEichlerComb (K := K) π e c = stdEichlerComb π e d := congrArg Subtype.val h
    rw [stdEichlerComb_apply, stdEichlerComb_apply] at h'
    have h00 : algebraMap R K (c 0) = algebraMap R K (d 0) := congrFun (congrFun h' 0) 0
    have h01 : algebraMap R K (c 1) = algebraMap R K (d 1) := congrFun (congrFun h' 0) 1
    have h10 : algebraMap R K (π ^ e * c 2) = algebraMap R K (π ^ e * d 2) := congrFun (congrFun h' 1) 0
    have h11 : algebraMap R K (c 3) = algebraMap R K (d 3) := congrFun (congrFun h' 1) 1
    funext i
    fin_cases i
    · exact inj h00
    · exact inj h01
    · exact mul_left_cancel₀ (pow_ne_zero _ hπ) (inj h10)
    · exact inj h11
  · rintro ⟨x, hxO⟩
    obtain ⟨hxi, r, hr⟩ := hxO
    obtain ⟨r00, h00⟩ := hxi 0 0
    obtain ⟨r01, h01⟩ := hxi 0 1
    obtain ⟨r11, h11⟩ := hxi 1 1
    refine ⟨![r00, r01, r, r11], Subtype.ext ?_⟩
    change stdEichlerComb (K := K) π e _ = x
    rw [stdEichlerComb_apply]
    ext i j
    fin_cases i <;> fin_cases j
    · exact h00
    · exact h01
    · exact hr.symm
    · exact h11

/-- **The standard basis of $\mathcal O_0(\pi^e)$ as an $R$-module basis**: $\mathcal O_0(\pi^e)$ is the free $R$-module
on $E_{00}, E_{01}, \pi^e E_{10}, E_{11}$ (Voight 2021, 23.4.12). -/
def stdEichlerBasisR (hπ : π ≠ 0) (e : ℕ) :
    Module.Basis (Fin 4) R (Subalgebra.toSubmodule (stdEichlerOrder R K π e)) :=
  Module.Basis.ofEquivFun (LinearEquiv.ofBijective (stdEichlerCombS (K := K) π e) (stdEichlerCombS_bijective hπ)).symm

theorem stdEichlerBasisR_apply (hπ : π ≠ 0) (i : Fin 4) :
    ((stdEichlerBasisR (K := K) hπ e i : Subalgebra.toSubmodule (stdEichlerOrder R K π e)) :
      Matrix (Fin 2) (Fin 2) K) = stdEichlerBasis π e i := by
  rw [stdEichlerBasisR, Module.Basis.coe_ofEquivFun]
  change stdEichlerComb (K := K) π e (Pi.single i 1) = _
  rw [stdEichlerComb, Fintype.linearCombination_apply]
  simp [Pi.single_apply]

/-- **The Gram determinant of the trace form in the standard basis** (Voight 2021, 23.4.12): the reduced trace of
$\mathrm M_2(K)$ is the matrix trace, and
$\det\bigl(\operatorname{trd}(f_pf_q)\bigr)_{p,q} = -\pi^{2e}$ for $f = (E_{00}, E_{01}, \pi^e E_{10}, E_{11})$. -/
@[kb "voight2021" "23.4.12, p. 384"]
theorem det_gram_stdEichlerBasis (π : R) (e : ℕ) :
    (Matrix.of fun p q => Matrix.trace (stdEichlerBasis (K := K) π e p * stdEichlerBasis π e q)).det =
      -(algebraMap R K π ^ e) ^ 2 := by
  have : (Matrix.of fun p q => Matrix.trace (stdEichlerBasis (K := K) π e p * stdEichlerBasis π e q)) =
      !![1, 0, 0, 0; 0, 0, algebraMap R K π ^ e, 0; 0, algebraMap R K π ^ e, 0, 0; 0, 0, 0, 1] := by
    ext p q
    fin_cases p <;> fin_cases q <;>
      simp [stdEichlerBasis, Matrix.trace, Matrix.mul_apply, Fin.sum_univ_two]
  rw [this]
  simp [Matrix.det_succ_row_zero, Fin.sum_univ_succ]
  ring

/-- **Gram determinants in an arbitrary $R$-basis** (Voight 2021, 23.4.12): for any $R$-basis $f'$ of $\mathcal O_0(\pi^e)$,
$\det(\operatorname{trd}(f'_pf'_q)) = u\cdot(-\pi^{2e})$ for a unit $u \in R^\times$ (indeed $u = \det(M)^2$ for the change
of basis matrix $M$). Hence the ideal generated by this determinant, the square of $\operatorname{discrd}$, is
$(\pi^{2e})$, i.e. $\operatorname{discrd}\mathcal O_0(\pi^e) = (\pi^e)$. -/
@[kb "voight2021" "23.4.12, p. 384"]
theorem det_gram_basis (hπ : π ≠ 0)
    (f' : Module.Basis (Fin 4) R (Subalgebra.toSubmodule (stdEichlerOrder R K π e))) :
    ∃ u : Rˣ, (Matrix.of fun p q => Matrix.trace
        ((f' p : Matrix (Fin 2) (Fin 2) K) * (f' q : Matrix (Fin 2) (Fin 2) K))).det =
      algebraMap R K (u : R) * (-(algebraMap R K π ^ e) ^ 2) := by
  set b := stdEichlerBasisR (K := K) hπ e with hb
  set P := b.toMatrix f' with hP
  set G : Matrix (Fin 4) (Fin 4) K :=
    Matrix.of fun p q => Matrix.trace (stdEichlerBasis (K := K) π e p * stdEichlerBasis π e q) with hG
  have hf' : ∀ j, (f' j : Matrix (Fin 2) (Fin 2) K) =
      ∑ i, algebraMap R K (P i j) • stdEichlerBasis π e i := by
    intro j
    have := congrArg (fun x : Subalgebra.toSubmodule (stdEichlerOrder R K π e) => (x : Matrix (Fin 2) (Fin 2) K))
      (b.sum_toMatrix_smul_self f' j)
    simp only [Submodule.coe_sum, Submodule.coe_smul] at this
    rw [← this]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [algebraMap_smul]
    rw [hb, stdEichlerBasisR_apply]
  have hgram : (Matrix.of fun p q => Matrix.trace
        ((f' p : Matrix (Fin 2) (Fin 2) K) * (f' q : Matrix (Fin 2) (Fin 2) K))) =
      (P.map (algebraMap R K))ᵀ * G * P.map (algebraMap R K) := by
    ext p q
    simp only [Matrix.of_apply, hf', Matrix.mul_sum, Matrix.trace_sum, Matrix.smul_mul,
      Matrix.mul_smul, smul_smul, Matrix.trace_smul, smul_eq_mul, Matrix.mul_apply, Matrix.transpose_apply,
      Matrix.map_apply, hG, Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun i _ => ?_
    ring
  have hdet : IsUnit (P.det) := by
    have := b.isUnit_det f'
    rwa [Module.Basis.det_apply] at this
  obtain ⟨d, hd⟩ := hdet
  refine ⟨d ^ 2, ?_⟩
  have hm : (P.map (algebraMap R K)).det = algebraMap R K P.det := (RingHom.map_det (algebraMap R K) P).symm
  rw [hgram, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, det_gram_stdEichlerBasis, hm,
    Units.val_pow_eq_pow_val, hd, map_pow]
  ring1

end QuadFormsKB.Voight.Wave4