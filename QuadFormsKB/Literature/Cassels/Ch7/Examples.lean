/-
# Cassels, Chapter 7, Examples 1–3: invariant divisors and the adjoint form

**Setting.** Cassels, *Rational Quadratic Forms*, Chapter 7, Examples (p. 110): $I$ a principal ideal domain; a
classically integral form $f$ in $n$ variables is given by its symmetric matrix $F = (f_{ij}) \in M_n(I)$; $f$ and $g$
are equivalent when $G = T^{t}FT$ with $T \in \mathrm{GL}_n(I)$. Cassels' greatest common divisors (elements of
$k^{\times}/U$) are represented by the ideals they generate.

**Proves**
* `minorIdeal_equiv` (**Example 1**, first part): the ideal $t_r(f)$ generated by the $r \times r$ minors of $F$
  depends only on $r$ and the equivalence class of $f$;
* `minorIdeal'_equiv` (**Example 1**, second part): the same for $t'_r(f)$, where the non-principal minors are
  multiplied by $2$;
* `adjointForm_equiv`, `adjointForm_adjointForm` (**Example 2**): for $f$ primitive and regular, the adjoint form $f^{*}$
  ($F^{*}_{ij} = s f^{*}_{ij}$ with $\gcd(f^{*}_{ij}) = 1$, $F^{*}$ the adjugate of $F$) satisfies: (i) if $f, g$ are
  equivalent then $g^{*}$ is equivalent to $uf^{*}$ for a unit $u$; (ii) $(f^{*})^{*} = vf$ for a unit $v$;
* `exists_unique_posDef_adjointForm` (**Example 3**): for $I = \mathbb Z$ and $f$ positive definite, $f^{*}$ can be chosen
  positive definite and is then unique.

Examples 1–3 are, as Cassels says, "concepts which are important in the classical theory but which are not needed in
this book".
-/
import Mathlib
import QuadFormsKB.Citation

namespace QuadFormsKB.Cassels

open Matrix

set_option linter.unusedSectionVars false

variable {I : Type*} [CommRing I] [IsDomain I] [IsPrincipalIdealRing I] {n : ℕ}

/-- The ideal $t_r(f)$ generated by the $r \times r$ minors of $F$ (rows chosen by an injection $s$, columns by an
injection $t$; Cassels' greatest common divisor of the minors, Ch. 7, Example 1). -/
def minorIdeal (r : ℕ) (F : Matrix (Fin n) (Fin n) I) : Ideal I :=
  Ideal.span (Set.range fun st : (Fin r ↪ Fin n) × (Fin r ↪ Fin n) => (F.submatrix st.1 st.2).det)

/-- The ideal $t'_r(f)$ of Example 1: generated by the principal $r \times r$ minors of $F$ (rows and columns the same
set) and twice the non-principal ones. -/
def minorIdeal' (r : ℕ) (F : Matrix (Fin n) (Fin n) I) : Ideal I :=
  Ideal.span (Set.range fun st : (Fin r ↪ Fin n) × (Fin r ↪ Fin n) =>
    if Set.range st.1 = Set.range st.2 then (F.submatrix st.1 st.2).det else 2 * (F.submatrix st.1 st.2).det)

/-- Rectangular Cauchy–Binet (a copy of the private `det_mul_rect` of `Ch8/Bases.lean`). -/
private theorem det_mul_rect {R : Type*} [CommRing R] {m k : ℕ} (A : Matrix (Fin m) (Fin k) R)
    (B : Matrix (Fin k) (Fin m) R) :
    (A * B).det = ∑ p : Fin m → Fin k, (∏ i, A i (p i)) * (B.submatrix p id).det := by
  classical
  have key : ∀ M : Matrix (Fin m) (Fin m) R,
      M.det = ∑ σ : Equiv.Perm (Fin m), (Equiv.Perm.sign σ : ℤ) • ∏ i, M i (σ i) := by
    intro M
    rw [← Matrix.det_transpose, Matrix.det_apply]
    rfl
  rw [key (A * B)]
  have h1 : ∀ σ : Equiv.Perm (Fin m), ∏ i, (A * B) i (σ i) =
      ∑ p : Fin m → Fin k, (∏ i, A i (p i)) * ∏ i, B (p i) (σ i) := by
    intro σ
    simp_rw [Matrix.mul_apply]
    rw [Finset.prod_univ_sum, Fintype.piFinset_univ]
    refine Finset.sum_congr rfl fun p _ => ?_
    rw [Finset.prod_mul_distrib]
  simp_rw [h1, Finset.smul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [key (B.submatrix p id), Finset.mul_sum]
  refine Finset.sum_congr rfl fun σ _ => ?_
  simp only [zsmul_eq_mul, Matrix.submatrix_apply, id]
  ring

/-- Rectangular Cauchy–Binet, columns version: the minor of $AB$ expanded over the columns of $A$. -/
private theorem det_mul_rect' {R : Type*} [CommRing R] {m k : ℕ} (A : Matrix (Fin m) (Fin k) R)
    (B : Matrix (Fin k) (Fin m) R) :
    (A * B).det = ∑ q : Fin m → Fin k, (∏ i, B (q i) i) * (A.submatrix id q).det := by
  rw [← Matrix.det_transpose, Matrix.transpose_mul, det_mul_rect]
  refine Finset.sum_congr rfl fun q _ => ?_
  rw [← Matrix.det_transpose (A.submatrix id q), Matrix.transpose_submatrix]
  simp

/-- A minor with non-injective row or column selection vanishes. -/
private theorem det_submatrix_eq_zero {R : Type*} [CommRing R] {m k : ℕ} (F : Matrix (Fin k) (Fin k) R)
    (p q : Fin m → Fin k) (h : ¬ (Function.Injective p ∧ Function.Injective q)) :
    (F.submatrix p q).det = 0 := by
  by_cases hp : Function.Injective p
  · have hq : ¬ Function.Injective q := fun hq => h ⟨hp, hq⟩
    obtain ⟨i, j, hij, hne⟩ : ∃ i j, q i = q j ∧ i ≠ j := by
      simpa [Function.Injective] using hq
    exact Matrix.det_zero_of_column_eq hne (fun k => by simp [hij])
  · obtain ⟨i, j, hij, hne⟩ : ∃ i j, p i = p j ∧ i ≠ j := by
      simpa [Function.Injective] using hp
    exact Matrix.det_zero_of_row_eq hne (by ext l; simp [hij])

/-- Every minor (for arbitrary selection functions) lies in `minorIdeal`. -/
private theorem det_submatrix_mem {r : ℕ} (F : Matrix (Fin n) (Fin n) I) (p q : Fin r → Fin n) :
    (F.submatrix p q).det ∈ minorIdeal r F := by
  by_cases h : Function.Injective p ∧ Function.Injective q
  · exact Ideal.subset_span ⟨(⟨p, h.1⟩, ⟨q, h.2⟩), rfl⟩
  · rw [det_submatrix_eq_zero F p q h]
    exact Ideal.zero_mem _

private theorem minorIdeal_mul_le_right (r : ℕ) (A B : Matrix (Fin n) (Fin n) I) :
    minorIdeal r (A * B) ≤ minorIdeal r B := by
  refine Ideal.span_le.2 ?_
  rintro _ ⟨⟨s, t⟩, rfl⟩
  simp only [SetLike.mem_coe]
  rw [Matrix.submatrix_mul A B s id t Function.bijective_id, det_mul_rect]
  refine Ideal.sum_mem _ fun p _ => Ideal.mul_mem_left _ _ ?_
  have := det_submatrix_mem B (r := r) p t
  simpa [Matrix.submatrix_submatrix] using this

private theorem minorIdeal_transpose_le (r : ℕ) (F : Matrix (Fin n) (Fin n) I) :
    minorIdeal r Fᵀ ≤ minorIdeal r F := by
  refine Ideal.span_le.2 ?_
  rintro _ ⟨⟨s, t⟩, rfl⟩
  simp only [SetLike.mem_coe]
  rw [← Matrix.det_transpose, Matrix.transpose_submatrix, Matrix.transpose_transpose]
  exact det_submatrix_mem F _ _

private theorem minorIdeal_mul_le_left (r : ℕ) (A B : Matrix (Fin n) (Fin n) I) :
    minorIdeal r (A * B) ≤ minorIdeal r A := by
  calc minorIdeal r (A * B) = minorIdeal r ((Bᵀ * Aᵀ)ᵀ) := by rw [Matrix.transpose_mul]; simp
    _ ≤ minorIdeal r (Bᵀ * Aᵀ) := minorIdeal_transpose_le r _
    _ ≤ minorIdeal r Aᵀ := minorIdeal_mul_le_right r _ _
    _ ≤ minorIdeal r A := minorIdeal_transpose_le r _

/-- Conjugating back by the inverse recovers the form. -/
private theorem conj_inv (T : GL (Fin n) I) (F : Matrix (Fin n) (Fin n) I) :
    ((T⁻¹).val)ᵀ * ((T.val)ᵀ * F * T.val) * (T⁻¹).val = F := by
  have h2 : T.val * (T⁻¹).val = 1 := by simp
  have h1t : ((T⁻¹).val)ᵀ * (T.val)ᵀ = 1 := by
    rw [← Matrix.transpose_mul, h2, Matrix.transpose_one]
  calc ((T⁻¹).val)ᵀ * ((T.val)ᵀ * F * T.val) * (T⁻¹).val
      = (((T⁻¹).val)ᵀ * (T.val)ᵀ) * F * (T.val * (T⁻¹).val) := by simp only [Matrix.mul_assoc]
    _ = F := by rw [h1t, h2]; simp

private theorem minorIdeal_conj_le (r : ℕ) (T : GL (Fin n) I) (F : Matrix (Fin n) (Fin n) I) :
    minorIdeal r ((T.val)ᵀ * F * T.val) ≤ minorIdeal r F :=
  (minorIdeal_mul_le_left r _ _).trans (minorIdeal_mul_le_right r _ _)

/-- **Cassels, Ch. 7, Example 1** (first part): *for a classically integral form $f$ and $1 \le r \le n$ define
$t_r(f)$ to be the greatest common divisor of the $r \times r$ minors of the corresponding matrix $F$. Show that
$t_r(f)$ depends only on $r$ and the equivalence class of $f$.* (Here for every $r$; the g.c.d. is the ideal
`minorIdeal r F`.) -/
@[kb "cassels1978" "Ch. 7, Ex. 1, p. 110 (t_r(f))"]
theorem minorIdeal_equiv (r : ℕ) (F : Matrix (Fin n) (Fin n) I) (T : GL (Fin n) I) :
    minorIdeal r ((T.val)ᵀ * F * T.val) = minorIdeal r F := by
  refine le_antisymm (minorIdeal_conj_le r T F) ?_
  have := minorIdeal_conj_le r T⁻¹ ((T.val)ᵀ * F * T.val)
  rwa [conj_inv] at this

/-- Expansion of a minor of $T^{t}FT$ over all pairs of selection functions. -/
private theorem det_conj_expand {r : ℕ} (T F : Matrix (Fin n) (Fin n) I) (s t : Fin r → Fin n) :
    (((T)ᵀ * F * T).submatrix s t).det = ∑ p : Fin r → Fin n, ∑ q : Fin r → Fin n,
      (∏ i, T (p i) (s i)) * (∏ i, T (q i) (t i)) * (F.submatrix p q).det := by
  have h : ((T)ᵀ * F * T).submatrix s t = (Tᵀ).submatrix s id * (F * T).submatrix id t := by
    rw [Matrix.mul_assoc, Matrix.submatrix_mul _ _ s id t Function.bijective_id]
  rw [h, det_mul_rect]
  refine Finset.sum_congr rfl fun p _ => ?_
  have h2 : ((F * T).submatrix id t).submatrix p id = F.submatrix p id * T.submatrix id t := by
    rw [Matrix.submatrix_submatrix, Function.id_comp, Function.comp_id]
    exact Matrix.submatrix_mul F T p id t Function.bijective_id
  rw [h2, det_mul_rect', Finset.mul_sum]
  refine Finset.sum_congr rfl fun q _ => ?_
  rw [Matrix.submatrix_submatrix]
  simp only [Matrix.transpose_apply, Matrix.submatrix_apply, Function.comp_id, Function.id_comp, id_eq]
  ring

private theorem exists_perm_of_range_eq {r : ℕ} (s t : Fin r ↪ Fin n) (h : Set.range s = Set.range t) :
    ∃ σ : Equiv.Perm (Fin r), ∀ i, s (σ i) = t i := by
  have hex : ∀ i, ∃ j, s j = t i := fun i => by
    have : t i ∈ Set.range s := h ▸ ⟨i, rfl⟩
    exact this
  choose f hf using hex
  have hinj : Function.Injective f := fun i j hij => t.injective (by rw [← hf i, ← hf j, hij])
  exact ⟨Equiv.ofBijective f hinj.bijective_of_finite, fun i => hf i⟩

section Prime

variable (r : ℕ) (F : Matrix (Fin n) (Fin n) I)

private theorem gen_mem (s t : Fin r ↪ Fin n) :
    (if Set.range s = Set.range t then (F.submatrix s t).det else 2 * (F.submatrix s t).det) ∈ minorIdeal' r F :=
  Ideal.subset_span ⟨(s, t), rfl⟩

private theorem det_mem_of_range_eq (p q : Fin r → Fin n) (h : Set.range p = Set.range q) :
    (F.submatrix p q).det ∈ minorIdeal' r F := by
  by_cases hi : Function.Injective p ∧ Function.Injective q
  · have := gen_mem r F ⟨p, hi.1⟩ ⟨q, hi.2⟩
    simpa [h] using this
  · rw [det_submatrix_eq_zero F p q hi]
    exact Ideal.zero_mem _

private theorem two_mul_det_mem (p q : Fin r → Fin n) : 2 * (F.submatrix p q).det ∈ minorIdeal' r F := by
  by_cases h : Set.range p = Set.range q
  · exact Ideal.mul_mem_left _ _ (det_mem_of_range_eq r F p q h)
  by_cases hi : Function.Injective p ∧ Function.Injective q
  · have := gen_mem r F ⟨p, hi.1⟩ ⟨q, hi.2⟩
    simpa [h] using this
  · rw [det_submatrix_eq_zero F p q hi]
    simp

variable {r F}

/-- Twice any minor of $T^{t}FT$ lies in $t'_r(F)$. -/
private theorem two_mul_conj_mem (T : Matrix (Fin n) (Fin n) I) (s t : Fin r → Fin n) :
    2 * (((T)ᵀ * F * T).submatrix s t).det ∈ minorIdeal' r F := by
  rw [det_conj_expand, Finset.mul_sum]
  refine Ideal.sum_mem _ fun p _ => ?_
  rw [Finset.mul_sum]
  refine Ideal.sum_mem _ fun q _ => ?_
  have := Ideal.mul_mem_left (minorIdeal' r F) ((∏ i, T (p i) (s i)) * (∏ i, T (q i) (t i)))
    (two_mul_det_mem r F p q)
  convert this using 1
  ring

/-- Principal minors of $T^{t}FT$ lie in $t'_r(F)$ (for symmetric $F$). -/
private theorem conj_principal_mem (hF : Fᵀ = F) (T : Matrix (Fin n) (Fin n) I) (s : Fin r → Fin n) :
    (((T)ᵀ * F * T).submatrix s s).det ∈ minorIdeal' r F := by
  classical
  set α : (Fin r → Fin n) → I := fun p => ∏ i, T (p i) (s i) with hα
  set k : (Fin r → Fin n) → ℕ := fun p => Fintype.equivFin (Finset (Fin n)) (Finset.univ.image p) with hk
  set f : (Fin r → Fin n) × (Fin r → Fin n) → I := fun x => α x.1 * α x.2 * (F.submatrix x.1 x.2).det with hf
  have hsymm : ∀ x, f x.swap = f x := by
    intro x
    have : (F.submatrix x.2 x.1).det = (F.submatrix x.1 x.2).det := by
      rw [← Matrix.det_transpose, Matrix.transpose_submatrix, hF]
    simp only [hf, Prod.fst_swap, Prod.snd_swap, this]
    ring
  have hexp : (((T)ᵀ * F * T).submatrix s s).det = ∑ x, f x := by
    rw [det_conj_expand, ← Fintype.sum_prod_type']
  have hsplit : ∑ x, f x = ∑ x, (if k x.1 = k x.2 then f x else 0)
      + ∑ x, (if k x.1 < k x.2 then f x else 0) + ∑ x, (if k x.2 < k x.1 then f x else 0) := by
    rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun x _ => ?_
    rcases lt_trichotomy (k x.1) (k x.2) with h | h | h
    · simp [h, h.ne, not_lt.2 h.le]
    · simp [h]
    · simp [h, h.ne', not_lt.2 h.le]
  have hswap : ∑ x, (if k x.2 < k x.1 then f x else 0) = ∑ x, (if k x.1 < k x.2 then f x else 0) := by
    refine Fintype.sum_equiv (Equiv.prodComm _ _) _ _ fun x => ?_
    simp [hsymm x]
  rw [hexp, hsplit, hswap, add_assoc]
  refine Ideal.add_mem _ ?_ ?_
  · refine Ideal.sum_mem _ fun x _ => ?_
    split_ifs with h
    · have h' : Finset.univ.image x.1 = Finset.univ.image x.2 := by
        exact (Fintype.equivFin _).injective (Fin.ext h)
      have hr : Set.range x.1 = Set.range x.2 := by
        ext y
        simpa using Finset.ext_iff.1 h' y
      exact Ideal.mul_mem_left _ _ (det_mem_of_range_eq r F x.1 x.2 hr)
    · exact Ideal.zero_mem _
  · rw [← Finset.sum_add_distrib]
    refine Ideal.sum_mem _ fun x _ => ?_
    split_ifs with h
    · have := Ideal.mul_mem_left (minorIdeal' r F) (α x.1 * α x.2) (two_mul_det_mem r F x.1 x.2)
      convert this using 1
      simp only [hf]
      ring
    · simp

private theorem minorIdeal'_conj_le (hF : Fᵀ = F) (T : Matrix (Fin n) (Fin n) I) :
    minorIdeal' r ((T)ᵀ * F * T) ≤ minorIdeal' r F := by
  refine Ideal.span_le.2 ?_
  rintro _ ⟨⟨s, t⟩, rfl⟩
  simp only [SetLike.mem_coe]
  split_ifs with h
  · obtain ⟨σ, hσ⟩ := exists_perm_of_range_eq s t h
    have : ((T)ᵀ * F * T).submatrix s t = (((T)ᵀ * F * T).submatrix s s).submatrix id σ := by
      rw [Matrix.submatrix_submatrix]
      congr 1
      funext i
      exact (hσ i).symm
    rw [this, Matrix.det_permute']
    exact Ideal.mul_mem_left _ _ (conj_principal_mem hF T s)
  · exact two_mul_conj_mem T s t

end Prime

/-- **Cassels, Ch. 7, Example 1** (second part): *show also that $t'_r(f)$ has the same property, where the definition
is the same as that of $t_r(f)$ except that the non-principal minors are multiplied by $2$ before the g.c.d. is
taken.* Here $F$ is symmetric (a quadratic form). -/
@[kb "cassels1978" "Ch. 7, Ex. 1, p. 110 (t'_r(f))"]
theorem minorIdeal'_equiv (r : ℕ) {F : Matrix (Fin n) (Fin n) I} (hF : Fᵀ = F) (T : GL (Fin n) I) :
    minorIdeal' r ((T.val)ᵀ * F * T.val) = minorIdeal' r F := by
  refine le_antisymm (minorIdeal'_conj_le hF _) ?_
  have hG : ((T.val)ᵀ * F * T.val)ᵀ = (T.val)ᵀ * F * T.val := by
    rw [Matrix.transpose_mul, Matrix.transpose_mul, Matrix.transpose_transpose, hF, Matrix.mul_assoc]
  have := minorIdeal'_conj_le (r := r) hG (T⁻¹).val
  rwa [conj_inv] at this

/-- $F^{*} = sf^{*}$ with $f^{*}$ primitive: `IsAdjointForm F s Fs` says that the adjugate of $F$ is $s \cdot F^{*}$
and the entries of $F^{*}$ are coprime (Cassels' $F_{ij} = s f^{*}_{ij}$, $\gcd(f^{*}_{ij}) = 1$, Ch. 7, Example 2;
$f^{*}$ is determined by $f$ up to a unit). -/
def IsAdjointForm (F : Matrix (Fin n) (Fin n) I) (s : I) (Fs : Matrix (Fin n) (Fin n) I) : Prop :=
  F.adjugate = s • Fs ∧ Ideal.span (Set.range fun ij : Fin n × Fin n => Fs ij.1 ij.2) = ⊤

section Adjoint

/-- The ideal generated by the entries of a matrix ("$f$ primitive" means this is the unit ideal). -/
private abbrev prim (M : Matrix (Fin n) (Fin n) I) : Ideal I :=
  Ideal.span (Set.range fun ij : Fin n × Fin n => M ij.1 ij.2)

private theorem pos_of_prim {M : Matrix (Fin n) (Fin n) I} (h : prim M = ⊤) : 0 < n := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · exfalso
    have h0 : (Set.range fun ij : Fin 0 × Fin 0 => M ij.1 ij.2) = ∅ := Set.range_eq_empty _
    have h' : Ideal.span (Set.range fun ij : Fin 0 × Fin 0 => M ij.1 ij.2) = ⊤ := h
    rw [h0, Ideal.span_empty] at h'
    exact bot_ne_top h'
  · exact hn

private theorem prim_mul_mem (A B C : Matrix (Fin n) (Fin n) I) (i j : Fin n) : (A * B * C) i j ∈ prim B := by
  simp only [Matrix.mul_apply, Finset.sum_mul]
  refine Ideal.sum_mem _ fun l _ => Ideal.sum_mem _ fun k _ => ?_
  have := Ideal.mul_mem_left (prim B) (A i k * C l j) (Ideal.subset_span ⟨(k, l), rfl⟩ : B k l ∈ prim B)
  convert this using 1
  ring

private theorem prim_conj_eq_top (S : GL (Fin n) I) {Y : Matrix (Fin n) (Fin n) I} (hY : prim Y = ⊤) :
    prim ((S.val)ᵀ * Y * S.val) = ⊤ := by
  rw [eq_top_iff, ← hY]
  refine Ideal.span_le.2 ?_
  rintro _ ⟨ij, rfl⟩
  have := prim_mul_mem (((S⁻¹).val)ᵀ) ((S.val)ᵀ * Y * S.val) (S⁻¹).val ij.1 ij.2
  rwa [conj_inv] at this

private theorem prim_neg_le (M : Matrix (Fin n) (Fin n) I) : prim (-M) ≤ prim M := by
  refine Ideal.span_le.2 ?_
  rintro _ ⟨ij, rfl⟩
  exact Ideal.neg_mem_iff _ |>.2 (Ideal.subset_span ⟨ij, rfl⟩)

private theorem prim_neg_eq_top {M : Matrix (Fin n) (Fin n) I} (h : prim M = ⊤) : prim (-M) = ⊤ := by
  have := prim_neg_le (-M)
  rw [neg_neg, h] at this
  exact top_le_iff.1 this

/-- If $cX = dY$ with $X$ primitive then $d \mid c$. -/
private theorem dvd_of_smul_eq {X Y : Matrix (Fin n) (Fin n) I} {c d : I} (hX : prim X = ⊤)
    (h : c • X = d • Y) : d ∣ c := by
  have h1 : (1 : I) ∈ prim X := hX ▸ Submodule.mem_top
  have key : ∀ x ∈ prim X, c * x ∈ Ideal.span {d} := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨ij, rfl⟩ := hx
      have := congrFun (congrFun h ij.1) ij.2
      simp only [Matrix.smul_apply, smul_eq_mul] at this
      simp only
      rw [this]
      exact Ideal.mem_span_singleton.2 (dvd_mul_right _ _)
    | zero => simp
    | add x y _ _ hx hy => rw [mul_add]; exact Ideal.add_mem _ hx hy
    | smul a x _ hx => rw [smul_eq_mul, mul_left_comm]; exact Ideal.mul_mem_left _ _ hx
  simpa [Ideal.mem_span_singleton] using key 1 h1

/-- Primitive matrices that are proportional (with nonzero ratio) differ by a unit. -/
private theorem exists_unit_of_smul_eq {X Y : Matrix (Fin n) (Fin n) I} {c d : I} (hX : prim X = ⊤)
    (hY : prim Y = ⊤) (hc : c ≠ 0) (h : c • X = d • Y) : ∃ u : Iˣ, X = (u : I) • Y := by
  obtain ⟨u, hu⟩ := associated_of_dvd_dvd (dvd_of_smul_eq hY h.symm) (dvd_of_smul_eq hX h)
  refine ⟨u, ?_⟩
  ext i j
  have := congrFun (congrFun h i) j
  simp only [Matrix.smul_apply, smul_eq_mul] at this ⊢
  rw [← hu] at this
  refine mul_left_cancel₀ hc ?_
  rw [this]
  ring

private theorem adjForm_scalar_ne_zero {F : Matrix (Fin n) (Fin n) I} (hdet : F.det ≠ 0) {s : I}
    {Fs : Matrix (Fin n) (Fin n) I} (hFs : IsAdjointForm F s Fs) : s ≠ 0 := by
  rintro rfl
  have hn := pos_of_prim hFs.2
  have h := Matrix.mul_adjugate F
  rw [hFs.1, zero_smul, Matrix.mul_zero] at h
  have := congrFun (congrFun h ⟨0, hn⟩) ⟨0, hn⟩
  simp at this
  exact hdet this.symm

/-- Every nonzero matrix over a principal ideal domain is a scalar multiple of a primitive one. -/
private theorem exists_primitive_decomp (A : Matrix (Fin n) (Fin n) I) (hA : A ≠ 0) :
    ∃ (s : I) (Fs : Matrix (Fin n) (Fin n) I), s ≠ 0 ∧ A = s • Fs ∧ prim Fs = ⊤ := by
  obtain ⟨g, hg⟩ : ∃ g, prim A = Ideal.span {g} := ⟨_, (Ideal.span_singleton_generator _).symm⟩
  have hmem : ∀ i j, A i j ∈ Ideal.span {g} := fun i j => by
    rw [← hg]; exact Ideal.subset_span ⟨(i, j), rfl⟩
  choose Fs hFs using fun i j => Ideal.mem_span_singleton'.1 (hmem i j)
  have hg0 : g ≠ 0 := by
    rintro rfl
    apply hA
    ext i j
    simpa using hmem i j
  have hA' : A = g • Matrix.of Fs := by
    ext i j
    simp [← hFs i j, mul_comm]
  refine ⟨g, Matrix.of Fs, hg0, hA', ?_⟩
  have hgmem : g ∈ prim A := by rw [hg]; exact Ideal.mem_span_singleton_self g
  have key : ∀ x ∈ prim A, ∃ y ∈ prim (Matrix.of Fs), x = g * y := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨ij, rfl⟩ := hx
      exact ⟨Fs ij.1 ij.2, Ideal.subset_span ⟨ij, rfl⟩, by simp [← hFs ij.1 ij.2, mul_comm]⟩
    | zero => exact ⟨0, Ideal.zero_mem _, by simp⟩
    | add x y _ _ hx hy =>
      obtain ⟨a, ha, rfl⟩ := hx
      obtain ⟨b, hb, rfl⟩ := hy
      exact ⟨a + b, Ideal.add_mem _ ha hb, by ring⟩
    | smul c x _ hx =>
      obtain ⟨a, ha, rfl⟩ := hx
      exact ⟨c * a, Ideal.mul_mem_left _ _ ha, by simp [mul_left_comm]⟩
  obtain ⟨y, hy, hgy⟩ := key g hgmem
  have hy1 : y = 1 := mul_left_cancel₀ hg0 (by rw [← hgy, mul_one])
  rw [Ideal.eq_top_iff_one]
  rwa [hy1] at hy

end Adjoint

/-- **Cassels, Ch. 7, Example 2 (i)**: *let $f$ be primitive and regular, and $f^{*}$ its adjoint form. If $f, g$ are
equivalent, then $g^{*}$ is equivalent to $uf^{*}$ for some unit $u$ of $I$.* Here $G = T^{t}FT$; "$f$ primitive"
means the entries of $F$ generate the unit ideal. -/
@[kb "cassels1978" "Ch. 7, Ex. 2 (i), p. 110"]
theorem adjointForm_equiv {F : Matrix (Fin n) (Fin n) I} (_hF : Fᵀ = F) (hdet : F.det ≠ 0) (T : GL (Fin n) I)
    {s s' : I} {Fs Gs : Matrix (Fin n) (Fin n) I} (hFs : IsAdjointForm F s Fs)
    (hGs : IsAdjointForm ((T.val)ᵀ * F * T.val) s' Gs) :
    ∃ (u : Iˣ) (S : GL (Fin n) I), Gs = (u : I) • ((S.val)ᵀ * Fs * S.val) := by
  have h2 : T.val * (T⁻¹).val = 1 := by simp
  have h1 : (T⁻¹).val * T.val = 1 := by simp
  let S : GL (Fin n) I := ⟨((T⁻¹).val)ᵀ, (T.val)ᵀ, by rw [← Matrix.transpose_mul, h2, Matrix.transpose_one],
    by rw [← Matrix.transpose_mul, h1, Matrix.transpose_one]⟩
  have hS : S.val = ((T⁻¹).val)ᵀ := rfl
  have hadjT : (T.val).adjugate = (T.val.det) • (T⁻¹).val := by
    calc (T.val).adjugate = (T.val).adjugate * (T.val * (T⁻¹).val) := by rw [h2, Matrix.mul_one]
      _ = ((T.val).adjugate * T.val) * (T⁻¹).val := (Matrix.mul_assoc _ _ _).symm
      _ = _ := by rw [Matrix.adjugate_mul, Matrix.smul_mul, Matrix.one_mul]
  have hGform : ((T.val)ᵀ * F * T.val).adjugate = (T.val.det ^ 2 * s) • ((S.val)ᵀ * Fs * S.val) := by
    rw [Matrix.adjugate_mul_distrib, Matrix.adjugate_mul_distrib, ← Matrix.adjugate_transpose, hFs.1, hadjT, hS,
      Matrix.transpose_transpose]
    simp only [Matrix.smul_mul, Matrix.mul_smul, Matrix.transpose_smul, smul_smul]
    congr 1 <;> first | ring | simp [Matrix.mul_assoc]
  have hdetG : ((T.val)ᵀ * F * T.val).det ≠ 0 := by
    obtain ⟨w, hw⟩ := (Matrix.isUnit_iff_isUnit_det _).1 T.isUnit
    rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, ← hw]
    exact mul_ne_zero (mul_ne_zero w.ne_zero hdet) w.ne_zero
  have hs' : s' ≠ 0 := adjForm_scalar_ne_zero hdetG hGs
  have hprim : prim ((S.val)ᵀ * Fs * S.val) = ⊤ := prim_conj_eq_top S hFs.2
  obtain ⟨u, hu⟩ := exists_unit_of_smul_eq hGs.2 hprim hs' (d := T.val.det ^ 2 * s)
    (by rw [← hGs.1, hGform])
  exact ⟨u, S, hu⟩

/-- **Cassels, Ch. 7, Example 2 (ii)**: *show that $(f^{*})^{*} = vf$ for some unit $v$.* Here $f$ is primitive and
regular, $F^{\mathrm{adj}} = sF^{*}$ and $(F^{*})^{\mathrm{adj}} = s_2F^{**}$ with $F^{*}, F^{**}$ primitive. -/
@[kb "cassels1978" "Ch. 7, Ex. 2 (ii), p. 110"]
theorem adjointForm_adjointForm {F : Matrix (Fin n) (Fin n) I} (_hF : Fᵀ = F) (hdet : F.det ≠ 0)
    (hprim : Ideal.span (Set.range fun ij : Fin n × Fin n => F ij.1 ij.2) = ⊤)
    {s s₂ : I} {Fs Fss : Matrix (Fin n) (Fin n) I} (hFs : IsAdjointForm F s Fs) (hFss : IsAdjointForm Fs s₂ Fss) :
    ∃ v : Iˣ, Fss = (v : I) • F := by
  have hn : 0 < n := pos_of_prim hFs.2
  have hs : s ≠ 0 := adjForm_scalar_ne_zero hdet hFs
  by_cases h1 : n = 1
  · subst h1
    have hu : ∀ M : Matrix (Fin 1) (Fin 1) I, prim M = ⊤ → IsUnit (M 0 0) := by
      intro M hM
      have hr : (Set.range fun ij : Fin 1 × Fin 1 => M ij.1 ij.2) = {M 0 0} := by
        ext x
        simp [Prod.exists]
        exact eq_comm
      have hM' : Ideal.span (Set.range fun ij : Fin 1 × Fin 1 => M ij.1 ij.2) = ⊤ := hM
      rw [hr] at hM'
      exact Ideal.span_singleton_eq_top.1 hM'
    have ha := hu F hprim
    have hf := hu Fss hFss.2
    refine ⟨hf.unit * ha.unit⁻¹, ?_⟩
    ext i j
    rw [Subsingleton.elim i 0, Subsingleton.elim j 0]
    have hinv := ha.unit.inv_mul
    rw [ha.unit_spec] at hinv
    simp only [Matrix.smul_apply, smul_eq_mul, Units.val_mul]
    rw [mul_assoc, hinv, mul_one, hf.unit_spec]
  · have hdetFs : Fs.det ≠ 0 := by
      intro h0
      have := Matrix.det_adjugate F
      rw [hFs.1, Matrix.det_smul, h0, mul_zero] at this
      exact pow_ne_zero _ hdet this.symm
    have hs₂ : s₂ ≠ 0 := adjForm_scalar_ne_zero hdetFs hFss
    have hcard : Fintype.card (Fin n) ≠ 1 := by simpa using h1
    have hadj := Matrix.adjugate_adjugate F hcard
    rw [hFs.1, Matrix.adjugate_smul, hFss.1, smul_smul] at hadj
    obtain ⟨v, hv⟩ := exists_unit_of_smul_eq hFss.2 hprim (mul_ne_zero (pow_ne_zero _ hs) hs₂) hadj
    exact ⟨v, hv⟩

/-- **Cassels, Ch. 7, Example 3**: *suppose that $I = \mathbb Z$ and that $f$ is positive definite. Show that $f^{*}$
can be chosen so that it is positive definite and that then it is uniquely determined by $f$.* Positive definiteness
of an integer matrix is that of its image in $M_n(\mathbb R)$; $f$ is primitive and regular as in Example 2 (regular
is automatic for positive definite $f$). -/
@[kb "cassels1978" "Ch. 7, Ex. 3, p. 110"]
theorem exists_unique_posDef_adjointForm {F : Matrix (Fin n) (Fin n) ℤ} (_hF : Fᵀ = F)
    (hprim : Ideal.span (Set.range fun ij : Fin n × Fin n => F ij.1 ij.2) = ⊤)
    (hpos : (F.map (Int.cast : ℤ → ℝ)).PosDef) :
    ∃! Fs : Matrix (Fin n) (Fin n) ℤ, (∃ s, IsAdjointForm F s Fs) ∧ (Fs.map (Int.cast : ℤ → ℝ)).PosDef := by
  have hn : 0 < n := pos_of_prim hprim
  have hdetr : 0 < (F.map (Int.cast : ℤ → ℝ)).det := hpos.det_pos
  have hdetcast : ((F.det : ℤ) : ℝ) = (F.map (Int.cast : ℤ → ℝ)).det := by
    have := (Int.castRingHom ℝ).map_det F
    simpa [RingHom.mapMatrix_apply] using this
  have hdet : F.det ≠ 0 := by
    intro h
    rw [h] at hdetcast
    simp at hdetcast
    linarith
  have hadjmap : (F.adjugate).map (Int.cast : ℤ → ℝ) = (F.map (Int.cast : ℤ → ℝ)).adjugate := by
    have := (Int.castRingHom ℝ).map_adjugate F
    simpa [RingHom.mapMatrix_apply] using this
  have hadjr : (F.map (Int.cast : ℤ → ℝ)).adjugate
      = (F.map (Int.cast : ℤ → ℝ)).det • (F.map (Int.cast : ℤ → ℝ))⁻¹ := by
    have hu : IsUnit (F.map (Int.cast : ℤ → ℝ)).det := isUnit_iff_ne_zero.2 hdetr.ne'
    calc (F.map (Int.cast : ℤ → ℝ)).adjugate
        = ((F.map (Int.cast : ℤ → ℝ))⁻¹ * F.map (Int.cast : ℤ → ℝ)) * (F.map (Int.cast : ℤ → ℝ)).adjugate := by
          rw [Matrix.nonsing_inv_mul _ hu, Matrix.one_mul]
      _ = (F.map (Int.cast : ℤ → ℝ))⁻¹ * (F.map (Int.cast : ℤ → ℝ) * (F.map (Int.cast : ℤ → ℝ)).adjugate) :=
          Matrix.mul_assoc _ _ _
      _ = _ := by rw [Matrix.mul_adjugate, Matrix.mul_smul, Matrix.mul_one]
  have hposadj : ((F.adjugate).map (Int.cast : ℤ → ℝ)).PosDef := by
    rw [hadjmap, hadjr]
    exact hpos.inv.smul hdetr
  -- the sign analysis: `s • Fs` is positive definite over `ℝ`
  have hsign : ∀ (s : ℤ) (Fs : Matrix (Fin n) (Fin n) ℤ), IsAdjointForm F s Fs →
      (0 < s → (Fs.map (Int.cast : ℤ → ℝ)).PosDef) ∧ (s < 0 → ((-Fs).map (Int.cast : ℤ → ℝ)).PosDef) := by
    intro s Fs hFs
    have hs : s ≠ 0 := adjForm_scalar_ne_zero hdet hFs
    have hent : ∀ i j, ((F.adjugate i j : ℤ) : ℝ) = (s : ℝ) * (Fs i j : ℝ) := by
      intro i j
      have := congrFun (congrFun hFs.1 i) j
      simp only [Matrix.smul_apply, smul_eq_mul] at this
      rw [this]
      push_cast
      ring
    have hsr : (s : ℝ) ≠ 0 := Int.cast_ne_zero.2 hs
    constructor
    · intro hs0
      have hsr0 : (0 : ℝ) < s := Int.cast_pos.2 hs0
      have : Fs.map (Int.cast : ℤ → ℝ) = ((s : ℝ)⁻¹) • (F.adjugate).map (Int.cast : ℤ → ℝ) := by
        ext i j
        simp only [Matrix.map_apply, Matrix.smul_apply, smul_eq_mul, hent]
        field_simp
      rw [this]
      exact hposadj.smul (inv_pos.2 hsr0)
    · intro hs0
      have hsr0 : (s : ℝ) < 0 := Int.cast_lt_zero.2 hs0
      have : (-Fs).map (Int.cast : ℤ → ℝ) = (-(s : ℝ))⁻¹ • (F.adjugate).map (Int.cast : ℤ → ℝ) := by
        ext i j
        simp only [Matrix.map_apply, Matrix.smul_apply, smul_eq_mul, hent, Matrix.neg_apply]
        push_cast
        field_simp
      rw [this]
      exact hposadj.smul (inv_pos.2 (neg_pos.2 hsr0))
  have huniq : ∀ (s₁ s₂ : ℤ) (Fs₁ Fs₂ : Matrix (Fin n) (Fin n) ℤ), IsAdjointForm F s₁ Fs₁ →
      IsAdjointForm F s₂ Fs₂ → (Fs₁.map (Int.cast : ℤ → ℝ)).PosDef → (Fs₂.map (Int.cast : ℤ → ℝ)).PosDef →
      Fs₁ = Fs₂ := by
    intro s₁ s₂ Fs₁ Fs₂ h₁ h₂ p₁ p₂
    obtain ⟨u, hu⟩ := exists_unit_of_smul_eq h₁.2 h₂.2 (adjForm_scalar_ne_zero hdet h₁)
      (h₁.1.symm.trans h₂.1)
    rcases Int.units_eq_one_or u with rfl | rfl
    · simpa using hu
    · exfalso
      have i0 : Fin n := ⟨0, hn⟩
      have d₁ := p₁.diag_pos (i := i0)
      have d₂ := p₂.diag_pos (i := i0)
      have := congrFun (congrFun hu i0) i0
      simp only [Matrix.map_apply] at d₁ d₂
      simp only [Matrix.smul_apply, smul_eq_mul, Units.val_neg, Units.val_one, neg_mul, one_mul] at this
      rw [this] at d₁
      push_cast at d₁
      linarith
  obtain ⟨s, Fs₀, hs0, hA, hP⟩ := exists_primitive_decomp F.adjugate (by
    intro h
    have := Matrix.mul_adjugate F
    rw [h, Matrix.mul_zero] at this
    have := congrFun (congrFun this ⟨0, hn⟩) ⟨0, hn⟩
    simp at this
    exact hdet this.symm)
  have hadj₀ : IsAdjointForm F s Fs₀ := ⟨hA, hP⟩
  have hex : ∃ Fs : Matrix (Fin n) (Fin n) ℤ, (∃ s, IsAdjointForm F s Fs) ∧
      (Fs.map (Int.cast : ℤ → ℝ)).PosDef := by
    rcases lt_or_gt_of_ne hs0 with hneg | hpos'
    · refine ⟨-Fs₀, ⟨-s, ?_, prim_neg_eq_top hP⟩, (hsign s Fs₀ hadj₀).2 hneg⟩
      rw [hA]
      simp
    · exact ⟨Fs₀, ⟨s, hadj₀⟩, (hsign s Fs₀ hadj₀).1 hpos'⟩
  obtain ⟨Fs, ⟨s₁, hs₁⟩, hp⟩ := hex
  exact ⟨Fs, ⟨⟨s₁, hs₁⟩, hp⟩, fun Fs' ⟨⟨s₂, hs₂⟩, hp'⟩ => huniq s₂ s₁ Fs' Fs hs₂ hs₁ hp' hp⟩

end QuadFormsKB.Cassels
