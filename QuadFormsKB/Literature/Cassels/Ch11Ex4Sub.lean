/-
# Cassels, Chapter 11, Example 4: the inclusion $\subseteq$

Proves `Cassels.Ch11Ex4.Ex4Statement` (`ex4Statement_holds`): for $p$ odd and an orthogonal basis $b_j$ of $\Lambda_p$
with pairwise distinct $\lvert\phi(b_j)\rvert_p$, $\theta(\Lambda_p)$ is generated by $(\mathbb Q_p^\times)^2$ and the
$\phi(b_1)\phi(b_j)$.

**Route.** Cassels' (Ch. 8, Cor. 1 to Lemma 3.3 and the norm computation) as already formalized in the library:
$O(\Lambda_p)$ is a product of symmetries (O'Meara 92:4, `ConwaySloane.theorem18_odd`), and the norm of a root vector
$x$ is $t^2\phi(b_k)e$ with $e$ a square when $\lvert\phi(b_l)\rvert \ne \lvert\phi(b_k)\rvert$ for $l \ne k$
(`ConwaySloane.exists_rootNorm_eq`), packaged as `ConwaySloane.algorithm_odd_upper`. Here it is applied to the subgroup
of square classes generated by the stated generators.
-/
import QuadFormsKB.Literature.Cassels.Ch11Examples4
import QuadFormsKB.Literature.ConwaySloane.Section9RootNorms

open Matrix NumberField IsDedekindDomain QuadFormsKB.Siegel

noncomputable section

namespace QuadFormsKB.Cassels.Ch11Ex4

open QuadFormsKB Lattices

variable {F : Type} [Field F] [NumberField F] {n : ℕ}

/-- Helper: the inclusion $\subseteq$ of Example 4 over a number field $F$. Arguments: `Q` the nondegenerate form
(`hQ`), `v` the prime with `h2` ($\mathfrak p \nmid 2$), `L` the lattice with orthogonal basis `γ` (`hγ`, `horth`),
`i₀` the index of $b_1$, `hdist` the pairwise distinctness of $\lvert Q(b_j)\rvert_v$. -/
theorem ex4_sub (Q : QuadForm F n) (hQ : Q.Nondegenerate) (v : HeightOneSpectrum (𝓞 F))
    (h2 : (2 : 𝓞 F) ∉ v.asIdeal) (L : Lattices.Lat F n) (γ : GL (Fin n) (v.adicCompletion F))
    (hγ : Lattices.loc v L.1 = Lattices.locAct v γ (Lattices.std v))
    (horth : ∀ k l, k ≠ l → Lattices.locGram Q v γ k l = 0) (i₀ : Fin n)
    (hdist : ∀ i j, i ≠ j → Valued.v (Q.evalIn (v.adicCompletion F) (γ.val *ᵥ Pi.single i 1)) ≠
      Valued.v (Q.evalIn (v.adicCompletion F) (γ.val *ᵥ Pi.single j 1))) :
    Lattices.localSpinorNormGroup Q hQ v L ≤ Subgroup.closure (ex4Gens Q v γ i₀) := by
  intro A hA
  set C := Subgroup.closure (ex4Gens Q v γ i₀) with hC
  have hne : ∀ k, Q.evalIn (v.adicCompletion F) (γ.val *ᵥ Pi.single k 1) ≠ 0 := fun k h0 =>
    Lattices.locGram_ne_zero_of_diag hQ horth k (by rw [← ex4_two_mul_eval, h0, mul_zero])
  have hgen : ∀ k, Units.mk0 (Q.evalIn (v.adicCompletion F) (γ.val *ᵥ Pi.single i₀ 1) *
      Q.evalIn (v.adicCompletion F) (γ.val *ᵥ Pi.single k 1)) (mul_ne_zero (hne i₀) (hne k)) ∈ C := by
    intro k
    apply Subgroup.subset_closure
    by_cases hk : k = i₀
    · left
      refine ⟨Units.mk0 _ (hne i₀), ?_⟩
      subst hk
      ext; simp [sq]
    · right
      exact ⟨k, hk, by simp⟩
  set H : Subgroup (SqClass (v.adicCompletion F)) := C.map (sqClassHom (v.adicCompletion F)) with hH
  have hpair : ∀ k l, sqClassOf (Q.evalIn (v.adicCompletion F) (γ.val *ᵥ Pi.single k 1) *
      Q.evalIn (v.adicCompletion F) (γ.val *ᵥ Pi.single l 1)) ∈ H := by
    intro k l
    rw [sqClassOf_of_ne_zero (mul_ne_zero (hne k) (hne l))]
    refine ⟨_, C.mul_mem (hgen k) (hgen l), ?_⟩
    rw [sqClassHom_apply]
    have : (Units.mk0 _ (mul_ne_zero (hne i₀) (hne k)) * Units.mk0 _ (mul_ne_zero (hne i₀) (hne l)) :
        (v.adicCompletion F)ˣ) =
        Units.mk0 _ (mul_ne_zero (hne k) (hne l)) * (Units.mk0 _ (hne i₀)) ^ 2 := by
      ext; simp only [Units.val_mul, Units.val_mk0, Units.val_pow_eq_pow_val]; ring_nf
    rw [this, SqClass.mk_mul, (SqClass.mk_eq_one_iff _).mpr ⟨Units.mk0 _ (hne i₀), rfl⟩, mul_one]
  have hunits : (∃ k l, k ≠ l ∧ Valued.v (Q.evalIn (v.adicCompletion F) (γ.val *ᵥ Pi.single k 1)) =
      Valued.v (Q.evalIn (v.adicCompletion F) (γ.val *ᵥ Pi.single l 1))) →
      ∀ u : v.adicCompletion F, Valued.v u = 1 → sqClassOf u ∈ H := by
    rintro ⟨k, l, hkl, heq⟩
    exact absurd heq (hdist k l hkl)
  obtain ⟨g, hg, hgA⟩ := ConwaySloane.algorithm_odd_upper hQ h2 L hγ horth H hpair hunits hA
  rw [sqClassHom_apply] at hgA
  obtain ⟨y, hy⟩ := (QuotientGroup.eq (s := (powMonoidHom 2 : (v.adicCompletion F)ˣ →* _).range)).mp hgA
  have hAeq : A = g * y ^ 2 := by
    have h1 : y ^ 2 = g⁻¹ * A := by simpa using hy
    rw [h1]; group
  rw [hAeq]
  exact C.mul_mem hg (Subgroup.subset_closure (Or.inl ⟨y, rfl⟩))

/-- **Cassels, Ch. 11, Example 4** (p. 252), full statement, proved: the inclusion $\subseteq$ of `Ex4Statement`
is `ex4_sub` (from the odd-prime algorithm for the automorphous numbers, `ConwaySloane.algorithm_odd_upper`, the
distinctness hypothesis making its unit-class clause vacuous), and $\supseteq$ is `ex4_closure_le`. -/
@[kb "cassels1978" "Ch. 11, Ex. 4, p. 252 (proved)"]
theorem ex4Statement_holds : Ex4Statement := by
  refine ⟨fun n hn Q hQ v h2 L γ hγ horth hdist => ?_⟩
  rw [← ConwaySloane.instAlgebraAdicCompletion_rat_eq v] at hdist
  exact le_antisymm (ex4_sub Q hQ v h2 L γ hγ horth ⟨0, hn⟩ hdist)
    ((Subgroup.closure_le _).mpr fun u hu =>
      ex4_closure_le Q hQ v h2 L γ hγ horth ⟨0, hn⟩ (Subgroup.subset_closure hu))

end QuadFormsKB.Cassels.Ch11Ex4
