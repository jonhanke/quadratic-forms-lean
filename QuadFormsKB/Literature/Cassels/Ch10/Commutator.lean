/-
# Cassels, Chapter 10, Lemma 3.3: generators of the commutator subgroup $\Omega(V)$

**Setting.** O'Meara's abstract quadratic spaces (`QuadFormsKB.OMeara`): a field $F$ of characteristic $\ne 2$, a
finite-dimensional regular quadratic space $(V, Q)$ (`(QuadraticMap.associated Q).Nondegenerate`), the orthogonal
group $O(V)$ = `orth Q`, symmetries $\tau_a$ = `symmetry Q a ha`, and $\Omega(V) = [O(V), O(V)]$ = `omega Q`.

**Proves** Cassels, Ch. 10, Lemma 3.3 (p. 179, `omega_eq_closure_symmCommutators`): $\Omega(V)$ is generated by the
commutators $[\tau_a, \tau_b] = \tau_a\tau_b\tau_a^{-1}\tau_b^{-1}$ ($\phi(a), \phi(b) \ne 0$).

**Proof** (as in the book): the symmetries generate $O(V)$ (Cartan–Dieudonné, O'Meara 43:3,
`OMeara.exists_symmetry_prod_eq_length_le`), so by Lemma 3.2 (`commutator_eq_normalClosure`, `Ch10/Clifford.lean`)
$\Omega(V)$ is the normal closure of the $[\tau_a, \tau_b]$; this set is closed under conjugation by $O(V)$ since
$\sigma\tau_a\sigma^{-1} = \tau_{\sigma a}$ (`OMeara.Sp55.conj_symmetry`), so the normal closure is the closure.
-/
import QuadFormsKB.Literature.OMeara.Sec55
import QuadFormsKB.Literature.Cassels.Ch10.Clifford

open QuadraticMap Module
open scoped commutatorElement

namespace QuadFormsKB.Cassels

set_option linter.unusedSectionVars false

open QuadFormsKB.OMeara

variable {F : Type*} [Field F] [Invertible (2 : F)] {V : Type*} [AddCommGroup V] [Module F V]
  [FiniteDimensional F V] (Q : QuadraticForm F V)

/-- The set of commutators $[\tau_a, \tau_b]$ of symmetries ($Q(a), Q(b) \ne 0$). -/
def symmCommutators : Set (V ≃ₗ[F] V) :=
  {g | ∃ a b : V, ∃ (ha : Q a ≠ 0) (hb : Q b ≠ 0), g = ⁅symmetry Q a ha, symmetry Q b hb⁆}

/-- **Cassels, Ch. 10, Lemma 3.3, p. 179.** For a regular quadratic space $V$ over a field of characteristic $\ne 2$,
the commutator subgroup $\Omega(V)$ of $O(V)$ is generated by the commutators $[\tau_a, \tau_b]$ of symmetries. -/
@[kb "cassels1978" "Ch. 10, Lemma 3.3, p. 179"]
theorem omega_eq_closure_symmCommutators (hQ : (QuadraticMap.associated Q).Nondegenerate) :
    omega Q = Subgroup.closure (symmCommutators Q) := by
  -- the symmetries generate `O(V)` (Cartan–Dieudonné)
  set B : Set (orth Q) := {g | ∃ a : V, ∃ ha : Q a ≠ 0, (g : V ≃ₗ[F] V) = symmetry Q a ha}
  have hB : Subgroup.closure B = ⊤ := by
    rw [eq_top_iff]
    rintro ⟨σ, hσ⟩ -
    obtain ⟨l, hl, hσl, -⟩ := exists_symmetry_prod_eq_length_le Q hQ hσ
    have key : ∀ l : List V, ∀ hl : ∀ u ∈ l, Q u ≠ 0, ∃ g ∈ Subgroup.closure B,
        (g : V ≃ₗ[F] V) = (l.attach.map fun u => symmetry Q u.1 (hl u.1 u.2)).prod := by
      intro l
      induction l with
      | nil => intro hl; exact ⟨1, Subgroup.one_mem _, by simp⟩
      | cons a l ih =>
        intro hl
        obtain ⟨g, hg, hgl⟩ := ih (fun u hu => hl u (List.mem_cons_of_mem a hu))
        refine ⟨⟨symmetry Q a (hl a (List.mem_cons_self ..)), symmetry_mem_orth Q _⟩ * g,
          Subgroup.mul_mem _ (Subgroup.subset_closure ⟨a, hl a (List.mem_cons_self ..), rfl⟩) hg, ?_⟩
        simp only [Subgroup.coe_mul, hgl, List.attach_cons, List.map_cons, List.map_map, List.prod_cons]
        rfl
    obtain ⟨g, hg, hgσ⟩ := key l hl
    have : g = ⟨σ, hσ⟩ := Subtype.ext (hgσ.trans hσl.symm)
    exact this ▸ hg
  set T : Set (orth Q) := {g | ∃ b₁ ∈ B, ∃ b₂ ∈ B, g = ⁅b₁, b₂⁆}
  have h32 : commutator (orth Q) = Subgroup.normalClosure T := commutator_eq_normalClosure hB
  -- `T` is closed under conjugation, so its normal closure is its closure
  have hconj : Group.conjugatesOfSet T ⊆ T := by
    intro x hx
    obtain ⟨y, ⟨b₁, ⟨a, ha, h1⟩, b₂, ⟨b, hb, h2⟩, rfl⟩, hy⟩ := Group.mem_conjugatesOfSet_iff.1 hx
    obtain ⟨c, rfl⟩ := isConj_iff.1 hy
    refine ⟨c * b₁ * c⁻¹, ⟨c.1 a, by rw [c.2 a]; exact ha, ?_⟩, c * b₂ * c⁻¹,
      ⟨c.1 b, by rw [c.2 b]; exact hb, ?_⟩, conjugate_commutatorElement _ _ _⟩
    · simp only [Subgroup.coe_mul, Subgroup.coe_inv, h1]; exact Sp55.conj_symmetry Q c.2 ha
    · simp only [Subgroup.coe_mul, Subgroup.coe_inv, h2]; exact Sp55.conj_symmetry Q c.2 hb
  have hnc : Subgroup.normalClosure T = Subgroup.closure T :=
    le_antisymm (Subgroup.closure_le _ |>.2 (hconj.trans Subgroup.subset_closure))
      (Subgroup.closure_mono Group.subset_conjugatesOfSet)
  have hc : omega Q = (commutator (orth Q)).map (orth Q).subtype := by
    rw [commutator, Subgroup.map_commutator, ← MonoidHom.range_eq_map, Subgroup.range_subtype]; rfl
  rw [hc, h32, hnc, MonoidHom.map_closure]
  congr 1
  ext g
  constructor
  · rintro ⟨_, ⟨b₁, ⟨a, ha, h1⟩, b₂, ⟨b, hb, h2⟩, rfl⟩, rfl⟩
    exact ⟨a, b, ha, hb, by rw [map_commutatorElement]; simp only [Subgroup.coe_subtype, h1, h2]⟩
  · rintro ⟨a, b, ha, hb, rfl⟩
    refine ⟨⁅⟨_, symmetry_mem_orth Q ha⟩, ⟨_, symmetry_mem_orth Q hb⟩⁆,
      ⟨_, ⟨a, ha, rfl⟩, _, ⟨b, hb, rfl⟩, rfl⟩, ?_⟩
    rw [map_commutatorElement]; rfl

end QuadFormsKB.Cassels
