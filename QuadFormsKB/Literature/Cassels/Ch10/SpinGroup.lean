/-
# Cassels, Chapter 10, §3: the corollaries of Theorem 3.1, the spinor norm, the spin group

**Setting.** As in `Ch10/Clifford.lean` and `Ch10/Spin.lean`: a field $k$ of characteristic $\ne 2$, a
finite-dimensional regular quadratic space $(V, Q)$ (`(QuadraticMap.associated Q).Nondegenerate`), the Clifford algebra
$C(V)$ = `CliffordAlgebra Q` with $\vec x$ identified with $\iota(\vec x)$, $C_0(V)$ = `evenOdd Q 0`, the canonical
involution $u \mapsto u'$ = `reverse`, Cassels' $M_0(V)$ = `M0 Q`, $T_u\vec x = u\vec x u^{-1}$ = `conjM0`/`conjHom`.
O'Meara's notation for the orthogonal groups: $O^+(V)$ = `orthPlus Q`, $\Theta$ = O'Meara's $O'(V)$ = `orthPrime Q`,
$\Omega(V)$ = `omega Q`, the spinor norm `OMeara.spinorNormHom` (defined through factorizations into symmetries,
`HasSpinorNorm`).

**The spin group.** Cassels (p. 181) defines $\operatorname{Spin}(V)$ as the $u$ with (i) $u \in C_0(V)$,
(ii) $uu' = 1$, (iii) $u\vec x u' \in V$ for all $\vec x \in V$. The library uses Mathlib's `spinGroup Q` (the even
elements of the Lipschitz group, generated by invertible vectors, with $\bar u u = u\bar u = 1$);
`mem_spinGroup_iff` proves that for $V \ne 0$ it is exactly Cassels' group. (For $V = 0$ Cassels' conditions give
$\{\pm 1\}$ while `spinGroup Q` is $\{1\}$; Cassels' spaces have $n \ge 1$, so `[Nontrivial V]` is assumed.)

**Proves** (Cassels, *Rational Quadratic Forms*, Ch. 10, §3)
* Corollary 1 to Theorem 3.1 (p. 177): every $u \in M_0(V)$ is $l\,\vec a_1\cdots\vec a_r$ with $l \in k^\times$,
  $\vec a_j \in V$ anisotropic and $r$ even, and $uu' \in k^\times$ (`exists_eq_smul_vecProd`, `M0_mul_reverse`);
* Corollary 3 (p. 178): the spinor norm of $T_u$ is $uu'(k^\times)^2$ (`hasSpinorNorm_conjM0`,
  `spinorNormHom_conjM0`), and (3.7 bis) $\Theta = \{T_u : uu' = 1\}$ (`mem_orthPrime_iff_exists_M0`);
* the definition of $\operatorname{Spin}(V)$ (p. 181, `mem_spinGroup_iff`);
* Theorem 3.3 (p. 181): $u \mapsto T_u$ (`spinConj`) maps $\operatorname{Spin}(V)$ onto $\Theta$
  (`range_spinConj`) with kernel $\{1, -1\}$ (`spinConj_eq_one_iff`);
* Lemma 3.4 (p. 181): for $n > 1$, if $u \in \operatorname{Spin}(V)$ and $T_u \in \Omega(V)$ then $u$ is a product of
  commutators $\vec a\vec b\vec a^{-1}\vec b^{-1}$ of anisotropic vectors (`mem_closure_vecCommutators`).

**Proof notes.** Corollary 1: $T_u$ is a rotation, hence $T_u = T_w$ with $w = \vec a_1\cdots\vec a_r$, $r$ even
(Cartan–Dieudonné, `exists_M0_of_orthPlus`), and $uw^{-1}$ is even and commutes with $V$, so it is a scalar
(Lemma 2.3). Lemma 3.4 follows Cassels: $\Omega$ is generated by the $[\tau_{\vec a}, \tau_{\vec b}] =
T_{[\vec a, \vec b]}$ (Lemma 3.3), so $u = l\,w$ with $w$ a product of commutators and $l = \pm 1$; and
$-1 = [\vec a, \vec b]$ for orthogonal anisotropic $\vec a, \vec b$.
-/
import QuadFormsKB.Literature.Cassels.Ch10.Spin
import QuadFormsKB.Literature.Cassels.Ch10.Commutator
import Mathlib.LinearAlgebra.CliffordAlgebra.SpinGroup

open Module CliffordAlgebra
open scoped commutatorElement

namespace QuadFormsKB.Cassels

set_option linter.unusedSectionVars false

open QuadFormsKB.OMeara

variable {k V : Type*} [Field k] [Invertible (2 : k)] [AddCommGroup V] [Module k V]
  [FiniteDimensional k V] {Q : QuadraticForm k V}

/-! ### Corollaries 1 and 3 to Theorem 3.1 -/

theorem conjM0_mem_orthPlus (hQ : (QuadraticMap.associated Q).Nondegenerate) (u : M0 Q) :
    conjM0 u ∈ orthPlus Q := by
  rw [← range_conjM0 hQ]; exact ⟨u, rfl⟩

/-- **Cassels, Ch. 10, Theorem 3.1, Corollary 1** (p. 177), first part. Every $u \in M_0(V)$ is
$u = l\,\vec a_1\cdots\vec a_r$ with $l \in k^\times$, anisotropic $\vec a_j \in V$ and $r$ even; moreover
$T_u = T_{\vec a_1\cdots\vec a_r}$. (Cassels absorbs $l$ into $\vec a_1$; here $r = 0$ is allowed.) -/
@[kb "cassels1978" "Ch. 10, Thm. 3.1, Cor. 1, p. 177 (u = l a₁ ⋯ a_r, r even)"]
theorem exists_eq_smul_vecProd (hQ : (QuadraticMap.associated Q).Nondegenerate) (u : M0 Q) :
    ∃ (l : List V) (hl : ∀ y ∈ l, Q y ≠ 0) (c : k), c ≠ 0 ∧ Even l.length ∧
      conjHom (vecProd l hl) = conjM0 u ∧
      ((u : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) =
        c • (((vecProd l hl : cliffordGroup Q) : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) := by
  obtain ⟨l, hl, hev, -, hT⟩ := exists_M0_of_orthPlus hQ (conjM0_mem_orthPlus hQ u)
  set w := vecProd l hl
  set u' : cliffordGroup Q := Subgroup.inclusion M0_le u
  set v : cliffordGroup Q := u' * w⁻¹
  have hv1 : conjHom v = 1 := by
    simp only [v, map_mul, map_inv, hT, conjM0_apply, u', mul_inv_cancel]
  have hw0 := vecProd_mem_even hl hev
  have hwi0 : (((w⁻¹ : cliffordGroup Q) : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) ∈ evenOdd Q 0 :=
    mem_evenOdd_of_mul_eq_one Q hw0 (w : (CliffordAlgebra Q)ˣ).mul_inv
  have hv0 : (((v : cliffordGroup Q) : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) ∈ evenOdd Q 0 := by
    have := SetLike.mul_mem_graded u.2.1 hwi0
    simpa [v, u'] using this
  obtain ⟨c, hc⟩ := (conjHom_eq_one_iff hQ hv0).1 hv1
  have hc0 : c ≠ 0 := by
    rintro rfl
    rw [map_zero] at hc
    exact Units.ne_zero _ hc.symm
  refine ⟨l, hl, c, hc0, hev, hT, ?_⟩
  have huvw : ((u : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) =
      (((v : cliffordGroup Q) : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) *
        (((w : cliffordGroup Q) : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) := by
    simp [v, u']
  rw [huvw, ← hc, Algebra.smul_def]

/-- **Cassels, Ch. 10, Theorem 3.1, Corollary 1** (p. 177), second part: $uu' \in k^\times$ for $u \in M_0(V)$. -/
@[kb "cassels1978" "Ch. 10, Thm. 3.1, Cor. 1, p. 177 (uu' ∈ k^×)"]
theorem M0_mul_reverse (hQ : (QuadraticMap.associated Q).Nondegenerate) (u : M0 Q) :
    ∃ c : k, c ≠ 0 ∧ ((u : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) *
      reverse ((u : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) = algebraMap k _ c := by
  obtain ⟨l, hl, c, hc, -, -, hu⟩ := exists_eq_smul_vecProd hQ u
  refine ⟨c ^ 2 * (l.map Q).prod, mul_ne_zero (pow_ne_zero 2 hc) ?_, ?_⟩
  · rw [Ne, List.prod_eq_zero_iff]
    simp only [List.mem_map, not_exists, not_and]
    exact fun y hy => hl y hy
  · rw [hu, map_smul, smul_mul_smul_comm, vecProd_mul_reverse, Algebra.smul_def, ← map_mul, sq]

/-- **Cassels, Ch. 10, Theorem 3.1, Corollary 3** (p. 178), (3.7): for $u \in M_0(V)$ with $uu' = c$, the spinor norm
of $T_u$ is $c\,(k^\times)^2$ (stated with O'Meara's `HasSpinorNorm`, through a factorization of $T_u$ into
symmetries). -/
@[kb "cassels1978" "Ch. 10, Thm. 3.1, Cor. 3, (3.7), p. 178"]
theorem hasSpinorNorm_conjM0 (hQ : (QuadraticMap.associated Q).Nondegenerate) (u : M0 Q) {c : k}
    (hc : ((u : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) *
      reverse ((u : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) = algebraMap k _ c) :
    HasSpinorNorm Q (conjM0 u) c := by
  obtain ⟨l, hl, d, hd, hev, hT, hu⟩ := exists_eq_smul_vecProd hQ u
  have hT' : conjM0 u = symProd l hl := by
    rw [← hT, conjHom_vecProd, negE_pow_even hev, one_mul]
  have hcd : c = d ^ 2 * (l.map Q).prod := by
    apply (algebraMap k (CliffordAlgebra Q)).injective
    rw [← hc, hu, map_smul, smul_mul_smul_comm, vecProd_mul_reverse, Algebra.smul_def, ← map_mul, sq]
  refine ⟨l, hl, hT', d⁻¹, inv_ne_zero hd, ?_⟩
  rw [hcd]; field_simp

/-- **Cassels, Ch. 10, Theorem 3.1, Corollary 3** (p. 178): the spinor norm homomorphism
$\theta : O^+(V) \to k^\times/(k^\times)^2$ takes $T_u$ to the square class of $uu'$. -/
@[kb "cassels1978" "Ch. 10, Thm. 3.1, Cor. 3, p. 178 (θ(T_u) = uu'(k^×)²)"]
theorem spinorNormHom_conjM0 (hQ : (QuadraticMap.associated Q).Nondegenerate) (u : M0 Q) {c : k}
    (hc : ((u : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) *
      reverse ((u : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) = algebraMap k _ c) :
    spinorNormHom Q hQ ⟨conjM0 u, conjM0_mem_orthPlus hQ u⟩ = Lattices.sqClassOf c :=
  spinorNormHom_apply Q hQ (hasSpinorNorm_conjM0 hQ u hc)

/-- A nonzero scalar is in $M_0(V)$. -/
theorem scalar_mem_M0 (c : kˣ) : Units.map (algebraMap k (CliffordAlgebra Q)).toMonoidHom c ∈ M0 Q := by
  refine ⟨?_, fun x => ⟨x, ?_⟩⟩
  · change algebraMap k (CliffordAlgebra Q) (c : k) ∈ evenOdd Q 0
    rw [Algebra.algebraMap_eq_smul_one]
    exact Submodule.smul_mem _ _ (one_le_evenOdd_zero Q (Submodule.mem_one.2 ⟨1, by simp⟩))
  · change ι Q x = algebraMap k _ (c : k) * ι Q x * algebraMap k _ ((c⁻¹ : kˣ) : k)
    rw [Algebra.commutes, mul_assoc, ← map_mul, Units.mul_inv, map_one, mul_one]

/-- **Cassels (3.7 bis)** (Ch. 10, p. 178): $\Theta$, the kernel of the spinor norm on $O^+(V)$ (O'Meara's $O'(V)$,
`orthPrime`), consists of the $T_u$ with $u \in M_0(V)$ and $uu' = 1$. -/
@[kb "cassels1978" "Ch. 10, Thm. 3.1, Cor. 3, (3.7 bis), p. 178"]
theorem mem_orthPrime_iff_exists_M0 (hQ : (QuadraticMap.associated Q).Nondegenerate) {σ : V ≃ₗ[k] V} :
    σ ∈ orthPrime Q ↔ ∃ u : M0 Q, ((u : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) *
      reverse ((u : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) = 1 ∧ conjM0 u = σ := by
  constructor
  · intro hσ
    obtain ⟨u, rfl⟩ : σ ∈ (conjM0 (Q := Q)).range := by rw [range_conjM0 hQ]; exact hσ.1
    obtain ⟨c, hc0, hc⟩ := M0_mul_reverse hQ u
    obtain ⟨s, hs0, hcs⟩ := HasSpinorNorm.eq_mul_sq Q hQ (hasSpinorNorm_conjM0 hQ u hc) hσ.2
    set t : kˣ := Units.mk0 s⁻¹ (inv_ne_zero hs0)
    refine ⟨⟨_, (M0 Q).mul_mem (scalar_mem_M0 t) u.2⟩, ?_, ?_⟩
    · change algebraMap k _ s⁻¹ * ((u : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) *
        reverse (algebraMap k _ s⁻¹ * ((u : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q)) = 1
      rw [reverse.map_mul, reverse.commutes, ← Algebra.commutes s⁻¹ (reverse _), mul_assoc,
        ← mul_assoc _ (algebraMap k _ s⁻¹), ← Algebra.commutes s⁻¹, mul_assoc, hc, ← mul_assoc,
        ← map_mul, ← map_mul, hcs, ← map_one (algebraMap k (CliffordAlgebra Q))]
      congr 1
      field_simp
    · change conjM0 (⟨_, scalar_mem_M0 t⟩ * u) = conjM0 u
      rw [map_mul, (conjM0_eq_one_iff hQ ⟨_, scalar_mem_M0 t⟩).2 ⟨_, rfl⟩, one_mul]
  · rintro ⟨u, hu, rfl⟩
    refine ⟨conjM0_mem_orthPlus hQ u, hasSpinorNorm_conjM0 hQ u ?_⟩
    rw [hu, map_one]

/-! ### The spin group -/

/-- An invertible vector belongs to the Lipschitz group. -/
theorem vecUnit_mem_lipschitzGroup (y : V) (hy : Q y ≠ 0) : vecUnit y hy ∈ lipschitzGroup Q :=
  Subgroup.subset_closure ⟨y, rfl⟩

theorem vecProd_mem_lipschitzGroup (l : List V) (hl : ∀ y ∈ l, Q y ≠ 0) :
    ((vecProd l hl : cliffordGroup Q) : (CliffordAlgebra Q)ˣ) ∈ lipschitzGroup Q := by
  induction l with
  | nil => simp [vecProd]
  | cons y l ih =>
    rw [vecProd_cons, Subgroup.coe_mul]
    exact Subgroup.mul_mem _ (vecUnit_mem_lipschitzGroup _ (hl y (List.mem_cons_self ..))) (ih _)

/-- A regular nonzero space has an anisotropic vector. -/
theorem exists_anisotropic [Nontrivial V] (hQ : (QuadraticMap.associated Q).Nondegenerate) :
    ∃ a : V, Q a ≠ 0 := by
  obtain ⟨e, -, hne⟩ := exists_orthogonal_basis_aniso hQ
  have : 0 < finrank k V := Module.finrank_pos
  exact ⟨e ⟨0, this⟩, hne _⟩

/-- A nonzero scalar belongs to the Lipschitz group when $V$ has an anisotropic vector $\vec a$:
$c = (c\vec a)(\phi(\vec a)^{-1}\vec a)$. -/
theorem scalar_mem_lipschitzGroup {a : V} (ha : Q a ≠ 0) (c : kˣ) :
    Units.map (algebraMap k (CliffordAlgebra Q)).toMonoidHom c ∈ lipschitzGroup Q := by
  have h1 : Q ((c : k) • a) ≠ 0 := by
    rw [QuadraticMap.map_smul]; exact mul_ne_zero (mul_ne_zero c.ne_zero c.ne_zero) ha
  have h2 : Q ((Q a)⁻¹ • a) ≠ 0 := by
    rw [QuadraticMap.map_smul]; exact mul_ne_zero (mul_ne_zero (inv_ne_zero ha) (inv_ne_zero ha)) ha
  have e : Units.map (algebraMap k (CliffordAlgebra Q)).toMonoidHom c = vecUnit _ h1 * vecUnit _ h2 := by
    ext
    change algebraMap k _ (c : k) = ι Q ((c : k) • a) * ι Q ((Q a)⁻¹ • a)
    rw [map_smul, map_smul, smul_mul_smul_comm, ι_sq_scalar, Algebra.smul_def, ← map_mul]
    congr 1
    field_simp
  rw [e]
  exact Subgroup.mul_mem _ (vecUnit_mem_lipschitzGroup _ _) (vecUnit_mem_lipschitzGroup _ _)

/-- **Cassels' definition of $\operatorname{Spin}(V)$** (Ch. 10, §3, p. 181): for a regular space $V \ne 0$
(characteristic $\ne 2$), $u$ lies in Mathlib's `spinGroup Q` if and only if (i) $u \in C_0(V)$, (ii) $uu' = 1$ and
(iii) $u\vec x u' \in V$ for all $\vec x \in V$. -/
@[kb "cassels1978" "Ch. 10, §3, p. 181 (definition of Spin(V))"]
theorem mem_spinGroup_iff [Nontrivial V] (hQ : (QuadraticMap.associated Q).Nondegenerate)
    {u : CliffordAlgebra Q} :
    u ∈ spinGroup Q ↔ u ∈ evenOdd Q 0 ∧ u * reverse u = 1 ∧ ∀ x, ∃ y, ι Q y = u * ι Q x * reverse u := by
  constructor
  · intro hu
    have hstar : star u = reverse u := by rw [star_def, spinGroup.involute_eq hu]
    have h1 : u * reverse u = 1 := by rw [← hstar]; exact spinGroup.mul_star_self_of_mem hu
    have h2 : reverse u * u = 1 := by rw [← hstar]; exact spinGroup.star_mul_self_of_mem hu
    refine ⟨spinGroup.mem_even hu, h1, fun x => ?_⟩
    set U : (CliffordAlgebra Q)ˣ := ⟨u, reverse u, h1, h2⟩
    obtain ⟨y, hy⟩ := spinGroup.conjAct_smul_ι_mem_range_ι (x := U) hu x
    exact ⟨y, by rw [hy]; rfl⟩
  · rintro ⟨h0, h1, h3⟩
    have h2 : reverse u * u = 1 := mul_eq_one_comm_of_finiteDimensional k h1
    set U : (CliffordAlgebra Q)ˣ := ⟨u, reverse u, h1, h2⟩
    have hU : U ∈ M0 Q := ⟨h0, h3⟩
    obtain ⟨l, hl, c, hc, -, -, hu⟩ := exists_eq_smul_vecProd hQ ⟨U, hU⟩
    obtain ⟨a, ha⟩ := exists_anisotropic hQ
    have hlip : U ∈ lipschitzGroup Q := by
      have e : U = Units.map (algebraMap k (CliffordAlgebra Q)).toMonoidHom (Units.mk0 c hc) *
          ((vecProd l hl : cliffordGroup Q) : (CliffordAlgebra Q)ˣ) := by
        ext
        change u = algebraMap k _ c * _
        rw [← Algebra.smul_def]; exact hu
      rw [e]
      exact Subgroup.mul_mem _ (scalar_mem_lipschitzGroup ha _) (vecProd_mem_lipschitzGroup l hl)
    have hstar : star u = reverse u := by rw [star_def, involute_eq_of_mem_even h0]
    refine ⟨⟨⟨U, hlip, rfl⟩, ?_⟩, h0⟩
    change u ∈ unitary (CliffordAlgebra Q)
    rw [Unitary.mem_iff, hstar]
    exact ⟨h2, h1⟩

/-- An element of the spin group as an element of the Clifford group. -/
theorem spinGroup_toUnits_mem (u : spinGroup Q) : spinGroup.toUnits u ∈ cliffordGroup Q := by
  intro x
  obtain ⟨y, hy⟩ := spinGroup.conjAct_smul_ι_mem_range_ι (x := spinGroup.toUnits u) u.2 x
  exact ⟨y, by rw [hy]; rfl⟩

/-- **The map $u \mapsto T_u$ on $\operatorname{Spin}(V)$** (Cassels (3.1), p. 176, restricted to
$\operatorname{Spin}(V)$ as in Theorem 3.3). -/
noncomputable def spinConj : spinGroup Q →* (V ≃ₗ[k] V) :=
  conjHom.comp ((spinGroup.toUnits (Q := Q)).codRestrict (cliffordGroup Q) spinGroup_toUnits_mem)

theorem spinGroup_mem_M0 (u : spinGroup Q) : spinGroup.toUnits u ∈ M0 Q :=
  ⟨spinGroup.mem_even u.2, spinGroup_toUnits_mem u⟩

theorem spinConj_eq (u : spinGroup Q) : spinConj u = conjM0 ⟨_, spinGroup_mem_M0 u⟩ := rfl

theorem spinGroup_mul_reverse (u : spinGroup Q) : (u : CliffordAlgebra Q) * reverse (u : CliffordAlgebra Q) = 1 := by
  have hstar : star (u : CliffordAlgebra Q) = reverse u := by
    rw [star_def, spinGroup.involute_eq u.2]
  rw [← hstar]; exact spinGroup.mul_star_self_of_mem u.2

/-- **Cassels, Ch. 10, Theorem 3.3** (p. 181), image: $u \mapsto T_u$ maps $\operatorname{Spin}(V)$ onto $\Theta$
(O'Meara's $O'(V)$). -/
@[kb "cassels1978" "Ch. 10, Theorem 3.3, p. 181 (onto Θ)"]
theorem range_spinConj [Nontrivial V] (hQ : (QuadraticMap.associated Q).Nondegenerate) :
    (spinConj (Q := Q)).range = orthPrime Q := by
  ext σ
  constructor
  · rintro ⟨u, rfl⟩
    rw [spinConj_eq, mem_orthPrime_iff_exists_M0 hQ]
    exact ⟨_, spinGroup_mul_reverse u, rfl⟩
  · intro hσ
    obtain ⟨u, hu, rfl⟩ := (mem_orthPrime_iff_exists_M0 hQ).1 hσ
    have hmem : ((u : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) ∈ spinGroup Q := by
      rw [mem_spinGroup_iff hQ]
      refine ⟨u.2.1, hu, fun x => ?_⟩
      obtain ⟨y, hy⟩ := u.2.2 x
      have hinv : (↑((u : (CliffordAlgebra Q)ˣ)⁻¹) : CliffordAlgebra Q) =
          reverse ((u : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) :=
        eq_of_mul_eq_one_of_mul_eq_one (u : (CliffordAlgebra Q)ˣ).mul_inv
          (mul_eq_one_comm_of_finiteDimensional k hu)
      exact ⟨y, by rw [hy, hinv]⟩
    refine ⟨⟨_, hmem⟩, ?_⟩
    rw [spinConj_eq]
    exact congrArg conjM0 (Subtype.ext (Units.ext rfl))

/-- **Cassels, Ch. 10, Theorem 3.3** (p. 181), kernel: $T_u = 1$ for $u \in \operatorname{Spin}(V)$ if and only if
$u = \pm 1$. -/
@[kb "cassels1978" "Ch. 10, Theorem 3.3, p. 181 (kernel {1, −1})"]
theorem spinConj_eq_one_iff (hQ : (QuadraticMap.associated Q).Nondegenerate) (u : spinGroup Q) :
    spinConj u = 1 ↔ (u : CliffordAlgebra Q) = 1 ∨ (u : CliffordAlgebra Q) = -1 := by
  rw [spinConj_eq, conjM0_eq_one_iff hQ]
  change (u : CliffordAlgebra Q) ∈ Set.range (algebraMap k (CliffordAlgebra Q)) ↔ _
  constructor
  · rintro ⟨c, hc⟩
    have h1 := spinGroup_mul_reverse u
    rw [← hc, reverse.commutes, ← map_mul, ← map_one (algebraMap k (CliffordAlgebra Q))] at h1
    have hc2 : c * c = 1 := (algebraMap k (CliffordAlgebra Q)).injective h1
    rcases mul_self_eq_one_iff.1 hc2 with rfl | rfl
    · left; rw [← hc, map_one]
    · right; rw [← hc, map_neg, map_one]
  · rintro (h | h)
    · exact ⟨1, by rw [h, map_one]⟩
    · exact ⟨-1, by rw [h, map_neg, map_one]⟩

/-! ### Lemma 3.4 -/

variable (Q) in
/-- The commutators $\vec a\vec b\vec a^{-1}\vec b^{-1}$ of anisotropic vectors, as units of $C(V)$. -/
def vecCommutators : Set (CliffordAlgebra Q)ˣ :=
  {w | ∃ a b : V, ∃ (ha : Q a ≠ 0) (hb : Q b ≠ 0), w = ⁅vecUnit a ha, vecUnit b hb⁆}

theorem comm_mul_central {G : Type*} [Group G] {z : G} (hz : ∀ g, z * g = g * z) (σ τ : G) :
    ⁅z * σ, z * τ⁆ = ⁅σ, τ⁆ := by
  have hz' : ∀ g, z⁻¹ * g = g * z⁻¹ := fun g => by
    rw [inv_mul_eq_iff_eq_mul, ← mul_assoc, hz g, mul_assoc, mul_inv_cancel, mul_one]
  have key : ∀ x y : G, x * z * y = x * y * z := fun x y => by
    rw [mul_assoc, hz y, ← mul_assoc]
  have key' : ∀ x y : G, x * z⁻¹ * y = x * y * z⁻¹ := fun x y => by
    rw [mul_assoc, hz' y, ← mul_assoc]
  rw [commutatorElement_def, commutatorElement_def]
  simp only [mul_inv_rev, mul_assoc]
  have sw' : ∀ x R : G, x * (z⁻¹ * R) = z⁻¹ * (x * R) := fun x R => by
    rw [← mul_assoc, ← hz' x, mul_assoc]
  rw [sw' σ⁻¹, sw' τ, mul_inv_cancel_left, hz]
  simp only [mul_assoc, inv_mul_cancel, mul_one]

/-- `P g`: even, and `g g' = 1`. -/
def EvenNormOne (g : cliffordGroup Q) : Prop :=
  ((g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) ∈ evenOdd Q 0 ∧
    ((g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) *
      reverse ((g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) = 1

theorem evenNormOne_one : EvenNormOne (1 : cliffordGroup Q) := by
  refine ⟨one_le_evenOdd_zero Q (Submodule.mem_one.2 ⟨1, by simp⟩), ?_⟩
  change (1 : CliffordAlgebra Q) * reverse 1 = 1
  simp

theorem evenNormOne_mul {g h : cliffordGroup Q} (hg : EvenNormOne g) (hh : EvenNormOne h) : EvenNormOne (g * h) := by
  refine ⟨by simpa using SetLike.mul_mem_graded hg.1 hh.1, ?_⟩
  change ((g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) * ((h : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) *
    reverse (((g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) * ((h : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q)) = 1
  rw [reverse.map_mul, mul_assoc, ← mul_assoc ((h : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q), hh.2, one_mul, hg.2]

theorem evenNormOne_inv {g : cliffordGroup Q} (hg : EvenNormOne g) : EvenNormOne g⁻¹ := by
  have h1 : (((g⁻¹ : cliffordGroup Q) : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) =
      reverse ((g : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) :=
    eq_of_mul_eq_one_of_mul_eq_one (g : (CliffordAlgebra Q)ˣ).mul_inv
      (mul_eq_one_comm_of_finiteDimensional k hg.2)
  refine ⟨mem_evenOdd_of_mul_eq_one Q hg.1 (g : (CliffordAlgebra Q)ˣ).mul_inv, ?_⟩
  rw [h1, reverse_reverse]
  exact mul_eq_one_comm_of_finiteDimensional k hg.2

theorem ne_zero_smul_self {a : V} (ha : Q a ≠ 0) : Q ((Q a)⁻¹ • a) ≠ 0 := by
  rw [QuadraticMap.map_smul]; exact mul_ne_zero (mul_ne_zero (inv_ne_zero ha) (inv_ne_zero ha)) ha

/-- commutators of vecUnits in the Clifford group -/
def cliffordVecCommutators (Q : QuadraticForm k V) : Set (cliffordGroup Q) :=
  {w | ∃ a b : V, ∃ (ha : Q a ≠ 0) (hb : Q b ≠ 0),
    w = ⁅(⟨vecUnit a ha, vecUnit_mem a ha⟩ : cliffordGroup Q), ⟨vecUnit b hb, vecUnit_mem b hb⟩⁆}

theorem evenNormOne_comm {a b : V} (ha : Q a ≠ 0) (hb : Q b ≠ 0) :
    EvenNormOne (⁅(⟨vecUnit a ha, vecUnit_mem a ha⟩ : cliffordGroup Q), ⟨vecUnit b hb, vecUnit_mem b hb⟩⁆) := by
  have hl : ∀ y ∈ [a, b, (Q a)⁻¹ • a, (Q b)⁻¹ • b], Q y ≠ 0 := by
    intro y hy
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hy
    rcases hy with rfl | rfl | rfl | rfl
    · exact ha
    · exact hb
    · exact ne_zero_smul_self ha
    · exact ne_zero_smul_self hb
  have e : (((⁅(⟨vecUnit a ha, vecUnit_mem a ha⟩ : cliffordGroup Q), ⟨vecUnit b hb, vecUnit_mem b hb⟩⁆ :
      cliffordGroup Q) : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) =
      (((vecProd [a, b, (Q a)⁻¹ • a, (Q b)⁻¹ • b] hl : cliffordGroup Q) : (CliffordAlgebra Q)ˣ) :
        CliffordAlgebra Q) := by
    rw [coe_vecProd_cons, coe_vecProd_cons, coe_vecProd_cons, coe_vecProd_cons]
    simp [vecProd, commutatorElement_def, vecUnit]
    simp only [mul_assoc]
  have h1 := vecProd_mem_evenOdd [a, b, (Q a)⁻¹ • a, (Q b)⁻¹ • b] hl
  have h2 := vecProd_mul_reverse [a, b, (Q a)⁻¹ • a, (Q b)⁻¹ • b] hl
  refine ⟨?_, ?_⟩
  · rw [e]
    rw [show ((([a, b, (Q a)⁻¹ • a, (Q b)⁻¹ • b] : List V).length : ℕ) : ZMod 2) = 0 from by show ((4 : ℕ) : ZMod 2) = 0; decide] at h1
    exact h1
  · rw [e, h2]
    simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, QuadraticMap.map_smul, smul_eq_mul, mul_one]
    rw [← map_one (algebraMap k (CliffordAlgebra Q))]
    congr 1
    have := ha; have := hb
    field_simp

theorem evenNormOne_of_mem_closure {g : cliffordGroup Q} (hg : g ∈ Subgroup.closure (cliffordVecCommutators Q)) : EvenNormOne g := by
  induction hg using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨a, b, ha, hb, rfl⟩ := hx
    exact evenNormOne_comm ha hb
  | one => exact evenNormOne_one
  | mul x y _ _ hx hy => exact evenNormOne_mul hx hy
  | inv x _ hx => exact evenNormOne_inv hx

theorem conjHom_comm {a b : V} (ha : Q a ≠ 0) (hb : Q b ≠ 0) :
    conjHom (⁅(⟨vecUnit a ha, vecUnit_mem a ha⟩ : cliffordGroup Q), ⟨vecUnit b hb, vecUnit_mem b hb⟩⁆) =
      ⁅symmetry Q a ha, symmetry Q b hb⁆ := by
  rw [map_commutatorElement, conjHom_vecUnit_eq, conjHom_vecUnit_eq]
  exact comm_mul_central (fun g => negE_mul_comm g) _ _

theorem image_cliffordVecCommutators : conjHom '' cliffordVecCommutators Q = symmCommutators Q := by
  ext g
  constructor
  · rintro ⟨_, ⟨a, b, ha, hb, rfl⟩, rfl⟩
    exact ⟨a, b, ha, hb, (conjHom_comm ha hb).symm ▸ rfl⟩
  · rintro ⟨a, b, ha, hb, rfl⟩
    exact ⟨_, ⟨a, b, ha, hb, rfl⟩, conjHom_comm ha hb⟩

theorem image_cliffordVecCommutators_units :
    (cliffordGroup Q).subtype '' cliffordVecCommutators Q = vecCommutators Q := by
  ext g
  constructor
  · rintro ⟨_, ⟨a, b, ha, hb, rfl⟩, rfl⟩
    exact ⟨a, b, ha, hb, rfl⟩
  · rintro ⟨a, b, ha, hb, rfl⟩
    exact ⟨_, ⟨a, b, ha, hb, rfl⟩, rfl⟩

theorem neg_one_mem_closure (hQ : (QuadraticMap.associated Q).Nondegenerate) (hn : 1 < finrank k V) :
    (-1 : (CliffordAlgebra Q)ˣ) ∈ Subgroup.closure (vecCommutators Q) := by
  obtain ⟨e, horth, hne⟩ := exists_orthogonal_basis_aniso hQ
  have h0 : 0 < finrank k V := by omega
  set i : Fin (finrank k V) := ⟨0, h0⟩
  set j : Fin (finrank k V) := ⟨1, hn⟩
  have hij : i ≠ j := by simp [i, j, Fin.ext_iff]
  refine Subgroup.subset_closure ⟨e i, e j, hne i, hne j, ?_⟩
  have hanti : ι Q (e j) * ι Q (e i) = -(ι Q (e i) * ι Q (e j)) := by
    have := ι_mul_ι_add_swap (Q := Q) (e j) (e i)
    rw [horth j i hij.symm, map_zero] at this
    exact eq_neg_of_add_eq_zero_left this
  ext
  change (-1 : CliffordAlgebra Q) = ι Q (e i) * ι Q (e j) * ((Q (e i))⁻¹ • ι Q (e i)) * ((Q (e j))⁻¹ • ι Q (e j))
  have hxx := ι_sq_scalar Q (e i)
  have hyy := ι_sq_scalar Q (e j)
  have h1 : ι Q (e i) * ι Q (e j) * ι Q (e i) * ι Q (e j) =
      -(algebraMap k (CliffordAlgebra Q) (Q (e i) * Q (e j))) := by
    rw [show ι Q (e i) * ι Q (e j) = -(ι Q (e j) * ι Q (e i)) from by rw [hanti, neg_neg],
      neg_mul, neg_mul, mul_assoc (ι Q (e j)) (ι Q (e i)) (ι Q (e i)), hxx, ← Algebra.commutes,
      mul_assoc, hyy, map_mul]
  rw [mul_smul_comm, mul_smul_comm, smul_mul_assoc, h1]
  simp only [Algebra.smul_def, mul_neg, ← map_mul]
  have hi := hne i
  have hj := hne j
  have : (Q (e j))⁻¹ * ((Q (e i))⁻¹ * (Q (e i) * Q (e j))) = 1 := by field_simp
  rw [this, map_one]

/-- **Cassels, Ch. 10, Lemma 3.4** (pp. 181–182). Let $n > 1$. If $u \in \operatorname{Spin}(V)$ and
$T_u \in \Omega(V)$, then $u$ is a product of commutators $\vec a\vec b\vec a^{-1}\vec b^{-1}$
($\vec a, \vec b \in V$ anisotropic): it lies in the subgroup of $C(V)^\times$ generated by them. -/
@[kb "cassels1978" "Ch. 10, Lemma 3.4, pp. 181–182"]
theorem mem_closure_vecCommutators (hQ : (QuadraticMap.associated Q).Nondegenerate) (hn : 1 < finrank k V)
    (u : spinGroup Q) (hu : spinConj u ∈ omega Q) :
    spinGroup.toUnits u ∈ Subgroup.closure (vecCommutators Q) := by
  have hW : (Subgroup.closure (cliffordVecCommutators Q)).map conjHom = omega Q := by
    rw [MonoidHom.map_closure, image_cliffordVecCommutators, omega_eq_closure_symmCommutators Q hQ]
  have hu' : spinConj u ∈ (Subgroup.closure (cliffordVecCommutators Q)).map conjHom := by rw [hW]; exact hu
  obtain ⟨w, hw, hwu⟩ := hu'
  have hPw := evenNormOne_of_mem_closure hw
  have hwmem : ((w : cliffordGroup Q) : (CliffordAlgebra Q)ˣ) ∈ Subgroup.closure (vecCommutators Q) := by
    have : (Subgroup.closure (cliffordVecCommutators Q)).map (cliffordGroup Q).subtype =
        Subgroup.closure (vecCommutators Q) := by
      rw [MonoidHom.map_closure, image_cliffordVecCommutators_units]
    rw [← this]; exact ⟨w, hw, rfl⟩
  set U : cliffordGroup Q := Subgroup.inclusion M0_le ⟨spinGroup.toUnits u, spinGroup_mem_M0 u⟩ with hU
  have hUc : ((U : (CliffordAlgebra Q)ˣ) : CliffordAlgebra Q) = (u : CliffordAlgebra Q) := rfl
  have hUw : conjHom w = conjHom U := hwu
  have hPU : EvenNormOne U := ⟨by rw [hUc]; exact spinGroup.mem_even u.2, by rw [hUc]; exact spinGroup_mul_reverse u⟩
  have hv := evenNormOne_mul hPU (evenNormOne_inv hPw)
  have hv1 : conjHom (U * w⁻¹) = 1 := by rw [map_mul, map_inv, hUw, mul_inv_cancel]
  obtain ⟨c, hc⟩ := (conjHom_eq_one_iff hQ hv.1).1 hv1
  have hc2 : c * c = 1 := by
    have h := hv.2
    rw [← hc, reverse.commutes, ← map_mul, ← map_one (algebraMap k (CliffordAlgebra Q))] at h
    exact (algebraMap k (CliffordAlgebra Q)).injective h
  have hUvw : U = (U * w⁻¹) * w := by rw [inv_mul_cancel_right]
  have hUvw' : ((U : (CliffordAlgebra Q)ˣ)) = ((U * w⁻¹ : cliffordGroup Q) : (CliffordAlgebra Q)ˣ) *
      (w : (CliffordAlgebra Q)ˣ) := by
    rw [← Subgroup.coe_mul]; exact congrArg _ hUvw
  rcases mul_self_eq_one_iff.1 hc2 with rfl | rfl
  · have : spinGroup.toUnits u = (w : (CliffordAlgebra Q)ˣ) := by
      have h1 : ((U * w⁻¹ : cliffordGroup Q) : (CliffordAlgebra Q)ˣ) = 1 := by
        ext; rw [← hc, map_one]; rfl
      rw [h1, one_mul] at hUvw'
      exact hUvw'
    rw [this]; exact hwmem
  · have : spinGroup.toUnits u = (-1 : (CliffordAlgebra Q)ˣ) * (w : (CliffordAlgebra Q)ˣ) := by
      have h1 : ((U * w⁻¹ : cliffordGroup Q) : (CliffordAlgebra Q)ˣ) = -1 := by
        ext; rw [← hc, map_neg, map_one]; simp
      rw [h1] at hUvw'
      exact hUvw'
    rw [this]; exact Subgroup.mul_mem _ (neg_one_mem_closure hQ hn) hwmem

end QuadFormsKB.Cassels
