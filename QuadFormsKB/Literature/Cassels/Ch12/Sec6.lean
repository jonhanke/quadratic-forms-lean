/-
# Cassels, Chapter 12, §6: the geometry of the binary case

Cassels, *Rational Quadratic Forms* (1978), Ch. 12, §6, pp. 273–276.

A binary form $f = f_{00}x_0^2 + 2f_{01}x_0x_1 + f_{11}x_1^2$ is represented by the point
$$(\xi, \eta) = \Bigl(\frac{2f_{01}}{f_{00} + f_{11}},\ \frac{f_{11} - f_{00}}{f_{00} + f_{11}}\Bigr)$$
((6.4), `binXi`, `binEta`; the formula is lost in the machine-read text and is reconstructed from the vertices of
Figure 12.1, p. 274: $(0,1) \sim [0,0,1]$, $(\tfrac12, 0) \sim [1,1,1]$, $(1,0) \sim [1,2,1]$ in the notation
$[f_{00}, 2f_{01}, f_{11}]$, and from (6.5)–(6.6)). Then:
* strictly definite forms are the points of the open unit disc ((6.2), (6.5), `binary_posDef_iff`);
* reduced forms are the points of the triangle with vertices $(0,1)$, $(\pm\tfrac12, 0)$ other than $(0,1)$
  ((6.3), (6.6), `binary_isMinkowskiReduced_iff`, `binary_isMinkowskiReduced_iff_triangle`);
* the strictly reduced forms are its interior points (`binary_isStrictlyReduced_iff`);
* $\mathrm{GL}_2(\mathbb{Z})$ is generated by $S_1$, $S_2$ and the diagonal matrices (`gl2_closure`).

Facts (i)–(ii) of p. 275 (the $T\mathcal F$ cover the disc and do not overlap) are Theorems 7.1 and 7.4 for $n = 2$
(`Sec7.lean`). **Not formalized:** fact (iii) (each side of $T\mathcal F$ belongs to exactly one other $T\mathcal F$, six
triangles at each interior vertex), the explicit formula for $T(\xi, \eta)$, and the comparison with the
upper half plane (Cassels refers to Ch. 13, §8).
-/
import QuadFormsKB.Literature.Cassels.Ch12.Sec7

open Matrix

namespace QuadFormsKB.Reduction

/-- **The coordinate $\xi$ of a binary form** (Cassels, Ch. 12, (6.4), p. 273, reconstructed):
$\xi = 2f_{01}/(f_{00} + f_{11})$ (Lean's $x/0 = 0$ if $f_{00} + f_{11} = 0$). -/
@[kb "cassels1978" "Ch. 12, §6, (6.4), p. 273"]
noncomputable def binXi (F : Matrix (Fin 2) (Fin 2) ℝ) : ℝ := 2 * F 0 1 / (F 0 0 + F 1 1)

/-- **The coordinate $\eta$ of a binary form** (Cassels, Ch. 12, (6.4), p. 273, reconstructed):
$\eta = (f_{11} - f_{00})/(f_{00} + f_{11})$. -/
@[kb "cassels1978" "Ch. 12, §6, (6.4), p. 273"]
noncomputable def binEta (F : Matrix (Fin 2) (Fin 2) ℝ) : ℝ := (F 1 1 - F 0 0) / (F 0 0 + F 1 1)

/-- Helper: $f(x_0, x_1) = f_{00}x_0^2 + 2f_{01}x_0x_1 + f_{11}x_1^2$ for a symmetric binary $F$. -/
theorem bin_val {F : Matrix (Fin 2) (Fin 2) ℝ} (hF : F.IsSymm) (x : Fin 2 → ℝ) :
    val F x = F 0 0 * x 0 ^ 2 + 2 * F 0 1 * x 0 * x 1 + F 1 1 * x 1 ^ 2 := by
  have h10 : F 1 0 = F 0 1 := by
    have := congrFun (congrFun hF 0) 1
    simpa using this
  simp [val, dotProduct, Fin.sum_univ_two, Matrix.mulVec, h10]
  ring

/-- Helper: lower bound $f(x) \ge f_{00}x_0^2 - |2f_{01}||x_0x_1| + f_{11}x_1^2$. -/
theorem bin_ge {F : Matrix (Fin 2) (Fin 2) ℝ} (hF : F.IsSymm) (x : Fin 2 → ℝ) :
    F 0 0 * x 0 ^ 2 - |2 * F 0 1| * |x 0 * x 1| + F 1 1 * x 1 ^ 2 ≤ val F x := by
  rw [bin_val hF]
  have := neg_abs_le (2 * F 0 1 * (x 0 * x 1))
  rw [abs_mul] at this
  nlinarith

/-- Helper: integers $a, c$ not both zero satisfy $a^2 - |ac| + c^2 \ge 1$. -/
theorem int_aux (a c : ℤ) (h : a ≠ 0 ∨ c ≠ 0) : 1 ≤ a ^ 2 - |a * c| + c ^ 2 := by
  have h1 : 2 * |a * c| ≤ a ^ 2 + c ^ 2 := by
    rw [abs_mul]
    nlinarith [sq_nonneg (|a| - |c|), sq_abs a, sq_abs c]
  have h2 : 1 ≤ a ^ 2 + c ^ 2 := by
    rcases h with h | h
    · have : 1 ≤ a ^ 2 := by
        rcases lt_or_gt_of_ne h with h | h <;> nlinarith
      nlinarith [sq_nonneg c]
    · have : 1 ≤ c ^ 2 := by
        rcases lt_or_gt_of_ne h with h | h <;> nlinarith
      nlinarith [sq_nonneg a]
  generalize |a * c| = m at *
  generalize a ^ 2 = p at *
  generalize c ^ 2 = q at *
  omega

/-- Helper: $\gcd(b_0, b_1) = 1$ forces $b \ne 0$. -/
theorem tail0 (b : Fin 2 → ℤ) (hb : tailGcd 0 b = 1) : b 0 ≠ 0 ∨ b 1 ≠ 0 := by
  by_contra h
  push_neg at h
  have : tailGcd 0 b = 0 :=
    Finset.gcd_eq_zero_iff.2 (fun k _ => by fin_cases k <;> simp [h.1, h.2])
  rw [hb] at this
  exact one_ne_zero this

/-- Helper: $\gcd(b_1) = 1$ means $b_1 = \pm1$. -/
theorem tail1 (b : Fin 2 → ℤ) (hb : tailGcd 1 b = 1) : b 1 = 1 ∨ b 1 = -1 := by
  have hd : b 1 ∣ tailGcd 1 b := by
    apply Finset.dvd_gcd
    intro k hk
    have hk' := (Finset.mem_filter.1 hk).2
    have hk1 : k = 1 := by
      revert hk'; fin_cases k <;> decide
    rw [hk1]
  rw [hb] at hd
  exact Int.isUnit_iff.1 (isUnit_of_dvd_one hd)

/-- Helper: the substitution $(x_0, x_1) \mapsto (x_0 + c x_1, x_1)$. -/
def binE (c : ℤ) : GL (Fin 2) ℤ :=
  ⟨!![1, c; 0, 1], !![1, -c; 0, 1],
    by ext i j; fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two],
    by ext i j; fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]⟩

/-- Helper: $(c, 1)$ extends $e_0$ to a basis. -/
theorem extendsBasis_binE (c : ℤ) : ExtendsBasis (1 : Fin 2) ![c, 1] := by
  refine ⟨binE c, fun i hi k => ?_, fun k => ?_⟩
  · have := (Fin.lt_one_iff _).1 hi
    subst this
    fin_cases k <;> simp [binE]
  · fin_cases k <;> simp [binE]

/-- Helper: $e_1$ is primitive, i.e. extends the empty list of basis vectors (via the swap matrix). -/
theorem extendsBasis_e1 : ExtendsBasis (0 : Fin 2) (Pi.single 1 1) := by
  refine ⟨⟨!![0, 1; 1, 0], !![0, 1; 1, 0], by decide, by decide⟩, fun i hi => absurd hi (by simp),
    fun k => ?_⟩
  fin_cases k <;> simp

/-- **Strictly definite binary forms** (Cassels, Ch. 12, (6.2) and (6.5), p. 273): a symmetric $F$ is strictly positive
definite iff $f_{00} > 0$ and $f_{00}f_{11} - f_{01}^2 > 0$, iff $f_{00} + f_{11} > 0$ and $\xi^2 + \eta^2 < 1$. -/
@[kb "cassels1978" "Ch. 12, §6, (6.2) and (6.5), p. 273"]
theorem binary_posDef_iff {F : Matrix (Fin 2) (Fin 2) ℝ} (hF : F.IsSymm) :
    (F.PosDef ↔ 0 < F 0 0 ∧ 0 < F 0 0 * F 1 1 - F 0 1 ^ 2) ∧
      (F.PosDef ↔ 0 < F 0 0 + F 1 1 ∧ binXi F ^ 2 + binEta F ^ 2 < 1) := by
  have h1 : F.PosDef ↔ 0 < F 0 0 ∧ 0 < F 0 0 * F 1 1 - F 0 1 ^ 2 := by
    rw [posDef_iff]
    constructor
    · rintro ⟨_, hp⟩
      have a := hp (Pi.single 0 1) (by intro h; have := congrFun h 0; simp at this)
      rw [val_single] at a
      have b := hp ![-F 0 1, F 0 0] (by
        intro h; have := congrFun h 1; simp at this; linarith)
      rw [bin_val hF] at b
      simp at b
      refine ⟨a, ?_⟩
      by_contra h
      push_neg at h
      nlinarith [mul_nonneg a.le (neg_nonneg.2 h)]
    · rintro ⟨h0, hd⟩
      refine ⟨hF, fun x hx => ?_⟩
      rw [bin_val hF]
      by_cases h : x 1 = 0
      · have : x 0 ≠ 0 := by
          intro h'; apply hx; ext i; fin_cases i <;> simp [h, h']
        have : 0 < x 0 ^ 2 := by positivity
        rw [h]
        nlinarith [mul_pos h0 this]
      · have hy : 0 < x 1 ^ 2 := by positivity
        have : 0 < F 0 0 * (F 0 0 * x 0 ^ 2 + 2 * F 0 1 * x 0 * x 1 + F 1 1 * x 1 ^ 2) := by
          nlinarith [sq_nonneg (F 0 0 * x 0 + F 0 1 * x 1), mul_pos hd hy]
        exact (mul_pos_iff_of_pos_left h0).1 this
  refine ⟨h1, ?_⟩
  rw [h1]
  constructor
  · rintro ⟨h0, hd⟩
    have hF11 : 0 < F 1 1 := by
      by_contra h
      push_neg at h
      nlinarith [sq_nonneg (F 0 1), mul_nonneg h0.le (neg_nonneg.2 h)]
    have hs : 0 < F 0 0 + F 1 1 := by linarith
    refine ⟨hs, ?_⟩
    unfold binXi binEta
    have : (2 * F 0 1 / (F 0 0 + F 1 1)) ^ 2 + ((F 1 1 - F 0 0) / (F 0 0 + F 1 1)) ^ 2 =
        ((2 * F 0 1) ^ 2 + (F 1 1 - F 0 0) ^ 2) / (F 0 0 + F 1 1) ^ 2 := by
      field_simp
    rw [this, div_lt_one (by positivity)]
    nlinarith
  · rintro ⟨hs, hlt⟩
    unfold binXi binEta at hlt
    have : (2 * F 0 1 / (F 0 0 + F 1 1)) ^ 2 + ((F 1 1 - F 0 0) / (F 0 0 + F 1 1)) ^ 2 =
        ((2 * F 0 1) ^ 2 + (F 1 1 - F 0 0) ^ 2) / (F 0 0 + F 1 1) ^ 2 := by
      field_simp
    rw [this, div_lt_one (by positivity)] at hlt
    have hd : 0 < F 0 0 * F 1 1 - F 0 1 ^ 2 := by nlinarith
    refine ⟨?_, hd⟩
    by_contra h
    push_neg at h
    nlinarith [mul_nonneg (neg_nonneg.2 h) hs.le, sq_nonneg (F 0 1)]

/-- **Reduced binary forms** (Cassels, Ch. 12, (6.3), p. 273; Lemma 1.2, Note 1, p. 257): a symmetric $F$ is
Minkowski-reduced iff $0 < f_{00} \le f_{11}$ and $|2f_{01}| \le f_{00}$. -/
@[kb "cassels1978" "Ch. 12, §6, (6.3), p. 273; §1, Lemma 1.2, Note 1, p. 257"]
theorem binary_isMinkowskiReduced_iff {F : Matrix (Fin 2) (Fin 2) ℝ} (hF : F.IsSymm) :
    IsMinkowskiReduced F ↔ 0 < F 0 0 ∧ F 0 0 ≤ F 1 1 ∧ |2 * F 0 1| ≤ F 0 0 := by
  constructor
  · intro h
    have hp := ((binary_posDef_iff hF).1.1 h.1).1
    exact ⟨hp, h.diag_mono (by decide), h.abs_two_mul_le (by decide)⟩
  · rintro ⟨h0, h1, h2⟩
    have h3 : (2 * F 0 1) ^ 2 ≤ F 0 0 ^ 2 := by
      nlinarith [abs_nonneg (2 * F 0 1), sq_abs (2 * F 0 1)]
    have hd : 0 < F 0 0 * F 1 1 - F 0 1 ^ 2 := by
      nlinarith [mul_le_mul_of_nonneg_left h1 h0.le, mul_pos h0 h0]
    have hpd := (binary_posDef_iff hF).1.2 ⟨h0, hd⟩
    rw [isMinkowskiReduced_iff_gcd]
    refine ⟨hpd, Fin.forall_fin_two.2 ⟨fun b hb => ?_, fun b hb => ?_⟩⟩
    · have hne := tail0 b hb
      have hX : (1 : ℝ) ≤ (b 0 : ℝ) ^ 2 - |(b 0 : ℝ) * b 1| + (b 1 : ℝ) ^ 2 := by
        exact_mod_cast int_aux _ _ hne
      have := bin_ge hF (cast b)
      simp only [cast] at this
      have h4 := mul_le_mul_of_nonneg_right h2 (abs_nonneg ((b 0 : ℝ) * b 1))
      nlinarith [mul_le_mul_of_nonneg_left hX h0.le, mul_nonneg (sub_nonneg.2 h1) (sq_nonneg (b 1 : ℝ))]
    · have hb1 := tail1 b hb
      have hsq : |b 0| ≤ b 0 ^ 2 := by
        have := Int.le_self_sq |b 0|
        rwa [sq_abs] at this
      have hsq' : |(b 0 : ℝ)| ≤ (b 0 : ℝ) ^ 2 := by exact_mod_cast hsq
      have hab : |(b 0 : ℝ) * b 1| = |(b 0 : ℝ)| := by
        rcases hb1 with h | h <;> rw [h] <;> simp
      have hb2 : ((b 1 : ℤ) : ℝ) ^ 2 = 1 := by
        rcases hb1 with h | h <;> rw [h] <;> simp
      have := bin_ge hF (cast b)
      simp only [cast] at this
      rw [hab, hb2] at this
      have h4 := mul_le_mul_of_nonneg_right h2 (abs_nonneg (b 0 : ℝ))
      nlinarith [mul_le_mul_of_nonneg_left hsq' h0.le]

/-- **The triangle of reduced forms** (Cassels, Ch. 12, (6.6), p. 274, and p. 275): a symmetric $F$ with
$f_{00} + f_{11} > 0$ is reduced iff $(\xi, \eta)$ lies in the triangle with vertices $(0, 1)$, $(\pm\tfrac12, 0)$ and is not
the vertex $(0, 1)$: $\eta \ge 0$, $2|\xi| \le 1 - \eta$, $\eta < 1$. -/
@[kb "cassels1978" "Ch. 12, §6, (6.6), p. 274, and p. 275 (the triangle 𝓕)"]
theorem binary_isMinkowskiReduced_iff_triangle {F : Matrix (Fin 2) (Fin 2) ℝ} (hF : F.IsSymm)
    (hs : 0 < F 0 0 + F 1 1) :
    IsMinkowskiReduced F ↔ 0 ≤ binEta F ∧ 2 * |binXi F| ≤ 1 - binEta F ∧ binEta F < 1 := by
  rw [binary_isMinkowskiReduced_iff hF]
  have e1 : 1 - binEta F = 2 * F 0 0 / (F 0 0 + F 1 1) := by
    unfold binEta; field_simp; ring
  have e2 : 2 * |binXi F| = 2 * |2 * F 0 1| / (F 0 0 + F 1 1) := by
    unfold binXi; rw [abs_div, abs_of_pos hs]; ring
  have a1 : 0 ≤ binEta F ↔ F 0 0 ≤ F 1 1 := by
    unfold binEta
    rw [le_div_iff₀ hs]; constructor <;> intro h <;> linarith
  have a2 : binEta F < 1 ↔ 0 < F 0 0 := by
    have : binEta F < 1 ↔ 0 < 1 - binEta F := by constructor <;> intro h <;> linarith
    rw [this, e1]
    constructor
    · intro h; exact (div_pos_iff_of_pos_right hs).1 h |> fun h => by linarith
    · intro h; positivity
  have a3 : 2 * |binXi F| ≤ 1 - binEta F ↔ |2 * F 0 1| ≤ F 0 0 := by
    rw [e1, e2, div_le_div_iff_of_pos_right hs]
    constructor <;> intro h <;> linarith
  rw [a1, a2, a3]
  tauto

/-- **Strictly reduced binary forms** (Cassels, Ch. 12, p. 275): the interior points of the triangle, i.e.
$0 < f_{00} < f_{11}$ and $|2f_{01}| < f_{00}$. -/
@[kb "cassels1978" "Ch. 12, §6, p. 275 (interior points are the strictly reduced forms)"]
theorem binary_isStrictlyReduced_iff {F : Matrix (Fin 2) (Fin 2) ℝ} (hF : F.IsSymm) :
    IsStrictlyReduced F ↔ 0 < F 0 0 ∧ F 0 0 < F 1 1 ∧ |2 * F 0 1| < F 0 0 := by
  rw [isStrictlyReduced_iff]
  constructor
  · rintro ⟨hp, h⟩
    have h0 := ((binary_posDef_iff hF).1.1 hp).1
    have hE : ∀ c : ℤ, (c = 1 ∨ c = -1) → F 1 1 < val F (cast ![c, 1]) := by
      intro c hc
      refine h 1 ![c, 1] (extendsBasis_binE c) ?_ ?_
      · intro h'; have := congrFun h' 0; rcases hc with rfl | rfl <;> simp at this
      · intro h'; have := congrFun h' 1; simp at this
    have e1 := hE 1 (Or.inl rfl)
    have e2 := hE (-1) (Or.inr rfl)
    rw [bin_val hF] at e1 e2
    simp [cast] at e1 e2
    refine ⟨h0, ?_, abs_lt.2 ⟨by linarith, by linarith⟩⟩
    have := h 0 (Pi.single 1 1) extendsBasis_e1
      (by intro h'; have := congrFun h' 0; simp at this)
      (by intro h'; have := congrFun h' 1; simp at this)
    rw [bin_val hF] at this
    simpa [cast] using this
  · rintro ⟨h0, h1, h2⟩
    have h3 : (2 * F 0 1) ^ 2 ≤ F 0 0 ^ 2 := by
      nlinarith [abs_nonneg (2 * F 0 1), sq_abs (2 * F 0 1)]
    have hd : 0 < F 0 0 * F 1 1 - F 0 1 ^ 2 := by
      nlinarith [mul_le_mul_of_nonneg_left h1.le h0.le, mul_pos h0 h0]
    refine ⟨(binary_posDef_iff hF).1.2 ⟨h0, hd⟩, Fin.forall_fin_two.2 ⟨fun e he hn1 hn2 => ?_,
      fun e he hn1 hn2 => ?_⟩⟩
    · have hne := tail0 e ((extendsBasis_iff_gcd _ _).1 he)
      have hge := bin_ge hF (cast e)
      simp only [cast] at hge
      have hδ : 0 ≤ |2 * F 0 1| := abs_nonneg _
      by_cases h1z : e 1 = 0
      · have h0z : e 0 ≠ 0 := by tauto
        have h01 : e 0 ≠ 1 := by
          intro h'; apply hn1; ext k; fin_cases k <;> simp [h', h1z]
        have h02 : e 0 ≠ -1 := by
          intro h'; apply hn2; ext k; fin_cases k <;> simp [h', h1z]
        have h4 : (4 : ℤ) ≤ e 0 ^ 2 := by
          have : e 0 ≤ -2 ∨ 2 ≤ e 0 := by omega
          rcases this with h | h <;> nlinarith
        have h4' : (4 : ℝ) ≤ (e 0 : ℝ) ^ 2 := by exact_mod_cast h4
        rw [h1z] at hge
        simp at hge
        nlinarith
      · by_cases h0z : e 0 = 0
        · have h4 : (1 : ℤ) ≤ e 1 ^ 2 := by
            have : e 1 ≤ -1 ∨ 1 ≤ e 1 := by omega
            rcases this with h | h <;> nlinarith
          have h4' : (1 : ℝ) ≤ (e 1 : ℝ) ^ 2 := by exact_mod_cast h4
          rw [h0z] at hge
          simp at hge
          nlinarith
        · have hX : (1 : ℝ) ≤ (e 0 : ℝ) ^ 2 - |(e 0 : ℝ) * e 1| + (e 1 : ℝ) ^ 2 := by
            exact_mod_cast int_aux _ _ (Or.inl h0z)
          have ht : 0 < |(e 0 : ℝ) * e 1| :=
            abs_pos.2 (mul_ne_zero (Int.cast_ne_zero.2 h0z) (Int.cast_ne_zero.2 h1z))
          have h5 := mul_lt_mul_of_pos_right h2 ht
          nlinarith [mul_le_mul_of_nonneg_left hX h0.le, mul_nonneg (sub_nonneg.2 h1.le) (sq_nonneg (e 1 : ℝ))]
    · have hb1 := tail1 e ((extendsBasis_iff_gcd _ _).1 he)
      have hge := bin_ge hF (cast e)
      simp only [cast] at hge
      have h0z : e 0 ≠ 0 := by
        intro h'
        rcases hb1 with h'' | h''
        · apply hn1; ext k; fin_cases k <;> simp [h', h'']
        · apply hn2; ext k; fin_cases k <;> simp [h', h'']
      have hsq : |e 0| ≤ e 0 ^ 2 := by
        have := Int.le_self_sq |e 0|
        rwa [sq_abs] at this
      have hsq' : |(e 0 : ℝ)| ≤ (e 0 : ℝ) ^ 2 := by exact_mod_cast hsq
      have hge1 : (1 : ℝ) ≤ |(e 0 : ℝ)| := by
        have : 1 ≤ |e 0| := Int.one_le_abs h0z
        exact_mod_cast this
      have hab : |(e 0 : ℝ) * e 1| = |(e 0 : ℝ)| := by
        rcases hb1 with h | h <;> rw [h] <;> simp
      have hb2 : ((e 1 : ℤ) : ℝ) ^ 2 = 1 := by
        rcases hb1 with h | h <;> rw [h] <;> simp
      rw [hab, hb2] at hge
      nlinarith [mul_le_mul_of_nonneg_left hsq' h0.le, mul_lt_mul_of_pos_right h2 (by linarith : 0 < |(e 0 : ℝ)|)]

/-- **$S_1$**: the substitution $(x_0, x_1) \mapsto (x_1, x_0)$ (Cassels, Ch. 12, p. 276; reconstructed, the formulas
are garbled in the machine-read text). It maps $\mathcal F$ to the triangle across the side $\eta = 0$. -/
@[kb "cassels1978" "Ch. 12, §6, p. 276 (S_1)"]
def binS1 : GL (Fin 2) ℤ := ⟨!![0, 1; 1, 0], !![0, 1; 1, 0], by decide, by decide⟩

/-- **$S_2$**: the substitution $(x_0, x_1) \mapsto (x_0 + x_1, x_1)$ (Cassels, Ch. 12, p. 276, reconstructed); $S_3$ is
$S_2^{-1}$. They map $\mathcal F$ to the triangles across the sides $2\xi = \pm(1 - \eta)$. -/
@[kb "cassels1978" "Ch. 12, §6, p. 276 (S_2; S_3 = S_2^{−1})"]
def binS2 : GL (Fin 2) ℤ := ⟨!![1, 1; 0, 1], !![1, -1; 0, 1], by decide, by decide⟩

/-- Helper: the substitution $\mathrm{diag}(1,-1)$. -/
def binD : GL (Fin 2) ℤ := ⟨!![1, 0; 0, -1], !![1, 0; 0, -1], by decide, by decide⟩

/-- Helper: `binD` is sign-diagonal. -/
theorem binD_signDiag : IsSignDiagonal binD := by
  refine ⟨![1, -1], fun i => ?_, ?_⟩
  · fin_cases i <;> simp
  · ext i j
    fin_cases i <;> fin_cases j <;> simp [binD]

/-- Helper: `binS1 * binD` is the image of Mathlib's `S`. -/
theorem toGL_S : Matrix.SpecialLinearGroup.toGL ModularGroup.S = binS1 * binD := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.SpecialLinearGroup.toGL, binS1, binD, ModularGroup.S,
    Matrix.mul_apply, Fin.sum_univ_two]

/-- Helper: the image of Mathlib's `T` is `binS2`. -/
theorem toGL_T : Matrix.SpecialLinearGroup.toGL ModularGroup.T = binS2 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.SpecialLinearGroup.toGL, binS2, ModularGroup.T]

/-- **Generators of $\mathrm{GL}_2(\mathbb{Z})$** (Cassels, Ch. 12, §6, p. 276): the integral unimodular group in two
variables is generated by $S_1$, $S_2$ and the diagonal matrices $\mathrm{diag}(\pm1, \pm1)$. (Cassels reads this off the
tessellation of the disc; here it is derived from Mathlib's generation of $\mathrm{SL}_2(\mathbb{Z})$ by
$\begin{pmatrix}0&-1\\1&0\end{pmatrix}$ and $\begin{pmatrix}1&1\\0&1\end{pmatrix}$,
`Matrix.SpecialLinearGroup.SL2Z_generators`.) -/
@[kb "cassels1978" "Ch. 12, §6, p. 276 (generators S_1, S_2 and the diagonal matrices)"]
theorem gl2_closure : Subgroup.closure ({binS1, binS2} ∪ {T | IsSignDiagonal T}) = ⊤ := by
  set G := Subgroup.closure ({binS1, binS2} ∪ {T | IsSignDiagonal T}) with hG
  have hD : binD ∈ G := Subgroup.subset_closure (Or.inr binD_signDiag)
  have h1 : binS1 ∈ G := Subgroup.subset_closure (Or.inl (by simp))
  have h2 : binS2 ∈ G := Subgroup.subset_closure (Or.inl (by simp))
  have hSL : ∀ s : Matrix.SpecialLinearGroup (Fin 2) ℤ, Matrix.SpecialLinearGroup.toGL s ∈ G := by
    intro s
    have hs : s ∈ Subgroup.closure {ModularGroup.S, ModularGroup.T} := by
      rw [SpecialLinearGroup.SL2Z_generators]; trivial
    have : Matrix.SpecialLinearGroup.toGL s ∈
        (Subgroup.closure {ModularGroup.S, ModularGroup.T}).map
          (Matrix.SpecialLinearGroup.toGL : Matrix.SpecialLinearGroup (Fin 2) ℤ →* GL (Fin 2) ℤ) :=
      Subgroup.mem_map_of_mem _ hs
    rw [MonoidHom.map_closure] at this
    refine (Subgroup.closure_le G).2 ?_ this
    rintro _ ⟨x, hx, rfl⟩
    rcases hx with rfl | hx
    · rw [toGL_S]; exact G.mul_mem h1 hD
    · rw [Set.mem_singleton_iff.1 hx, toGL_T]; exact h2
  rw [eq_top_iff]
  intro g _
  have hdet : IsUnit g.val.det := (Matrix.isUnit_iff_isUnit_det _).1 g.isUnit
  have key : ∀ g : GL (Fin 2) ℤ, g.val.det = 1 → g ∈ G := by
    intro g hg
    have : g = Matrix.SpecialLinearGroup.toGL (⟨g.val, hg⟩ : Matrix.SpecialLinearGroup (Fin 2) ℤ) := by
      ext i j; rfl
    rw [this]; exact hSL _
  rcases Int.isUnit_iff.1 hdet with h | h
  · exact key g h
  · have : (g * binD).val.det = 1 := by
      rw [Units.val_mul, Matrix.det_mul, h]; simp [binD]
    have := G.mul_mem (key _ this) (G.inv_mem hD)
    simpa using this

end QuadFormsKB.Reduction
