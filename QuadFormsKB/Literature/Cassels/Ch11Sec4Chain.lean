/-
# Cassels, Chapter 11, §4: Lemma 4.4 and its Corollary (chains of lattices of prime index)

**Layer:** $\mathbb Z$-lattices `Lat ℚ n` in $V = \mathbb Q^n$ with the form $Q$ = `Q : QuadForm ℚ n`, Cassels'
index $I(\Lambda, \Gamma)$ = `casselsI` and "same determinant" = equal `latIndex` (`Ch11Sec4Index.lean`); the prime
$p$ of a finite place $v$ is `Rat.HeightOneSpectrum.natGenerator v`. "The form induced by $\phi$ on $\Lambda_p$ is
classically integral" is stated as $\lvert B(x, y)\rvert_p \le \lvert 2\rvert_p$ for $x, y \in \Lambda_p$, with
$B(x, y) = Q(x+y) - Q(x) - Q(y) = 2\phi(x, y)$ (`qbil`), as in Lemma 3.8, Corollary.

**Proves**
* Lemma 4.4 (pp. 217–218) (`exists_casselsI_step`): if $p \mid I(\Lambda, \Gamma)$ and the forms on $\Lambda_p$,
  $\Gamma_p$ are classically integral, there is $\Delta$ of the same determinant with $I(\Lambda, \Delta) = p$,
  $I(\Delta, \Gamma) = I(\Lambda, \Gamma)/p$ and classically integral form on $\Delta_p$.
* Lemma 4.4, Corollary (p. 218) (`exists_casselsI_chain`): a chain $\Lambda = \Lambda^{(0)}, \dots,
  \Lambda^{(J)} = \Gamma$ of lattices of the same determinant with $I(\Lambda^{(j)}, \Lambda^{(j+1)})$ prime, product
  $I(\Lambda, \Gamma)$, and all forms classically integral at the primes of $P$.

*Reconstruction.* The displays (4.8) and the conditions (i)–(iii) of the Corollary are garbled in the scan; they are
read from the proofs: (4.8) is $I(\Lambda, \Delta) = p$ ("$\Lambda^{(1)} = \Lambda \cap \Delta$ has index $p$ in both
$\Lambda$ and $\Delta$, which gives (4.8)"), (i) $\Lambda^{(0)} = \Lambda$, $\Lambda^{(J)} = \Gamma$, (ii)
$I(\Lambda^{(j)}, \Lambda^{(j+1)})$ prime, (iii) $\prod_j I(\Lambda^{(j)}, \Lambda^{(j+1)}) = I(\Lambda, \Gamma)$ (the
induction on $I(\Lambda, \Gamma)$).
-/
import QuadFormsKB.Literature.Cassels.Ch11Sec4Index

open NumberField IsDedekindDomain Matrix

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.Lattices

open Tamagawa.SiegelSpace

attribute [local instance 2000] HeightOneSpectrum.instAlgebraAdicCompletion

variable {n : ℕ}

/-! ### Group-theoretic helpers -/

theorem exists_addSubgroup_index_eq_of_dvd_aux {A : Type*} [AddCommGroup A] [Finite A] {k : ℕ}
    (h : k ∣ Nat.card A) : ∃ H : AddSubgroup A, H.index = k := by
  have h' : k ∣ Nat.card (Multiplicative A) := h
  obtain ⟨H, h1, -⟩ := Group.IsNilpotent.exists_normal_index_eq_of_dvd_card h'
  refine ⟨AddSubgroup.toSubgroup.symm H, ?_⟩
  rw [← h1, AddSubgroup.index, Subgroup.index]
  exact Nat.card_congr (Equiv.refl _)

/-- If $H \le K$ has finite index divisible by $k$, there is $H \le H' \le K$ with $[K : H'] = k$. -/
theorem exists_between_relIndex_eq {G : Type*} [AddCommGroup G] {H K : AddSubgroup G} (hHK : H ≤ K) {k : ℕ}
    (hd : k ∣ H.relIndex K) (hne : H.relIndex K ≠ 0) :
    ∃ H' : AddSubgroup G, H ≤ H' ∧ H' ≤ K ∧ H'.relIndex K = k := by
  have : (H.addSubgroupOf K).FiniteIndex := ⟨hne⟩
  have : Finite (K ⧸ H.addSubgroupOf K) := AddSubgroup.finite_quotient_of_finiteIndex
  have hd' : k ∣ Nat.card (K ⧸ H.addSubgroupOf K) := by
    rw [← AddSubgroup.index_eq_card]; exact hd
  obtain ⟨H₁, h₁⟩ := exists_addSubgroup_index_eq_of_dvd_aux hd'
  refine ⟨(H₁.comap (QuotientAddGroup.mk' (H.addSubgroupOf K))).map K.subtype, ?_, ?_, ?_⟩
  · intro x hx
    refine ⟨⟨x, hHK hx⟩, ?_, rfl⟩
    have : (QuotientAddGroup.mk' (H.addSubgroupOf K)) ⟨x, hHK hx⟩ = 0 :=
      (QuotientAddGroup.eq_zero_iff _).2 (AddSubgroup.mem_addSubgroupOf.2 hx)
    exact AddSubgroup.mem_comap.2 (by rw [this]; exact H₁.zero_mem)
  · rintro _ ⟨y, -, rfl⟩; exact y.2
  · unfold AddSubgroup.relIndex
    have e : ∀ C : AddSubgroup K, (C.map K.subtype).addSubgroupOf K = C := by
      intro C; ext y
      simp only [AddSubgroup.mem_addSubgroupOf, AddSubgroup.mem_map]
      constructor
      · rintro ⟨z, hz, hzy⟩
        have : z = y := Subtype.ext hzy
        rwa [this] at hz
      · intro hy; exact ⟨y, hy, rfl⟩
    rw [e, ← h₁]
    exact AddSubgroup.index_comap_of_surjective _ (QuotientAddGroup.mk'_surjective _)

/-- If $K \le K'$ and $K'/K$ is generated by the class of $a$, which has order $p$, then $[K' : K] = p$. -/
theorem relIndex_eq_prime_of_gen {G : Type*} [AddCommGroup G] {K K' : AddSubgroup G} {a : G} (ha : a ∈ K')
    (p : ℕ) [Fact p.Prime] (hgen : ∀ x ∈ K', ∃ m : ℤ, x - m • a ∈ K) (hnot : a ∉ K) (hp : p • a ∈ K) :
    K.relIndex K' = p := by
  set g : K' ⧸ K.addSubgroupOf K' := QuotientAddGroup.mk ⟨a, ha⟩ with hg
  have hord : addOrderOf g = p := by
    refine addOrderOf_eq_prime ?_ ?_
    · rw [hg, ← QuotientAddGroup.mk_nsmul, QuotientAddGroup.eq_zero_iff]
      exact AddSubgroup.mem_addSubgroupOf.2 hp
    · rw [hg]; intro h0
      rw [QuotientAddGroup.eq_zero_iff] at h0
      exact hnot (AddSubgroup.mem_addSubgroupOf.1 h0)
  have htop : AddSubgroup.zmultiples g = ⊤ := by
    rw [eq_top_iff]
    intro q _
    obtain ⟨x, rfl⟩ := QuotientAddGroup.mk_surjective q
    obtain ⟨m, hm⟩ := hgen x.1 x.2
    refine ⟨m, ?_⟩
    show m • g = QuotientAddGroup.mk x
    rw [hg, ← QuotientAddGroup.mk_zsmul, QuotientAddGroup.eq]
    refine AddSubgroup.mem_addSubgroupOf.2 ?_
    simpa [sub_eq_neg_add] using hm
  unfold AddSubgroup.relIndex
  rw [AddSubgroup.index_eq_card, ← AddSubgroup.card_top (G := K' ⧸ K.addSubgroupOf K'), ← htop,
    Nat.card_zmultiples, hord]

/-- An additive subgroup of $\mathbb Q^n$ is an $\mathcal O_\mathbb Q$-submodule. -/
def subOfAddSubgroup (H : AddSubgroup (Fin n → ℚ)) : Submodule (𝓞 ℚ) (Fin n → ℚ) where
  carrier := H
  add_mem' := H.add_mem
  zero_mem' := H.zero_mem
  smul_mem' k x hx := by
    have : k = ((Rat.IsIntegralClosure.intEquiv (𝓞 ℚ) k : ℤ) : 𝓞 ℚ) := by
      apply (Rat.IsIntegralClosure.intEquiv (𝓞 ℚ)).injective
      simp
    rw [this, Int.cast_smul_eq_zsmul]
    exact H.zsmul_mem hx _

@[simp] theorem subOfAddSubgroup_toAddSubgroup (H : AddSubgroup (Fin n → ℚ)) :
    (subOfAddSubgroup H).toAddSubgroup = H := rfl

/-! ### The valuation on $\mathbb Q$ at $p$ -/

section Val

variable (v : HeightOneSpectrum (𝓞 ℚ))

private theorem chain_asIdeal_eq_span :
    v.asIdeal = Ideal.span {((Rat.HeightOneSpectrum.natGenerator v : ℕ) : 𝓞 ℚ)} := by
  have h := Rat.HeightOneSpectrum.span_natGenerator v
  have h2 : v.asIdeal = (v.asIdeal.map (Rat.IsIntegralClosure.intEquiv (𝓞 ℚ))).comap
      (Rat.IsIntegralClosure.intEquiv (𝓞 ℚ)) :=
    (Ideal.comap_map_of_bijective _ (Rat.IsIntegralClosure.intEquiv (𝓞 ℚ)).bijective).symm
  rw [← h] at h2
  rw [h2]
  ext x
  rw [Ideal.mem_comap, Ideal.mem_span_singleton, Ideal.mem_span_singleton]
  have e1 : Rat.IsIntegralClosure.intEquiv (𝓞 ℚ) ((Rat.HeightOneSpectrum.natGenerator v : ℕ) : 𝓞 ℚ) =
      ((Rat.HeightOneSpectrum.natGenerator v : ℕ) : ℤ) := map_natCast _ _
  rw [← e1]
  exact map_dvd_iff _

private theorem chain_natCast_mem_asIdeal_iff (m : ℕ) :
    (m : 𝓞 ℚ) ∈ v.asIdeal ↔ Rat.HeightOneSpectrum.natGenerator v ∣ m := by
  rw [chain_asIdeal_eq_span, Ideal.mem_span_singleton, ← map_dvd_iff (Rat.IsIntegralClosure.intEquiv (𝓞 ℚ)),
    map_natCast, map_natCast, Int.natCast_dvd_natCast]

theorem chain_val_natCast_eq_one {m : ℕ} (h : ¬ Rat.HeightOneSpectrum.natGenerator v ∣ m) :
    v.valuation ℚ (m : ℚ) = 1 := by
  have : ((m : ℕ) : ℚ) = algebraMap (𝓞 ℚ) ℚ (m : 𝓞 ℚ) := by simp
  rw [this, HeightOneSpectrum.valuation_of_algebraMap, HeightOneSpectrum.intValuation_eq_one_iff]
  exact fun hm => h ((chain_natCast_mem_asIdeal_iff v m).1 hm)

theorem val_intCast_le_one (m : ℤ) : v.valuation ℚ (m : ℚ) ≤ 1 := by
  have : (m : ℚ) = algebraMap (𝓞 ℚ) ℚ (m : 𝓞 ℚ) := by simp
  rw [this]; exact v.valuation_le_one _

theorem val_intCast_eq_one {m : ℤ} (h : ¬ ((Rat.HeightOneSpectrum.natGenerator v : ℕ) : ℤ) ∣ m) :
    v.valuation ℚ (m : ℚ) = 1 := by
  have hna : ¬ Rat.HeightOneSpectrum.natGenerator v ∣ m.natAbs := fun hd => h (Int.natCast_dvd.2 hd)
  have := chain_val_natCast_eq_one v hna
  rcases Int.natAbs_eq m with h1 | h1
  · have e : (m : ℚ) = ((m.natAbs : ℕ) : ℚ) := by rw [← Int.cast_natCast, ← h1]
    rw [e]; exact this
  · have e : (m : ℚ) = -((m.natAbs : ℕ) : ℚ) := by rw [← Int.cast_natCast, ← Int.cast_neg, ← h1]
    rw [e, Valuation.map_neg]; exact this

theorem val_p_lt_one : v.valuation ℚ ((Rat.HeightOneSpectrum.natGenerator v : ℕ) : ℚ) < 1 := by
  have : ((Rat.HeightOneSpectrum.natGenerator v : ℕ) : ℚ) =
      algebraMap (𝓞 ℚ) ℚ ((Rat.HeightOneSpectrum.natGenerator v : ℕ) : 𝓞 ℚ) := by simp
  rw [this, HeightOneSpectrum.valuation_of_algebraMap]
  exact (HeightOneSpectrum.intValuation_lt_one_iff_mem v _).2
    ((chain_natCast_mem_asIdeal_iff v _).2 dvd_rfl)

/-- Approximation by integers: if $v(q) \le 1$, then $v(q - m) \le v(p)$ for some $m \in \mathbb Z$. -/
theorem chain_exists_int_approx {q : ℚ} (hq : v.valuation ℚ q ≤ 1) :
    ∃ m : ℤ, v.valuation ℚ (q - m) ≤ v.valuation ℚ ((Rat.HeightOneSpectrum.natGenerator v : ℕ) : ℚ) := by
  have hp := Rat.HeightOneSpectrum.prime_natGenerator v
  have hden : ¬ Rat.HeightOneSpectrum.natGenerator v ∣ q.den := fun hd =>
    (Rat.valuation_le_one_iff_den.1 hq) ((chain_natCast_mem_asIdeal_iff v _).2 hd)
  have hcop : IsCoprime ((Rat.HeightOneSpectrum.natGenerator v : ℕ) : ℤ) (q.den : ℤ) := by
    rw [Nat.isCoprime_iff_coprime]; exact (Nat.Prime.coprime_iff_not_dvd hp).2 hden
  obtain ⟨a, b, hab⟩ := hcop
  refine ⟨q.num * b, ?_⟩
  have hd0 : (q.den : ℚ) ≠ 0 := by exact_mod_cast q.den_nz
  have hab' : (a : ℚ) * (Rat.HeightOneSpectrum.natGenerator v : ℕ) + b * q.den = 1 := by exact_mod_cast hab
  have e : q - ((q.num * b : ℤ) : ℚ) =
      (q.num : ℚ) * a * (Rat.HeightOneSpectrum.natGenerator v : ℕ) / q.den := by
    have hn : (q.num : ℚ) = q * q.den := (Rat.mul_den_eq_num q).symm
    rw [eq_div_iff hd0]
    push_cast
    rw [hn]
    linear_combination (-(q * q.den)) * hab'
  rw [e, map_div₀, map_mul, map_mul, chain_val_natCast_eq_one v hden, div_one]
  calc _ ≤ 1 * 1 * v.valuation ℚ ((Rat.HeightOneSpectrum.natGenerator v : ℕ) : ℚ) :=
        mul_le_mul' (mul_le_mul' (val_intCast_le_one v _) (val_intCast_le_one v _)) le_rfl
    _ = _ := by simp

/-- A rational of valuation $< 1$ has valuation $\le v(p)$. -/
theorem val_le_of_lt_one {u : ℚ} (hu : v.valuation ℚ u < 1) :
    v.valuation ℚ u ≤ v.valuation ℚ ((Rat.HeightOneSpectrum.natGenerator v : ℕ) : ℚ) := by
  obtain ⟨m, hm⟩ := chain_exists_int_approx v hu.le
  by_contra hcon
  push Not at hcon
  have h2 : v.valuation ℚ (u - m) < v.valuation ℚ u := lt_of_le_of_lt hm hcon
  have h3 : v.valuation ℚ (m : ℚ) = v.valuation ℚ u := by
    have : (m : ℚ) = u - (u - m) := by ring
    rw [this]; exact Valuation.map_sub_eq_of_lt_left _ h2
  have hdvd : ((Rat.HeightOneSpectrum.natGenerator v : ℕ) : ℤ) ∣ m := by
    by_contra hnd
    have := val_intCast_eq_one v hnd
    rw [h3] at this; exact hu.ne this
  obtain ⟨k, hk⟩ := hdvd
  have : v.valuation ℚ (m : ℚ) ≤ v.valuation ℚ ((Rat.HeightOneSpectrum.natGenerator v : ℕ) : ℚ) := by
    rw [hk]; push_cast; rw [map_mul]
    exact mul_le_of_le_one_right' (val_intCast_le_one v k)
  exact hcon.not_ge (h3 ▸ this)

end Val

variable (Q : QuadForm ℚ n)

section Integral

variable (v : HeightOneSpectrum (𝓞 ℚ))

/-- Integrality of $B(x, y) = 2\phi(x, y)$ at $v$, for a rational value $q = B(x, y)$: $v(q) \le v(2)$. -/
def Ok2 (q : ℚ) : Prop := v.valuation ℚ q ≤ v.valuation ℚ 2

theorem Ok2.zero : Ok2 v 0 := by simp [Ok2]

theorem Ok2.add {q r : ℚ} (hq : Ok2 v q) (hr : Ok2 v r) : Ok2 v (q + r) :=
  (Valuation.map_add _ _ _).trans (max_le hq hr)

theorem Ok2.mul {q r : ℚ} (hq : Ok2 v q) (hr : v.valuation ℚ r ≤ 1) : Ok2 v (r * q) := by
  unfold Ok2; rw [map_mul]
  calc _ ≤ 1 * v.valuation ℚ q := mul_le_mul' hr le_rfl
    _ = v.valuation ℚ q := one_mul _
    _ ≤ _ := hq

theorem qbil_smul_right' {K : Type*} [Field K] [Algebra ℚ K] [CharZero K] (c : K) (x z : Fin n → K) :
    qbil Q K x (c • z) = c * qbil Q K x z := by
  rw [qbil_comm, qbil_smul_left, qbil_comm]

theorem qbil_locVec (x y : Fin n → ℚ) :
    qbil Q (v.adicCompletion ℚ) (locVec v x) (locVec v y) = algebraMap ℚ (v.adicCompletion ℚ) (qbil Q ℚ x y) := by
  unfold qbil
  rw [RingHom.map_dotProduct]
  congr 1
  funext i
  have := (RingHom.map_mulVec (algebraMap ℚ (v.adicCompletion ℚ)) (Q.hessian.map (algebraMap ℚ ℚ)) y i).symm
  simp only [Matrix.map_map, Algebra.algebraMap_self] at this
  exact this

theorem valued_two_chain : Valued.v (2 : v.adicCompletion ℚ) = v.valuation ℚ 2 := by
  have := valued_algebraMap v (2 : ℚ)
  simpa using this

theorem valued_qbil_locVec (x y : Fin n → ℚ) :
    Valued.v (qbil Q (v.adicCompletion ℚ) (locVec v x) (locVec v y)) = v.valuation ℚ (qbil Q ℚ x y) := by
  rw [qbil_locVec, valued_algebraMap]

/-- Global integrality on a submodule gives local integrality on its localization. -/
theorem loc_qbil_le (X : Submodule (𝓞 ℚ) (Fin n → ℚ)) (h : ∀ x ∈ X, ∀ y ∈ X, Ok2 v (qbil Q ℚ x y)) :
    ∀ x ∈ loc v X, ∀ y ∈ loc v X,
      Valued.v (qbil Q (v.adicCompletion ℚ) x y) ≤ Valued.v (2 : v.adicCompletion ℚ) := by
  have hsm : ∀ (c : v.adicCompletionIntegers ℚ) (y : Fin n → v.adicCompletion ℚ),
      c • y = (c : v.adicCompletion ℚ) • y := fun c y => rfl
  have hc : ∀ c : v.adicCompletionIntegers ℚ, Valued.v (c : v.adicCompletion ℚ) ≤ 1 := fun c =>
    (HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).1 c.2
  have step1 : ∀ x₀ ∈ X, ∀ y ∈ loc v X,
      Valued.v (qbil Q (v.adicCompletion ℚ) (locVec v x₀) y) ≤ Valued.v (2 : v.adicCompletion ℚ) := by
    intro x₀ hx₀ y hy
    induction hy using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨y₀, hy₀, rfl⟩ := hy
      rw [valued_qbil_locVec, valued_two_chain]; exact h x₀ hx₀ y₀ hy₀
    | zero =>
      have : qbil Q (v.adicCompletion ℚ) (locVec v x₀) 0 = 0 := by simp [qbil]
      rw [this, map_zero]; exact zero_le
    | add y z _ _ hy hz =>
      rw [qbil_add_right]; exact (Valuation.map_add _ _ _).trans (max_le hy hz)
    | smul c y _ hy =>
      rw [hsm, qbil_smul_right', map_mul]
      calc _ ≤ 1 * Valued.v (qbil Q (v.adicCompletion ℚ) (locVec v x₀) y) := mul_le_mul' (hc c) le_rfl
        _ = _ := one_mul _
        _ ≤ _ := hy
  intro x hx y hy
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨x₀, hx₀, rfl⟩ := hx
    exact step1 x₀ hx₀ y hy
  | zero =>
    have : qbil Q (v.adicCompletion ℚ) 0 y = 0 := by simp [qbil]
    rw [this, map_zero]; exact zero_le
  | add x z _ _ hx hz =>
    rw [qbil_add_left]; exact (Valuation.map_add _ _ _).trans (max_le hx hz)
  | smul c x _ hx =>
    rw [hsm, qbil_smul_left, map_mul]
    calc _ ≤ 1 * Valued.v (qbil Q (v.adicCompletion ℚ) x y) := mul_le_mul' (hc c) le_rfl
      _ = _ := one_mul _
      _ ≤ _ := hx

/-- Local integrality on a localization gives global integrality on the module. -/
theorem ok2_of_loc (X : Submodule (𝓞 ℚ) (Fin n → ℚ))
    (hX : ∀ x ∈ loc v X, ∀ y ∈ loc v X,
      Valued.v (qbil Q (v.adicCompletion ℚ) x y) ≤ Valued.v (2 : v.adicCompletion ℚ)) :
    ∀ x ∈ X, ∀ y ∈ X, Ok2 v (qbil Q ℚ x y) := by
  intro x hx y hy
  have := hX _ (locVec_mem_loc v hx) _ (locVec_mem_loc v hy)
  rwa [valued_qbil_locVec, valued_two_chain] at this

theorem Ok2.neg {q : ℚ} (hq : Ok2 v q) : Ok2 v (-q) := by
  unfold Ok2; rwa [Valuation.map_neg]

theorem Ok2.sub {q r : ℚ} (hq : Ok2 v q) (hr : Ok2 v r) : Ok2 v (q - r) := by
  rw [sub_eq_add_neg]; exact hq.add v hr.neg

end Integral

section QbilQ

theorem qbil_nsmul_left_q (k : ℕ) (x y : Fin n → ℚ) : qbil Q ℚ (k • x) y = (k : ℚ) * qbil Q ℚ x y := by
  rw [← Nat.cast_smul_eq_nsmul ℚ k x, qbil_smul_left]

theorem qbil_zsmul_left_q (k : ℤ) (x y : Fin n → ℚ) : qbil Q ℚ (k • x) y = (k : ℚ) * qbil Q ℚ x y := by
  rw [← Int.cast_smul_eq_zsmul ℚ k x, qbil_smul_left]

theorem qbil_zsmul_right_q (k : ℤ) (x y : Fin n → ℚ) : qbil Q ℚ x (k • y) = (k : ℚ) * qbil Q ℚ x y := by
  rw [qbil_comm, qbil_zsmul_left_q, qbil_comm]

theorem qbil_nsmul_right_q (k : ℕ) (x y : Fin n → ℚ) : qbil Q ℚ x (k • y) = (k : ℚ) * qbil Q ℚ x y := by
  rw [qbil_comm, qbil_nsmul_left_q, qbil_comm]

variable (v : HeightOneSpectrum (𝓞 ℚ))

/-- **The auxiliary sublattice $L^1$** of Cassels' proof of Lemma 4.4: an index-$p$ subgroup of $L$ containing
$L \cap M$ on which $\phi(a, \cdot)$ is $p$-integral. -/
theorem exists_L1 {L M : Lat ℚ n}
    (hLg : ∀ x ∈ L.1, ∀ y ∈ L.1, Ok2 v (qbil Q ℚ x y))
    (hMg : ∀ x ∈ M.1, ∀ y ∈ M.1, Ok2 v (qbil Q ℚ x y))
    (hdvd : Rat.HeightOneSpectrum.natGenerator v ∣ casselsI L M) {a : Fin n → ℚ} (haM : a ∈ M.1)
    (hpa : Rat.HeightOneSpectrum.natGenerator v • a ∈ L.1) :
    ∃ H : AddSubgroup (Fin n → ℚ), (L.1 ⊓ M.1).toAddSubgroup ≤ H ∧ H ≤ L.1.toAddSubgroup ∧
      H.relIndex L.1.toAddSubgroup = Rat.HeightOneSpectrum.natGenerator v ∧
      ∀ c ∈ H, Ok2 v (qbil Q ℚ a c) := by
  have hp := Rat.HeightOneSpectrum.prime_natGenerator v
  have : Fact (Rat.HeightOneSpectrum.natGenerator v).Prime := ⟨hp⟩
  set p := Rat.HeightOneSpectrum.natGenerator v with hpdef
  have hne : casselsI L M ≠ 0 :=
    relIndex_ne_zero (L := (⟨L.1 ⊓ M.1, isLattice_inf_aux L.2 M.2⟩ : Lat ℚ n)) (M := L) inf_le_left
  have hKL : (L.1 ⊓ M.1).toAddSubgroup ≤ L.1.toAddSubgroup := fun x hx => hx.1
  by_cases hall : ∀ c ∈ L.1, Ok2 v (qbil Q ℚ a c)
  · obtain ⟨H, h1, h2, h3⟩ := exists_between_relIndex_eq hKL hdvd hne
    exact ⟨H, h1, h2, h3, fun c hc => hall c (h2 hc)⟩
  · push Not at hall
    obtain ⟨c₀, hc₀L, hc₀⟩ := hall
    let L2 : AddSubgroup (Fin n → ℚ) :=
      { carrier := {c | c ∈ L.1 ∧ Ok2 v (qbil Q ℚ a c)}
        add_mem' := fun {x y} hx hy => ⟨L.1.add_mem hx.1 hy.1, by
          rw [qbil_add_right]; exact hx.2.add v hy.2⟩
        zero_mem' := ⟨L.1.zero_mem, by
          have : qbil Q ℚ a 0 = 0 := by simp [qbil]
          rw [this]; exact Ok2.zero v⟩
        neg_mem' := fun {x} hx => ⟨L.1.neg_mem hx.1, by
          have : qbil Q ℚ a (-x) = -qbil Q ℚ a x := by
            rw [qbil_comm, qbil_neg_left, qbil_comm]
          rw [this]; exact hx.2.neg v⟩ }
    have hK2 : (L.1 ⊓ M.1).toAddSubgroup ≤ L2 := fun c hc => ⟨hc.1, hMg a haM c hc.2⟩
    have hL2L : L2 ≤ L.1.toAddSubgroup := fun c hc => hc.1
    refine ⟨L2, hK2, hL2L, ?_, fun c hc => hc.2⟩
    -- the key identities
    have hpt : ∀ x ∈ L.1, Ok2 v ((p : ℚ) * qbil Q ℚ a x) := by
      intro x hx
      have := hLg _ hpa x hx
      rwa [qbil_nsmul_left_q] at this
    have hwp : 0 < v.valuation ℚ (p : ℚ) := (Valuation.pos_iff _).2 (Nat.cast_ne_zero.2 hp.ne_zero)
    have hw2 : 0 < v.valuation ℚ (2 : ℚ) := (Valuation.pos_iff _).2 two_ne_zero
    have ht₀ : v.valuation ℚ 2 < v.valuation ℚ (qbil Q ℚ a c₀) := not_le.1 hc₀
    have hh : v.valuation ℚ (p : ℚ) * v.valuation ℚ (qbil Q ℚ a c₀) = v.valuation ℚ 2 := by
      have h1 : v.valuation ℚ (p : ℚ) * v.valuation ℚ (qbil Q ℚ a c₀) ≤ v.valuation ℚ 2 := by
        rw [← map_mul]; exact hpt c₀ hc₀L
      by_contra hne'
      have h2 := lt_of_le_of_ne h1 hne'
      set y : ℚ := (p : ℚ) * qbil Q ℚ a c₀ / 2 with hy
      have hy2 : y * 2 = (p : ℚ) * qbil Q ℚ a c₀ := by rw [hy]; field_simp
      have hy3 : v.valuation ℚ y * v.valuation ℚ 2 = v.valuation ℚ (p : ℚ) * v.valuation ℚ (qbil Q ℚ a c₀) := by
        rw [← map_mul, ← map_mul, hy2]
      have hy1 : v.valuation ℚ y < 1 := by
        by_contra h
        have h' : 1 ≤ v.valuation ℚ y := not_lt.1 h
        have : v.valuation ℚ 2 ≤ v.valuation ℚ y * v.valuation ℚ 2 := by
          simpa using mul_le_mul' h' (le_refl (v.valuation ℚ 2))
        rw [hy3] at this
        exact absurd h2 (not_lt.2 this)
      have h3 := val_le_of_lt_one v hy1
      have h4 : v.valuation ℚ (p : ℚ) * v.valuation ℚ (qbil Q ℚ a c₀) ≤ v.valuation ℚ (p : ℚ) * v.valuation ℚ 2 := by
        rw [← hy3]
        calc _ ≤ v.valuation ℚ (p : ℚ) * v.valuation ℚ 2 := mul_le_mul' h3 le_rfl
          _ = _ := rfl
      have h5 := le_of_mul_le_mul_left h4 hwp
      exact absurd ht₀ (not_lt.2 h5)
    apply relIndex_eq_prime_of_gen (a := c₀) hc₀L p _ _ _
    · intro x hx
      set t := qbil Q ℚ a x with ht
      set t₀ := qbil Q ℚ a c₀ with ht₀def
      have hle : v.valuation ℚ t ≤ v.valuation ℚ t₀ := by
        have h1 : v.valuation ℚ (p : ℚ) * v.valuation ℚ t ≤ v.valuation ℚ (p : ℚ) * v.valuation ℚ t₀ := by
          rw [hh, ← map_mul]; exact hpt x hx
        exact le_of_mul_le_mul_left h1 hwp
      have ht₀ne : t₀ ≠ 0 := by
        intro h0; rw [h0, map_zero] at ht₀; exact absurd ht₀ (not_lt.2 zero_le)
      have hu : v.valuation ℚ (t / t₀) ≤ 1 := by
        rw [map_div₀]
        exact div_le_one_of_le₀ hle zero_le
      obtain ⟨m, hm⟩ := chain_exists_int_approx v hu
      refine ⟨m, ?_⟩
      refine ⟨L.1.toAddSubgroup.sub_mem hx (L.1.toAddSubgroup.zsmul_mem hc₀L m), ?_⟩
      have e : qbil Q ℚ a (x - m • c₀) = t₀ * (t / t₀ - m) := by
        rw [qbil_sub_right, qbil_zsmul_right_q]; field_simp; rfl
      rw [e]
      unfold Ok2
      rw [map_mul]
      calc _ ≤ v.valuation ℚ t₀ * v.valuation ℚ (p : ℚ) := mul_le_mul' le_rfl hm
        _ = _ := by rw [mul_comm]; exact hh
    · intro h; exact hc₀ h.2
    · refine ⟨L.1.nsmul_mem hc₀L p, ?_⟩
      have := hLg _ hpa c₀ hc₀L
      rw [qbil_nsmul_left_q] at this
      rw [qbil_nsmul_right_q]; exact this

end QbilQ


theorem isLattice_between {N X Y : Submodule (𝓞 ℚ) (Fin n → ℚ)} (hN : N.IsLattice ℚ) (hY : Y.IsLattice ℚ)
    (h1 : N ≤ X) (h2 : X ≤ Y) : X.IsLattice ℚ := by
  obtain ⟨d₁, hd₁, hd₁1, -⟩ := exists_global_bounds hN
  obtain ⟨d₂, hd₂, -, hd₂2⟩ := exists_global_bounds hY
  refine isLattice_of_global_bounds (d := d₁ * d₂) (mul_ne_zero hd₁ hd₂) (fun x hx => ?_) (fun x hx => ?_)
  · rw [mul_smul]; exact h1 (hd₁1 _ (intVec.smul_mem d₂ hx))
  · rw [mul_smul]; exact intVec.smul_mem d₁ (hd₂2 x (h2 hx))

/-- **Cassels, Lemma 4.4** (Ch. 11, pp. 217–218): *let $\Lambda, \Gamma$ be $\mathbb Z$-lattices with the same
determinant and let $p$ be a prime dividing $I(\Lambda, \Gamma)$. Suppose that the quadratic forms induced by $\phi$
on $\Lambda_p$, $\Gamma_p$ are integral in the classical sense. Then there is a lattice $\Delta$ with the same
determinant as $\Lambda$ and $\Gamma$ such that $I(\Lambda, \Delta) = p$, $I(\Delta, \Gamma) = I(\Lambda, \Gamma)/p$,
and the form induced by $\phi$ on $\Delta$ is classically integral* (at $p$; at the other primes
$\Delta_q = \Lambda_q$, also stated). (4.8) reconstructed, see the module docstring. -/
@[kb "cassels1978" "Ch. 11, Lemma 4.4, pp. 217–218 ((4.8) reconstructed)"]
theorem exists_casselsI_step {L M : Lat ℚ n} (h : latIndex L = latIndex M) (v : HeightOneSpectrum (𝓞 ℚ))
    (hv : Rat.HeightOneSpectrum.natGenerator v ∣ casselsI L M)
    (hL : ∀ x ∈ loc v L.1, ∀ y ∈ loc v L.1,
      Valued.v (qbil Q (v.adicCompletion ℚ) x y) ≤ Valued.v (2 : v.adicCompletion ℚ))
    (hM : ∀ x ∈ loc v M.1, ∀ y ∈ loc v M.1,
      Valued.v (qbil Q (v.adicCompletion ℚ) x y) ≤ Valued.v (2 : v.adicCompletion ℚ)) :
    ∃ D : Lat ℚ n, latIndex D = latIndex L ∧ casselsI L D = Rat.HeightOneSpectrum.natGenerator v ∧
      casselsI D M = casselsI L M / Rat.HeightOneSpectrum.natGenerator v ∧
      (∀ x ∈ loc v D.1, ∀ y ∈ loc v D.1,
        Valued.v (qbil Q (v.adicCompletion ℚ) x y) ≤ Valued.v (2 : v.adicCompletion ℚ)) ∧
      (∀ w, w ≠ v → loc w D.1 = loc w L.1) := by
  classical
  have hp := Rat.HeightOneSpectrum.prime_natGenerator v
  have : Fact (Rat.HeightOneSpectrum.natGenerator v).Prime := ⟨hp⟩
  set p := Rat.HeightOneSpectrum.natGenerator v with hpdef
  have hLg := ok2_of_loc Q v L.1 hL
  have hMg := ok2_of_loc Q v M.1 hM
  have hcomm := casselsI_comm h
  have hneM : casselsI M L ≠ 0 :=
    relIndex_ne_zero (L := (⟨M.1 ⊓ L.1, isLattice_inf_aux M.2 L.2⟩ : Lat ℚ n)) (M := M) inf_le_left
  have hdvdM : p ∣ casselsI M L := hcomm ▸ hv
  obtain ⟨a, haM, haKn, hpa⟩ := exists_of_prime_dvd_relIndex (H := (M.1 ⊓ L.1).toAddSubgroup)
    (K := M.1.toAddSubgroup) p hdvdM hneM
  have haL : a ∉ L.1 := fun hh => haKn ⟨haM, hh⟩
  have hpaL : p • a ∈ L.1 := hpa.2
  have hpaK : p • a ∈ (L.1 ⊓ M.1) := ⟨hpa.2, hpa.1⟩
  obtain ⟨H, hKH, hHL, hHidx, hHok⟩ := exists_L1 Q v hLg hMg hv haM hpaL
  set D' : AddSubgroup (Fin n → ℚ) := H ⊔ AddSubgroup.zmultiples a with hD'
  -- the lattice D
  have hDlat : (subOfAddSubgroup D').IsLattice ℚ := by
    obtain ⟨d₁, hd₁, hd₁1, -⟩ := exists_global_bounds (isLattice_inf_aux L.2 M.2)
    obtain ⟨dL, hdL, -, hdL2⟩ := exists_global_bounds L.2
    obtain ⟨dM, hdM, -, hdM2⟩ := exists_global_bounds M.2
    refine isLattice_of_global_bounds (d := d₁ * dL * dM) (mul_ne_zero (mul_ne_zero hd₁ hdL) hdM)
      (fun x hx => ?_) (fun x hx => ?_)
    · have e : (d₁ * dL * dM) • x = d₁ • ((dL * dM) • x) := by rw [mul_assoc, mul_smul]
      rw [e]
      exact (le_sup_left : H ≤ D') (hKH (hd₁1 _ (intVec.smul_mem _ hx)))
    · obtain ⟨h₁, hh₁, z, hz, rfl⟩ := AddSubgroup.mem_sup.1 (show x ∈ D' from hx)
      obtain ⟨m, rfl⟩ := AddSubgroup.mem_zmultiples_iff.1 hz
      rw [smul_add, smul_comm _ m a]
      refine add_mem ?_ (zsmul_mem ?_ m)
      · have e : (d₁ * dL * dM) • h₁ = (d₁ * dM) • (dL • h₁) := by
          rw [show d₁ * dL * dM = (d₁ * dM) * dL by ring, mul_smul]
        rw [e]; exact intVec.smul_mem _ (hdL2 h₁ (hHL hh₁))
      · have e : (d₁ * dL * dM) • a = (d₁ * dL) • (dM • a) := by rw [mul_smul]
        rw [e]; exact intVec.smul_mem _ (hdM2 a haM)
  let D : Lat ℚ n := ⟨subOfAddSubgroup D', hDlat⟩
  have hDmem : ∀ x, x ∈ D.1 ↔ x ∈ D' := fun x => Iff.rfl
  -- the lattice H
  have hHlat : (subOfAddSubgroup H).IsLattice ℚ :=
    isLattice_between (isLattice_inf_aux L.2 M.2) L.2 (fun x hx => hKH hx) (fun x hx => hHL hx)
  let Hl : Lat ℚ n := ⟨subOfAddSubgroup H, hHlat⟩
  -- D ∩ L = H
  have hDL : (L.1 ⊓ D.1).toAddSubgroup = H := by
    ext x
    constructor
    · rintro ⟨hxL, hxD⟩
      obtain ⟨h₁, hh₁, z, hz, rfl⟩ := AddSubgroup.mem_sup.1 ((hDmem _).1 hxD)
      obtain ⟨m, rfl⟩ := AddSubgroup.mem_zmultiples_iff.1 hz
      have hma : m • a ∈ L.1 := by
        have := L.1.toAddSubgroup.sub_mem hxL (hHL hh₁)
        simpa using this
      have hdv : (p : ℤ) ∣ m := by
        by_contra hnd
        have hc : IsCoprime (p : ℤ) m :=
          (Nat.prime_iff_prime_int.1 hp).irreducible.coprime_iff_not_dvd.2 hnd
        obtain ⟨s, t, hst⟩ := hc
        have e : a = s • (p • a) + t • (m • a) := by
          rw [← Nat.cast_smul_eq_nsmul ℤ p a, ← mul_smul, ← mul_smul, ← add_smul, hst, one_smul]
        exact haL (e ▸ L.1.toAddSubgroup.add_mem (L.1.toAddSubgroup.zsmul_mem hpaL s)
          (L.1.toAddSubgroup.zsmul_mem hma t))
      obtain ⟨k, rfl⟩ := hdv
      have e : ((p : ℤ) * k) • a = k • (p • a) := by
        rw [mul_comm, mul_smul, Nat.cast_smul_eq_nsmul ℤ p a]
      exact H.add_mem hh₁ (e ▸ H.zsmul_mem (hKH hpaK) k)
    · intro hx
      exact ⟨hHL hx, (hDmem _).2 ((le_sup_left : H ≤ D') hx)⟩
  have hCI1 : casselsI L D = p := by
    unfold casselsI; rw [hDL]; exact hHidx
  -- D ∩ M
  have hDM : (D.1 ⊓ M.1).toAddSubgroup = (L.1 ⊓ M.1).toAddSubgroup ⊔ AddSubgroup.zmultiples a := by
    ext x
    constructor
    · rintro ⟨hxD, hxM⟩
      obtain ⟨h₁, hh₁, z, hz, rfl⟩ := AddSubgroup.mem_sup.1 ((hDmem _).1 hxD)
      obtain ⟨m, rfl⟩ := AddSubgroup.mem_zmultiples_iff.1 hz
      have hmaM : m • a ∈ M.1 := M.1.toAddSubgroup.zsmul_mem haM m
      have h₁M : h₁ ∈ M.1 := by
        have := M.1.toAddSubgroup.sub_mem hxM hmaM
        simpa using this
      exact AddSubgroup.mem_sup.2 ⟨h₁, ⟨hHL hh₁, h₁M⟩, m • a, hz, rfl⟩
    · intro hx
      obtain ⟨k, hk, z, hz, rfl⟩ := AddSubgroup.mem_sup.1 hx
      obtain ⟨m, rfl⟩ := AddSubgroup.mem_zmultiples_iff.1 hz
      refine ⟨(hDmem _).2 (AddSubgroup.add_mem_sup (hKH hk) hz), ?_⟩
      exact M.1.toAddSubgroup.add_mem hk.2 (M.1.toAddSubgroup.zsmul_mem haM m)
  have hKidx : (L.1 ⊓ M.1).toAddSubgroup.relIndex (D.1 ⊓ M.1).toAddSubgroup = p := by
    rw [hDM]
    refine relIndex_eq_prime_of_gen (a := a) (AddSubgroup.mem_sup_right (AddSubgroup.mem_zmultiples a)) p
      ?_ (fun hh => haL hh.1) hpaK
    intro x hx
    obtain ⟨k, hk, z, hz, rfl⟩ := AddSubgroup.mem_sup.1 hx
    obtain ⟨m, rfl⟩ := AddSubgroup.mem_zmultiples_iff.1 hz
    exact ⟨m, by simpa using hk⟩
  have hHDidx : H.relIndex D.1.toAddSubgroup = p := by
    refine relIndex_eq_prime_of_gen (a := a) (AddSubgroup.mem_sup_right (AddSubgroup.mem_zmultiples a)) p
      ?_ (fun hh => haL (hHL hh)) (hKH hpaK)
    intro x hx
    obtain ⟨k, hk, z, hz, rfl⟩ := AddSubgroup.mem_sup.1 hx
    obtain ⟨m, rfl⟩ := AddSubgroup.mem_zmultiples_iff.1 hz
    exact ⟨m, by simpa using hk⟩
  -- indices
  let Kl : Lat ℚ n := ⟨L.1 ⊓ M.1, isLattice_inf_aux L.2 M.2⟩
  let K'l : Lat ℚ n := ⟨D.1 ⊓ M.1, isLattice_inf_aux D.2 M.2⟩
  have e1 : latIndex L = (p : ℝ) * latIndex Hl := by
    have := latIndex_mul_relIndex (L := Hl) (M := L) (fun x hx => hHL hx)
    rw [this]; congr 2
  have e2 : latIndex D = (p : ℝ) * latIndex Hl := by
    have := latIndex_mul_relIndex (L := Hl) (M := D) (fun x hx => (hDmem _).2 ((le_sup_left : H ≤ D') hx))
    rw [this]; congr 2
  have hlat : latIndex D = latIndex L := by rw [e1, e2]
  have e3 : latIndex L = (casselsI L M : ℝ) * latIndex Kl :=
    latIndex_mul_relIndex (L := Kl) (M := L) inf_le_left
  have e4 : latIndex D = (casselsI D M : ℝ) * latIndex K'l :=
    latIndex_mul_relIndex (L := K'l) (M := D) inf_le_left
  have e5 : latIndex K'l = (p : ℝ) * latIndex Kl := by
    have := latIndex_mul_relIndex (L := Kl) (M := K'l) (fun x hx => ⟨(hDmem _).2 ((le_sup_left : H ≤ D') (hKH hx)), hx.2⟩)
    rw [this]; congr 2
  have hpos := latIndex_pos Kl
  have e6 : ((casselsI D M * p : ℕ) : ℝ) = (casselsI L M : ℝ) := by
    have : (casselsI D M : ℝ) * ((p : ℝ) * latIndex Kl) = (casselsI L M : ℝ) * latIndex Kl := by
      rw [← e5, ← e4, hlat, e3]
    push_cast
    apply mul_right_cancel₀ hpos.ne'
    linarith
  have hCID : casselsI D M = casselsI L M / p := by
    have e7 : casselsI L M = casselsI D M * p := by exact_mod_cast e6.symm
    exact (Nat.div_eq_of_eq_mul_left hp.pos e7).symm
  -- integrality
  have hDg : ∀ x ∈ D.1, ∀ y ∈ D.1, Ok2 v (qbil Q ℚ x y) := by
    intro x hx y hy
    obtain ⟨h₁, hh₁, z, hz, rfl⟩ := AddSubgroup.mem_sup.1 ((hDmem _).1 hx)
    obtain ⟨m, rfl⟩ := AddSubgroup.mem_zmultiples_iff.1 hz
    obtain ⟨h₂, hh₂, z', hz', rfl⟩ := AddSubgroup.mem_sup.1 ((hDmem _).1 hy)
    obtain ⟨m', rfl⟩ := AddSubgroup.mem_zmultiples_iff.1 hz'
    have e : qbil Q ℚ (h₁ + m • a) (h₂ + m' • a) =
        (qbil Q ℚ h₁ h₂ + (m' : ℚ) * qbil Q ℚ a h₁) +
        ((m : ℚ) * qbil Q ℚ a h₂ + (m : ℚ) * ((m' : ℚ) * qbil Q ℚ a a)) := by
      rw [qbil_add_left, qbil_add_right, qbil_add_right, qbil_zsmul_left_q, qbil_zsmul_left_q,
        qbil_zsmul_right_q, qbil_zsmul_right_q, qbil_comm Q ℚ h₁ a]
    rw [e]
    refine Ok2.add v (Ok2.add v (hLg _ (hHL hh₁) _ (hHL hh₂)) (Ok2.mul v (hHok _ hh₁) (val_intCast_le_one v _)))
      (Ok2.add v (Ok2.mul v (hHok _ hh₂) (val_intCast_le_one v _)) ?_)
    exact Ok2.mul v (Ok2.mul v (hMg _ haM _ haM) (val_intCast_le_one v _)) (val_intCast_le_one v _)
  refine ⟨D, hlat, hCI1, hCID, loc_qbil_le Q v D.1 hDg, ?_⟩
  intro w hw
  have hLD : latIndex L = latIndex D := hlat.symm
  have hnd : ¬ Rat.HeightOneSpectrum.natGenerator w ∣ casselsI L D := by
    rw [hCI1]
    intro hd
    have := (Nat.prime_dvd_prime_iff_eq (Rat.HeightOneSpectrum.prime_natGenerator w) hp).1 hd
    exact hw (Rat.HeightOneSpectrum.primesEquiv.injective (Subtype.ext this))
  exact ((loc_eq_iff_not_dvd_casselsI hLD w).2 hnd).symm

/-- **Cassels, Lemma 4.4, Corollary** (Ch. 11, p. 218): *suppose that the quadratic forms induced by $\phi$ on
$\Lambda, \Gamma$ are classically $p$-adically integral for a set $P$ of primes which includes all $p \mid I(\Lambda,
\Gamma)$. Then there are lattices $\Lambda^{(j)}$ ($0 \le j \le J$), all with the same determinant as $\Lambda,
\Gamma$, such that (i) $\Lambda^{(0)} = \Lambda$, $\Lambda^{(J)} = \Gamma$; (ii) $I(\Lambda^{(j)}, \Lambda^{(j+1)})$ is
prime; (iii) $\prod_j I(\Lambda^{(j)}, \Lambda^{(j+1)}) = I(\Lambda, \Gamma)$; (iv) the quadratic forms induced on the
$\Lambda^{(j)}$ are classically $p$-adically integral for all $p \in P$.* ((i)–(iii) reconstructed; Cassels indexes
from $1$.) -/
@[kb "cassels1978" "Ch. 11, Lemma 4.4, Cor., p. 218 ((i)–(iii) reconstructed; 0-based)"]
theorem exists_casselsI_chain {L M : Lat ℚ n} (h : latIndex L = latIndex M) (P : Set (HeightOneSpectrum (𝓞 ℚ)))
    (hP : ∀ v, Rat.HeightOneSpectrum.natGenerator v ∣ casselsI L M → v ∈ P)
    (hL : ∀ v ∈ P, ∀ x ∈ loc v L.1, ∀ y ∈ loc v L.1,
      Valued.v (qbil Q (v.adicCompletion ℚ) x y) ≤ Valued.v (2 : v.adicCompletion ℚ))
    (hM : ∀ v ∈ P, ∀ x ∈ loc v M.1, ∀ y ∈ loc v M.1,
      Valued.v (qbil Q (v.adicCompletion ℚ) x y) ≤ Valued.v (2 : v.adicCompletion ℚ)) :
    ∃ (J : ℕ) (Λs : Fin (J + 1) → Lat ℚ n), Λs 0 = L ∧ Λs (Fin.last J) = M ∧
      (∀ j, latIndex (Λs j) = latIndex L) ∧
      (∀ j : Fin J, (casselsI (Λs j.castSucc) (Λs j.succ)).Prime) ∧
      (∏ j : Fin J, casselsI (Λs j.castSucc) (Λs j.succ)) = casselsI L M ∧
      (∀ j, ∀ v ∈ P, ∀ x ∈ loc v (Λs j).1, ∀ y ∈ loc v (Λs j).1,
        Valued.v (qbil Q (v.adicCompletion ℚ) x y) ≤ Valued.v (2 : v.adicCompletion ℚ)) := by
  classical
  suffices key : ∀ N : ℕ, ∀ L' : Lat ℚ n, casselsI L' M = N → latIndex L' = latIndex M →
      (∀ v, Rat.HeightOneSpectrum.natGenerator v ∣ N → v ∈ P) →
      (∀ v ∈ P, ∀ x ∈ loc v L'.1, ∀ y ∈ loc v L'.1,
        Valued.v (qbil Q (v.adicCompletion ℚ) x y) ≤ Valued.v (2 : v.adicCompletion ℚ)) →
      ∃ (J : ℕ) (Λs : Fin (J + 1) → Lat ℚ n), Λs 0 = L' ∧ Λs (Fin.last J) = M ∧
        (∀ j, latIndex (Λs j) = latIndex L') ∧
        (∀ j : Fin J, (casselsI (Λs j.castSucc) (Λs j.succ)).Prime) ∧
        (∏ j : Fin J, casselsI (Λs j.castSucc) (Λs j.succ)) = casselsI L' M ∧
        (∀ j, ∀ v ∈ P, ∀ x ∈ loc v (Λs j).1, ∀ y ∈ loc v (Λs j).1,
          Valued.v (qbil Q (v.adicCompletion ℚ) x y) ≤ Valued.v (2 : v.adicCompletion ℚ)) from
    key _ L rfl h hP hL
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
  intro L' hN hlat hPN hL'
  have hne : casselsI L' M ≠ 0 :=
    relIndex_ne_zero (L := (⟨L'.1 ⊓ M.1, isLattice_inf_aux L'.2 M.2⟩ : Lat ℚ n)) (M := L') inf_le_left
  by_cases hN1 : N = 1
  · have h1 : casselsI L' M = 1 := hN.trans hN1
    have h2 : casselsI M L' = 1 := (casselsI_comm hlat).symm.trans h1
    have hle1 : L'.1 ≤ M.1 := fun x hx =>
      ((AddSubgroup.relIndex_eq_one.1 h1) (show x ∈ L'.1.toAddSubgroup from hx)).2
    have hle2 : M.1 ≤ L'.1 := fun x hx =>
      ((AddSubgroup.relIndex_eq_one.1 h2) (show x ∈ M.1.toAddSubgroup from hx)).2
    have hLM : L' = M := Subtype.ext (le_antisymm hle1 hle2)
    refine ⟨0, fun _ => L', rfl, hLM, fun _ => rfl, fun j => j.elim0, ?_, fun _ => hL'⟩
    simp [h1]
  · have hN0 : N ≠ 0 := by rw [← hN]; exact hne
    obtain ⟨p, hp, hpN⟩ := Nat.exists_prime_and_dvd hN1
    let v : HeightOneSpectrum (𝓞 ℚ) := (Rat.HeightOneSpectrum.primesEquiv (R := 𝓞 ℚ)).symm ⟨p, hp⟩
    have hv : Rat.HeightOneSpectrum.natGenerator v = p :=
      congrArg Subtype.val ((Rat.HeightOneSpectrum.primesEquiv (R := 𝓞 ℚ)).apply_symm_apply ⟨p, hp⟩)
    have hvP : v ∈ P := hPN v (by rw [hv]; exact hpN)
    obtain ⟨D, hDlat, hCI, hCDM, hDint, hDw⟩ := exists_casselsI_step Q hlat v (by rw [hv, hN]; exact hpN)
      (hL' v hvP) (hM v hvP)
    rw [hv] at hCI hCDM
    rw [hN] at hCDM
    have hlt : casselsI D M < N := by
      rw [hCDM]; exact Nat.div_lt_self (Nat.pos_of_ne_zero hN0) hp.one_lt
    obtain ⟨J, Λs', h0, hlast, hlatΛ, hprime, hprod, hint⟩ := ih (casselsI D M) hlt D rfl
      (hDlat.trans hlat)
      (fun u hu => hPN u (hu.trans (by rw [hCDM]; exact Nat.div_dvd_of_dvd hpN)))
      (fun u hu => by
        by_cases huv : u = v
        · subst huv; exact hDint
        · rw [hDw u huv]; exact hL' u hu)
    refine ⟨J + 1, Fin.cons L' Λs', ?_, ?_, ?_, ?_, ?_, ?_⟩
    · simp
    · rw [← Fin.succ_last, Fin.cons_succ]; exact hlast
    · intro j
      refine Fin.cases ?_ (fun i => ?_) j
      · simp
      · rw [Fin.cons_succ]; exact (hlatΛ i).trans hDlat
    · intro j
      refine Fin.cases ?_ (fun i => ?_) j
      · simp only [Fin.castSucc_zero, Fin.cons_zero, Fin.succ_zero_eq_one, Fin.cons_one]
        rw [h0, hCI]; exact hp
      · rw [← Fin.succ_castSucc, Fin.cons_succ, Fin.cons_succ]; exact hprime i
    · rw [Fin.prod_univ_succ]
      have e1 : ∀ i : Fin J, casselsI ((Fin.cons L' Λs' : Fin (J + 1 + 1) → Lat ℚ n) i.succ.castSucc)
          ((Fin.cons L' Λs' : Fin (J + 1 + 1) → Lat ℚ n) i.succ.succ) =
          casselsI (Λs' i.castSucc) (Λs' i.succ) := by
        intro i; rw [← Fin.succ_castSucc, Fin.cons_succ, Fin.cons_succ]
      rw [Finset.prod_congr rfl (fun i _ => e1 i), hprod]
      have e0 : casselsI ((Fin.cons L' Λs' : Fin (J + 1 + 1) → Lat ℚ n) (0 : Fin (J + 1)).castSucc)
          ((Fin.cons L' Λs' : Fin (J + 1 + 1) → Lat ℚ n) (0 : Fin (J + 1)).succ) = p := by
        simp [h0, hCI]
      rw [e0, hCDM, hN]
      exact Nat.mul_div_cancel' hpN
    · intro j
      refine Fin.cases ?_ (fun i => ?_) j
      · simpa using hL'
      · intro u hu; rw [Fin.cons_succ]; exact hint i u hu

end QuadFormsKB.Lattices
