/-
# Cassels, Chapter 11, Theorem 2.1: approximation in $\mathrm{SL}(\Lambda)$

**Layer:** a $\mathbb Z$-lattice $\Lambda$ = `L : Lat ℚ n` in $\mathbb Q^n$, its localizations $\Lambda_p$ = `loc v L.1`;
$\mathrm{SL}(\Lambda)$ = the $\gamma \in \mathrm{GL}_n(\mathbb Q)$ with $\gamma\Lambda = \Lambda$ and $\det\gamma = 1$
(Cassels: "the group of automorphs of $\Lambda$ with determinant $+1$", automorphs of $\Lambda$ as a $\mathbb Z$-module;
no quadratic form is involved), $\mathrm{SL}(\Lambda_p)$ likewise over $\mathbb Z_p$. "Arbitrarily close $p$-adically"
is stated as a congruence: $(\gamma - \beta_p)\Lambda_p \subseteq p^N\Lambda_p$ for a given $N$.

**Proves** Cassels' Theorem 2.1 (p. 206) (`exists_slLat_approx`): for a finite set $P$ of primes and
$\beta_p \in \mathrm{SL}(\Lambda_p)$ ($p \in P$) there is $\beta \in \mathrm{SL}(\Lambda)$ with $\beta \equiv \beta_p$
modulo $p^N\Lambda_p$ for every $p \in P$ ("a straightforward translation of Theorem 2.1 of Chapter 9", the strong
approximation theorem for $\mathrm{SL}_n$). *Proof:* $\mathrm{SL}_n(\mathbb Z_p)$ is generated by elementary
transvections ($\mathbb Z_p$ is local), each approximated by an integral one which is moreover $\equiv 1$ modulo
$q^N$ at the other $q \in P$ (Chinese remainder theorem).
-/
import QuadFormsKB.Literature.Cassels.Ch11Thm13Int

open NumberField IsDedekindDomain Matrix

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.Lattices

attribute [local instance 2000] HeightOneSpectrum.instAlgebraAdicCompletion

variable {n : ℕ}

namespace SLApprox
variable {R : Type*} [CommRing R]

local notation "SLn" => Matrix.SpecialLinearGroup (Fin n) R
local notation "Mat" => Matrix (Fin n) (Fin n) R

theorem tv_mulVec_apply (i j : Fin n) (c : R) (v : Fin n → R) (a : Fin n) :
    (transvection i j c *ᵥ v) a = v a + if a = i then c * v j else 0 := by
  simp [transvection, Matrix.add_mulVec, Matrix.single_mulVec, Function.update_apply]

/-- The transvection as an element of `SL_n(R)`. -/
def tvSL (i j : Fin n) (h : i ≠ j) (c : R) : SLn :=
  ⟨transvection i j c, det_transvection_of_ne i j h c⟩

theorem coe_tvSL (i j : Fin n) (h : i ≠ j) (c : R) :
    ((tvSL i j h c : SLn) : Mat) = transvection i j c := rfl

theorem sl_inv_mulVec (A : SLn) (x : Fin n → R) :
    ((A⁻¹ : SLn) : Mat) *ᵥ ((A : Mat) *ᵥ x) = x := by
  rw [mulVec_mulVec, ← Matrix.SpecialLinearGroup.coe_mul, inv_mul_cancel,
    Matrix.SpecialLinearGroup.coe_one, one_mulVec]

theorem sl_mul_mulVec (A B : SLn) (x : Fin n → R) :
    ((A * B : SLn) : Mat) *ᵥ x = (A : Mat) *ᵥ ((B : Mat) *ᵥ x) := by
  rw [Matrix.SpecialLinearGroup.coe_mul, mulVec_mulVec]

variable (n R) in
/-- Elements of `SL_n(R)` fixing the first `k` standard basis vectors. -/
def stabSL (k : ℕ) : Subgroup SLn where
  carrier := {E | ∀ j : Fin n, (j : ℕ) < k → (E : Mat) *ᵥ Pi.single j 1 = Pi.single j 1}
  mul_mem' := fun {A B} hA hB j hj => by rw [sl_mul_mulVec, hB j hj, hA j hj]
  one_mem' := fun j hj => by
    rw [Matrix.SpecialLinearGroup.coe_one, one_mulVec]
  inv_mem' := fun {A} hA j hj => by
    have := sl_inv_mulVec A (Pi.single j 1)
    rw [hA j hj] at this
    exact this

theorem mem_stabSL {k : ℕ} {E : SLn} :
    E ∈ stabSL n R k ↔ ∀ j : Fin n, (j : ℕ) < k → (E : Mat) *ᵥ Pi.single j 1 = Pi.single j 1 :=
  Iff.rfl

theorem tvSL_mem_stabSL {k : ℕ} (i j : Fin n) (h : i ≠ j) (c : R) (hj : k ≤ (j : ℕ)) :
    tvSL i j h c ∈ stabSL n R k := by
  intro j' hj'
  funext a
  rw [coe_tvSL, tv_mulVec_apply]
  have : j ≠ j' := fun e => by subst e; omega
  simp [this]

variable [IsLocalRing R]

theorem isUnit_add_of_not_isUnit {a b : R} (ha : ¬IsUnit a) (hb : IsUnit b) : IsUnit (a + b) := by
  by_contra h
  have h1 : a + b ∈ IsLocalRing.maximalIdeal R := h
  have h2 : a ∈ IsLocalRing.maximalIdeal R := ha
  have h3 : b ∈ IsLocalRing.maximalIdeal R := by
    simpa using (IsLocalRing.maximalIdeal R).sub_mem h1 h2
  exact (IsLocalRing.mem_maximalIdeal b).mp h3 hb

theorem exists_unit_entry (M : SLn) (k : Fin n) (hM : M ∈ stabSL n R k) :
    ∃ j : Fin n, (k : ℕ) ≤ j ∧ IsUnit ((M : Mat) j k) := by
  by_contra hcon
  push Not at hcon
  have hA : (M⁻¹ : SLn) ∈ stabSL n R k := inv_mem hM
  have h1 : ((M⁻¹ : SLn) : Mat) * (M : Mat) = 1 := by
    rw [← Matrix.SpecialLinearGroup.coe_mul, inv_mul_cancel]; rfl
  have h2 := congrFun (congrFun h1 k) k
  rw [Matrix.mul_apply, Matrix.one_apply_eq] at h2
  have : (1 : R) ∈ IsLocalRing.maximalIdeal R := by
    rw [← h2]
    refine Ideal.sum_mem _ (fun j _ => ?_)
    by_cases hj : (j : ℕ) < k
    · have h0 : ((M⁻¹ : SLn) : Mat) k j = 0 := by
        have := congrFun (hA j hj) k
        have hkj : k ≠ j := fun e => by subst e; omega
        simpa [Matrix.mulVec_single_one, hkj] using this
      rw [h0, zero_mul]; exact Ideal.zero_mem _
    · exact Ideal.mul_mem_left _ _ ((IsLocalRing.mem_maximalIdeal _).mpr (hcon j (not_lt.mp hj)))
  exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top ((Ideal.eq_top_iff_one _).mpr this)

section Steps

theorem exists_clear (G : Subgroup SLn) (k : Fin n)
    (hG : ∀ (i j : Fin n) (h : i ≠ j) (c : R), (k : ℕ) ≤ j → tvSL i j h c ∈ G)
    (v : Fin n → R) (hk : IsUnit (v k)) (s : Finset (Fin n)) (hks : k ∉ s) :
    ∃ E : SLn, E ∈ G ∧ (E : Mat) *ᵥ v = fun a => if a ∈ s then 0 else v a := by
  classical
  revert hks
  refine Finset.induction_on s ?_ ?_
  · intro _
    refine ⟨1, one_mem _, ?_⟩
    simp
  · intro i s hi ih hks
    obtain ⟨E, hE, hEv⟩ := ih (fun h => hks (Finset.mem_insert_of_mem h))
    have hik : i ≠ k := fun h => hks (h ▸ Finset.mem_insert_self _ _)
    have hksn : k ∉ s := fun h => hks (Finset.mem_insert_of_mem h)
    have hw : ∀ a, ((E : Mat) *ᵥ v) a = if a ∈ s then 0 else v a :=
      fun a => congrFun hEv a
    refine ⟨tvSL i k hik (-(((E : Mat) *ᵥ v) i) * ↑(hk.unit⁻¹)) * E,
      mul_mem (hG i k hik _ le_rfl) hE, ?_⟩
    rw [sl_mul_mulVec, coe_tvSL]
    funext a
    rw [tv_mulVec_apply, hw, hw k]
    by_cases hai : a = i
    · subst hai
      have h1 : ((E : Mat) *ᵥ v) a = v a := by rw [hw]; simp [hi]
      have h2 : ((hk.unit⁻¹ : Rˣ) : R) * v k = 1 := by
        have := hk.unit.inv_mul
        rwa [IsUnit.unit_spec] at this
      simp [hi, hksn, h1]
      linear_combination (-(v a)) * h2
    · have : a ∈ insert i s ↔ a ∈ s := by simp [hai]
      simp [hai, this]

theorem mulVec_single_one_apply (M : Mat) (a j : Fin n) : (M *ᵥ Pi.single j 1) a = M a j := by
  simp

theorem exists_to_single (G : Subgroup SLn) (k : Fin n)
    (hG : ∀ (i j : Fin n) (h : i ≠ j) (c : R), (k : ℕ) ≤ j → tvSL i j h c ∈ G)
    (v : Fin n → R) (hv : ∃ j : Fin n, (k : ℕ) ≤ j ∧ IsUnit (v j)) :
    ∃ E : SLn, E ∈ G ∧ ∃ u : Rˣ, (E : Mat) *ᵥ v = Pi.single k (u : R) := by
  classical
  obtain ⟨j, hkj, hj⟩ := hv
  obtain ⟨E₀, hE₀, hu⟩ : ∃ E₀ : SLn, E₀ ∈ G ∧ IsUnit (((E₀ : Mat) *ᵥ v) k) := by
    by_cases hk : IsUnit (v k)
    · exact ⟨1, one_mem _, by simpa using hk⟩
    · have hne : k ≠ j := fun e => hk (e ▸ hj)
      refine ⟨tvSL k j hne 1, hG k j hne 1 hkj, ?_⟩
      rw [coe_tvSL, tv_mulVec_apply]
      simpa using isUnit_add_of_not_isUnit hk hj
  obtain ⟨E₁, hE₁, hE₁v⟩ := exists_clear G k hG _ hu (Finset.univ.erase k) (by simp)
  refine ⟨E₁ * E₀, mul_mem hE₁ hE₀, hu.unit, ?_⟩
  rw [sl_mul_mulVec, hE₁v]
  funext a
  by_cases h : a = k
  · subst h; simp [hu.unit_spec]
  · simp [h]

theorem exists_normalize (G : Subgroup SLn) (k l : Fin n) (hlk : k ≠ l) (hkl : (k : ℕ) ≤ l)
    (hG : ∀ (i j : Fin n) (h : i ≠ j) (c : R), (k : ℕ) ≤ j → tvSL i j h c ∈ G) (u : Rˣ) :
    ∃ E : SLn, E ∈ G ∧ (E : Mat) *ᵥ Pi.single k (u : R) = Pi.single k 1 := by
  refine ⟨tvSL l k hlk.symm (-1) * tvSL k l hlk (1 - (u : R)) * tvSL l k hlk.symm (((u⁻¹ : Rˣ)) : R),
    mul_mem (mul_mem (hG _ _ _ _ le_rfl) (hG _ _ _ _ hkl)) (hG _ _ _ _ le_rfl), ?_⟩
  have hu : ((u⁻¹ : Rˣ) : R) * u = 1 := Units.inv_mul u
  rw [sl_mul_mulVec, sl_mul_mulVec, coe_tvSL, coe_tvSL, coe_tvSL]
  funext a
  simp only [tv_mulVec_apply]
  by_cases hak : a = k
  · subst hak
    simp [hlk, hlk.symm]
  · by_cases hal : a = l
    · subst hal
      simp [hak, hlk, hlk.symm, hu]
    · simp [hak, hal]

theorem eq_one_of_last (N : SLn) (k : Fin n) (hk : (k : ℕ) + 1 = n) (u : R)
    (h1 : ∀ j : Fin n, (j : ℕ) < k → (N : Mat) *ᵥ Pi.single j 1 = Pi.single j 1)
    (h2 : (N : Mat) *ᵥ Pi.single k 1 = Pi.single k u) : u = 1 := by
  classical
  have hN : (N : Mat) = Matrix.diagonal (fun a => if a = k then u else 1) := by
    ext a b
    have hb : (b : ℕ) < k ∨ b = k := by
      rcases lt_or_eq_of_le (show (b : ℕ) ≤ k by omega) with h | h
      · exact Or.inl h
      · exact Or.inr (Fin.ext h)
    rcases hb with hb | rfl
    · have := congrFun (h1 b hb) a
      rw [mulVec_single_one_apply] at this
      rw [this]
      by_cases hab : a = b
      · subst hab
        have : a ≠ k := fun e => by subst e; omega
        simp [this]
      · simp [hab]
    · have := congrFun h2 a
      rw [mulVec_single_one_apply] at this
      rw [this]
      by_cases hab : a = b
      · subst hab; simp
      · simp [hab]
  have hdet := Matrix.SpecialLinearGroup.det_coe N
  rw [hN, Matrix.det_diagonal] at hdet
  simpa using hdet

theorem mem_of_tvSL_mem (H : Subgroup SLn)
    (hH : ∀ (i j : Fin n) (h : i ≠ j) (c : R), tvSL i j h c ∈ H) (M : SLn) : M ∈ H := by
  have key : ∀ d k : ℕ, k + d = n → ∀ M : SLn, M ∈ stabSL n R k → M ∈ H := by
    intro d
    induction d with
    | zero =>
      intro k hk M hM
      have : M = 1 := by
        apply Matrix.SpecialLinearGroup.ext
        intro a b
        have h1 := congrFun (hM b (by omega)) a
        rw [mulVec_single_one_apply] at h1
        rw [h1]
        by_cases hab : a = b
        · subst hab; simp
        · simp [hab, Matrix.one_apply, Ne.symm hab]
      rw [this]; exact one_mem H
    | succ d ih =>
      intro k hk M hM
      have hkn : k < n := by omega
      let kf : Fin n := ⟨k, hkn⟩
      have hG' : ∀ (i j : Fin n) (h : i ≠ j) (c : R), (kf : ℕ) ≤ j →
          tvSL i j h c ∈ H ⊓ stabSL n R k := fun i j h c hj =>
        Subgroup.mem_inf.mpr ⟨hH _ _ _ _, tvSL_mem_stabSL _ _ _ _ hj⟩
      obtain ⟨j, hj, hjunit⟩ := exists_unit_entry M kf hM
      obtain ⟨E, hE, u, hEv⟩ := exists_to_single (H ⊓ stabSL n R k) kf hG'
        ((M : Mat) *ᵥ Pi.single kf 1)
        ⟨j, hj, by rwa [mulVec_single_one_apply]⟩
      have hEstab : E ∈ stabSL n R k := (Subgroup.mem_inf.mp hE).2
      have hEH : E ∈ H := (Subgroup.mem_inf.mp hE).1
      obtain ⟨F, hFH, hFstab, hFv⟩ : ∃ F : SLn, F ∈ H ∧ F ∈ stabSL n R k ∧
          (F : Mat) *ᵥ ((M : Mat) *ᵥ Pi.single kf 1) = Pi.single kf 1 := by
        by_cases hlt : k + 1 < n
        · obtain ⟨E', hE', hE'v⟩ := exists_normalize (H ⊓ stabSL n R k) kf ⟨k + 1, hlt⟩
            (fun e => by have := congrArg Fin.val e; simp [kf] at this) (by simp [kf]) hG' u
          refine ⟨E' * E, mul_mem (Subgroup.mem_inf.mp hE').1 hEH,
            mul_mem (Subgroup.mem_inf.mp hE').2 hEstab, ?_⟩
          rw [sl_mul_mulVec, hEv, hE'v]
        · have hk1 : (kf : ℕ) + 1 = n := by simp [kf]; omega
          have hu : (u : R) = 1 := by
            refine eq_one_of_last (E * M) kf hk1 u (fun j hj => ?_) ?_
            · rw [sl_mul_mulVec, hM j hj, hEstab j hj]
            · rw [sl_mul_mulVec, hEv]
          refine ⟨E, hEH, hEstab, ?_⟩
          rw [hEv, hu]
      have hN : F * M ∈ stabSL n R (k + 1) := by
        intro j hj
        rw [sl_mul_mulVec]
        by_cases hjk : (j : ℕ) < k
        · rw [hM j hjk, hFstab j hjk]
        · have : j = kf := Fin.ext (by simp [kf]; omega)
          subst this
          exact hFv
      have hNH := ih (k + 1) (by omega) _ hN
      have : M = F⁻¹ * (F * M) := by simp
      rw [this]
      exact mul_mem (inv_mem hFH) hNH
  exact key n 0 (by simp) M (fun j hj => absurd hj (Nat.not_lt_zero _))

end Steps


section Abstract

theorem tvSL_zero (i j : Fin n) (h : i ≠ j) {S : Type*} [CommRing S] :
    tvSL i j h (0 : S) = 1 := Subtype.ext (transvection_zero i j)

theorem map_tvSL {S T : Type*} [CommRing S] [CommRing T] (f : S →+* T) (i j : Fin n) (h : i ≠ j)
    (c : S) :
    Matrix.SpecialLinearGroup.map f (tvSL i j h c) = tvSL i j h (f c) := by
  apply Matrix.SpecialLinearGroup.ext
  intro a b
  simp only [Matrix.SpecialLinearGroup.map_apply_coe, RingHom.mapMatrix_apply, Matrix.map_apply,
    coe_tvSL, transvection, Matrix.add_apply, Matrix.one_apply, Matrix.single_apply]
  split_ifs <;> simp_all

variable {ι : Type*} [Fintype ι] [DecidableEq ι] (R Q : ι → Type*) [∀ i, CommRing (R i)]
  [∀ i, CommRing (Q i)]

/-- Elements of $\mathrm{SL}_n(R_i)$ approximable (modulo the maps $\rho_i$) by an integral matrix of
determinant $1$ which is $\equiv 1$ at the other indices. A subgroup. -/
def apprSub (ρ : ∀ i, R i →+* Q i) (i : ι) : Subgroup (Matrix.SpecialLinearGroup (Fin n) (R i)) where
  carrier := {β | ∃ B : Matrix.SpecialLinearGroup (Fin n) ℤ,
    Matrix.SpecialLinearGroup.map (Int.castRingHom (Q i)) B = Matrix.SpecialLinearGroup.map (ρ i) β ∧
      ∀ w, w ≠ i → Matrix.SpecialLinearGroup.map (Int.castRingHom (Q w)) B = 1}
  mul_mem' := by
    rintro a b ⟨A, hA1, hA2⟩ ⟨B, hB1, hB2⟩
    exact ⟨A * B, by rw [map_mul, map_mul, hA1, hB1],
      fun w hw => by rw [map_mul, hA2 w hw, hB2 w hw, mul_one]⟩
  one_mem' := ⟨1, by simp, by simp⟩
  inv_mem' := by
    rintro a ⟨A, h1, h2⟩
    exact ⟨A⁻¹, by rw [map_inv, map_inv, h1], fun w hw => by rw [map_inv, h2 w hw, inv_one]⟩

variable [∀ i, IsLocalRing (R i)]

theorem mem_apprSub (ρ : ∀ i, R i →+* Q i) (hsurj : ∀ i (t : R i), ∃ a : ℤ, ρ i t = (a : Q i))
    (hcrt : ∀ i (a : ℤ), ∃ z : ℤ, (z : Q i) = a ∧ ∀ w, w ≠ i → (z : Q w) = 0) (i : ι)
    (β : Matrix.SpecialLinearGroup (Fin n) (R i)) : β ∈ apprSub (n := n) R Q ρ i := by
  refine mem_of_tvSL_mem _ (fun i' j' h c => ?_) β
  obtain ⟨a, ha⟩ := hsurj i c
  obtain ⟨z, hz1, hz2⟩ := hcrt i a
  refine ⟨tvSL i' j' h z, ?_, fun w hw => ?_⟩
  · rw [map_tvSL, map_tvSL]
    simp [hz1, ha]
  · rw [map_tvSL]
    have : (Int.castRingHom (Q w)) z = 0 := by simpa using hz2 w hw
    rw [this, tvSL_zero]

theorem exists_approx_abstract (ρ : ∀ i, R i →+* Q i)
    (hsurj : ∀ i (t : R i), ∃ a : ℤ, ρ i t = (a : Q i))
    (hcrt : ∀ i (a : ℤ), ∃ z : ℤ, (z : Q i) = a ∧ ∀ w, w ≠ i → (z : Q w) = 0)
    (β : ∀ i, Matrix.SpecialLinearGroup (Fin n) (R i)) :
    ∃ B : Matrix.SpecialLinearGroup (Fin n) ℤ, ∀ i,
      Matrix.SpecialLinearGroup.map (Int.castRingHom (Q i)) B =
        Matrix.SpecialLinearGroup.map (ρ i) (β i) := by
  have key : ∀ s : Finset ι, ∃ B : Matrix.SpecialLinearGroup (Fin n) ℤ, ∀ i ∈ s,
      Matrix.SpecialLinearGroup.map (Int.castRingHom (Q i)) B =
        Matrix.SpecialLinearGroup.map (ρ i) (β i) := by
    intro s
    refine Finset.induction_on s ⟨1, by simp⟩ ?_
    intro j s hj ih
    obtain ⟨B', hB'⟩ := ih
    obtain ⟨Bj, h1, h2⟩ := mem_apprSub (n := n) R Q ρ hsurj hcrt j
      ((Matrix.SpecialLinearGroup.map (Int.castRingHom (R j)) B')⁻¹ * β j)
    refine ⟨B' * Bj, fun i hi => ?_⟩
    rw [map_mul]
    rcases Finset.mem_insert.mp hi with rfl | hi
    · have hcomm : Matrix.SpecialLinearGroup.map (Int.castRingHom (Q i)) B' =
          Matrix.SpecialLinearGroup.map (ρ i) (Matrix.SpecialLinearGroup.map (Int.castRingHom (R i)) B') := by
        apply Matrix.SpecialLinearGroup.ext
        intro a b
        simp
      rw [hcomm, h1, map_mul, map_inv, mul_inv_cancel_left]
    · have hne : i ≠ j := fun e => hj (e ▸ hi)
      rw [h2 i hne, mul_one, hB' i hi]
  obtain ⟨B, hB⟩ := key Finset.univ
  exact ⟨B, fun i => hB i (Finset.mem_univ i)⟩

end Abstract


section CRT

theorem exists_crt {ι : Type*} [Fintype ι] [DecidableEq ι] (m : ι → ℤ)
    (hm : ∀ i j, i ≠ j → IsCoprime (m i) (m j)) (i : ι) (a : ℤ) :
    ∃ z : ℤ, m i ∣ z - a ∧ ∀ w, w ≠ i → m w ∣ z := by
  set Pr : ℤ := ∏ w ∈ Finset.univ.erase i, m w with hPr
  have hc : IsCoprime (m i) Pr :=
    IsCoprime.prod_right (fun w hw => hm i w (Finset.ne_of_mem_erase hw).symm)
  obtain ⟨x, y, hxy⟩ := hc
  refine ⟨a * y * Pr, ⟨-(a * x), ?_⟩, fun w hw => ?_⟩
  · linear_combination a * hxy
  · exact Dvd.dvd.mul_left (Finset.dvd_prod_of_mem _ (Finset.mem_erase.mpr ⟨hw, Finset.mem_univ w⟩)) _

end CRT

section Local

open QuadFormsKB.LocalDensity QuadFormsKB.LocalDensity.NF

variable (v : HeightOneSpectrum (𝓞 ℚ))

private theorem asIdeal_eq_span_p :
    v.asIdeal = Ideal.span {((Rat.HeightOneSpectrum.natGenerator v : ℕ) : 𝓞 ℚ)} := by
  have h := Rat.HeightOneSpectrum.span_natGenerator v
  have h2 : v.asIdeal = (v.asIdeal.map (Rat.IsIntegralClosure.intEquiv (𝓞 ℚ))).comap
      (Rat.IsIntegralClosure.intEquiv (𝓞 ℚ)) :=
    (Ideal.comap_map_of_bijective _ (Rat.IsIntegralClosure.intEquiv (𝓞 ℚ)).bijective).symm
  rw [← h] at h2
  rw [h2]
  ext x
  rw [Ideal.mem_comap, Ideal.mem_span_singleton, Ideal.mem_span_singleton]
  have e1 : Rat.IsIntegralClosure.intEquiv (𝓞 ℚ) ((Rat.HeightOneSpectrum.natGenerator v : ℕ) : 𝓞 ℚ) =
      ((Rat.HeightOneSpectrum.natGenerator v : ℕ) : ℤ) := map_natCast _ _
  rw [← e1]
  exact map_dvd_iff _

/-- $v(p) = e^{-1}$ for the prime $p$ of $v$, as an element of $\mathfrak o_v$. -/
theorem valued_p :
    Valued.v ((((Rat.HeightOneSpectrum.natGenerator v : ℕ) : v.adicCompletionIntegers ℚ) :
      v.adicCompletion ℚ)) = WithZero.exp (-1 : ℤ) := by
  have hne : ((Rat.HeightOneSpectrum.natGenerator v : ℕ) : 𝓞 ℚ) ≠ 0 := by
    exact_mod_cast (Rat.HeightOneSpectrum.prime_natGenerator v).ne_zero
  have : (((Rat.HeightOneSpectrum.natGenerator v : ℕ) : v.adicCompletionIntegers ℚ)) =
      ι v ((Rat.HeightOneSpectrum.natGenerator v : ℕ) : 𝓞 ℚ) := by simp
  rw [this, valued_ι]
  exact HeightOneSpectrum.intValuation_singleton v hne (asIdeal_eq_span_p v)

theorem span_p_pow (N : ℕ) :
    Ideal.span {(((Rat.HeightOneSpectrum.natGenerator v : ℕ) : v.adicCompletionIntegers ℚ)) ^ N} =
      Ideal.span {π v ^ N} := by
  rw [← Ideal.span_singleton_pow, ← Ideal.span_singleton_pow,
    ← (irreducible_of_valued v (valued_p v)).maximalIdeal_eq, ← (irreducible_π v).maximalIdeal_eq]

theorem exists_int_cong_p (N : ℕ) (t : v.adicCompletionIntegers ℚ) :
    ∃ a : ℤ, Ideal.Quotient.mk (Ideal.span {(((Rat.HeightOneSpectrum.natGenerator v : ℕ) :
      v.adicCompletionIntegers ℚ)) ^ N}) t =
      ((a : ℤ) : v.adicCompletionIntegers ℚ ⧸ Ideal.span {(((Rat.HeightOneSpectrum.natGenerator v : ℕ) :
      v.adicCompletionIntegers ℚ)) ^ N}) := by
  obtain ⟨r, hr⟩ := redHom_surjective v N (Ideal.Quotient.mk _ t)
  have hr' : ι v r - t ∈ Ideal.span {π v ^ N} := Ideal.Quotient.eq.mp hr
  rw [← span_p_pow] at hr'
  refine ⟨Rat.IsIntegralClosure.intEquiv (𝓞 ℚ) r, ?_⟩
  have hzr : ι v r = ((Rat.IsIntegralClosure.intEquiv (𝓞 ℚ) r : ℤ) : v.adicCompletionIntegers ℚ) := by
    have : ((Rat.IsIntegralClosure.intEquiv (𝓞 ℚ) r : ℤ) : 𝓞 ℚ) = r := by
      rw [← Tamagawa.RatHeadline3.intEquiv_symm_intCast]
      exact RingEquiv.symm_apply_apply _ r
    conv_lhs => rw [← this]
    rw [map_intCast]
  rw [← map_intCast (Ideal.Quotient.mk (Ideal.span {(((Rat.HeightOneSpectrum.natGenerator v : ℕ) :
      v.adicCompletionIntegers ℚ)) ^ N})), ← hzr]
  exact (Ideal.Quotient.eq.mpr hr').symm

end Local


section IntApprox

open QuadFormsKB.LocalDensity QuadFormsKB.LocalDensity.NF

/-- **Strong approximation for $\mathrm{SL}_n(\mathbb Z)$ at finitely many primes**: matrices in
$\mathrm{SL}_n(\mathbb Z_p)$ ($p \in P$) are simultaneously approximated modulo $p^N$ by one matrix of
$\mathrm{SL}_n(\mathbb Z)$. -/
theorem exists_int_approx (P : Finset (HeightOneSpectrum (𝓞 ℚ))) (N : ℕ)
    (β : ∀ v : P, Matrix.SpecialLinearGroup (Fin n) (v.1.adicCompletionIntegers ℚ)) :
    ∃ B : Matrix.SpecialLinearGroup (Fin n) ℤ, ∀ v : P,
      ∃ C : Matrix (Fin n) (Fin n) (v.1.adicCompletionIntegers ℚ),
        (B : Matrix (Fin n) (Fin n) ℤ).map (Int.castRingHom (v.1.adicCompletionIntegers ℚ)) -
            (β v : Matrix (Fin n) (Fin n) (v.1.adicCompletionIntegers ℚ)) =
          (((Rat.HeightOneSpectrum.natGenerator v.1 : ℕ) : v.1.adicCompletionIntegers ℚ) ^ N) • C := by
  classical
  have hcop : ∀ v w : P, v ≠ w → IsCoprime
      (((Rat.HeightOneSpectrum.natGenerator v.1 : ℕ) : ℤ) ^ N)
      (((Rat.HeightOneSpectrum.natGenerator w.1 : ℕ) : ℤ) ^ N) := by
    intro v w hvw
    have hne : Rat.HeightOneSpectrum.natGenerator v.1 ≠ Rat.HeightOneSpectrum.natGenerator w.1 :=
      fun h => hvw (Subtype.ext
        ((Rat.HeightOneSpectrum.primesEquiv (R := 𝓞 ℚ)).injective (Subtype.ext h)))
    have := (Nat.coprime_primes (Rat.HeightOneSpectrum.prime_natGenerator v.1)
      (Rat.HeightOneSpectrum.prime_natGenerator w.1)).2 hne
    exact (Nat.isCoprime_iff_coprime.2 this).pow
  let I : ∀ v : P, Ideal (v.1.adicCompletionIntegers ℚ) := fun v =>
    Ideal.span {(((Rat.HeightOneSpectrum.natGenerator v.1 : ℕ) : v.1.adicCompletionIntegers ℚ)) ^ N}
  have hzero : ∀ (w : P) (x : ℤ),
      ((Rat.HeightOneSpectrum.natGenerator w.1 : ℕ) : ℤ) ^ N ∣ x →
        ((x : ℤ) : (w.1.adicCompletionIntegers ℚ) ⧸ I w) = 0 := by
    intro w x ⟨c, hc⟩
    rw [← map_intCast (Ideal.Quotient.mk (I w)) x, Ideal.Quotient.eq_zero_iff_mem,
      Ideal.mem_span_singleton]
    exact ⟨(c : _), by rw [hc]; push_cast; ring⟩
  obtain ⟨B, hB⟩ := exists_approx_abstract (n := n) (fun v : P => v.1.adicCompletionIntegers ℚ)
    (fun v : P => (v.1.adicCompletionIntegers ℚ) ⧸ I v) (fun v => Ideal.Quotient.mk (I v))
    (fun v t => exists_int_cong_p v.1 N t)
    (fun v a => by
      obtain ⟨z, hz1, hz2⟩ := exists_crt
        (fun v : P => ((Rat.HeightOneSpectrum.natGenerator v.1 : ℕ) : ℤ) ^ N) hcop v a
      refine ⟨z, ?_, fun w hw => hzero w z (hz2 w hw)⟩
      have := hzero v (z - a) hz1
      push_cast at this
      exact sub_eq_zero.mp this)
    β
  refine ⟨B, fun v => ?_⟩
  have hent : ∀ a b, ∃ c : v.1.adicCompletionIntegers ℚ,
      ((B a b : ℤ) : v.1.adicCompletionIntegers ℚ) - (β v : Matrix _ _ _) a b =
        (((Rat.HeightOneSpectrum.natGenerator v.1 : ℕ) : v.1.adicCompletionIntegers ℚ) ^ N) * c := by
    intro a b
    have h1 := congrArg (fun M : Matrix.SpecialLinearGroup (Fin n) _ => M.1 a b) (hB v)
    simp only [Matrix.SpecialLinearGroup.map_apply_coe, RingHom.mapMatrix_apply, Matrix.map_apply] at h1
    have h2 : Ideal.Quotient.mk (I v) (((B a b : ℤ) : v.1.adicCompletionIntegers ℚ) - (β v : Matrix _ _ _) a b) = 0 := by
      rw [map_sub, sub_eq_zero, map_intCast]
      simpa using h1
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at h2
    exact h2
  choose C hC using hent
  refine ⟨Matrix.of C, ?_⟩
  ext a b
  simp [hC a b]

end IntApprox

end SLApprox


/-- **Cassels, Theorem 2.1** (Ch. 11, p. 206): *let $\Lambda$ be a $\mathbb Z$-lattice and for a finite set $P$ of
primes $p$ let $\beta_p \in \mathrm{SL}(\Lambda_p)$ be given. Then there is a $\beta \in \mathrm{SL}(\Lambda)$ which is
arbitrarily close $p$-adically to each of the $\beta_p$*: for every $N$ there is $\beta$ with
$(\beta - \beta_p)x \in p^N\Lambda_p$ for all $x \in \Lambda_p$, $p \in P$. -/
@[kb "cassels1978" "Ch. 11, Thm. 2.1, p. 206"]
theorem exists_slLat_approx (L : Lat ℚ n) (P : Finset (HeightOneSpectrum (𝓞 ℚ)))
    (β : ∀ v : P, GL (Fin n) (v.1.adicCompletion ℚ))
    (hβ : ∀ v : P, locAct v.1 (β v) (loc v.1 L.1) = loc v.1 L.1 ∧ (β v).val.det = 1) (N : ℕ) :
    ∃ γ : GL (Fin n) ℚ, glImage γ L.1 = L.1 ∧ γ.val.det = 1 ∧
      ∀ v : P, ∀ x ∈ loc v.1 L.1, ∃ y ∈ loc v.1 L.1,
        ((GeneralLinearGroup.map (algebraMap ℚ (v.1.adicCompletion ℚ)) γ).val - (β v).val) *ᵥ x =
          ((Rat.HeightOneSpectrum.natGenerator v.1 : v.1.adicCompletion ℚ) ^ N) • y := by
  classical
  obtain ⟨g, hg⟩ := HilbertModular.exists_latOf_of_isPrincipalIdealRing L
  have hloc : ∀ v : P, loc v.1 L.1 =
      locAct v.1 (GeneralLinearGroup.map (algebraMap ℚ (v.1.adicCompletion ℚ)) g) (std v.1) :=
    fun v => by rw [hg, latOf, loc_glImage, loc_intVec]
  -- the local elements in `SL_n(𝔬_v)`
  have hS : ∀ v : P, ∃ S : Matrix.SpecialLinearGroup (Fin n) (v.1.adicCompletionIntegers ℚ),
      (S : Matrix (Fin n) (Fin n) (v.1.adicCompletionIntegers ℚ)).map
          (algebraMap (v.1.adicCompletionIntegers ℚ) (v.1.adicCompletion ℚ)) =
        ((GeneralLinearGroup.map (algebraMap ℚ (v.1.adicCompletion ℚ)) g)⁻¹ * (β v) *
          GeneralLinearGroup.map (algebraMap ℚ (v.1.adicCompletion ℚ)) g).val := by
    intro v
    set gv := GeneralLinearGroup.map (algebraMap ℚ (v.1.adicCompletion ℚ)) g with hgv
    have hstab : locAct v.1 (gv⁻¹ * β v * gv) (std v.1) = std v.1 := by
      rw [locAct_mul, locAct_mul, ← hloc v, (hβ v).1, hloc v, locAct_inv_locAct]
    obtain ⟨P₀, hP₀⟩ := exists_gl_o_of_locAct_eq v.1 hstab
    have hdet : (gv⁻¹ * β v * gv).val.det = 1 := by
      have h1 : gv⁻¹.val.det * gv.val.det = 1 := by
        rw [← Matrix.det_mul, ← Units.val_mul, inv_mul_cancel, Units.val_one, Matrix.det_one]
      rw [Units.val_mul, Units.val_mul, Matrix.det_mul, Matrix.det_mul, (hβ v).2, mul_one, h1]
    refine ⟨⟨P₀.val, ?_⟩, ?_⟩
    · apply Subtype.val_injective
      have : (P₀.val.map (algebraMap (v.1.adicCompletionIntegers ℚ) (v.1.adicCompletion ℚ))).det =
          algebraMap (v.1.adicCompletionIntegers ℚ) (v.1.adicCompletion ℚ) P₀.val.det :=
        (RingHom.map_det _ _).symm
      rw [← hP₀] at hdet
      simpa [this] using hdet
    · exact congrArg Units.val hP₀
  choose S hSm using hS
  obtain ⟨B, hB⟩ := SLApprox.exists_int_approx P N S
  let Bq : GL (Fin n) ℚ :=
    Matrix.SpecialLinearGroup.toGL (Matrix.SpecialLinearGroup.map (Int.castRingHom ℚ) B)
  have hBqval : Bq.val = (B : Matrix (Fin n) (Fin n) ℤ).map (Int.castRingHom ℚ) := rfl
  have hdetBq : Bq.val.det = 1 :=
    Matrix.SpecialLinearGroup.det_coe (Matrix.SpecialLinearGroup.map (Int.castRingHom ℚ) B)
  refine ⟨g * Bq * g⁻¹, ?_, ?_, ?_⟩
  · have hBq : glImage Bq intVec = intVec := by
      let Pz : GL (Fin n) (𝓞 ℚ) :=
        Matrix.SpecialLinearGroup.toGL (Matrix.SpecialLinearGroup.map (Int.castRingHom (𝓞 ℚ)) B)
      have hmap : GeneralLinearGroup.map (algebraMap (𝓞 ℚ) ℚ) Pz = Bq := by
        apply Units.ext
        ext a b
        simp [Pz, Bq]
      have := glImage_map_intVec (F := ℚ) (n := n) Pz
      rwa [hmap] at this
    rw [hg, latOf, glImage_mul, glImage_mul, ← glImage_mul g⁻¹ g, inv_mul_cancel, glImage_one, hBq]
  · rw [Units.val_mul, Units.val_mul, Matrix.det_mul, Matrix.det_mul, hdetBq, mul_one,
      ← Matrix.det_mul, ← Units.val_mul, mul_inv_cancel, Units.val_one, Matrix.det_one]
  · intro v x hx
    rw [hloc v] at hx
    obtain ⟨z, hz, rfl⟩ := mem_locAct.mp hx
    obtain ⟨C, hC⟩ := hB v
    set gv := GeneralLinearGroup.map (algebraMap ℚ (v.1.adicCompletion ℚ)) g with hgv
    have hGGi : gv.val * gv⁻¹.val = 1 := by rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
    have hGiG : gv⁻¹.val * gv.val = 1 := by rw [← Units.val_mul, inv_mul_cancel, Units.val_one]
    have hBm : Bq.val.map (algebraMap ℚ (v.1.adicCompletion ℚ)) =
        (B : Matrix (Fin n) (Fin n) ℤ).map (Int.castRingHom (v.1.adicCompletion ℚ)) := by
      ext a b; simp [hBqval]
    have hγv : (GeneralLinearGroup.map (algebraMap ℚ (v.1.adicCompletion ℚ)) (g * Bq * g⁻¹)).val =
        gv.val * (B : Matrix (Fin n) (Fin n) ℤ).map (Int.castRingHom (v.1.adicCompletion ℚ)) *
          gv⁻¹.val := by
      rw [map_mul, map_mul, map_inv, Units.val_mul, Units.val_mul, ← hBm]; rfl
    have hβv : (β v).val = gv.val * ((S v : Matrix (Fin n) (Fin n) _).map
        (algebraMap (v.1.adicCompletionIntegers ℚ) (v.1.adicCompletion ℚ))) * gv⁻¹.val := by
      have hSm' := hSm v
      rw [← hgv] at hSm'
      rw [hSm', Units.val_mul, Units.val_mul]
      calc (β v).val = (gv.val * gv⁻¹.val) * (β v).val * (gv.val * gv⁻¹.val) := by
            rw [hGGi, one_mul, mul_one]
        _ = _ := by simp only [Matrix.mul_assoc]
    have hCm : (B : Matrix (Fin n) (Fin n) ℤ).map (Int.castRingHom (v.1.adicCompletion ℚ)) -
        (S v : Matrix (Fin n) (Fin n) _).map
          (algebraMap (v.1.adicCompletionIntegers ℚ) (v.1.adicCompletion ℚ)) =
        ((Rat.HeightOneSpectrum.natGenerator v.1 : v.1.adicCompletion ℚ) ^ N) •
          C.map (algebraMap (v.1.adicCompletionIntegers ℚ) (v.1.adicCompletion ℚ)) := by
      refine Matrix.ext fun a b => ?_
      have h1 := congrFun (congrFun hC a) b
      have h3 := congrArg (algebraMap (v.1.adicCompletionIntegers ℚ) (v.1.adicCompletion ℚ)) h1
      simp only [Matrix.sub_apply, Matrix.smul_apply, Matrix.map_apply, map_sub, map_mul, map_pow,
        map_natCast, eq_intCast, map_intCast, smul_eq_mul] at h3 ⊢
      exact h3
    have hint : ∀ i j, Valued.v ((C.map (algebraMap (v.1.adicCompletionIntegers ℚ)
        (v.1.adicCompletion ℚ))) i j) ≤ 1 := fun i j =>
      (HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mp (C i j).2
    refine ⟨gv.val *ᵥ ((C.map (algebraMap (v.1.adicCompletionIntegers ℚ)
        (v.1.adicCompletion ℚ))) *ᵥ z), ?_, ?_⟩
    · rw [hloc v]
      exact mem_locAct.mpr ⟨_, mulVec_mem_std v.1 hint hz, rfl⟩
    · rw [hγv]
      have : gv.val * (B : Matrix (Fin n) (Fin n) ℤ).map (Int.castRingHom (v.1.adicCompletion ℚ)) *
          gv⁻¹.val - (β v).val = gv.val * ((B : Matrix (Fin n) (Fin n) ℤ).map
            (Int.castRingHom (v.1.adicCompletion ℚ)) - (S v : Matrix (Fin n) (Fin n) _).map
          (algebraMap (v.1.adicCompletionIntegers ℚ) (v.1.adicCompletion ℚ))) * gv⁻¹.val := by
        rw [hβv]; simp only [Matrix.mul_sub, Matrix.sub_mul]
      rw [this, hCm, Matrix.mul_smul, Matrix.smul_mul, Matrix.smul_mulVec]
      congr 1
      have e : gv⁻¹.val *ᵥ (gv.val *ᵥ z) = z := by
        rw [Matrix.mulVec_mulVec, hGiG, Matrix.one_mulVec]
      rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, e]

end QuadFormsKB.Lattices
