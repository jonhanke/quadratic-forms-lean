/-
# Cassels, Chapter 2, §5: the Witt group of a finite field

Source: J. W. S. Cassels, *Rational Quadratic Forms* (1978), Chapter 2, §5, Lemma 5.8, Corollary, p. 27.

**Setting.** As in `Ch2/WittGroup.lean`: $k$ = `K` is a finite field with $2 \ne 0$ (`[Invertible (2 : K)]`, so of
odd order; Cassels: $k = \mathbb F_p$, $p \ne 2$ prime), $W(k)$ = `W K`.

**Proves.** Lemma 5.8, Corollary (p. 27): $|W(k)| = 4$ (`card_W_finiteField`), and $W(k)$ is cyclic if and only if
$-1$ is not a square (`isAddCyclic_W_finiteField_iff`).

**Proof notes.** By Lemma 5.8 (`closure_one_eps`, `zsmul_add_zsmul_eq_zero_iff` in `Ch2/WittGroup.lean`), $G(k)$ is
generated by $\langle 1\rangle$, $\langle\varepsilon\rangle$ ($\varepsilon$ a non-square) with the single relation
$2\langle 1\rangle = 2\langle\varepsilon\rangle$, and $h = \langle 1\rangle + \langle -1\rangle$.
-/
import QuadFormsKB.Literature.Cassels.Ch2.WittGroup

open QuadraticMap Module

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.Cassels

variable {K : Type*} [Field K] [Invertible (2 : K)]

section Finite

variable [Fintype K]

open scoped Classical

/-- Every element of $G(k)$ is a difference of two classes from $S(k)$. -/
theorem G_eq_sub (z : G K) : ∃ s t : S K, z = toG K s - toG K t := by
  induction z using AddLocalization.ind with
  | H p =>
    refine ⟨p.1, p.2, ?_⟩
    rw [AddLocalization.mk_eq_addMonoidOf_mk', AddSubmonoid.LocalizationMap.mk'_eq_iff_eq_add]
    simp

/-- $h = \langle 1\rangle + \langle -1\rangle$ in $S(k)$. -/
theorem hyp_eq_unary : hyp K = unary K 1 + unary K (-1) := by
  rw [← unary_add_star 1, star_unary]

variable (ε : Kˣ) (hε : ¬IsSquare (ε : K))
include hε

/-- Every element of $G(k)$ is $x\langle 1\rangle + y\langle\varepsilon\rangle$ with $x, y \in \mathbb Z$. -/
theorem G_eq_zsmul (z : G K) : ∃ x y : ℤ, z = x • toG K (unary K 1) + y • toG K (unary K ε) := by
  classical
  have hS : ∀ s : S K, ∃ m n : ℕ, toG K s = m • toG K (unary K 1) + n • toG K (unary K ε) := by
    intro s
    have hs : s ∈ AddSubmonoid.closure {unary K 1, unary K ε} := by
      rw [closure_one_eps ε hε]; trivial
    obtain ⟨m, n, rfl⟩ := (AddSubmonoid.mem_closure_pair _ _ _).mp hs
    exact ⟨m, n, by simp⟩
  obtain ⟨s, t, rfl⟩ := G_eq_sub z
  obtain ⟨m, n, hm⟩ := hS s
  obtain ⟨m', n', hm'⟩ := hS t
  refine ⟨(m : ℤ) - m', (n : ℤ) - n', ?_⟩
  rw [hm, hm', sub_smul, sub_smul, natCast_zsmul, natCast_zsmul, natCast_zsmul, natCast_zsmul]
  abel

omit hε in
/-- $\langle -1\rangle = \langle 1\rangle$ if $-1$ is a square. -/
theorem unary_neg_one_of_isSquare (h : IsSquare (-1 : K)) : unary K (-1) = unary K 1 := by
  obtain ⟨b, hb⟩ := h
  have hb0 : b ≠ 0 := by rintro rfl; simp at hb
  have : (-1 : Kˣ) = 1 * (Units.mk0 b hb0) ^ 2 := by ext; simp [hb, _root_.sq]
  rw [this, unary_mul_sq]

/-- $\langle -1\rangle = \langle\varepsilon\rangle$ if $-1$ is not a square. -/
theorem unary_neg_one_of_not_isSquare (h : ¬IsSquare (-1 : K)) : unary K (-1) = unary K ε :=
  unary_eq_of_not_isSquare hε (by simpa using h)

/-- The kernel of $G(k) \to W(k)$ on $x\langle 1\rangle + y\langle\varepsilon\rangle$, when $-1$ is a square. -/
theorem toW_eq_zero_iff_of_isSquare (h : IsSquare (-1 : K)) (x y : ℤ) :
    toW K (x • toG K (unary K 1) + y • toG K (unary K ε)) = 0 ↔ ∃ k : ℤ, (x - 2 * k) + y = 0 ∧ Even y := by
  rw [QuotientAddGroup.mk'_apply, QuotientAddGroup.eq_zero_iff, AddSubgroup.mem_zmultiples_iff,
    hyp_eq_unary, map_add, unary_neg_one_of_isSquare h]
  constructor
  · rintro ⟨k, hk⟩
    refine ⟨k, (zsmul_add_zsmul_eq_zero_iff ε hε (x - 2 * k) y).mp ?_⟩
    rw [sub_smul, mul_smul, two_smul]; linear_combination (norm := module) (-1 : ℤ) • hk
  · rintro ⟨k, hk⟩
    refine ⟨k, ?_⟩
    have := (zsmul_add_zsmul_eq_zero_iff ε hε (x - 2 * k) y).mpr hk
    rw [sub_smul, mul_smul, two_smul] at this
    linear_combination (norm := module) (-1 : ℤ) • this

/-- The kernel of $G(k) \to W(k)$ on $x\langle 1\rangle + y\langle\varepsilon\rangle$, when $-1$ is not a
square. -/
theorem toW_eq_zero_iff_of_not_isSquare (h : ¬IsSquare (-1 : K)) (x y : ℤ) :
    toW K (x • toG K (unary K 1) + y • toG K (unary K ε)) = 0 ↔
      ∃ k : ℤ, (x - k) + (y - k) = 0 ∧ Even (y - k) := by
  rw [QuotientAddGroup.mk'_apply, QuotientAddGroup.eq_zero_iff, AddSubgroup.mem_zmultiples_iff,
    hyp_eq_unary, map_add, unary_neg_one_of_not_isSquare ε hε h]
  constructor
  · rintro ⟨k, hk⟩
    refine ⟨k, (zsmul_add_zsmul_eq_zero_iff ε hε (x - k) (y - k)).mp ?_⟩
    rw [sub_smul, sub_smul]; linear_combination (norm := module) (-1 : ℤ) • hk
  · rintro ⟨k, hk⟩
    refine ⟨k, ?_⟩
    have := (zsmul_add_zsmul_eq_zero_iff ε hε (x - k) (y - k)).mpr hk
    rw [sub_smul, sub_smul] at this
    linear_combination (norm := module) (-1 : ℤ) • this


/-- Every element of $W(k)$ is $x\langle 1\rangle + y\langle\varepsilon\rangle$. -/
theorem W_eq_zsmul (w : W K) :
    ∃ x y : ℤ, w = x • toW K (toG K (unary K 1)) + y • toW K (toG K (unary K ε)) := by
  obtain ⟨z, rfl⟩ := QuotientAddGroup.mk'_surjective _ w
  obtain ⟨x, y, rfl⟩ := G_eq_zsmul ε hε z
  exact ⟨x, y, by simp only [map_add, map_zsmul]⟩

omit hε in
/-- In $W(k)$, `x • a + y • b` is the image of `x • A + y • B`. -/
theorem toW_zsmul_add (x y : ℤ) :
    x • toW K (toG K (unary K 1)) + y • toW K (toG K (unary K ε)) =
      toW K (x • toG K (unary K 1) + y • toG K (unary K ε)) := by
  simp only [map_add, map_zsmul]

omit hε in
/-- An element of order dividing $2$: $x \cdot a$ is $0$ or $a$. -/
theorem zsmul_eq_of_two {A : Type*} [AddCommGroup A] {a : A} (ha : (2 : ℤ) • a = 0) (x : ℤ) :
    x • a = 0 ∨ x • a = a := by
  obtain ⟨m, rfl | rfl⟩ := Int.even_or_odd' x
  · left; rw [mul_comm, mul_zsmul, ha, zsmul_zero]
  · right; rw [add_zsmul, mul_comm, mul_zsmul, ha, zsmul_zero, zero_add, one_zsmul]

/-- $-1$ a square: $W(k) = \{0, a, b, a + b\}$ with $a = \langle 1\rangle$, $b = \langle\varepsilon\rangle$, all distinct
and $2a = 2b = 0$. -/
theorem W_klein (h : IsSquare (-1 : K)) :
    let a := toW K (toG K (unary K 1))
    let b := toW K (toG K (unary K ε))
    (2 : ℤ) • a = 0 ∧ (2 : ℤ) • b = 0 ∧ a ≠ 0 ∧ b ≠ 0 ∧ a + b ≠ 0 ∧ a ≠ b := by
  intro a b
  have key := toW_eq_zero_iff_of_isSquare ε hε h
  have e : ∀ x y : ℤ, x • a + y • b = 0 ↔ ∃ k : ℤ, (x - 2 * k) + y = 0 ∧ Even y := fun x y => by
    rw [toW_zsmul_add]; exact key x y
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · have := (e 2 0).mpr ⟨1, by norm_num, by decide⟩; simpa using this
  · have := (e 0 2).mpr ⟨1, by norm_num, by decide⟩; simpa using this
  · intro h0
    obtain ⟨k, hk, -⟩ := (e 1 0).mp (by simpa using h0)
    omega
  · intro h0
    obtain ⟨k, -, hk⟩ := (e 0 1).mp (by simpa using h0)
    exact Int.not_even_one hk
  · intro h0
    obtain ⟨k, -, hk⟩ := (e 1 1).mp (by simpa using h0)
    exact Int.not_even_one hk
  · intro h0
    obtain ⟨k, -, hk⟩ := (e 1 (-1)).mp (by rw [h0]; simp)
    simp at hk

/-- $-1$ not a square: $W(k)$ is generated by $b = \langle\varepsilon\rangle$, of order $4$. -/
theorem W_cyclic (h : ¬IsSquare (-1 : K)) :
    (∀ w : W K, w ∈ AddSubgroup.zmultiples (toW K (toG K (unary K ε)))) ∧
      addOrderOf (toW K (toG K (unary K ε))) = 4 := by
  set a := toW K (toG K (unary K 1))
  set b := toW K (toG K (unary K ε))
  have key := toW_eq_zero_iff_of_not_isSquare ε hε h
  have e : ∀ x y : ℤ, x • a + y • b = 0 ↔ ∃ k : ℤ, (x - k) + (y - k) = 0 ∧ Even (y - k) := fun x y => by
    rw [toW_zsmul_add]; exact key x y
  have hab : a = -b := by
    have := (e 1 1).mpr ⟨1, by norm_num, by norm_num⟩
    simp only [one_zsmul] at this
    exact eq_neg_of_add_eq_zero_left this
  refine ⟨fun w => ?_, ?_⟩
  · obtain ⟨x, y, rfl⟩ := W_eq_zsmul ε hε w
    refine AddSubgroup.mem_zmultiples_iff.mpr ⟨y - x, ?_⟩
    show (y - x) • b = x • a + y • b
    rw [hab, sub_zsmul, zsmul_neg]; abel
  · have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    have h4 : (2 ^ (1 + 1)) • b = 0 := by
      have := (e 0 4).mpr ⟨2, by norm_num, by decide⟩
      simp only [zero_smul, zero_add] at this
      rw [← natCast_zsmul]; simpa using this
    have h2 : ¬ (2 ^ 1) • b = 0 := by
      intro h0
      obtain ⟨k, hk, hk'⟩ := (e 0 2).mp (by rw [← natCast_zsmul] at h0; simpa using h0)
      have : k = 1 := by omega
      subst this
      exact Int.not_even_one hk'
    simpa using addOrderOf_eq_prime_pow h2 h4

omit hε in
/-- A non-square unit of a finite field of odd order. -/
theorem exists_nonsquare_unit : ∃ ε : Kˣ, ¬IsSquare (ε : K) := by
  obtain ⟨c, hc⟩ := FiniteField.exists_nonsquare (ringChar_ne_two_of_invertible (K := K))
  have hc0 : c ≠ 0 := by rintro rfl; exact hc ⟨0, by simp⟩
  exact ⟨Units.mk0 c hc0, hc⟩

omit hε

/-- **Cassels, Ch. 2, Lemma 5.8, Corollary (order).** For a finite field $k$ of odd order (Cassels:
$k = \mathbb F_p$, $p \ne 2$ prime) the Witt group $W(k)$ has order $4$. -/
@[kb "cassels1978" "Ch. 2, Lemma 5.8, Cor., p. 27 (W has order 4)"]
theorem card_W_finiteField : Nat.card (W K) = 4 := by
  obtain ⟨ε, hε⟩ := exists_nonsquare_unit (K := K)
  by_cases h : IsSquare (-1 : K)
  · obtain ⟨h2a, h2b, ha, hb, hab, hne⟩ := W_klein ε hε h
    set a := toW K (toG K (unary K 1))
    set b := toW K (toG K (unary K ε))
    let f : Fin 4 → W K := ![0, a, b, a + b]
    have hf : Function.Bijective f := by
      constructor
      · intro i j hij
        fin_cases i <;> fin_cases j <;> simp [f] at hij ⊢ <;>
          first
          | exact absurd hij.symm ha | exact absurd hij ha | exact absurd hij.symm hb | exact absurd hij hb
          | exact absurd hij.symm hab | exact absurd hij hab | exact absurd hij hne | exact absurd hij.symm hne
      · intro w
        obtain ⟨x, y, rfl⟩ := W_eq_zsmul ε hε w
        rcases zsmul_eq_of_two h2a x with hx | hx <;> rcases zsmul_eq_of_two h2b y with hy | hy <;>
          rw [hx, hy]
        · exact ⟨0, by simp [f]⟩
        · exact ⟨2, by simp [f]⟩
        · exact ⟨1, by simp [f]⟩
        · exact ⟨3, by simp [f]⟩
    rw [← Nat.card_eq_of_bijective f hf, Nat.card_eq_fintype_card, Fintype.card_fin]
  · obtain ⟨hgen, hord⟩ := W_cyclic ε hε h
    rw [← hord, ← Nat.card_zmultiples]
    have : AddSubgroup.zmultiples (toW K (toG K (unary K ε))) = ⊤ := eq_top_iff.mpr fun w _ => hgen w
    rw [this, AddSubgroup.card_top]

/-- **Cassels, Ch. 2, Lemma 5.8, Corollary (structure).** For a finite field $k$ of odd order, $W(k)$ is cyclic if
and only if $-1$ is not a square in $k$ (Cassels: "non-cyclic if $-1 \in (k^{*})^{2}$, otherwise cyclic"). -/
@[kb "cassels1978" "Ch. 2, Lemma 5.8, Cor., p. 27 (cyclic iff −1 is not a square)"]
theorem isAddCyclic_W_finiteField_iff : IsAddCyclic (W K) ↔ ¬IsSquare (-1 : K) := by
  obtain ⟨ε, hε⟩ := exists_nonsquare_unit (K := K)
  constructor
  · rintro ⟨g, hg⟩ h
    obtain ⟨h2a, h2b, ha, hb, -, hne⟩ := W_klein ε hε h
    set a := toW K (toG K (unary K 1))
    set b := toW K (toG K (unary K ε))
    have h2g : (2 : ℤ) • g = 0 := by
      obtain ⟨x, y, hxy⟩ := W_eq_zsmul ε hε g
      rw [hxy, smul_add, smul_comm 2 x, smul_comm 2 y, h2a, h2b, smul_zero, smul_zero, add_zero]
    have hval : ∀ w : W K, w ≠ 0 → w = g := fun w hw => by
      obtain ⟨n, rfl⟩ := hg w
      rcases zsmul_eq_of_two h2g n with h0 | h0
      · exact absurd h0 hw
      · exact h0
    exact hne ((hval a ha).trans (hval b hb).symm)
  · intro h
    exact ⟨⟨_, (W_cyclic ε hε h).1⟩⟩

end Finite

end QuadFormsKB.Cassels
