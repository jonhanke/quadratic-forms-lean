/-
# Cassels, Chapter 9, §2: bases of $\mathbb Z^n$

**Layer:** vectors and matrices over $\mathbb Z$ and over the $p$-adic integers $\mathbb Z_p$ = `ℤ_[p]` (Mathlib's
`PadicInt`), for a finite set $P$ of primes = `P : Finset Nat.Primes`. A basis $c_1, \dots, c_n$ of $\mathbb Z^n$
(Cassels' notation, 1-based) is the list of columns of a matrix in $\mathrm{GL}_n(\mathbb Z)$; here the columns are
indexed $0, \dots, n-1$. "Arbitrarily close in the $p$-adic topology" is stated with the $p$-adic norm and a real
$\varepsilon > 0$, as in Cassels ($\lVert b\rVert_p = \max_i \lvert b_i\rvert_p$, so closeness of vectors is closeness
of every coordinate).

**Proves**
* Lemma 2.1 (`tfae_extends_basis`): for $c_0, \dots, c_{J-1} \in \mathbb Z^n$ ($J \le n$) the three statements
  (i) they extend to a basis of $\mathbb Z^n$, (ii) the determinants of the $J \times J$ submatrices of the $n \times J$
  matrix $(c_0 \cdots c_{J-1})$ have no common divisor other than a unit, (iii) $\sum_j v_jc_j \in \mathbb Z^n$ with
  $v_j \in \mathbb Q$ forces $v_j \in \mathbb Z$, are equivalent;
* the Corollary (`exists_basis_first_iff_gcd`): $c$ is primitive (the first vector of a basis) iff
  $\gcd(c_0, \dots, c_{n-1}) = 1$; in the form with $\det = +1$ for $n \ge 2$ (`exists_sl_first_of_gcd`);
* Lemma 2.2 (`exists_int_approx_gcd`): integers close to prescribed $p$-adic integers with greatest common divisor $1$;
* Theorem 2.1 (`exists_basis_approx`): a basis of $\mathbb Z^n$ of determinant $\delta = \pm 1$ arbitrarily close to
  given bases of the $\mathbb Z_p^n$ ($p \in P$) of determinant $\delta$.

*Proof of Theorem 2.1:* not Cassels' column-by-column induction but the argument of Chapter 11, Theorem 2.1
(`Lattices.SLApprox.exists_approx_abstract`: $\mathrm{SL}_n$ of a local ring is generated by transvections, each
approximated by an integral one with the Chinese remainder theorem).
-/
import QuadFormsKB.Literature.Cassels.Ch9Sec1
import QuadFormsKB.Literature.Cassels.Ch11Sec2
import QuadFormsKB.Literature.Cassels.Ch11Sec6Subst
import QuadFormsKB.Literature.Cassels.Ch12.Basic

open Matrix

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.Siegel

variable {n : ℕ}

local instance (p : Nat.Primes) : Fact (p : ℕ).Prime := ⟨p.2⟩

/-! ### Helpers for the $p$-adic approximation statements -/

/-- For every $\varepsilon > 0$ there is $N$ with $p^{-N} < \varepsilon$ for all primes $p$. -/
private theorem exists_pow_neg_lt {ε : ℝ} (hε : 0 < ε) :
    ∃ N : ℕ, 1 ≤ N ∧ ∀ q : ℕ, 2 ≤ q → (q : ℝ) ^ (-(N : ℤ)) < ε := by
  obtain ⟨N, hN⟩ := exists_pow_lt_of_lt_one hε (show (1 / 2 : ℝ) < 1 by norm_num)
  refine ⟨N + 1, by omega, fun q hq => ?_⟩
  have hq' : (2 : ℝ) ≤ q := by exact_mod_cast hq
  have h1 : (q : ℝ) ^ (-((N + 1 : ℕ) : ℤ)) = ((q : ℝ) ^ (N + 1))⁻¹ := by
    rw [_root_.zpow_neg, zpow_natCast]
  rw [h1]
  have h2 : (2 : ℝ) ^ (N + 1) ≤ (q : ℝ) ^ (N + 1) := pow_le_pow_left₀ (by norm_num) hq' _
  calc ((q : ℝ) ^ (N + 1))⁻¹ ≤ ((2 : ℝ) ^ (N + 1))⁻¹ := inv_anti₀ (by positivity) h2
    _ ≤ ((2 : ℝ) ^ N)⁻¹ := inv_anti₀ (by positivity) (pow_le_pow_right₀ (by norm_num) (by omega))
    _ = (1 / 2 : ℝ) ^ N := by rw [one_div, inv_pow]
    _ < ε := hN

/-- Every $p$-adic integer is congruent mod $p^N$ to a rational integer. -/
private theorem exists_int_toZModPow (p : ℕ) [Fact p.Prime] (N : ℕ) (t : ℤ_[p]) :
    ∃ a : ℤ, PadicInt.toZModPow N t = (a : ZMod (p ^ N)) :=
  ⟨((PadicInt.toZModPow N t).val : ℤ), by simp⟩

/-- An element of the kernel of `toZModPow N` has norm at most $p^{-N}$. -/
private theorem norm_le_of_toZModPow_eq_zero (p : ℕ) [Fact p.Prime] (N : ℕ) {x : ℤ_[p]}
    (h : PadicInt.toZModPow N x = 0) : ‖x‖ ≤ (p : ℝ) ^ (-(N : ℤ)) := by
  rw [PadicInt.norm_le_pow_iff_mem_span_pow, ← PadicInt.ker_toZModPow]
  exact h

/-- Chinese remainder theorem in the form needed for `exists_approx_abstract` with moduli $p^N$. -/
private theorem crt_primes (P : Finset Nat.Primes) (N : ℕ) (i : P) (a : ℤ) :
    ∃ z : ℤ, (z : ZMod ((i : Nat.Primes) ^ N : ℕ)) = a ∧
      ∀ w : P, w ≠ i → (z : ZMod ((w : Nat.Primes) ^ N : ℕ)) = 0 := by
  obtain ⟨z, hz1, hz2⟩ := QuadFormsKB.Lattices.SLApprox.exists_crt (ι := P) (fun q => (((q : Nat.Primes) ^ N : ℕ) : ℤ))
    (fun i j hij => by
      rw [Nat.isCoprime_iff_coprime]
      apply Nat.Coprime.pow
      exact (Nat.coprime_primes (i : Nat.Primes).2 (j : Nat.Primes).2).2
        (fun h => hij (Subtype.ext (Nat.Primes.coe_nat_injective h)))) i a
  refine ⟨z, ?_, fun w hw => ?_⟩
  · have : NeZero (((i : Nat.Primes) : ℕ) ^ N) := ⟨pow_ne_zero _ (i : Nat.Primes).2.ne_zero⟩
    rw [ZMod.intCast_eq_intCast_iff_dvd_sub]
    simpa using (dvd_sub_comm.mp hz1)
  · have : NeZero (((w : Nat.Primes) : ℕ) ^ N) := ⟨pow_ne_zero _ (w : Nat.Primes).2.ne_zero⟩
    rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
    exact hz2 w hw

/-- Chinese remainder theorem for a finite set of primes with prescribed prime-power moduli. -/
private theorem crt_nat (S : Finset ℕ) (hS : ∀ r ∈ S, r.Prime) (e : ℕ → ℕ) (a : ℕ → ℤ) :
    ∃ z : ℤ, ∀ r ∈ S, ((r ^ e r : ℕ) : ℤ) ∣ z - a r := by
  have hcop : ∀ i j : S, i ≠ j → IsCoprime (((i : ℕ) ^ e i : ℕ) : ℤ) (((j : ℕ) ^ e j : ℕ) : ℤ) := by
    intro i j hij
    rw [Nat.isCoprime_iff_coprime]
    apply Nat.Coprime.pow
    exact (Nat.coprime_primes (hS i i.2) (hS j j.2)).2 (fun h => hij (Subtype.ext h))
  have hex := fun i : S => QuadFormsKB.Lattices.SLApprox.exists_crt (ι := S)
    (fun q => (((q : ℕ) ^ e q : ℕ) : ℤ)) hcop i (a i)
  choose zf hz1 hz2 using hex
  refine ⟨∑ i : S, zf i, fun r hr => ?_⟩
  have h0 : (⟨r, hr⟩ : S) ∈ (Finset.univ : Finset S) := Finset.mem_univ _
  have e1 : ∑ i : S, zf i - a r = (zf ⟨r, hr⟩ - a r) + ∑ i ∈ Finset.univ.erase ⟨r, hr⟩, zf i := by
    rw [← Finset.add_sum_erase _ _ h0]; ring
  rw [e1]
  refine dvd_add (hz1 ⟨r, hr⟩) (Finset.dvd_sum fun i hi => ?_)
  exact hz2 i ⟨r, hr⟩ (fun h => (Finset.ne_of_mem_erase hi) h.symm)

/-- Chinese remainder theorem: congruences modulo $p^N$ for $p \in P$ together with congruences modulo further
primes $q \in T$ not in $P$. -/
private theorem crt_approx (P : Finset Nat.Primes) (N : ℕ) (A : P → ℤ) (T : Finset ℕ)
    (hT : ∀ q ∈ T, q.Prime ∧ ∀ p : P, ((p : Nat.Primes) : ℕ) ≠ q) (b : ℕ → ℤ) :
    ∃ z : ℤ, (∀ p : P, (((p : Nat.Primes) : ℕ) : ℤ) ^ N ∣ z - A p) ∧ ∀ q ∈ T, (q : ℤ) ∣ z - b q := by
  classical
  set P' : Finset ℕ := P.image (fun p => ((p : Nat.Primes) : ℕ)) with hP'
  have hmemP' : ∀ r, r ∈ P' ↔ ∃ p : P, ((p : Nat.Primes) : ℕ) = r := by
    intro r
    simp only [hP', Finset.mem_image]
    constructor
    · rintro ⟨p, hp, rfl⟩; exact ⟨⟨p, hp⟩, rfl⟩
    · rintro ⟨p, rfl⟩; exact ⟨p, p.2, rfl⟩
  obtain ⟨z, hz⟩ := crt_nat (P' ∪ T)
    (fun r hr => by
      rcases Finset.mem_union.1 hr with h | h
      · obtain ⟨p, rfl⟩ := (hmemP' r).1 h
        exact (p : Nat.Primes).2
      · exact (hT r h).1)
    (fun r => if r ∈ P' then N else 1)
    (fun r => if h : ∃ p : P, ((p : Nat.Primes) : ℕ) = r then A h.choose else b r)
  refine ⟨z, fun p => ?_, fun q hq => ?_⟩
  · have hp : ((p : Nat.Primes) : ℕ) ∈ P' := (hmemP' _).2 ⟨p, rfl⟩
    have := hz _ (Finset.mem_union_left _ hp)
    have hex : ∃ p' : P, ((p' : Nat.Primes) : ℕ) = ((p : Nat.Primes) : ℕ) := ⟨p, rfl⟩
    have hch : hex.choose = p := Subtype.ext (Nat.Primes.coe_nat_injective hex.choose_spec)
    simp only [hp, ite_true, dif_pos hex, hch] at this
    simpa using this
  · have hq' : q ∉ P' := fun h => by
      obtain ⟨p, hp⟩ := (hmemP' q).1 h
      exact (hT q hq).2 p hp
    have hex : ¬ ∃ p : P, ((p : Nat.Primes) : ℕ) = q := fun h => hq' ((hmemP' q).2 h)
    have := hz q (Finset.mem_union_right _ hq)
    simp only [hq', ite_false, dif_neg hex] at this
    simpa using this

/-- Ultrametric step: if $m' \equiv A \pmod{p^N}$ and $A$ is $p^{-N}$-close to $x$ then so is $m'$. -/
private theorem norm_sub_le_of_dvd (p : ℕ) [Fact p.Prime] (N : ℕ) {m' A : ℤ} {x : ℤ_[p]}
    (h1 : ((p : ℤ) ^ N) ∣ m' - A) (h2 : ‖(A : ℤ_[p]) - x‖ ≤ (p : ℝ) ^ (-(N : ℤ))) :
    ‖(m' : ℤ_[p]) - x‖ ≤ (p : ℝ) ^ (-(N : ℤ)) := by
  have h3 : ‖((m' - A : ℤ) : ℤ_[p])‖ ≤ (p : ℝ) ^ (-(N : ℤ)) := PadicInt.norm_int_le_pow_iff_dvd.2 h1
  have : (m' : ℤ_[p]) - x = ((m' - A : ℤ) : ℤ_[p]) + ((A : ℤ_[p]) - x) := by push_cast; ring
  rw [this]
  exact (PadicInt.nonarchimedean _ _).trans (max_le h3 h2)

/-- Approximation by rational integers within $p^{-N}$. -/
private theorem exists_int_norm_le (p : ℕ) [Fact p.Prime] (N : ℕ) (x : ℤ_[p]) :
    ∃ a : ℤ, ‖(a : ℤ_[p]) - x‖ ≤ (p : ℝ) ^ (-(N : ℤ)) := by
  obtain ⟨a, ha⟩ := exists_int_toZModPow p N x
  refine ⟨a, norm_le_of_toZModPow_eq_zero p N ?_⟩
  rw [map_sub, ha, map_intCast, sub_self]

/-! ### Lemma 2.1 and its Corollary -/

/-- The $n \times J$ matrix whose columns are $c_0, \dots, c_{J-1}$. -/
def colsMat {J : ℕ} (c : Fin J → Fin n → ℤ) : Matrix (Fin n) (Fin J) ℤ := Matrix.of fun i j => c j i

/-- Lemma 2.1, (i) $\Rightarrow$ (ii): Cauchy–Binet applied to $(\text{first } J \text{ rows of } T^{-1}) \cdot
(\text{first } J \text{ columns of } T) = 1$. -/
private theorem tfae_one_two {J : ℕ} (hJ : J ≤ n) (c : Fin J → Fin n → ℤ)
    (h : ∃ T : GL (Fin n) ℤ, ∀ j, T.val *ᵥ Pi.single (Fin.castLE hJ j) 1 = c j) :
    ∀ d : ℤ, (∀ s : Fin J ↪ Fin n, d ∣ ((colsMat c).submatrix s id).det) → IsUnit d := by
  obtain ⟨T, hT⟩ := h
  intro d hd
  have hcol : ∀ j k, T.val k (Fin.castLE hJ j) = c j k := fun j k => by
    rw [← hT j]; simp
  set A : Matrix (Fin J) (Fin n) ℤ := Matrix.of fun j k => (T⁻¹).val (Fin.castLE hJ j) k with hA
  have hAB : A * colsMat c = 1 := by
    ext j j'
    have := congrFun (congrFun (Units.inv_mul T) (Fin.castLE hJ j)) (Fin.castLE hJ j')
    simp only [Matrix.mul_apply] at this
    simp only [Matrix.mul_apply, hA, colsMat, Matrix.of_apply, ← hcol, Matrix.one_apply]
    rw [this]
    simp [Matrix.one_apply, Fin.ext_iff]
  have hdet := QuadFormsKB.Lattices.det_mul_rect A (colsMat c)
  rw [hAB, Matrix.det_one] at hdet
  have : d ∣ 1 := by
    rw [hdet]
    refine Finset.dvd_sum fun p _ => ?_
    by_cases hp : Function.Injective p
    · exact Dvd.dvd.mul_left (hd ⟨p, hp⟩) _
    · obtain ⟨i, i', hii, hne⟩ : ∃ i i', p i = p i' ∧ i ≠ i' := by
        simpa [Function.Injective] using hp
      rw [Matrix.det_zero_of_row_eq hne (by ext l; simp [hii])]
      simp
  exact isUnit_of_dvd_one this

/-- Lemma 2.1, (ii) $\Rightarrow$ (iii): Cramer's rule shows that the denominators of $v$ form an ideal of
$\mathbb Z$ containing all the $J \times J$ minors. -/
private theorem tfae_two_three {J : ℕ} (c : Fin J → Fin n → ℤ)
    (h : ∀ d : ℤ, (∀ s : Fin J ↪ Fin n, d ∣ ((colsMat c).submatrix s id).det) → IsUnit d) :
    ∀ v : Fin J → ℚ, (∃ y : Fin n → ℤ, ∑ j, v j • (fun i => (c j i : ℚ)) = fun i => (y i : ℚ)) →
      ∀ j, ∃ z : ℤ, v j = z := by
  intro v ⟨y, hy⟩
  let D : Ideal ℤ :=
    { carrier := {d | ∀ j, ∃ z : ℤ, (d : ℚ) * v j = z}
      add_mem' := by
        rintro a b ha hb j
        obtain ⟨z, hz⟩ := ha j
        obtain ⟨z', hz'⟩ := hb j
        exact ⟨z + z', by push_cast; rw [add_mul, hz, hz']⟩
      zero_mem' := fun j => ⟨0, by simp⟩
      smul_mem' := by
        rintro a b hb j
        obtain ⟨z, hz⟩ := hb j
        exact ⟨a * z, by simp only [smul_eq_mul]; push_cast; rw [mul_assoc, hz]⟩ }
  have hminor : ∀ s : Fin J ↪ Fin n, ((colsMat c).submatrix s id).det ∈ D := by
    intro s j
    set S := (colsMat c).submatrix s id with hS
    set Sq : Matrix (Fin J) (Fin J) ℚ := S.map (Int.castRingHom ℚ) with hSq
    have hSv : Sq *ᵥ v = fun i => (y (s i) : ℚ) := by
      funext i
      have := congrFun hy (s i)
      simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] at this
      simp only [Matrix.mulVec, dotProduct, hSq, hS, Matrix.map_apply, Matrix.submatrix_apply, colsMat,
        Matrix.of_apply, id]
      rw [← this]
      refine Finset.sum_congr rfl fun l _ => ?_
      simp [mul_comm]
    have hadj : Sq.adjugate = (S.adjugate).map (Int.castRingHom ℚ) := by
      rw [hSq]
      exact ((Int.castRingHom ℚ).map_adjugate S).symm
    have hcr : (S.det : ℚ) • v = Sq.adjugate *ᵥ (fun i => (y (s i) : ℚ)) := by
      rw [← hSv, Matrix.mulVec_mulVec, Matrix.adjugate_mul]
      have : Sq.det = (S.det : ℚ) := by
        rw [hSq, ← RingHom.mapMatrix_apply, ← RingHom.map_det]; simp
      rw [this, Matrix.smul_mulVec, Matrix.one_mulVec]
    refine ⟨(S.adjugate *ᵥ (fun i => y (s i))) j, ?_⟩
    have := congrFun hcr j
    simp only [Pi.smul_apply, smul_eq_mul] at this
    rw [this, hadj]
    simp [Matrix.mulVec, dotProduct]
  obtain ⟨g, hg⟩ := (IsPrincipalIdealRing.principal D).principal
  have hgunit : IsUnit g := h g fun s => by
    have := hminor s
    rw [hg] at this
    exact Ideal.mem_span_singleton.1 this
  have hgD : g ∈ D := by rw [hg]; exact Ideal.mem_span_singleton_self g
  intro j
  obtain ⟨z, hz⟩ := hgD j
  obtain ⟨u, hu⟩ := hgunit
  refine ⟨(↑(u⁻¹ : ℤˣ) : ℤ) * z, ?_⟩
  have hgu : (g : ℚ) ≠ 0 := by
    rw [← hu]; exact_mod_cast u.ne_zero
  have : v j = (z : ℚ) / g := by field_simp; linarith
  rw [this]
  have hgz : g * (↑(u⁻¹ : ℤˣ) : ℤ) = 1 := by rw [← hu]; simp
  have : (1 : ℚ) / g = ((↑(u⁻¹ : ℤˣ) : ℤ) : ℚ) := by
    rw [div_eq_iff hgu]; rw [mul_comm]; exact_mod_cast hgz.symm
  push_cast
  rw [← this]; ring

/-- Lemma 2.1, (iii) $\Rightarrow$ (i). -/
private theorem tfae_three_one {J : ℕ} (hJ : J ≤ n) (c : Fin J → Fin n → ℤ)
    (h : ∀ v : Fin J → ℚ, (∃ y : Fin n → ℤ, ∑ j, v j • (fun i => (c j i : ℚ)) = fun i => (y i : ℚ)) →
      ∀ j, ∃ z : ℤ, v j = z) :
    ∃ T : GL (Fin n) ℤ, ∀ j, T.val *ᵥ Pi.single (Fin.castLE hJ j) 1 = c j := by
  have key : ∀ J' : ℕ, J' ≤ J → ∃ T : GL (Fin n) ℤ, ∀ j : Fin J, j.val < J' → ∀ k,
      T.val k (Fin.castLE hJ j) = c j k := by
    intro J'
    induction J' with
    | zero => intro _; exact ⟨1, fun j hj => absurd hj (by omega)⟩
    | succ J' ih =>
      intro hJ'
      obtain ⟨T, hT⟩ := ih (by omega)
      set j' : Fin J := ⟨J', by omega⟩ with hj'
      set i' : Fin n := Fin.castLE hJ j' with hi'
      have hi'val : i'.val = J' := rfl
      set e' : Fin n → ℤ := (T⁻¹).val *ᵥ c j' with he'
      have hTe : T.val *ᵥ e' = c j' := by
        rw [he', Matrix.mulVec_mulVec]
        have : T.val * (T⁻¹).val = 1 := Units.mul_inv T
        rw [this, Matrix.one_mulVec]
      have hgcd : QuadFormsKB.Reduction.tailGcd i' e' = 1 := by
        by_contra hne
        have hg0 : 0 ≤ QuadFormsKB.Reduction.tailGcd i' e' :=
          Int.nonneg_of_normalize_eq_self (Finset.normalize_gcd)
        have hg1 : (QuadFormsKB.Reduction.tailGcd i' e').natAbs ≠ 1 := fun h => hne (by omega)
        obtain ⟨p, hp, hpg⟩ := Nat.exists_prime_and_dvd hg1
        have hp0 : (p : ℤ) ≠ 0 := by exact_mod_cast hp.ne_zero
        have hpe : ∀ k : Fin n, i' ≤ k → (p : ℤ) ∣ e' k := fun k hk =>
          (Int.natCast_dvd.2 hpg).trans
            (Finset.gcd_dvd (f := e') (Finset.mem_filter.2 ⟨Finset.mem_univ k, hk⟩))
        set w : Fin n → ℤ := fun k => if i' ≤ k then e' k / p else 0 with hw
        set a : Fin J → ℤ := fun j => if j.val < J' then e' (Fin.castLE hJ j) else 0 with ha
        have hint : ∀ i : Fin n, (p : ℤ) * (∑ k, T.val i k * w k) = c j' i - ∑ j, a j * c j i := by
          intro i
          have h1 : c j' i = ∑ k, T.val i k * e' k := by rw [← hTe]; rfl
          have h2 : ∑ j, a j * c j i = ∑ k : Fin n, if k.val < J' then T.val i k * e' k else 0 := by
            have h3 : ∀ j : Fin J, a j * c j i =
                if j.val < J' then T.val i (Fin.castLE hJ j) * e' (Fin.castLE hJ j) else 0 := by
              intro j
              by_cases hj : j.val < J'
              · simp only [ha, hj, ite_true]
                rw [← hT j hj i]; ring
              · simp [ha, hj]
            simp_rw [h3]
            refine Finset.sum_of_injOn (Fin.castLE hJ) (fun x _ y _ h => Fin.castLE_injective hJ h)
              (fun x _ => Finset.mem_coe.2 (Finset.mem_univ _)) (fun k _ hk => ?_) (fun j _ => ?_)
            · have : ¬ k.val < J' := by
                by_contra hlt
                exact hk ⟨⟨k.val, by omega⟩, Finset.mem_coe.2 (Finset.mem_univ _), Fin.ext rfl⟩
              simp [this]
            · simp
          rw [h1, h2, Finset.mul_sum, ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl fun k _ => ?_
          by_cases hk : k.val < J'
          · have : ¬ i' ≤ k := by rw [Fin.le_def]; omega
            simp only [hw, hk, this, ite_true, ite_false]
            ring
          · have hik : i' ≤ k := by rw [Fin.le_def]; omega
            obtain ⟨q, hq⟩ := hpe k hik
            simp only [hw, hk, hik, ite_true, ite_false]
            rw [hq, Int.mul_ediv_cancel_left _ hp0]
            ring
        have hv := h (fun j => (((if j = j' then 1 else 0 : ℚ)) - (a j : ℚ)) / p)
          ⟨fun i => ∑ k, T.val i k * w k, ?_⟩ j'
        · obtain ⟨z, hz⟩ := hv
          have ha0 : a j' = 0 := by simp [ha, hj']
          rw [if_pos rfl, ha0] at hz
          have hpq : (p : ℚ) ≠ 0 := by exact_mod_cast hp0
          have : (p : ℤ) * z = 1 := by
            have h1 : (p : ℚ) * z = 1 := by
              rw [← hz]; field_simp; simp
            exact_mod_cast h1
          exact hp.one_lt.ne' (by exact_mod_cast Int.eq_one_of_dvd_one (by positivity) ⟨z, this.symm⟩)
        · funext i
          have hpq : (p : ℚ) ≠ 0 := by exact_mod_cast hp0
          have hq := congrArg (fun x : ℤ => (x : ℚ)) (hint i)
          simp only [Pi.smul_apply, smul_eq_mul, Finset.sum_apply]
          have h4 : ∀ j : Fin J, ((((if j = j' then 1 else 0 : ℚ)) - (a j : ℚ)) / p) * (c j i : ℚ) =
              ((if j = j' then (c j' i : ℚ) else 0) - (a j : ℚ) * c j i) / p := by
            intro j
            by_cases hjj : j = j'
            · subst hjj; simp only [ite_true]; ring
            · simp only [hjj, ite_false]; ring
          simp_rw [h4]
          rw [← Finset.sum_div, Finset.sum_sub_distrib, Finset.sum_ite_eq' Finset.univ j' (fun _ => (c j' i : ℚ))]
          simp only [Finset.mem_univ, ite_true]
          push_cast at hq
          field_simp
          push_cast
          linarith
      obtain ⟨T', h1, h2⟩ := (QuadFormsKB.Reduction.extendsBasis_iff_gcd i' e').2 hgcd
      refine ⟨T * T', fun j hj k => ?_⟩
      rw [Units.val_mul, Matrix.mul_apply]
      by_cases hjl : j.val < J'
      · have hlt : Fin.castLE hJ j < i' := by rw [Fin.lt_def]; simpa [hi'val] using hjl
        simp_rw [h1 _ hlt, Pi.single_apply]
        simpa using hT j hjl k
      · have hjj : j = j' := Fin.ext (by simp [hj']; omega)
        subst hjj
        have h2' : ∀ m, T'.val m (Fin.castLE hJ j') = e' m := h2
        simp_rw [h2']
        rw [← hTe]; rfl
  obtain ⟨T, hT⟩ := key J le_rfl
  exact ⟨T, fun j => funext fun k => by simpa using hT j j.2 k⟩

/-- **Cassels, Lemma 2.1** (Ch. 9, p. 132; Chapter 7, Theorem 3.1 for $I = \mathbb Z$): *let $c_1, \dots, c_J$ be
elements of $\mathbb Z^n$. Then the three following statements are equivalent: (i) there exist $c_{J+1}, \dots, c_n$
such that $c_1, \dots, c_n$ is a basis for $\mathbb Z^n$; (ii) the determinants of the $J \times J$ submatrices of the
$n \times J$ matrix $c_1 c_2 \cdots c_J$ have no common divisor $> 1$; (iii) if $a = v_1c_1 + \dots + v_Jc_J \in \mathbb Z^n$
with $v_1, \dots, v_J \in \mathbb Q$ then necessarily $v_1, \dots, v_J \in \mathbb Z$.*

Here $J \le n$ (implicit in (i)); (i) says the vectors are the first $J$ columns of some $T \in \mathrm{GL}_n(\mathbb Z)$;
(ii) says every common divisor $d$ of the minors (taken over all choices of $J$ distinct rows, in any order) is a unit
$\pm 1$; the indices are $0, \dots, J-1$ and the scan lost the formulas, which are reconstructed from the proof and
from Chapter 7, Theorem 3.1. -/
@[kb "cassels1978" "Ch. 9, Lemma 2.1, p. 132 (Ch. 7, Thm. 3.1 for ℤ)"]
theorem tfae_extends_basis {J : ℕ} (hJ : J ≤ n) (c : Fin J → Fin n → ℤ) :
    List.TFAE
      [∃ T : GL (Fin n) ℤ, ∀ j, T.val *ᵥ Pi.single (Fin.castLE hJ j) 1 = c j,
       ∀ d : ℤ, (∀ s : Fin J ↪ Fin n, d ∣ ((colsMat c).submatrix s id).det) → IsUnit d,
       ∀ v : Fin J → ℚ, (∃ y : Fin n → ℤ, ∑ j, v j • (fun i => (c j i : ℚ)) = fun i => (y i : ℚ)) →
         ∀ j, ∃ z : ℤ, v j = z] := by
  tfae_have 1 → 2 := tfae_one_two hJ c
  tfae_have 2 → 3 := tfae_two_three c
  tfae_have 3 → 1 := tfae_three_one hJ c
  tfae_finish

/-- **Cassels, Lemma 2.1, Corollary** (Ch. 9, p. 132): *a necessary and sufficient condition that
$c = (c_1, \dots, c_n)$ be primitive is that $\gcd(c_1, \dots, c_n) = 1$*; primitive means: there is a basis
$c = c_1, c_2, \dots, c_n$ of $\mathbb Z^n$, i.e. $c$ is the first column ($e_0 \mapsto c$) of some
$T \in \mathrm{GL}_n(\mathbb Z)$. (The case $j = 0$ of `Reduction.extendsBasis_iff_gcd`.) -/
@[kb "cassels1978" "Ch. 9, Lemma 2.1, Cor., p. 132"]
theorem exists_basis_first_iff_gcd (hn : 0 < n) (c : Fin n → ℤ) :
    (∃ T : GL (Fin n) ℤ, T.val *ᵥ Pi.single ⟨0, hn⟩ 1 = c) ↔ Finset.univ.gcd c = 1 := by
  have h := QuadFormsKB.Reduction.extendsBasis_iff_gcd (⟨0, hn⟩ : Fin n) c
  have h2 : QuadFormsKB.Reduction.tailGcd (⟨0, hn⟩ : Fin n) c = Finset.univ.gcd c := by
    unfold QuadFormsKB.Reduction.tailGcd
    congr 1
    ext k
    simp [Fin.le_def]
  rw [h2] at h
  rw [← h]
  unfold QuadFormsKB.Reduction.ExtendsBasis
  constructor
  · rintro ⟨T, hT⟩
    refine ⟨T, fun i hi => absurd hi (by simp [Fin.lt_def]), fun k => ?_⟩
    rw [← hT]
    simp
  · rintro ⟨T, -, hT⟩
    refine ⟨T, funext fun k => ?_⟩
    rw [← hT k]
    simp

/-- A primitive vector is the first column of a matrix of determinant $+1$ (for $n \ge 2$ change the sign of another
column; for $n = 1$, $c = \pm 1$ and the sign may be absorbed by $\det$ only when $c = 1$, so $n \ge 2$ is assumed).
Used in §3 and §6 ("on taking $-b_n$ for $b_n$ if need be", (6.7)). -/
theorem exists_sl_first_of_gcd (hn : 2 ≤ n) (c : Fin n → ℤ) (hc : Finset.univ.gcd c = 1) :
    ∃ T : GL (Fin n) ℤ, T.val.det = 1 ∧ T.val *ᵥ Pi.single ⟨0, by omega⟩ 1 = c := by
  obtain ⟨T, hT⟩ := (exists_basis_first_iff_gcd (by omega) c).2 hc
  rcases det_GL_int_eq T with hd | hd
  · exact ⟨T, hd, hT⟩
  · set D : Matrix (Fin n) (Fin n) ℤ := Matrix.diagonal (Function.update 1 ⟨1, by omega⟩ (-1)) with hD
    have hDD : D * D = 1 := by
      rw [hD, Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
      congr 1
      ext i
      by_cases h : i = ⟨1, by omega⟩ <;> simp [h]
    have hdet : D.det = -1 := by
      rw [hD, Matrix.det_diagonal, Finset.prod_update_of_mem (Finset.mem_univ _)]
      simp
    let Dg : GL (Fin n) ℤ := ⟨D, D, hDD, hDD⟩
    refine ⟨T * Dg, ?_, ?_⟩
    · simp only [Units.val_mul, Matrix.det_mul]
      change T.val.det * D.det = 1
      rw [hd, hdet]; norm_num
    · rw [Units.val_mul, ← Matrix.mulVec_mulVec, ← hT]
      congr 1
      change D *ᵥ Pi.single _ 1 = _
      rw [hD]
      ext i
      rw [Matrix.mulVec_diagonal]
      by_cases h : i = (⟨0, by omega⟩ : Fin n)
      · subst h
        simp [Function.update_of_ne, Fin.ext_iff]
      · simp [h]

/-! ### Lemma 2.2 -/

/-- **Cassels, Lemma 2.2** (Ch. 9, p. 133): *let $K > 1$ be an integer and let $m^{(p)}_k \in \mathbb Z_p$ be given for
$p \in P$ and $1 \le k \le K$ such that $\max_k \lvert m^{(p)}_k\rvert_p = 1$ (2.5). Then there are $m_k \in \mathbb Z$
such that $\lvert m_k - m^{(p)}_k\rvert_p < \varepsilon$ ($1 \le k \le K$, $p \in P$) (2.6) and
$\gcd(m_1, \dots, m_K) = 1$ (2.7).* Indices $k = 0, \dots, K-1$; (2.5) is stated as "some $m^{(p)}_k$ is a unit"
(all have norm $\le 1$); the formulas (2.6), (2.7) are lost in the scan and reconstructed from the proof. -/
@[kb "cassels1978" "Ch. 9, Lemma 2.2, p. 133"]
theorem exists_int_approx_gcd (P : Finset Nat.Primes) {K : ℕ} (hK : 1 < K)
    (m : ∀ p : P, Fin K → ℤ_[(p : ℕ)]) (hm : ∀ p, ∃ k, ‖m p k‖ = 1) {ε : ℝ} (hε : 0 < ε) :
    ∃ m' : Fin K → ℤ, (∀ p : P, ∀ k, ‖((m' k : ℤ) : ℤ_[(p : ℕ)]) - m p k‖ < ε) ∧ Finset.univ.gcd m' = 1 := by
  classical
  obtain ⟨N, -, hN⟩ := exists_pow_neg_lt (lt_min hε one_pos)
  have hA : ∀ (p : P) (k : Fin K), ∃ a : ℤ, ‖(a : ℤ_[(p : ℕ)]) - m p k‖ ≤ ((p : ℕ) : ℝ) ^ (-(N : ℤ)) :=
    fun p k => exists_int_norm_le (p : ℕ) N (m p k)
  choose A hA using hA
  have hclose : ∀ (k : Fin K) (z : ℤ), (∀ p : P, (((p : Nat.Primes) : ℕ) : ℤ) ^ N ∣ z - A p k) →
      ∀ p : P, ‖((z : ℤ) : ℤ_[(p : ℕ)]) - m p k‖ < min ε 1 := fun k z h p =>
    lt_of_le_of_lt (norm_sub_le_of_dvd (p : ℕ) N (h p) (hA p k)) (hN _ (p : Nat.Primes).2.two_le)
  set k0 : Fin K := ⟨0, by omega⟩ with hk0
  set k1 : Fin K := ⟨1, hK⟩ with hk1
  -- the first integer, nonzero
  obtain ⟨z0, hz0ne, hz0⟩ : ∃ z0 : ℤ, z0 ≠ 0 ∧ ∀ p : P, (((p : Nat.Primes) : ℕ) : ℤ) ^ N ∣ z0 - A p k0 := by
    obtain ⟨z, hz, -⟩ := crt_approx P N (fun p => A p k0) ∅ (by simp) 0
    by_cases h : z = 0
    · refine ⟨∏ p : P, (((p : Nat.Primes) : ℕ) : ℤ) ^ N, ?_, fun p => ?_⟩
      · exact Finset.prod_ne_zero_iff.2 fun p _ =>
          pow_ne_zero _ (by exact_mod_cast (p : Nat.Primes).2.ne_zero)
      · have := hz p
        rw [h, zero_sub] at this
        have h2 : (((p : Nat.Primes) : ℕ) : ℤ) ^ N ∣ ∏ p : P, (((p : Nat.Primes) : ℕ) : ℤ) ^ N :=
          Finset.dvd_prod_of_mem (fun p : P => (((p : Nat.Primes) : ℕ) : ℤ) ^ N) (Finset.mem_univ p)
        exact dvd_sub h2 (dvd_neg.1 this)
    · exact ⟨z, h, hz⟩
  -- the second integer, coprime to the first outside P
  obtain ⟨z1, hz1, hz1T⟩ := crt_approx P N (fun p => A p k1)
    (z0.natAbs.primeFactors.filter fun q => ∀ p : P, ((p : Nat.Primes) : ℕ) ≠ q)
    (fun q hq => ⟨(Nat.mem_primeFactors.1 (Finset.mem_filter.1 hq).1).1, (Finset.mem_filter.1 hq).2⟩)
    (fun _ => 1)
  have hk : ∀ k : Fin K, ∃ z : ℤ, ∀ p : P, (((p : Nat.Primes) : ℕ) : ℤ) ^ N ∣ z - A p k := fun k => by
    obtain ⟨z, hz, -⟩ := crt_approx P N (fun p => A p k) ∅ (by simp) 0
    exact ⟨z, hz⟩
  choose zk hzk using hk
  set m' : Fin K → ℤ := fun k => if k.val = 0 then z0 else if k.val = 1 then z1 else zk k with hm'
  have hm'0 : m' k0 = z0 := by simp [hm', hk0]
  have hm'1 : m' k1 = z1 := by simp [hm', hk1]
  have hspec : ∀ k : Fin K, ∀ p : P, (((p : Nat.Primes) : ℕ) : ℤ) ^ N ∣ m' k - A p k := by
    intro k p
    by_cases h0 : k.val = 0
    · have : k = k0 := Fin.ext h0
      subst this; rw [hm'0]; exact hz0 p
    · by_cases h1 : k.val = 1
      · have : k = k1 := Fin.ext h1
        subst this; rw [hm'1]; exact hz1 p
      · simp only [hm', h0, h1, ite_false]; exact hzk k p
  have hcl : ∀ (p : P) (k : Fin K), ‖((m' k : ℤ) : ℤ_[(p : ℕ)]) - m p k‖ < min ε 1 :=
    fun p k => hclose k (m' k) (hspec k) p
  refine ⟨m', fun p k => lt_of_lt_of_le (hcl p k) (min_le_left _ _), ?_⟩
  by_contra hg
  set g := Finset.univ.gcd m' with hgdef
  have hg0 : 0 ≤ g := Int.nonneg_of_normalize_eq_self (Finset.normalize_gcd)
  have hg1 : g.natAbs ≠ 1 := fun h => hg (by omega)
  obtain ⟨q, hq, hqg⟩ := Nat.exists_prime_and_dvd hg1
  have hqm : ∀ k, (q : ℤ) ∣ m' k := fun k =>
    (Int.natCast_dvd.2 hqg).trans (Finset.gcd_dvd (Finset.mem_univ k))
  by_cases hqP : ∃ p : P, ((p : Nat.Primes) : ℕ) = q
  · obtain ⟨p, rfl⟩ := hqP
    obtain ⟨k, hk⟩ := hm p
    have h1 : ‖((m' k : ℤ) : ℤ_[((p : Nat.Primes) : ℕ)])‖ < 1 :=
      (PadicInt.norm_int_lt_one_iff_dvd _).2 (hqm k)
    have h2 : ‖((m' k : ℤ) : ℤ_[((p : Nat.Primes) : ℕ)]) - m p k‖ < 1 :=
      lt_of_lt_of_le (hcl p k) (min_le_right _ _)
    have h3 := PadicInt.nonarchimedean ((m' k : ℤ) : ℤ_[((p : Nat.Primes) : ℕ)])
      (-(((m' k : ℤ) : ℤ_[((p : Nat.Primes) : ℕ)]) - m p k))
    rw [norm_neg, show ((m' k : ℤ) : ℤ_[((p : Nat.Primes) : ℕ)]) + -(((m' k : ℤ) : ℤ_[((p : Nat.Primes) : ℕ)])
      - m p k) = m p k by ring, hk] at h3
    exact absurd (lt_of_le_of_lt h3 (max_lt h1 h2)) (lt_irrefl _)
  · have hq0 : q ∈ z0.natAbs.primeFactors := by
      rw [Nat.mem_primeFactors]
      refine ⟨hq, ?_, Int.natAbs_ne_zero.2 hz0ne⟩
      have := hqm k0
      rw [hm'0] at this
      exact Int.natCast_dvd.1 this
    have hqT : q ∈ z0.natAbs.primeFactors.filter fun q => ∀ p : P, ((p : Nat.Primes) : ℕ) ≠ q :=
      Finset.mem_filter.2 ⟨hq0, fun p hp => hqP ⟨p, hp⟩⟩
    have h1 := hz1T q hqT
    have h2 := hqm k1
    rw [hm'1] at h2
    have h3 : (q : ℤ) ∣ 1 := by
      have := dvd_sub h2 h1
      simpa using this
    exact hq.one_lt.ne' (by exact_mod_cast Int.eq_one_of_dvd_one (by positivity) h3)

/-! ### Theorem 2.1 -/

/-- **Cassels, Theorem 2.1** (Ch. 9, p. 133): *let $P$ be a finite set of primes $p \ne \infty$ and for each $p \in P$
let $c^{(p)}_1, \dots, c^{(p)}_n$ be a basis of $\mathbb Z_p^n$ with $\det(c^{(p)}_1, \dots, c^{(p)}_n) = \delta$ (2.2).
Then for any $\varepsilon > 0$ there is a basis $c_1, \dots, c_n$ of $\mathbb Z^n$ with
$\det(c_1, \dots, c_n) = \delta$ (2.3) such that $\lVert c_j - c^{(p)}_j\rVert_p < \varepsilon$ ($1 \le j \le n$,
$p \in P$) (2.4).*

The bases are the columns of matrices $C_p$ over $\mathbb Z_p$ and $C$ over $\mathbb Z$; $\delta = \pm 1$ is the same
for all $p$ (the right-hand side of (2.2) is lost in the scan; the proof, "$m_n^{(p)} = m_n$ is independent of $p$",
shows that it is one integer $\pm 1$). A matrix over $\mathbb Z_p$ with determinant $\pm 1$ is a basis of
$\mathbb Z_p^n$, so no further hypothesis is needed. Here $n \ge 1$ (for $n = 0$ and $P = \emptyset$ there is no basis
of determinant $-1$). -/
@[kb "cassels1978" "Ch. 9, Thm. 2.1, p. 133"]
theorem exists_basis_approx (hn : 0 < n) (P : Finset Nat.Primes) {δ : ℤ} (hδ : δ = 1 ∨ δ = -1)
    (C : ∀ p : P, Matrix (Fin n) (Fin n) ℤ_[(p : ℕ)]) (hC : ∀ p, (C p).det = δ) {ε : ℝ} (hε : 0 < ε) :
    ∃ C' : Matrix (Fin n) (Fin n) ℤ, C'.det = δ ∧
      ∀ p : P, ∀ i j, ‖((C' i j : ℤ) : ℤ_[(p : ℕ)]) - C p i j‖ < ε := by
  obtain ⟨N, hN1, hN⟩ := exists_pow_neg_lt hε
  set i0 : Fin n := ⟨0, hn⟩ with hi0
  set D : Matrix (Fin n) (Fin n) ℤ := Matrix.diagonal (Function.update 1 i0 δ) with hD
  have hδδ : δ * δ = 1 := by rcases hδ with rfl | rfl <;> norm_num
  have hDD : D * D = 1 := by
    rw [hD, Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
    congr 1
    ext i
    by_cases h : i = i0 <;> simp [h, hδδ]
  have hdet : D.det = δ := by
    rw [hD, Matrix.det_diagonal, Finset.prod_update_of_mem (Finset.mem_univ _)]
    simp
  have hDp : ∀ p : P, (D.map (Int.castRingHom ℤ_[(p : ℕ)])) * (D.map (Int.castRingHom ℤ_[(p : ℕ)])) = 1 := by
    intro p
    rw [← Matrix.map_mul, hDD, Matrix.map_one _ (map_zero _) (map_one _)]
  have hdetp : ∀ p : P, (C p * D.map (Int.castRingHom ℤ_[(p : ℕ)])).det = 1 := by
    intro p
    rw [Matrix.det_mul, hC p]
    have : (D.map (Int.castRingHom ℤ_[(p : ℕ)])).det = (δ : ℤ_[(p : ℕ)]) := by
      rw [← RingHom.mapMatrix_apply, ← RingHom.map_det, hdet]
      simp
    rw [this]
    exact_mod_cast hδδ
  let β : ∀ p : P, Matrix.SpecialLinearGroup (Fin n) ℤ_[(p : ℕ)] :=
    fun p => ⟨C p * D.map (Int.castRingHom ℤ_[(p : ℕ)]), hdetp p⟩
  obtain ⟨B, hB⟩ := QuadFormsKB.Lattices.SLApprox.exists_approx_abstract (R := fun p : P => ℤ_[(p : ℕ)])
    (Q := fun p : P => ZMod ((p : Nat.Primes) ^ N : ℕ))
    (fun p => (PadicInt.toZModPow N : ℤ_[(p : ℕ)] →+* ZMod ((p : ℕ) ^ N)))
    (fun p t => exists_int_toZModPow (p : ℕ) N t) (crt_primes P N) β
  refine ⟨B.val * D, ?_, fun p i j => ?_⟩
  · rw [Matrix.det_mul, B.det_coe, hdet, one_mul]
  · refine lt_of_le_of_lt (norm_le_of_toZModPow_eq_zero (p : ℕ) N ?_) (hN _ (p : Nat.Primes).2.two_le)
    have h1 := congrArg Subtype.val (hB p)
    simp only [Matrix.SpecialLinearGroup.map_apply_coe, RingHom.mapMatrix_apply] at h1
    have hf : (PadicInt.toZModPow N : ℤ_[(p : ℕ)] →+* ZMod ((p : ℕ) ^ N)).comp
        (Int.castRingHom ℤ_[(p : ℕ)]) = Int.castRingHom (ZMod ((p : ℕ) ^ N)) := RingHom.ext_int _ _
    have hDq : D.map (Int.castRingHom (ZMod ((p : ℕ) ^ N))) =
        (D.map (Int.castRingHom ℤ_[(p : ℕ)])).map (PadicInt.toZModPow N) := by
      rw [Matrix.map_map, ← hf]; rfl
    have hDp1 := hDp p
    have key : (B.val * D).map (Int.castRingHom (ZMod ((p : ℕ) ^ N))) =
        (C p).map (PadicInt.toZModPow N) := by
      rw [Matrix.map_mul, h1, hDq, ← Matrix.map_mul]
      have : (C p * D.map (Int.castRingHom ℤ_[(p : ℕ)]) * D.map (Int.castRingHom ℤ_[(p : ℕ)])) = C p := by
        rw [mul_assoc, hDp1, mul_one]
      rw [this]
    have key2 := congrFun (congrFun key i) j
    simp only [Matrix.map_apply] at key2
    rw [map_sub, sub_eq_zero]
    rw [map_intCast]
    exact key2

end QuadFormsKB.Siegel
