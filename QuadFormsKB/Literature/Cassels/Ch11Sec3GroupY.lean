/-
# Cassels, Chapter 11, §3: the groups $X$, $Y$ and Lemma 3.6

**Layer:** over $\mathbb Q$: a regular form `Q : QuadForm ℚ n`, $n \ge 3$, a lattice $\Lambda$ = `L : Lat ℚ n`, a finite
set $P$ of primes, and Cassels' groups $R = \prod_{p\in P}\mathbb Q_p^\times$ (`CasselsR`), $S$ (`casselsS`), $T$
(`casselsT`), $G = R/ST$ (`CasselsG`) of `Ch11Sec3Group.lean`.

**Defines** (Cassels, Ch. 11, (3.33)–(3.34) and the text before Lemma 3.6, pp. 212–213):
* `casselsX` $= X = \prod_{p\in P}U_p$, the families of $p$-adic units;
* `casselsY` $= Y = X \cap ST$;
* `casselsJ` $= j$: $-1$ if $V$ is indefinite, $+1$ if $V$ is definite;
* `casselsP1` $= P_1$, the $q \in P$ for which $\theta(\Lambda_q)$ contains an element $\theta(a_q) \in qU_q(\mathbb Q_q^\times)^2$
  (of odd order at $q$);
* `casselsSq` $= s_q$: the element of $R$ with component $\theta(a_q)q^{-1}$ at $q$ and $q^{-1}$ at the other $p \in P$.

**Proves**
* $R = XT$ (`exists_casselsX_mul_casselsT`) and hence $G = R/ST = X/Y$ (3.35) (`exists_casselsX_mk_eq`,
  `mk_eq_one_iff_mem_casselsY`);
* **Lemma 3.6** (p. 213, `casselsY_eq_closure`): $Y$ is generated by (i) $\prod_{p \in P}(\theta(\Lambda_p) \cap U_p)$,
  (ii) $j$ (embedded diagonally), (iii) the $s_q$ ($q \in P_1$).

*Reconstruction.* The displays (3.33)–(3.34), the definition of $s_q$ and the list in Lemma 3.6 are partly lost in the
scan; they are reconstructed from the surviving text ("$R = XT$ and so $G = R/ST = X/Y$", "$s_q \in ST$ and so
$s_q \in Y$", "$j = -1$ if $V_\infty$ is indefinite, $+1$ if definite", "$\theta(a_q) = qU_q(\mathbb Q_q^\times)^2$") and
from the Corollary (if $U_p \subseteq \theta(\Lambda_p)$ for all $p$ then $Y = X$). The representative of $\theta(a_q)$ is
any $c_q \in \theta(\Lambda_q)$ with $\lvert c_q\rvert_q = \lvert q\rvert_q$ (hypothesis `hc`). Cassels' conditions
(3.6), (3.7) on $P$ are not needed.
-/
import QuadFormsKB.Literature.Cassels.Ch11Sec3GroupLemma34
import QuadFormsKB.Literature.Cassels.Ch11Sec4Thm
import QuadFormsKB.Literature.Cassels.Ch11Sec4Local

open NumberField IsDedekindDomain

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.Lattices

attribute [local instance 2000] HeightOneSpectrum.instAlgebraAdicCompletion

variable {n : ℕ}

/-! ### Valuations of rationals -/

section Val

/-- The prime $p$ of the place $v$ of $\mathbb Q$, as a unit of $\mathbb Q$. -/
def natGenUnit (v : HeightOneSpectrum (𝓞 ℚ)) : ℚˣ :=
  Units.mk0 (Rat.HeightOneSpectrum.natGenerator v : ℚ)
    (by exact_mod_cast (Rat.HeightOneSpectrum.prime_natGenerator v).ne_zero)

theorem natGenUnit_pos (v : HeightOneSpectrum (𝓞 ℚ)) : 0 < ((natGenUnit v : ℚˣ) : ℚ) := by
  simp only [natGenUnit, Units.val_mk0]
  exact_mod_cast (Rat.HeightOneSpectrum.prime_natGenerator v).pos

theorem valued_natGenUnit_self (v : HeightOneSpectrum (𝓞 ℚ)) :
    Valued.v (algebraMap ℚ (v.adicCompletion ℚ) ((natGenUnit v : ℚˣ) : ℚ)) = WithZero.exp (-1 : ℤ) := by
  simp only [natGenUnit, Units.val_mk0, map_natCast]
  exact valued_natGenerator v

theorem valued_natGenUnit_of_ne {v w : HeightOneSpectrum (𝓞 ℚ)} (h : w ≠ v) :
    Valued.v (algebraMap ℚ (w.adicCompletion ℚ) ((natGenUnit v : ℚˣ) : ℚ)) = 1 := by
  have hnd : ¬ Rat.HeightOneSpectrum.natGenerator w ∣ Rat.HeightOneSpectrum.natGenerator v := by
    intro hd
    exact h (natGen_injective' ((Nat.prime_dvd_prime_iff_eq (Rat.HeightOneSpectrum.prime_natGenerator w)
      (Rat.HeightOneSpectrum.prime_natGenerator v)).mp hd))
  have := valued_natCast_eq_one' (v := w) hnd
  simp only [natGenUnit, Units.val_mk0, map_natCast]
  simpa using this

/-- **A rational number that is a unit at every prime is $\pm 1$.** -/
theorem eq_one_or_neg_one_of_valued (t : ℚˣ)
    (h : ∀ v : HeightOneSpectrum (𝓞 ℚ), Valued.v (algebraMap ℚ (v.adicCompletion ℚ) (t : ℚ)) = 1) :
    t = 1 ∨ t = -1 := by
  obtain ⟨a, ha⟩ := HeightOneSpectrum.mem_integers_of_valuation_le_one ℚ (t : ℚ) fun v => by
    rw [← valued_algebraMap]; exact (h v).le
  obtain ⟨b, hb⟩ := HeightOneSpectrum.mem_integers_of_valuation_le_one ℚ ((t⁻¹ : ℚˣ) : ℚ) fun v => by
    rw [← valued_algebraMap, Units.val_inv_eq_inv_val, map_inv₀, map_inv₀, h v, inv_one]
  have hab : a * b = 1 := by
    apply FaithfulSMul.algebraMap_injective (𝓞 ℚ) ℚ
    rw [map_mul, ha, hb, map_one, Units.mul_inv]
  have hu := (Rat.RingOfIntegers.isUnit_iff (x := a)).mp (IsUnit.of_mul_eq_one b hab)
  have e : ((a : ℚ)) = (t : ℚ) := ha
  rcases hu with h1 | h1
  · left; ext; rw [← e, h1]; rfl
  · right; ext; rw [← e, h1]; rfl

open Classical in
/-- **Valuations of a product of primes:** $\lvert\prod_{q\in P}q^{e_q}\rvert_v = e^{-e_v}$ for $v \in P$, and $1$ for
$v \notin P$. -/
theorem valued_prod_natGenUnit (P : Finset (HeightOneSpectrum (𝓞 ℚ))) (e : HeightOneSpectrum (𝓞 ℚ) → ℤ)
    (v : HeightOneSpectrum (𝓞 ℚ)) :
    Valued.v (algebraMap ℚ (v.adicCompletion ℚ) ((∏ q ∈ P, natGenUnit q ^ e q : ℚˣ) : ℚ)) =
      if v ∈ P then WithZero.exp (-e v) else 1 := by
  classical
  simp only [Units.coe_prod, Units.val_zpow_eq_zpow_val, map_prod, map_zpow₀]
  split_ifs with hv
  · rw [Finset.prod_eq_single_of_mem v hv (fun w _ hwv => by rw [valued_natGenUnit_of_ne (Ne.symm hwv),
      one_zpow]), valued_natGenUnit_self, ← WithZero.exp_zsmul]
    congr 1
    simp
  · exact Finset.prod_eq_one fun w hw => by
      rw [valued_natGenUnit_of_ne (by rintro rfl; exact hv hw), one_zpow]

/-- **A $P$-unit is $\pm$ a product of the primes of $P$:** if $t \in \mathbb Q^\times$ is a unit at every prime outside
$P$, then $t = \varepsilon\prod_{q\in P}q^{e_q}$ with $\varepsilon = \pm 1$. -/
theorem exists_eq_sign_mul_prod (P : Finset (HeightOneSpectrum (𝓞 ℚ))) (t : ℚˣ)
    (ht : ∀ v : HeightOneSpectrum (𝓞 ℚ), v ∉ P → Valued.v (algebraMap ℚ (v.adicCompletion ℚ) (t : ℚ)) = 1) :
    ∃ (ε : ℚˣ) (e : HeightOneSpectrum (𝓞 ℚ) → ℤ), (ε = 1 ∨ ε = -1) ∧
      t = ε * ∏ q ∈ P, natGenUnit q ^ e q := by
  classical
  let k : HeightOneSpectrum (𝓞 ℚ) → ℤ := fun v =>
    WithZero.log (Valued.v (algebraMap ℚ (v.adicCompletion ℚ) (t : ℚ)))
  have hk : ∀ v, Valued.v (algebraMap ℚ (v.adicCompletion ℚ) (t : ℚ)) = WithZero.exp (k v) := fun v =>
    (WithZero.exp_log (by simp)).symm
  refine ⟨t * (∏ q ∈ P, natGenUnit q ^ (-k q))⁻¹, fun q => -k q,
    eq_one_or_neg_one_of_valued _ fun v => ?_, by simp⟩
  rw [Units.val_mul, Units.val_inv_eq_inv_val, map_mul, map_inv₀, map_mul, map_inv₀, valued_prod_natGenUnit]
  split_ifs with hv
  · rw [hk v, neg_neg, mul_inv_cancel₀ (by simp)]
  · rw [ht v hv, inv_one, one_mul]

end Val

/-! ### The groups $X$, $Y$ and the elements $j$, $s_q$ -/

section Groups

variable (Q : QuadForm ℚ n) (hQ : Q.Nondegenerate) (L : Lat ℚ n) (P : Finset (HeightOneSpectrum (𝓞 ℚ)))

/-- **Cassels' group $X$** (Ch. 11, (3.33), p. 212, reconstructed): $X = \prod_{p\in P}U_p \subseteq R$, the families of
$p$-adic units. -/
@[kb "cassels1978" "Ch. 11, (3.33), p. 212 (X = ∏ U_p, reconstructed)"]
def casselsX : Subgroup (CasselsR P) where
  carrier := {r | ∀ v : P, Valued.v ((r v : (v.1.adicCompletion ℚ)ˣ) : v.1.adicCompletion ℚ) = 1}
  mul_mem' {a b} ha hb v := by
    simp only [Set.mem_ofPred_eq] at ha hb
    rw [Pi.mul_apply, Units.val_mul, map_mul, ha v, hb v, one_mul]
  one_mem' v := by simp
  inv_mem' {a} ha v := by
    simp only [Set.mem_ofPred_eq] at ha
    rw [Pi.inv_apply, Units.val_inv_eq_inv_val, map_inv₀, ha v, inv_one]

/-- **Cassels' group $Y$** (Ch. 11, (3.34), p. 212): $Y = X \cap ST$. -/
@[kb "cassels1978" "Ch. 11, (3.34), p. 212 (Y = X ∩ ST)"]
def casselsY : Subgroup (CasselsR P) := casselsX P ⊓ casselsST Q hQ L P

open Classical in
/-- **Cassels' $j$** (Ch. 11, Lemma 3.6 (ii), p. 213): $j = -1$ if $V$ is indefinite, $j = +1$ if $V$ is definite. -/
@[kb "cassels1978" "Ch. 11, Lemma 3.6 (ii), p. 213 (j)"]
def casselsJ : ℚˣ := if IsIndefinite Q then -1 else 1

/-- **Cassels' set $P_1$** (Ch. 11, p. 212): the $q \in P$ for which some $a_q \in O^+(\Lambda_q)$ has
$\theta(a_q) \in qU_q(\mathbb Q_q^\times)^2$, i.e. $\theta(\Lambda_q)$ contains an element of odd order at $q$. -/
@[kb "cassels1978" "Ch. 11, p. 212 (the set P₁)"]
def casselsP1 : Set P :=
  {q | ∃ c ∈ localSpinorNormGroup Q hQ q.1 L, ∃ m : ℤ,
    Valued.v ((c : (q.1.adicCompletion ℚ)ˣ) : q.1.adicCompletion ℚ) = WithZero.exp (2 * m + 1)}

open Classical in
/-- **Cassels' $s_q$** (Ch. 11, p. 213, reconstructed): for $c \in \mathbb Q_q^\times$ (a representative of
$\theta(a_q)$), the element of $R$ with component $c\,q^{-1}$ at $q$ and $q^{-1}$ at the other $p \in P$. -/
@[kb "cassels1978" "Ch. 11, p. 213 (s_q, reconstructed)"]
def casselsSq (q : P) (c : (q.1.adicCompletion ℚ)ˣ) : CasselsR P :=
  Pi.mulSingle q c * (casselsDiag P (natGenUnit q.1))⁻¹

variable {Q hQ L P}

theorem casselsDiag_mem_casselsX {t : ℚˣ}
    (ht : ∀ v : P, Valued.v (algebraMap ℚ (v.1.adicCompletion ℚ) (t : ℚ)) = 1) :
    casselsDiag P t ∈ casselsX P := fun v => by
  rw [casselsDiag_apply]; exact ht v

theorem casselsDiag_sign_mem_casselsX {ε : ℚˣ} (hε : ε = 1 ∨ ε = -1) : casselsDiag P ε ∈ casselsX P :=
  casselsDiag_mem_casselsX fun v => by rcases hε with rfl | rfl <;> simp

theorem casselsSq_mem_casselsX (q : P) {c : (q.1.adicCompletion ℚ)ˣ}
    (hc : Valued.v ((c : (q.1.adicCompletion ℚ)ˣ) : q.1.adicCompletion ℚ) = WithZero.exp (-1 : ℤ)) :
    casselsSq P q c ∈ casselsX P := by
  classical
  intro v
  rw [casselsSq, Pi.mul_apply, Pi.inv_apply, Units.val_mul, Units.val_inv_eq_inv_val, casselsDiag_apply, map_mul,
    map_inv₀]
  by_cases hv : v = q
  · subst hv
    rw [Pi.mulSingle_eq_same, hc, valued_natGenUnit_self, mul_inv_cancel₀ (by simp)]
  · rw [Pi.mulSingle_eq_of_ne hv, Units.val_one, map_one, one_mul,
      valued_natGenUnit_of_ne (fun h => hv (Subtype.ext h)), inv_one]

open Classical in
theorem mulSingle_mem_casselsS (q : P) {c : (q.1.adicCompletion ℚ)ˣ}
    (hc : c ∈ localSpinorNormGroup Q hQ q.1 L) : (Pi.mulSingle q c : CasselsR P) ∈ casselsS Q hQ L P := by
  classical
  rw [casselsS, Subgroup.mem_pi]
  intro v _
  by_cases hv : v = q
  · subst hv; rw [Pi.mulSingle_eq_same]; exact hc
  · rw [Pi.mulSingle_eq_of_ne hv]; exact Subgroup.one_mem _

theorem natGenUnit_mem_casselsT (hn : 3 ≤ n) (q : P) : natGenUnit q.1 ∈ casselsT Q hQ P := by
  rw [mem_casselsT_rat_iff Q hQ hn]
  refine ⟨fun v hv => ?_, fun _ => natGenUnit_pos _⟩
  have := valued_natGenUnit_of_ne (v := q.1) (w := v) (by rintro rfl; exact hv q.2)
  rw [algebraMap_adic_eq_rat] at this
  exact this

theorem casselsSq_mem_casselsST (hn : 3 ≤ n) (q : P) {c : (q.1.adicCompletion ℚ)ˣ}
    (hc : c ∈ localSpinorNormGroup Q hQ q.1 L) : casselsSq P q c ∈ casselsST Q hQ L P :=
  (casselsST Q hQ L P).mul_mem (Subgroup.mem_sup_left (mulSingle_mem_casselsS q hc))
    ((casselsST Q hQ L P).inv_mem (Subgroup.mem_sup_right (Subgroup.mem_map.mpr ⟨_, natGenUnit_mem_casselsT hn q, rfl⟩)))

theorem casselsJ_mem_casselsT (hn : 3 ≤ n) : casselsJ Q ∈ casselsT Q hQ P := by
  classical
  rw [mem_casselsT_rat_iff Q hQ hn]
  refine ⟨fun v _ => ?_, fun h => ?_⟩
  · unfold casselsJ; split_ifs <;> simp
  · unfold casselsJ; rw [if_neg h]; simp

variable (Q hQ L P)

/-- **Cassels: $R = XT$** (Ch. 11, p. 212): every $r \in R$ is $xt$ with $x \in X$ and $t \in T$ (namely
$t = \prod_{q \in P}q^{e_q}$, $e_q = \operatorname{ord}_q r_q$). -/
@[kb "cassels1978" "Ch. 11, p. 212 (R = XT)"]
theorem exists_casselsX_mul_casselsT (hn : 3 ≤ n) (r : CasselsR P) :
    ∃ x ∈ casselsX P, ∃ t ∈ casselsT Q hQ P, r = x * casselsDiag P t := by
  classical
  let k : HeightOneSpectrum (𝓞 ℚ) → ℤ := fun v =>
    if h : v ∈ P then WithZero.log (Valued.v ((r ⟨v, h⟩ : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ)) else 0
  set t : ℚˣ := ∏ q ∈ P, natGenUnit q ^ (-k q) with htdef
  refine ⟨r * (casselsDiag P t)⁻¹, fun v => ?_, t, ?_, by simp⟩
  · rw [Pi.mul_apply, Pi.inv_apply, Units.val_mul, Units.val_inv_eq_inv_val, casselsDiag_apply, map_mul, map_inv₀,
      htdef, valued_prod_natGenUnit, if_pos v.2, neg_neg]
    have : k v.1 = WithZero.log (Valued.v ((r v : (v.1.adicCompletion ℚ)ˣ) : v.1.adicCompletion ℚ)) := by
      simp only [k, dif_pos v.2]
    rw [this, WithZero.exp_log (by simp), mul_inv_cancel₀ (by simp)]
  · rw [mem_casselsT_rat_iff Q hQ hn]
    refine ⟨fun v hv => ?_, fun _ => ?_⟩
    · have := valued_prod_natGenUnit P (fun q => -k q) v
      rw [if_neg hv, algebraMap_adic_eq_rat] at this
      simpa [htdef] using this
    rw [htdef, Units.coe_prod]
    exact Finset.prod_pos fun q _ => by
      rw [Units.val_zpow_eq_zpow_val]; exact zpow_pos (natGenUnit_pos q) _

/-- **Cassels (3.35): $G = R/ST = X/Y$** (Ch. 11, p. 212): every class of $G$ is represented by an element of $X$. -/
@[kb "cassels1978" "Ch. 11, (3.35), p. 212 (G = X/Y: surjectivity)"]
theorem exists_casselsX_mk_eq (hn : 3 ≤ n) (g : CasselsG Q hQ L P) :
    ∃ x ∈ casselsX P, (QuotientGroup.mk x : CasselsG Q hQ L P) = g := by
  obtain ⟨r, rfl⟩ := QuotientGroup.mk_surjective g
  obtain ⟨x, hx, t, ht, rfl⟩ := exists_casselsX_mul_casselsT Q hQ P hn r
  refine ⟨x, hx, QuotientGroup.eq.mpr ?_⟩
  rw [inv_mul_cancel_left]
  exact Subgroup.mem_sup_right (Subgroup.mem_map.mpr ⟨t, ht, rfl⟩)

/-- **Cassels (3.35): $G = X/Y$** (Ch. 11, p. 212): an element of $X$ is trivial in $G$ if and only if it lies in $Y$. -/
@[kb "cassels1978" "Ch. 11, (3.35), p. 212 (G = X/Y: kernel)"]
theorem mk_eq_one_iff_mem_casselsY {x : CasselsR P} (hx : x ∈ casselsX P) :
    (QuotientGroup.mk x : CasselsG Q hQ L P) = 1 ↔ x ∈ casselsY Q hQ L P := by
  rw [QuotientGroup.eq_one_iff]
  exact ⟨fun h => ⟨hx, h⟩, fun h => h.2⟩

/-- **Cassels, Lemma 3.6** (Ch. 11, p. 213, reconstructed; module docstring): *the group $Y = X \cap ST$ is generated
by (i) $\prod_{p\in P}(\theta(\Lambda_p) \cap U_p)$; (ii) $j$ ($-1$ if $V$ is indefinite, $+1$ if definite); (iii) the
$s_q$ ($q \in P_1$).* Here (i) is $S \cap X$, $j$ is embedded diagonally, and $s_q$ is built from a representative $c_q$
of $\theta(a_q)$ with $\lvert c_q\rvert_q = \lvert q\rvert_q$ (`hc`). -/
@[kb "cassels1978" "Ch. 11, Lemma 3.6, p. 213 (reconstructed)"]
theorem casselsY_eq_closure (hn : 3 ≤ n) (c : ∀ q : P, (q.1.adicCompletion ℚ)ˣ)
    (hc : ∀ q ∈ casselsP1 Q hQ L P, c q ∈ localSpinorNormGroup Q hQ q.1 L ∧
      Valued.v ((c q : (q.1.adicCompletion ℚ)ˣ) : q.1.adicCompletion ℚ) = WithZero.exp (-1 : ℤ)) :
    casselsY Q hQ L P = Subgroup.closure
      (((casselsS Q hQ L P ⊓ casselsX P : Subgroup (CasselsR P)) : Set (CasselsR P)) ∪
        {casselsDiag P (casselsJ Q)} ∪ (fun q => casselsSq P q (c q)) '' casselsP1 Q hQ L P) := by
  classical
  apply le_antisymm
  · rintro y ⟨hyX, hyST⟩
    obtain ⟨s, hs, d, hd, rfl⟩ := Subgroup.mem_sup.mp hyST
    obtain ⟨t, ht, rfl⟩ := Subgroup.mem_map.mp hd
    have ht' := (mem_casselsT_rat_iff Q hQ hn P t).mp ht
    obtain ⟨ε, e, hε, rfl⟩ := exists_eq_sign_mul_prod P t fun v hv => by
      rw [algebraMap_adic_eq_rat]; exact ht'.1 v hv
    set K := Subgroup.closure
      (((casselsS Q hQ L P ⊓ casselsX P : Subgroup (CasselsR P)) : Set (CasselsR P)) ∪
        {casselsDiag P (casselsJ Q)} ∪ (fun q => casselsSq P q (c q)) '' casselsP1 Q hQ L P) with hK
    -- the sign
    have hεK : casselsDiag P ε ∈ K := by
      rcases hε with rfl | rfl
      · rw [map_one]; exact K.one_mem
      · by_cases hind : IsIndefinite Q
        · have : casselsJ Q = -1 := by unfold casselsJ; rw [if_pos hind]
          rw [← this]
          exact Subgroup.subset_closure (Or.inl (Or.inr rfl))
        · exfalso
          have hpos := ht'.2 hind
          rw [Units.val_mul, Units.coe_prod] at hpos
          have : 0 < ∏ q ∈ P, ((natGenUnit q ^ e q : ℚˣ) : ℚ) := Finset.prod_pos fun q _ => by
            rw [Units.val_zpow_eq_zpow_val]; exact zpow_pos (natGenUnit_pos q) _
          simp only [Units.val_neg, Units.val_one, neg_one_mul] at hpos
          linarith
    -- valuation of the scalar at `q ∈ P`
    have hval : ∀ q : P, Valued.v (algebraMap ℚ (q.1.adicCompletion ℚ)
        (((ε * ∏ q ∈ P, natGenUnit q ^ e q : ℚˣ)) : ℚ)) = WithZero.exp (-e q.1) := by
      intro q
      rw [Units.val_mul, map_mul, map_mul, valued_prod_natGenUnit, if_pos q.2]
      rcases hε with rfl | rfl <;> simp
    -- primes with odd exponent are in `P₁`
    have hodd : ∀ q : P, ¬ Even (e q.1) → q ∈ casselsP1 Q hQ L P := by
      intro q hq
      obtain ⟨m, hm⟩ := Int.not_even_iff_odd.mp hq
      refine ⟨s q, by rw [casselsS, Subgroup.mem_pi] at hs; exact hs q trivial, m, ?_⟩
      have h1 := hyX q
      rw [Pi.mul_apply, Units.val_mul, casselsDiag_apply, map_mul, hval q] at h1
      have h2 : Valued.v ((s q : (q.1.adicCompletion ℚ)ˣ) : q.1.adicCompletion ℚ) = WithZero.exp (e q.1) := by
        have hne : WithZero.exp (-e q.1) ≠ (0 : WithZero (Multiplicative ℤ)) := WithZero.exp_ne_zero
        calc _ = Valued.v ((s q : (q.1.adicCompletion ℚ)ˣ) : q.1.adicCompletion ℚ) * WithZero.exp (-e q.1) *
              (WithZero.exp (-e q.1))⁻¹ := by rw [mul_inv_cancel_right₀ hne]
          _ = _ := by rw [h1, one_mul, ← WithZero.exp_neg, neg_neg]
      rw [h2, hm]
    -- the correction factors
    let f : P → CasselsR P := fun q => if q ∈ casselsP1 Q hQ L P then casselsSq P q (c q) ^ e q.1 else 1
    have hfK : ∀ q, f q ∈ K := by
      intro q
      simp only [f]
      split_ifs with hq
      · exact K.zpow_mem (Subgroup.subset_closure (Or.inr ⟨q, hq, rfl⟩)) _
      · exact K.one_mem
    have hfX : ∀ q, f q ∈ casselsX P := by
      intro q
      simp only [f]
      split_ifs with hq
      · exact (casselsX P).zpow_mem (casselsSq_mem_casselsX q (hc q hq).2) _
      · exact (casselsX P).one_mem
    have hfS : ∀ q : P, casselsDiag P (natGenUnit q.1) ^ e q.1 * f q ∈ casselsS Q hQ L P := by
      intro q
      simp only [f]
      split_ifs with hq
      · have : casselsDiag P (natGenUnit q.1) ^ e q.1 * casselsSq P q (c q) ^ e q.1 =
            (Pi.mulSingle q (c q) : CasselsR P) ^ e q.1 := by
          rw [casselsSq, mul_zpow, inv_zpow', ← mul_assoc, mul_comm (casselsDiag P _ ^ e q.1), mul_assoc,
            ← zpow_add, add_neg_cancel, zpow_zero, mul_one]
        rw [this]
        exact (casselsS Q hQ L P).zpow_mem (mulSingle_mem_casselsS q (hc q hq).1) _
      · obtain ⟨m, hm⟩ := not_not.mp (fun h => hq (hodd q h))
        rw [mul_one, hm, ← two_mul, mul_comm, zpow_mul, zpow_two, ← sq]
        exact sq_mem_casselsS Q hQ L P _
    -- `z = y · ε⁻¹ · ∏ f q` lies in `S ∩ X`
    set z := s * casselsDiag P (ε * ∏ q ∈ P, natGenUnit q ^ e q) * (casselsDiag P ε)⁻¹ * ∏ q, f q with hz
    have hzS : z ∈ casselsS Q hQ L P := by
      have : z = s * ∏ q : P, (casselsDiag P (natGenUnit q.1) ^ e q.1 * f q) := by
        rw [hz, map_mul, mul_comm (casselsDiag P ε), ← mul_assoc s, mul_inv_cancel_right, Finset.prod_mul_distrib,
          map_prod, ← Finset.prod_coe_sort P, mul_assoc]
        simp only [map_zpow]
      rw [this]
      exact (casselsS Q hQ L P).mul_mem hs (Subgroup.prod_mem _ fun q _ => hfS q)
    have hzX : z ∈ casselsX P :=
      (casselsX P).mul_mem ((casselsX P).mul_mem hyX ((casselsX P).inv_mem (casselsDiag_sign_mem_casselsX hε)))
        (Subgroup.prod_mem _ fun q _ => hfX q)
    have hzK : z ∈ K := Subgroup.subset_closure (Or.inl (Or.inl ⟨hzS, hzX⟩))
    have hy : s * casselsDiag P (ε * ∏ q ∈ P, natGenUnit q ^ e q) = z * casselsDiag P ε * (∏ q, f q)⁻¹ := by
      rw [hz, mul_right_comm _ (∏ q, f q) (casselsDiag P ε), mul_inv_cancel_right, inv_mul_cancel_right]
    rw [hy]
    exact K.mul_mem (K.mul_mem hzK hεK) (K.inv_mem (Subgroup.prod_mem _ fun q _ => hfK q))
  · rw [Subgroup.closure_le]
    rintro y ((⟨hS, hX⟩ | rfl) | ⟨q, hq, rfl⟩)
    · exact ⟨hX, Subgroup.mem_sup_left hS⟩
    · refine ⟨casselsDiag_mem_casselsX fun v => ?_, Subgroup.mem_sup_right
        (Subgroup.mem_map.mpr ⟨_, casselsJ_mem_casselsT hn, rfl⟩)⟩
      unfold casselsJ; split_ifs <;> simp
    · exact ⟨casselsSq_mem_casselsX q (hc q hq).2, casselsSq_mem_casselsST hn q (hc q hq).1⟩

/-- **Cassels, Lemma 3.6, Corollary, through $Y$** (Ch. 11, p. 213): *if $U_p \subseteq \theta(\Lambda_p)$ for all
$p \in P$, then $Y = X$*, so $G = X/Y$ is trivial and the genus is a single spinor genus (for the last step see
`sameProperSpinorGenus_of_sameGenus_rat`). -/
@[kb "cassels1978" "Ch. 11, Lemma 3.6, Cor., p. 213 (Y = X)"]
theorem casselsY_eq_casselsX (h : ∀ v : P, ∀ u : (v.1.adicCompletion ℚ)ˣ,
    Valued.v ((u : (v.1.adicCompletion ℚ)ˣ) : v.1.adicCompletion ℚ) = 1 → u ∈ localSpinorNormGroup Q hQ v.1 L) :
    casselsY Q hQ L P = casselsX P := by
  refine le_antisymm inf_le_left fun x hx => ⟨hx, Subgroup.mem_sup_left ?_⟩
  rw [casselsS, Subgroup.mem_pi]
  exact fun v _ => h v (x v) (hx v)

end Groups

