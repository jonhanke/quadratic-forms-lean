      Siegel.ProperIntEquiv (cfT t) (cfT (repsL145.getD i (0, 0, 0)))) ∧
    (∀ i j, i < repsL145.length → j < repsL145.length →
      Siegel.ProperIntEquiv (cfT (repsL145.getD i (0, 0, 0))) (cfT (repsL145.getD j (0, 0, 0))) → i = j) := by
  have h := classify (d := -145) (by norm_num) (by simpa using not_isSquare_145) Adm145
    (fun t ht p q r s _ => Adm145_subT t ht p q r s) S145 repsL145 tab145 (p := 30) (by norm_num) (by decide)
    S145_red S145_closed S145_per S145_complete tab145_ok tab145_cover tab145_cls tab145_K tab145_rep
  exact ⟨fun t hA ht => h.1 t hA ht, h.2⟩

/-- Helper: $Ax_0^2 + Bx_0x_1 + Cx_1^2$ for `BinQF.mk A B C`. -/
theorem eval_binqf_mk_find (A B C : ℤ) (x : Fin 2 → ℤ) :
    QuadForm.eval (BinQF.mk A B C) x = A * x 0 ^ 2 + B * x 0 * x 1 + C * x 1 ^ 2 := by
  simp [QuadForm.eval, QuadForm.evalIn, Fin.sum_univ_two, BinQF.mk, QuadForm.ofUpper]
  ring

/-- Helper: the classically integral form $(2A, B, 2C)$ takes twice the values of $Ax^2 + Bxy + Cy^2$. -/
theorem eval_cfT_double (A B C : ℤ) (x : Fin 2 → ℤ) :
    QuadForm.eval (cfT (2 * A, B, 2 * C)) x = 2 * QuadForm.eval (BinQF.mk A B C) x := by
  simp only [cfT, eval_cform, eval_binqf_mk_find]
  push_cast
  ring

/-- Helper: equivalence ($\det T = \pm 1$) of the doubled triples is equivalence of the integer-valued forms. -/
theorem cfT_double_iff {A B C A' B' C' : ℤ} (e : ℤ) :
    (∃ T : GL (Fin 2) ℤ, T.val.det = e ∧ ∀ x, QuadForm.eval (cfT (2 * A, B, 2 * C)) (T.val *ᵥ x) =
      QuadForm.eval (cfT (2 * A', B', 2 * C')) x) ↔
    (∃ T : GL (Fin 2) ℤ, T.val.det = e ∧ ∀ x, QuadForm.eval (BinQF.mk A B C) (T.val *ᵥ x) =
      QuadForm.eval (BinQF.mk A' B' C') x) := by
  simp only [eval_cfT_double]
  constructor
  · rintro ⟨T, hT, h⟩; exact ⟨T, hT, fun x => by have := h x; omega⟩
  · rintro ⟨T, hT, h⟩; exact ⟨T, hT, fun x => by rw [h x]⟩

/-- Helper: proper equivalence of integer-valued forms is that of the doubled triples. -/
theorem properIntEquiv_mk_iff {A B C A' B' C' : ℤ} :
    Siegel.ProperIntEquiv (BinQF.mk A B C) (BinQF.mk A' B' C') ↔
      Siegel.ProperIntEquiv (cfT (2 * A, B, 2 * C)) (cfT (2 * A', B', 2 * C')) :=
  (cfT_double_iff 1).symm

/-- Helper: improper equivalence of integer-valued forms is that of the doubled triples. -/
theorem improperIntEquiv_mk_iff {A B C A' B' C' : ℤ} :
    Siegel.ImproperIntEquiv (BinQF.mk A B C) (BinQF.mk A' B' C') ↔
      Siegel.ImproperIntEquiv (cfT (2 * A, B, 2 * C)) (cfT (2 * A', B', 2 * C')) :=
  (cfT_double_iff (-1)).symm

/-- The four representatives of the classes of integer-valued forms $Ax^2 + Bxy + Cy^2$ of discriminant $145$, as
triples $(A, B, C)$: $x^2 + xy - 36y^2$, $4x^2 + xy - 9y^2$, $2x^2 + xy - 18y^2$, $3x^2 + xy - 12y^2$. -/
def reps145 (i : Fin 4) : ℤ × ℤ × ℤ := ![(1, 1, -36), (4, 1, -9), (2, 1, -18), (3, 1, -12)] i

/-- The mirror-image involution on the representatives of discriminant $145$: `reps145 i` is improperly equivalent
to `reps145 j` iff `i = conj145 j` (it swaps `2 ↔ 3`). -/
def conj145 : Fin 4 → Fin 4 := ![0, 1, 3, 2]

/-- Helper: the form $Ax^2 + Bxy + Cy^2$ of a representative. -/
def qf145 (i : Fin 4) : BinQF := BinQF.mk (reps145 i).1 (reps145 i).2.1 (reps145 i).2.2

/-- Helper: the doubled triple of `reps145 i` is `repsL145[i]`. -/
theorem cfT_qf145 (i : Fin 4) :
    cfT (2 * (reps145 i).1, (reps145 i).2.1, 2 * (reps145 i).2.2) = cfT (repsL145.getD i (0, 0, 0)) := by
  fin_cases i <;> rfl

/-- Helper: the representatives pairwise inequivalent, in terms of `qf145`. -/
theorem qf145_proper_iff (i j : Fin 4) : Siegel.ProperIntEquiv (qf145 i) (qf145 j) ↔ i = j := by
  unfold qf145
  rw [properIntEquiv_mk_iff, cfT_qf145, cfT_qf145]
  constructor
  · intro h
    exact Fin.ext (classify145.2 i j (by have := i.2; simpa [repsL145] using this)
      (by have := j.2; simpa [repsL145] using this) h)
  · rintro rfl; exact Siegel.ProperIntEquiv.refl _

/-- **Example 4 (iii)** (Cassels, Ch. 13, p. 329): the proper equivalence classes of integer-valued binary forms
$Ax^2 + Bxy + Cy^2$ with $B^2 - 4AC = 145$ are the four classes of $x^2 + xy - 36y^2$, $4x^2 + xy - 9y^2$,
$2x^2 + xy - 18y^2$, $3x^2 + xy - 12y^2$ (`reps145`, as triples $(A, B, C)$): the four listed forms have
$B^2 - 4AC = 145$, and every integer-valued form of discriminant $145$ is properly equivalent to exactly one of them. -/
@[kb "cassels1978" "Ch. 13, Examples, Ex. 4 (iii), p. 329"]
theorem example_4_iii :
    (∀ i : Fin 4, (reps145 i).2.1 ^ 2 - 4 * (reps145 i).1 * (reps145 i).2.2 = 145) ∧
    (∀ A B C : ℤ, B ^ 2 - 4 * A * C = 145 →
      ∃! i : Fin 4, Siegel.ProperIntEquiv (BinQF.mk A B C) (qf145 i)) := by
  refine ⟨by decide, fun A B C h => ?_⟩
  have hA : Adm145 (2 * A, B, 2 * C) := ⟨⟨A, rfl⟩, ⟨C, rfl⟩⟩
  have hd : discT (2 * A, B, 2 * C) = -145 := by simp only [discT]; linarith
  obtain ⟨i, hi, hequiv⟩ := classify145.1 _ hA hd
  have hi' : i < 4 := by simpa [repsL145] using hi
  have key : Siegel.ProperIntEquiv (BinQF.mk A B C) (qf145 ⟨i, hi'⟩) := by
    unfold qf145
    rw [properIntEquiv_mk_iff, cfT_qf145]
    exact hequiv
  refine ⟨⟨i, hi'⟩, key, fun j hj => ?_⟩
  exact (qf145_proper_iff j ⟨i, hi'⟩).mp (Siegel.ProperIntEquiv.trans (Siegel.ProperIntEquiv.symm hj) key)

/-- **Example 4 (iii), improper equivalences**: among the four representatives, `reps145 i` is improperly
equivalent to `reps145 j` iff `i = conj145 j`; so the only improper equivalence between different representatives
is $2x^2 + xy - 18y^2 \sim 3x^2 + xy - 12y^2$ (the other two have improper automorphs). -/
@[kb "cassels1978" "Ch. 13, Examples, Ex. 4 (iii), p. 329 (improper equivalences)"]
theorem example_4_iii_improper (i j : Fin 4) :
    Siegel.ImproperIntEquiv (BinQF.mk (reps145 i).1 (reps145 i).2.1 (reps145 i).2.2)
      (BinQF.mk (reps145 j).1 (reps145 j).2.1 (reps145 j).2.2) ↔ i = conj145 j := by
  have hc : ∀ j : Fin 4, ∃ c ∈ ctab145, c.j = j ∧ c.i = conj145 j := by decide
  obtain ⟨c, hcm, hcj, hci⟩ := hc j
  have := classify_improper repsL145 classify145.2 ctab145 ctab145_ok c hcm i
    (by have := i.2; simpa [repsL145] using this)
  rw [hcj] at this
  rw [improperIntEquiv_mk_iff]
  have e1 := cfT_qf145 i
  have e2 := cfT_qf145 j
  unfold qf145 at e1 e2
  rw [e1, e2]
  rw [Fin.ext_iff, hci] at *
  exact this

/-- **Example 4 (iii), classes up to equivalence** ($\det T = \pm 1$): every integer-valued form with
$B^2 - 4AC = 145$ is equivalent to one of $x^2 + xy - 36y^2$, $4x^2 + xy - 9y^2$, $2x^2 + xy - 18y^2$ (`reps145` at
`0, 1, 2`), and these three are pairwise inequivalent: there are three classes. -/
@[kb "cassels1978" "Ch. 13, Examples, Ex. 4 (iii), p. 329 (classes up to equivalence)"]
theorem example_4_iii_gl :
    (∀ A B C : ℤ, B ^ 2 - 4 * A * C = 145 → ∃ i ∈ ({0, 1, 2} : Finset (Fin 4)),
      Siegel.IntEquiv (BinQF.mk A B C) (qf145 i)) ∧
    (∀ i ∈ ({0, 1, 2} : Finset (Fin 4)), ∀ j ∈ ({0, 1, 2} : Finset (Fin 4)),
      Siegel.IntEquiv (qf145 i) (qf145 j) → i = j) := by
  refine ⟨fun A B C h => ?_, fun i hi j hj hij => ?_⟩
  · obtain ⟨i, hi, -⟩ := example_4_iii.2 A B C h
    have hmem : ∀ k : Fin 4, k ≠ 3 → k ∈ ({0, 1, 2} : Finset (Fin 4)) := by decide
    by_cases h3 : i = 3
    · subst h3
      refine ⟨2, by decide, Siegel.ProperIntEquiv.intEquiv hi |>.trans ?_⟩
      exact Siegel.ImproperIntEquiv.intEquiv ((example_4_iii_improper 3 2).mpr (by decide))
    · exact ⟨i, hmem i h3, hi.intEquiv⟩
  · rcases (Siegel.intEquiv_iff_proper_or_improper _ _).mp hij with h | h
    · exact (qf145_proper_iff i j).mp h
    · have := (example_4_iii_improper i j).mp h
      clear h hij
      revert hi hj this
      revert i j
      decide

/-! ### Exercise 2: the integral automorphs of $3x^2 + 2xy - 27y^2$

The form is $f = 3x^2 + 2xy - 27y^2 = $ `cform 3 1 (-27)` ($a = 3$, $b = 1$, $c = -27$, $ac - b^2 = -82$), primitive,
properly primitive, indefinite and anisotropic ($82$ is not a square). By Theorem 3.1 (3.14) its proper integral
automorphs are the matrices $\begin{pmatrix} t - u & 27u \\ 3u & t + u\end{pmatrix}$ with $t^2 - 82u^2 = 1$
(`autPlus_cform_iff_proper`); the fundamental solution of Pell's equation is $(t, u) = (163, 18)$ (since
$9^2 - 82 = -1$ and $(9 + \sqrt{82})^2 = 163 + 18\sqrt{82}$). There is no improper integral automorph: it would
make $f$ improperly equivalent to itself, i.e. properly equivalent to $3x^2 - 2xy - 27y^2$, and the proper classes of
determinant $-82$ (computed below like those of Ex. 3 (iii): four of them) separate these two forms. -/

/-- Helper: the classically reduced forms of determinant $-82$. -/
def S82 : List Tri :=
