theorem S82_red : ∀ t ∈ S82, IsRedTri t ∧ discT t = -82 := by decide +kernel

theorem S82_closed : ∀ t ∈ S82, nxt t ∈ S82 := by decide +kernel

theorem S82_per : ∀ t ∈ S82, nxt^[6] t = t := by decide +kernel

theorem S82_complete (t : Tri) (hr : IsRedTri t) (hd : discT t = -82) : t ∈ S82 :=
  mem_of_complete (d := -82) (N := 82) (by norm_num) (fun _ => True) S82 (by decide +kernel) t trivial hr hd

theorem tab82_ok : ∀ e ∈ tab82, e.i < repsL82.length ∧ e.p * e.s - e.q * e.r = 1 ∧
    subT (repsL82.getD e.i (0, 0, 0)) e.p e.q e.r e.s = e.v := by decide +kernel

theorem tab82_cover : ∀ u ∈ S82, (∃ e ∈ tab82, e.v = u) ∧ (∃ e ∈ tab82, e.v = conjT u) := by decide +kernel

theorem tab82_cls : ∀ e ∈ tab82, e.v ∈ S82 → clsOf tab82 e.v = e.i := by decide +kernel

theorem tab82_K : ∀ t ∈ S82, clsOf tab82 (nxt (nxt t)) = clsOf tab82 t ∧
    clsOf tab82 (rotT t) = clsOf tab82 t := by decide +kernel

theorem tab82_rep : ∀ i, i < repsL82.length → ∃ e ∈ tab82, e.i = i ∧ e.v ∈ S82 := fun i hi =>
  (by decide +kernel : ∀ i ∈ List.range repsL82.length, ∃ e ∈ tab82, e.i = i ∧ e.v ∈ S82) i
    (List.mem_range.2 hi)

/-- Helper: $82$ is not a square. -/
theorem not_isSquare_82 : ¬ IsSquare (82 : ℤ) := by
  rintro ⟨m, hm⟩
  have h1 : m ≤ 10 := by nlinarith
  have h2 : -10 ≤ m := by nlinarith
  interval_cases m <;> omega

/-- Helper: the four proper classes of determinant $-82$ (`repsL82` is the list of representatives). -/
theorem classify82 :
    ∀ i j, i < repsL82.length → j < repsL82.length →
      Siegel.ProperIntEquiv (cfT (repsL82.getD i (0, 0, 0))) (cfT (repsL82.getD j (0, 0, 0))) → i = j := by
  have h := classify (d := -82) (by norm_num) (by simpa using not_isSquare_82) (fun _ => True)
    (fun _ _ _ _ _ _ _ => trivial) S82 repsL82 tab82 (p := 6) (by norm_num) (by decide) S82_red S82_closed
    S82_per (fun t _ hr hd => S82_complete t hr hd) tab82_ok tab82_cover tab82_cls tab82_K tab82_rep
  exact h.2

/-- Helper: $f = 3x^2 + 2xy - 27y^2$ has no improper integral automorph. -/
theorem not_improperIntEquiv_f : ¬ Siegel.ImproperIntEquiv (cform 3 1 (-27)) (cform 3 1 (-27)) := by
  intro h
  have h1 := (improperIntEquiv_cfT_iff (t := (3, 1, -27)) (t' := (3, 1, -27))).mp h
  have h2 := classify82 0 1 (by decide) (by decide) h1
  exact absurd h2 (by decide)

/-- Helper: $-I$ is an integral automorph of every $ax^2 + 2bxy + cy^2$. -/
theorem neg_one_mem_aut' (a b c : ℤ) : (-1 : GL (Fin 2) ℤ) ∈ Siegel.Aut (cform a b c) := by
  intro x
  simp only [eval_cform, Units.val_neg, Units.val_one, Matrix.neg_mulVec, Matrix.one_mulVec, Pi.neg_apply]
  ring

/-- Helper: the element $\begin{pmatrix} t - u & 27u \\ 3u & t + u\end{pmatrix}$ of $SL_2(\mathbb{Z})$ for a solution
$(t, u)$ of $t^2 - 82u^2 = 1$, i.e. (3.14) for $3x^2 + 2xy - 27y^2$; a homomorphism from the Pell solutions. -/
def pellGL82 : Pell.Solution₁ 82 →* GL (Fin 2) ℤ where
  toFun s := mkSL (s.x - s.y) (27 * s.y) (3 * s.y) (s.x + s.y) (by have := s.prop; linear_combination this)
  map_one' := by
    apply Units.ext
    simp only [mkSL_val, Pell.Solution₁.x_one, Pell.Solution₁.y_one, Units.val_one]
    ext i j; fin_cases i <;> fin_cases j <;> simp
  map_mul' s s' := by
    apply Units.ext
    simp only [mkSL_val, Units.val_mul, Pell.Solution₁.x_mul, Pell.Solution₁.y_mul]
    ext i j; fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two] <;> ring

/-- Helper: `pellGL82` takes $-s$ to $-\,$`pellGL82 s`. -/
theorem pellGL82_neg (s : Pell.Solution₁ 82) : pellGL82 (-s) = -pellGL82 s := by
  apply Units.ext
  simp only [pellGL82, MonoidHom.coe_mk, OneHom.coe_mk, mkSL_val, Pell.Solution₁.x_neg,
    Pell.Solution₁.y_neg, Units.val_neg]
  ext i j; fin_cases i <;> fin_cases j <;> simp <;> ring

/-- Helper: the generator $\begin{pmatrix} 145 & 486 \\ 54 & 181\end{pmatrix}$ (the case $(t, u) = (163, 18)$). -/
def T82 : GL (Fin 2) ℤ := mkSL 145 486 54 181 (by norm_num)

/-- Helper: $(163, 18)$ solves $t^2 - 82u^2 = 1$. -/
def sol82 : Pell.Solution₁ 82 := Pell.Solution₁.mk 163 18 (by norm_num)

/-- Helper: `pellGL82 sol82 = T82`. -/
theorem pellGL82_sol82 : pellGL82 sol82 = T82 := by
  apply Units.ext
  simp only [pellGL82, MonoidHom.coe_mk, OneHom.coe_mk, T82, mkSL_val, sol82]
  ext i j; fin_cases i <;> fin_cases j <;> simp

/-- Helper: $(163, 18)$ is the fundamental solution of $t^2 - 82u^2 = 1$ (smallest $t > 1$). -/
theorem isFundamental_sol82 : Pell.IsFundamental sol82 := by
  refine ⟨by simp [sol82], by simp [sol82], fun {b} hb => ?_⟩
  by_contra hlt
  have hlt' : b.x < 163 := not_le.mp hlt
  have hp := b.prop
  have hx0 : 2 ≤ b.x := by omega
  have hx2 : b.x ^ 2 ≤ 26244 := by
    nlinarith [mul_nonneg (by omega : (0 : ℤ) ≤ 162 - b.x) (by omega : (0 : ℤ) ≤ 162 + b.x)]
  have hy : -17 ≤ b.y ∧ b.y ≤ 17 := by
    have : b.y ^ 2 < 324 := by nlinarith
    constructor <;> nlinarith
  have key : ∀ y ∈ Finset.Icc (-17 : ℤ) 17, ∀ x ∈ Finset.Icc (2 : ℤ) 162, x ^ 2 - 82 * y ^ 2 ≠ 1 := by
    decide +kernel
  exact key b.y (Finset.mem_Icc.2 hy) b.x (Finset.mem_Icc.2 ⟨by omega, by omega⟩) hp

/-- Helper: $f = 3x^2 + 2xy - 27y^2$ is anisotropic over $\mathbb{Q}$. -/
theorem aniso_f : ¬ (cform 3 1 (-27)).IsotropicIn ℚ := by
  apply aniso_of_nonsquare
  have : (1 : ℤ) ^ 2 - 3 * (-27) = 82 := by norm_num
  rw [this]
  exact not_isSquare_82

/-- Helper: the proper integral automorphs of $f$ are the matrices (3.14) with $t^2 - 82u^2 = 1$. -/
theorem autPlus_f_iff (T : GL (Fin 2) ℤ) :
    T ∈ Siegel.AutPlus (cform 3 1 (-27)) ↔
      ∃ t u : ℤ, t ^ 2 + (3 * (-27) - 1 ^ 2) * u ^ 2 = 1 ∧ T.val = pellMat 3 1 (-27) t u :=
  autPlus_cform_iff_proper (by norm_num) (by norm_num) (by norm_num) aniso_f T

/-- **Example 2** (Cassels, Ch. 13, p. 329): a complete set of generators of the group $\mathrm{Aut}(f)$ of integral
automorphs of $f = 3x^2 + 2xy - 27y^2$ (`cform 3 1 (-27)`). The group is generated by $-I$ and
$T_0 = \begin{pmatrix} 145 & 486 \\ 54 & 181\end{pmatrix}$ (`T82`, the matrix (3.14) of Theorem 3.1 for the fundamental
solution $(t, u) = (163, 18)$ of $t^2 - 82u^2 = 1$; $T_0\vec{x} = (145x_0 + 486x_1, 54x_0 + 181x_1)$), it is isomorphic to
$\{\pm 1\} \times \mathbb{Z}$, and every integral automorph of $f$ is proper (there is no integral automorph of
determinant $-1$). -/
@[kb "cassels1978" "Ch. 13, Examples, Ex. 2, p. 329"]
theorem ch13_example_2 :
    Subgroup.closure ({-1, T82} : Set (GL (Fin 2) ℤ)) = Siegel.Aut (cform 3 1 (-27)) ∧
    (∀ T ∈ Siegel.Aut (cform 3 1 (-27)), T.val.det = 1) := by
  have hnoimp : ∀ T ∈ Siegel.Aut (cform 3 1 (-27)), T.val.det = 1 := by
    intro T hT
    rcases det_gl T with hd | hd
    · exact hd
    · exact absurd ⟨T, hd, hT⟩ not_improperIntEquiv_f
  refine ⟨?_, hnoimp⟩
  have hT82 : T82 ∈ Siegel.AutPlus (cform 3 1 (-27)) := by
    rw [autPlus_f_iff]
    refine ⟨163, 18, by norm_num, ?_⟩
    simp only [T82, mkSL_val]
    ext i j; fin_cases i <;> fin_cases j <;> simp [pellMat]
  apply le_antisymm
  · rw [Subgroup.closure_le]
    rintro x (rfl | rfl)
    · exact neg_one_mem_aut' _ _ _
    · exact (Siegel.mem_autPlus_iff.mp hT82).1
  · intro T hT
    have hTp : T ∈ Siegel.AutPlus (cform 3 1 (-27)) := Siegel.mem_autPlus_iff.mpr ⟨hT, hnoimp T hT⟩
    obtain ⟨t, u, ht, hTv⟩ := (autPlus_f_iff T).mp hTp
    have hs : t ^ 2 - 82 * u ^ 2 = 1 := by linear_combination ht
    obtain ⟨n, hn | hn⟩ := isFundamental_sol82.eq_zpow_or_neg_zpow (Pell.Solution₁.mk (d := 82) t u hs)
    · have hTe : T = T82 ^ n := by
        rw [← pellGL82_sol82, ← map_zpow, ← hn]
        apply Units.ext
        rw [hTv]
        simp only [pellGL82, MonoidHom.coe_mk, OneHom.coe_mk, mkSL_val]
        ext i j; fin_cases i <;> fin_cases j <;> simp [pellMat]
      rw [hTe]
      exact zpow_mem (Subgroup.subset_closure (Set.mem_insert_of_mem _ (Set.mem_singleton _))) n
    · have hTe : T = -1 * T82 ^ n := by
        rw [neg_one_mul, ← pellGL82_sol82, ← map_zpow, ← pellGL82_neg, ← hn]
        apply Units.ext
        rw [hTv]
        simp only [pellGL82, MonoidHom.coe_mk, OneHom.coe_mk, mkSL_val]
        ext i j; fin_cases i <;> fin_cases j <;> simp [pellMat]
      rw [hTe]
      exact mul_mem (Subgroup.subset_closure (Set.mem_insert _ _))
        (zpow_mem (Subgroup.subset_closure (Set.mem_insert_of_mem _ (Set.mem_singleton _))) n)

end QuadFormsKB.Reduction
