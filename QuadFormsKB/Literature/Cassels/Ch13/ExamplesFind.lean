/-- The six representatives of the proper classes of determinant $-79$, as triples $(a, b, c)$ for
$ax^2 + 2bxy + cy^2$: $x^2 - 79y^2$, $-x^2 + 79y^2$, $5x^2 + 4xy - 15y^2$, $5x^2 - 4xy - 15y^2$,
$-5x^2 + 4xy + 15y^2$, $-5x^2 - 4xy + 15y^2$. -/
def reps79 (i : Fin 6) : ℤ × ℤ × ℤ := repsL79.getD i (0, 0, 0)

/-- The mirror-image involution on the representatives of determinant $-79$: `reps79 i` is improperly equivalent to
`reps79 j` iff `i = conj79 j` (it swaps `2 ↔ 3` and `4 ↔ 5`). -/
def conj79 : Fin 6 → Fin 6 := ![0, 1, 3, 2, 5, 4]

/-- **Example 3 (iii)** (Cassels, Ch. 13, p. 329): the proper equivalence classes of classically integral forms
$ax^2 + 2bxy + cy^2$ with $ac - b^2 = -79$ are the six classes of $x^2 - 79y^2$, $-x^2 + 79y^2$,
$5x^2 + 4xy - 15y^2$, $5x^2 - 4xy - 15y^2$, $-5x^2 + 4xy + 15y^2$, $-5x^2 - 4xy + 15y^2$ (`reps79`, as triples
$(a, b, c)$): the six listed forms have $ac - b^2 = -79$, and every classically integral form with $ac - b^2 = -79$ is
properly equivalent to exactly one of them. -/
@[kb "cassels1978" "Ch. 13, Examples, Ex. 3 (iii), p. 329"]
theorem example_3_iii :
    (∀ i : Fin 6, (reps79 i).1 * (reps79 i).2.2 - (reps79 i).2.1 ^ 2 = -79) ∧
    (∀ a b c : ℤ, a * c - b ^ 2 = -79 →
      ∃! i : Fin 6, Siegel.ProperIntEquiv (cform a b c)
        (cform (reps79 i).1 (reps79 i).2.1 (reps79 i).2.2)) := by
  refine ⟨by decide, fun a b c h => ?_⟩
  obtain ⟨i, hi, hequiv⟩ := classify79.1 (a, b, c) h
  refine ⟨⟨i, by simpa [repsL79] using hi⟩, hequiv, fun j hj => ?_⟩
  have := classify79.2 j i (by have := j.2; simpa [repsL79] using this) hi
    (Siegel.ProperIntEquiv.trans (Siegel.ProperIntEquiv.symm hj) hequiv)
  exact Fin.ext this

/-- **Example 3 (iii), improper equivalences** (Cassels, Ch. 13, p. 329): among the six representatives `reps79`,
`reps79 i` is improperly equivalent to `reps79 j` iff `i = conj79 j`; so the improper equivalences are exactly
$5x^2 + 4xy - 15y^2 \sim 5x^2 - 4xy - 15y^2$ and $-5x^2 + 4xy + 15y^2 \sim -5x^2 - 4xy + 15y^2$ (and each form with
itself, $x^2 - 79y^2$ and $-x^2 + 79y^2$ have improper automorphs). -/
@[kb "cassels1978" "Ch. 13, Examples, Ex. 3 (iii), p. 329 (improper equivalences)"]
theorem example_3_iii_improper (i j : Fin 6) :
    Siegel.ImproperIntEquiv (cform (reps79 i).1 (reps79 i).2.1 (reps79 i).2.2)
      (cform (reps79 j).1 (reps79 j).2.1 (reps79 j).2.2) ↔ i = conj79 j := by
  have hc : ∀ j : Fin 6, ∃ c ∈ ctab79, c.j = j ∧ c.i = conj79 j := by decide
  obtain ⟨c, hcm, hcj, hci⟩ := hc j
  have := classify_improper repsL79 classify79.2 ctab79 ctab79_ok c hcm i (by have := i.2; simpa [repsL79] using this)
  rw [hcj] at this
  rw [Fin.ext_iff, hci] at *
  exact this

/-- **Example 3 (iii), classes up to equivalence** ($\det T = \pm 1$, as in Ex. 3 (ii)): every classically integral form
with $ac - b^2 = -79$ is equivalent to one of $x^2 - 79y^2$, $-x^2 + 79y^2$, $5x^2 + 4xy - 15y^2$,
$-5x^2 + 4xy + 15y^2$ (`reps79` at `0, 1, 2, 4`), and these four are pairwise inequivalent: there are four classes. -/
@[kb "cassels1978" "Ch. 13, Examples, Ex. 3 (iii), p. 329 (classes up to equivalence)"]
theorem example_3_iii_gl :
    (∀ a b c : ℤ, a * c - b ^ 2 = -79 → ∃ i ∈ ({0, 1, 2, 4} : Finset (Fin 6)),
      Siegel.IntEquiv (cform a b c) (cform (reps79 i).1 (reps79 i).2.1 (reps79 i).2.2)) ∧
    (∀ i ∈ ({0, 1, 2, 4} : Finset (Fin 6)), ∀ j ∈ ({0, 1, 2, 4} : Finset (Fin 6)),
      Siegel.IntEquiv (cform (reps79 i).1 (reps79 i).2.1 (reps79 i).2.2)
        (cform (reps79 j).1 (reps79 j).2.1 (reps79 j).2.2) → i = j) := by
  have hmem : ∀ k : Fin 6, k ≠ 3 → k ≠ 5 → k ∈ ({0, 1, 2, 4} : Finset (Fin 6)) := by decide
  refine ⟨fun a b c h => ?_, fun i hi j hj hij => ?_⟩
  · obtain ⟨i, hi, hequiv⟩ := classify79.1 (a, b, c) h
    have hi' : i < 6 := by simpa [repsL79] using hi
    have key : Siegel.IntEquiv (cform a b c) (cform (reps79 ⟨i, hi'⟩).1 (reps79 ⟨i, hi'⟩).2.1 (reps79 ⟨i, hi'⟩).2.2) :=
      Siegel.ProperIntEquiv.intEquiv hequiv
    by_cases h3 : (⟨i, hi'⟩ : Fin 6) = 3
    · rw [h3] at key
      exact ⟨2, by decide, key.trans (Siegel.ImproperIntEquiv.intEquiv
        ((example_3_iii_improper 3 2).mpr (by decide)))⟩
    by_cases h5 : (⟨i, hi'⟩ : Fin 6) = 5
    · rw [h5] at key
      exact ⟨4, by decide, key.trans (Siegel.ImproperIntEquiv.intEquiv
        ((example_3_iii_improper 5 4).mpr (by decide)))⟩
    exact ⟨⟨i, hi'⟩, hmem _ h3 h5, key⟩
  · rcases (Siegel.intEquiv_iff_proper_or_improper _ _).mp hij with h | h
    · exact Fin.ext (classify79.2 i j (by have := i.2; simpa [repsL79] using this)
        (by have := j.2; simpa [repsL79] using this) h)
    · have := (example_3_iii_improper i j).mp h
      clear h hij
      revert hi hj this
      revert i j
      decide

