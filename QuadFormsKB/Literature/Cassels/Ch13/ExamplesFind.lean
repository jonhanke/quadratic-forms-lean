   (6, 4, -11),
   (6, 8, -3),
   (9, 1, -9),
   (9, 8, -2),
   (11, 4, -6),
   (11, 7, -3)]

/-- Helper: representatives. -/
def repsL82 : List Tri :=
  [(3, 1, -27), (3, -1, -27), (-9, -8, 2), (-1, -9, 1)]

/-- Helper: table of explicit proper equivalences `(v, i, p, q, r, s)`: $v$ is the form `repsL[i]`
substituted by $\begin{pmatrix} p & q \\ r & s\end{pmatrix}$. -/
def tab82 : List TabEntry :=
  [⟨(-11, -7, 3), 0, 2, -1, 1, 0⟩,
   ⟨(-11, 7, 3), 1, -2, -1, 1, 0⟩,
