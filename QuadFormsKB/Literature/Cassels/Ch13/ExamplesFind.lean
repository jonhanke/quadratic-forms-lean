   ⟨(-1, 9, 1), 3, 1, -18, 0, 1⟩,
   ⟨(1, 9, -1), 3, 0, -1, 1, 0⟩,
   ⟨(1, -9, -1), 3, 0, -1, 1, -18⟩,
   ⟨(2, 8, -9), 2, 0, -1, 1, 0⟩,
   ⟨(2, -8, -9), 2, 0, -1, 1, -8⟩,
   ⟨(3, 7, -11), 0, 1, 2, 0, 1⟩,
   ⟨(3, -7, -11), 1, 1, -2, 0, 1⟩,
   ⟨(3, 8, -6), 1, 1, 3, 0, 1⟩,
   ⟨(3, -8, -6), 0, 1, -3, 0, 1⟩,
   ⟨(6, 4, -11), 1, -3, 2, 1, -1⟩,
   ⟨(6, -4, -11), 0, 3, 2, 1, 1⟩,
   ⟨(6, 8, -3), 0, 3, 8, 1, 3⟩,
   ⟨(6, -8, -3), 1, -3, 8, 1, -3⟩,
   ⟨(9, 1, -9), 2, -1, 1, -9, 8⟩,
   ⟨(9, -1, -9), 2, -1, -1, 1, 0⟩,
