   ⟨(-6, -4, 11), 0, -3, -7, 1, 2⟩,
   ⟨(-6, 4, 11), 1, 3, -7, 1, -2⟩,
   ⟨(-3, -8, 6), 0, 8, -3, 3, -1⟩,
   ⟨(-3, 8, 6), 1, 8, 3, -3, -1⟩,
   ⟨(-3, -7, 11), 1, 8, 43, -3, -16⟩,
   ⟨(-3, 7, 11), 0, -10, -7, 3, 2⟩,
