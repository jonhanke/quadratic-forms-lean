/-
# Cassels, Chapter 13, Examples 2, 3 (iii), 4 (iii): the "find" exercises on binary forms

Formalization of Cassels, *Rational Quadratic Forms* (1978), Ch. 13, *Examples*, p. 329, Exercises 2, 3 (iii) and
4 (iii). The book gives no answers to these; the answers are computed (Python, outside the repository) and proved here.

**Conventions.** `cform a b c` $= ax^2 + 2bxy + cy^2$ (classically integral), `BinQF.mk A B C`
$= Ax^2 + Bxy + Cy^2$ (integer-valued), as in `Ch13/Sec3.lean`. Variables are $x_0, x_1$ (Cassels' $x, y$).
`Siegel.Aut`/`Siegel.AutPlus` are the integral automorphs/proper integral automorphs, `Siegel.ProperIntEquiv` and
`Siegel.ImproperIntEquiv` proper/improper equivalence ($\det T = \pm 1$ with $Q(T\vec{x}) = Q'(\vec{x})$).

**Exercise 2** (`ch13_example_2`). The form is $3x^2 + 2xy - 27y^2$ (`cform 3 1 (-27)`, determinant $ac - b^2 = -82$). Its
group of integral automorphs (proper and improper) is generated by $-I$ and the proper automorph
$T_0 = \begin{pmatrix} 145 & 486 \\ 54 & 181\end{pmatrix}$, the matrix (3.14) of Theorem 3.1 for the fundamental
solution $(163, 18)$ of $t^2 - 82u^2 = 1$; the form has no improper automorph (the answer is computed in Python,
outside the repository; the absence of improper automorphs is proved from the classification of proper classes of
determinant $-82$ by the cycle method below). Matrices are $T = \begin{pmatrix} p & q \\ r & s\end{pmatrix}$ with
$T\vec{x} = (px_0 + qx_1, rx_0 + sx_1)$.

**Exercises 3 (iii) and 4 (iii)** (`example_3_iii`, `example_4_iii`). Lists of forms are given such that every form of
the stated determinant/discriminant is properly equivalent to exactly one of them (existence and pairwise
non-equivalence), together with the improper equivalences between the listed forms and the resulting classes up to
(improper or proper) equivalence ($GL_2(\mathbb{Z})$-classes). Cassels says "classes" in 4 (iii) and "proper
equivalence classes" in 3 (iii); we do both for both exercises (in Cassels "equivalent" means $\det T = \pm 1$, as in
4 (ii)).
The method is the cycle of classically reduced forms of §3 (`Sec3Cycle.lean`): every form is equivalent to a
classically reduced one (Lemma 3.6, `exists_act_isClassicallyReduced`); two properly equivalent classically reduced
forms are $f_m$ ($m$ even) or $f_m(-y, x)$ (`mem_cycleForm_proper`, a sharpening of the Corollary to Lemma 3.6 that
records the parity of $m$). For the finitely many classically reduced forms of the given determinant (an explicit list,
proved complete) the cycles are computed by `decide`.
-/
import QuadFormsKB.Literature.Cassels.Ch13.Sec3Cycle

open Matrix

namespace QuadFormsKB.Reduction

/-! ### Helpers on $GL_2(\mathbb{Z})$ -/

/-- Helper: the element of $GL_2(\mathbb{Z})$ with matrix $\begin{pmatrix} p & q \\ r & s\end{pmatrix}$ when
$ps - qr = 1$. -/
def mkSL (p q r s : ℤ) (h : p * s - q * r = 1) : GL (Fin 2) ℤ :=
  Matrix.SpecialLinearGroup.toGL ⟨!![p, q; r, s], by rw [Matrix.det_fin_two_of]; exact h⟩

/-- Helper: the matrix of `mkSL`. -/
theorem mkSL_val (p q r s : ℤ) (h : p * s - q * r = 1) : (mkSL p q r s h).val = !![p, q; r, s] := rfl

/-- Helper: `mkSL` is proper. -/
theorem det_mkSL (p q r s : ℤ) (h : p * s - q * r = 1) : (mkSL p q r s h).val.det = 1 := by
  rw [mkSL_val, Matrix.det_fin_two_of]; exact h

/-- Helper: the reflection $\operatorname{diag}(1, -1)$, $f(x_0, x_1) \mapsto f(x_0, -x_1)$. -/
noncomputable def flipGL : GL (Fin 2) ℤ := toGL !![1, 0; 0, -1] (Or.inr (by simp [Matrix.det_fin_two_of]))

/-- Helper: the matrix of `flipGL`. -/
theorem flipGL_val : flipGL.val = !![1, 0; 0, -1] := rfl

/-- Helper: `flipGL` is an involution. -/
theorem flipGL_mul_self : flipGL * flipGL = 1 := by
  apply Units.ext
  rw [Units.val_mul, flipGL_val]
  ext i j; fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]

/-! ### Proper equivalence of classically reduced forms: the parity of the cycle index -/

/-- Helper: parity bookkeeping for `det`: if $(-1)^k D = (-1)^m$ with $D = \pm 1$ then $D = 1$ iff $m - k$ is even. -/
theorem det_even_iff {D : ℤ} (hD : D = 1 ∨ D = -1) {k m : ℕ} (h : (-1 : ℤ) ^ k * D = (-1) ^ m) :
    D = 1 ↔ Even (-(k : ℤ) + m) := by
  have e : Even (-(k : ℤ) + m) ↔ (Even k ↔ Even m) := by
    rw [Int.even_add, even_neg]; simp [Int.even_coe_nat]
  rw [e]
  rcases Nat.even_or_odd k with hk | hk <;> rcases Nat.even_or_odd m with hm | hm
  · rw [hk.neg_one_pow, hm.neg_one_pow] at h
    simp [hk, hm]; omega
  · rw [hk.neg_one_pow, hm.neg_one_pow] at h
    have hm' : ¬ Even m := Nat.not_even_iff_odd.mpr hm
    simp [hk, hm']; omega
  · rw [hk.neg_one_pow, hm.neg_one_pow] at h
    have hk' : ¬ Even k := Nat.not_even_iff_odd.mpr hk
    simp [hk', hm]; omega
  · rw [hk.neg_one_pow, hm.neg_one_pow] at h
    have hk' : ¬ Even k := Nat.not_even_iff_odd.mpr hk
    have hm' : ¬ Even m := Nat.not_even_iff_odd.mpr hm
    simp [hk', hm']; omega

/-- Helper: `Rd.exists_cycleForm` with the parity of the index: a matrix whose columns form a reduced pair takes $f$
to $f_m$ with $\det T = 1$ iff $m$ is even. -/
theorem Rd.exists_cycleForm_det {F : Matrix (Fin 2) (Fin 2) ℝ} {θ φ : ℝ} (h : Rd F θ φ) (hA : Aniso F)
    {T : Matrix (Fin 2) (Fin 2) ℤ} {c d : ℝ} (hT : RP (-θ) φ T c d) :
    ∃ m : ℤ, act T F = cycleForm F m ∧ (T.det = 1 ↔ Even m) := by
  have hG : Good F := ⟨⟨_, _, h⟩, hA⟩
  have hL := hT.lc0_ne (h.nz hA).1
  have hLp : 0 < |lc0 (-θ) T| := abs_pos.2 hL
  obtain ⟨k, hk⟩ : ∃ k : ℕ, 1 ≤ k * |lc0 (-θ) T| := by
    refine ⟨⌈1 / |lc0 (-θ) T|⌉₊, ?_⟩
    have := Nat.le_ceil (1 / |lc0 (-θ) T|)
    rwa [div_le_iff₀ hLp] at this
  set F' := cycleForm F (-(k : ℤ)) with hF'
  obtain ⟨⟨θ1, φ1, h1⟩, hA1⟩ := good_cycleForm hG (-(k : ℤ))
  have hG1 : Good F' := ⟨⟨_, _, h1⟩, hA1⟩
  obtain ⟨c', d', hR, hRP⟩ := rp_seq h1 hA1 k
  have hback : cycleForm F' k = F := by rw [hF', cycleForm_add hG]; simp [cycleForm_zero]
  rw [hback] at hR
  have hc' : c' = θ := hR.red.1.symm.trans h.red.1
  have hd' : d' = φ := hR.red.2.symm.trans h.red.2
  subst hc' hd'
  obtain ⟨hRP2, hmul⟩ := hRP.mul hT
  have hge := (rp_ge_one h1 hA1 k).1
  have h1le : 1 ≤ |lc0 (-θ1) (cycleBasis F' k * T)| := by
    rw [hmul, abs_mul]; nlinarith [abs_nonneg (lc0 (-θ1) (cycleBasis F' k))]
  obtain ⟨m, ε, hε, hS⟩ := classX h1 hA1 hRP2 h1le
  refine ⟨-(k : ℤ) + m, ?_, ?_⟩
  · have hspec := (cycleBasis_spec hG1 k).1
    rw [hback] at hspec
    rw [← cycleForm_add hG, ← hF', (cycleBasis_spec hG1 m).1, ← act_smul_sign (cycleBasis F' m) hε, ← hS,
      act_mul, ← hspec]
  · have hdetB : (cycleBasis F' k).det = (-1) ^ k := (cycleBasis_spec hG1 k).2
    have hdetM : (cycleBasis F' m).det = (-1) ^ m := (cycleBasis_spec hG1 m).2
    have hd : (cycleBasis F' k * T).det = (ε • cycleBasis F' m).det := by rw [hS]
    have hε2 : ε ^ 2 = 1 := by rcases hε with rfl | rfl <;> norm_num
    rw [Matrix.det_mul, hdetB, Matrix.det_smul, hdetM, Fintype.card_fin, hε2, one_mul] at hd
    exact det_even_iff hT.1 hd

/-- **Corollary to Lemma 3.6, with parity** (a sharpening of `mem_cycleForm_of_isClassicallyReduced`): let $f$ be a
classically reduced real binary form without nonzero rational zeros and let $T \in GL_2(\mathbb{Z})$ be *proper*
($\det T = 1$) such that $g(\vec{x}) = f(T\vec{x})$ is classically reduced. Then $g = f_m$ or $g(\vec{x}) = f_m(-x_1, x_0)$
with $m$ *even*. -/
theorem mem_cycleForm_proper {F : Matrix (Fin 2) (Fin 2) ℝ} (hF : F.IsSymm) (hred : IsClassicallyReduced F)
    (haniso : ∀ x : Fin 2 → ℚ, x ≠ 0 → val F (fun i => (x i : ℝ)) ≠ 0)
    (T : GL (Fin 2) ℤ) (hT1 : T.val.det = 1) (hG : IsClassicallyReduced (act T.val F)) :
    ∃ m : ℤ, Even m ∧ (act T.val F = cycleForm F m ∨ act T.val F = act !![0, -1; 1, 0] (cycleForm F m)) := by
  obtain ⟨θ, φ, h⟩ := rd_of_red hF hred
  have hA : Aniso F := haniso
  obtain ⟨θ', φ', h'⟩ := rd_of_red (isSymm_act hF _) hG
  have hdet := det_gl T
  obtain ⟨hα, hβ⟩ := h.nz hA
  have hL0 : lc0 (-θ) T.val ≠ 0 := fun h0 => by
    obtain ⟨_, _⟩ := hα _ _ h0; rcases col0_ne hdet with h1 | h1 <;> contradiction
  have hM0 : lc0 φ T.val ≠ 0 := fun h0 => by
    obtain ⟨_, _⟩ := hβ _ _ h0; rcases col0_ne hdet with h1 | h1 <;> contradiction
  have hG00 : act T.val F 0 0 = F 0 0 * (lc0 (-θ) T.val * lc0 φ T.val) := by
    have := h.val_act_lc T.val ![1, 0]
    rw [val_e0 (isSymm_act hF _)] at this
    simp at this; linear_combination this
  have hGa : act T.val F 0 0 ≠ 0 := h'.a_ne
  rcases fac_unique hGa (θ := θ') (φ := φ') (θ' := lc1 (-θ) T.val / lc0 (-θ) T.val)
      (φ' := -(lc1 φ T.val / lc0 φ T.val)) (fun x => by
        rw [← h'.val_eq, h.val_act_lc, hG00]; field_simp; ring) with ⟨e1, e2⟩ | ⟨e1, e2⟩
  · have hRP : RP (-θ) φ T.val θ' φ' :=
      ⟨hdet, h'.one_lt, h'.phi_pos, h'.phi_lt, by rw [e1]; field_simp, by rw [e2]; field_simp⟩
    obtain ⟨m, hm, hmd⟩ := h.exists_cycleForm_det hA hRP
    exact ⟨m, hmd.mp hT1, Or.inl hm⟩
  · set J : Matrix (Fin 2) (Fin 2) ℤ := !![0, 1; -1, 0] with hJ
    have hJ0 : ∀ γ, lc0 γ (T.val * J) = -lc1 γ T.val := fun γ => by rw [lc0_mul]; simp [J]
    have hJ1 : ∀ γ, lc1 γ (T.val * J) = lc0 γ T.val := fun γ => by rw [lc1_mul]; simp [J]
    have hL1 : lc1 (-θ) T.val ≠ 0 := by
      intro h0; rw [h0] at e2; simp at e2; linarith [h'.phi_pos]
    have hM1 : lc1 φ T.val ≠ 0 := by
      intro h0; rw [h0] at e1; simp at e1; linarith [h'.one_lt]
    have hJdet : J.det = 1 := by simp [J, Matrix.det_fin_two_of]
    have hRP : RP (-θ) φ (T.val * J) (1 / φ') (1 / θ') := by
      refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
      · rw [Matrix.det_mul, hJdet, mul_one]; exact hdet
      · rw [lt_div_iff₀ h'.phi_pos]; linarith [h'.phi_lt]
      · exact one_div_pos.2 (by linarith [h'.one_lt])
      · rw [div_lt_one (by linarith [h'.one_lt])]; exact h'.one_lt
      · rw [hJ0, hJ1, e2]; field_simp
      · rw [hJ0, hJ1, e1]; field_simp
    obtain ⟨m, hm, hmd⟩ := h.exists_cycleForm_det hA hRP
    refine ⟨m, hmd.mp (by rw [Matrix.det_mul, hJdet, mul_one]; exact hT1), Or.inr ?_⟩
    rw [← hm, ← act_mul, Matrix.mul_assoc]
    have : J * !![0, -1; 1, 0] = 1 := by ext i j; fin_cases i <;> fin_cases j <;> simp [J]
    rw [this, Matrix.mul_one]

/-! ### Integer triples: the cycle of a reduced form as an explicit computation -/

/-- A triple $(a, b, c) \in \mathbb{Z}^3$, standing for the classically integral form $ax^2 + 2bxy + cy^2$. -/
abbrev Tri := ℤ × ℤ × ℤ

/-- Helper: the symmetric real matrix $\begin{pmatrix} a & b \\ b & c\end{pmatrix}$ of a triple. -/
def triM (t : Tri) : Matrix (Fin 2) (Fin 2) ℝ := !![(t.1 : ℝ), t.2.1; t.2.1, t.2.2]

/-- Helper: the form `cform a b c` of a triple. -/
def cfT (t : Tri) : BinQF := cform t.1 t.2.1 t.2.2

/-- Helper: the determinant $ac - b^2$ of a triple. -/
def discT (t : Tri) : ℤ := t.1 * t.2.2 - t.2.1 ^ 2

/-- Helper: classical reducedness (3.36) for a triple: $ac < 0$, $a(a + 2b + c) > 0$, $a(a - 2b + c) < 0$. -/
def IsRedTri (t : Tri) : Prop :=
  t.1 * t.2.2 < 0 ∧ 0 < t.1 * (t.1 + 2 * t.2.1 + t.2.2) ∧ t.1 * (t.1 - 2 * t.2.1 + t.2.2) < 0

instance : DecidablePred IsRedTri := fun t => by unfold IsRedTri; infer_instance

/-- Helper: the step $f(x, y) \mapsto f(y, x + wy)$ on triples. -/
def stp (w : ℤ) (t : Tri) : Tri :=
  (t.2.2, t.2.1 + w * t.2.2, t.1 + 2 * w * t.2.1 + w ^ 2 * t.2.2)

/-- Helper: the rotation $f(x, y) \mapsto f(-y, x)$ on triples. -/
def rotT (t : Tri) : Tri := (t.2.2, -t.2.1, t.1)

/-- Helper: the mirror image $f(x, -y)$ on triples. -/
def conjT (t : Tri) : Tri := (t.1, -t.2.1, t.2.2)

/-- Helper: the substitution $f(px + qy, rx + sy)$ on triples. -/
def subT (t : Tri) (p q r s : ℤ) : Tri :=
  (t.1 * p ^ 2 + 2 * t.2.1 * p * r + t.2.2 * r ^ 2,
   t.1 * p * q + t.2.1 * (p * s + q * r) + t.2.2 * r * s,
   t.1 * q ^ 2 + 2 * t.2.1 * q * s + t.2.2 * s ^ 2)

/-- Helper: the integer $w = \lfloor 1/\phi\rfloor$ of a reduced triple, found as the first $n < 400$ for which the
step is reduced (this is the unique such integer; `cycleForm_step`). -/
def wOf (t : Tri) : ℤ :=
  ((((List.range 400).find? fun n : ℕ => decide (IsRedTri (stp (n : ℤ) t))).getD 0 : ℕ) : ℤ)

/-- Helper: the next form of the cycle of a reduced triple. -/
def nxt (t : Tri) : Tri := stp (wOf t) t

theorem triM_symm (t : Tri) : (triM t).IsSymm := isSymm_cmat t.1 t.2.1 t.2.2

theorem triM_inj {t t' : Tri} (h : triM t = triM t') : t = t' := by
  have h00 := congrFun (congrFun h 0) 0
  have h01 := congrFun (congrFun h 0) 1
  have h11 := congrFun (congrFun h 1) 1
  simp [triM] at h00 h01 h11
  exact Prod.ext (by exact_mod_cast h00) (Prod.ext (by exact_mod_cast h01) (by exact_mod_cast h11))

theorem det_triM (t : Tri) : (triM t).det = (discT t : ℝ) := by
  simp [triM, Matrix.det_fin_two_of, discT]; ring

theorem act_triM (T : Matrix (Fin 2) (Fin 2) ℤ) (t : Tri) :
    act T (triM t) = triM (subT t (T 0 0) (T 0 1) (T 1 0) (T 1 1)) := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [act, castM, triM, subT, Matrix.mul_apply, Fin.sum_univ_two] <;> ring

theorem act_rot_triM (t : Tri) : act !![0, -1; 1, 0] (triM t) = triM (rotT t) := by
  rw [act_triM]
  congr 1
  simp [subT, rotT]

theorem act_cycleMat_triM (w : ℤ) (t : Tri) : act (cycleMat w) (triM t) = triM (stp w t) := by
  rw [act_triM]
  congr 1
  refine Prod.ext ?_ (Prod.ext ?_ ?_) <;> simp [subT, stp, cycleMat] <;> ring

theorem isClassicallyReduced_triM_iff (t : Tri) : IsClassicallyReduced (triM t) ↔ IsRedTri t := by
  rw [isClassicallyReduced_iff (triM_symm t)]
  have e : ∀ x : Fin 2 → ℝ, val (triM t) x = t.1 * x 0 ^ 2 + 2 * t.2.1 * x 0 * x 1 + t.2.2 * x 1 ^ 2 := by
    intro x; rw [val_fin2 (triM_symm t)]; simp [triM]
  simp only [e]
  unfold IsRedTri
  constructor
  · rintro ⟨h1, h2, h3⟩
    simp at h1 h2 h3
    refine ⟨?_, ?_, ?_⟩
    · exact_mod_cast h1
    · have : (0 : ℝ) < t.1 * (t.1 + 2 * t.2.1 + t.2.2) := by linarith
      exact_mod_cast this
    · have : (t.1 : ℝ) * (t.1 - 2 * t.2.1 + t.2.2) < 0 := by linarith
      exact_mod_cast this
  · rintro ⟨h1, h2, h3⟩
    have h1' : (t.1 : ℝ) * t.2.2 < 0 := by exact_mod_cast h1
    have h2' : (0 : ℝ) < t.1 * (t.1 + 2 * t.2.1 + t.2.2) := by exact_mod_cast h2
    have h3' : (t.1 : ℝ) * (t.1 - 2 * t.2.1 + t.2.2) < 0 := by exact_mod_cast h3
    simp
    refine ⟨by linarith, by linarith, by linarith⟩

/-- Helper: a rational zero of $ax^2 + 2bxy + cy^2$ forces $b^2 - ac$ to be a square. -/
theorem aniso_of_nonsquare {a b c : ℤ} (h : ¬ IsSquare (b ^ 2 - a * c)) : ¬ (cform a b c).IsotropicIn ℚ := by
  rintro ⟨x, hx0, hx⟩
  rw [evalIn_cform] at hx
  apply h
  have hsq : IsSquare (((b ^ 2 - a * c : ℤ)) : ℚ) := by
    by_cases h1 : x 1 = 0
    · have hx0' : x 0 ≠ 0 := by
        intro h0; apply hx0; ext i; fin_cases i <;> simp [h0, h1]
      rw [h1] at hx
      have h2 : (a : ℚ) = 0 := by
        have : (a : ℚ) * x 0 ^ 2 = 0 := by simpa using hx
        rcases mul_eq_zero.mp this with h | h
        · exact h
        · exact absurd (pow_eq_zero_iff two_ne_zero |>.mp h) hx0'
      exact ⟨b, by push_cast; rw [h2]; ring⟩
    · refine ⟨(a * x 0 + b * x 1) / x 1, ?_⟩
      push_cast
      field_simp
      linear_combination (-(a : ℚ)) * hx
  obtain ⟨M, hM⟩ := Rat.isSquare_intCast_iff.mp hsq
  exact ⟨M, hM⟩

theorem good_triM {t : Tri} (hr : IsRedTri t) (hns : ¬ IsSquare (t.2.1 ^ 2 - t.1 * t.2.2)) : Good (triM t) :=
  ⟨rd_of_red (triM_symm t) ((isClassicallyReduced_triM_iff t).2 hr), aniso_of_cform (aniso_of_nonsquare hns)⟩

/-- Helper: one step of the cycle, computed on triples. -/
theorem cycleForm_step {t : Tri} (hG : Good (triM t)) {u : Tri} {j : ℤ}
    (hj : cycleForm (triM t) j = triM u) {w : ℤ} (hw : IsRedTri (stp w u)) :
    cycleForm (triM t) (j + 1) = triM (stp w u) := by
  have hGu : Good (triM u) := hj ▸ good_cycleForm hG j
  obtain ⟨⟨θ, φ, h⟩, hA⟩ := hGu
  have hact : act (cycleMat w) (triM u) = triM (stp w u) := act_cycleMat_triM w u
  have hred : IsClassicallyReduced (act (cycleMat w) (triM u)) := by
    rw [hact]; exact (isClassicallyReduced_triM_iff _).2 hw
  have hw' := (h.next_iff (h.phi_ne hA) w).1 hred
  rw [cycleForm_succ hG, hj]
  unfold cycleNext
  rw [h.cycleW_eq, ← hw', hact]

theorem discT_subT (t : Tri) {p q r s : ℤ} (h : p * s - q * r = 1 ∨ p * s - q * r = -1) :
    discT (subT t p q r s) = discT t := by
  have e : discT (subT t p q r s) = (p * s - q * r) ^ 2 * discT t := by
    unfold discT subT; simp only; ring
  rw [e]
  rcases h with h | h <;> rw [h] <;> ring

/-- Helper: the key combinatorial theorem. If `S` is a finite list of classically reduced triples of determinant
`d` (a non-square `-d`), closed under the cycle step `nxt`, on which `nxt^p = id` for an even `p`, and `cls` is
invariant under two steps and under the rotation, then properly equivalent members of `S` have the same `cls`. -/
theorem proper_equiv_cls {d : ℤ} (hns : ¬ IsSquare (-d)) (S : List Tri) (cls : Tri → ℕ) {p : ℕ} (hp : 0 < p)
    (hpe : Even p) (hS : ∀ t ∈ S, IsRedTri t ∧ discT t = d) (hC : ∀ t ∈ S, nxt t ∈ S)
    (hP : ∀ t ∈ S, nxt^[p] t = t) (hK : ∀ t ∈ S, cls (nxt (nxt t)) = cls t ∧ cls (rotT t) = cls t)
    {t t' : Tri} (ht : t ∈ S) (ht' : t' ∈ S)
    (hPE : ∃ T : GL (Fin 2) ℤ, T.val.det = 1 ∧
      subT t (T.val 0 0) (T.val 0 1) (T.val 1 0) (T.val 1 1) = t') : cls t' = cls t := by
  obtain ⟨hrt, hdt⟩ := hS t ht
  have hns' : ¬ IsSquare (t.2.1 ^ 2 - t.1 * t.2.2) := by
    have : t.2.1 ^ 2 - t.1 * t.2.2 = -d := by unfold discT at hdt; linarith
    rwa [this]
  have hG : Good (triM t) := good_triM hrt hns'
  have hcyc : ∀ n : ℕ, cycleForm (triM t) (n : ℤ) = triM (nxt^[n] t) ∧ nxt^[n] t ∈ S := by
    intro n
    induction n with
    | zero => exact ⟨by simp [cycleForm_zero], ht⟩
    | succ n ih =>
      obtain ⟨h1, h2⟩ := ih
      have h3 : nxt^[n + 1] t = nxt (nxt^[n] t) := Function.iterate_succ_apply' nxt n t
      have h4 : nxt^[n + 1] t ∈ S := by rw [h3]; exact hC _ h2
      refine ⟨?_, h4⟩
      have h5 : ((n + 1 : ℕ) : ℤ) = (n : ℤ) + 1 := by push_cast; ring
      rw [h5, h3]
      exact cycleForm_step hG h1 (hS _ (hC _ h2)).1
  have hp0 : cycleForm (triM t) (p : ℤ) = triM t := by rw [(hcyc p).1, hP t ht]
  have hper : Function.Periodic (cycleForm (triM t)) (p : ℤ) := by
    intro m
    rw [add_comm m (p : ℤ), ← cycleForm_add hG, hp0]
  have hpz : (0 : ℤ) < p := by exact_mod_cast hp
  have hpz' : Even (p : ℤ) := by exact_mod_cast hpe
  have hred : ∀ m : ℤ, ∃ n : ℕ, cycleForm (triM t) m = cycleForm (triM t) (n : ℤ) ∧ (Even m → Even n) := by
    intro m
    have h0 : 0 ≤ m % p := Int.emod_nonneg m hpz.ne'
    have hmod : m % p = m - p * (m / p) := by linarith [Int.mul_ediv_add_emod m p]
    refine ⟨(m % p).toNat, ?_, fun hm => ?_⟩
    · rw [Int.toNat_of_nonneg h0]
      have := (hper.int_mul (m / p)) (m % p)
      rw [← this]
      congr 1
      push_cast
      linarith [Int.mul_ediv_add_emod m p]
    · have : Even (m % (p : ℤ)) := by
        rw [hmod]
        exact (Int.even_sub.mpr ⟨fun _ => hpz'.mul_right _, fun _ => hm⟩)
      have h2 : Even (((m % p).toNat : ℕ) : ℤ) := by rw [Int.toNat_of_nonneg h0]; exact this
      exact_mod_cast h2
  have hclsEven : ∀ k : ℕ, cls (nxt^[2 * k] t) = cls t ∧ nxt^[2 * k] t ∈ S := by
    intro k
    induction k with
    | zero => exact ⟨rfl, ht⟩
    | succ k ih =>
      obtain ⟨h1, h2⟩ := ih
      have e : nxt^[2 * (k + 1)] t = nxt (nxt (nxt^[2 * k] t)) := by
        rw [show 2 * (k + 1) = 2 * k + 1 + 1 by ring, Function.iterate_succ_apply',
          Function.iterate_succ_apply']
      rw [e]
      exact ⟨by rw [(hK _ h2).1, h1], hC _ (hC _ h2)⟩
  obtain ⟨T, hdet, hsub⟩ := hPE
  have hact : act T.val (triM t) = triM t' := by rw [act_triM, hsub]
  have hred' : IsClassicallyReduced (act T.val (triM t)) := by
    rw [hact]; exact (isClassicallyReduced_triM_iff t').2 (hS t' ht').1
  obtain ⟨m, hm, hcase⟩ := mem_cycleForm_proper (triM_symm t) ((isClassicallyReduced_triM_iff t).2 hrt) hG.2
    T hdet hred'
  obtain ⟨n, hn1, hn2⟩ := hred m
  obtain ⟨k, hk⟩ := hn2 hm
  have hnk : n = 2 * k := by omega
  subst hnk
  obtain ⟨hcls, hmem⟩ := hclsEven k
  rcases hcase with h | h
  · rw [hact, hn1, (hcyc (2 * k)).1] at h
    have := triM_inj h
    rw [this, hcls]
  · rw [hact, hn1, (hcyc (2 * k)).1, act_rot_triM] at h
    have := triM_inj h
    rw [this, (hK _ hmem).2, hcls]

/-! ### Bridges to proper and improper equivalence of the forms `cform` -/

/-- Helper: proper equivalence of `cform`s is the substitution `subT` along an element of $SL_2(\mathbb{Z})$. -/
theorem properIntEquiv_cfT_iff {t t' : Tri} :
    Siegel.ProperIntEquiv (cfT t) (cfT t') ↔
      ∃ T : GL (Fin 2) ℤ, T.val.det = 1 ∧ subT t (T.val 0 0) (T.val 0 1) (T.val 1 0) (T.val 1 1) = t' := by
  constructor
  · rintro ⟨T, hd, h⟩
    refine ⟨T, hd, ?_⟩
    have h1 := h ![1, 0]
    have h2 := h ![0, 1]
    have h3 := h ![1, 1]
    simp only [cfT, eval_cform, Matrix.mulVec, dotProduct, Fin.sum_univ_two] at h1 h2 h3
    simp at h1 h2 h3
    have e : 2 * (subT t (T.val 0 0) (T.val 0 1) (T.val 1 0) (T.val 1 1)).2.1 = 2 * t'.2.1 := by
      simp only [subT]
      linear_combination h3 - h1 - h2
    refine Prod.ext ?_ (Prod.ext ?_ ?_)
    · simp only [subT]; linear_combination h1
    · omega
    · simp only [subT]; linear_combination h2
  · rintro ⟨T, hd, hs⟩
    refine ⟨T, hd, fun x => ?_⟩
    simp only [cfT, eval_cform, Matrix.mulVec, dotProduct, Fin.sum_univ_two]
    rw [← hs]
    simp only [subT]
    ring

/-- Helper: the mirror image: $f(x, -y)$ along `flipGL`. -/
theorem eval_cfT_flip (t : Tri) (x : Fin 2 → ℤ) :
    QuadForm.eval (cfT t) (flipGL.val *ᵥ x) = QuadForm.eval (cfT (conjT t)) x := by
  simp only [cfT, conjT, eval_cform, flipGL_val, Matrix.mulVec, dotProduct, Fin.sum_univ_two]
  simp

theorem conjT_conjT (t : Tri) : conjT (conjT t) = t := by simp [conjT]

/-- Helper: improper equivalence with $g$ is proper equivalence with the mirror image of $g$. -/
theorem improperIntEquiv_cfT_iff {t t' : Tri} :
    Siegel.ImproperIntEquiv (cfT t) (cfT t') ↔ Siegel.ProperIntEquiv (cfT t) (cfT (conjT t')) := by
  have hdet : (flipGL.val).det = -1 := by rw [flipGL_val]; simp [Matrix.det_fin_two_of]
  constructor
  · rintro ⟨T, hd, h⟩
    refine ⟨T * flipGL, by rw [Units.val_mul, Matrix.det_mul, hd, hdet]; norm_num, fun x => ?_⟩
    rw [Units.val_mul, ← Matrix.mulVec_mulVec, h, eval_cfT_flip]
  · rintro ⟨T, hd, h⟩
    refine ⟨T * flipGL, by rw [Units.val_mul, Matrix.det_mul, hd, hdet]; norm_num, fun x => ?_⟩
    rw [Units.val_mul, ← Matrix.mulVec_mulVec, h, eval_cfT_flip, conjT_conjT]

/-- Helper: the mirror image of a substitution: `T * flipGL` has the entries $(T_{00}, -T_{01}, T_{10}, -T_{11})$. -/
theorem subT_flip (t : Tri) (T : GL (Fin 2) ℤ) :
    subT t ((T * flipGL).val 0 0) ((T * flipGL).val 0 1) ((T * flipGL).val 1 0) ((T * flipGL).val 1 1) =
      conjT (subT t (T.val 0 0) (T.val 0 1) (T.val 1 0) (T.val 1 1)) := by
  refine Prod.ext ?_ (Prod.ext ?_ ?_) <;>
    simp [Units.val_mul, flipGL_val, Matrix.mul_apply, Fin.sum_univ_two, subT, conjT] <;> ring

/-- Helper: every triple of non-square determinant is equivalent, by some $T \in GL_2(\mathbb{Z})$, to a
classically reduced one (Lemma 3.6). -/
theorem exists_reduced_T {d : ℤ} (hd : d < 0) (hns : ¬ IsSquare (-d)) {t : Tri} (hdt : discT t = d) :
    ∃ T : GL (Fin 2) ℤ, IsRedTri (subT t (T.val 0 0) (T.val 0 1) (T.val 1 0) (T.val 1 1)) := by
  have hns' : ¬ IsSquare (t.2.1 ^ 2 - t.1 * t.2.2) := by
    have : t.2.1 ^ 2 - t.1 * t.2.2 = -d := by unfold discT at hdt; linarith
    rwa [this]
  have hdetR : (triM t).det < 0 := by
    rw [det_triM, hdt]; exact_mod_cast hd
  obtain ⟨T, hT⟩ := exists_act_isClassicallyReduced (triM_symm t) hdetR (aniso_of_cform (aniso_of_nonsquare hns'))
  refine ⟨T, ?_⟩
  rw [act_triM] at hT
  exact (isClassicallyReduced_triM_iff _).1 hT

/-- Helper: the result of the classification, for a list `S` of all admissible classically reduced triples of
determinant `d`, a list `reps` of representatives and a certificate table `tab`. -/
structure TabEntry where
  /-- The form $v$ (a classically reduced triple). -/
  v : Tri
  /-- The index of the representative. -/
  i : ℕ
  /-- The matrix entries $p, q, r, s$ of a proper substitution from the representative `i` to `v`. -/
  p : ℤ
  q : ℤ
  r : ℤ
  s : ℤ

/-- Helper: an entry of the table of improper partners: the mirror image of the representative `j` is the
representative `i` substituted by the matrix. -/
structure CEntry where
  /-- Index of the representative whose mirror image is considered. -/
  j : ℕ
  /-- Index of the representative properly equivalent to that mirror image. -/
  i : ℕ
  p : ℤ
  q : ℤ
  r : ℤ
  s : ℤ

/-- Helper: the class index of a reduced triple read from the table (first entry with that form). -/
def clsOf (tab : List TabEntry) (v : Tri) : ℕ :=
  ((tab.find? fun e => decide (e.v = v)).map fun e => e.i).getD 0

/-- Helper: a certificate table entry gives a proper equivalence. -/
theorem properIntEquiv_of_entry {reps : List Tri} {e : TabEntry}
    (h1 : e.p * e.s - e.q * e.r = 1) (h2 : subT (reps.getD e.i (0, 0, 0)) e.p e.q e.r e.s = e.v) :
    Siegel.ProperIntEquiv (cfT (reps.getD e.i (0, 0, 0))) (cfT e.v) :=
  properIntEquiv_cfT_iff.mpr ⟨mkSL e.p e.q e.r e.s h1, det_mkSL _ _ _ _ _, by rw [mkSL_val]; simpa using h2⟩

/-- **Classification certificate** (all members proved by `decide` in the applications): if `S` is the list of all
admissible classically reduced triples of non-square determinant $d$ (closed under the cycle step, of period dividing
`p`), `reps` a list of triples and `tab` a table of proper substitutions covering every member of `S` and its mirror
image, with `clsOf tab` invariant under two cycle steps and the rotation, then (1) every admissible triple of
determinant $d$ is properly equivalent to some `reps[i]` and (2) the `reps[i]` are pairwise not properly equivalent. -/
theorem classify {d : ℤ} (hd : d < 0) (hns : ¬ IsSquare (-d)) (Adm : Tri → Prop)
    (hAdm : ∀ t, Adm t → ∀ p q r s : ℤ, (p * s - q * r = 1 ∨ p * s - q * r = -1) → Adm (subT t p q r s))
    (S reps : List Tri) (tab : List TabEntry) {p : ℕ} (hp : 0 < p) (hpe : Even p)
    (hSred : ∀ t ∈ S, IsRedTri t ∧ discT t = d) (hSclosed : ∀ t ∈ S, nxt t ∈ S)
    (hSper : ∀ t ∈ S, nxt^[p] t = t) (hSall : ∀ t, Adm t → IsRedTri t → discT t = d → t ∈ S)
    (htab : ∀ e ∈ tab, e.i < reps.length ∧ e.p * e.s - e.q * e.r = 1 ∧
      subT (reps.getD e.i (0, 0, 0)) e.p e.q e.r e.s = e.v)
    (hcover : ∀ u ∈ S, (∃ e ∈ tab, e.v = u) ∧ (∃ e ∈ tab, e.v = conjT u))
    (hcls : ∀ e ∈ tab, e.v ∈ S → clsOf tab e.v = e.i)
    (hK : ∀ t ∈ S, clsOf tab (nxt (nxt t)) = clsOf tab t ∧ clsOf tab (rotT t) = clsOf tab t)
    (hrepS : ∀ i, i < reps.length → ∃ e ∈ tab, e.i = i ∧ e.v ∈ S) :
    (∀ t, Adm t → discT t = d → ∃ i, i < reps.length ∧
      Siegel.ProperIntEquiv (cfT t) (cfT (reps.getD i (0, 0, 0)))) ∧
    (∀ i j, i < reps.length → j < reps.length →
      Siegel.ProperIntEquiv (cfT (reps.getD i (0, 0, 0))) (cfT (reps.getD j (0, 0, 0))) → i = j) := by
  have hrep : ∀ e ∈ tab, Siegel.ProperIntEquiv (cfT (reps.getD e.i (0, 0, 0))) (cfT e.v) := fun e he =>
    properIntEquiv_of_entry (htab e he).2.1 (htab e he).2.2
  refine ⟨fun t hAt hdt => ?_, fun i j hi hj hij => ?_⟩
  · obtain ⟨T0, hT0⟩ := exists_reduced_T hd hns hdt
    set u := subT t (T0.val 0 0) (T0.val 0 1) (T0.val 1 0) (T0.val 1 1) with hu
    have hdet0 := det_gl T0
    have hdetu : discT u = d := by
      rw [hu, discT_subT t (by rw [← Matrix.det_fin_two]; exact hdet0), hdt]
    have hAu : Adm u := hAdm t hAt _ _ _ _ (by rw [← Matrix.det_fin_two]; exact hdet0)
    have huS : u ∈ S := hSall u hAu hT0 hdetu
    -- the form `v` properly equivalent to `t` and its table entry
    obtain ⟨v, hv, hve⟩ : ∃ v : Tri, Siegel.ProperIntEquiv (cfT t) (cfT v) ∧ ∃ e ∈ tab, e.v = v := by
      rcases hdet0 with h1 | h1
      · exact ⟨u, properIntEquiv_cfT_iff.mpr ⟨T0, h1, rfl⟩, (hcover u huS).1⟩
      · refine ⟨conjT u, properIntEquiv_cfT_iff.mpr ⟨T0 * flipGL, ?_, ?_⟩, (hcover u huS).2⟩
        · rw [Units.val_mul, Matrix.det_mul, h1, flipGL_val]; simp [Matrix.det_fin_two_of]
        · rw [subT_flip]
    obtain ⟨e, he, rfl⟩ := hve
    exact ⟨e.i, (htab e he).1, hv.trans (hrep e he).symm⟩
  · obtain ⟨ei, hei, hei1, hei2⟩ := hrepS i hi
    obtain ⟨ej, hej, hej1, hej2⟩ := hrepS j hj
    have h1 : Siegel.ProperIntEquiv (cfT ei.v) (cfT ej.v) := by
      refine Siegel.ProperIntEquiv.trans (Siegel.ProperIntEquiv.symm (hrep ei hei)) ?_
      rw [hei1]
      exact Siegel.ProperIntEquiv.trans hij (by rw [← hej1]; exact hrep ej hej)
    obtain ⟨T, hdT, hsub⟩ := properIntEquiv_cfT_iff.mp h1
    have := proper_equiv_cls hns S (clsOf tab) hp hpe hSred hSclosed hSper hK hei2 hej2 ⟨T, hdT, hsub⟩
    rw [hcls ej hej hej2, hcls ei hei hei2] at this
    omega


/-- Helper: the improper equivalences between the representatives: if the mirror image of `reps[c.j]` is properly
equivalent to `reps[c.i]` (an entry of the table `ctab`) and the representatives are pairwise properly inequivalent,
then `reps[i]` is improperly equivalent to `reps[c.j]` exactly when `i = c.i`. -/
theorem classify_improper (reps : List Tri)
    (hdist : ∀ i j, i < reps.length → j < reps.length →
      Siegel.ProperIntEquiv (cfT (reps.getD i (0, 0, 0))) (cfT (reps.getD j (0, 0, 0))) → i = j)
    (ctab : List CEntry)
    (hctab : ∀ c ∈ ctab, c.i < reps.length ∧ c.j < reps.length ∧ c.p * c.s - c.q * c.r = 1 ∧
      subT (reps.getD c.i (0, 0, 0)) c.p c.q c.r c.s = conjT (reps.getD c.j (0, 0, 0))) :
    ∀ c ∈ ctab, ∀ i, i < reps.length →
      (Siegel.ImproperIntEquiv (cfT (reps.getD i (0, 0, 0))) (cfT (reps.getD c.j (0, 0, 0))) ↔ i = c.i) := by
  intro c hc i hi
  obtain ⟨hci, hcj, h1, h2⟩ := hctab c hc
  have hcc : Siegel.ProperIntEquiv (cfT (reps.getD c.i (0, 0, 0))) (cfT (conjT (reps.getD c.j (0, 0, 0)))) :=
    properIntEquiv_cfT_iff.mpr ⟨mkSL c.p c.q c.r c.s h1, det_mkSL _ _ _ _ _, by rw [mkSL_val]; simpa using h2⟩
  rw [improperIntEquiv_cfT_iff]
  constructor
  · intro h
    exact hdist i c.i hi hci (Siegel.ProperIntEquiv.trans h (Siegel.ProperIntEquiv.symm hcc))
  · rintro rfl
    exact hcc

/-- Helper: bounds for the completeness of a list of reduced triples: every admissible reduced triple of
determinant $d = -N < 0$ has $|a|, |b| \le N$ and $c = (b^2 + d)/a$, so it is among the finitely many checked by `key`. -/
theorem mem_of_complete {d : ℤ} {N : ℕ} (hN : (N : ℤ) = -d) (Adm : Tri → Prop) (S : List Tri)
    (key : ∀ i ∈ List.range (2 * N + 1), ∀ j ∈ List.range (2 * N + 1),
      Adm ((i : ℤ) - N, (j : ℤ) - N, (((j : ℤ) - N) ^ 2 + d) / ((i : ℤ) - N)) →
      IsRedTri ((i : ℤ) - N, (j : ℤ) - N, (((j : ℤ) - N) ^ 2 + d) / ((i : ℤ) - N)) →
      discT ((i : ℤ) - N, (j : ℤ) - N, (((j : ℤ) - N) ^ 2 + d) / ((i : ℤ) - N)) = d →
      ((i : ℤ) - N, (j : ℤ) - N, (((j : ℤ) - N) ^ 2 + d) / ((i : ℤ) - N)) ∈ S)
    (t : Tri) (hA : Adm t) (hr : IsRedTri t) (hdt : discT t = d) : t ∈ S := by
  obtain ⟨a, b, c⟩ := t
  have hr' := hr
  obtain ⟨h1, h2, h3⟩ := hr
  simp only [discT] at hdt
  simp only at h1 h2 h3 hdt
  have ha0 : a ≠ 0 := by rintro rfl; simp at h1
  have hc0 : c ≠ 0 := by rintro rfl; simp at h1
  have hac : a * c = b ^ 2 + d := by linarith
  have hc : c = (b ^ 2 + d) / a := by rw [← hac]; exact (Int.mul_ediv_cancel_left c ha0).symm
  have hab : |a| ≤ N := by
    have h4 : |a| ≤ |a * c| := by
      rw [abs_mul]; exact le_mul_of_one_le_right (abs_nonneg a) (Int.one_le_abs hc0)
    have h5 : |a * c| ≤ N := by rw [abs_of_neg h1]; nlinarith [sq_nonneg b]
    linarith
  have hbb : |b| ≤ N := by
    have h4 : b ^ 2 ≤ N := by nlinarith
    have h5 := Int.le_self_sq |b|
    rw [sq_abs] at h5
    linarith
  obtain ⟨ha1, ha2⟩ := abs_le.mp hab
  obtain ⟨hb1, hb2⟩ := abs_le.mp hbb
  have hi : (((a + N).toNat : ℕ) : ℤ) - N = a := by rw [Int.toNat_of_nonneg (by linarith)]; ring
  have hj : (((b + N).toNat : ℕ) : ℤ) - N = b := by rw [Int.toNat_of_nonneg (by linarith)]; ring
  have := key (a + N).toNat (List.mem_range.mpr (by omega)) (b + N).toNat (List.mem_range.mpr (by omega))
  rw [hi, hj, ← hc] at this
  exact this hA hr' (by simpa [discT] using hdt)

