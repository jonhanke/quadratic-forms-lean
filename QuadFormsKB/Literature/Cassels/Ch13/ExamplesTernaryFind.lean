/-- Helper: the six equations $T^{\mathsf T} G\, T = G$ (with `G` the Gram matrix `ex11Gram`) in terms of the entries of `T`. -/
theorem aut11_entries {T : GL (Fin 3) ℤ} (hT : T ∈ aut3 ex11Gram) :
    T.val 0 0 ^ 2 - 3 * T.val 1 0 ^ 2 - 2 * T.val 1 0 * T.val 2 0 - 23 * T.val 2 0 ^ 2 = 1 ∧
    T.val 0 1 ^ 2 - 3 * T.val 1 1 ^ 2 - 2 * T.val 1 1 * T.val 2 1 - 23 * T.val 2 1 ^ 2 = -3 ∧
    T.val 0 2 ^ 2 - 3 * T.val 1 2 ^ 2 - 2 * T.val 1 2 * T.val 2 2 - 23 * T.val 2 2 ^ 2 = -23 ∧
    T.val 0 0 * T.val 0 1 - 3 * T.val 1 0 * T.val 1 1 - T.val 1 0 * T.val 2 1 - T.val 2 0 * T.val 1 1
      - 23 * T.val 2 0 * T.val 2 1 = 0 ∧
    T.val 0 0 * T.val 0 2 - 3 * T.val 1 0 * T.val 1 2 - T.val 1 0 * T.val 2 2 - T.val 2 0 * T.val 1 2
      - 23 * T.val 2 0 * T.val 2 2 = 0 ∧
    T.val 0 1 * T.val 0 2 - 3 * T.val 1 1 * T.val 1 2 - T.val 1 1 * T.val 2 2 - T.val 2 1 * T.val 1 2
      - 23 * T.val 2 1 * T.val 2 2 = -1 := by
  have e := fun i j => congrFun (congrFun (mem_aut3.1 hT) i) j
  have e00 := e 0 0
  have e11 := e 1 1
  have e22 := e 2 2
  have e01 := e 0 1
  have e02 := e 0 2
  have e12 := e 1 2
  simp [ex11Gram, Matrix.mul_apply, Fin.sum_univ_three] at e00 e11 e22 e01 e02 e12
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> linarith

/-- Helper: integer solutions for the lower-right $2\times2$ block of an automorph fixing $(1,0,0)$: the identity or $\operatorname{diag}(-1,-1)$. -/
theorem stab11_aux (a b c d : ℤ) (E11 : 3 * a ^ 2 + 2 * a * b + 23 * b ^ 2 = 3)
    (E22 : 3 * c ^ 2 + 2 * c * d + 23 * d ^ 2 = 23) (E12 : 3 * a * c + a * d + b * c + 23 * b * d = 1) :
    b = 0 ∧ c = 0 ∧ ((a = 1 ∧ d = 1) ∨ (a = -1 ∧ d = -1)) := by
  have hb : b = 0 := by
    by_contra hb
    have : 1 ≤ b ^ 2 := by
      have := sq_pos_of_ne_zero hb
      omega
    nlinarith [sq_nonneg (3 * a + b)]
  subst hb
  have ha : a = 1 ∨ a = -1 := by
    have : a ^ 2 = 1 := by nlinarith
    have h2 : (a - 1) * (a + 1) = 0 := by ring_nf; linarith
    rcases mul_eq_zero.1 h2 with h | h
    · left; omega
    · right; omega
  rcases ha with rfl | rfl
  · have hd : d = 1 - 3 * c := by linarith
    subst hd
    have : c * (204 * c - 136) = 0 := by nlinarith
    rcases mul_eq_zero.1 this with h | h
    · subst h; refine ⟨rfl, rfl, Or.inl ⟨rfl, by norm_num⟩⟩
    · omega
  · have hd : d = -1 - 3 * c := by linarith
    subst hd
    have : c * (204 * c + 136) = 0 := by nlinarith
    rcases mul_eq_zero.1 this with h | h
    · subst h; refine ⟨rfl, rfl, Or.inr ⟨rfl, by norm_num⟩⟩
    · omega

/-- Helper: an integral automorph of the form of Ex. 11 fixing $(1,0,0)$ is $1$ or `rot11`. -/
theorem stab11 {T : GL (Fin 3) ℤ} (hT : T ∈ aut3 ex11Gram) (hfix : T.val *ᵥ ![1, 0, 0] = ![1, 0, 0]) :
    T ∈ Subgroup.closure ex11Gens := by
  obtain ⟨E00, E11, E22, E01, E02, E12⟩ := aut11_entries hT
  have f0 := congrFun hfix 0
  have f1 := congrFun hfix 1
  have f2 := congrFun hfix 2
  simp [Matrix.mulVec, dotProduct, Fin.sum_univ_three] at f0 f1 f2
  rw [f0, f1, f2] at E01 E02
  have t01 : T.val 0 1 = 0 := by linarith
  have t02 : T.val 0 2 = 0 := by linarith
  rw [t01] at E11 E12
  rw [t02] at E22 E12
  obtain ⟨h21, h12, h⟩ := stab11_aux (T.val 1 1) (T.val 2 1) (T.val 1 2) (T.val 2 2) (by linarith) (by linarith)
    (by linarith)
  rcases h with ⟨ha, hd⟩ | ⟨ha, hd⟩
  · have : T = 1 := by
      apply Units.ext
      ext i j
      fin_cases i <;> fin_cases j <;> simp_all
    rw [this]; exact one_mem _
  · have : T = rot11 := by
      apply Units.ext
      ext i j
      fin_cases i <;> fin_cases j <;> simp_all [rot11, mk3_val]
    rw [this]; exact Subgroup.subset_closure (by simp [ex11Gens])

/-- Helper: the arithmetic behind the invariant of Ex. 11 (ii): the equations $5a - 2b + 22c = 0$ and $a^2 - 3b^2 - 2bc - 23c^2 = -3$ have no integer solution (set $b = c + 5k$, then $(6c+14k)^2 + 17k^2 = 9$). -/
theorem orbit11_aux (a b c : ℤ) (E01 : 5 * a - 2 * b + 22 * c = 0)
    (E11 : a ^ 2 - 3 * b ^ 2 - 2 * b * c - 23 * c ^ 2 = -3) : False := by
  obtain ⟨k, hk⟩ : ∃ k, b = c + 5 * k := ⟨(b - c) / 5, by omega⟩
  have ha : a = 2 * k - 4 * c := by omega
  subst hk ha
  have h1 : (6 * c + 14 * k) ^ 2 + 17 * k ^ 2 = 9 := by nlinarith
  have hk0 : k = 0 := by
    by_contra hne
    have : 1 ≤ k ^ 2 := by
      have := sq_pos_of_ne_zero hne
      omega
    nlinarith [sq_nonneg (6 * c + 14 * k)]
  subst hk0
  have h2 : 36 * c ^ 2 = 9 := by nlinarith
  generalize c ^ 2 = s at h2
  omega

/-- Helper: no integral automorph of the form of Ex. 11 carries $(1,0,0)$ to $(5,1,-1)$: the orthogonal complement of $(5,1,-1)$ does not represent $-3$ whereas that of $(1,0,0)$ does. -/
theorem no_orbit11 {T : GL (Fin 3) ℤ} (hT : T ∈ aut3 ex11Gram) (hv : T.val *ᵥ ![1, 0, 0] = ![5, 1, -1]) : False := by
  obtain ⟨E00, E11, E22, E01, E02, E12⟩ := aut11_entries hT
  have f0 := congrFun hv 0
  have f1 := congrFun hv 1
  have f2 := congrFun hv 2
  simp [Matrix.mulVec, dotProduct, Fin.sum_univ_three] at f0 f1 f2
  rw [f0, f1, f2] at E01
  exact orbit11_aux (T.val 0 1) (T.val 1 1) (T.val 2 1) (by linarith) E11

/-- Helper: no integral automorph of the form of Ex. 11 carries $(1,0,0)$ to $(5,-1,1)$. -/
theorem no_orbit11' {T : GL (Fin 3) ℤ} (hT : T ∈ aut3 ex11Gram) (hv : T.val *ᵥ ![1, 0, 0] = ![5, -1, 1]) : False := by
  obtain ⟨E00, E11, E22, E01, E02, E12⟩ := aut11_entries hT
  have f0 := congrFun hv 0
  have f1 := congrFun hv 1
  have f2 := congrFun hv 2
  simp [Matrix.mulVec, dotProduct, Fin.sum_univ_three] at f0 f1 f2
  rw [f0, f1, f2] at E01
  exact orbit11_aux (T.val 0 1) (-T.val 1 1) (-T.val 2 1) (by linarith) (by linarith)

/-- Helper: the group generated by `ex11Gens` is `aut3 ex11Gram`. -/
theorem ex11_closure : Subgroup.closure ex11Gens = aut3 ex11Gram := by
  refine closure_eq_of_descent3 ex11Gram ex11Gens ex11Gens_sub ![1, 0, 0] Term11 ?_ ?_ ?_
  · intro v hv
    apply desc11 v
    simp only [qf3_ex11Gram] at hv
    simpa [X11] using hv
  · intro T hT t ht hTt
    rcases ht with rfl | rfl | rfl
    · rfl
    · exact (no_orbit11 hT hTt).elim
    · exact (no_orbit11' hT hTt).elim
  · intro T hT hfix
    exact stab11 hT hfix

/-- Helper: every representation of $1$ is `T` applied to $(1,0,0)$ or to $(5,1,-1)$ for some `T` in `aut3 ex11Gram`, and $(1,0,0) \mapsto (5,1,-1)$ is impossible. -/
theorem ex11_orbits :
    (∀ v ∈ X11, ∃ T ∈ aut3 ex11Gram, v = T.val *ᵥ ![1, 0, 0] ∨ v = T.val *ᵥ ![5, 1, -1]) ∧
    ¬ ∃ T ∈ aut3 ex11Gram, T.val *ᵥ ![1, 0, 0] = ![5, 1, -1] := by
  refine ⟨fun v hv => ?_, fun ⟨T, hT, h⟩ => no_orbit11 hT h⟩
  obtain ⟨g, hg, ht⟩ := desc11 v hv
  have hga : g ∈ aut3 ex11Gram := ((Subgroup.closure_le _).2 ex11Gens_sub) hg
  have hv' : v = (g⁻¹).val *ᵥ (g.val *ᵥ v) := by
    rw [Matrix.mulVec_mulVec, ← Units.val_mul]; simp
  rcases ht with ht | ht | ht
  · exact ⟨g⁻¹, inv_mem hga, Or.inl (by rw [hv', ht])⟩
  · exact ⟨g⁻¹, inv_mem hga, Or.inr (by rw [hv', ht])⟩
  · refine ⟨g⁻¹ * rot11, mul_mem (inv_mem hga) rot11_mem, Or.inr ?_⟩
    have : rot11.val *ᵥ ![5, 1, -1] = ![5, -1, 1] := by
      ext i; fin_cases i <;> simp [rot11, mk3_val, mulVec3_0, mulVec3_1, mulVec3_2]
    rw [Units.val_mul, ← Matrix.mulVec_mulVec, this, ← ht, ← hv']



/-! ### Example 8 (iii) -/

/-- Helper: the bilinear pairing $x^{\mathsf T} A y$ of a symmetric integer matrix `A` is symmetric in `x`, `y`. -/
theorem dot_mulVec_symm3 {A : Matrix (Fin 3) (Fin 3) ℤ} (hA : A.IsSymm) (x y : Fin 3 → ℤ) :
    x ⬝ᵥ (A *ᵥ y) = y ⬝ᵥ (A *ᵥ x) := by
  rw [Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, hA.eq, dotProduct_comm]

/-- Helper: change of variables in a quadratic form: $(Cy)^{\mathsf T} A (Cy) = y^{\mathsf T} (C^{\mathsf T} A C) y$. -/
theorem quad_conj3 (C A : Matrix (Fin 3) (Fin 3) ℤ) (y : Fin 3 → ℤ) :
    (C *ᵥ y) ⬝ᵥ (A *ᵥ (C *ᵥ y)) = y ⬝ᵥ ((Cᵀ * A * C) *ᵥ y) := by
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec y Cᵀ, Matrix.vecMul_transpose]

/-- Helper: change of variables in a bilinear pairing: $(Cx)^{\mathsf T} A (Cy) = x^{\mathsf T} (C^{\mathsf T} A C) y$. -/
theorem bil_conj3 (C A : Matrix (Fin 3) (Fin 3) ℤ) (x y : Fin 3 → ℤ) :
    (C *ᵥ x) ⬝ᵥ (A *ᵥ (C *ᵥ y)) = x ⬝ᵥ ((Cᵀ * A * C) *ᵥ y) := by
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec x Cᵀ, Matrix.vecMul_transpose]

/-- Helper: an element `T` of `aut3 A` preserves the pairing $x^{\mathsf T} A y$ of any two integer vectors `x`, `y`. -/
theorem bil_mulVec3 {A : Matrix (Fin 3) (Fin 3) ℤ} {T : GL (Fin 3) ℤ} (hT : T ∈ aut3 A) (x y : Fin 3 → ℤ) :
    (T.val *ᵥ x) ⬝ᵥ (A *ᵥ (T.val *ᵥ y)) = x ⬝ᵥ (A *ᵥ y) := by
  rw [bil_conj3, mem_aut3.1 hT]

/-- Helper: **finiteness of the vectors of a given nonzero value in the orthogonal complement of `b`.** Let $C = (b\,|\,u\,|\,v)$ have nonzero determinant and $C^{\mathsf T} A C = \operatorname{diag}(m) \oplus \begin{pmatrix} a_0 & \beta_0 \\ \beta_0 & c_0\end{pmatrix}$ (`hP`, with $m \ne 0$), and let the binary form $a_0x^2 + 2\beta_0xy + c_0y^2$ be regular and isotropic over $\mathbb Q$. Then for every nonzero integer `e` the set of integer vectors `x` with $b^{\mathsf T}Ax = 0$ and $x^{\mathsf T}Ax = e$ is finite (the coordinates of $\det C\cdot x$ in the basis $u, v$ are integral solutions of the binary form $= (\det C)^2 e$; Cassels, Lemma 3.2 (ii) in the form `binqf_finite`). -/
theorem stab_S_finite {A : Matrix (Fin 3) (Fin 3) ℤ} (b u v : Fin 3 → ℤ) (m a0 β0 c0 : ℤ)
    (hP : (!![b 0, u 0, v 0; b 1, u 1, v 1; b 2, u 2, v 2] : Matrix (Fin 3) (Fin 3) ℤ)ᵀ * A *
      !![b 0, u 0, v 0; b 1, u 1, v 1; b 2, u 2, v 2] = !![m, 0, 0; 0, a0, β0; 0, β0, c0])
    (hm : m ≠ 0)
    (hD : (!![b 0, u 0, v 0; b 1, u 1, v 1; b 2, u 2, v 2] : Matrix (Fin 3) (Fin 3) ℤ).det ≠ 0)
    (hreg : (BinQF.mk a0 (2 * β0) c0).Nondegenerate) (hiso : (BinQF.mk a0 (2 * β0) c0).IsotropicIn ℚ)
    (e : ℤ) (he : e ≠ 0) :
    {x : Fin 3 → ℤ | b ⬝ᵥ (A *ᵥ x) = 0 ∧ x ⬝ᵥ (A *ᵥ x) = e}.Finite := by
  set C : Matrix (Fin 3) (Fin 3) ℤ := !![b 0, u 0, v 0; b 1, u 1, v 1; b 2, u 2, v 2] with hC
  set D := C.det with hDdef
  have hCx : ∀ x : Fin 3 → ℤ, (Cᵀ *ᵥ (A *ᵥ x)) 0 = b ⬝ᵥ (A *ᵥ x) := by
    intro x
    simp [hC, Matrix.mulVec, dotProduct, Fin.sum_univ_three]
  have hfin := binqf_finite (BinQF.mk a0 (2 * β0) c0) hreg hiso (D * D * e)
    (mul_ne_zero (mul_ne_zero hD hD) he)
  have hCy : ∀ x : Fin 3 → ℤ, C *ᵥ (C.adjugate *ᵥ x) = D • x := by
    intro x
    rw [Matrix.mulVec_mulVec, Matrix.mul_adjugate]
    simp [hDdef]
  have hy0 : ∀ x : Fin 3 → ℤ, b ⬝ᵥ (A *ᵥ x) = 0 → (C.adjugate *ᵥ x) 0 = 0 := by
    intro x hx1
    set y := C.adjugate *ᵥ x with hy
    have h1 : (Cᵀ *ᵥ (A *ᵥ (C *ᵥ y))) 0 = 0 := by
      rw [hy, hCy, Matrix.mulVec_smul, Matrix.mulVec_smul, Pi.smul_apply, hCx, hx1]
      simp
    have h2 : (Cᵀ *ᵥ (A *ᵥ (C *ᵥ y))) 0 = m * y 0 := by
      rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, hP]
      simp [Matrix.mulVec, dotProduct, Fin.sum_univ_three]
    rw [h2] at h1
    rcases mul_eq_zero.1 h1 with h | h
    · exact absurd h hm
    · exact h
  let ψ : (Fin 3 → ℤ) → (Fin 2 → ℤ) := fun x => ![(C.adjugate *ᵥ x) 1, (C.adjugate *ᵥ x) 2]
  refine Set.Finite.of_injOn (f := ψ) (t := {y : Fin 2 → ℤ | QuadForm.eval (BinQF.mk a0 (2 * β0) c0) y = D * D * e})
    ?_ ?_ hfin
  · rintro x ⟨hx1, hx2⟩
    set y := C.adjugate *ᵥ x with hy
    have hq : y ⬝ᵥ ((Cᵀ * A * C) *ᵥ y) = D * D * e := by
      rw [← quad_conj3, hy, hCy, Matrix.mulVec_smul, dotProduct_smul, smul_dotProduct, hx2]
      simp [smul_eq_mul]
      ring
    rw [hP] at hq
    have h0 := hy0 x hx1
    rw [← hy] at h0
    show (BinQF.mk a0 (2 * β0) c0).eval (y 1) (y 2) = D * D * e
    rw [BinQF.eval_eq]
    simp [Matrix.mulVec, dotProduct, Fin.sum_univ_three, h0] at hq
    simp
    linarith
  · intro x hx x' hx' h
    obtain ⟨hx1, hx2⟩ := hx
    obtain ⟨hx1', hx2'⟩ := hx'
    have e0 := hy0 x hx1
    have e0' := hy0 x' hx1'
    have e1 : (C.adjugate *ᵥ x) = (C.adjugate *ᵥ x') := by
      ext i
      fin_cases i
      · simpa using e0.trans e0'.symm
      · simpa [ψ] using congrFun h 0
      · simpa [ψ] using congrFun h 1
    have e2 : D • x = D • x' := by rw [← hCy x, ← hCy x', e1]
    ext i
    have := congrFun e2 i
    simp only [Pi.smul_apply, smul_eq_mul] at this
    exact mul_left_cancel₀ hD this

/-- Helper: the stabilizer of `b` in `aut3 A` is finite as soon as there are two vectors `x1`, `x2` orthogonal to `b`, with $\det(b\,|\,x_1\,|\,x_2) \ne 0$, for each of which the integer vectors orthogonal to `b` and of the same (nonzero) value form a finite set `hS1`, `hS2`: an automorph fixing `b` is determined by the images of `x1` and `x2`. -/
theorem stab_finite_of_two {A : Matrix (Fin 3) (Fin 3) ℤ} (b x1 x2 : Fin 3 → ℤ)
    (hx1 : b ⬝ᵥ (A *ᵥ x1) = 0) (hx2 : b ⬝ᵥ (A *ᵥ x2) = 0)
    (hS1 : {x : Fin 3 → ℤ | b ⬝ᵥ (A *ᵥ x) = 0 ∧ x ⬝ᵥ (A *ᵥ x) = x1 ⬝ᵥ (A *ᵥ x1)}.Finite)
    (hS2 : {x : Fin 3 → ℤ | b ⬝ᵥ (A *ᵥ x) = 0 ∧ x ⬝ᵥ (A *ᵥ x) = x2 ⬝ᵥ (A *ᵥ x2)}.Finite)
    (hdet : (!![b 0, x1 0, x2 0; b 1, x1 1, x2 1; b 2, x1 2, x2 2] : Matrix (Fin 3) (Fin 3) ℤ).det ≠ 0) :
    {T : GL (Fin 3) ℤ | T ∈ aut3 A ∧ T.val *ᵥ b = b}.Finite := by
  set C : Matrix (Fin 3) (Fin 3) ℤ := !![b 0, x1 0, x2 0; b 1, x1 1, x2 1; b 2, x1 2, x2 2] with hC
  refine Set.Finite.of_injOn (f := fun T : GL (Fin 3) ℤ => (T.val *ᵥ x1, T.val *ᵥ x2))
    (t := {x : Fin 3 → ℤ | b ⬝ᵥ (A *ᵥ x) = 0 ∧ x ⬝ᵥ (A *ᵥ x) = x1 ⬝ᵥ (A *ᵥ x1)} ×ˢ
      {x : Fin 3 → ℤ | b ⬝ᵥ (A *ᵥ x) = 0 ∧ x ⬝ᵥ (A *ᵥ x) = x2 ⬝ᵥ (A *ᵥ x2)}) ?_ ?_ (hS1.prod hS2)
  · rintro T ⟨hT, hTb⟩
    refine ⟨⟨?_, bil_mulVec3 hT x1 x1⟩, ⟨?_, bil_mulVec3 hT x2 x2⟩⟩
    · have := bil_mulVec3 hT b x1
      rw [hTb] at this
      rw [this, hx1]
    · have := bil_mulVec3 hT b x2
      rw [hTb] at this
      rw [this, hx2]
  · rintro T ⟨hT, hTb⟩ T' ⟨hT', hTb'⟩ h
    obtain ⟨h1, h2⟩ := Prod.mk.inj h
    have hcols : T.val * C = T'.val * C := by
      ext i j
      fin_cases j
      · have := congrFun (hTb.trans hTb'.symm) i
        simpa [hC, Matrix.mul_apply, Matrix.mulVec, dotProduct, Fin.sum_univ_three] using this
      · have := congrFun h1 i
        simpa [hC, Matrix.mul_apply, Matrix.mulVec, dotProduct, Fin.sum_univ_three] using this
      · have := congrFun h2 i
        simpa [hC, Matrix.mul_apply, Matrix.mulVec, dotProduct, Fin.sum_univ_three] using this
    have h3 : C.det • T.val = C.det • T'.val := by
      have e := congrArg (fun M => M * C.adjugate) hcols
      simp only [Matrix.mul_assoc, Matrix.mul_adjugate, Matrix.mul_smul, Matrix.mul_one] at e
      exact e
    apply Units.ext
    ext i j
    have := congrFun (congrFun h3 i) j
    simp only [Matrix.smul_apply, smul_eq_mul] at this
    exact mul_left_cancel₀ hdet this

/-- Helper: the binary form $a_0x^2 + 2\beta_0xy + c_0y^2$ with $\beta_0^2 - a_0c_0 = r^2$ (a square) is isotropic over $\mathbb Q$ (the vector $(r - \beta_0, a_0)$, or $(1,0)$ if $a_0 = 0$). -/
theorem binF_isotropic (a0 β0 c0 r : ℤ) (h : β0 ^ 2 - a0 * c0 = r ^ 2) :
    (BinQF.mk a0 (2 * β0) c0).IsotropicIn ℚ := by
  by_cases ha : a0 = 0
  · refine ⟨![1, 0], ?_, ?_⟩
    · intro h0; have := congrFun h0 0; simp at this
    · rw [binqf_evalIn]; simp [ha]
  · refine ⟨![(-β0 + r : ℚ), a0], ?_, ?_⟩
    · intro h0; have := congrFun h0 1; simp at this; exact ha this
    · rw [binqf_evalIn]
      have h' : (β0 : ℚ) ^ 2 - a0 * c0 = r ^ 2 := by exact_mod_cast h
      simp
      linear_combination (-(a0 : ℚ)) * h'

/-- Helper: for a regular binary form $a_0x^2 + 2\beta_0xy + c_0y^2$ there are two linearly independent integer vectors $(p_1,q_1)$, $(p_2,q_2)$ (among $(1,0), (0,1), (1,1), (1,-1)$) at which the form is nonzero. -/
theorem pair_choice3 (a0 β0 c0 : ℤ) (hnd : a0 * c0 - β0 ^ 2 ≠ 0) :
    ∃ p1 q1 p2 q2 : ℤ, p1 * q2 - p2 * q1 ≠ 0 ∧ a0 * p1 ^ 2 + 2 * β0 * p1 * q1 + c0 * q1 ^ 2 ≠ 0 ∧
      a0 * p2 ^ 2 + 2 * β0 * p2 * q2 + c0 * q2 ^ 2 ≠ 0 := by
  by_cases ha : a0 = 0 <;> by_cases hc : c0 = 0
  · have hb : β0 ≠ 0 := by
      intro h; apply hnd; rw [h, ha]; ring
    refine ⟨1, 1, 1, -1, by norm_num, ?_, ?_⟩
    · simp [ha, hc]; exact hb
    · simp [ha, hc]; exact hb
  · have hb : β0 ≠ 0 := by
      intro h; apply hnd; rw [h, ha]; ring
    by_cases h1 : 2 * β0 + c0 = 0
    · refine ⟨0, 1, 1, -1, by norm_num, ?_, ?_⟩
      · simpa [ha] using hc
      · simp [ha]; intro h; apply hc; linarith
    · refine ⟨0, 1, 1, 1, by norm_num, ?_, ?_⟩
      · simpa [ha] using hc
      · simp [ha]; intro h; apply h1; linarith
  · have hb : β0 ≠ 0 := by
      intro h; apply hnd; rw [h, hc]; ring
    by_cases h1 : a0 + 2 * β0 = 0
    · refine ⟨1, 0, 1, -1, by norm_num, ?_, ?_⟩
      · simpa [hc] using ha
      · simp [hc]; intro h; apply ha; linarith
    · refine ⟨1, 0, 1, 1, by norm_num, ?_, ?_⟩
      · simpa [hc] using ha
      · simp [hc]; intro h; apply h1; linarith
  · exact ⟨1, 0, 0, 1, by norm_num, by simpa using ha, by simpa using hc⟩

/-- Helper: Gram matrix of the vectors $b, u, v$ when $u, v$ are orthogonal to $b$: $\operatorname{diag}(b^{\mathsf T}Ab) \oplus \begin{pmatrix} u^{\mathsf T}Au & u^{\mathsf T}Av \\ u^{\mathsf T}Av & v^{\mathsf T}Av \end{pmatrix}$ (`A` symmetric). -/
theorem ex8_gram3 {A : Matrix (Fin 3) (Fin 3) ℤ} (hA : A.IsSymm) (b u v : Fin 3 → ℤ)
    (hu' : b ⬝ᵥ (A *ᵥ u) = 0) (hv' : b ⬝ᵥ (A *ᵥ v) = 0) :
    (!![b 0, u 0, v 0; b 1, u 1, v 1; b 2, u 2, v 2] : Matrix (Fin 3) (Fin 3) ℤ)ᵀ * A *
      !![b 0, u 0, v 0; b 1, u 1, v 1; b 2, u 2, v 2] =
    !![b ⬝ᵥ (A *ᵥ b), 0, 0; 0, u ⬝ᵥ (A *ᵥ u), u ⬝ᵥ (A *ᵥ v); 0, u ⬝ᵥ (A *ᵥ v), v ⬝ᵥ (A *ᵥ v)] := by
  have hPentry : ∀ i j, ((!![b 0, u 0, v 0; b 1, u 1, v 1; b 2, u 2, v 2] : Matrix (Fin 3) (Fin 3) ℤ)ᵀ * A *
      !![b 0, u 0, v 0; b 1, u 1, v 1; b 2, u 2, v 2]) i j = ![b, u, v] i ⬝ᵥ (A *ᵥ ![b, u, v] j) := by
    intro i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, dotProduct, Matrix.mulVec, Fin.sum_univ_three] <;> ring
  ext i j
  rw [hPentry]
  fin_cases i <;> fin_cases j <;> simp
  all_goals first | assumption | (rw [dot_mulVec_symm3 hA]; assumption) | exact dot_mulVec_symm3 hA _ _

/-- Helper: **Ex. 8 (iii), finite case.** Let `A` be a symmetric integer matrix with $\det A \ne 0$ and `b` an integer vector with $m = b^{\mathsf T}Ab \ne 0$. If $-m \det A$ is a perfect square, then the stabilizer of `b` in `aut3 A` is finite (the plane $b^\perp$ is then isotropic, and there are only finitely many vectors of a given nonzero value in it). -/
theorem ex8_iii_finite {A : Matrix (Fin 3) (Fin 3) ℤ} (hA : A.IsSymm) (hdet : A.det ≠ 0) (b : Fin 3 → ℤ)
    (hm : b ⬝ᵥ (A *ᵥ b) ≠ 0) (hsq : IsSquare (-(A.det * (b ⬝ᵥ (A *ᵥ b))))) :
    {T : GL (Fin 3) ℤ | T ∈ aut3 A ∧ T.val *ᵥ b = b}.Finite := by
  obtain ⟨u, v, hu, hv, hdetC⟩ := ex8_perp (A *ᵥ b) b hm
  have hu' : b ⬝ᵥ (A *ᵥ u) = 0 := by rw [dot_mulVec_symm3 hA]; exact hu
  have hv' : b ⬝ᵥ (A *ᵥ v) = 0 := by rw [dot_mulVec_symm3 hA]; exact hv
  set C : Matrix (Fin 3) (Fin 3) ℤ := !![b 0, u 0, v 0; b 1, u 1, v 1; b 2, u 2, v 2] with hC
  have hdetC' : C.det ≠ 0 := hdetC
  set m := b ⬝ᵥ (A *ᵥ b) with hmdef
  set a0 := u ⬝ᵥ (A *ᵥ u) with ha0
  set β0 := u ⬝ᵥ (A *ᵥ v) with hβ0
  set c0 := v ⬝ᵥ (A *ᵥ v) with hc0
  have hP : Cᵀ * A * C = !![m, 0, 0; 0, a0, β0; 0, β0, c0] := ex8_gram3 hA b u v hu' hv'
  have hdP : m * (a0 * c0 - β0 ^ 2) = C.det * C.det * A.det := by
    have h1 := congrArg Matrix.det hP
    rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose] at h1
    have hdP : (!![m, 0, 0; 0, a0, β0; 0, β0, c0] : Matrix (Fin 3) (Fin 3) ℤ).det = m * (a0 * c0 - β0 ^ 2) := by
      simp [Matrix.det_fin_three]; ring
    rw [hdP] at h1
    linarith
  have hnd : a0 * c0 - β0 ^ 2 ≠ 0 := by
    intro h0
    rw [h0, mul_zero] at hdP
    exact mul_ne_zero (mul_ne_zero hdetC' hdetC') hdet hdP.symm
  obtain ⟨s, hs⟩ := hsq
  have h1 : m ^ 2 * (β0 ^ 2 - a0 * c0) = (C.det * s) ^ 2 := by
    have : (C.det * s) ^ 2 = C.det * C.det * (s * s) := by ring
    rw [this, ← hs]
    linear_combination (-m) * hdP
  have h2 : m ^ 2 ∣ (C.det * s) ^ 2 := ⟨β0 ^ 2 - a0 * c0, h1.symm⟩
  obtain ⟨r, hr⟩ := (Int.pow_dvd_pow_iff two_ne_zero).1 h2
  have h4 : β0 ^ 2 - a0 * c0 = r ^ 2 := by
    apply mul_left_cancel₀ (pow_ne_zero 2 hm)
    rw [h1, hr]; ring
  have hiso : (BinQF.mk a0 (2 * β0) c0).IsotropicIn ℚ := binF_isotropic a0 β0 c0 r h4
  have hreg : (BinQF.mk a0 (2 * β0) c0).Nondegenerate := by
    unfold QuadForm.Nondegenerate
    rw [binqf_det]
    simp
    intro h
    apply hnd
    linarith
  obtain ⟨p1, q1, p2, q2, hpq, hv1, hv2⟩ := pair_choice3 a0 β0 c0 hnd
  -- the two vectors
  set x1 : Fin 3 → ℤ := C *ᵥ ![0, p1, q1] with hx1d
  set x2 : Fin 3 → ℤ := C *ᵥ ![0, p2, q2] with hx2d
  have hb : b = C *ᵥ ![1, 0, 0] := by
    ext i; fin_cases i <;> simp [hC, Matrix.mulVec, dotProduct, Fin.sum_univ_three]
  have hperp : ∀ p q : ℤ, b ⬝ᵥ (A *ᵥ (C *ᵥ ![0, p, q])) = 0 := by
    intro p q
    rw [hb, bil_conj3, hP]
    simp [Matrix.mulVec, dotProduct, Fin.sum_univ_three]
  have hval : ∀ p q : ℤ, (C *ᵥ ![0, p, q]) ⬝ᵥ (A *ᵥ (C *ᵥ ![0, p, q])) = a0 * p ^ 2 + 2 * β0 * p * q + c0 * q ^ 2 := by
    intro p q
    rw [quad_conj3, hP]
    simp [Matrix.mulVec, dotProduct, Fin.sum_univ_three]
    ring
  have hdetx : (!![b 0, x1 0, x2 0; b 1, x1 1, x2 1; b 2, x1 2, x2 2] : Matrix (Fin 3) (Fin 3) ℤ).det ≠ 0 := by
    have : (!![b 0, x1 0, x2 0; b 1, x1 1, x2 1; b 2, x1 2, x2 2] : Matrix (Fin 3) (Fin 3) ℤ) =
        C * !![1, 0, 0; 0, p1, p2; 0, q1, q2] := by
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [hx1d, hx2d, hC, Matrix.mul_apply, Matrix.mulVec, dotProduct, Fin.sum_univ_three] <;> ring
    rw [this, Matrix.det_mul]
    have : (!![1, 0, 0; 0, p1, p2; 0, q1, q2] : Matrix (Fin 3) (Fin 3) ℤ).det = p1 * q2 - p2 * q1 := by
      simp [Matrix.det_fin_three]
    rw [this]
    exact mul_ne_zero hdetC' hpq
  refine stab_finite_of_two b x1 x2 (hperp p1 q1) (hperp p2 q2) ?_ ?_ hdetx
  · apply stab_S_finite b u v m a0 β0 c0 hP hm hdetC' hreg hiso
    rw [hval]; exact hv1
  · apply stab_S_finite b u v m a0 β0 c0 hP hm hdetC' hreg hiso
    rw [hval]; exact hv2

/-- Helper: if the classically integral binary form $ax^2 + 2bxy + cy^2$ is isotropic over $\mathbb Q$, then $b^2 - ac$ is a perfect square. -/
theorem cform_iso_sq {a b c : ℤ} (h : (cform a b c).IsotropicIn ℚ) : ∃ k : ℤ, b ^ 2 - a * c = k ^ 2 := by
  obtain ⟨x, hx0, hx⟩ := h
  rw [evalIn_cform] at hx
  have hsq : IsSquare (((b ^ 2 - a * c : ℤ)) : ℚ) := by
    by_cases h1 : x 1 = 0
    · have hx0' : x 0 ≠ 0 := by
        intro h; apply hx0; ext i; fin_cases i <;> simp [h, h1]
      rw [h1] at hx
      have h2 : (a : ℚ) = 0 := by
        have : (a : ℚ) * x 0 ^ 2 = 0 := by simpa using hx
        rcases mul_eq_zero.mp this with h | h
        · exact h
        · exact absurd (pow_eq_zero_iff two_ne_zero |>.mp h) hx0'
      refine ⟨b, ?_⟩; push_cast; rw [h2]; ring
    · refine ⟨((a : ℚ) * x 0 + b * x 1) / x 1, ?_⟩
      push_cast
      field_simp
      linear_combination (-(a : ℚ)) * hx
  obtain ⟨M, hM⟩ := Rat.isSquare_intCast_iff.mp hsq
  exact ⟨M, by rw [hM]; ring⟩

/-- Helper: **Ex. 8 (iii), infinite case.** Let `A` be a symmetric integer matrix with $\det A < 0$ and `b` an integer vector with $m = b^{\mathsf T}Ab > 0$. If $-m\det A$ is not a perfect square, the stabilizer of `b` in `Siegel.Aut (Siegel.ofGram A)` is infinite. (This is the proof of the library's `ex8_infinite`, with the hypothesis ``$f$ anisotropic'' replaced by the weaker ``$-m\det A$ is not a square'': what is used is only that the binary form on $b^\perp$ is anisotropic.) -/
theorem ex8_iii_infinite {A : Matrix (Fin 3) (Fin 3) ℤ} (hA : A.IsSymm) (hdetA : A.det < 0) (b : Fin 3 → ℤ)
    (hb : 0 < b ⬝ᵥ (A *ᵥ b)) (hns : ¬ IsSquare (-(A.det * (b ⬝ᵥ (A *ᵥ b))))) :
    {T : GL (Fin 3) ℤ | T ∈ Siegel.Aut (Siegel.ofGram A) ∧ T.val *ᵥ b = b}.Infinite := by
  set m := b ⬝ᵥ (A *ᵥ b) with hm
  obtain ⟨u, v, hu, hv, hdet⟩ := ex8_perp (A *ᵥ b) b (by rw [← hm]; exact hb.ne')
  set C : Matrix (Fin 3) (Fin 3) ℤ := !![b 0, u 0, v 0; b 1, u 1, v 1; b 2, u 2, v 2] with hC
  have hcol : (fun i => C i 0) = b := by ext i; fin_cases i <;> rfl
  set a0 := u ⬝ᵥ (A *ᵥ u) with ha0
  set β0 := u ⬝ᵥ (A *ᵥ v) with hβ0
  set c0 := v ⬝ᵥ (A *ᵥ v) with hc0
  have hu' : b ⬝ᵥ (A *ᵥ u) = 0 := by rw [dot_mulVec_symm3 hA]; exact hu
  have hv' : b ⬝ᵥ (A *ᵥ v) = 0 := by rw [dot_mulVec_symm3 hA]; exact hv
  have hPentry : ∀ i j, (Cᵀ * A * C) i j = ![b, u, v] i ⬝ᵥ (A *ᵥ ![b, u, v] j) := by
    intro i j
    fin_cases i <;> fin_cases j <;>
      simp [hC, Matrix.mul_apply, dotProduct, Matrix.mulVec, Fin.sum_univ_three] <;> ring
  have hP : Cᵀ * A * C = !![m, 0, 0; 0, a0, β0; 0, β0, c0] := by
    ext i j
    rw [hPentry]
    fin_cases i <;> fin_cases j <;> simp [hm, ha0, hβ0, hc0]
    all_goals first | assumption | (rw [dot_mulVec_symm3 hA]; assumption) | exact dot_mulVec_symm3 hA _ _
  have hdP : m * (a0 * c0 - β0 ^ 2) = C.det * C.det * A.det := by
    have h1 := congrArg Matrix.det hP
    rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose] at h1
    have hdP : (!![m, 0, 0; 0, a0, β0; 0, β0, c0] : Matrix (Fin 3) (Fin 3) ℤ).det = m * (a0 * c0 - β0 ^ 2) := by
      simp [Matrix.det_fin_three]; ring
    rw [hdP] at h1
    linarith
  have hind0 : a0 * c0 - β0 ^ 2 < 0 := by
    have h1 := congrArg Matrix.det hP
    rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose] at h1
    have hdP : (!![m, 0, 0; 0, a0, β0; 0, β0, c0] : Matrix (Fin 3) (Fin 3) ℤ).det = m * (a0 * c0 - β0 ^ 2) := by
      simp [Matrix.det_fin_three]; ring
    rw [hdP] at h1
    have h2 : 0 < C.det * C.det := mul_self_pos.2 hdet
    have h3 : m * (a0 * c0 - β0 ^ 2) < 0 := by
      rw [← h1]; nlinarith [mul_neg_of_pos_of_neg h2 hdetA]
    by_contra hcon
    push Not at hcon
    nlinarith [mul_nonneg hb.le hcon]
  obtain ⟨g, a', b', c', hg, ha, hb', hc, hprim⟩ := ex8_primitive hind0
  have hind' : a' * c' - b' ^ 2 < 0 := by
    by_contra hcon
    push Not at hcon
    have : a0 * c0 - β0 ^ 2 = g * g * (a' * c' - b' ^ 2) := by rw [ha, hb', hc]; ring
    nlinarith [mul_nonneg (mul_self_nonneg g) hcon]
  have haniso' : ¬ (cform a' b' c').IsotropicIn ℚ := by
    intro hiso
    obtain ⟨k, hk⟩ := cform_iso_sq hiso
    have e1 : a0 * c0 - β0 ^ 2 = -(g * g * k ^ 2) := by
      rw [ha, hb', hc]; linear_combination (-(g * g)) * hk
    have hD0 : C.det ≠ 0 := hdet
    have e2 : -(m * (g * g * k ^ 2)) = C.det * C.det * A.det := by rw [← hdP, e1]; ring
    have hh : (m * g * k) ^ 2 = C.det ^ 2 * (-(A.det * m)) := by linear_combination (-m) * e2
    obtain ⟨t, ht⟩ := (Int.pow_dvd_pow_iff two_ne_zero).1 (⟨_, hh⟩ : C.det ^ 2 ∣ (m * g * k) ^ 2)
    apply hns
    refine ⟨t, ?_⟩
    apply mul_left_cancel₀ (pow_ne_zero 2 hD0)
    rw [← hh, ht]; ring
  obtain ⟨T₀, hT₀, hord, -⟩ := autPlus_cform_cyclic hprim hind' haniso'
  have hP' : Cᵀ * A * C = !![m, 0, 0; 0, g * a', g * b'; 0, g * b', g * c'] := by
    rw [hP, ← ha, ← hb', ← hc]
  have := ex8_construct hA C hdet m g a' b' c' hP' hT₀ hord
  rwa [hcol] at this


end QuadFormsKB.Reduction.TernaryFind

namespace QuadFormsKB.Reduction

open QuadFormsKB.Reduction.TernaryFind

/-! ### Headline statements -/

/-- Helper: for a symmetric Gram matrix `A`, the automorph group `Siegel.Aut (Siegel.ofGram A)` is `aut3 A`. -/
theorem aut_ofGram_eq {A : Matrix (Fin 3) (Fin 3) ℤ} (hA : A.IsSymm) :
    Siegel.Aut (Siegel.ofGram A) = aut3 A := by
  ext T
  exact mem_aut_ofGram hA T

/-- Helper: the value of the form `Siegel.ofGram A` at `v` is `qf3 A v` $= v^{\mathsf T} A v$. -/
theorem eval_ofGram3 {A : Matrix (Fin 3) (Fin 3) ℤ} (hA : A.IsSymm) (v : Fin 3 → ℤ) :
    (Siegel.ofGram A).eval v = qf3 A v :=
  Siegel.eval_ofGram hA v

/-- The form $f(x,y,z) = 3x^2 - 2y^2 - z^2$ of Cassels, Ch. 13, Ex. 9. -/
abbrev ex9Form : QuadForm ℤ 3 := Siegel.ofGram ex9Gram

/-- The form $f(x,y,z) = 3x^2 + 2y^2 - z^2$ of Cassels, Ch. 13, Ex. 10. -/
abbrev ex10Form : QuadForm ℤ 3 := Siegel.ofGram ex10Gram

/-- The form $f(x,y,z) = x^2 - 3y^2 - 2yz - 23z^2$ of Cassels, Ch. 13, Ex. 11. -/
abbrev ex11Form : QuadForm ℤ 3 := Siegel.ofGram ex11Gram

/-- Helper: the Gram matrix of Ex. 9 is symmetric. -/
theorem ex9Gram_symm : ex9Gram.IsSymm := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [ex9Gram]

/-- Helper: the Gram matrix of Ex. 10 is symmetric. -/
theorem ex10Gram_symm : ex10Gram.IsSymm := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [ex10Gram]

/-- Helper: the Gram matrix of Ex. 11 is symmetric. -/
theorem ex11Gram_symm : ex11Gram.IsSymm := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [ex11Gram]

/-- **Cassels, Ch. 13, Ex. 9, p. 329** (answer computed here; the book gives none): the group of integral
automorphs of $f = 3x^2 - 2y^2 - z^2$ is the group generated by the sign changes `flip3 0`, `flip3 1`, `flip3 2`
and the reflections `s9c`, `s9d` (`ex9Gens`, entries in the docstrings): all of these are integral automorphs, and they
generate `Siegel.Aut ex9Form`. -/
@[kb "cassels1978" "Ch. 13, Ex. 9, p. 329"]
theorem example_9 :
    (∀ T ∈ ex9Gens, T ∈ Siegel.Aut ex9Form) ∧ Subgroup.closure ex9Gens = Siegel.Aut ex9Form := by
  have h : Siegel.Aut ex9Form = aut3 ex9Gram := aut_ofGram_eq ex9Gram_symm
  rw [h]
  exact ⟨fun T hT => ex9Gens_sub hT, ex9_closure⟩

/-- **Cassels, Ch. 13, Ex. 10, p. 329** (answer computed here): the group of integral automorphs of
$f = 3x^2 + 2y^2 - z^2$ (anisotropic over $\mathbb Q$) is generated by the sign changes `flip3 0`, `flip3 1`,
`flip3 2` and the reflections `s10c`, `s10d` (`ex10Gens`); all of these are integral automorphs. -/
@[kb "cassels1978" "Ch. 13, Ex. 10, p. 329"]
theorem example_10 :
    (∀ T ∈ ex10Gens, T ∈ Siegel.Aut ex10Form) ∧ Subgroup.closure ex10Gens = Siegel.Aut ex10Form := by
  have h : Siegel.Aut ex10Form = aut3 ex10Gram := aut_ofGram_eq ex10Gram_symm
  rw [h]
  exact ⟨fun T hT => ex10Gens_sub hT, ex10_closure⟩

/-- **Cassels, Ch. 13, Ex. 11 (i), p. 329** (answer computed here): the group of integral automorphs of
$f = x^2 - 3y^2 - 2yz - 23z^2$ is generated by `R11_0`, ..., `R11_6`, `rot11` $= \operatorname{diag}(1,-1,-1)$ and
`neg11` $= -I$ (`ex11Gens`); all of these are integral automorphs. -/
@[kb "cassels1978" "Ch. 13, Ex. 11 (i), p. 329"]
theorem example_11_i :
    (∀ T ∈ ex11Gens, T ∈ Siegel.Aut ex11Form) ∧ Subgroup.closure ex11Gens = Siegel.Aut ex11Form := by
  have h : Siegel.Aut ex11Form = aut3 ex11Gram := aut_ofGram_eq ex11Gram_symm
  rw [h]
  exact ⟨fun T hT => ex11Gens_sub hT, ex11_closure⟩

/-- **Cassels, Ch. 13, Ex. 11 (ii), pp. 329--330** (computed here): there are precisely two orbits of integral
representations of $1$ by $f = x^2 - 3y^2 - 2yz - 23z^2$ under its group of integral automorphs, with representatives
$(1,0,0)$ and $(5,1,-1)$: both represent $1$, every representation of $1$ is carried to one of them by an integral
automorph, and no integral automorph carries $(1,0,0)$ to $(5,1,-1)$. -/
@[kb "cassels1978" "Ch. 13, Ex. 11 (ii), pp. 329-330"]
theorem example_11_ii :
    ex11Form.eval ![1, 0, 0] = 1 ∧ ex11Form.eval ![5, 1, -1] = 1 ∧
    (∀ v : Fin 3 → ℤ, ex11Form.eval v = 1 →
      (∃ T ∈ Siegel.Aut ex11Form, T.val *ᵥ ![1, 0, 0] = v) ∨ (∃ T ∈ Siegel.Aut ex11Form, T.val *ᵥ ![5, 1, -1] = v)) ∧
    ¬ ∃ T ∈ Siegel.Aut ex11Form, T.val *ᵥ ![1, 0, 0] = ![5, 1, -1] := by
  have h : Siegel.Aut ex11Form = aut3 ex11Gram := aut_ofGram_eq ex11Gram_symm
  obtain ⟨h1, h2⟩ := ex11_orbits
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [eval_ofGram3 ex11Gram_symm, qf3_ex11Gram]; norm_num
  · rw [eval_ofGram3 ex11Gram_symm, qf3_ex11Gram]; norm_num
  · intro v hv
    rw [eval_ofGram3 ex11Gram_symm, qf3_ex11Gram] at hv
    obtain ⟨T, hT, hTv⟩ := h1 v hv
    rw [h]
    rcases hTv with hTv | hTv
    · exact Or.inl ⟨T, hT, hTv.symm⟩
    · exact Or.inr ⟨T, hT, hTv.symm⟩
  · rw [h]; exact h2

/-- **Cassels, Ch. 13, Examples, Ex. 8 (iii), p. 329** (precise version, proved here): let $f$ be a classically
integral ternary form with symmetric Gram matrix `A`, real equivalent to $X^2 + Y^2 - Z^2$ (`L`, `hL`, `hF` as in
`example_8`), let $\vec b \in \mathbb Z^3$ with $f(\vec b) = \vec b^{\mathsf T} A \vec b > 0$ and let $G$ consist of the
integral automorphs $T$ of $f$ with $T\vec b = \vec b$. Then $G$ is infinite if and only if
$-f(\vec b)\det A$ is not a perfect square. (If $f$ is anisotropic this number is never a square; if $f$ is isotropic
it is a square exactly for those $\vec b$ whose orthogonal plane is isotropic, and then $G$ is finite.) -/
@[kb "cassels1978" "Ch. 13, Examples, Ex. 8 (iii), p. 329"]
theorem example_8_iii {A : Matrix (Fin 3) (Fin 3) ℤ} (hA : A.IsSymm) {L : Matrix (Fin 3) (Fin 3) ℝ}
    (hL : IsUnit L.det) (hF : A.map (Int.cast : ℤ → ℝ) = Lᵀ * diagonal ![1, 1, -1] * L) (b : Fin 3 → ℤ)
    (hb : 0 < b ⬝ᵥ (A *ᵥ b)) :
    {T : GL (Fin 3) ℤ | T ∈ Siegel.Aut (Siegel.ofGram A) ∧ T.val *ᵥ b = b}.Infinite ↔
      ¬ IsSquare (-(A.det * (b ⬝ᵥ (A *ᵥ b)))) := by
  have hdetA : A.det < 0 := by
    have hmap : (A.map (Int.cast : ℤ → ℝ)).det = ((A.det : ℤ) : ℝ) := by
      have := RingHom.map_det (Int.castRingHom ℝ) A
      simpa [RingHom.mapMatrix_apply] using this.symm
    have h1 : ((A.det : ℤ) : ℝ) = -(L.det * L.det) := by
      have := congrArg Matrix.det hF
      rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose,
        show (diagonal ![1, 1, -1] : Matrix (Fin 3) (Fin 3) ℝ).det = -1 by
          simp [Matrix.det_diagonal, Fin.prod_univ_three], hmap] at this
      rw [this]; ring
    have h2 : 0 < L.det * L.det := mul_self_pos.2 hL.ne_zero
    have : ((A.det : ℤ) : ℝ) < 0 := by rw [h1]; linarith
    exact_mod_cast this
  constructor
  · intro hinf hsq
    apply hinf
    have hset : {T : GL (Fin 3) ℤ | T ∈ Siegel.Aut (Siegel.ofGram A) ∧ T.val *ᵥ b = b} =
        {T : GL (Fin 3) ℤ | T ∈ aut3 A ∧ T.val *ᵥ b = b} := by
      rw [aut_ofGram_eq hA]
    rw [hset]
    exact ex8_iii_finite hA hdetA.ne b hb.ne' hsq
  · intro hns
    exact ex8_iii_infinite hA hdetA b hb hns

/-- **Ex. 8 (iii), examples** (the isotropic form $f = x^2 + y^2 - z^2$, which has the zero $(1,0,1)$): the group of
integral automorphs fixing $\vec b = (1,1,0)$ ($f(\vec b) = 2$, $-f(\vec b)\det = 2$, not a square) is infinite, and the
group fixing $\vec b = (1,0,0)$ ($f(\vec b) = 1$, $-f(\vec b)\det = 1$, a square) is finite. So for an isotropic form both
cases of `example_8_iii` occur. -/
theorem example_8_iii_isotropic :
    (Siegel.ofGram (!![1, 0, 0; 0, 1, 0; 0, 0, -1] : Matrix (Fin 3) (Fin 3) ℤ)).IsotropicIn ℚ ∧
    {T : GL (Fin 3) ℤ | T ∈ Siegel.Aut (Siegel.ofGram (!![1, 0, 0; 0, 1, 0; 0, 0, -1] : Matrix (Fin 3) (Fin 3) ℤ)) ∧
      T.val *ᵥ ![1, 1, 0] = ![1, 1, 0]}.Infinite ∧
    {T : GL (Fin 3) ℤ | T ∈ Siegel.Aut (Siegel.ofGram (!![1, 0, 0; 0, 1, 0; 0, 0, -1] : Matrix (Fin 3) (Fin 3) ℤ)) ∧
      T.val *ᵥ ![1, 0, 0] = ![1, 0, 0]}.Finite := by
  have hA : (!![1, 0, 0; 0, 1, 0; 0, 0, -1] : Matrix (Fin 3) (Fin 3) ℤ).IsSymm := by
    ext i j; fin_cases i <;> fin_cases j <;> simp
  have hF : (!![1, 0, 0; 0, 1, 0; 0, 0, -1] : Matrix (Fin 3) (Fin 3) ℤ).map (Int.cast : ℤ → ℝ) =
      (1 : Matrix (Fin 3) (Fin 3) ℝ)ᵀ * diagonal ![1, 1, -1] * 1 := by
    ext i j; fin_cases i <;> fin_cases j <;> simp [Matrix.diagonal_apply]
  have hdet : (!![1, 0, 0; 0, 1, 0; 0, 0, -1] : Matrix (Fin 3) (Fin 3) ℤ).det = -1 := by
    simp [Matrix.det_fin_three]
  have hL : IsUnit (1 : Matrix (Fin 3) (Fin 3) ℝ).det := by rw [Matrix.det_one]; exact isUnit_one
  have hm1 : (![1, 1, 0] : Fin 3 → ℤ) ⬝ᵥ ((!![1, 0, 0; 0, 1, 0; 0, 0, -1] : Matrix (Fin 3) (Fin 3) ℤ) *ᵥ ![1, 1, 0]) = 2 := by
    simp [dotProduct, Matrix.mulVec, Fin.sum_univ_three]
  have hm2 : (![1, 0, 0] : Fin 3 → ℤ) ⬝ᵥ ((!![1, 0, 0; 0, 1, 0; 0, 0, -1] : Matrix (Fin 3) (Fin 3) ℤ) *ᵥ ![1, 0, 0]) = 1 := by
    simp [dotProduct, Matrix.mulVec, Fin.sum_univ_three]
  have h2 : ¬ IsSquare (2 : ℤ) := by
    rintro ⟨r, hr⟩
    have h1 : |r| ≤ 2 := by nlinarith [abs_nonneg r, sq_abs r]
    have h2 := abs_le.1 h1
    obtain ⟨h3, h4⟩ := h2
    interval_cases r <;> omega
  refine ⟨?_, ?_, ?_⟩
  · refine ⟨![1, 0, 1], ?_, ?_⟩
    · intro h0; have := congrFun h0 0; simp at this
    · rw [ex8_evalIn hA]
      simp [dotProduct, Matrix.mulVec, Fin.sum_univ_three]
  · refine (example_8_iii hA hL hF ![1, 1, 0] (by rw [hm1]; norm_num)).2 ?_
    rw [hdet, hm1]
    intro hsq
    apply h2
    convert hsq using 1
    norm_num
  · by_contra hfin
    refine (example_8_iii hA hL hF ![1, 0, 0] (by rw [hm2]; norm_num)).1 hfin ?_
    rw [hdet, hm2]
    exact ⟨1, by norm_num⟩

end QuadFormsKB.Reduction
