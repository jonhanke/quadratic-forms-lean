  · exact R11_0_mem
  · exact R11_1_mem
  · exact R11_2_mem
  · exact R11_3_mem
  · exact R11_4_mem
  · exact R11_5_mem
  · exact R11_6_mem
  · exact rot11_mem
  · exact neg11_mem

/-- Helper: the integer vectors `v` with $f(v) = 1$, where $f = x^2 - 3y^2 - 2yz - 23z^2$ (the integral representations of $1$). -/
def X11 : Set (Fin 3 → ℤ) := {v | v 0 ^ 2 - 3 * v 1 ^ 2 - 2 * v 1 * v 2 - 23 * v 2 ^ 2 = 1}

/-- Helper: the three terminal vectors $(1,0,0)$, $(5,1,-1)$, $(5,-1,1)$ of the descent for Ex. 11. -/
def Term11 : Set (Fin 3 → ℤ) := {![1, 0, 0], ![5, 1, -1], ![5, -1, 1]}

/-- Helper: if $u, v$ both have $f = 1$ and positive first coordinate, then the polar form $f(u,v) = u_0v_0 - (3u_1v_1 + u_1v_2 + u_2v_1 + 23u_2v_2)$ is positive (Cauchy--Schwarz for the positive definite form $3y^2+2yz+23z^2$ of determinant $68$). -/
theorem pos11 (u0 u1 u2 v0 v1 v2 : ℤ) (hu : u0 ^ 2 - 3 * u1 ^ 2 - 2 * u1 * u2 - 23 * u2 ^ 2 = 1) (hu0 : 0 < u0)
    (hv : v0 ^ 2 - 3 * v1 ^ 2 - 2 * v1 * v2 - 23 * v2 ^ 2 = 1) (hv0 : 0 < v0) :
    0 < u0 * v0 - (3 * u1 * v1 + u1 * v2 + u2 * v1 + 23 * u2 * v2) := by
  by_contra hc
  push_neg at hc
  have h1 : (u0 * v0) ^ 2 ≤ (3 * u1 * v1 + u1 * v2 + u2 * v1 + 23 * u2 * v2) ^ 2 :=
    pow_le_pow_left₀ (by positivity) (by linarith) 2
  have h2 : (3 * u1 ^ 2 + 2 * u1 * u2 + 23 * u2 ^ 2) * (3 * v1 ^ 2 + 2 * v1 * v2 + 23 * v2 ^ 2) -
      (3 * u1 * v1 + u1 * v2 + u2 * v1 + 23 * u2 * v2) ^ 2 = 68 * (u1 * v2 - u2 * v1) ^ 2 := by ring
  have h3 : 3 * u1 ^ 2 + 2 * u1 * u2 + 23 * u2 ^ 2 = u0 ^ 2 - 1 := by linarith
  have h4 : 3 * v1 ^ 2 + 2 * v1 * v2 + 23 * v2 ^ 2 = v0 ^ 2 - 1 := by linarith
  rw [h3, h4] at h2
  nlinarith [sq_nonneg (u1 * v2 - u2 * v1), sq_nonneg u0, sq_nonneg v0]

/-- Helper: **one reduction step for Ex. 11.** Let `g` be an automorph in the subgroup `H` whose first row is $(u_0, -(3u_1+u_2), -(u_1+23u_2))$ for a vector $u = (u_0,u_1,u_2)$ with $f(u) = 1$ and $u_0 > 0$. If `v` is a representation of $1$ with $v_0 > 0$ and $f(u,v) < v_0$, then $gv$ is again a representation of $1$ with strictly smaller first coordinate in absolute value. -/
theorem red11 (H : Subgroup (GL (Fin 3) ℤ)) (g : GL (Fin 3) ℤ) (hg : g ∈ H) (hga : g ∈ aut3 ex11Gram)
    (u0 u1 u2 : ℤ) (hr0 : g.val 0 0 = u0) (hr1 : g.val 0 1 = -(3 * u1 + u2)) (hr2 : g.val 0 2 = -(u1 + 23 * u2))
    (hu : u0 ^ 2 - 3 * u1 ^ 2 - 2 * u1 * u2 - 23 * u2 ^ 2 = 1) (hu0 : 0 < u0)
    (v : Fin 3 → ℤ) (hv : v ∈ X11) (hpos : 0 < v 0)
    (hlt : (u0 - 1) * v 0 + (-(3 * u1 + u2)) * v 1 + (-(u1 + 23 * u2)) * v 2 < 0) :
    ∃ g ∈ H, g.val *ᵥ v ∈ X11 ∧ ((g.val *ᵥ v) 0).natAbs < (v 0).natAbs := by
  refine ⟨g, hg, ?_, ?_⟩
  · have := qf3_mulVec hga v
    rw [qf3_ex11Gram, qf3_ex11Gram] at this
    have hv' : v 0 ^ 2 - 3 * v 1 ^ 2 - 2 * v 1 * v 2 - 23 * v 2 ^ 2 = 1 := hv
    show _ = _
    linarith
  · have e : (g.val *ᵥ v) 0 = u0 * v 0 + (-(3 * u1 + u2)) * v 1 + (-(u1 + 23 * u2)) * v 2 := by
      rw [mulVec3_0, hr0, hr1, hr2]
    have hv' : v 0 ^ 2 - 3 * v 1 ^ 2 - 2 * v 1 * v 2 - 23 * v 2 ^ 2 = 1 := hv
    have hp := pos11 u0 u1 u2 (v 0) (v 1) (v 2) hu hu0 hv' hpos
    have hp' : 0 < (g.val *ᵥ v) 0 := by rw [e]; linarith
    have hl' : (g.val *ᵥ v) 0 < v 0 := by rw [e]; linarith
    omega

/-- Helper: for $z \ge 0$, the fourteen linear inequalities $f(u,v) \ge v_0$ (for the fourteen facets $u$) imply $100\,(3y^2+2yz+23z^2) \le 99x^2$ (a sector-by-sector Bernstein certificate on the upper half of the Dirichlet polygon). -/
theorem bnd11u (x y z : ℤ) (hz : 0 ≤ z) (h0 : 0 ≤ 1 * x + (-3) * y + (-1) * z) (h1 : 0 ≤ 1 * x + (3) * y + (1) * z) (h2 : 0 ≤ 23 * x + (-5) * y + (-115) * z) (h3 : 0 ≤ 23 * x + (5) * y + (115) * z) (h4 : 0 ≤ 48 * x + (20) * y + (-220) * z) (h5 : 0 ≤ 48 * x + (-20) * y + (220) * z) (h6 : 0 ≤ 51 * x + (-51) * y + (-221) * z) (h7 : 0 ≤ 51 * x + (51) * y + (221) * z) (h8 : 0 ≤ 51 * x + (-51) * y + (187) * z) (h9 : 0 ≤ 51 * x + (51) * y + (-187) * z) (h10 : 0 ≤ 75 * x + (45) * y + (355) * z) (h11 : 0 ≤ 75 * x + (-45) * y + (-355) * z) (h12 : 0 ≤ 75 * x + (-45) * y + (325) * z) (h13 : 0 ≤ 75 * x + (45) * y + (-325) * z) :
    100 * (3 * y ^ 2 + 2 * y * z + 23 * z ^ 2) ≤ 99 * x ^ 2 := by
  rcases le_or_gt 0 ((3) * y + (-5) * z) with c0 | c0
  · linarith [mul_nonneg hz hz, mul_nonneg hz c0, mul_nonneg hz h0, mul_nonneg c0 c0, mul_nonneg c0 h0, mul_nonneg h0 h0]
  have d0 : 0 ≤ -(((3) * y + (-5) * z)) := by linarith
  rcases le_or_gt 0 ((3) * y + (-3) * z) with c1 | c1
  · linarith [mul_nonneg d0 d0, mul_nonneg d0 c1, mul_nonneg d0 h6, mul_nonneg c1 c1, mul_nonneg c1 h6, mul_nonneg h6 h6]
  have d1 : 0 ≤ -(((3) * y + (-3) * z)) := by linarith
  rcases le_or_gt 0 ((33) * y + (-23) * z) with c2 | c2
  · linarith [mul_nonneg d1 d1, mul_nonneg d1 c2, mul_nonneg d1 h11, mul_nonneg c2 c2, mul_nonneg c2 h11, mul_nonneg h11 h11]
  have d2 : 0 ≤ -(((33) * y + (-23) * z)) := by linarith
  rcases le_or_gt 0 ((35) * y + (23) * z) with c3 | c3
  · linarith [mul_nonneg d2 d2, mul_nonneg d2 c3, mul_nonneg d2 h2, mul_nonneg c3 c3, mul_nonneg c3 h2, mul_nonneg h2 h2]
  have d3 : 0 ≤ -(((35) * y + (23) * z)) := by linarith
  rcases le_or_gt 0 ((33) * y + (45) * z) with c4 | c4
  · linarith [mul_nonneg d3 d3, mul_nonneg d3 c4, mul_nonneg d3 h4, mul_nonneg c4 c4, mul_nonneg c4 h4, mul_nonneg h4 h4]
  have d4 : 0 ≤ -(((33) * y + (45) * z)) := by linarith
  rcases le_or_gt 0 ((3) * y + (5) * z) with c5 | c5
  · linarith [mul_nonneg d4 d4, mul_nonneg d4 c5, mul_nonneg d4 h13, mul_nonneg c5 c5, mul_nonneg c5 h13, mul_nonneg h13 h13]
  have d5 : 0 ≤ -(((3) * y + (5) * z)) := by linarith
  rcases le_or_gt 0 ((3) * y + (7) * z) with c6 | c6
  · linarith [mul_nonneg d5 d5, mul_nonneg d5 c6, mul_nonneg d5 h9, mul_nonneg c6 c6, mul_nonneg c6 h9, mul_nonneg h9 h9]
  have d6 : 0 ≤ -(((3) * y + (7) * z)) := by linarith
  linarith [mul_nonneg d6 d6, mul_nonneg d6 hz, mul_nonneg d6 h1, mul_nonneg hz hz, mul_nonneg hz h1, mul_nonneg h1 h1]

/-- Helper: the same bound without the assumption $z \ge 0$ (apply `bnd11u` to $(-y,-z)$; the facets come in pairs $u$, $(u_0,-u_1,-u_2)$). -/
theorem bnd11 (x y z : ℤ) (h0 : 0 ≤ 1 * x + (-3) * y + (-1) * z) (h1 : 0 ≤ 1 * x + (3) * y + (1) * z) (h2 : 0 ≤ 23 * x + (-5) * y + (-115) * z) (h3 : 0 ≤ 23 * x + (5) * y + (115) * z) (h4 : 0 ≤ 48 * x + (20) * y + (-220) * z) (h5 : 0 ≤ 48 * x + (-20) * y + (220) * z) (h6 : 0 ≤ 51 * x + (-51) * y + (-221) * z) (h7 : 0 ≤ 51 * x + (51) * y + (221) * z) (h8 : 0 ≤ 51 * x + (-51) * y + (187) * z) (h9 : 0 ≤ 51 * x + (51) * y + (-187) * z) (h10 : 0 ≤ 75 * x + (45) * y + (355) * z) (h11 : 0 ≤ 75 * x + (-45) * y + (-355) * z) (h12 : 0 ≤ 75 * x + (-45) * y + (325) * z) (h13 : 0 ≤ 75 * x + (45) * y + (-325) * z) :
    100 * (3 * y ^ 2 + 2 * y * z + 23 * z ^ 2) ≤ 99 * x ^ 2 := by
  rcases le_or_gt 0 z with hz | hz
  · exact bnd11u x y z hz h0 h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 h12 h13
  · have := bnd11u x (-y) (-z) (by linarith) (by linarith [h1]) (by linarith [h0]) (by linarith [h3]) (by linarith [h2]) (by linarith [h5]) (by linarith [h4]) (by linarith [h7]) (by linarith [h6]) (by linarith [h9]) (by linarith [h8]) (by linarith [h11]) (by linarith [h10]) (by linarith [h13]) (by linarith [h12])
    nlinarith [this]

/-- Helper: a representation $(x,y,z)$ of $1$ with $x > 0$ satisfying the fourteen inequalities of `bnd11u` is $(1,0,0)$, $(5,1,-1)$ or $(5,-1,1)$ (the bound gives $x \le 10$, hence $|y| \le 3$, $|z| \le 2$, and a finite check). -/
theorem term11 (x y z : ℤ) (hx : 0 < x) (hf : x ^ 2 - 3 * y ^ 2 - 2 * y * z - 23 * z ^ 2 = 1) (h0 : 0 ≤ 1 * x + (-3) * y + (-1) * z) (h1 : 0 ≤ 1 * x + (3) * y + (1) * z) (h2 : 0 ≤ 23 * x + (-5) * y + (-115) * z) (h3 : 0 ≤ 23 * x + (5) * y + (115) * z) (h4 : 0 ≤ 48 * x + (20) * y + (-220) * z) (h5 : 0 ≤ 48 * x + (-20) * y + (220) * z) (h6 : 0 ≤ 51 * x + (-51) * y + (-221) * z) (h7 : 0 ≤ 51 * x + (51) * y + (221) * z) (h8 : 0 ≤ 51 * x + (-51) * y + (187) * z) (h9 : 0 ≤ 51 * x + (51) * y + (-187) * z) (h10 : 0 ≤ 75 * x + (45) * y + (355) * z) (h11 : 0 ≤ 75 * x + (-45) * y + (-355) * z) (h12 : 0 ≤ 75 * x + (-45) * y + (325) * z) (h13 : 0 ≤ 75 * x + (45) * y + (-325) * z) :
    (x = 1 ∧ y = 0 ∧ z = 0) ∨ (x = 5 ∧ y = 1 ∧ z = -1) ∨ (x = 5 ∧ y = -1 ∧ z = 1) := by
  have hb := bnd11 x y z h0 h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 h12 h13
  have hx10 : x ≤ 10 := by nlinarith
  have hy3 : -3 ≤ y ∧ y ≤ 3 := by omega
  have hz2 : -2 ≤ z ∧ z ≤ 2 := by omega
  obtain ⟨hy1, hy2⟩ := hy3
  obtain ⟨hz1, hz2⟩ := hz2
  interval_cases x <;> interval_cases y <;> interval_cases z <;> first | omega | (exfalso; omega) | simp_all

/-- Helper: **descent for Ex. 11.** Every representation of $1$ by $f$ is carried by an element of the group generated by `ex11Gens` to $(1,0,0)$, $(5,1,-1)$ or $(5,-1,1)$. -/
theorem desc11 : ∀ v ∈ X11, ∃ g ∈ Subgroup.closure ex11Gens, g.val *ᵥ v ∈ Term11 := by
  apply descent3 (Subgroup.closure ex11Gens) X11 Term11 (fun v => 0 < v 0) (fun v => (v 0).natAbs)
  · intro v hv
    have hv' : v 0 ^ 2 - 3 * v 1 ^ 2 - 2 * v 1 * v 2 - 23 * v 2 ^ 2 = 1 := hv
    have hQ : 0 ≤ 3 * v 1 ^ 2 + 2 * v 1 * v 2 + 23 * v 2 ^ 2 := by nlinarith [sq_nonneg (v 1 + v 2), sq_nonneg (v 1), sq_nonneg (v 2)]
    have hne : v 0 ≠ 0 := by
      intro h0
      rw [h0] at hv'
      nlinarith
    rcases lt_or_gt_of_ne hne with hneg | hpos
    · refine ⟨neg11, Subgroup.subset_closure (by simp [ex11Gens]), ?_, ?_, ?_⟩
      · have : neg11.val *ᵥ v = fun i => - v i := by
          ext i; fin_cases i <;> simp [neg11, mk3_val, mulVec3_0, mulVec3_1, mulVec3_2]
        rw [this]
        show (-v 0) ^ 2 - 3 * (-v 1) ^ 2 - 2 * (-v 1) * (-v 2) - 23 * (-v 2) ^ 2 = 1
        linarith
      · have : neg11.val *ᵥ v = fun i => - v i := by
          ext i; fin_cases i <;> simp [neg11, mk3_val, mulVec3_0, mulVec3_1, mulVec3_2]
        rw [this]; simp; omega
      · have : neg11.val *ᵥ v = fun i => - v i := by
          ext i; fin_cases i <;> simp [neg11, mk3_val, mulVec3_0, mulVec3_1, mulVec3_2]
        rw [this]; simp
    · exact ⟨1, one_mem _, by simpa using hv, by simpa using hpos, by simp⟩
  · intro v hv hN
    have hv' : v 0 ^ 2 - 3 * v 1 ^ 2 - 2 * v 1 * v 2 - 23 * v 2 ^ 2 = 1 := hv
    rcases lt_or_ge (((2:ℤ) - 1) * v 0 + (-(3 * 1 + 0)) * v 1 + (-(1 + 23 * 0)) * v 2) 0 with hk0 | hk0
    · right
      have hk := hk0
      exact red11 _ R11_0 (Subgroup.subset_closure (by simp [ex11Gens])) R11_0_mem 2 (1) (0) (by simp [R11_0, mk3_val]) (by simp [R11_0, mk3_val]) (by simp [R11_0, mk3_val]) (by norm_num) (by norm_num) v hv hN hk
    rcases lt_or_ge (((2:ℤ) - 1) * v 0 + (-(3 * -1 + 0)) * v 1 + (-(-1 + 23 * 0)) * v 2) 0 with hk1 | hk1
    · right
      have hk := hk1
      exact red11 _ (R11_0 * rot11) (Subgroup.mul_mem _ (Subgroup.subset_closure (by simp [ex11Gens])) (Subgroup.subset_closure (by simp [ex11Gens]))) (mul_mem R11_0_mem rot11_mem) 2 (-1) (0) (by simp [Units.val_mul, R11_0, rot11, mk3_val, Matrix.mul_apply, Fin.sum_univ_three]) (by simp [Units.val_mul, R11_0, rot11, mk3_val, Matrix.mul_apply, Fin.sum_univ_three]) (by simp [Units.val_mul, R11_0, rot11, mk3_val, Matrix.mul_apply, Fin.sum_univ_three]) (by norm_num) (by norm_num) v hv hN hk
    rcases lt_or_ge (((24:ℤ) - 1) * v 0 + (-(3 * 0 + 5)) * v 1 + (-(0 + 23 * 5)) * v 2) 0 with hk2 | hk2
    · right
