/-
# Cassels, Appendix A, Example 1: the lattice $\Gamma_{16}$

**Layer:** $V = \mathbb Q^{n}$ with Cassels' form $\phi(\sum x_ie_i) = \sum x_i^2$ (`sumSqForm n`), lattices as
$\mathcal O_{\mathbb Q}$-submodules (= additive subgroups, `addSubgroupOrderIso`); integral forms `QuadForm ℤ n`.

**Defines** (Cassels, App. A, Ex. 1, pp. 366–367; his $n = 16$, printed "$n = 8!$" in the machine-read text)
* `casselsGamma n`: the lattice $\Gamma$ generated by $\Lambda = \{\sum u_ie_i : u_i \in \mathbb Z,
  \sum u_i \equiv 0 \bmod 2\}$ and $b = \tfrac12\sum e_i$ (`omearaEHalf n`); for $4 \mid n$ it is O'Meara's lattice
  $E$ of §106E (`casselsGamma_eq_omearaE`);
* `gamma16Basis`: the basis $b_0 = 2e_0$, $b_j = e_j - e_{j-1}$ ($1 \le j \le 14$), $b_{15} = \tfrac12\sum e_i$ of
  $\Gamma_{16}$ (columns of an upper triangular matrix with diagonal $2, 1, \dots, 1, \tfrac12$);
* `gamma16`: the integral form $Q(c) = \tfrac12\phi(\sum c_jb_j)$ in 16 variables, i.e.
  $Q(x) = 2x_0^2 + \sum_{i=1}^{14}x_i^2 + 2x_{15}^2 - 2x_0x_1 + x_0x_{15} - \sum_{i=1}^{13}x_ix_{i+1}$; its Hessian is
  the Gram matrix $(b_i \cdot b_j)$, which is Cassels' matrix of $\phi$ on $\Gamma$.

**Proves** Ex. 1 (i)–(iii): $\det(b_i\cdot b_j) = 1$ (`gamma16_det`), $\phi(\Gamma_{16}) \subseteq 2\mathbb Z$
(`casselsGamma_even`, any $8 \mid n$), $\Gamma_{16}$ indecomposable (`casselsGamma_indecomposable`, from O'Meara
§106E). Part (iv) is in `Gamma16Genus.lean`.

*Convention.* Cassels' "the quadratic form given by $\phi$ on $\Gamma$ has determinant 1" is the determinant of the
classically integral matrix $(\phi(b_i, b_j))$; here $\phi(x, y) = x \cdot y$, so this is the Hessian of the
integer-valued form $Q = \tfrac12\phi$ (the library's convention, as for `Siegel.e8`).
-/
import QuadFormsKB.Literature.Cassels.AppA.Sec2

open NumberField Matrix

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.Lattices

/-- Cassels' $\Lambda$ (App. A, Ex. 1): the points $\sum u_ie_i$ with $u_i \in \mathbb Z$ and
$\sum u_i \equiv 0 \pmod 2$. -/
def casselsEvenSet (n : ℕ) : Set (Fin n → ℚ) :=
  {x | ∃ u : Fin n → ℤ, Even (∑ i, u i) ∧ x = fun i => (u i : ℚ)}

/-- **Cassels' lattice $\Gamma$** (App. A, Ex. 1, p. 367): the lattice generated by $\Lambda$ (`casselsEvenSet n`) and
$b = \tfrac12\sum e_i$ (`omearaEHalf n`). Cassels takes $n = 16$: $\Gamma_{16}$. -/
@[kb "cassels1978" "App. A, Ex. 1, pp. 366–367 (Γ = Γ₁₆ generated by Λ and b = ½Σe_i)"]
def casselsGamma (n : ℕ) : Submodule (𝓞 ℚ) (Fin n → ℚ) :=
  Submodule.span (𝓞 ℚ) (casselsEvenSet n ∪ {omearaEHalf n})

/-- Integrality dichotomy: all coordinates are integers or all are integers plus one half. -/
private theorem gam_dichotomy {n : ℕ} (hn : 0 < n) {A : Fin n → ℚ} (h1 : ∀ i, ∃ m : ℤ, 2 * A i = m)
    (h2 : ∀ i j, ∃ m : ℤ, A i - A j = m) :
    (∀ i, ∃ b : ℤ, A i = b) ∨ (∀ i, ∃ b : ℤ, A i = b + 1 / 2) := by
  obtain ⟨m0, hm0⟩ := h1 ⟨0, hn⟩
  rcases Int.even_or_odd' m0 with ⟨c, rfl | rfl⟩
  · left
    intro i
    obtain ⟨d, hd⟩ := h2 i ⟨0, hn⟩
    exact ⟨d + c, by push_cast at hm0 ⊢; linarith⟩
  · right
    intro i
    obtain ⟨d, hd⟩ := h2 i ⟨0, hn⟩
    exact ⟨d + c, by push_cast at hm0 ⊢; linarith⟩

/-- Integer vectors with even sum lie in `omearaE n` (for `4 ∣ n`). -/
private theorem gam_int_mem {n : ℕ} (h4 : 4 ∣ n) (hn : 0 < n) (u : Fin n → ℤ) (hu : Even (∑ i, u i)) :
    (fun i => (u i : ℚ)) ∈ omearaE n := by
  rw [omeara106_11 h4 hn]
  obtain ⟨m, hm⟩ := hu
  refine ⟨fun i => ⟨2 * u i, by push_cast; ring⟩, fun i j => ⟨u i - u j, by push_cast; ring⟩, m, ?_⟩
  have : ((∑ i, u i : ℤ) : ℚ) = ((m + m : ℤ) : ℚ) := by rw [hm]
  push_cast at this
  rw [this]; ring

/-- **Cassels' $\Gamma_n$ is O'Meara's $E$** (O'Meara 1973, §106E) for $4 \mid n$, $n > 0$. -/
theorem casselsGamma_eq_omearaE {n : ℕ} (h4 : 4 ∣ n) (hn : 0 < n) : casselsGamma n = omearaE n := by
  obtain ⟨k, hk⟩ := h4
  have h4 : 4 ∣ n := ⟨k, hk⟩
  have hy : omearaEHalf n ∈ omearaE n := Submodule.subset_span (Or.inl (Or.inl rfl))
  apply le_antisymm
  · refine Submodule.span_le.mpr ?_
    rintro x (⟨u, hu, rfl⟩ | hx)
    · exact gam_int_mem h4 hn u hu
    · rw [Set.mem_singleton_iff.mp hx]; exact hy
  · intro x hx
    obtain ⟨h1, h2, m, hm⟩ := (omeara106_11 h4 hn x).mp hx
    have hy' : omearaEHalf n ∈ casselsGamma n := Submodule.subset_span (Or.inr rfl)
    rcases gam_dichotomy hn h1 h2 with h | h
    · choose a ha using h
      have hxa : x = fun i => (a i : ℚ) := funext ha
      rw [hxa]
      refine Submodule.subset_span (Or.inl ⟨a, ⟨m, ?_⟩, rfl⟩)
      have : (∑ i, (a i : ℚ)) = 2 * m := by rw [← hm, hxa]
      have : ((∑ i, a i : ℤ) : ℚ) = ((m + m : ℤ) : ℚ) := by push_cast at this ⊢; linarith
      exact_mod_cast this
    · choose a ha using h
      have e : x = (fun i => (a i : ℚ)) + omearaEHalf n := by
        funext i; simp [ha i, omearaEHalf]
      rw [e]
      refine add_mem (Submodule.subset_span (Or.inl ⟨a, ⟨m - k, ?_⟩, rfl⟩)) hy'
      have : ∑ i, x i = ∑ i, ((a i : ℚ) + 1 / 2) := Finset.sum_congr rfl fun i _ => ha i
      rw [Finset.sum_add_distrib, hm] at this
      simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul] at this
      subst hk
      have : ((∑ i, a i : ℤ) : ℚ) = ((m - k + (m - k) : ℤ) : ℚ) := by push_cast at this ⊢; linarith
      exact_mod_cast this

/-- **The values of $\phi$ on $\Gamma$ are even** (Cassels, App. A, Ex. 1 (ii), p. 367), for $8 \mid n$:
$\sum x_i^2 \in 2\mathbb Z$ for $x \in \Gamma_n$. -/
@[kb "cassels1978" "App. A, Ex. 1 (ii), p. 367 (φ takes values in 2ℤ on Γ; here 8 ∣ n)"]
theorem casselsGamma_even {n : ℕ} (h8 : 8 ∣ n) {x : Fin n → ℚ} (hx : x ∈ casselsGamma n) :
    ∃ m : ℤ, (sumSqForm n).eval x = 2 * m := by
  have hev : (sumSqForm n).eval x = ∑ i, x i ^ 2 := by
    rw [sumSqForm, QuadForm.eval, QuadForm.evalIn_diag]; simp
  rw [hev]
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · exact ⟨0, by simp⟩
  obtain ⟨k, hk⟩ := h8
  have h4 : 4 ∣ n := ⟨2 * k, by omega⟩
  rw [casselsGamma_eq_omearaE h4 hn] at hx
  obtain ⟨h1, h2, m, hm⟩ := (omeara106_11 h4 hn x).mp hx
  have hd : ∀ a : ℤ, (2 : ℤ) ∣ a ^ 2 + a := fun a => by
    obtain ⟨c, hc⟩ := Int.even_mul_succ_self a
    exact ⟨c, by nlinarith [hc]⟩
  rcases gam_dichotomy hn h1 h2 with h | h
  · choose a ha using h
    have hs : ∑ i, a i = 2 * m := by
      have : ((∑ i, a i : ℤ) : ℚ) = 2 * m := by
        push_cast; rw [← hm]; exact Finset.sum_congr rfl fun i _ => (ha i).symm
      exact_mod_cast this
    have hd2 : (2 : ℤ) ∣ ∑ i, (a i ^ 2 + a i) := Finset.dvd_sum fun i _ => hd (a i)
    rw [Finset.sum_add_distrib, hs] at hd2
    obtain ⟨c, hc⟩ := hd2
    refine ⟨c - m, ?_⟩
    have : ((∑ i, a i ^ 2 : ℤ) : ℚ) = ((2 * c - 2 * m : ℤ) : ℚ) := by congr 1; omega
    push_cast at this ⊢
    have e : ∑ i, x i ^ 2 = ∑ i, ((a i : ℤ) : ℚ) ^ 2 := Finset.sum_congr rfl fun i _ => by rw [ha i]
    rw [e, this]; ring
  · choose a ha using h
    have hd2 : (2 : ℤ) ∣ ∑ i, (a i ^ 2 + a i) := Finset.dvd_sum fun i _ => hd (a i)
    obtain ⟨c, hc⟩ := hd2
    refine ⟨c + k, ?_⟩
    have : ∀ i, x i ^ 2 = ((a i ^ 2 + a i : ℤ) : ℚ) + 1 / 4 := fun i => by
      rw [ha i]; push_cast; ring
    simp only [this, Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      nsmul_eq_mul]
    rw [← Int.cast_sum, hc, hk]
    push_cast
    ring

/-- **$\Gamma$ is indecomposable** (Cassels, App. A, Ex. 1 (iii), p. 367), for $n \in \{8, 12, 16, \dots\}$; Cassels'
case is $n = 16$. -/
@[kb "cassels1978" "App. A, Ex. 1 (iii), p. 367 (Γ is indecomposable; here 4 ∣ n, n ≥ 8)"]
theorem casselsGamma_indecomposable {n : ℕ} (h4 : 4 ∣ n) (h8 : 8 ≤ n) :
    IsIndecomposable (sumSqForm n) (casselsGamma n) := by
  rw [casselsGamma_eq_omearaE h4 (by omega)]
  exact omearaE_indecomposable h4 h8

/-! ### A basis of $\Gamma_{16}$ and the form $\gamma_{16}$ -/

/-- **A basis of $\Gamma_{16}$** (columns): $b_0 = 2e_0$, $b_j = e_j - e_{j-1}$ for $1 \le j \le 14$,
$b_{15} = \tfrac12\sum_i e_i$. Entry $(i, j)$ is the $i$-th coordinate of $b_j$. -/
def gamma16Basis : Matrix (Fin 16) (Fin 16) ℚ := Matrix.of fun i j =>
  if j.val = 15 then 1 / 2
  else if j.val = 0 then (if i.val = 0 then 2 else 0)
  else if i = j then 1
  else if i.val + 1 = j.val then -1
  else 0

/-- The $j$-th basis vector $b_j$ (the $j$-th column of `gamma16Basis`). -/
def gamma16Vec (j : Fin 16) : Fin 16 → ℚ := fun i => gamma16Basis i j

/-- $\det(b_0, \dots, b_{15}) = 1$: the basis matrix is upper triangular with diagonal $2, 1, \dots, 1, \tfrac12$. -/
theorem det_gamma16Basis : gamma16Basis.det = 1 := by
  have hup : gamma16Basis.BlockTriangular id := by
    intro i j hij
    simp only [id] at hij
    have h2 : j.val < i.val := hij
    simp only [gamma16Basis, Matrix.of_apply]
    split_ifs <;> first | omega | rfl
  rw [Matrix.det_of_isUpperTriangular hup]
  simp [Fin.prod_univ_succ, gamma16Basis]

/-- **The $b_j$ form a basis of $\Gamma_{16}$:** they span `casselsGamma 16` (they are linearly independent since
$\det = 1$, `det_gamma16Basis`). -/
@[kb "cassels1978" "App. A, Ex. 1, p. 367 (a basis of Γ₁₆)"]
theorem span_gamma16Vec : Submodule.span (𝓞 ℚ) (Set.range gamma16Vec) = casselsGamma 16 := by
  have h4 : 4 ∣ 16 := by norm_num
  have hn : 0 < 16 := by norm_num
  have hhalf : gamma16Vec 15 = omearaEHalf 16 := by
    funext i; simp [gamma16Vec, gamma16Basis, omearaEHalf]
  apply le_antisymm
  · refine Submodule.span_le.mpr ?_
    rintro _ ⟨j, rfl⟩
    rw [casselsGamma_eq_omearaE h4 hn]
    by_cases hj : j = 15
    · subst hj
      rw [hhalf]
      exact Submodule.subset_span (Or.inl (Or.inl rfl))
    · have hj15 : j.val ≠ 15 := fun h => hj (Fin.ext h)
      have key : ∀ u : Fin 16 → ℤ, Even (∑ i, u i) →
          (∀ i, gamma16Vec j i = (u i : ℚ)) → gamma16Vec j ∈ omearaE 16 := by
        intro u hu hv
        have : gamma16Vec j = fun i => (u i : ℚ) := funext hv
        rw [this]; exact gam_int_mem h4 hn u hu
      refine key (fun i => if j.val = 0 then (if i.val = 0 then 2 else 0) else if i = j then 1
        else if i.val + 1 = j.val then -1 else 0) ?_ ?_
      · revert hj15
        fin_cases j <;> intro hj15 <;> first | exact absurd rfl hj15 | decide +kernel
      · intro i
        simp only [gamma16Vec, gamma16Basis, Matrix.of_apply, hj15, ite_false]
        split_ifs <;> simp
  · refine Submodule.span_le.mpr ?_
    set S := Submodule.span (𝓞 ℚ) (Set.range gamma16Vec) with hS
    have hb : ∀ j, gamma16Vec j ∈ S := fun j => Submodule.subset_span ⟨j, rfl⟩
    have h15 : (Pi.single (⟨15, by norm_num⟩ : Fin 16) (1 : ℚ) - Pi.single (⟨14, by norm_num⟩ : Fin 16) (1 : ℚ)
        : Fin 16 → ℚ) = (2 : ℤ) • gamma16Vec 15 - (8 : ℤ) • gamma16Vec 0 - (15 : ℤ) • gamma16Vec 1
          - (14 : ℤ) • gamma16Vec 2 - (13 : ℤ) • gamma16Vec 3 - (12 : ℤ) • gamma16Vec 4
          - (11 : ℤ) • gamma16Vec 5 - (10 : ℤ) • gamma16Vec 6 - (9 : ℤ) • gamma16Vec 7
          - (8 : ℤ) • gamma16Vec 8 - (7 : ℤ) • gamma16Vec 9 - (6 : ℤ) • gamma16Vec 10
          - (5 : ℤ) • gamma16Vec 11 - (4 : ℤ) • gamma16Vec 12 - (3 : ℤ) • gamma16Vec 13
          - (2 : ℤ) • gamma16Vec 14 := by
      ext i
      fin_cases i <;> simp [gamma16Vec, gamma16Basis] <;> norm_num
    have hd : ∀ t : ℕ, ∀ ht : t + 1 < 16,
        (Pi.single (⟨t + 1, ht⟩ : Fin 16) (1 : ℚ) - Pi.single (⟨t, by omega⟩ : Fin 16) (1 : ℚ)
          : Fin 16 → ℚ) ∈ S := by
      intro t ht
      by_cases h : t = 14
      · subst h
        rw [show (Pi.single (⟨14 + 1, ht⟩ : Fin 16) (1 : ℚ) : Fin 16 → ℚ) = Pi.single (⟨15, by norm_num⟩ : Fin 16) 1
          from rfl]
        rw [h15]
        repeat' refine sub_mem ?_ (zsmul_mem (hb _) _)
        exact zsmul_mem (hb _) _
      · have : gamma16Vec ⟨t + 1, ht⟩ = (Pi.single (⟨t + 1, ht⟩ : Fin 16) (1 : ℚ) -
            Pi.single (⟨t, by omega⟩ : Fin 16) (1 : ℚ) : Fin 16 → ℚ) := by
          have h1 : t + 1 ≠ 15 := fun h' => h (by omega)
          funext i
          simp only [gamma16Vec, gamma16Basis, Matrix.of_apply, Pi.sub_apply, Pi.single_apply, h1, ite_false]
          split_ifs <;> simp_all [Fin.ext_iff]
        rw [← this]; exact hb _
    have hd0 : ∀ t : ℕ, ∀ i : Fin 16, i.val = t →
        (Pi.single i (1 : ℚ) - Pi.single (⟨0, hn⟩ : Fin 16) (1 : ℚ) : Fin 16 → ℚ) ∈ S := by
      intro t
      induction t with
      | zero =>
        intro i hi
        obtain rfl : i = ⟨0, hn⟩ := Fin.ext hi
        simp
      | succ t ih =>
        intro i hi
        have hj : t < 16 := by omega
        have h1 := ih ⟨t, hj⟩ rfl
        have g := hd t (by omega)
        have e : (Pi.single i (1 : ℚ) : Fin 16 → ℚ) = Pi.single (⟨t + 1, by omega⟩ : Fin 16) 1 := by
          congr 1; exact Fin.ext hi
        have g' : (Pi.single i (1 : ℚ) - Pi.single (⟨t, hj⟩ : Fin 16) (1 : ℚ) : Fin 16 → ℚ) ∈ S := by
          rw [e]; exact g
        have := add_mem g' h1
        convert this using 1
        abel
    have hx0 : (Pi.single (⟨0, hn⟩ : Fin 16) (2 : ℚ) : Fin 16 → ℚ) ∈ S := by
      have : (Pi.single (⟨0, hn⟩ : Fin 16) (2 : ℚ) : Fin 16 → ℚ) = gamma16Vec 0 := by
        funext i
        simp only [gamma16Vec, gamma16Basis, Matrix.of_apply, Pi.single_apply]
        by_cases h : i = ⟨0, hn⟩
        · subst h; simp
        · have h' : i.val ≠ 0 := fun h' => h (Fin.ext h')
          have h2 : i ≠ 0 := fun h0 => h h0
          simp [h2, h']
      rw [this]; exact hb _
    rintro x (⟨a, ⟨m, hm⟩, rfl⟩ | hx)
    · have hsum : (∑ i, (a i : ℚ)) = 2 * m := by
        have : ((∑ i, a i : ℤ) : ℚ) = ((m + m : ℤ) : ℚ) := by rw [hm]
        push_cast at this ⊢; linarith
      have e : (fun i => (a i : ℚ)) = ∑ i, a i • (Pi.single i (1 : ℚ) - Pi.single (⟨0, hn⟩ : Fin 16) (1 : ℚ)
          : Fin 16 → ℚ) + m • (Pi.single (⟨0, hn⟩ : Fin 16) (2 : ℚ) : Fin 16 → ℚ) := by
        ext k
        simp only [Pi.add_apply, Finset.sum_apply, Pi.smul_apply, Pi.sub_apply]
        simp only [zsmul_eq_mul, mul_sub, Finset.sum_sub_distrib, Pi.single_apply]
        rw [← Finset.sum_mul, hsum]
        simp only [mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_univ, ite_true]
        by_cases hk : k = (0 : Fin 16) <;> (simp [hk]; try ring)
      show (fun i => (a i : ℚ)) ∈ S
      rw [e]
      exact add_mem (Submodule.sum_mem _ fun i _ => zsmul_mem (hd0 _ i rfl) _) (zsmul_mem hx0 _)
    · rw [Set.mem_singleton_iff.mp hx, ← hhalf]; exact hb _

/-- **The form $\gamma_{16}$:** $Q(x) = 2x_0^2 + \sum_{i=1}^{14}x_i^2 + 2x_{15}^2 - 2x_0x_1 + x_0x_{15} -
\sum_{i=1}^{13}x_ix_{i+1}$, i.e. $Q(c) = \tfrac12\phi(\sum_j c_jb_j)$ (`two_mul_gamma16_eval`). Its Hessian is the Gram
matrix $(b_i \cdot b_j)$. -/
@[kb "cassels1978" "App. A, Ex. 1, p. 367 (the form given by φ on Γ₁₆, halved: an integer-valued form)"]
def gamma16 : QuadForm ℤ 16 := QuadForm.ofUpper fun i j =>
  if i = j then (if i.val = 0 ∨ i.val = 15 then 2 else 1)
  else if i.val = 0 ∧ j.val = 1 then -2
  else if i.val = 0 ∧ j.val = 15 then 1
  else if 1 ≤ i.val ∧ j.val = i.val + 1 ∧ j.val ≤ 14 then -1
  else 0

/-- **$\gamma_{16}$ explicitly**, over any commutative ring $S$ (the form `gamma16` mapped to $S$). -/
theorem gamma16_map_eval {S : Type*} [CommRing S] (x : Fin 16 → S) :
    (gamma16.map (Int.castRingHom S)).eval x =
      2 * x 0 ^ 2 + x 1 ^ 2 + x 2 ^ 2 + x 3 ^ 2 + x 4 ^ 2 + x 5 ^ 2 + x 6 ^ 2 + x 7 ^ 2 + x 8 ^ 2 + x 9 ^ 2
        + x 10 ^ 2 + x 11 ^ 2 + x 12 ^ 2 + x 13 ^ 2 + x 14 ^ 2 + 2 * x 15 ^ 2
        - 2 * x 0 * x 1 + x 0 * x 15
        - x 1 * x 2 - x 2 * x 3 - x 3 * x 4 - x 4 * x 5 - x 5 * x 6 - x 6 * x 7 - x 7 * x 8 - x 8 * x 9
        - x 9 * x 10 - x 10 * x 11 - x 11 * x 12 - x 12 * x 13 - x 13 * x 14 := by
  simp only [QuadForm.eval, QuadForm.evalIn, QuadForm.map, gamma16, QuadForm.ofUpper, Matrix.map_apply,
    Matrix.of_apply, Algebra.algebraMap_self, RingHom.id_apply, Fin.sum_univ_succ, Fin.sum_univ_zero]
  simp
  ring

/-- **$\gamma_{16}$ is $\tfrac12\phi$ in the basis $b_j$:** $2Q(c) = \phi(\sum_j c_jb_j)$ for $c \in \mathbb Z^{16}$. -/
theorem two_mul_gamma16_eval (c : Fin 16 → ℤ) :
    2 * ((gamma16.eval c : ℤ) : ℚ) = (sumSqForm 16).eval (gamma16Basis *ᵥ fun i => (c i : ℚ)) := by
  have h : ((gamma16.eval c : ℤ) : ℚ) =
      (gamma16.map (Int.castRingHom ℚ)).eval (fun i => (c i : ℚ)) := by
    simp [QuadForm.eval, QuadForm.evalIn, QuadForm.map]
  rw [h, gamma16_map_eval]
  have hev : (sumSqForm 16).eval (gamma16Basis *ᵥ fun i => (c i : ℚ)) =
      ∑ i, (gamma16Basis *ᵥ fun i => (c i : ℚ)) i ^ 2 := by
    rw [sumSqForm, QuadForm.eval, QuadForm.evalIn_diag]; simp
  rw [hev]
  simp [Matrix.mulVec, dotProduct, Fin.sum_univ_succ, gamma16Basis]
  ring

set_option maxHeartbeats 4000000 in
/-- **The Hessian of $\gamma_{16}$ is the Gram matrix** $(b_i \cdot b_j) = B^{\mathsf T}B$ of the basis. -/
theorem gamma16_hessian_map : gamma16.hessian.map (Int.castRingHom ℚ) = gamma16Basisᵀ * gamma16Basis := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [gamma16, QuadForm.ofUpper, QuadForm.hessian, gamma16Basis, Matrix.mul_apply, Fin.sum_univ_succ] <;>
    norm_num

/-- **Cassels, App. A, Ex. 1 (i)** (p. 367): the quadratic form given by $\phi$ on $\Gamma_{16}$ has determinant $1$:
the Gram matrix $(b_i \cdot b_j)$, which is the Hessian of $\gamma_{16}$, has determinant $1$. -/
@[kb "cassels1978" "App. A, Ex. 1 (i), p. 367 (the form given by φ on Γ has determinant 1)"]
theorem gamma16_det : gamma16.hessian.det = 1 := by
  have h2 : (Int.castRingHom ℚ) gamma16.hessian.det = (gamma16.hessian.map (Int.castRingHom ℚ)).det :=
    RingHom.map_det _ _
  rw [gamma16_hessian_map, Matrix.det_mul, Matrix.det_transpose, det_gamma16Basis] at h2
  have h' : ((gamma16.hessian.det : ℤ) : ℚ) = 1 := by simpa using h2
  exact_mod_cast h'

end QuadFormsKB.Lattices
