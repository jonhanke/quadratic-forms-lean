      fin_cases i <;> simp <;> omega)
    (by
      intro x y h
      have h0 := congrFun h 0
      have h1 := congrFun h 1
      have h2 := congrFun h 2
      have h3 := congrFun h 3
      simp at h0 h1 h2 h3
      funext i
      fin_cases i <;> simp <;> omega)
    (by intro x; simp [ex21f1, phi21, QuadForm.evalIn, QuadForm.ofUpper, Fin.sum_univ_four]; ring) a

