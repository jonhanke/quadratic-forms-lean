      refine ⟨![((-2) * t 0 + (2) * t 1 + (-2) * t 2 + (-2) * t 3) / 4, ((2) * t 2 + (2) * t 3) / 4, ((2) * t 0 + (2) * t 1 + (-2) * t 2 + (2) * t 3) / 4, ((-2) * t 0 + (-2) * t 1) / 4], ?_⟩
      funext i
