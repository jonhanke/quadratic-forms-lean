/-
# Cassels, Chapter 9, Examples 16--19: generators of integral automorph groups

Formalization of J. W. S. Cassels, *Rational Quadratic Forms* (1978), Ch. 9, *Examples*, Ex. 16 (i)--(vii), 17, 18 and
19 (i), pp. 166--167.

## Conventions

* Indices are 0-based: the book's $(x,y,z)$ of Ex. 16 are $(x_0,x_1,x_2)$; Ex. 17, 18 use $x_0,\dots,x_m$ as in the book.
* "Integral automorphs" are `Siegel.Aut Q`, the subgroup of $\mathrm{GL}_n(\mathbb Z)$ of $g$ with $Q(gx) = Q(x)$; "generated by"
  is an equality of subgroups with `Subgroup.closure S`. Proper automorphs are `Siegel.AutPlus`.
* Symmetries are the library's `reflectionBy` (Ch. 11, Sec. 9) for statements over $\mathbb R$; for integer matrices the
  reflection $x \mapsto x - (\varphi\cdot x)v$ is `reflGL`, with $\varphi = B(\cdot, v)/Q(v)$ integral.
* Ex. 18 is written with $m = k + 3$.

## What is formalized

* Ex. 16 (i)--(vii) in full: `ex16_i`, ..., `ex16_vii`. The set of generators for $O^+_{\mathbb Z}(f)$ in (vii) is `Gens6`.
* Ex. 17 (i) (with a correction, see below) and (ii): `ex17_i`, `ex17_ii`.
* Ex. 18 for $3 \le m \le 9$: `ex18`.
* Ex. 19 (i): `ex19_i`.

## Elsewhere

* Ex. 19 (ii), the group of integral automorphs of $x_0^2 + x_1^2 - x_2^2 - x_3^2$, is proved in `Ch9/Ex19ii.lean`
  (`Cassels.Ch9Ex19ii.ex19_ii`: a descent on $a_0^2 + a_1^2$ for $a = g e_0$, with one extra generator for the vector
  $(1,1,1,0)$, and Ex. 19 (i) for the stabilizer of $e_0$).

## What is reconstructed

The book states the exercises with hints only. The method (descent on a height with a special symmetry, then a finite
stabilizer) follows the hints; the generators of Ex. 16 (vii) and Ex. 19 (i) and all proofs are new. The stabilizer of
$e_0$ (`stab_le`) is shared by all parts.

## Errata and updates

* Ex. 17 (i), p. 167: *Erratum.* As printed (no condition beyond $f(a) > 0$, $a_j \ge 0$) the claim $|b_0| < |a_0|$ is false
  ($a = (1,0,0,0)$, $a = (10,1,0,0)$). It holds when $a_0 < a_1+a_2+a_3$, which is automatic for integral $a \ne e_0$ with
  $f(a) = 1$ (what (ii) needs).
* Ex. 18 hint, p. 167: *Update.* "$b_0 < b_1+b_2+b_3 < 2b_0$" should read "$\le 2b_0$" (equality for $b_0 = 1$).
-/
import QuadFormsKB.Literature.Cassels.Ch13.ExamplesTernaryFind
import QuadFormsKB.Literature.Cassels.Ch11Sec9
import QuadFormsKB.Literature.Cassels.Ch9Sec1

open Matrix QuadFormsKB QuadFormsKB.Reduction.TernaryFind

namespace QuadFormsKB.Cassels.Ch9Ex16

/-- The form $f(x_0,x_1,x_2) = x_1x_2 + x_2x_0 + x_0x_1$. -/
def fQ : QuadForm ℤ 3 := QuadForm.ofUpper ![![0, 1, 1], ![0, 0, 1], ![0, 0, 0]]

/-- Helper: $f(v) = v_1v_2 + v_2v_0 + v_0v_1$ for an integer vector `v`. -/
theorem fQ_eval (v : Fin 3 → ℤ) : fQ.eval v = v 1 * v 2 + v 2 * v 0 + v 0 * v 1 := by
  simp [fQ, QuadForm.ofUpper, QuadForm.evalIn, Fin.sum_univ_three]
  ring

/-- The real form. -/
noncomputable abbrev fR : QuadForm ℝ 3 := fQ.map (Int.castRingHom ℝ)

/-- Helper: the real form `fR` evaluated at the real vector `v` is $v_1v_2 + v_2v_0 + v_0v_1$. -/
theorem fR_eval (v : Fin 3 → ℝ) :
    fR.eval v = v 1 * v 2 + v 2 * v 0 + v 0 * v 1 := by
  simp [fR, fQ, QuadForm.map, QuadForm.ofUpper, QuadForm.evalIn, Fin.sum_univ_three]
  ring

/-- Helper: membership of `g` in the integral automorphs of the form `Q` unfolds to $Q(gx) = Q(x)$ for all integer vectors `x`. -/
theorem mem_Aut_iff {n : ℕ} (Q : QuadForm ℤ n) (g : GL (Fin n) ℤ) :
    g ∈ Siegel.Aut Q ↔ ∀ x, Q.eval (g.val *ᵥ x) = Q.eval x := Iff.rfl

/-- Helper: the matrix of the symmetry $\sigma_1$ in $(0,1,1)$, $(x_0,x_1,x_2) \mapsto (x_0, -2x_0 - x_2, -2x_0 - x_1)$. -/
noncomputable def s1 : GL (Fin 3) ℤ := mk3 !![1, 0, 0; -2, 0, -1; -2, -1, 0]
  (Or.inr (by norm_num [Matrix.det_fin_three]))
/-- Helper: the matrix of the symmetry $\sigma_2$ in $(1,0,1)$, $(x_0,x_1,x_2) \mapsto (-2x_1 - x_2, x_1, -2x_1 - x_0)$. -/
noncomputable def s2 : GL (Fin 3) ℤ := mk3 !![0, -2, -1; 0, 1, 0; -1, -2, 0]
  (Or.inr (by norm_num [Matrix.det_fin_three]))
/-- Helper: the matrix of the symmetry $\sigma_3$ in $(1,1,0)$, $(x_0,x_1,x_2) \mapsto (-x_1 - 2x_2, -x_0 - 2x_2, x_2)$. -/
noncomputable def s3 : GL (Fin 3) ℤ := mk3 !![0, -1, -2; -1, 0, -2; 0, 0, 1]
  (Or.inr (by norm_num [Matrix.det_fin_three]))
/-- Helper: the matrix $-I$ (any dimension $3$ here). -/
noncomputable def negI : GL (Fin 3) ℤ := mk3 (-1)
  (Or.inr (by norm_num [Matrix.det_fin_three]))

/-- Helper: coordinates of $\sigma_1 v$ for an integer vector `v`. -/
theorem s1_apply (v : Fin 3 → ℤ) : s1.val *ᵥ v = ![v 0, -2 * v 0 - v 2, -2 * v 0 - v 1] := by
  ext i; fin_cases i <;> simp [s1, mk3_val, mulVec3_0, mulVec3_1, mulVec3_2] <;> ring
/-- Helper: coordinates of $\sigma_2 v$ for an integer vector `v`. -/
theorem s2_apply (v : Fin 3 → ℤ) : s2.val *ᵥ v = ![-2 * v 1 - v 2, v 1, -2 * v 1 - v 0] := by
  ext i; fin_cases i <;> simp [s2, mk3_val, mulVec3_0, mulVec3_1, mulVec3_2] <;> ring
/-- Helper: coordinates of $\sigma_3 v$ for an integer vector `v`. -/
theorem s3_apply (v : Fin 3 → ℤ) : s3.val *ᵥ v = ![-v 1 - 2 * v 2, -v 0 - 2 * v 2, v 2] := by
  ext i; fin_cases i <;> simp [s3, mk3_val, mulVec3_0, mulVec3_1, mulVec3_2] <;> ring
/-- Helper: $(-I)v = -v$. -/
theorem negI_apply (v : Fin 3 → ℤ) : negI.val *ᵥ v = -v := by
  simp [negI, mk3_val, Matrix.neg_mulVec]

/-- Helper: $\sigma_1$ is an integral automorph of $f$. -/
theorem s1_mem : s1 ∈ Siegel.Aut fQ := by
  rw [mem_Aut_iff]; intro x; rw [s1_apply, fQ_eval, fQ_eval]; simp; ring
/-- Helper: $\sigma_2$ is an integral automorph of $f$. -/
theorem s2_mem : s2 ∈ Siegel.Aut fQ := by
  rw [mem_Aut_iff]; intro x; rw [s2_apply, fQ_eval, fQ_eval]; simp; ring
/-- Helper: $\sigma_3$ is an integral automorph of $f$. -/
theorem s3_mem : s3 ∈ Siegel.Aut fQ := by
  rw [mem_Aut_iff]; intro x; rw [s3_apply, fQ_eval, fQ_eval]; simp; ring
/-- Helper: $-I$ is an integral automorph of $f$. -/
theorem negI_mem : negI ∈ Siegel.Aut fQ := by
  rw [mem_Aut_iff]; intro x; rw [negI_apply, fQ_eval, fQ_eval]; simp

/-! ### Real reflections -/

/-- Helper: the library reflection `reflectionBy` of the real form in $(0,1,1)$ has the explicit coordinates of $\sigma_1$. -/
theorem refl_v1 (a : Fin 3 → ℝ) :
    reflectionBy fR ![0, 1, 1] a = ![a 0, -2 * a 0 - a 2, -2 * a 0 - a 1] := by
  have hv : fR.eval ![0, 1, 1] = 1 := by rw [fR_eval]; simp
  unfold reflectionBy
  rw [hv, fR_eval, fR_eval]; ext i; fin_cases i <;> simp <;> ring
/-- Helper: the library reflection of the real form in $(1,0,1)$ has the explicit coordinates of $\sigma_2$. -/
theorem refl_v2 (a : Fin 3 → ℝ) :
    reflectionBy fR ![1, 0, 1] a = ![-2 * a 1 - a 2, a 1, -2 * a 1 - a 0] := by
  have hv : fR.eval ![1, 0, 1] = 1 := by rw [fR_eval]; simp
  unfold reflectionBy
  rw [hv, fR_eval, fR_eval]; ext i; fin_cases i <;> simp <;> ring
/-- Helper: the library reflection of the real form in $(1,1,0)$ has the explicit coordinates of $\sigma_3$. -/
theorem refl_v3 (a : Fin 3 → ℝ) :
    reflectionBy fR ![1, 1, 0] a = ![-a 1 - 2 * a 2, -a 0 - 2 * a 2, a 2] := by
  have hv : fR.eval ![1, 1, 0] = 1 := by rw [fR_eval]; simp
  unfold reflectionBy
  rw [hv, fR_eval, fR_eval]; ext i; fin_cases i <;> simp <;> ring

/-- Helper: the real matrix of $\sigma_1$ is the reflection in $(0,1,1)$. -/
theorem s1_map (x : Fin 3 → ℝ) : (s1.val.map (Int.castRingHom ℝ)) *ᵥ x = reflectionBy fR ![0, 1, 1] x := by
  rw [refl_v1]; ext i; fin_cases i <;> simp [s1, mk3_val, Matrix.mulVec, dotProduct, Fin.sum_univ_three] <;> ring
/-- Helper: the real matrix of $\sigma_2$ is the reflection in $(1,0,1)$. -/
theorem s2_map (x : Fin 3 → ℝ) : (s2.val.map (Int.castRingHom ℝ)) *ᵥ x = reflectionBy fR ![1, 0, 1] x := by
  rw [refl_v2]; ext i; fin_cases i <;> simp [s2, mk3_val, Matrix.mulVec, dotProduct, Fin.sum_univ_three] <;> ring
/-- Helper: the real matrix of $\sigma_3$ is the reflection in $(1,1,0)$. -/
theorem s3_map (x : Fin 3 → ℝ) : (s3.val.map (Int.castRingHom ℝ)) *ᵥ x = reflectionBy fR ![1, 1, 0] x := by
  rw [refl_v3]; ext i; fin_cases i <;> simp [s3, mk3_val, Matrix.mulVec, dotProduct, Fin.sum_univ_three] <;> ring

/-! ### Part (ii) -/

section Descent
variable {α : Type*} [CommRing α] [LinearOrder α] [IsStrictOrderedRing α]

/-- $\max_i |a_i|$. -/
def mx (a : Fin 3 → α) : α := max (max |a 0| |a 1|) |a 2|

/-- Helper: if $x, y$ have the same strict sign and $z$ the opposite one, and $f(x,y,z) = xy + yz + zx > 0$, then $|y+2z| < |y|$, $|x+2z| < |x|$, $|z| < |x|$, $|z| < |y|$. -/
theorem K (x y z : α) (hf : 0 < x * y + y * z + z * x)
    (h : (0 < x ∧ 0 < y ∧ z < 0) ∨ (x < 0 ∧ y < 0 ∧ 0 < z)) :
    |y + 2 * z| < |y| ∧ |x + 2 * z| < |x| ∧ |z| < |x| ∧ |z| < |y| := by
  rcases h with ⟨hx, hy, hz⟩ | ⟨hx, hy, hz⟩
  · have h1 : -z < y := by nlinarith
    have h2 : -z < x := by nlinarith
    rw [abs_of_pos hx, abs_of_pos hy, abs_of_neg hz]
    exact ⟨abs_lt.2 ⟨by linarith, by linarith⟩, abs_lt.2 ⟨by linarith, by linarith⟩, h2, h1⟩
  · have h1 : z < -y := by nlinarith
    have h2 : z < -x := by nlinarith
    rw [abs_of_neg hx, abs_of_neg hy, abs_of_pos hz]
    exact ⟨abs_lt.2 ⟨by linarith, by linarith⟩, abs_lt.2 ⟨by linarith, by linarith⟩, h2, h1⟩

/-- Helper: $|a_0| \le \max_i |a_i|$. -/
theorem le_mx0 (a : Fin 3 → α) : |a 0| ≤ mx a := le_max_of_le_left (le_max_left _ _)
/-- Helper: $|a_1| \le \max_i |a_i|$. -/
theorem le_mx1 (a : Fin 3 → α) : |a 1| ≤ mx a := le_max_of_le_left (le_max_right _ _)
/-- Helper: $|a_2| \le \max_i |a_i|$. -/
theorem le_mx2 (a : Fin 3 → α) : |a 2| ≤ mx a := le_max_right _ _

/-- Helper: the odd coordinate is $x_2$ (reflection in $(1,1,0)$). -/
theorem case2 (a : Fin 3 → α) (hf : 0 < a 1 * a 2 + a 2 * a 0 + a 0 * a 1)
    (h : (0 < a 0 ∧ 0 < a 1 ∧ a 2 < 0) ∨ (a 0 < 0 ∧ a 1 < 0 ∧ 0 < a 2)) :
    mx (![-a 1 - 2 * a 2, -a 0 - 2 * a 2, a 2] : Fin 3 → α) < mx a := by
  obtain ⟨k1, k2, k3, k4⟩ := K (a 0) (a 1) (a 2) (by linarith) h
  unfold mx
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
    Matrix.tail_cons]
  rw [show -a 1 - 2 * a 2 = -(a 1 + 2 * a 2) by ring, show -a 0 - 2 * a 2 = -(a 0 + 2 * a 2) by ring,
    abs_neg, abs_neg]
  refine max_lt (max_lt ?_ ?_) ?_
  · exact lt_of_lt_of_le k1 (le_mx1 a)
  · exact lt_of_lt_of_le k2 (le_mx0 a)
  · exact lt_of_lt_of_le k3 (le_mx0 a)

/-- Helper: when the odd sign is at coordinate $1$, the reflection in $(1,0,1)$ lowers $\max_i |a_i|$. -/
theorem case1 (a : Fin 3 → α) (hf : 0 < a 1 * a 2 + a 2 * a 0 + a 0 * a 1)
    (h : (0 < a 0 ∧ 0 < a 2 ∧ a 1 < 0) ∨ (a 0 < 0 ∧ a 2 < 0 ∧ 0 < a 1)) :
    mx (![-2 * a 1 - a 2, a 1, -2 * a 1 - a 0] : Fin 3 → α) < mx a := by
  obtain ⟨k1, k2, k3, k4⟩ := K (a 0) (a 2) (a 1) (by linarith) h
  unfold mx
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
    Matrix.tail_cons]
  rw [show -2 * a 1 - a 2 = -(a 2 + 2 * a 1) by ring, show -2 * a 1 - a 0 = -(a 0 + 2 * a 1) by ring,
    abs_neg, abs_neg]
  refine max_lt (max_lt ?_ ?_) ?_
  · exact lt_of_lt_of_le k1 (le_mx2 a)
  · exact lt_of_lt_of_le k3 (le_mx0 a)
  · exact lt_of_lt_of_le k2 (le_mx0 a)

/-- Helper: when the odd sign is at coordinate $0$, the reflection in $(0,1,1)$ lowers $\max_i |a_i|$. -/
theorem case0 (a : Fin 3 → α) (hf : 0 < a 1 * a 2 + a 2 * a 0 + a 0 * a 1)
    (h : (0 < a 1 ∧ 0 < a 2 ∧ a 0 < 0) ∨ (a 1 < 0 ∧ a 2 < 0 ∧ 0 < a 0)) :
    mx (![a 0, -2 * a 0 - a 2, -2 * a 0 - a 1] : Fin 3 → α) < mx a := by
  obtain ⟨k1, k2, k3, k4⟩ := K (a 1) (a 2) (a 0) (by linarith) h
  unfold mx
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
    Matrix.tail_cons]
  rw [show -2 * a 0 - a 2 = -(a 2 + 2 * a 0) by ring, show -2 * a 0 - a 1 = -(a 1 + 2 * a 0) by ring,
    abs_neg, abs_neg]
  refine max_lt (max_lt ?_ ?_) ?_
  · exact lt_of_lt_of_le k3 (le_mx1 a)
  · exact lt_of_lt_of_le k1 (le_mx2 a)
  · exact lt_of_lt_of_le k2 (le_mx1 a)

/-- Helper: if $a_0 = 0$ and $f(a) > 0$ then $a_1, a_2$ have the same strict sign. -/
theorem zero_pair0 (a : Fin 3 → α) (hf : 0 < a 1 * a 2 + a 2 * a 0 + a 0 * a 1) (h0 : a 0 = 0) :
    (0 < a 1 ∧ 0 < a 2) ∨ (a 1 < 0 ∧ a 2 < 0) := by
  rw [h0] at hf; simp at hf; exact mul_pos_iff.1 hf
/-- Helper: if $a_1 = 0$ and $f(a) > 0$ then $a_0, a_2$ have the same strict sign. -/
theorem zero_pair1 (a : Fin 3 → α) (hf : 0 < a 1 * a 2 + a 2 * a 0 + a 0 * a 1) (h0 : a 1 = 0) :
    (0 < a 0 ∧ 0 < a 2) ∨ (a 0 < 0 ∧ a 2 < 0) := by
  rw [h0] at hf; simp at hf; rw [mul_comm] at hf; exact mul_pos_iff.1 hf
/-- Helper: if $a_2 = 0$ and $f(a) > 0$ then $a_0, a_1$ have the same strict sign. -/
theorem zero_pair2 (a : Fin 3 → α) (hf : 0 < a 1 * a 2 + a 2 * a 0 + a 0 * a 1) (h0 : a 2 = 0) :
    (0 < a 0 ∧ 0 < a 1) ∨ (a 0 < 0 ∧ a 1 < 0) := by
  rw [h0] at hf; simp at hf; exact mul_pos_iff.1 hf

/-- Helper: the sign pattern. -/
theorem sign_pattern (a : Fin 3 → α) (hf : 0 < a 1 * a 2 + a 2 * a 0 + a 0 * a 1)
    (hp : 0 < a 0 ∨ 0 < a 1 ∨ 0 < a 2) (hn : a 0 < 0 ∨ a 1 < 0 ∨ a 2 < 0) :
    ((0 < a 0 ∧ 0 < a 1 ∧ a 2 < 0) ∨ (a 0 < 0 ∧ a 1 < 0 ∧ 0 < a 2)) ∨
    ((0 < a 0 ∧ 0 < a 2 ∧ a 1 < 0) ∨ (a 0 < 0 ∧ a 2 < 0 ∧ 0 < a 1)) ∨
    ((0 < a 1 ∧ 0 < a 2 ∧ a 0 < 0) ∨ (a 1 < 0 ∧ a 2 < 0 ∧ 0 < a 0)) := by
  rcases lt_trichotomy (a 0) 0 with h0 | h0 | h0 <;> rcases lt_trichotomy (a 1) 0 with h1 | h1 | h1 <;>
    rcases lt_trichotomy (a 2) 0 with h2 | h2 | h2 <;>
    first
    | (left; left; exact ⟨by assumption, by assumption, by assumption⟩)
    | (left; right; exact ⟨by assumption, by assumption, by assumption⟩)
    | (right; left; left; exact ⟨by assumption, by assumption, by assumption⟩)
    | (right; left; right; exact ⟨by assumption, by assumption, by assumption⟩)
    | (right; right; left; exact ⟨by assumption, by assumption, by assumption⟩)
    | (right; right; right; exact ⟨by assumption, by assumption, by assumption⟩)
    | (exfalso; rcases hp with h | h | h <;> rcases hn with h' | h' | h' <;> linarith)
    | (exfalso; have z := zero_pair0 a hf h0; rcases z with ⟨_, _⟩ | ⟨_, _⟩ <;> rcases hp with h | h | h <;>
        rcases hn with h' | h' | h' <;> linarith)
    | (exfalso; have z := zero_pair1 a hf h1; rcases z with ⟨_, _⟩ | ⟨_, _⟩ <;> rcases hp with h | h | h <;>
        rcases hn with h' | h' | h' <;> linarith)
    | (exfalso; have z := zero_pair2 a hf h2; rcases z with ⟨_, _⟩ | ⟨_, _⟩ <;> rcases hp with h | h | h <;>
        rcases hn with h' | h' | h' <;> linarith)

end Descent

/-- Helper: $\max_i |a_i| \ge 0$ for an integer vector. -/
theorem mx_nonneg (a : Fin 3 → ℤ) : 0 ≤ mx a := le_trans (abs_nonneg _) (le_mx0 a)

/-- The permutation matrix of `π`: `(permGL π) *ᵥ v = v ∘ π.symm`. -/
noncomputable def permGL {n : ℕ} : Equiv.Perm (Fin n) →* GL (Fin n) ℤ :=
  MonoidHom.toHomUnits
    (Matrix.permMatrixHom : Equiv.Perm (Fin n) →* Matrix (Fin n) (Fin n) ℤ)

/-- Helper: `permGL` acts on vectors by $v \mapsto v \circ \pi^{-1}$ (`v ∘ π.symm`). -/
theorem permGL_apply {n : ℕ} (π : Equiv.Perm (Fin n)) (v : Fin n → ℤ) :
    (permGL π).val *ᵥ v = v ∘ π.symm := by
  simp [permGL, Matrix.permMatrix_mulVec]

/-- The group $G_1$. -/
def G1 : Subgroup (GL (Fin 3) ℤ) := Subgroup.closure {s1, s2, s3, negI}

/-- The group $G_2$. -/
def G2 : Subgroup (GL (Fin 3) ℤ) :=
  Subgroup.closure ({s1, s2, s3, negI} ∪ Set.range (permGL (n := 3)))

/-- Helper: $G_1$ consists of integral automorphs. -/
theorem G1_le_Aut : G1 ≤ Siegel.Aut fQ := by
  refine (Subgroup.closure_le _).2 ?_
  intro g hg
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
  rcases hg with rfl | rfl | rfl | rfl
  exacts [s1_mem, s2_mem, s3_mem, negI_mem]

/-- Helper: $G_1 \le G_2$. -/
theorem G1_le_G2 : G1 ≤ G2 := Subgroup.closure_mono Set.subset_union_left


/-- **Cassels, Ch. 9, Ex. 16 (i), p. 166.** For $f = x_1x_2 + x_2x_0 + x_0x_1$ the symmetries $\sigma_1, \sigma_2, \sigma_3$ in $(0,1,1)$, $(1,0,1)$, $(1,1,0)$ are integral automorphs (`s1`, `s2`, `s3` are in `Siegel.Aut fQ`), and their real matrices are the library reflections `reflectionBy` of the real form `fR` in these vectors. -/
@[kb "cassels1978" "Ch. 9, Ex. 16 (i), p. 166"]
theorem ex16_i :
    (s1 ∈ Siegel.Aut fQ ∧ ∀ x : Fin 3 → ℝ, (s1.val.map (Int.castRingHom ℝ)) *ᵥ x = reflectionBy fR ![0, 1, 1] x) ∧
    (s2 ∈ Siegel.Aut fQ ∧ ∀ x : Fin 3 → ℝ, (s2.val.map (Int.castRingHom ℝ)) *ᵥ x = reflectionBy fR ![1, 0, 1] x) ∧
    (s3 ∈ Siegel.Aut fQ ∧ ∀ x : Fin 3 → ℝ, (s3.val.map (Int.castRingHom ℝ)) *ᵥ x = reflectionBy fR ![1, 1, 0] x) :=
  ⟨⟨s1_mem, s1_map⟩, ⟨s2_mem, s2_map⟩, ⟨s3_mem, s3_map⟩⟩

/-- Helper: a vector with a strictly positive and a strictly negative entry has these as disjunctions over the three coordinates. -/
theorem pos_neg_of (a : Fin 3 → ℝ) (hp : ∃ i, 0 < a i) (hn : ∃ i, a i < 0) :
    (0 < a 0 ∨ 0 < a 1 ∨ 0 < a 2) ∧ (a 0 < 0 ∨ a 1 < 0 ∨ a 2 < 0) := by
  obtain ⟨i, hi⟩ := hp
  obtain ⟨j, hj⟩ := hn
  constructor
  · fin_cases i <;> simp_all
  · fin_cases j <;> simp_all

/-- **Cassels, Ch. 9, Ex. 16 (ii), p. 166.** Let $a \in \mathbb R^3$ with $f(a) > 0$, having a strictly positive and a strictly negative coordinate (`hp`, `hn`). Then for one of the three vectors $v \in \{(0,1,1),(1,0,1),(1,1,0)\}$ the symmetry $b$ of $a$ in $v$ satisfies $\max_i |b_i| < \max_i |a_i|$. -/
@[kb "cassels1978" "Ch. 9, Ex. 16 (ii), p. 166"]
theorem ex16_ii (a : Fin 3 → ℝ) (hf : 0 < fR.eval a) (hp : ∃ i, 0 < a i) (hn : ∃ i, a i < 0) :
    ∃ v ∈ ({![0, 1, 1], ![1, 0, 1], ![1, 1, 0]} : Set (Fin 3 → ℝ)),
      max (max |reflectionBy fR v a 0| |reflectionBy fR v a 1|) |reflectionBy fR v a 2| <
        max (max |a 0| |a 1|) |a 2| := by
  rw [fR_eval] at hf
  obtain ⟨hp', hn'⟩ := pos_neg_of a hp hn
  rcases sign_pattern a hf hp' hn' with h | h | h
  · refine ⟨![1, 1, 0], by simp, ?_⟩
    rw [refl_v3]; exact case2 a hf h
  · refine ⟨![1, 0, 1], by simp, ?_⟩
    rw [refl_v2]; exact case1 a hf h
  · refine ⟨![0, 1, 1], by simp, ?_⟩
    rw [refl_v1]; exact case0 a hf h

/-- Helper: integral version of (ii). -/
theorem ex16_ii_int (a : Fin 3 → ℤ) (hf : 0 < fQ.eval a) (hp : 0 < a 0 ∨ 0 < a 1 ∨ 0 < a 2)
    (hn : a 0 < 0 ∨ a 1 < 0 ∨ a 2 < 0) :
    ∃ s ∈ ({s1, s2, s3} : Set (GL (Fin 3) ℤ)), mx (s.val *ᵥ a) < mx a := by
  rw [fQ_eval] at hf
  rcases sign_pattern a hf hp hn with h | h | h
  · exact ⟨s3, by simp, by rw [s3_apply]; exact case2 a hf h⟩
  · exact ⟨s2, by simp, by rw [s2_apply]; exact case1 a hf h⟩
  · exact ⟨s1, by simp, by rw [s1_apply]; exact case0 a hf h⟩

/-- Helper: descent on $\max_i |a_i|$ for Ex. 16 (iii): $G_1$ moves every integer vector with $f > 0$ to a non-negative one. -/
theorem desc_nonneg : ∀ (N : ℕ) (a : Fin 3 → ℤ), (mx a).toNat = N → 0 < fQ.eval a →
    ∃ σ ∈ G1, ∀ i, 0 ≤ (σ.val *ᵥ a) i := by
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
    intro a hN hf
    by_cases hpos : ∀ i, 0 ≤ a i
    · exact ⟨1, one_mem _, fun i => by simpa using hpos i⟩
    by_cases hneg : ∀ i, a i ≤ 0
    · refine ⟨negI, Subgroup.subset_closure (by simp), fun i => ?_⟩
      rw [negI_apply]; simpa using hneg i
    simp only [not_forall, not_le] at hpos hneg
    obtain ⟨i, hi⟩ := hpos
    obtain ⟨j, hj⟩ := hneg
    have hn : a 0 < 0 ∨ a 1 < 0 ∨ a 2 < 0 := by fin_cases i <;> simp_all
    have hp : 0 < a 0 ∨ 0 < a 1 ∨ 0 < a 2 := by fin_cases j <;> simp_all
    obtain ⟨s, hs, hlt⟩ := ex16_ii_int a hf hp hn
    have hsG : s ∈ G1 := by
      apply Subgroup.subset_closure
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hs ⊢
      tauto
    have hsA : s ∈ Siegel.Aut fQ := G1_le_Aut hsG
    have hf' : 0 < fQ.eval (s.val *ᵥ a) := by rw [hsA a]; exact hf
    have hlt' : (mx (s.val *ᵥ a)).toNat < N := by
      have := mx_nonneg (s.val *ᵥ a); have := mx_nonneg a; omega
    obtain ⟨σ, hσ, hσ'⟩ := ih _ hlt' (s.val *ᵥ a) rfl hf'
    exact ⟨σ * s, mul_mem hσ hsG, by simpa [Matrix.mulVec_mulVec] using hσ'⟩

/-- **Cassels, Ch. 9, Ex. 16 (iii), p. 166.** For $a \in \mathbb Z^3$ with $f(a) > 0$ there is $\sigma \in G_1 = \langle \sigma_1,\sigma_2,\sigma_3,-I\rangle$ (`G1`) such that all coordinates of $\sigma a$ are $\ge 0$. -/
@[kb "cassels1978" "Ch. 9, Ex. 16 (iii), p. 166"]
theorem ex16_iii (a : Fin 3 → ℤ) (hf : 0 < fQ.eval a) :
    ∃ σ ∈ G1, ∀ i, 0 ≤ (σ.val *ᵥ a) i :=
  desc_nonneg _ a rfl hf

/-- Helper: for non-negative integers with $yz + zx + xy = 1$, $x \le 1$. -/
theorem bd1 (x y z : ℤ) (hx : 0 ≤ x) (hy : 0 ≤ y) (hz : 0 ≤ z) (h : y * z + z * x + x * y = 1) : x ≤ 1 := by
  by_contra hc
  rcases (by omega : y + z = 0 ∨ 1 ≤ y + z) with h0 | h0
  · have : y = 0 := by omega
    have : z = 0 := by omega
    subst_vars; simp at h
  · nlinarith [mul_nonneg hy hz, mul_nonneg (show 0 ≤ x - 2 by omega) (show 0 ≤ y + z by omega)]

/-- Helper: a non-negative integer vector with $f = 1$ is a permutation of $(1,1,0)$. -/
theorem nonneg_f1 (c : Fin 3 → ℤ) (h0 : 0 ≤ c 0) (h1 : 0 ≤ c 1) (h2 : 0 ≤ c 2)
    (hf : c 1 * c 2 + c 2 * c 0 + c 0 * c 1 = 1) :
    c = ![1, 1, 0] ∨ c = ![1, 0, 1] ∨ c = ![0, 1, 1] := by
  have b0 : c 0 ≤ 1 := bd1 _ _ _ h0 h1 h2 hf
  have b1 : c 1 ≤ 1 := bd1 (c 1) (c 2) (c 0) h1 h2 h0 (by linarith)
  have b2 : c 2 ≤ 1 := bd1 (c 2) (c 0) (c 1) h2 h0 h1 (by linarith)
  rcases (by omega : c 0 = 0 ∨ c 0 = 1) with e0 | e0 <;> rcases (by omega : c 1 = 0 ∨ c 1 = 1) with e1 | e1 <;>
    rcases (by omega : c 2 = 0 ∨ c 2 = 1) with e2 | e2 <;>
    first
    | (exfalso; rw [e0, e1, e2] at hf; omega)
    | (left; ext i; fin_cases i <;> simp [e0, e1, e2]; done)
    | (right; left; ext i; fin_cases i <;> simp [e0, e1, e2]; done)
    | (right; right; ext i; fin_cases i <;> simp [e0, e1, e2]; done)

/-- **Cassels, Ch. 9, Ex. 16 (iv), p. 166.** For $a \in \mathbb Z^3$ with $f(a) = 1$ there is $\sigma \in G_2$ (`G2`: $G_1$ together with the permutations of $x_0,x_1,x_2$) with $a = \sigma(1,1,0)$. -/
@[kb "cassels1978" "Ch. 9, Ex. 16 (iv), p. 166"]
theorem ex16_iv (a : Fin 3 → ℤ) (hf : fQ.eval a = 1) :
    ∃ σ ∈ G2, a = σ.val *ᵥ ![1, 1, 0] := by
  obtain ⟨σ', hσ', hnn⟩ := ex16_iii a (by rw [hf]; norm_num)
  have hA : σ' ∈ Siegel.Aut fQ := G1_le_Aut hσ'
  have hf' : fQ.eval (σ'.val *ᵥ a) = 1 := by rw [hA a]; exact hf
  rw [fQ_eval] at hf'
  have key := nonneg_f1 _ (hnn 0) (hnn 1) (hnn 2) hf'
  have hperm : ∃ π : Equiv.Perm (Fin 3), σ'.val *ᵥ a = (permGL π).val *ᵥ ![1, 1, 0] := by
    rcases key with h | h | h
    · exact ⟨1, by rw [h, permGL_apply]; ext i; fin_cases i <;> rfl⟩
    · exact ⟨Equiv.swap 1 2, by rw [h, permGL_apply]; ext i; fin_cases i <;> rfl⟩
    · exact ⟨Equiv.swap 0 2, by rw [h, permGL_apply]; ext i; fin_cases i <;> rfl⟩
  obtain ⟨π, hπ⟩ := hperm
  refine ⟨σ'⁻¹ * permGL π, mul_mem (G1_le_G2 (inv_mem hσ')) (Subgroup.subset_closure (Or.inr ⟨π, rfl⟩)), ?_⟩
  rw [Units.val_mul, ← Matrix.mulVec_mulVec, ← hπ, Matrix.mulVec_mulVec]
  simp


/-! ### Part (v): the stabilizer of $(1,1,0)$ -/

/-- **Cassels, Ch. 9, Ex. 16 (v), p. 166 (first half).** If $x \in \mathbb R^3$ is normal to $(1,1,0)$ with respect to $f$ (the polar form $f(x+e) - f(x) - f(e)$ vanishes for $e = (1,1,0)$) then $f(x) = -(x_1+x_2)^2 - x_2^2$, i.e. in the book's coordinates $-(y+z)^2 - z^2$. -/
@[kb "cassels1978" "Ch. 9, Ex. 16 (v), p. 166"]
theorem ex16_v_form (x : Fin 3 → ℝ)
    (h : fR.eval (x + ![1, 1, 0]) - fR.eval x - fR.eval ![1, 1, 0] = 0) :
    fR.eval x = -(x 1 + x 2) ^ 2 - (x 2) ^ 2 := by
  simp only [fR_eval] at h ⊢
  simp at h
  have : x 0 = -x 1 - 2 * x 2 := by linarith
  rw [this]; ring

/-- Helper: the stabilizer of $(1,1,0)$ in the integral automorphs. -/
def G3 : Subgroup (GL (Fin 3) ℤ) where
  carrier := {T | T ∈ Siegel.Aut fQ ∧ T.val *ᵥ ![1, 1, 0] = ![1, 1, 0]}
  mul_mem' := by
    rintro S T ⟨hS, hS'⟩ ⟨hT, hT'⟩
    refine ⟨mul_mem hS hT, ?_⟩
    rw [Units.val_mul, ← Matrix.mulVec_mulVec, hT', hS']
  one_mem' := ⟨one_mem _, by simp⟩
  inv_mem' := by
    rintro T ⟨hT, hT'⟩
    refine ⟨inv_mem hT, ?_⟩
    calc (T⁻¹).val *ᵥ ![1, 1, 0] = (T⁻¹).val *ᵥ (T.val *ᵥ ![1, 1, 0]) := by rw [hT']
      _ = ![1, 1, 0] := by
        rw [Matrix.mulVec_mulVec, ← Units.val_mul, inv_mul_cancel]; simp

/-- Helper: the algebra of the stabilizer of $(1,1,0)$: nine integer unknowns satisfying the equations of an automorph fixing $(1,1,0)$ form one of four explicit matrices. -/
theorem stab_alg (t00 t01 t02 t10 t11 t12 t20 t21 t22 : ℤ)
    (e0 : t10 * t20 + t20 * t00 + t00 * t10 = 0)
    (e1 : t11 * t21 + t21 * t01 + t01 * t11 = 0)
    (e2 : t12 * t22 + t22 * t02 + t02 * t12 = 0)
    (e02 : (t10 + t12) * (t20 + t22) + (t20 + t22) * (t00 + t02) + (t00 + t02) * (t10 + t12) = 1)
    (e12 : (t11 + t12) * (t21 + t22) + (t21 + t22) * (t01 + t02) + (t01 + t02) * (t11 + t12) = 1)
    (h0 : t00 + t01 = 1) (h1 : t10 + t11 = 1) (h2 : t20 + t21 = 0) :
    (t00 = 1 ∧ t01 = 0 ∧ t02 = 0 ∧ t10 = 0 ∧ t11 = 1 ∧ t12 = 0 ∧ t20 = 0 ∧ t21 = 0 ∧ t22 = 1) ∨
    (t00 = 0 ∧ t01 = 1 ∧ t02 = 0 ∧ t10 = 1 ∧ t11 = 0 ∧ t12 = 0 ∧ t20 = 0 ∧ t21 = 0 ∧ t22 = 1) ∨
    (t00 = 0 ∧ t01 = 1 ∧ t02 = 2 ∧ t10 = 1 ∧ t11 = 0 ∧ t12 = 2 ∧ t20 = 0 ∧ t21 = 0 ∧ t22 = -1) ∨
    (t00 = 1 ∧ t01 = 0 ∧ t02 = 2 ∧ t10 = 0 ∧ t11 = 1 ∧ t12 = 2 ∧ t20 = 0 ∧ t21 = 0 ∧ t22 = -1) := by
  have a1 : t01 = 1 - t00 := by linarith
  have a2 : t11 = 1 - t10 := by linarith
  have a3 : t21 = -t20 := by linarith
  subst a1 a2 a3
  have ha : t00 = 1 - t10 - 2 * t20 := by nlinarith
  subst ha
  have hm : (t10 + t20) * (1 - (t10 + t20)) = t20 ^ 2 := by linear_combination e0
  have hc : t20 = 0 := by
    have h1 : (t10 + t20) * (1 - (t10 + t20)) ≤ 0 := by
      rcases le_or_gt (t10 + t20) 0 with h | h
      · nlinarith
      · nlinarith
    have : t20 ^ 2 ≤ 0 := by linarith
    nlinarith [sq_nonneg t20]
  subst hc
  have hb : t10 * (1 - t10) = 0 := by linarith
  rcases mul_eq_zero.1 hb with hb | hb
  · subst hb
    have hq : t12 + t22 = 1 := by nlinarith
    have hp : t02 + t22 = 1 := by nlinarith
    have hp' : t02 = 1 - t22 := by linarith
    have hq' : t12 = 1 - t22 := by linarith
    subst hp' hq'
    have : (1 - t22) * (1 + t22) = 0 := by linear_combination e2
    rcases mul_eq_zero.1 this with h | h
    · have : t22 = 1 := by linarith
      subst this; left; simp
    · have : t22 = -1 := by linarith
      subst this; right; right; right; simp
  · have hb : t10 = 1 := by linarith
    subst hb
    have hq : t12 + t22 = 1 := by nlinarith
    have hp : t02 + t22 = 1 := by nlinarith
    have hp' : t02 = 1 - t22 := by linarith
    have hq' : t12 = 1 - t22 := by linarith
    subst hp' hq'
    have : (1 - t22) * (1 + t22) = 0 := by linear_combination e2
    rcases mul_eq_zero.1 this with h | h
    · have : t22 = 1 := by linarith
      subst this; right; left; simp
    · have : t22 = -1 := by linarith
      subst this; right; right; left; simp


/-- Helper: elements of $G_3$ are one of four explicit matrices. -/
theorem stab_cases (T : GL (Fin 3) ℤ) (hT : T ∈ G3) :
    T.val = 1 ∨ T.val = !![0, 1, 0; 1, 0, 0; 0, 0, 1] ∨ T.val = !![0, 1, 2; 1, 0, 2; 0, 0, -1] ∨
      T.val = !![1, 0, 2; 0, 1, 2; 0, 0, -1] := by
  obtain ⟨hA, he⟩ := hT
  have e0 := hA ![1, 0, 0]
  have e1 := hA ![0, 1, 0]
  have e2 := hA ![0, 0, 1]
  have e02 := hA ![1, 0, 1]
  have e12 := hA ![0, 1, 1]
  have h0 := congrFun he 0
  have h1 := congrFun he 1
  have h2 := congrFun he 2
  rw [fQ_eval, fQ_eval] at e0 e1 e2 e02 e12
  simp [mulVec3_0, mulVec3_1, mulVec3_2] at e0 e1 e2 e02 e12 h0 h1 h2
  have hM := Matrix.eta_fin_three T.val
  have key := stab_alg (T.val 0 0) (T.val 0 1) (T.val 0 2) (T.val 1 0) (T.val 1 1) (T.val 1 2)
    (T.val 2 0) (T.val 2 1) (T.val 2 2) (by linarith) (by linarith) (by linarith) (by linarith)
    (by linarith) (by linarith) (by linarith) (by linarith)
  rw [hM]
  rcases key with ⟨k1, k2, k3, k4, k5, k6, k7, k8, k9⟩ | ⟨k1, k2, k3, k4, k5, k6, k7, k8, k9⟩ |
    ⟨k1, k2, k3, k4, k5, k6, k7, k8, k9⟩ | ⟨k1, k2, k3, k4, k5, k6, k7, k8, k9⟩
  · left; rw [k1, k2, k3, k4, k5, k6, k7, k8, k9]; ext i j; fin_cases i <;> fin_cases j <;> simp
  · right; left; rw [k1, k2, k3, k4, k5, k6, k7, k8, k9]
  · right; right; left; rw [k1, k2, k3, k4, k5, k6, k7, k8, k9]
  · right; right; right; rw [k1, k2, k3, k4, k5, k6, k7, k8, k9]

/-- Helper: two elements of $\mathrm{GL}_3(\mathbb Z)$ with the same action on vectors are equal. -/
theorem gl_ext3 {S T : GL (Fin 3) ℤ} (h : ∀ v, S.val *ᵥ v = T.val *ᵥ v) : S = T := by
  apply Units.ext
  ext i j
  have := congrFun (h (Pi.single j 1)) i
  simpa using this


/-- Helper: $\sigma_1 \in G_2$. -/
theorem s1_G2 : s1 ∈ G2 := Subgroup.subset_closure (Or.inl (by simp))
/-- Helper: $\sigma_2 \in G_2$. -/
theorem s2_G2 : s2 ∈ G2 := Subgroup.subset_closure (Or.inl (by simp))
/-- Helper: $\sigma_3 \in G_2$. -/
theorem s3_G2 : s3 ∈ G2 := Subgroup.subset_closure (Or.inl (by simp))
/-- Helper: $-I \in G_2$. -/
theorem negI_G2 : negI ∈ G2 := Subgroup.subset_closure (Or.inl (by simp))
/-- Helper: every permutation matrix lies in $G_2$. -/
theorem permGL_G2 (π : Equiv.Perm (Fin 3)) : permGL π ∈ G2 := Subgroup.subset_closure (Or.inr ⟨π, rfl⟩)

/-- Helper: the four elements of $G_3$. -/
theorem G3_le_G2 : G3 ≤ G2 := by
  intro T hT
  rcases stab_cases T hT with h | h | h | h
  · have : T = 1 := Units.ext h
    rw [this]; exact one_mem _
  · have : T = permGL (Equiv.swap 0 1) := gl_ext3 (fun v => by
      rw [h, permGL_apply]; ext i; fin_cases i <;> simp [mulVec3_0, mulVec3_1, mulVec3_2] <;> rfl)
    rw [this]; exact permGL_G2 _
  · have : T = s3 * negI := gl_ext3 (fun v => by
      rw [h, Units.val_mul, ← Matrix.mulVec_mulVec, negI_apply, s3_apply]
      ext i; fin_cases i <;> simp [mulVec3_0, mulVec3_1, mulVec3_2] <;> ring)
    rw [this]; exact mul_mem s3_G2 negI_G2
  · have : T = s3 * negI * permGL (Equiv.swap 0 1) := gl_ext3 (fun v => by
      rw [h, Units.val_mul, Units.val_mul, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, permGL_apply,
        negI_apply, s3_apply]
      ext i; fin_cases i <;> simp [mulVec3_0, mulVec3_1, mulVec3_2] <;> first | rfl | ring)
    rw [this]; exact mul_mem (mul_mem s3_G2 negI_G2) (permGL_G2 _)

/-- Helper: $G_3$ is finite. -/
theorem G3_finite : (G3 : Set (GL (Fin 3) ℤ)).Finite := by
  have : (G3 : Set (GL (Fin 3) ℤ)) ⊆ {1, permGL (Equiv.swap 0 1), s3 * negI,
      s3 * negI * permGL (Equiv.swap 0 1)} := by
    intro T hT
    rcases stab_cases T hT with h | h | h | h
    · have : T = 1 := Units.ext h
      simp [this]
    · have : T = permGL (Equiv.swap 0 1) := gl_ext3 (fun v => by
        rw [h, permGL_apply]; ext i; fin_cases i <;> simp [mulVec3_0, mulVec3_1, mulVec3_2] <;> rfl)
      simp [this]
    · have : T = s3 * negI := gl_ext3 (fun v => by
        rw [h, Units.val_mul, ← Matrix.mulVec_mulVec, negI_apply, s3_apply]
        ext i; fin_cases i <;> simp [mulVec3_0, mulVec3_1, mulVec3_2] <;> ring)
      simp [this]
    · have : T = s3 * negI * permGL (Equiv.swap 0 1) := gl_ext3 (fun v => by
        rw [h, Units.val_mul, Units.val_mul, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, permGL_apply,
          negI_apply, s3_apply]
        ext i; fin_cases i <;> simp [mulVec3_0, mulVec3_1, mulVec3_2] <;> first | rfl | ring)
      simp [this]
  exact Set.Finite.subset (Set.toFinite _) this


/-- **Cassels, Ch. 9, Ex. 16 (v), p. 166 (second half).** The group $G_3$ of integral automorphs fixing $(1,1,0)$ is finite (it has four elements, listed in `stab_cases`) and contained in $G_2$. -/
@[kb "cassels1978" "Ch. 9, Ex. 16 (v), p. 166"]
theorem ex16_v_group : (G3 : Set (GL (Fin 3) ℤ)).Finite ∧ G3 ≤ G2 := ⟨G3_finite, G3_le_G2⟩

/-- Helper: $2f(v) = (\sum_i v_i)^2 - \sum_i v_i^2$ (permutation invariance of $f$). -/
theorem two_mul_fQ (v : Fin 3 → ℤ) : 2 * fQ.eval v = (∑ i, v i) ^ 2 - ∑ i, (v i) ^ 2 := by
  rw [fQ_eval]; simp [Fin.sum_univ_three]; ring

/-- Helper: permutation matrices are integral automorphs of $f$. -/
theorem permGL_mem_Aut (π : Equiv.Perm (Fin 3)) : permGL π ∈ Siegel.Aut fQ := by
  rw [mem_Aut_iff]; intro x
  have h := two_mul_fQ (x ∘ π.symm)
  rw [permGL_apply]
  have h' := two_mul_fQ x
  have e1 : ∑ i, (x ∘ π.symm) i = ∑ i, x i := Equiv.sum_comp π.symm x
  have e2 : ∑ i, ((x ∘ π.symm) i) ^ 2 = ∑ i, (x i) ^ 2 := Equiv.sum_comp π.symm (fun i => x i ^ 2)
  rw [e1, e2, ← h'] at h
  linarith

/-- Helper: $G_2$ consists of integral automorphs. -/
theorem G2_le_Aut : G2 ≤ Siegel.Aut fQ := by
  refine (Subgroup.closure_le _).2 ?_
  rintro g (hg | ⟨π, rfl⟩)
  · exact G1_le_Aut (Subgroup.subset_closure hg)
  · exact permGL_mem_Aut π

/-- **Cassels, Ch. 9, Ex. 16 (vi), p. 166.** The group of integral automorphs of $f = x_1x_2+x_2x_0+x_0x_1$ is $G_2$. -/
@[kb "cassels1978" "Ch. 9, Ex. 16 (vi), p. 166"]
theorem ex16_vi : Siegel.Aut fQ = G2 := by
  refine le_antisymm (fun T hT => ?_) G2_le_Aut
  have hfe : fQ.eval (T.val *ᵥ ![1, 1, 0]) = 1 := by rw [hT]; rw [fQ_eval]; simp
  obtain ⟨σ, hσ, hTσ⟩ := ex16_iv _ hfe
  have hσA : σ ∈ Siegel.Aut fQ := G2_le_Aut hσ
  have : σ⁻¹ * T ∈ G3 := by
    refine ⟨mul_mem (inv_mem hσA) hT, ?_⟩
    rw [Units.val_mul, ← Matrix.mulVec_mulVec, hTσ, Matrix.mulVec_mulVec, ← Units.val_mul, inv_mul_cancel]
    simp
  have h2 := G3_le_G2 this
  have := mul_mem hσ h2
  simpa using this


/-! ### Part (vii): generators of the proper automorphs -/

/-- The transposition matrix swapping $x_0, x_1$. -/
noncomputable def p01 : GL (Fin 3) ℤ := permGL (Equiv.swap 0 1)
/-- The transposition matrix swapping $x_0, x_2$. -/
noncomputable def p02 : GL (Fin 3) ℤ := permGL (Equiv.swap 0 2)
/-- The transposition matrix swapping $x_1, x_2$. -/
noncomputable def p12 : GL (Fin 3) ℤ := permGL (Equiv.swap 1 2)

/-- The generating set for $O^+$: $-\sigma_1,-\sigma_2,-\sigma_3$ and minus the three transposition matrices. -/
def Gens6 : Set (GL (Fin 3) ℤ) :=
  {negI * s1, negI * s2, negI * s3, negI * p01, negI * p02, negI * p12}

/-- Helper: the subgroup generated by `Gens6`. -/
def C6 : Subgroup (GL (Fin 3) ℤ) := Subgroup.closure Gens6

/-- Helper: $-I$ is central in $\mathrm{GL}_3(\mathbb Z)$. -/
theorem negI_central (g : GL (Fin 3) ℤ) : negI * g = g * negI := by
  apply gl_ext3; intro v
  rw [Units.val_mul, Units.val_mul, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, negI_apply, negI_apply,
    Matrix.mulVec_neg]

/-- Helper: $(-I)^2 = 1$. -/
theorem negI_sq : negI * negI = 1 := by
  apply gl_ext3; intro v
  rw [Units.val_mul, ← Matrix.mulVec_mulVec, negI_apply, negI_apply]; simp

/-- Helper: $\det(-I) = -1$ in dimension $3$. -/
theorem det_negI : negI.val.det = -1 := by
  simp [negI, mk3_val, Matrix.det_fin_three]
/-- Helper: $\det \sigma_1 = -1$. -/
theorem det_s1 : s1.val.det = -1 := by simp [s1, mk3_val, Matrix.det_fin_three]
/-- Helper: $\det \sigma_2 = -1$. -/
theorem det_s2 : s2.val.det = -1 := by simp [s2, mk3_val, Matrix.det_fin_three]
/-- Helper: $\det \sigma_3 = -1$. -/
theorem det_s3 : s3.val.det = -1 := by simp [s3, mk3_val, Matrix.det_fin_three]
/-- Helper: a transposition matrix has determinant $-1$. -/
theorem det_swap (i j : Fin 3) (h : i ≠ j) : (permGL (Equiv.swap i j)).val.det = -1 := by
  simp [permGL, Matrix.det_permutation, Equiv.Perm.sign_swap h]

/-- Helper: an element of $\mathrm{GL}_3(\mathbb Z)$ has determinant $\pm 1$. -/
theorem det_pm (g : GL (Fin 3) ℤ) : g.val.det = 1 ∨ g.val.det = -1 := by
  have h : IsUnit g.val.det := (Matrix.isUnit_iff_isUnit_det _).1 g.isUnit
  exact Int.isUnit_iff.1 h

/-- Helper: the even/odd predicate used in the proof of (vii). -/
def PP (g : GL (Fin 3) ℤ) : Prop :=
  (g.val.det = 1 ∧ g ∈ C6) ∨ (g.val.det = -1 ∧ negI * g ∈ C6)

/-- Helper: the parity predicate `PP` is closed under products. -/
theorem PP_mul {g h : GL (Fin 3) ℤ} (hg : PP g) (hh : PP h) : PP (g * h) := by
  have hd : (g * h).val.det = g.val.det * h.val.det := by rw [Units.val_mul, Matrix.det_mul]
  rcases hg with ⟨d1, m1⟩ | ⟨d1, m1⟩ <;> rcases hh with ⟨d2, m2⟩ | ⟨d2, m2⟩
  · left; exact ⟨by rw [hd, d1, d2]; norm_num, mul_mem m1 m2⟩
  · right; refine ⟨by rw [hd, d1, d2]; norm_num, ?_⟩
    have : negI * (g * h) = g * (negI * h) := by
      rw [← mul_assoc, negI_central g, mul_assoc]
    rw [this]; exact mul_mem m1 m2
  · right; refine ⟨by rw [hd, d1, d2]; norm_num, ?_⟩
    have : negI * (g * h) = (negI * g) * h := by rw [mul_assoc]
    rw [this]; exact mul_mem m1 m2
  · left; refine ⟨by rw [hd, d1, d2]; norm_num, ?_⟩
    have : (negI * g) * (negI * h) = g * h := by
      calc (negI * g) * (negI * h) = (g * negI) * (negI * h) := by rw [negI_central g]
        _ = g * (negI * negI) * h := by simp only [mul_assoc]
        _ = g * h := by rw [negI_sq]; simp
    rw [← this]; exact mul_mem m1 m2

/-- Helper: the parity predicate `PP` is closed under inverses. -/
theorem PP_inv {g : GL (Fin 3) ℤ} (hg : PP g) : PP g⁻¹ := by
  have hd : g⁻¹.val.det * g.val.det = 1 := by
    rw [← Matrix.det_mul, ← Units.val_mul, inv_mul_cancel]; simp
  rcases hg with ⟨d1, m1⟩ | ⟨d1, m1⟩
  · left; refine ⟨by rw [d1] at hd; linarith, inv_mem m1⟩
  · right; refine ⟨by rw [d1] at hd; linarith, ?_⟩
    have : negI * g⁻¹ = (negI * g)⁻¹ := by
      rw [_root_.mul_inv_rev]
      have : negI⁻¹ = negI := by
        rw [inv_eq_iff_mul_eq_one, negI_sq]
      rw [this, negI_central]
    rw [this]; exact inv_mem m1

/-- Helper: the generators of determinant $-1$ whose product with $-I$ lies in `Gens6` satisfy `PP`. -/
theorem PP_gen {s : GL (Fin 3) ℤ} (hd : s.val.det = -1) (hs : negI * s ∈ Gens6) : PP s :=
  Or.inr ⟨hd, Subgroup.subset_closure hs⟩

/-- Helper: every element of the group generated by $\sigma_1,\sigma_2,\sigma_3,-I$ and the three transpositions satisfies `PP`. -/
theorem PP_closure : ∀ g ∈ Subgroup.closure ({s1, s2, s3, negI, p01, p02, p12} : Set (GL (Fin 3) ℤ)), PP g := by
  intro g hg
  refine Subgroup.closure_induction (p := fun g _ => PP g) ?_ ?_ ?_ ?_ hg
  · intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact PP_gen det_s1 (by simp [Gens6])
    · exact PP_gen det_s2 (by simp [Gens6])
    · exact PP_gen det_s3 (by simp [Gens6])
    · exact Or.inr ⟨det_negI, by rw [negI_sq]; exact one_mem _⟩
    · exact PP_gen (det_swap 0 1 (by decide)) (by simp [Gens6, p01])
    · exact PP_gen (det_swap 0 2 (by decide)) (by simp [Gens6, p02])
    · exact PP_gen (det_swap 1 2 (by decide)) (by simp [Gens6, p12])
  · exact Or.inl ⟨by simp, one_mem _⟩
  · intro x y _ _ hx hy; exact PP_mul hx hy
  · intro x _ hx; exact PP_inv hx

/-- Helper: every permutation matrix lies in the group generated by the three transposition matrices. -/
theorem perm_closure (π : Equiv.Perm (Fin 3)) :
    permGL π ∈ Subgroup.closure ({s1, s2, s3, negI, p01, p02, p12} : Set (GL (Fin 3) ℤ)) := by
  induction π using Equiv.Perm.swap_induction_on with
  | one => simpa using one_mem _
  | swap_mul f x y hxy ih =>
    rw [map_mul]
    refine mul_mem ?_ ih
    fin_cases x <;> fin_cases y <;> simp at hxy
    · exact Subgroup.subset_closure (by simp [p01])
    · exact Subgroup.subset_closure (by simp [p02])
    · rw [Equiv.swap_comm]; exact Subgroup.subset_closure (by simp [p01])
    · exact Subgroup.subset_closure (by simp [p12])
    · rw [Equiv.swap_comm]; exact Subgroup.subset_closure (by simp [p02])
    · rw [Equiv.swap_comm]; exact Subgroup.subset_closure (by simp [p12])

/-- Helper: the group generated by `Gens6` consists of proper automorphs. -/
theorem Gens6_sub : C6 ≤ Siegel.AutPlus fQ := by
  refine (Subgroup.closure_le _).2 ?_
  intro g hg
  have key : ∀ s : GL (Fin 3) ℤ, s ∈ Siegel.Aut fQ → s.val.det = -1 → negI * s ∈ Siegel.AutPlus fQ := by
    intro s hs hd
    rw [Siegel.mem_autPlus_iff]
    refine ⟨mul_mem negI_mem hs, ?_⟩
    rw [Units.val_mul, Matrix.det_mul, hd, det_negI]; norm_num
  simp only [Gens6, Set.mem_insert_iff, Set.mem_singleton_iff] at hg
  rcases hg with rfl | rfl | rfl | rfl | rfl | rfl
  · exact key _ s1_mem det_s1
  · exact key _ s2_mem det_s2
  · exact key _ s3_mem det_s3
  · exact key _ (permGL_mem_Aut _) (det_swap 0 1 (by decide))
  · exact key _ (permGL_mem_Aut _) (det_swap 0 2 (by decide))
  · exact key _ (permGL_mem_Aut _) (det_swap 1 2 (by decide))

/-- **Cassels, Ch. 9, Ex. 16 (vii), p. 166.** The group $O^{+}_{\mathbb Z}(f)$ of integral automorphs of determinant $1$ is generated by the six elements `Gens6`: $-\sigma_1, -\sigma_2, -\sigma_3$ and minus the three transposition matrices (the seven involutions $\sigma_i$, $-I$, transpositions all have determinant $-1$; a determinant $1$ element is a product of an even number of them, hence of products $(-I)s$). The set is possibly redundant. *Answer computed, the book gives none.* -/
@[kb "cassels1978" "Ch. 9, Ex. 16 (vii), p. 166"]
theorem ex16_vii : Siegel.AutPlus fQ = Subgroup.closure Gens6 := by
  refine le_antisymm (fun T hT => ?_) Gens6_sub
  rw [Siegel.mem_autPlus_iff] at hT
  obtain ⟨hA, hd⟩ := hT
  rw [ex16_vi] at hA
  have hcl : T ∈ Subgroup.closure ({s1, s2, s3, negI, p01, p02, p12} : Set (GL (Fin 3) ℤ)) := by
    have : G2 ≤ Subgroup.closure ({s1, s2, s3, negI, p01, p02, p12} : Set (GL (Fin 3) ℤ)) := by
      refine (Subgroup.closure_le _).2 ?_
      rintro g (hg | ⟨π, rfl⟩)
      · apply Subgroup.subset_closure
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg ⊢
        tauto
      · exact perm_closure π
    exact this hA
  rcases PP_closure T hcl with ⟨_, m⟩ | ⟨d, _⟩
  · exact m
  · rw [hd] at d; norm_num at d


/-! ## Exercises 17--19: the Lorentzian forms $x_0^2 - x_1^2 - \dots - x_m^2$ -/

section Lorentz
variable {m : ℕ}

/-- Gram matrix $\operatorname{diag}(1,-1,\dots,-1)$. -/
def lorentzGram (m : ℕ) : Matrix (Fin (m + 1)) (Fin (m + 1)) ℤ :=
  Matrix.diagonal (fun i => if i = 0 then 1 else -1)

/-- The form $x_0^2 - x_1^2 - \dots - x_m^2$. -/
def lorentz (m : ℕ) : QuadForm ℤ (m + 1) := Siegel.ofGram (lorentzGram m)

/-- Helper: $Q(v) = 2v_0^2 - \sum_i v_i^2$ for $Q = x_0^2 - x_1^2 - \dots - x_m^2$. -/
theorem lorentz_eval (v : Fin (m + 1) → ℤ) :
    (lorentz m).eval v = 2 * v 0 ^ 2 - ∑ i, v i ^ 2 := by
  have h := Siegel.eval_ofGram (A := lorentzGram m) (by simp [lorentzGram, Matrix.isSymm_diagonal]) v
  unfold lorentz
  rw [h]
  simp only [lorentzGram, Matrix.mulVec_diagonal, dotProduct]
  have : ∀ i : Fin (m + 1), v i * ((if i = 0 then (1 : ℤ) else -1) * v i) =
      2 * (if i = 0 then v 0 ^ 2 else 0) - v i ^ 2 := by
    intro i
    by_cases hi : i = 0
    · subst hi; simp; ring
    · simp [hi]; ring
  rw [Finset.sum_congr rfl (fun i _ => this i), Finset.sum_sub_distrib, ← Finset.mul_sum]
  simp

/-- Helper: $Q(v) = v_0^2 - \sum_{i=1}^m v_i^2$. -/
theorem lorentz_eval' (v : Fin (m + 1) → ℤ) :
    (lorentz m).eval v = v 0 ^ 2 - ∑ i : Fin m, v i.succ ^ 2 := by
  rw [lorentz_eval, Fin.sum_univ_succ]; ring

end Lorentz

section Generic
variable {n : ℕ}

/-- Helper: two integer matrices with the same action on all vectors are equal. -/
theorem mat_ext_mulVec {A B : Matrix (Fin n) (Fin n) ℤ} (h : ∀ v, A *ᵥ v = B *ᵥ v) : A = B := by
  ext i j
  have := congrFun (h (Pi.single j 1)) i
  simpa using this

/-- Helper: two elements of $\mathrm{GL}_n(\mathbb Z)$ with the same action on vectors are equal. -/
theorem gl_ext {S T : GL (Fin n) ℤ} (h : ∀ v, S.val *ᵥ v = T.val *ᵥ v) : S = T :=
  Units.ext (mat_ext_mulVec h)

/-- The sign change of the coordinate `i`. -/
def flipGL (i : Fin n) : GL (Fin n) ℤ where
  val := Matrix.diagonal fun j => if j = i then -1 else 1
  inv := Matrix.diagonal fun j => if j = i then -1 else 1
  val_inv := by
    rw [Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]; congr 1; ext j
    by_cases h : j = i <;> simp [h]
  inv_val := by
    rw [Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]; congr 1; ext j
    by_cases h : j = i <;> simp [h]

/-- Helper: `flipGL i` negates the coordinate `i` of a vector. -/
theorem flipGL_apply (i : Fin n) (v : Fin n → ℤ) :
    (flipGL i).val *ᵥ v = Function.update v i (-v i) := by
  ext j
  simp only [flipGL, Matrix.mulVec_diagonal]
  by_cases h : j = i
  · subst h; simp
  · simp [h, Function.update_of_ne h]

/-- The transposition of the coordinates `i`, `j`. -/
noncomputable def swapGL (i j : Fin n) : GL (Fin n) ℤ := permGL (Equiv.swap i j)

/-- Helper: the matrix $1 - v\varphi^{\mathsf T}$. -/
def reflMat (φ v : Fin n → ℤ) : Matrix (Fin n) (Fin n) ℤ := 1 - Matrix.vecMulVec v φ

/-- Helper: $(1 - v\varphi^{\mathsf T})x = x - (\varphi\cdot x)v$. -/
theorem reflMat_mulVec (φ v x : Fin n → ℤ) : reflMat φ v *ᵥ x = x - (φ ⬝ᵥ x) • v := by
  ext i
  simp [reflMat, Matrix.sub_mulVec, Matrix.vecMulVec_mulVec, dotProduct_comm]

/-- Helper: if $\varphi\cdot v = 2$ then $(1 - v\varphi^{\mathsf T})^2 = 1$. -/
theorem reflMat_sq (φ v : Fin n → ℤ) (h : φ ⬝ᵥ v = 2) : reflMat φ v * reflMat φ v = 1 := by
  apply mat_ext_mulVec; intro x
  rw [← Matrix.mulVec_mulVec, reflMat_mulVec, reflMat_mulVec, dotProduct_sub, dotProduct_smul, h]
  ext i; simp; ring

/-- The reflection $x \mapsto x - (\varphi\cdot x) v$ (an involution when $\varphi\cdot v = 2$). -/
def reflGL (φ v : Fin n → ℤ) (h : φ ⬝ᵥ v = 2) : GL (Fin n) ℤ where
  val := reflMat φ v
  inv := reflMat φ v
  val_inv := reflMat_sq φ v h
  inv_val := reflMat_sq φ v h

/-- Helper: `reflGL` acts as $x \mapsto x - (\varphi\cdot x)v$. -/
theorem reflGL_apply (φ v : Fin n → ℤ) (h : φ ⬝ᵥ v = 2) (x : Fin n → ℤ) :
    (reflGL φ v h).val *ᵥ x = x - (φ ⬝ᵥ x) • v := reflMat_mulVec φ v x

end Generic

section Stab
variable {m : ℕ}

/-- Helper: $Q(x+y) = Q(x) + Q(y) + 4x_0y_0 - 2\sum_i x_iy_i$ for $Q = x_0^2 - \dots - x_m^2$. -/
theorem lorentz_polar (x y : Fin (m + 1) → ℤ) :
    (lorentz m).eval (x + y) = (lorentz m).eval x + (lorentz m).eval y + 4 * x 0 * y 0 -
      2 * ∑ i, x i * y i := by
  rw [lorentz_eval, lorentz_eval, lorentz_eval]
  have h : ∑ i, (x i + y i) ^ 2 = ∑ i, x i ^ 2 + ∑ i, y i ^ 2 + 2 * ∑ i, x i * y i := by
    rw [Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    ring
  simp only [Pi.add_apply]
  rw [h]; ring

/-- Helper: $\sum_j y_j e_i(j) = y_i$. -/
theorem sum_mul_single (y : Fin (m + 1) → ℤ) (i : Fin (m + 1)) :
    ∑ j, y j * (Pi.single i (1 : ℤ) : Fin (m + 1) → ℤ) j = y i := by
  simp [Pi.single_apply]

/-- Helper: $Q(e_i) = 1$ for $i = 0$ and $-1$ for $i \ne 0$. -/
theorem lorentz_single (i : Fin (m + 1)) :
    (lorentz m).eval (Pi.single i (1 : ℤ) : Fin (m + 1) → ℤ) = if i = 0 then 1 else -1 := by
  rw [lorentz_eval]
  by_cases h : i = 0
  · subst h; simp [Pi.single_apply]
  · simp [Pi.single_apply, h, Ne.symm h]

/-- Helper: an integer vector with sum of squares one is $\pm$ a unit vector. -/
theorem sumsq_one {ι : Type*} [Fintype ι] [DecidableEq ι] (y : ι → ℤ) (h : ∑ i, y i ^ 2 = 1) :
    ∃ l, (y l = 1 ∨ y l = -1) ∧ ∀ i, i ≠ l → y i = 0 := by
  have hex : ∃ l, y l ≠ 0 := by
    by_contra hc
    push Not at hc
    simp [hc] at h
  obtain ⟨l, hl⟩ := hex
  have hsplit := Finset.add_sum_erase Finset.univ (fun i => y i ^ 2) (Finset.mem_univ l)
  have hnn : 0 ≤ ∑ i ∈ Finset.univ.erase l, y i ^ 2 := Finset.sum_nonneg fun i _ => sq_nonneg _
  have hl2 : 1 ≤ y l ^ 2 := by
    have : 0 < y l ^ 2 := by positivity
    omega
  have hl1 : y l ^ 2 = 1 := by omega
  have hrest : ∑ i ∈ Finset.univ.erase l, y i ^ 2 = 0 := by omega
  refine ⟨l, ?_, fun i hi => ?_⟩
  · have : (y l - 1) * (y l + 1) = 0 := by ring_nf; linarith
    rcases mul_eq_zero.1 this with h | h
    · left; linarith
    · right; linarith
  · have := (Finset.sum_eq_zero_iff_of_nonneg (fun j _ => sq_nonneg (y j))).1 hrest i
      (Finset.mem_erase.2 ⟨hi, Finset.mem_univ i⟩)
    exact pow_eq_zero_iff (by norm_num) |>.1 this


/-- Helper: sign changes are integral automorphs of $x_0^2 - \dots - x_m^2$. -/
theorem flipGL_mem_Aut (i : Fin (m + 1)) : flipGL i ∈ Siegel.Aut (lorentz m) := by
  rw [mem_Aut_iff]; intro x
  rw [flipGL_apply, lorentz_eval, lorentz_eval]
  have hp : ∀ j, (Function.update x i (-x i) j) ^ 2 = x j ^ 2 := by
    intro j
    by_cases h : j = i
    · subst h; simp
    · simp [Function.update_of_ne h]
  rw [hp 0]
  simp only [hp]

/-- Helper: permutations fixing the coordinate $0$ are integral automorphs of $x_0^2 - \dots - x_m^2$. -/
theorem permGL_mem_Aut_lorentz (π : Equiv.Perm (Fin (m + 1))) (h0 : π 0 = 0) :
    permGL π ∈ Siegel.Aut (lorentz m) := by
  rw [mem_Aut_iff]; intro x
  rw [permGL_apply, lorentz_eval, lorentz_eval]
  have h1 : π.symm 0 = 0 := by rw [Equiv.symm_apply_eq]; exact h0.symm
  simp only [Function.comp_apply, h1]
  have := Equiv.sum_comp π.symm (fun i => x i ^ 2)
  rw [this]

/-- Fixing the first `k` basis vectors. -/
def FixesFirst (T : GL (Fin (m + 1)) ℤ) (k : ℕ) : Prop :=
  ∀ i : Fin (m + 1), i.val < k → T.val *ᵥ (Pi.single i (1 : ℤ) : Fin (m + 1) → ℤ) = Pi.single i 1

/-- Helper: an element fixing every basis vector is the identity. -/
theorem fixesFirst_all (T : GL (Fin (m + 1)) ℤ) (h : FixesFirst T (m + 1)) : T = 1 := by
  apply gl_ext; intro v
  have : v = ∑ i, v i • (Pi.single i (1 : ℤ) : Fin (m + 1) → ℤ) := by
    ext j; simp [Finset.sum_apply, Pi.single_apply]
  rw [this, Matrix.mulVec_sum]
  simp only [Matrix.mulVec_smul, Units.val_one, Matrix.one_mulVec]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [h i i.isLt]


/-- Helper: an automorph fixing $e_0, \dots, e_{k-1}$ ($k \ge 1$) sends $e_k$ to $\pm e_l$ with $l \ge k$. -/
theorem peel_step (T : GL (Fin (m + 1)) ℤ) (hT : T ∈ Siegel.Aut (lorentz m)) (k : ℕ) (hk1 : 1 ≤ k)
    (hk : k < m + 1) (hfix : FixesFirst T k) :
    ∃ l : Fin (m + 1), k ≤ l.val ∧ ∃ s : ℤ, (s = 1 ∨ s = -1) ∧
      T.val *ᵥ (Pi.single ⟨k, hk⟩ (1 : ℤ) : Fin (m + 1) → ℤ) = s • Pi.single l 1 := by
  set y := T.val *ᵥ (Pi.single ⟨k, hk⟩ (1 : ℤ) : Fin (m + 1) → ℤ) with hy
  have hk0 : (⟨k, hk⟩ : Fin (m + 1)) ≠ 0 := by
    intro h; have := congrArg Fin.val h; simp at this; omega
  have hyev : (lorentz m).eval y = -1 := by
    rw [hy, hT, lorentz_single, if_neg hk0]
  have ha : ∀ i : Fin (m + 1), i.val < k → y i = 0 := by
    intro i hi
    have hki : (⟨k, hk⟩ : Fin (m + 1)) ≠ i := by
      intro h; have := congrArg Fin.val h; simp at this; omega
    have h1 := hT (Pi.single ⟨k, hk⟩ 1 + Pi.single i 1)
    rw [Matrix.mulVec_add, hfix i hi, ← hy, lorentz_polar, lorentz_polar, hyev, lorentz_single,
      lorentz_single] at h1
    have e1 : (Pi.single (⟨k, hk⟩ : Fin (m + 1)) (1 : ℤ) : Fin (m + 1) → ℤ) 0 = 0 := by
      simp [Pi.single_apply, Ne.symm hk0]
    have e2 : ∑ j, (Pi.single (⟨k, hk⟩ : Fin (m + 1)) (1 : ℤ) : Fin (m + 1) → ℤ) j *
        (Pi.single i (1 : ℤ) : Fin (m + 1) → ℤ) j = 0 := by
      simp [Pi.single_apply, hki, hki.symm]
    rw [e1, e2, sum_mul_single] at h1
    by_cases hi0 : i = 0
    · subst hi0
      simp [hk0] at h1
      omega
    · have e3 : (Pi.single i (1 : ℤ) : Fin (m + 1) → ℤ) 0 = 0 := by
        simp [Pi.single_apply, Ne.symm hi0]
      rw [e3] at h1
      simp [hk0, hi0] at h1
      omega
  have hy0 : y 0 = 0 := ha 0 (by simp; omega)
  have hsum : ∑ i, y i ^ 2 = 1 := by
    rw [lorentz_eval, hy0] at hyev
    simp at hyev
    linarith
  obtain ⟨l, hl, hl'⟩ := sumsq_one y hsum
  have hlk : k ≤ l.val := by
    by_contra hc
    have := ha l (by omega)
    rcases hl with h | h <;> omega
  refine ⟨l, hlk, y l, hl, ?_⟩
  ext j
  by_cases hj : j = l
  · subst hj; simp
  · simp [Pi.single_apply, hj, hl' j hj]


/-- Helper: `permGL π` sends $e_c$ to $e_{\pi(c)}$. -/
theorem permGL_single {n : ℕ} (π : Equiv.Perm (Fin n)) (c : Fin n) :
    (permGL π).val *ᵥ (Pi.single c (1 : ℤ) : Fin n → ℤ) = Pi.single (π c) 1 := by
  rw [permGL_apply]
  ext j
  simp only [Function.comp_apply, Pi.single_apply]
  have : π.symm j = c ↔ j = π c := by rw [Equiv.symm_apply_eq]
  simp only [this]

/-- Helper: **the stabilizer of $e_0$** in the integral automorphs of $x_0^2 - \dots - x_m^2$ is generated by sign changes and transpositions of $x_1, \dots, x_m$: any subgroup containing these contains every automorph fixing $e_0$. -/
theorem stab_le (H0 : Subgroup (GL (Fin (m + 1)) ℤ)) (hf : ∀ i : Fin (m + 1), i ≠ 0 → flipGL i ∈ H0)
    (hs : ∀ i j : Fin (m + 1), i ≠ 0 → j ≠ 0 → swapGL i j ∈ H0) (T : GL (Fin (m + 1)) ℤ)
    (hT : T ∈ Siegel.Aut (lorentz m)) (he : T.val *ᵥ (Pi.single 0 (1 : ℤ) : Fin (m + 1) → ℤ) = Pi.single 0 1) :
    T ∈ H0 := by
  have claim : ∀ d : ℕ, d ≤ m → ∀ T : GL (Fin (m + 1)) ℤ, T ∈ Siegel.Aut (lorentz m) →
      FixesFirst T (m + 1 - d) → T ∈ H0 := by
    intro d
    induction d with
    | zero =>
      intro _ T _ hfix
      have : T = 1 := fixesFirst_all T (by simpa using hfix)
      rw [this]; exact one_mem _
    | succ d ih =>
      intro hd T hT hfix
      have hk : m - d < m + 1 := by omega
      have hk1 : 1 ≤ m - d := by omega
      have hfix' : FixesFirst T (m - d) := by
        have : m + 1 - (d + 1) = m - d := by omega
        rwa [this] at hfix
      obtain ⟨l, hlk, s, hs1, hTy⟩ := peel_step T hT (m - d) hk1 hk hfix'
      set kk : Fin (m + 1) := ⟨m - d, hk⟩ with hkk
      have hkk0 : kk ≠ 0 := by
        intro h; have := congrArg Fin.val h; simp [hkk] at this; omega
      have hl0 : l ≠ 0 := by
        intro h; subst h; simp at hlk; omega
      -- the correcting element
      obtain ⟨g, hgH, hgA, hgfix, hgk⟩ : ∃ g ∈ H0, g ∈ Siegel.Aut (lorentz m) ∧
          (∀ i : Fin (m + 1), i.val < m - d → g.val *ᵥ (Pi.single i (1 : ℤ) : Fin (m + 1) → ℤ) = Pi.single i 1) ∧
          g.val *ᵥ (s • (Pi.single l (1 : ℤ) : Fin (m + 1) → ℤ)) = Pi.single kk 1 := by
        have hswapA : swapGL kk l ∈ Siegel.Aut (lorentz m) :=
          permGL_mem_Aut_lorentz _ (by
            rw [Equiv.swap_apply_of_ne_of_ne hkk0.symm hl0.symm])
        have hswapfix : ∀ i : Fin (m + 1), i.val < m - d →
            (swapGL kk l).val *ᵥ (Pi.single i (1 : ℤ) : Fin (m + 1) → ℤ) = Pi.single i 1 := by
          intro i hi
          unfold swapGL
          rw [permGL_single]
          have h1 : i ≠ kk := by intro h; subst h; simp [hkk] at hi
          have h2 : i ≠ l := by intro h; subst h; omega
          rw [Equiv.swap_apply_of_ne_of_ne h1 h2]
        rcases hs1 with rfl | rfl
        · refine ⟨swapGL kk l, hs kk l hkk0 hl0, hswapA, hswapfix, ?_⟩
          unfold swapGL
          rw [one_smul, permGL_single, Equiv.swap_apply_right]
        · have hflipfix : ∀ i : Fin (m + 1), i.val < m - d →
              (flipGL l).val *ᵥ (Pi.single i (1 : ℤ) : Fin (m + 1) → ℤ) = Pi.single i 1 := by
            intro i hi
            rw [flipGL_apply]
            have h2 : i ≠ l := by intro h; subst h; omega
            ext j
            by_cases hj : j = l
            · subst hj; simp [Pi.single_apply, h2.symm]
            · simp [Function.update_of_ne hj]
          refine ⟨swapGL kk l * flipGL l, mul_mem (hs kk l hkk0 hl0) (hf l hl0), mul_mem hswapA (flipGL_mem_Aut l),
            fun i hi => ?_, ?_⟩
          · rw [Units.val_mul, ← Matrix.mulVec_mulVec, hflipfix i hi, hswapfix i hi]
          · have h3 : (flipGL l).val *ᵥ ((-1 : ℤ) • (Pi.single l (1 : ℤ) : Fin (m + 1) → ℤ)) =
                Pi.single l 1 := by
              rw [Matrix.mulVec_smul, flipGL_apply]
              ext j
              by_cases hj : j = l
              · subst hj; simp
              · simp [Function.update_of_ne hj, Pi.single_apply, hj]
            rw [Units.val_mul, ← Matrix.mulVec_mulVec, h3]
            unfold swapGL
            rw [permGL_single, Equiv.swap_apply_right]
      have hgT : FixesFirst (g * T) (m + 1 - d) := by
        intro i hi
        have : m + 1 - d = m - d + 1 := by omega
        rw [this] at hi
        rw [Units.val_mul, ← Matrix.mulVec_mulVec]
        by_cases hik : i.val < m - d
        · rw [hfix' i hik, hgfix i hik]
        · have : i = kk := by apply Fin.ext; simp [hkk]; omega
          subst this
          rw [hTy, hgk]
      have := ih (by omega) (g * T) (mul_mem hgA hT) hgT
      have h2 := mul_mem (inv_mem hgH) this
      simpa using h2
  apply claim m le_rfl T hT
  intro i hi
  have h0 : ((0 : Fin (m + 1)) : ℕ) = 0 := rfl
  have : i = 0 := by apply Fin.ext; omega
  subst this
  exact he

end Stab


/-! ### The symmetry $\tau$ in $(1,1,1,1,0,\dots,0)$ -/

section Tau

/-- The vector $(1,1,1,1,0,\dots,0)$. -/
def vT (m : ℕ) : Fin (m + 1) → ℤ := fun i => if i.val ≤ 3 then 1 else 0

/-- The functional $x \mapsto -x_0 + x_1 + x_2 + x_3$ (so that $\tau x = x - (\varphi\cdot x) v$). -/
def phiT (m : ℕ) : Fin (m + 1) → ℤ := fun i => if i.val = 0 then -1 else if i.val ≤ 3 then 1 else 0

/-- Helper: `Fin.succ 2 = 3` in `Fin (k+4)`. -/
theorem fin3 (k : ℕ) : (Fin.succ (2 : Fin (k + 3)) : Fin (k + 3 + 1)) = 3 := by
  ext; simp [Fin.val_succ]; rw [Nat.mod_eq_of_lt (by omega), Nat.mod_eq_of_lt (by omega)]

/-- Helper: $\varphi\cdot x = -x_0 + x_1 + x_2 + x_3$. -/
theorem phiT_dot (k : ℕ) (x : Fin (k + 3 + 1) → ℤ) : phiT (k + 3) ⬝ᵥ x = -x 0 + x 1 + x 2 + x 3 := by
  have hz : ∀ i : Fin k, ¬ ((i : ℕ) + 1 + 1 + 1 < 3) := fun i => by omega
  simp [dotProduct, Fin.sum_univ_succ, phiT, hz, fin3]
  ring

/-- Helper: $\varphi\cdot v = 2$ for the data of $\tau$. -/
theorem phiT_dot_vT (k : ℕ) : phiT (k + 3) ⬝ᵥ vT (k + 3) = 2 := by
  have hz : ∀ i : Fin k, ¬ ((i : ℕ) + 1 + 1 + 1 < 3) := fun i => by omega
  simp [dotProduct, Fin.sum_univ_succ, phiT, vT, hz]

/-- The symmetry $\tau$ in $(1,1,1,1,0,\dots,0)$ of $x_0^2 - x_1^2 - \dots - x_{k+3}^2$:
$\tau x = x + (x_0 - x_1 - x_2 - x_3)(1,1,1,1,0,\dots,0)$. -/
def tauGL (k : ℕ) : GL (Fin (k + 3 + 1)) ℤ := reflGL (phiT (k + 3)) (vT (k + 3)) (phiT_dot_vT k)

/-- Helper: $\tau x = x + (x_0 - x_1 - x_2 - x_3)(1,1,1,1,0,\dots,0)$. -/
theorem tauGL_apply (k : ℕ) (x : Fin (k + 3 + 1) → ℤ) :
    (tauGL k).val *ᵥ x = x + (x 0 - x 1 - x 2 - x 3) • vT (k + 3) := by
  rw [tauGL, reflGL_apply, phiT_dot]
  ext i; simp; ring

/-- Helper: $\tau$ is an integral automorph of $x_0^2 - \dots - x_{k+3}^2$. -/
theorem tauGL_mem_Aut (k : ℕ) : tauGL k ∈ Siegel.Aut (lorentz (k + 3)) := by
  rw [mem_Aut_iff]; intro x
  rw [tauGL_apply, lorentz_eval', lorentz_eval']
  have hz : ∀ i : Fin k, ¬ ((i : ℕ) + 1 + 1 + 1 < 3) := fun i => by omega
  simp [Fin.sum_univ_succ, vT, hz, fin3]
  ring

end Tau


/-! ### Normalizing signs -/

/-- Helper: if `H` contains all sign changes, some element of `H` replaces every coordinate of `a` by its absolute value. -/
theorem abs_fix {n : ℕ} (H : Subgroup (GL (Fin n) ℤ)) (hF : ∀ i, flipGL i ∈ H) (a : Fin n → ℤ) :
    ∃ D ∈ H, D.val *ᵥ a = fun j => |a j| := by
  have claim : ∀ s : Finset (Fin n), ∃ D ∈ H, ∀ j, (D.val *ᵥ a) j = if j ∈ s then |a j| else a j := by
    intro s
    induction s using Finset.induction_on with
    | empty => exact ⟨1, one_mem _, fun j => by simp⟩
    | insert i s hi ih =>
      obtain ⟨D, hD, hDa⟩ := ih
      have hDi : (D.val *ᵥ a) i = a i := by rw [hDa i]; simp [hi]
      by_cases hneg : 0 ≤ a i
      · refine ⟨D, hD, fun j => ?_⟩
        rw [hDa j]
        by_cases hj : j = i
        · subst hj; simp [abs_of_nonneg hneg]
        · simp [hj]
      · refine ⟨flipGL i * D, mul_mem (hF i) hD, fun j => ?_⟩
        rw [Units.val_mul, ← Matrix.mulVec_mulVec, flipGL_apply]
        by_cases hj : j = i
        · subst hj
          simp [hDi, abs_of_neg (not_le.1 hneg)]
        · rw [Function.update_of_ne hj, hDa j]
          simp [hj]
  obtain ⟨D, hD, hDa⟩ := claim Finset.univ
  exact ⟨D, hD, by ext j; rw [hDa j]; simp⟩

/-! ### Exercise 17 -/

section Ex17

/-- The symmetry $\tau$ in $(1,1,1,1)$ for $f = x_0^2 - x_1^2 - x_2^2 - x_3^2$. -/
def tau3 : GL (Fin 4) ℤ := tauGL 0

/-- Helper: coordinates of $\tau a$ in dimension $4$. -/
theorem tau3_apply (x : Fin 4 → ℤ) : tau3.val *ᵥ x =
    ![x 0 + (x 0 - x 1 - x 2 - x 3), x 1 + (x 0 - x 1 - x 2 - x 3), x 2 + (x 0 - x 1 - x 2 - x 3),
      x 3 + (x 0 - x 1 - x 2 - x 3)] := by
  rw [tau3, tauGL_apply]
  ext i; fin_cases i <;> simp [vT]

/-- Helper: $Q(x) = x_0^2 - x_1^2 - x_2^2 - x_3^2$ on integer vectors of length $4$. -/
theorem lorentz3_eval (x : Fin 4 → ℤ) : (lorentz 3).eval x = x 0 ^ 2 - x 1 ^ 2 - x 2 ^ 2 - x 3 ^ 2 := by
  rw [lorentz_eval']; simp [Fin.sum_univ_three]; ring

/-- Helper: $\tau$ is an integral automorph of $x_0^2 - x_1^2 - x_2^2 - x_3^2$. -/
theorem tau3_mem : tau3 ∈ Siegel.Aut (lorentz 3) := tauGL_mem_Aut 0

/-- The generators of Exercise 17 (ii): $\tau$, the sign changes $x_j \mapsto -x_j$ ($0 \le j \le 3$) and the
permutations of $x_1, x_2, x_3$ (the permutations of the four coordinates fixing the coordinate $0$). -/
def ex17Gens : Set (GL (Fin 4) ℤ) :=
  {tau3} ∪ Set.range (flipGL (n := 4)) ∪ {g | ∃ π : Equiv.Perm (Fin 4), π 0 = 0 ∧ permGL π = g}

/-- Helper: the generators of Exercise 17 are integral automorphs. -/
theorem ex17Gens_sub : ex17Gens ⊆ (Siegel.Aut (lorentz 3) : Set (GL (Fin 4) ℤ)) := by
  rintro g ((rfl | ⟨i, rfl⟩) | ⟨π, h0, rfl⟩)
  · exact tau3_mem
  · exact flipGL_mem_Aut i
  · exact permGL_mem_Aut_lorentz π h0

/-- Helper: sign changes lie in the group generated by `ex17Gens`. -/
theorem ex17_flip_mem (i : Fin 4) : flipGL i ∈ Subgroup.closure ex17Gens :=
  Subgroup.subset_closure (Or.inl (Or.inr ⟨i, rfl⟩))

/-- Helper: $\tau$ lies in the group generated by `ex17Gens`. -/
theorem ex17_tau_mem : tau3 ∈ Subgroup.closure ex17Gens :=
  Subgroup.subset_closure (Or.inl (Or.inl rfl))

/-- Helper: transpositions of $x_i, x_j$ ($i, j \ne 0$) lie in the group generated by `ex17Gens`. -/
theorem ex17_swap_mem (i j : Fin 4) (hi : i ≠ 0) (hj : j ≠ 0) :
    swapGL i j ∈ Subgroup.closure ex17Gens :=
  Subgroup.subset_closure (Or.inr ⟨Equiv.swap i j, by
    rw [Equiv.swap_apply_of_ne_of_ne hi.symm hj.symm], rfl⟩)

/-- Helper: integral form of Ex. 17 (i): for $a \in \mathbb Z^4$ with all $a_j \ge 0$, $f(a) = 1$ and $a \ne e_0$, the symmetry $\tau$ in $(1,1,1,1)$ satisfies $|(\tau a)_0| < |a_0|$. This is the form needed for (ii); see `ex17_i` for the erratum. -/
theorem ex17_i_int (a : Fin 4 → ℤ) (hnn : ∀ j, 0 ≤ a j) (hf : (lorentz 3).eval a = 1)
    (hne : a ≠ Pi.single 0 1) : |(tau3.val *ᵥ a) 0| < |a 0| := by
  rw [lorentz3_eval] at hf
  rw [tau3_apply]
  simp only [Matrix.cons_val_zero]
  have h0 := hnn 0; have h1 := hnn 1; have h2 := hnn 2; have h3 := hnn 3
  have ha0 : 1 ≤ a 0 := by nlinarith
  have ha0' : 2 ≤ a 0 := by
    by_contra hc
    have : a 0 = 1 := by omega
    have e1 : a 1 = 0 := by nlinarith
    have e2 : a 2 = 0 := by nlinarith
    have e3 : a 3 = 0 := by nlinarith
    apply hne
    ext i; fin_cases i <;> simp [this, e1, e2, e3]
  have lower : a 0 < a 1 + a 2 + a 3 := by
    by_contra hc
    push Not at hc
    have hS0 : 0 ≤ a 1 + a 2 + a 3 := by omega
    have hP : 0 ≤ a 1 * a 2 + a 1 * a 3 + a 2 * a 3 := by positivity
    have hsq : (a 1 + a 2 + a 3) ^ 2 ≤ a 0 ^ 2 := by nlinarith
    have e : (a 1 + a 2 + a 3) ^ 2 = a 1 ^ 2 + a 2 ^ 2 + a 3 ^ 2 + 2 * (a 1 * a 2 + a 1 * a 3 + a 2 * a 3) := by ring
    have hP0 : a 1 * a 2 + a 1 * a 3 + a 2 * a 3 = 0 := by nlinarith
    have hS : (a 1 + a 2 + a 3) ^ 2 = a 0 ^ 2 - 1 := by rw [e, hP0]; nlinarith
    have : a 0 - (a 1 + a 2 + a 3) = 0 ∨ 1 ≤ a 0 - (a 1 + a 2 + a 3) := by omega
    rcases this with h | h
    · nlinarith
    · nlinarith
  have upper : a 1 + a 2 + a 3 < 3 * a 0 := by
    by_contra hc
    push Not at hc
    nlinarith [sq_nonneg (a 1 - a 2), sq_nonneg (a 1 - a 3), sq_nonneg (a 2 - a 3)]
  rw [abs_of_nonneg h0, abs_lt]
  constructor <;> linarith


/-- Helper: the group generated by `ex17Gens` consists of integral automorphs. -/
theorem ex17_closure_le : Subgroup.closure ex17Gens ≤ Siegel.Aut (lorentz 3) :=
  (Subgroup.closure_le _).2 ex17Gens_sub

/-- Helper: descent for Exercise 17: every integer vector with $f = 1$ is moved to $e_0$ by the group generated by `ex17Gens`. -/
theorem ex17_desc : ∀ (N : ℕ) (a : Fin 4 → ℤ), (a 0).natAbs = N → (lorentz 3).eval a = 1 →
    ∃ h ∈ Subgroup.closure ex17Gens, h.val *ᵥ a = Pi.single 0 1 := by
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
    intro a hN hf
    obtain ⟨D, hD, hDa⟩ := abs_fix (Subgroup.closure ex17Gens) ex17_flip_mem a
    set a' := D.val *ᵥ a with ha'
    have hDA : D ∈ Siegel.Aut (lorentz 3) := ex17_closure_le hD
    have hf' : (lorentz 3).eval a' = 1 := by rw [ha', hDA a]; exact hf
    have hnn : ∀ j, 0 ≤ a' j := fun j => by rw [hDa]; exact abs_nonneg _
    by_cases he : a' = Pi.single 0 1
    · exact ⟨D, hD, he⟩
    · have hlt := ex17_i_int a' hnn hf' he
      set b := tau3.val *ᵥ a' with hb
      have hbf : (lorentz 3).eval b = 1 := by rw [hb, tau3_mem a']; exact hf'
      have hlt' : (b 0).natAbs < N := by
        have e1 : |a' 0| = |a 0| := by rw [hDa]; simp
        rw [e1] at hlt
        rw [← hN]
        rw [Int.abs_eq_natAbs, Int.abs_eq_natAbs] at hlt
        exact_mod_cast hlt
      obtain ⟨h', hh', hh'b⟩ := ih _ hlt' b rfl hbf
      refine ⟨h' * tau3 * D, mul_mem (mul_mem hh' ex17_tau_mem) hD, ?_⟩
      rw [Units.val_mul, Units.val_mul, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
      exact hh'b


/-- **Cassels, Ch. 9, Ex. 17 (ii), p. 167.** The group of integral automorphs of $f = x_0^2 - x_1^2 - x_2^2 - x_3^2$ is generated by $\tau$, the sign changes $x_j \mapsto -x_j$ and the permutations of $x_1,x_2,x_3$ (`ex17Gens`). -/
@[kb "cassels1978" "Ch. 9, Ex. 17 (ii), p. 167"]
theorem ex17_ii : Siegel.Aut (lorentz 3) = Subgroup.closure ex17Gens := by
  refine le_antisymm (fun g hg => ?_) ex17_closure_le
  have hfe : (lorentz 3).eval (g.val *ᵥ (Pi.single 0 1 : Fin 4 → ℤ)) = 1 := by
    rw [hg, lorentz_single]; simp
  obtain ⟨h, hh, hhg⟩ := ex17_desc _ _ rfl hfe
  have hA : h * g ∈ Siegel.Aut (lorentz 3) := mul_mem (ex17_closure_le hh) hg
  have hs := stab_le (Subgroup.closure ex17Gens) (fun i hi => ex17_flip_mem i)
    (fun i j hi hj => ex17_swap_mem i j hi hj) (h * g) hA
    (by rw [Units.val_mul, ← Matrix.mulVec_mulVec]; exact hhg)
  have := mul_mem (inv_mem hh) hs
  simpa using this

/-- Helper: the real form $x_0^2 - x_1^2 - x_2^2 - x_3^2$ evaluated at a real vector. -/
theorem lorentz3R_eval (x : Fin 4 → ℝ) :
    ((lorentz 3).map (Int.castRingHom ℝ)).eval x = x 0 ^ 2 - x 1 ^ 2 - x 2 ^ 2 - x 3 ^ 2 := by
  simp [lorentz, Siegel.ofGram, lorentzGram, QuadForm.map, QuadForm.ofUpper, QuadForm.evalIn,
    Fin.sum_univ_four, Matrix.diagonal_apply]
  ring


/-- Helper: the $0$-th coordinate of the symmetry in $(1,1,1,1)$ applied to `a` is $2a_0 - a_1 - a_2 - a_3$. -/
theorem refl0_ex17 (a : Fin 4 → ℝ) :
    reflectionBy ((lorentz 3).map (Int.castRingHom ℝ)) ![1, 1, 1, 1] a 0 = 2 * a 0 - a 1 - a 2 - a 3 := by
  have hv : ((lorentz 3).map (Int.castRingHom ℝ)).eval ![1, 1, 1, 1] = -2 := by
    rw [lorentz3R_eval]; norm_num
  unfold reflectionBy
  rw [hv, lorentz3R_eval, lorentz3R_eval]
  simp
  field_simp
  ring

/-- **Cassels, Ch. 9, Ex. 17 (i), p. 167.** Let $a \in \mathbb R^4$ with $f(a) > 0$ and all $a_j \ge 0$, and let $b = \tau a$ be its symmetry in $(1,1,1,1)$. Then $|b_0| < |a_0|$, *provided that $a_0 < a_1 + a_2 + a_3$* (hypothesis `hS`).

*Erratum:* the printed statement has no such hypothesis and is false without it: $a = (1,0,0,0)$ has $f(a) = 1$ and $(\tau a)_0 = 2$, and $a = (10,1,0,0)$ gives $(\tau a)_0 = 19$ (confirmed by direct computation). The corrected hypothesis is what the book's use (the descent in (ii)) needs: for integral $a \ne e_0$ with $f(a) = 1$ and $a_j \ge 0$ it holds automatically (`ex17_i_int`). -/
@[kb "cassels1978" "Ch. 9, Ex. 17 (i), p. 167"]
theorem ex17_i (a : Fin 4 → ℝ) (hf : 0 < ((lorentz 3).map (Int.castRingHom ℝ)).eval a)
    (hnn : ∀ j, 0 ≤ a j) (hS : a 0 < a 1 + a 2 + a 3) :
    |reflectionBy ((lorentz 3).map (Int.castRingHom ℝ)) ![1, 1, 1, 1] a 0| < |a 0| := by
  rw [lorentz3R_eval] at hf
  rw [refl0_ex17]
  have h0 := hnn 0; have h1 := hnn 1; have h2 := hnn 2; have h3 := hnn 3
  have a0pos : 0 < a 0 := by
    by_contra hc
    have : a 0 = 0 := le_antisymm (not_lt.1 hc) h0
    nlinarith [sq_nonneg (a 1), sq_nonneg (a 2), sq_nonneg (a 3)]
  have upper : a 1 + a 2 + a 3 < 3 * a 0 := by
    by_contra hc
    push Not at hc
    nlinarith [sq_nonneg (a 1 - a 2), sq_nonneg (a 1 - a 3), sq_nonneg (a 2 - a 3)]
  rw [abs_of_pos a0pos, abs_lt]
  constructor <;> linarith

end Ex17


/-! ### Exercise 19 (i): $f = x_0^2 - x_1^2 - x_2^2$ -/

section Ex19i

/-- The symmetry $\rho$ in $(1,1,1)$ for $f = x_0^2 - x_1^2 - x_2^2$ ($f(1,1,1) = -1$):
$\rho x = x + 2(x_0 - x_1 - x_2)(1,1,1)$. -/
def rho2 : GL (Fin 3) ℤ :=
  reflGL ![-2, 2, 2] ![1, 1, 1] (by simp [dotProduct, Fin.sum_univ_three])

/-- Helper: coordinates of $\rho x$. -/
theorem rho2_apply (x : Fin 3 → ℤ) : rho2.val *ᵥ x =
    ![x 0 + 2 * (x 0 - x 1 - x 2), x 1 + 2 * (x 0 - x 1 - x 2), x 2 + 2 * (x 0 - x 1 - x 2)] := by
  rw [rho2, reflGL_apply]
  ext i; fin_cases i <;> simp [dotProduct, Fin.sum_univ_three] <;> ring

/-- Helper: $Q(x) = x_0^2 - x_1^2 - x_2^2$. -/
theorem lorentz2_eval (x : Fin 3 → ℤ) : (lorentz 2).eval x = x 0 ^ 2 - x 1 ^ 2 - x 2 ^ 2 := by
  rw [lorentz_eval']; simp [Fin.sum_univ_two]; ring

/-- Helper: $\rho$ is an integral automorph of $x_0^2 - x_1^2 - x_2^2$. -/
theorem rho2_mem : rho2 ∈ Siegel.Aut (lorentz 2) := by
  rw [mem_Aut_iff]; intro x
  rw [rho2_apply, lorentz2_eval, lorentz2_eval]
  simp; ring

/-- Generators for Exercise 19 (i). -/
def ex19iGens : Set (GL (Fin 3) ℤ) :=
  {rho2} ∪ Set.range (flipGL (n := 3)) ∪ {g | ∃ π : Equiv.Perm (Fin 3), π 0 = 0 ∧ permGL π = g}

/-- Helper: the generators of Exercise 19 (i) are integral automorphs. -/
theorem ex19i_sub : ex19iGens ⊆ (Siegel.Aut (lorentz 2) : Set (GL (Fin 3) ℤ)) := by
  rintro g ((rfl | ⟨i, rfl⟩) | ⟨π, h0, rfl⟩)
  · exact rho2_mem
  · exact flipGL_mem_Aut i
  · exact permGL_mem_Aut_lorentz π h0

/-- Helper: sign changes lie in the group generated by `ex19iGens`. -/
theorem ex19i_flip_mem (i : Fin 3) : flipGL i ∈ Subgroup.closure ex19iGens :=
  Subgroup.subset_closure (Or.inl (Or.inr ⟨i, rfl⟩))

/-- Helper: $\rho$ lies in the group generated by `ex19iGens`. -/
theorem ex19i_rho_mem : rho2 ∈ Subgroup.closure ex19iGens :=
  Subgroup.subset_closure (Or.inl (Or.inl rfl))

/-- Helper: transpositions of $x_1, x_2$ lie in the group generated by `ex19iGens`. -/
theorem ex19i_swap_mem (i j : Fin 3) (hi : i ≠ 0) (hj : j ≠ 0) :
    swapGL i j ∈ Subgroup.closure ex19iGens :=
  Subgroup.subset_closure (Or.inr ⟨Equiv.swap i j, by
    rw [Equiv.swap_apply_of_ne_of_ne hi.symm hj.symm], rfl⟩)

/-- Helper: the group generated by `ex19iGens` consists of integral automorphs. -/
theorem ex19i_closure_le : Subgroup.closure ex19iGens ≤ Siegel.Aut (lorentz 2) :=
  (Subgroup.closure_le _).2 ex19i_sub

/-- Helper: for a non-negative integer vector `a` with $f(a) = 1$, $a \ne e_0$, $|(\rho a)_0| < |a_0|$. -/
theorem ex19i_step (a : Fin 3 → ℤ) (hnn : ∀ j, 0 ≤ a j) (hf : (lorentz 2).eval a = 1)
    (hne : a ≠ Pi.single 0 1) : |(rho2.val *ᵥ a) 0| < |a 0| := by
  rw [lorentz2_eval] at hf
  rw [rho2_apply]
  simp only [Matrix.cons_val_zero]
  have h0 := hnn 0; have h1 := hnn 1; have h2 := hnn 2
  have ha0 : 1 ≤ a 0 := by nlinarith
  have ha0' : 2 ≤ a 0 := by
    by_contra hc
    have : a 0 = 1 := by omega
    have e1 : a 1 = 0 := by nlinarith
    have e2 : a 2 = 0 := by nlinarith
    apply hne
    ext i; fin_cases i <;> simp [this, e1, e2]
  have lower : a 0 < a 1 + a 2 := by
    by_contra hc
    push Not at hc
    have hP : 0 ≤ a 1 * a 2 := by positivity
    have hsq : (a 1 + a 2) ^ 2 ≤ a 0 ^ 2 := by nlinarith
    have hP0 : a 1 * a 2 = 0 := by nlinarith
    have hS : (a 1 + a 2) ^ 2 = a 0 ^ 2 - 1 := by nlinarith
    have : a 0 - (a 1 + a 2) = 0 ∨ 1 ≤ a 0 - (a 1 + a 2) := by omega
    rcases this with h | h
    · nlinarith
    · nlinarith
  have upper : a 1 + a 2 < 2 * a 0 := by
    by_contra hc
    push Not at hc
    nlinarith [sq_nonneg (a 1 - a 2)]
  rw [abs_of_nonneg h0, abs_lt]
  constructor <;> linarith

/-- Helper: descent for Exercise 19 (i): every integer vector with $f = 1$ is moved to $e_0$. -/
theorem ex19i_desc : ∀ (N : ℕ) (a : Fin 3 → ℤ), (a 0).natAbs = N → (lorentz 2).eval a = 1 →
    ∃ h ∈ Subgroup.closure ex19iGens, h.val *ᵥ a = Pi.single 0 1 := by
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
    intro a hN hf
    obtain ⟨D, hD, hDa⟩ := abs_fix (Subgroup.closure ex19iGens) ex19i_flip_mem a
    set a' := D.val *ᵥ a with ha'
    have hDA : D ∈ Siegel.Aut (lorentz 2) := ex19i_closure_le hD
    have hf' : (lorentz 2).eval a' = 1 := by rw [ha', hDA a]; exact hf
    have hnn : ∀ j, 0 ≤ a' j := fun j => by rw [hDa]; exact abs_nonneg _
    by_cases he : a' = Pi.single 0 1
    · exact ⟨D, hD, he⟩
    · have hlt := ex19i_step a' hnn hf' he
      set b := rho2.val *ᵥ a' with hb
      have hbf : (lorentz 2).eval b = 1 := by rw [hb, rho2_mem a']; exact hf'
      have hlt' : (b 0).natAbs < N := by
        have e1 : |a' 0| = |a 0| := by rw [hDa]; simp
        rw [e1] at hlt
        rw [← hN]
        rw [Int.abs_eq_natAbs, Int.abs_eq_natAbs] at hlt
        exact_mod_cast hlt
      obtain ⟨h', hh', hh'b⟩ := ih _ hlt' b rfl hbf
      refine ⟨h' * rho2 * D, mul_mem (mul_mem hh' ex19i_rho_mem) hD, ?_⟩
      rw [Units.val_mul, Units.val_mul, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
      exact hh'b

/-- **Cassels, Ch. 9, Ex. 19 (i), p. 167.** The group of integral automorphs of $x_0^2 - x_1^2 - x_2^2$ is generated by the symmetry $\rho$ in $(1,1,1)$, the three sign changes and the transposition of $x_1, x_2$ (`ex19iGens`). *Answer computed (the book only cites Wall 1964), proved by the same descent as Ex. 16--18.* -/
@[kb "cassels1978" "Ch. 9, Ex. 19 (i), p. 167"]
theorem ex19_i : Siegel.Aut (lorentz 2) = Subgroup.closure ex19iGens := by
  refine le_antisymm (fun g hg => ?_) ex19i_closure_le
  have hfe : (lorentz 2).eval (g.val *ᵥ (Pi.single 0 1 : Fin 3 → ℤ)) = 1 := by
    rw [hg, lorentz_single]; simp
  obtain ⟨h, hh, hhg⟩ := ex19i_desc _ _ rfl hfe
  have hA : h * g ∈ Siegel.Aut (lorentz 2) := mul_mem (ex19i_closure_le hh) hg
  have hs := stab_le (Subgroup.closure ex19iGens) (fun i hi => ex19i_flip_mem i)
    (fun i j hi hj => ex19i_swap_mem i j hi hj) (h * g) hA
    (by rw [Units.val_mul, ← Matrix.mulVec_mulVec]; exact hhg)
  have := mul_mem (inv_mem hh) hs
  simpa using this

end Ex19i


/-! ## Exercise 18: $x_0^2 - x_1^2 - \dots - x_m^2$, $3 \le m \le 9$ (written $m = k+3$, $0 \le k \le 6$) -/

section Ex18

/-- The generators of Exercise 18: $\tau$ (the symmetry in $(1,1,1,1,0,\dots,0)$), the sign changes of all
coordinates, and the permutations of $x_1, \dots, x_m$ (permutations fixing the coordinate $0$). -/
def GensK (k : ℕ) : Set (GL (Fin (k + 3 + 1)) ℤ) :=
  {tauGL k} ∪ Set.range (flipGL (n := k + 3 + 1)) ∪ {g | ∃ π : Equiv.Perm (Fin (k + 3 + 1)), π 0 = 0 ∧ permGL π = g}

/-- The subgroup generated. -/
def HK (k : ℕ) : Subgroup (GL (Fin (k + 3 + 1)) ℤ) := Subgroup.closure (GensK k)

/-- Helper: `HK k` consists of integral automorphs. -/
theorem HK_le_Aut (k : ℕ) : HK k ≤ Siegel.Aut (lorentz (k + 3)) := by
  refine (Subgroup.closure_le _).2 ?_
  rintro g ((rfl | ⟨i, rfl⟩) | ⟨π, h0, rfl⟩)
  · exact tauGL_mem_Aut k
  · exact flipGL_mem_Aut i
  · exact permGL_mem_Aut_lorentz π h0

/-- Helper: sign changes lie in `HK k`. -/
theorem HK_flip (k : ℕ) (i : Fin (k + 3 + 1)) : flipGL i ∈ HK k :=
  Subgroup.subset_closure (Or.inl (Or.inr ⟨i, rfl⟩))
/-- Helper: $\tau \in$ `HK k`. -/
theorem HK_tau (k : ℕ) : tauGL k ∈ HK k := Subgroup.subset_closure (Or.inl (Or.inl rfl))
/-- Helper: permutations fixing the coordinate $0$ lie in `HK k`. -/
theorem HK_perm (k : ℕ) (π : Equiv.Perm (Fin (k + 3 + 1))) (h0 : π 0 = 0) : permGL π ∈ HK k :=
  Subgroup.subset_closure (Or.inr ⟨π, h0, rfl⟩)
/-- Helper: transpositions of $x_i, x_j$ ($i, j \ne 0$) lie in `HK k`. -/
theorem HK_swap (k : ℕ) (i j : Fin (k + 3 + 1)) (hi : i ≠ 0) (hj : j ≠ 0) : swapGL i j ∈ HK k :=
  HK_perm k _ (by rw [Equiv.swap_apply_of_ne_of_ne hi.symm hj.symm])

/-- The elements of `HK k` fixing $e_i$ for all $i > c$. -/
def KK (k c : ℕ) : Subgroup (GL (Fin (k + 3 + 1)) ℤ) where
  carrier := {h | h ∈ HK k ∧ ∀ i : Fin (k + 3 + 1), c < i.val →
    h.val *ᵥ (Pi.single i (1 : ℤ) : Fin (k + 3 + 1) → ℤ) = Pi.single i 1}
  mul_mem' := by
    rintro g h ⟨hg, hg'⟩ ⟨hh, hh'⟩
    refine ⟨mul_mem hg hh, fun i hi => ?_⟩
    rw [Units.val_mul, ← Matrix.mulVec_mulVec, hh' i hi, hg' i hi]
  one_mem' := ⟨one_mem _, fun i _ => by simp only [Units.val_one, Matrix.one_mulVec]⟩
  inv_mem' := by
    rintro g ⟨hg, hg'⟩
    refine ⟨inv_mem hg, fun i hi => ?_⟩
    calc (g⁻¹).val *ᵥ (Pi.single i (1 : ℤ) : Fin (k + 3 + 1) → ℤ)
        = (g⁻¹).val *ᵥ (g.val *ᵥ (Pi.single i (1 : ℤ) : Fin (k + 3 + 1) → ℤ)) := by rw [hg' i hi]
      _ = Pi.single i 1 := by
        rw [Matrix.mulVec_mulVec, ← Units.val_mul, inv_mul_cancel]; simp only [Units.val_one, Matrix.one_mulVec]

/-- Helper: `flipGL i` fixes $e_l$ for $l \ne i$. -/
theorem flip_fix {n : ℕ} (i l : Fin n) (h : l ≠ i) :
    (flipGL i).val *ᵥ (Pi.single l (1 : ℤ) : Fin n → ℤ) = Pi.single l 1 := by
  rw [flipGL_apply]
  ext j
  by_cases hj : j = i
  · subst hj; simp [Pi.single_apply, h]
  · simp [Function.update_of_ne hj]


/-- Helper: if an automorph fixes $e_i$ then the $i$-th coordinate of its image of $e_c$ ($c \ne i$) is $0$. -/
theorem col_orth {m : ℕ} (T : GL (Fin (m + 1)) ℤ) (hT : T ∈ Siegel.Aut (lorentz m)) (i c : Fin (m + 1))
    (hi : T.val *ᵥ (Pi.single i (1 : ℤ) : Fin (m + 1) → ℤ) = Pi.single i 1) (hic : c ≠ i) :
    (T.val *ᵥ (Pi.single c (1 : ℤ) : Fin (m + 1) → ℤ)) i = 0 := by
  set y := T.val *ᵥ (Pi.single c (1 : ℤ) : Fin (m + 1) → ℤ) with hy
  have hyev : (lorentz m).eval y = (lorentz m).eval (Pi.single c (1 : ℤ) : Fin (m + 1) → ℤ) := hT _
  have h1 := hT (Pi.single c 1 + Pi.single i 1)
  rw [Matrix.mulVec_add, hi, ← hy, lorentz_polar, lorentz_polar, hyev] at h1
  have e2 : ∑ j, (Pi.single c (1 : ℤ) : Fin (m + 1) → ℤ) j * (Pi.single i (1 : ℤ) : Fin (m + 1) → ℤ) j = 0 := by
    simp [Pi.single_apply, hic, Ne.symm hic]
  rw [e2, sum_mul_single] at h1
  by_cases hi0 : i = 0
  · subst hi0
    have e1 : (Pi.single c (1 : ℤ) : Fin (m + 1) → ℤ) 0 = 0 := by simp [Pi.single_apply, hic]
    rw [e1] at h1
    simp at h1
    omega
  · have e3 : (Pi.single i (1 : ℤ) : Fin (m + 1) → ℤ) 0 = 0 := by simp [Pi.single_apply, Ne.symm hi0]
    rw [e3] at h1
    simp at h1
    omega

/-- Helper: the numerals $1, 2, 3$ of `Fin (k+4)` have values $1, 2, 3$. -/
theorem lit_val (k : ℕ) : ((1 : Fin (k + 3 + 1)).val = 1) ∧ ((2 : Fin (k + 3 + 1)).val = 2) ∧
    ((3 : Fin (k + 3 + 1)).val = 3) := by
  refine ⟨?_, ?_, ?_⟩ <;> simp [Fin.val_ofNat] <;> rw [Nat.mod_eq_of_lt (by omega)]

/-- Helper: $\tau$ fixes $e_l$ for $l \ge 4$. -/
theorem tau_fix (k : ℕ) (l : Fin (k + 3 + 1)) (hl : 4 ≤ l.val) :
    (tauGL k).val *ᵥ (Pi.single l (1 : ℤ) : Fin (k + 3 + 1) → ℤ) = Pi.single l 1 := by
  rw [tauGL_apply]
  have hz : ∀ j : Fin (k + 3 + 1), j.val ≤ 3 → (Pi.single l (1 : ℤ) : Fin (k + 3 + 1) → ℤ) j = 0 := by
    intro j hj
    rw [Pi.single_apply, if_neg]
    intro h; subst h; omega
  obtain ⟨v1, v2, v3⟩ := lit_val k
  rw [hz 0 (by simp), hz 1 (by omega), hz 2 (by omega), hz 3 (by omega)]
  simp


/-- Helper: like `abs_fix`, for a subgroup containing the sign changes of the coordinates satisfying `p`. -/
theorem abs_fix_on {n : ℕ} (H : Subgroup (GL (Fin n) ℤ)) (p : Fin n → Prop) [DecidablePred p]
    (hF : ∀ i, p i → flipGL i ∈ H) (a : Fin n → ℤ) :
    ∃ D ∈ H, ∀ j, (D.val *ᵥ a) j = if p j then |a j| else a j := by
  have claim : ∀ s : Finset (Fin n), ∃ D ∈ H, ∀ j, (D.val *ᵥ a) j = if (j ∈ s ∧ p j) then |a j| else a j := by
    intro s
    induction s using Finset.induction_on with
    | empty => exact ⟨1, one_mem _, fun j => by simp⟩
    | insert i s hi ih =>
      obtain ⟨D, hD, hDa⟩ := ih
      by_cases hpi : p i
      · have hDi : (D.val *ᵥ a) i = a i := by rw [hDa i]; simp [hi]
        by_cases hneg : 0 ≤ a i
        · refine ⟨D, hD, fun j => ?_⟩
          rw [hDa j]
          by_cases hj : j = i
          · subst hj; simp [abs_of_nonneg hneg, hpi, hi]
          · simp [hj]
        · refine ⟨flipGL i * D, mul_mem (hF i hpi) hD, fun j => ?_⟩
          rw [Units.val_mul, ← Matrix.mulVec_mulVec, flipGL_apply]
          by_cases hj : j = i
          · subst hj
            simp [hDi, abs_of_neg (not_le.1 hneg), hpi]
          · rw [Function.update_of_ne hj, hDa j]
            simp [hj]
      · refine ⟨D, hD, fun j => ?_⟩
        rw [hDa j]
        by_cases hj : j = i
        · subst hj; simp [hpi]
        · simp [hj]
  obtain ⟨D, hD, hDa⟩ := claim Finset.univ
  exact ⟨D, hD, fun j => by rw [hDa j]; simp⟩

/-- Vectors supported on the first `c + 1` coordinates. -/
def Supp {n : ℕ} (c : ℕ) (b : Fin n → ℤ) : Prop := ∀ i : Fin n, c < i.val → b i = 0


/-- Helper: sign changes of coordinates $\le c$ lie in `KK k c`. -/
theorem flip_KK (k c : ℕ) (i : Fin (k + 3 + 1)) (hi : i.val ≤ c) : flipGL i ∈ KK k c :=
  ⟨HK_flip k i, fun l hl => flip_fix i l (by intro h; subst h; omega)⟩

/-- Helper: transpositions of non-zero coordinates $\le c$ lie in `KK k c`. -/
theorem swap_KK (k c : ℕ) (i j : Fin (k + 3 + 1)) (hi0 : i ≠ 0) (hj0 : j ≠ 0) (hi : i.val ≤ c)
    (hj : j.val ≤ c) : swapGL i j ∈ KK k c := by
  refine ⟨HK_swap k i j hi0 hj0, fun l hl => ?_⟩
  unfold swapGL
  rw [permGL_single, Equiv.swap_apply_of_ne_of_ne (by intro h; subst h; omega) (by intro h; subst h; omega)]

/-- Helper: $\tau \in$ `KK k c` for $c \ge 3$. -/
theorem tau_KK (k c : ℕ) (hc : 3 ≤ c) : tauGL k ∈ KK k c :=
  ⟨HK_tau k, fun l hl => tau_fix k l (by omega)⟩


/-- Helper: the numerals $0, 1, 2, 3$ of `Fin (k+4)` are pairwise distinct. -/
theorem lit_ne (k : ℕ) : ((1 : Fin (k + 3 + 1)) ≠ 2) ∧ ((1 : Fin (k + 3 + 1)) ≠ 3) ∧ ((2 : Fin (k + 3 + 1)) ≠ 3) ∧
    ((1 : Fin (k + 3 + 1)) ≠ 0) ∧ ((2 : Fin (k + 3 + 1)) ≠ 0) ∧ ((3 : Fin (k + 3 + 1)) ≠ 0) := by
  obtain ⟨v1, v2, v3⟩ := lit_val k
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> intro h <;> have := congrArg Fin.val h <;> simp only [v1, v2, v3, Fin.val_zero] at this <;> omega

/-- Helper: some element of `KK k c` permutes the coordinates $1..c$ so that coordinate $3$ is a third largest. -/
theorem top3 (k c : ℕ) (hc3 : 3 ≤ c) (hcm : c ≤ k + 3) (x : Fin (k + 3 + 1) → ℤ) :
    ∃ g ∈ KK k c, ∃ σ : Equiv.Perm (Fin (k + 3 + 1)), g.val *ᵥ x = x ∘ σ ∧
      (∀ j, (j.val = 0 ∨ c < j.val) → σ j = j) ∧ x (σ 3) ≤ x (σ 1) ∧ x (σ 3) ≤ x (σ 2) ∧
      ∀ j : Fin (k + 3 + 1), 4 ≤ j.val → j.val ≤ c → x (σ j) ≤ x (σ 3) := by
  classical
  obtain ⟨v1, v2, v3⟩ := lit_val k
  obtain ⟨n12, n13, n23, n10, n20, n30⟩ := lit_ne k
  set P := Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 3 + 1)) =>
    ∀ j : Fin (k + 3 + 1), (j.val = 0 ∨ c < j.val) → σ j = j) with hP
  obtain ⟨σ, hσP, hmax⟩ := Finset.exists_max_image P (fun σ => 4 * x (σ 1) + 2 * x (σ 2) + x (σ 3))
    ⟨1, by simp [hP]⟩
  simp only [hP, Finset.mem_filter, Finset.mem_univ, true_and] at hσP hmax
  -- improving swaps
  have improve : ∀ a b : Fin (k + 3 + 1), a.val ≠ 0 → b.val ≠ 0 → a.val ≤ c → b.val ≤ c →
      4 * x (σ (Equiv.swap a b 1)) + 2 * x (σ (Equiv.swap a b 2)) + x (σ (Equiv.swap a b 3)) ≤
      4 * x (σ 1) + 2 * x (σ 2) + x (σ 3) := by
    intro a b ha hb hac hbc
    refine hmax (σ * Equiv.swap a b) ?_
    intro j hj
    simp only [Equiv.Perm.mul_apply]
    rw [Equiv.swap_apply_of_ne_of_ne (by intro h; subst h; omega) (by intro h; subst h; omega)]
    exact hσP j hj
  have c1 := improve 1 3 (by rw [v1]; omega) (by rw [v3]; omega) (by rw [v1]; omega) (by rw [v3]; omega)
  have c2 := improve 2 3 (by rw [v2]; omega) (by rw [v3]; omega) (by rw [v2]; omega) (by rw [v3]; omega)
  have s13a : Equiv.swap (1 : Fin (k + 3 + 1)) 3 1 = 3 := Equiv.swap_apply_left _ _
  have s13b : Equiv.swap (1 : Fin (k + 3 + 1)) 3 3 = 1 := Equiv.swap_apply_right _ _
  have s13c : Equiv.swap (1 : Fin (k + 3 + 1)) 3 2 = 2 :=
    Equiv.swap_apply_of_ne_of_ne (Ne.symm n12) n23
  have s23a : Equiv.swap (2 : Fin (k + 3 + 1)) 3 2 = 3 := Equiv.swap_apply_left _ _
  have s23b : Equiv.swap (2 : Fin (k + 3 + 1)) 3 3 = 2 := Equiv.swap_apply_right _ _
  have s23c : Equiv.swap (2 : Fin (k + 3 + 1)) 3 1 = 1 :=
    Equiv.swap_apply_of_ne_of_ne n12 n13
  rw [s13a, s13b, s13c] at c1
  rw [s23a, s23b, s23c] at c2
  refine ⟨permGL σ.symm, ⟨HK_perm k _ (by
      have := hσP 0 (Or.inl rfl)
      rw [Equiv.symm_apply_eq]; exact this.symm), fun l hl => ?_⟩, σ, ?_, hσP, by linarith, by linarith, ?_⟩
  · rw [permGL_single]
    have := hσP l (Or.inr hl)
    rw [show σ.symm l = l from by rw [Equiv.symm_apply_eq]; exact this.symm]
  · rw [permGL_apply]; simp
  · intro j hj4 hjc
    have := improve j 3 (by omega) (by rw [v3]; omega) hjc (by rw [v3]; omega)
    have hj3 : j ≠ 3 := by intro h; subst h; rw [v3] at hj4; omega
    have hj1 : j ≠ 1 := by intro h; subst h; rw [v1] at hj4; omega
    have hj2 : j ≠ 2 := by intro h; subst h; rw [v2] at hj4; omega
    rw [Equiv.swap_apply_of_ne_of_ne (Ne.symm hj1) n13, Equiv.swap_apply_of_ne_of_ne (Ne.symm hj2) n23,
      Equiv.swap_apply_right] at this
    linarith


/-- Helper: $Q(b) = b_0^2 - b_1^2 - b_2^2 - b_3^2 - \sum_{j} b_{j+4}^2$. -/
theorem lorentz_split (k : ℕ) (b : Fin (k + 3 + 1) → ℤ) :
    (lorentz (k + 3)).eval b = b 0 ^ 2 - b 1 ^ 2 - b 2 ^ 2 - b 3 ^ 2 -
      ∑ j : Fin k, b j.succ.succ.succ.succ ^ 2 := by
  rw [lorentz_eval']
  simp [Fin.sum_univ_succ, fin3]
  ring

/-- Helper: the tail $\sum_j b_{j+4}^2$ is at most $k\,b_3^2$ when $0 \le b_j \le b_3$ for $j \ge 4$. -/
theorem tail_le (k : ℕ) (b : Fin (k + 3 + 1) → ℤ) (hnn : ∀ i, 0 ≤ b i)
    (h3 : ∀ j : Fin (k + 3 + 1), 4 ≤ j.val → b j ≤ b 3) :
    ∑ j : Fin k, b j.succ.succ.succ.succ ^ 2 ≤ k * b 3 ^ 2 := by
  have : ∀ j : Fin k, b j.succ.succ.succ.succ ^ 2 ≤ b 3 ^ 2 := by
    intro j
    have h1 := h3 j.succ.succ.succ.succ (by simp)
    have h2 := hnn j.succ.succ.succ.succ
    nlinarith
  calc ∑ j : Fin k, b j.succ.succ.succ.succ ^ 2 ≤ ∑ _j : Fin k, b 3 ^ 2 := Finset.sum_le_sum fun j _ => this j
    _ = k * b 3 ^ 2 := by simp

/-- The arithmetic heart of Exercise 18: for the three largest coordinates $b_1, b_2, b_3$ and $m \le 9$. -/
theorem neg_arith (b0 b1 b2 b3 T : ℤ) (k : ℕ) (hk : k ≤ 6) (h0 : 1 ≤ b0) (h3 : 0 ≤ b3) (h31 : b3 ≤ b1)
    (h32 : b3 ≤ b2) (hT0 : 0 ≤ T) (hT : T ≤ k * b3 ^ 2) (heq : b0 ^ 2 + 1 = b1 ^ 2 + b2 ^ 2 + b3 ^ 2 + T) :
    b0 < b1 + b2 + b3 ∧ b1 + b2 + b3 ≤ 2 * b0 := by
  have hk' : (k : ℤ) ≤ 6 := by exact_mod_cast hk
  have hT6 : T ≤ 6 * b3 ^ 2 := by nlinarith [sq_nonneg b3]
  have h12 : b3 * b3 ≤ b1 * b2 := by nlinarith
  have h13 : b3 * b3 ≤ b1 * b3 := by nlinarith
  have h23 : b3 * b3 ≤ b2 * b3 := by nlinarith
  constructor
  · by_contra hc
    push Not at hc
    have hp : 0 ≤ b1 + b2 + b3 := by nlinarith
    nlinarith
  · by_contra hc
    push Not at hc
    nlinarith [sq_nonneg (b1 - b2), sq_nonneg (b1 - b3), sq_nonneg (b2 - b3)]


/-- Helper: descent for vectors of norm $-1$ supported on the first $c+1$ coordinates (Exercise 18 hint): they are moved to $e_c$ by `KK k c`. -/
theorem desc_neg (k c : ℕ) (hc4 : 4 ≤ c) (hcm : c ≤ k + 3) (hk : k ≤ 6) :
    ∀ (N : ℕ) (b : Fin (k + 3 + 1) → ℤ), (b 0).natAbs = N → (lorentz (k + 3)).eval b = -1 → Supp c b →
      ∃ h ∈ KK k c, h.val *ᵥ b = Pi.single (⟨c, by omega⟩ : Fin (k + 3 + 1)) (1 : ℤ) := by
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
    intro b hN hf hsupp
    classical
    obtain ⟨D, hD, hDa⟩ := abs_fix_on (KK k c) (fun i => i.val ≤ c) (fun i hi => flip_KK k c i hi) b
    have hDA : D ∈ Siegel.Aut (lorentz (k + 3)) := HK_le_Aut k hD.1
    set a' := D.val *ᵥ b with ha'
    have hf' : (lorentz (k + 3)).eval a' = -1 := by rw [ha', hDA b]; exact hf
    have ha'val : ∀ j : Fin (k + 3 + 1), a' j = if j.val ≤ c then |b j| else b j := hDa
    have hnn : ∀ j, 0 ≤ a' j := by
      intro j; rw [ha'val j]
      split_ifs
      · exact abs_nonneg _
      · rw [hsupp j (by omega)]
    have hsupp' : Supp c a' := by
      intro j hj; rw [ha'val j, if_neg (by omega)]; exact hsupp j hj
    have ha0 : a' 0 = |b 0| := by rw [ha'val 0, if_pos (by simp)]
    by_cases hz : a' 0 = 0
    · -- terminal case: `a'` is a unit vector
      have hsum : ∑ i : Fin (k + 3), a' i.succ ^ 2 = 1 := by
        rw [lorentz_eval', hz] at hf'; simp at hf'; linarith
      obtain ⟨l, hl, hl'⟩ := sumsq_one _ hsum
      have hl1 : a' l.succ = 1 := by
        rcases hl with h | h
        · exact h
        · have := hnn l.succ; omega
      have hlc : l.succ.val ≤ c := by
        by_contra hcon
        have := hsupp' l.succ (by omega); omega
      have hl0 : l.succ ≠ 0 := Fin.succ_ne_zero l
      have hc0 : (⟨c, by omega⟩ : Fin (k + 3 + 1)) ≠ 0 := by
        intro h; have := congrArg Fin.val h; simp at this; omega
      have ha'e : a' = Pi.single l.succ 1 := by
        ext j
        by_cases hj : j = l.succ
        · subst hj; simp [hl1]
        · rw [Pi.single_apply, if_neg hj]
          by_cases hj0 : j = 0
          · rw [hj0, hz]
          · obtain ⟨i, rfl⟩ := Fin.exists_succ_eq.2 hj0
            exact hl' i (by intro h; exact hj (by rw [h]))
      refine ⟨swapGL l.succ ⟨c, by omega⟩ * D, mul_mem (swap_KK k c _ _ hl0 hc0 hlc (le_refl _)) hD, ?_⟩
      rw [Units.val_mul, ← Matrix.mulVec_mulVec, ← ha', ha'e]
      unfold swapGL
      rw [permGL_single, Equiv.swap_apply_left]
    · -- descent case
      have hpos : 1 ≤ a' 0 := by have := hnn 0; omega
      obtain ⟨g, hg, σ, hgy, hσ, h31, h32, h3j⟩ := top3 k c (by omega) hcm a'
      have hgA : g ∈ Siegel.Aut (lorentz (k + 3)) := HK_le_Aut k hg.1
      set y := g.val *ᵥ a' with hy
      have hyσ : ∀ j, y j = a' (σ j) := fun j => congrFun hgy j
      have hyf : (lorentz (k + 3)).eval y = -1 := by rw [hy, hgA a']; exact hf'
      have hynn : ∀ j, 0 ≤ y j := fun j => by rw [hyσ]; exact hnn _
      have hysupp : Supp c y := fun j hj => by rw [hyσ, hσ j (Or.inr hj)]; exact hsupp' j hj
      have hy0 : y 0 = a' 0 := by rw [hyσ, hσ 0 (Or.inl rfl)]
      have h3j' : ∀ j : Fin (k + 3 + 1), 4 ≤ j.val → y j ≤ y 3 := by
        intro j hj
        by_cases hjc : j.val ≤ c
        · rw [hyσ, hyσ]; exact h3j j hj hjc
        · rw [hysupp j (by omega)]; exact hynn 3
      have h31' : y 3 ≤ y 1 := by rw [hyσ, hyσ]; exact h31
      have h32' : y 3 ≤ y 2 := by rw [hyσ, hyσ]; exact h32
      rw [lorentz_split] at hyf
      have hT := tail_le k y hynn h3j'
      obtain ⟨hlow, hup⟩ := neg_arith (y 0) (y 1) (y 2) (y 3) _ k hk (by rw [hy0]; exact hpos) (hynn 3)
        h31' h32' (Finset.sum_nonneg fun j _ => sq_nonneg _) hT (by linarith)
      have hτA : tauGL k ∈ Siegel.Aut (lorentz (k + 3)) := tauGL_mem_Aut k
      set z := (tauGL k).val *ᵥ y with hz'
      have hzf : (lorentz (k + 3)).eval z = -1 := by
        rw [hz', hτA y, lorentz_split]; exact hyf
      have hz0 : z 0 = 2 * y 0 - y 1 - y 2 - y 3 := by
        rw [hz', tauGL_apply]; simp [vT]; ring
      have hzsupp : Supp c z := by
        intro j hj
        rw [hz', tauGL_apply]
        simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
        rw [hysupp j hj]
        have : vT (k + 3) j = 0 := by simp only [vT]; rw [if_neg (by omega)]
        rw [this]; simp
      have hlt : (z 0).natAbs < N := by
        have e1 : (b 0).natAbs = N := hN
        have : (a' 0) = ((b 0).natAbs : ℤ) := by rw [ha0, Int.abs_eq_natAbs]
        omega
      obtain ⟨h', hh', hh'z⟩ := ih _ hlt z rfl hzf hzsupp
      refine ⟨h' * tauGL k * g * D, mul_mem (mul_mem (mul_mem hh' (tau_KK k c (by omega))) hg) hD, ?_⟩
      rw [Units.val_mul, Units.val_mul, Units.val_mul, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec,
        ← Matrix.mulVec_mulVec, ← ha', ← hy, ← hz']
      exact hh'z


/-- Helper: arithmetic for the descent on norm $+1$ vectors: $a_0 < a_1 + a_2 + a_3 < 3a_0$ unless $a = e_0$. -/
theorem pos_arith (a0 a1 a2 a3 : ℤ) (h0 : 0 ≤ a0) (h1 : 0 ≤ a1) (h2 : 0 ≤ a2) (h3 : 0 ≤ a3)
    (hf : a0 ^ 2 - a1 ^ 2 - a2 ^ 2 - a3 ^ 2 = 1) (hne : ¬ (a0 = 1 ∧ a1 = 0 ∧ a2 = 0 ∧ a3 = 0)) :
    a0 < a1 + a2 + a3 ∧ a1 + a2 + a3 < 3 * a0 := by
  have ha0 : 1 ≤ a0 := by nlinarith
  have ha0' : 2 ≤ a0 := by
    by_contra hc
    have : a0 = 1 := by omega
    have e1 : a1 = 0 := by nlinarith
    have e2 : a2 = 0 := by nlinarith
    have e3 : a3 = 0 := by nlinarith
    exact hne ⟨this, e1, e2, e3⟩
  constructor
  · by_contra hc
    push Not at hc
    have hS0 : 0 ≤ a1 + a2 + a3 := by omega
    have hP : 0 ≤ a1 * a2 + a1 * a3 + a2 * a3 := by positivity
    have hsq : (a1 + a2 + a3) ^ 2 ≤ a0 ^ 2 := by nlinarith
    have e : (a1 + a2 + a3) ^ 2 = a1 ^ 2 + a2 ^ 2 + a3 ^ 2 + 2 * (a1 * a2 + a1 * a3 + a2 * a3) := by ring
    have hP0 : a1 * a2 + a1 * a3 + a2 * a3 = 0 := by nlinarith
    have hS : (a1 + a2 + a3) ^ 2 = a0 ^ 2 - 1 := by rw [e, hP0]; nlinarith
    have : a0 - (a1 + a2 + a3) = 0 ∨ 1 ≤ a0 - (a1 + a2 + a3) := by omega
    rcases this with h | h
    · nlinarith
    · nlinarith
  · by_contra hc
    push Not at hc
    nlinarith [sq_nonneg (a1 - a2), sq_nonneg (a1 - a3), sq_nonneg (a2 - a3)]

/-- Helper: descent for vectors of norm $+1$ supported on the first four coordinates: they are moved to $e_0$ by `KK k 3`. -/
theorem desc_pos (k : ℕ) :
    ∀ (N : ℕ) (a : Fin (k + 3 + 1) → ℤ), (a 0).natAbs = N → (lorentz (k + 3)).eval a = 1 → Supp 3 a →
      ∃ h ∈ KK k 3, h.val *ᵥ a = Pi.single 0 (1 : ℤ) := by
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
    intro b hN hf hsupp
    classical
    obtain ⟨v1, v2, v3⟩ := lit_val k
    obtain ⟨D, hD, hDa⟩ := abs_fix_on (KK k 3) (fun i => i.val ≤ 3) (fun i hi => flip_KK k 3 i hi) b
    have hDA : D ∈ Siegel.Aut (lorentz (k + 3)) := HK_le_Aut k hD.1
    set a' := D.val *ᵥ b with ha'
    have hf' : (lorentz (k + 3)).eval a' = 1 := by rw [ha', hDA b]; exact hf
    have ha'val : ∀ j : Fin (k + 3 + 1), a' j = if j.val ≤ 3 then |b j| else b j := hDa
    have hnn : ∀ j, 0 ≤ a' j := by
      intro j; rw [ha'val j]
      split_ifs
      · exact abs_nonneg _
      · rw [hsupp j (by omega)]
    have hsupp' : Supp 3 a' := by
      intro j hj; rw [ha'val j, if_neg (by omega)]; exact hsupp j hj
    have ha0 : a' 0 = |b 0| := by rw [ha'val 0, if_pos (by simp)]
    have htail : ∑ j : Fin k, a' j.succ.succ.succ.succ ^ 2 = 0 := by
      apply Finset.sum_eq_zero; intro j _
      rw [hsupp' j.succ.succ.succ.succ (by simp)]; simp
    rw [lorentz_split, htail] at hf'
    by_cases he : a' = Pi.single 0 1
    · exact ⟨D, hD, he⟩
    · have hne : ¬ (a' 0 = 1 ∧ a' 1 = 0 ∧ a' 2 = 0 ∧ a' 3 = 0) := by
        rintro ⟨e0, e1, e2, e3⟩
        apply he
        ext j
        by_cases hj : j.val ≤ 3
        · have : j = 0 ∨ j = 1 ∨ j = 2 ∨ j = 3 := by
            rcases (by omega : j.val = 0 ∨ j.val = 1 ∨ j.val = 2 ∨ j.val = 3) with h | h | h | h
            · left; exact Fin.ext (by simpa using h)
            · right; left; exact Fin.ext (by rw [h, v1])
            · right; right; left; exact Fin.ext (by rw [h, v2])
            · right; right; right; exact Fin.ext (by rw [h, v3])
          rcases this with rfl | rfl | rfl | rfl
          · simpa using e0
          · simpa [Pi.single_apply, (lit_ne k).2.2.2.1] using e1
          · simpa [Pi.single_apply, (lit_ne k).2.2.2.2.1] using e2
          · simpa [Pi.single_apply, (lit_ne k).2.2.2.2.2] using e3
        · rw [hsupp' j (by omega), Pi.single_apply, if_neg]
          intro h; subst h; simp at hj
      obtain ⟨hlow, hup⟩ := pos_arith (a' 0) (a' 1) (a' 2) (a' 3) (hnn 0) (hnn 1) (hnn 2) (hnn 3)
        (by linarith) hne
      have hτA : tauGL k ∈ Siegel.Aut (lorentz (k + 3)) := tauGL_mem_Aut k
      set z := (tauGL k).val *ᵥ a' with hz'
      have hzf : (lorentz (k + 3)).eval z = 1 := by rw [hz', hτA a']; rw [lorentz_split, htail]; linarith
      have hz0 : z 0 = 2 * a' 0 - a' 1 - a' 2 - a' 3 := by
        rw [hz', tauGL_apply]; simp [vT]; ring
      have hzsupp : Supp 3 z := by
        intro j hj
        rw [hz', tauGL_apply]
        simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
        rw [hsupp' j hj]
        have : vT (k + 3) j = 0 := by simp only [vT]; rw [if_neg (by omega)]
        rw [this]; simp
      have hlt : (z 0).natAbs < N := by
        have : (a' 0) = ((b 0).natAbs : ℤ) := by rw [ha0, Int.abs_eq_natAbs]
        omega
      obtain ⟨h', hh', hh'z⟩ := ih _ hlt z rfl hzf hzsupp
      refine ⟨h' * tauGL k * D, mul_mem (mul_mem hh' (tau_KK k 3 le_rfl)) hD, ?_⟩
      rw [Units.val_mul, Units.val_mul, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, ← ha', ← hz']
      exact hh'z

/-- Helper: an automorph fixing $e_i$ for all $i > 3$ lies in `HK k`. -/
theorem claim_base (k : ℕ) (T : GL (Fin (k + 3 + 1)) ℤ) (hT : T ∈ Siegel.Aut (lorentz (k + 3)))
    (hfix : ∀ i : Fin (k + 3 + 1), 3 < i.val → T.val *ᵥ (Pi.single i (1 : ℤ) : Fin (k + 3 + 1) → ℤ) = Pi.single i 1) :
    T ∈ HK k := by
  have hfe : (lorentz (k + 3)).eval (T.val *ᵥ (Pi.single 0 1 : Fin (k + 3 + 1) → ℤ)) = 1 := by
    rw [hT, lorentz_single]; simp
  have hsupp : Supp 3 (T.val *ᵥ (Pi.single 0 1 : Fin (k + 3 + 1) → ℤ)) := by
    intro i hi
    exact col_orth T hT i 0 (hfix i hi) (by intro h; subst h; simp at hi)
  obtain ⟨h, hh, hhT⟩ := desc_pos k _ _ rfl hfe hsupp
  have hA : h * T ∈ Siegel.Aut (lorentz (k + 3)) := mul_mem (HK_le_Aut k hh.1) hT
  have hs := stab_le (HK k) (fun i _ => HK_flip k i) (fun i j hi hj => HK_swap k i j hi hj) (h * T) hA
    (by rw [Units.val_mul, ← Matrix.mulVec_mulVec]; exact hhT)
  have := mul_mem (inv_mem hh.1) hs
  simpa using this

/-- Helper: inductive step on the number of coordinates moved. -/
theorem claim_step (k : ℕ) (hk : k ≤ 6) (c : ℕ) (hc3 : 3 ≤ c) (hc : c + 1 ≤ k + 3)
    (IH : ∀ T : GL (Fin (k + 3 + 1)) ℤ, T ∈ Siegel.Aut (lorentz (k + 3)) →
      (∀ i : Fin (k + 3 + 1), c < i.val → T.val *ᵥ (Pi.single i (1 : ℤ) : Fin (k + 3 + 1) → ℤ) = Pi.single i 1) →
      T ∈ HK k)
    (T : GL (Fin (k + 3 + 1)) ℤ) (hT : T ∈ Siegel.Aut (lorentz (k + 3)))
    (hfix : ∀ i : Fin (k + 3 + 1), c + 1 < i.val →
      T.val *ᵥ (Pi.single i (1 : ℤ) : Fin (k + 3 + 1) → ℤ) = Pi.single i 1) : T ∈ HK k := by
  set C : Fin (k + 3 + 1) := ⟨c + 1, by omega⟩ with hC
  have hC0 : C ≠ 0 := by intro h; have := congrArg Fin.val h; simp [hC] at this
  have hfe : (lorentz (k + 3)).eval (T.val *ᵥ (Pi.single C 1 : Fin (k + 3 + 1) → ℤ)) = -1 := by
    rw [hT, lorentz_single, if_neg hC0]
  have hsupp : Supp (c + 1) (T.val *ᵥ (Pi.single C 1 : Fin (k + 3 + 1) → ℤ)) := by
    intro i hi
    exact col_orth T hT i C (hfix i hi) (by intro h; subst h; simp [hC] at hi)
  obtain ⟨h, hh, hhT⟩ := desc_neg k (c + 1) (by omega) hc hk _ _ rfl hfe hsupp
  have hA : h * T ∈ Siegel.Aut (lorentz (k + 3)) := mul_mem (HK_le_Aut k hh.1) hT
  have hs := IH (h * T) hA (by
    intro i hi
    rw [Units.val_mul, ← Matrix.mulVec_mulVec]
    by_cases hiC : i = C
    · subst hiC; exact hhT
    · have hi' : c + 1 < i.val := by
        have : i.val ≠ c + 1 := fun h => hiC (Fin.ext (by simpa [hC] using h))
        omega
      rw [hfix i hi', hh.2 i hi'])
  have := mul_mem (inv_mem hh.1) hs
  simpa using this

/-- **Cassels, Ch. 9, Ex. 18, p. 167.** For $3 \le m \le 9$, written $m = k+3$ with $0 \le k \le 6$ (so $k = 0$ repeats Exercise 17 (ii), and $1 \le k \le 6$ is $4 \le m \le 9$), the group of integral automorphs of $x_0^2 - x_1^2 - \dots - x_m^2$ is `HK k`, the group generated by $\tau$ (the symmetry in $(1,1,1,1,0,\dots,0)$), the sign changes and the permutations of $x_1,\dots,x_m$ (`GensK`).

Proof (as in the hint): vectors of norm $-1$ are moved to some $e_i$ by the descent `desc_neg` (the hint's inequality is `neg_arith`; $m \le 9$ enters through $k \le 6$), and the rest is an induction on the number of non-fixed coordinates (`claim_step`), starting from the norm $+1$ descent `desc_pos` and the stabilizer of $e_0$ (`stab_le`).

*Update:* the hint's strict inequality $b_1+b_2+b_3 < 2b_0$ should be $\le$ (equality occurs for $b_0 = 1$, $b = (1;1,1,0,\dots)$); this suffices because $|2b_0 - (b_1+b_2+b_3)| < b_0$ still holds. -/
@[kb "cassels1978" "Ch. 9, Ex. 18, p. 167"]
theorem ex18 (k : ℕ) (hk : k ≤ 6) : Siegel.Aut (lorentz (k + 3)) = HK k := by
  refine le_antisymm (fun T hT => ?_) (HK_le_Aut k)
  have claim : ∀ d : ℕ, d ≤ k → ∀ T : GL (Fin (k + 3 + 1)) ℤ, T ∈ Siegel.Aut (lorentz (k + 3)) →
      (∀ i : Fin (k + 3 + 1), 3 + d < i.val →
        T.val *ᵥ (Pi.single i (1 : ℤ) : Fin (k + 3 + 1) → ℤ) = Pi.single i 1) → T ∈ HK k := by
    intro d
    induction d with
    | zero => intro _ T hT hfix; exact claim_base k T hT hfix
    | succ d ih =>
      intro hd T hT hfix
      exact claim_step k hk (3 + d) (by omega) (by omega) (fun T hT hf => ih (by omega) T hT hf) T hT
        (fun i hi => hfix i (by omega))
  exact claim k le_rfl T hT (fun i hi => by exfalso; have := i.isLt; omega)

end Ex18

end QuadFormsKB.Cassels.Ch9Ex16
