/-
# O'Meara §71A: Example 71:6, cyclotomic extensions inside an algebraically closed field

**Setting.** $F$ is a field of characteristic $0$ (O'Meara: an algebraic number field) and $C$ an algebraically closed
field containing $F$. The definitions 71:1 (`IsAbsCyclotomic`) and 71:2 (`IsMCyclotomic`) and Examples 71:3–71:5 are in
`Sec71A.lean`.

**Proves** Example 71:6 (p. 191): `isAbsCyclotomic_iff_eq_adjoin_rootSet` (the absolute $m$-cyclotomic extension in $C$
is the splitting field $H$ in $C$ of $x^m - 1$), `existsUnique_isAbsCyclotomic` (it is unique),
`le_adjoin_rootSet_of_isMCyclotomic` ($m$-cyclotomic subextensions of $C/F$ lie in $H$), `isMCyclotomic_sup` (a
compositum of cyclotomic extensions is cyclotomic), `sup_le_adjoin_of_isMCyclotomic` ($KL/L$ is $m$-cyclotomic).
-/
import QuadFormsKB.Literature.OMeara.Sec71A

open Polynomial

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.OMeara

section Algebraic

variable {F : Type} [Field F] [CharZero F]

private lemma exists_adjoin_eq {m : ℕ} {H : Type*} [Field H] [Algebra F H] {K : IntermediateField F H}
    (h : IsAbsCyclotomic m F K) : ∃ a : H, IsPrimitiveRoot a m ∧ K = IntermediateField.adjoin F {a} := by
  obtain ⟨ζ, hζ, htop⟩ := h
  refine ⟨ζ, IsPrimitiveRoot.coe_submonoidClass_iff.2 hζ, ?_⟩
  have h := congrArg (IntermediateField.map K.val) htop
  rw [IntermediateField.adjoin_map, Set.image_singleton] at h
  refine Eq.trans ?_ h.symm
  ext x
  simp

private lemma isAbsCyclotomic_of_eq_adjoin {m : ℕ} {H : Type*} [Field H] [Algebra F H]
    {K : IntermediateField F H} {a : H} (ha : IsPrimitiveRoot a m)
    (hK : K = IntermediateField.adjoin F {a}) : IsAbsCyclotomic m F K := by
  have haK : a ∈ K := hK ▸ IntermediateField.subset_adjoin F _ rfl
  refine ⟨⟨a, haK⟩, IsPrimitiveRoot.coe_submonoidClass_iff.1 ha, ?_⟩
  apply IntermediateField.map_injective K.val
  rw [IntermediateField.adjoin_map, Set.image_singleton]
  have : K.val ⟨a, haK⟩ = a := rfl
  rw [this, ← hK]
  ext x
  simp

variable {C : Type} [Field C] [IsAlgClosed C] [Algebra F C]

private lemma mem_rootSet_iff {k : ℕ} (hk : k ≠ 0) (x : C) :
    x ∈ (X ^ k - 1 : F[X]).rootSet C ↔ x ^ k = 1 := by
  rw [mem_rootSet]
  constructor
  · rintro ⟨-, h⟩
    simpa [sub_eq_zero] using h
  · intro h
    refine ⟨?_, by simp [h]⟩
    simpa using X_pow_sub_C_ne_zero (Nat.pos_of_ne_zero hk) (1 : F)

include F in
private lemma exists_isPrimitiveRoot_C {m : ℕ} (hm : m ≠ 0) : ∃ ζ : C, IsPrimitiveRoot ζ m := by
  have : CharZero C := charZero_of_injective_algebraMap (algebraMap F C).injective
  have : NeZero m := ⟨hm⟩
  exact IsCyclotomicExtension.exists_isPrimitiveRoot (S := {m}) C C rfl hm

private lemma adjoin_rootSet_eq {m : ℕ} (hm : m ≠ 0) {ζ : C} (hζ : IsPrimitiveRoot ζ m) :
    IntermediateField.adjoin F ((X ^ m - 1 : F[X]).rootSet C) = IntermediateField.adjoin F {ζ} := by
  have : NeZero m := ⟨hm⟩
  apply le_antisymm
  · rw [IntermediateField.adjoin_le_iff]
    intro x hx
    obtain ⟨i, -, rfl⟩ := hζ.eq_pow_of_pow_eq_one ((mem_rootSet_iff hm x).1 hx)
    exact pow_mem (IntermediateField.subset_adjoin F {ζ} rfl) i
  · rw [IntermediateField.adjoin_le_iff]
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    exact IntermediateField.subset_adjoin F _ ((mem_rootSet_iff hm _).2 hζ.pow_eq_one)

/-- **Example 71:6** (O'Meara 1963, p. 191), first part: let $C$ be an algebraically closed field containing $F$ and
$m \ne 0$. An intermediate field $K$ of $C/F$ is an absolute $m$-cyclotomic extension of $F$ if and only if it is the
splitting field $H$ in $C$ of $x^m - 1$ over $F$ (the field generated by the roots of $x^m - 1$ in $C$). -/
@[kb "omeara1963" "§71A, 71:6, p. 191 (the absolute m-cyclotomic extension in C is the splitting field H)"]
theorem isAbsCyclotomic_iff_eq_adjoin_rootSet {m : ℕ} (hm : m ≠ 0) (K : IntermediateField F C) :
    IsAbsCyclotomic m F K ↔ K = IntermediateField.adjoin F ((X ^ m - 1 : F[X]).rootSet C) := by
  obtain ⟨ζ, hζ⟩ := exists_isPrimitiveRoot_C (F := F) (C := C) hm
  constructor
  · intro h
    obtain ⟨a, ha, e⟩ := exists_adjoin_eq h
    rw [e, adjoin_rootSet_eq hm ha]
  · intro h
    exact isAbsCyclotomic_of_eq_adjoin hζ (h.trans (adjoin_rootSet_eq hm hζ))

/-- **Example 71:6** (O'Meara 1963, p. 191): $C$ contains exactly one absolute $m$-cyclotomic extension of $F$. -/
@[kb "omeara1963" "§71A, 71:6, p. 191 (exactly one absolute m-cyclotomic extension in C)"]
theorem existsUnique_isAbsCyclotomic {m : ℕ} (hm : m ≠ 0) :
    ∃! K : IntermediateField F C, IsAbsCyclotomic m F K := by
  refine ⟨IntermediateField.adjoin F ((X ^ m - 1 : F[X]).rootSet C),
    (isAbsCyclotomic_iff_eq_adjoin_rootSet hm _).2 rfl, fun K hK => ?_⟩
  exact (isAbsCyclotomic_iff_eq_adjoin_rootSet hm K).1 hK

/-- **Example 71:6** (O'Meara 1963, p. 191): every $m$-cyclotomic subextension $K$ of $C/F$ satisfies
$F \subseteq K \subseteq H$, $H$ the splitting field in $C$ of $x^m - 1$. -/
@[kb "omeara1963" "§71A, 71:6, p. 191 (an m-cyclotomic subextension of C/F lies in H)"]
theorem le_adjoin_rootSet_of_isMCyclotomic {m : ℕ} (hm : m ≠ 0) (K : IntermediateField F C)
    (hK : IsMCyclotomic m F K) : K ≤ IntermediateField.adjoin F ((X ^ m - 1 : F[X]).rootSet C) := by
  obtain ⟨L, _, _, hL, ⟨φ⟩⟩ := hK
  have : NeZero m := ⟨hm⟩
  have hcyc := isAbsCyclotomic_iff_isCyclotomicExtension.1 hL
  have : Algebra.IsAlgebraic F L :=
    (IsCyclotomicExtension.integral {m} F L).isAlgebraic
  obtain ⟨η, hη, hηtop⟩ := hL
  let ψ : L →ₐ[F] C := IsAlgClosed.lift
  have hψη : IsPrimitiveRoot (ψ η) m := hη.map_of_injective ψ.injective
  have hH := adjoin_rootSet_eq (F := F) hm hψη
  have hN : Normal F (IntermediateField.adjoin F ((X ^ m - 1 : F[X]).rootSet C)) :=
    have := IntermediateField.adjoin_rootSet_isSplittingField (K := F) (L := C)
      (p := (X ^ m - 1 : F[X])) (IsAlgClosed.splits _)
    Normal.of_isSplittingField (X ^ m - 1 : F[X])
  intro x hx
  let xK : K := ⟨x, hx⟩
  let χ : K →ₐ[F] C := ψ.comp φ
  have hy : χ xK ∈ IntermediateField.adjoin F ((X ^ m - 1 : F[X]).rootSet C) := by
    rw [hH]
    have hl : φ xK ∈ IntermediateField.adjoin F {η} := by rw [hηtop]; trivial
    have : ψ (φ xK) ∈ IntermediateField.map ψ (IntermediateField.adjoin F {η}) :=
      (IntermediateField.mem_map _).2 ⟨_, hl, rfl⟩
    rw [IntermediateField.adjoin_map, Set.image_singleton] at this
    exact this
  set H := IntermediateField.adjoin F ((X ^ m - 1 : F[X]).rootSet C) with hHdef
  let y : H := ⟨χ xK, hy⟩
  have hmin : minpoly F y = minpoly F x := by
    have e1 := minpoly.algHom_eq H.val H.val.injective y
    have e2 := minpoly.algHom_eq χ χ.injective xK
    have e3 := minpoly.algHom_eq K.val K.val.injective xK
    have : H.val y = χ xK := rfl
    have h3 : K.val xK = x := rfl
    rw [this] at e1
    rw [h3] at e3
    rw [← e1, e2, e3]
  have hroot : (((minpoly F y).map (algebraMap F H)).map (H.val : H →+* C)).IsRoot x := by
    rw [Polynomial.map_map]
    have : (H.val : H →+* C).comp (algebraMap F H) = algebraMap F C := rfl
    rw [this, hmin, IsRoot, eval_map_algebraMap]
    exact minpoly.aeval F _
  obtain ⟨h, hh⟩ := (Normal.splits hN y).mem_range_of_isRoot (Polynomial.map_ne_zero (minpoly.ne_zero (Normal.isIntegral hN y))) hroot
  rw [← hh]
  exact h.2

/-- **Example 71:6** (O'Meara 1963, p. 191): a compositum of cyclotomic extensions is cyclotomic: if $K_1$ is
$m$-cyclotomic and $K_2$ is $n$-cyclotomic (subextensions of $C/F$), then $K_1K_2$ is $mn$-cyclotomic. -/
@[kb "omeara1963" "§71A, 71:6, p. 191 (a compositum of cyclotomic extensions is cyclotomic)"]
theorem isMCyclotomic_sup {m n : ℕ} (hm : m ≠ 0) (hn : n ≠ 0) (K₁ K₂ : IntermediateField F C)
    (h₁ : IsMCyclotomic m F K₁) (h₂ : IsMCyclotomic n F K₂) :
    IsMCyclotomic (m * n) F ↥(K₁ ⊔ K₂) := by
  have hmn : m * n ≠ 0 := mul_ne_zero hm hn
  have mono : ∀ {k : ℕ}, k ≠ 0 → k ∣ m * n →
      IntermediateField.adjoin F ((X ^ k - 1 : F[X]).rootSet C) ≤
        IntermediateField.adjoin F ((X ^ (m * n) - 1 : F[X]).rootSet C) := by
    intro k hk hd
    rw [IntermediateField.adjoin_le_iff]
    intro x hx
    apply IntermediateField.subset_adjoin
    rw [mem_rootSet_iff hk] at hx
    rw [mem_rootSet_iff hmn]
    obtain ⟨c, hc⟩ := hd
    rw [hc, pow_mul, hx, one_pow]
  have hle : K₁ ⊔ K₂ ≤ IntermediateField.adjoin F ((X ^ (m * n) - 1 : F[X]).rootSet C) :=
    sup_le ((le_adjoin_rootSet_of_isMCyclotomic hm K₁ h₁).trans (mono hm (dvd_mul_right m n)))
      ((le_adjoin_rootSet_of_isMCyclotomic hn K₂ h₂).trans (mono hn (dvd_mul_left n m)))
  exact ⟨↥(IntermediateField.adjoin F ((X ^ (m * n) - 1 : F[X]).rootSet C)), inferInstance,
    inferInstance, (isAbsCyclotomic_iff_eq_adjoin_rootSet hmn _).2 rfl,
    ⟨IntermediateField.inclusion hle⟩⟩

/-- **Example 71:6** (O'Meara 1963, p. 191), last part: if $K$ is an $m$-cyclotomic subextension of $C/F$ and $L$ is
an intermediate field of $C/F$, then $KL/L$ is $m$-cyclotomic: $KL \subseteq L(\zeta)$ for a primitive $m$-th root of
unity $\zeta \in C$, and $L(\zeta)/L$ is absolute $m$-cyclotomic. (O'Meara allows any subfield $L$ of $C$ and works with
$FL/L$; here $L$ contains $F$.) -/
@[kb "omeara1963" "§71A, 71:6, p. 191 (KL/FL is m-cyclotomic)"]
theorem sup_le_adjoin_of_isMCyclotomic {m : ℕ} (hm : m ≠ 0) (K L : IntermediateField F C)
    (hK : IsMCyclotomic m F K) :
    ∃ ζ : C, IsPrimitiveRoot ζ m ∧ K ⊔ L ≤ (IntermediateField.adjoin L {ζ}).restrictScalars F := by
  obtain ⟨ζ, hζ⟩ := exists_isPrimitiveRoot_C (F := F) (C := C) hm
  refine ⟨ζ, hζ, sup_le ?_ ?_⟩
  · intro x hx
    have h1 := le_adjoin_rootSet_of_isMCyclotomic hm K hK hx
    rw [adjoin_rootSet_eq hm hζ] at h1
    have hsub : IntermediateField.adjoin F {ζ} ≤ (IntermediateField.adjoin L {ζ}).restrictScalars F :=
      IntermediateField.adjoin_le_iff.2
        (Set.singleton_subset_iff.2 (IntermediateField.mem_adjoin_simple_self L ζ))
    exact hsub h1
  · intro y hy
    exact IntermediateField.adjoin.algebraMap_mem L {ζ} ⟨y, hy⟩

end Algebraic

end QuadFormsKB.OMeara
