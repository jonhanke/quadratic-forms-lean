/-
# O'Meara §65C: generators of the $S$-units modulo squares, and the field $F(\sqrt{\mathfrak u})$

**Setting.** $F$ is a number field. O'Meara's $S$ (§65A) contains almost all spots and only discrete ones; his group of
$S$-units $\mathfrak u = \{\alpha \in F : \lvert\alpha\rvert_\mathfrak p = 1$ for all $\mathfrak p \in S\}$ is the
library's `HN.SUnit T` for the finite set $T$ of finite spots outside $S$ (Milne's indexing: $T$ lists the primes
that are allowed in the denominators; the infinite spots are always allowed). The number of spots outside $S$ is
$s = \lvert T\rvert + r_\infty$, $r_\infty$ the number of infinite spots, and $(\mathfrak u : \mathfrak u^2) = 2^{s}$
(O'Meara 65:6, `HN.index_sq_sUnit`).

**Defines**
* `IsGenModSq T e` (§65C, p. 182): $\varepsilon_1, \dots, \varepsilon_r$ is a *set of generators of $\mathfrak u$
  modulo $\mathfrak u^2$*: every $S$-unit is $\varepsilon_1^{\nu_1}\cdots\varepsilon_r^{\nu_r}\delta^2$ with
  $\nu_i \in \mathbb N$ and $\delta \in \mathfrak u$;
* `sqrtSUnitField T` $= F(\sqrt{\mathfrak u})$ (p. 183): the subfield of an algebraic closure of $F$ generated by the
  square roots of all $S$-units.

**Proves** (§65C, pp. 182–183)
* `card_le_of_isGenModSq`, `exists_isGenModSq`, `isGenModSq_unique`, `exists_isGenModSq_mem` (65.r9): a set of
  generators has at least $s$ elements; there is one with exactly $s$; for such a set the exponents
  $\nu_i \in \{0, 1\}$ are unique; every non-square $S$-unit belongs to such a set;
* `sqrtSUnitField_eq_adjoin` (p. 183): $F(\sqrt{\mathfrak u}) = F(\sqrt{\varepsilon_1}, \dots, \sqrt{\varepsilon_s})$;
* Proposition 65:16 (p. 183): `finrank_adjoin_sqrt` (the abstract degree formula $[K(\sqrt{\beta_1}, \dots,
  \sqrt{\beta_t}) : K] = 2^{t}$ when all products of distinct $\beta_i$ are non-squares) and
  `finrank_sqrtSUnitField` ($[F(\sqrt{\mathfrak u}) : F] = 2^{s}$).
-/
import QuadFormsKB.Literature.HasseNorm.SUnits

open NumberField IsDedekindDomain Module

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.OMeara

universe u v

/-! ### Auxiliary: the abstract degree formula, induction step (internal) -/

namespace Sec65CAux

/-- The statement of the degree formula for a fixed ambient field `L`, with base fields in the universe of `L`. -/
def Stmt (L : Type v) [Field L] (t : ℕ) : Prop :=
  ∀ (K : Type v) [Field K] [Algebra K L], (2 : K) ≠ 0 → ∀ (b : Fin t → L) (β : Fin t → K),
    (∀ i, b i ^ 2 = algebraMap K L (β i)) →
    (∀ s : Finset (Fin t), s.Nonempty → ¬ IsSquare (∏ i ∈ s, β i)) →
    finrank K (IntermediateField.adjoin K (Set.range b)) = 2 ^ t

lemma stmt_base {K : Type u} {L : Type v} [Field K] [Field L] [Algebra K L] (b : Fin 0 → L) :
    finrank K (IntermediateField.adjoin K (Set.range b)) = 2 ^ 0 := by
  rw [Set.range_eq_empty, IntermediateField.adjoin_empty, IntermediateField.finrank_bot]
  rfl

set_option synthInstance.maxHeartbeats 400000 in
lemma stmt_step {K : Type u} {L : Type v} [Field K] [Field L] [Algebra K L] (h2 : (2 : K) ≠ 0) (t : ℕ)
    (IH : Stmt L t) (b : Fin (t + 1) → L) (β : Fin (t + 1) → K)
    (hb : ∀ i, b i ^ 2 = algebraMap K L (β i))
    (hβ : ∀ s : Finset (Fin (t + 1)), s.Nonempty → ¬ IsSquare (∏ i ∈ s, β i)) :
    finrank K (IntermediateField.adjoin K (Set.range b)) = 2 ^ (t + 1) := by
  have hβ0 : ¬ IsSquare (β 0) := by simpa using hβ {0} (by simp)
  have hint : IsIntegral K (b 0) :=
    ⟨Polynomial.X ^ 2 - Polynomial.C (β 0), Polynomial.monic_X_pow_sub_C _ (by norm_num),
      by simp [hb 0]⟩
  set K₁ := IntermediateField.adjoin K {b 0} with hK₁
  have hmin : minpoly K (b 0) = Polynomial.X ^ 2 - Polynomial.C (β 0) := by
    symm
    apply minpoly.eq_of_irreducible_of_monic
    · exact X_pow_sub_C_irreducible_of_prime Nat.prime_two
        (fun c hc => hβ0 ⟨c, by rw [← hc]; ring⟩)
    · simp [hb 0]
    · exact Polynomial.monic_X_pow_sub_C _ (by norm_num)
  have h1 : finrank K K₁ = 2 := by
    rw [IntermediateField.adjoin.finrank hint, hmin, Polynomial.natDegree_X_pow_sub_C]
  have hdec : ∀ y ∈ K₁, ∃ α γ : K, y = algebraMap K L α + algebraMap K L γ * b 0 := by
    intro y hy
    rw [hK₁, ← IntermediateField.mem_toSubalgebra,
      IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hint.isAlgebraic] at hy
    induction hy using Algebra.adjoin_induction with
    | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      exact ⟨0, 1, by simp [hx]⟩
    | algebraMap r => exact ⟨r, 0, by simp⟩
    | add x y _ _ hx hy =>
      obtain ⟨a, c, rfl⟩ := hx
      obtain ⟨a', c', rfl⟩ := hy
      exact ⟨a + a', c + c', by simp only [map_add]; ring⟩
    | mul x y _ _ hx hy =>
      obtain ⟨a, c, rfl⟩ := hx
      obtain ⟨a', c', rfl⟩ := hy
      refine ⟨a * a' + c * c' * β 0, a * c' + a' * c, ?_⟩
      simp only [map_add, map_mul]
      have := hb 0
      linear_combination (algebraMap K L c * algebraMap K L c') * this
  have hkey : ∀ α γ x : K, algebraMap K L x = (algebraMap K L α + algebraMap K L γ * b 0) ^ 2 →
      α = 0 ∨ γ = 0 := by
    intro α γ x hx
    by_contra hne
    rw [not_or] at hne
    obtain ⟨hα, hγ⟩ := hne
    apply hβ0
    have hc : (2 * α * γ) ≠ 0 := mul_ne_zero (mul_ne_zero h2 hα) hγ
    refine ⟨(x - α ^ 2 - γ ^ 2 * β 0) / (2 * α * γ), ?_⟩
    apply (algebraMap K L).injective
    have e1 : b 0 = algebraMap K L ((x - α ^ 2 - γ ^ 2 * β 0) / (2 * α * γ)) := by
      have hc' : algebraMap K L (2 * α * γ) ≠ 0 := by simpa using hc
      rw [map_div₀, eq_div_iff hc']
      simp only [map_sub, map_mul, map_pow, map_ofNat]
      have := hb 0
      rw [hx]
      linear_combination (-(algebraMap K L γ) ^ 2) * this
    have := hb 0
    rw [map_mul, ← e1, ← pow_two, ← this]
  have h2' : (2 : K₁) ≠ 0 := by
    intro h
    apply h2
    apply (algebraMap K K₁).injective
    rw [map_ofNat, map_zero]; exact h
  have hIH := IH K₁ h2' (fun i => b i.succ) (fun i => algebraMap K K₁ (β i.succ))
    (fun i => by
      rw [hb i.succ]
      exact IsScalarTower.algebraMap_apply K K₁ L _)
    (by
      intro s hs hsq
      obtain ⟨y, hy⟩ := hsq
      obtain ⟨α, γ, hyy⟩ := hdec y.1 y.2
      have hx : algebraMap K L (∏ i ∈ s.map (Fin.succEmb t), β i) =
          (algebraMap K L α + algebraMap K L γ * b 0) ^ 2 := by
        rw [← hyy, Finset.prod_map, map_prod, pow_two]
        have := congrArg (IntermediateField.val K₁) hy
        rw [map_prod, map_mul] at this
        simp only [AlgHom.commutes] at this
        exact this
      have hne : (s.map (Fin.succEmb t)).Nonempty := by simpa using hs
      rcases hkey α γ _ hx with h0 | h0
      · apply hβ (insert 0 (s.map (Fin.succEmb t))) (by simp)
        rw [Finset.prod_insert (by simp)]
        refine ⟨γ * β 0, ?_⟩
        apply (algebraMap K L).injective
        rw [map_mul, hx, h0]
        have := hb 0
        simp only [map_zero, zero_add, map_mul]
        rw [mul_pow, this]; ring
      · apply hβ _ hne
        refine ⟨α, ?_⟩
        apply (algebraMap K L).injective
        rw [hx, h0]; simp [pow_two])
  have hE : IntermediateField.adjoin K (Set.range b) =
      (IntermediateField.adjoin K₁ (Set.range fun i : Fin t => b i.succ)).restrictScalars K := by
    rw [IntermediateField.restrictScalars_adjoin]
    apply le_antisymm
    · apply IntermediateField.adjoin_le_iff.mpr
      rintro _ ⟨i, rfl⟩
      refine IntermediateField.subset_adjoin K _ ?_
      refine Fin.cases ?_ (fun j => ?_) i
      · exact Or.inl (IntermediateField.subset_adjoin K _ rfl)
      · exact Or.inr ⟨j, rfl⟩
    · apply IntermediateField.adjoin_le_iff.mpr
      rintro x (hx | ⟨j, rfl⟩)
      · have : K₁ ≤ IntermediateField.adjoin K (Set.range b) := by
          rw [hK₁]
          apply IntermediateField.adjoin_le_iff.mpr
          rintro _ rfl
          exact IntermediateField.subset_adjoin K _ ⟨0, rfl⟩
        exact this hx
      · exact IntermediateField.subset_adjoin K _ ⟨j.succ, rfl⟩
  rw [hE]
  have htower := Module.finrank_mul_finrank K K₁
    (IntermediateField.adjoin K₁ (Set.range fun i : Fin t => b i.succ))
  rw [h1, hIH] at htower
  rw [pow_succ]
  have : finrank K ((IntermediateField.adjoin K₁ (Set.range fun i : Fin t => b i.succ)).restrictScalars K)
      = finrank K (IntermediateField.adjoin K₁ (Set.range fun i : Fin t => b i.succ)) := rfl
  rw [this, ← htower]
  ring

lemma stmt_all (L : Type v) [Field L] : ∀ t, Stmt L t
  | 0 => fun K _ _ _ b _ _ _ => stmt_base b
  | t + 1 => fun K _ _ h2 b β hb hβ => stmt_step h2 t (stmt_all L t) b β hb hβ

end Sec65CAux

/-! ### Auxiliary: the quotient $G/G^2$ as an $\mathbb F_2$-vector space (internal) -/

namespace Mod2

variable (M : Type*) [CommGroup M]

/-- The quotient $M/M^2$ (additively). -/
abbrev Vq := Additive M ⧸ (nsmulAddMonoidHom (α := Additive M) 2).range

instance : Module (ZMod 2) (Vq M) :=
  QuotientAddGroup.zmodModule (fun x => ⟨x, by simp⟩)

variable {M}

/-- The class of `x` in $M/M^2$. -/
def mkq (x : M) : Vq M := QuotientAddGroup.mk (Additive.ofMul x)

lemma mkq_mul (x y : M) : mkq (x * y) = mkq x + mkq y := by
  unfold mkq; rw [ofMul_mul, QuotientAddGroup.mk_add]

lemma mkq_one : mkq (1 : M) = 0 := by
  unfold mkq; rw [ofMul_one]; rfl

lemma mkq_eq_iff (x y : M) : mkq x = mkq y ↔ ∃ d : M, x = y * d ^ 2 := by
  unfold mkq
  rw [QuotientAddGroup.eq_iff_sub_mem]
  constructor
  · rintro ⟨z, hz⟩
    refine ⟨z.toMul, ?_⟩
    have : Additive.ofMul x = Additive.ofMul y + 2 • z := by
      simp only [nsmulAddMonoidHom_apply] at hz
      rw [hz]; abel
    have h2 := congrArg Additive.toMul this
    simpa [toMul_add, toMul_nsmul] using h2
  · rintro ⟨d, hd⟩
    refine ⟨Additive.ofMul d, ?_⟩
    simp only [nsmulAddMonoidHom_apply]
    rw [hd]
    rw [← ofMul_pow, ← ofMul_div]
    congr 1
    exact (mul_div_cancel_left _ _).symm

lemma mkq_sq (d : M) : mkq (d ^ 2) = 0 := by
  rw [← mkq_one, mkq_eq_iff]; exact ⟨d, by simp⟩

lemma mkq_pow (x : M) (n : ℕ) : mkq (x ^ n) = (n : ZMod 2) • mkq x := by
  rw [Nat.cast_smul_eq_nsmul]
  induction n with
  | zero => simp [mkq_one]
  | succ n ih => rw [pow_succ, mkq_mul, ih, succ_nsmul]

lemma mkq_prod {ι : Type*} (s : Finset ι) (f : ι → M) :
    mkq (∏ i ∈ s, f i) = ∑ i ∈ s, mkq (f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [mkq_one]
  | insert a s ha ih => rw [Finset.prod_insert ha, Finset.sum_insert ha, mkq_mul, ih]

lemma mkq_surj (v : Vq M) : ∃ x : M, mkq x = v := by
  obtain ⟨a, rfl⟩ := QuotientAddGroup.mk_surjective v
  exact ⟨a.toMul, rfl⟩

/-- Generators of $M$ modulo squares (the shape of `IsGenModSq`). -/
def GenP {r : ℕ} (e : Fin r → M) : Prop :=
  ∀ u : M, ∃ ν : Fin r → ℕ, ∃ d : M, u = (∏ i, e i ^ ν i) * d ^ 2

lemma mkq_prod_pow {r : ℕ} (e : Fin r → M) (ν : Fin r → ℕ) :
    mkq (∏ i, e i ^ ν i) = ∑ i, (ν i : ZMod 2) • mkq (e i) := by
  rw [mkq_prod]; simp only [mkq_pow]

lemma genP_iff {r : ℕ} (e : Fin r → M) :
    GenP e ↔ ⊤ ≤ Submodule.span (ZMod 2) (Set.range fun i => mkq (e i)) := by
  constructor
  · intro h v _
    obtain ⟨u, rfl⟩ := mkq_surj v
    obtain ⟨ν, d, hu⟩ := h u
    rw [hu, mkq_mul, mkq_sq, add_zero, mkq_prod_pow]
    exact Submodule.sum_mem _ fun i _ =>
      Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  · intro h u
    have hu : mkq u ∈ Submodule.span (ZMod 2) (Set.range fun i => mkq (e i)) := h trivial
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun (ZMod 2)).mp hu
    refine ⟨fun i => (c i).val, ?_⟩
    have : mkq u = mkq (∏ i, e i ^ (c i).val) := by
      rw [mkq_prod_pow]; simp [hc]
    obtain ⟨d, hd⟩ := (mkq_eq_iff _ _).mp this
    exact ⟨d, hd⟩

section
variable [Finite (Vq M)] {s : ℕ} (hs : finrank (ZMod 2) (Vq M) = s)
include hs

lemma card_le_of_genP {r : ℕ} {e : Fin r → M} (h : GenP e) : s ≤ r := by
  have := (genP_iff e).mp h
  have h1 : finrank (ZMod 2) (Submodule.span (ZMod 2) (Set.range fun i => mkq (e i))) = s := by
    rw [eq_top_iff.mpr this, finrank_top, hs]
  have h2 : finrank (ZMod 2) (Submodule.span (ZMod 2) (Set.range fun i => mkq (e i))) ≤
      Fintype.card (Fin r) := finrank_range_le_card (R := ZMod 2) fun i => mkq (e i)
  rw [h1] at h2
  simpa using h2

lemma exists_genP : ∃ e : Fin s → M, GenP e := by
  have b := Module.finBasisOfFinrankEq (ZMod 2) (Vq M) hs
  choose e he using fun i => mkq_surj (b i)
  refine ⟨e, (genP_iff e).mpr ?_⟩
  have : (fun i => mkq (e i)) = b := funext he
  rw [this, b.span_eq]

lemma genP_unique {e : Fin s → M} (h : GenP e) {ν ν' : Fin s → ℕ} (hν : ∀ i, ν i ≤ 1)
    (hν' : ∀ i, ν' i ≤ 1) {d d' : M} (heq : (∏ i, e i ^ ν i) * d ^ 2 = (∏ i, e i ^ ν' i) * d' ^ 2) :
    ν = ν' := by
  have hli : LinearIndependent (ZMod 2) fun i => mkq (e i) :=
    linearIndependent_of_top_le_span_of_card_eq_finrank ((genP_iff e).mp h) (by simp [hs])
  have h1 := congrArg mkq heq
  rw [mkq_mul, mkq_mul, mkq_sq, mkq_sq, add_zero, add_zero, mkq_prod_pow, mkq_prod_pow] at h1
  have h2 : ∑ i, ((ν i : ZMod 2) - (ν' i : ZMod 2)) • mkq (e i) = 0 := by
    simp only [sub_smul, Finset.sum_sub_distrib]; rw [h1, sub_self]
  have h3 := Fintype.linearIndependent_iff.mp hli _ h2
  funext i
  have h4 := h3 i
  rw [sub_eq_zero] at h4
  have a1 := hν i
  have a2 := hν' i
  interval_cases hi : ν i <;> interval_cases hj : ν' i <;> first | rfl | (exfalso; revert h4; decide)

lemma exists_genP_mem {x : M} (hx : mkq x ≠ 0) :
    ∃ e : Fin s → M, GenP e ∧ x ∈ Set.range e := by
  have hli : LinearIndepOn (ZMod 2) id ({mkq x} : Set (Vq M)) :=
    LinearIndepOn.singleton hx
  let b := Module.Basis.extend hli
  have : Fintype (hli.extend (Set.subset_univ _)) := Fintype.ofFinite _
  have hcard : Fintype.card (hli.extend (Set.subset_univ _)) = s := by
    rw [← hs, finrank_eq_card_basis b]
  let σ : Fin s ≃ (hli.extend (Set.subset_univ _)) :=
    (Fintype.equivFinOfCardEq hcard).symm
  have hmem : mkq x ∈ hli.extend (Set.subset_univ _) :=
    hli.subset_extend (Set.subset_univ _) rfl
  have : ∀ i : Fin s, ∃ y : M, mkq y = (σ i : Vq M) ∧ ((σ i : Vq M) = mkq x → y = x) := by
    intro i
    by_cases hi : (σ i : Vq M) = mkq x
    · exact ⟨x, hi.symm, fun _ => rfl⟩
    · obtain ⟨y, hy⟩ := mkq_surj (σ i : Vq M)
      exact ⟨y, hy, fun h => absurd h hi⟩
  choose e he1 he2 using this
  refine ⟨e, (genP_iff e).mpr ?_, ?_⟩
  · have hb : (fun i => mkq (e i)) = b ∘ σ := by
      funext i; simp [he1, b]
    rw [hb]
    have := (b.reindex σ.symm).span_eq
    rw [show (b ∘ σ) = ⇑(b.reindex σ.symm) from by
      funext i; simp [Module.Basis.reindex_apply]]
    rw [this]
  · refine ⟨σ.symm ⟨mkq x, hmem⟩, he2 _ ?_⟩
    simp
end

end Mod2

/-! ### The abstract degree formula -/

/-- **The degree of a multiquadratic extension** (O'Meara 1963, proof of 65:16, p. 183): let $K$ be a field of
characteristic $\ne 2$, $L/K$ an extension, and $b_1, \dots, b_t \in L$ with $b_i^2 = \beta_i \in K$ such that every
product of distinct $\beta_i$ is a non-square in $K$. Then $[K(b_1, \dots, b_t) : K] = 2^{t}$. -/
@[kb "omeara1963" "§65C, 65:16, p. 183 (abstract result: [K(√β₁, …, √β_t) : K] = 2^t)"]
theorem finrank_adjoin_sqrt {K L : Type*} [Field K] [Field L] [Algebra K L] (hK : ringChar K ≠ 2) {t : ℕ}
    (b : Fin t → L) (β : Fin t → K) (hb : ∀ i, b i ^ 2 = algebraMap K L (β i))
    (hβ : ∀ s : Finset (Fin t), s.Nonempty → ¬ IsSquare (∏ i ∈ s, β i)) :
    finrank K (IntermediateField.adjoin K (Set.range b)) = 2 ^ t := by
  have h2 : (2 : K) ≠ 0 := Ring.two_ne_zero hK
  cases t with
  | zero => exact Sec65CAux.stmt_base b
  | succ t => exact Sec65CAux.stmt_step h2 t (Sec65CAux.stmt_all L t) b β hb hβ

variable {F : Type} [Field F] [NumberField F]

/-- The quotient $\mathfrak u/\mathfrak u^2$ is finite of dimension $s = |T| + r_\infty$ over $\mathbb F_2$. (Internal.) -/
lemma sunit_vq (T : Finset (HeightOneSpectrum (𝓞 F))) :
    Finite (Mod2.Vq (HN.SUnit (F := F) T)) ∧
      finrank (ZMod 2) (Mod2.Vq (HN.SUnit (F := F) T)) = T.card + Fintype.card (InfinitePlace F) := by
  have hidx := HN.index_sq_sUnit (F := F) T
  have hpos := Fintype.card_pos (α := InfinitePlace F)
  have hexp : Units.rank F + T.card + 1 = T.card + Fintype.card (InfinitePlace F) := by
    unfold NumberField.Units.rank; omega
  have hcard : Nat.card (Mod2.Vq (HN.SUnit (F := F) T)) = 2 ^ (T.card + Fintype.card (InfinitePlace F)) := by
    rw [← hexp, ← hidx]; rfl
  have hfin : Finite (Mod2.Vq (HN.SUnit (F := F) T)) :=
    Nat.finite_of_card_ne_zero (by rw [hcard]; positivity)
  refine ⟨hfin, ?_⟩
  have := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := Mod2.Vq (HN.SUnit (F := F) T))
  rw [hcard, Nat.card_zmod] at this
  exact (Nat.pow_right_injective le_rfl this).symm

/-! ### Generators of $\mathfrak u$ modulo squares -/

/-- **A set of generators of $\mathfrak u$ modulo $\mathfrak u^2$** (O'Meara 1963, §65C, p. 182): every $S$-unit has the
form $\varepsilon_1^{\nu_1}\cdots\varepsilon_r^{\nu_r}\delta^2$ with $\nu_i \in \mathbb N$ and $\delta \in \mathfrak u$
(O'Meara: $\nu_i \in \mathbb Z$, equivalently $\nu_i \in \{0, 1\}$). Here $\mathfrak u$ = `HN.SUnit T`. -/
@[kb "omeara1963" "§65C, p. 182 (a set of generators of 𝔲 mod 𝔲²)"]
def IsGenModSq (T : Finset (HeightOneSpectrum (𝓞 F))) {r : ℕ} (e : Fin r → HN.SUnit (F := F) T) : Prop :=
  ∀ u : HN.SUnit (F := F) T, ∃ ν : Fin r → ℕ, ∃ d : HN.SUnit (F := F) T, u = (∏ i, e i ^ ν i) * d ^ 2

/-- **A set of generators has at least $s$ elements** (O'Meara 1963, §65C, p. 182: "$r \ge s$ since
$(\mathfrak u : \mathfrak u^2) = 2^{s}$"). -/
@[kb "omeara1963" "§65C, p. 182 (a set of generators of 𝔲 mod 𝔲² has r ≥ s elements)"]
theorem card_le_of_isGenModSq (T : Finset (HeightOneSpectrum (𝓞 F))) {r : ℕ} {e : Fin r → HN.SUnit (F := F) T}
    (h : IsGenModSq T e) : T.card + Fintype.card (InfinitePlace F) ≤ r := by
  haveI := (sunit_vq T).1
  exact Mod2.card_le_of_genP (sunit_vq T).2 h

/-- **There is a set of generators with exactly $s$ elements** (O'Meara 1963, §65C, p. 183, by the Dirichlet unit
theorem). -/
@[kb "omeara1963" "§65C, p. 183 (a set of s generators of 𝔲 mod 𝔲² exists)"]
theorem exists_isGenModSq (T : Finset (HeightOneSpectrum (𝓞 F))) :
    ∃ e : Fin (T.card + Fintype.card (InfinitePlace F)) → HN.SUnit (F := F) T, IsGenModSq T e := by
  haveI := (sunit_vq T).1
  exact Mod2.exists_genP (sunit_vq T).2

/-- **Uniqueness of the representation** (O'Meara 1963, §65C, p. 183): for a set of $s$ generators, the exponents
$\nu_i \in \{0, 1\}$ in $\varepsilon = \varepsilon_1^{\nu_1}\cdots\varepsilon_s^{\nu_s}\delta^2$ are unique. -/
@[kb "omeara1963" "§65C, p. 183 (the representation ε = ε₁^{ν₁}⋯ε_s^{ν_s}δ², ν_i ∈ {0,1}, is unique)"]
theorem isGenModSq_unique (T : Finset (HeightOneSpectrum (𝓞 F)))
    {e : Fin (T.card + Fintype.card (InfinitePlace F)) → HN.SUnit (F := F) T} (h : IsGenModSq T e)
    {ν ν' : Fin (T.card + Fintype.card (InfinitePlace F)) → ℕ} (hν : ∀ i, ν i ≤ 1) (hν' : ∀ i, ν' i ≤ 1)
    {d d' : HN.SUnit (F := F) T} (heq : (∏ i, e i ^ ν i) * d ^ 2 = (∏ i, e i ^ ν' i) * d' ^ 2) : ν = ν' := by
  haveI := (sunit_vq T).1
  exact Mod2.genP_unique (sunit_vq T).2 h hν hν' heq

/-- **Every non-square $S$-unit extends to a set of $s$ generators** (O'Meara 1963, §65C, p. 183). -/
@[kb "omeara1963" "§65C, p. 183 (every non-square S-unit extends to a set of s generators)"]
theorem exists_isGenModSq_mem (T : Finset (HeightOneSpectrum (𝓞 F))) {ε : HN.SUnit (F := F) T}
    (hε : ¬ IsSquare (((ε : Fˣ) : F))) :
    ∃ e : Fin (T.card + Fintype.card (InfinitePlace F)) → HN.SUnit (F := F) T, IsGenModSq T e ∧ ε ∈ Set.range e := by
  haveI := (sunit_vq T).1
  refine Mod2.exists_genP_mem (sunit_vq T).2 ?_
  intro h0
  rw [← Mod2.mkq_one, Mod2.mkq_eq_iff] at h0
  obtain ⟨d, hd⟩ := h0
  apply hε
  refine ⟨((d : Fˣ) : F), ?_⟩
  have := congrArg (fun z : HN.SUnit (F := F) T => ((z : Fˣ) : F)) hd
  simpa [pow_two] using this

/-! ### The field $F(\sqrt{\mathfrak u})$ -/

/-- **The field $F(\sqrt{\mathfrak u})$** (O'Meara 1963, §65C, p. 183): the field obtained by adjoining to $F$ the
square roots of all $S$-units, inside an algebraic closure of $F$. -/
@[kb "omeara1963" "§65C, p. 183 (the field F(√𝔲))"]
def sqrtSUnitField (T : Finset (HeightOneSpectrum (𝓞 F))) : IntermediateField F (AlgebraicClosure F) :=
  IntermediateField.adjoin F
    {x | ∃ u : HN.SUnit (F := F) T, x ^ 2 = algebraMap F (AlgebraicClosure F) ((u : Fˣ) : F)}

/-- **$F(\sqrt{\mathfrak u}) = F(\sqrt{\varepsilon_1}, \dots, \sqrt{\varepsilon_r})$** for a set of generators
$\varepsilon_1, \dots, \varepsilon_r$ of $\mathfrak u$ modulo $\mathfrak u^2$ and any choice of square roots
(O'Meara 1963, §65C, p. 183). -/
@[kb "omeara1963" "§65C, p. 183 (F(√𝔲) = F(√ε₁, …, √ε_s))"]
theorem sqrtSUnitField_eq_adjoin (T : Finset (HeightOneSpectrum (𝓞 F))) {r : ℕ} {e : Fin r → HN.SUnit (F := F) T}
    (h : IsGenModSq T e) (b : Fin r → AlgebraicClosure F)
    (hb : ∀ i, b i ^ 2 = algebraMap F (AlgebraicClosure F) ((e i : Fˣ) : F)) :
    sqrtSUnitField T = IntermediateField.adjoin F (Set.range b) := by
  unfold sqrtSUnitField
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro x ⟨u, hx⟩
    obtain ⟨ν, d, hu⟩ := h u
    let ι : HN.SUnit (F := F) T →* F := (Units.coeHom F).comp (HN.SUnit (F := F) T).subtype
    have hu' : ((u : Fˣ) : F) = (∏ i, ((e i : Fˣ) : F) ^ ν i) * ((d : Fˣ) : F) ^ 2 := by
      have := congrArg ι hu
      simp only [map_mul, map_prod, map_pow] at this
      exact this
    set y : AlgebraicClosure F :=
      (∏ i, b i ^ ν i) * algebraMap F (AlgebraicClosure F) ((d : Fˣ) : F) with hy
    have hymem : y ∈ IntermediateField.adjoin F (Set.range b) :=
      mul_mem (prod_mem fun i _ => pow_mem (IntermediateField.subset_adjoin F (Set.range b) (Set.mem_range_self i)) _)
        (IntermediateField.algebraMap_mem _ _)
    have hxy : x ^ 2 = y ^ 2 := by
      rw [hx, hu', hy, map_mul, map_prod, map_pow, mul_pow, ← Finset.prod_pow]
      congr 1
      · refine Finset.prod_congr rfl fun i _ => ?_
        rw [map_pow, ← hb i, ← pow_mul, ← pow_mul, mul_comm]
    rcases sq_eq_sq_iff_eq_or_eq_neg.mp hxy with h1 | h1
    · rw [h1]; exact hymem
    · rw [h1]; exact neg_mem hymem
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨i, rfl⟩
    exact IntermediateField.subset_adjoin F _ ⟨e i, hb i⟩

/-- **Proposition 65:16** (O'Meara 1963, p. 183): $[F(\sqrt{\mathfrak u}) : F] = 2^{s}$. -/
@[kb "omeara1963" "§65C, 65:16, p. 183 ([F(√𝔲) : F] = 2^s)"]
theorem finrank_sqrtSUnitField (T : Finset (HeightOneSpectrum (𝓞 F))) :
    finrank F (sqrtSUnitField T) = 2 ^ (T.card + Fintype.card (InfinitePlace F)) := by
  classical
  haveI := (sunit_vq T).1
  obtain ⟨e, he⟩ := exists_isGenModSq T
  have hb0 := fun i => IsAlgClosed.exists_pow_nat_eq
    (algebraMap F (AlgebraicClosure F) ((e i : Fˣ) : F)) (n := 2) two_pos
  choose b hb using hb0
  rw [sqrtSUnitField_eq_adjoin T he b hb]
  refine finrank_adjoin_sqrt (by rw [ringChar.eq_zero]; norm_num) b (fun i => ((e i : Fˣ) : F)) hb ?_
  intro s hs hsq
  obtain ⟨c, hc⟩ := hsq
  have hc0 : c ≠ 0 := by
    intro h0
    rw [h0, mul_zero] at hc
    exact (Finset.prod_ne_zero_iff.mpr fun i _ => (e i : Fˣ).ne_zero) hc
  have hcT : ∀ v ∉ (↑T : Set (HeightOneSpectrum (𝓞 F))), v.valuation F c = 1 := by
    intro v hv
    have h1 : v.valuation F c * v.valuation F c = 1 := by
      rw [← map_mul, ← hc, map_prod]
      exact Finset.prod_eq_one fun i _ => (e i).2 v hv
    have : v.valuation F c ^ 2 = 1 ^ 2 := by rw [pow_two, h1]; simp
    exact (pow_left_inj₀ zero_le' zero_le' two_ne_zero).mp this
  let d : HN.SUnit (F := F) T := ⟨Units.mk0 c hc0, fun v hv => hcT v hv⟩
  let ι : HN.SUnit (F := F) T →* F := (Units.coeHom F).comp (HN.SUnit (F := F) T).subtype
  have hι : Function.Injective ι := fun x y h => Subtype.ext (Units.ext h)
  let ν : Fin (T.card + Fintype.card (InfinitePlace F)) → ℕ := fun i => if i ∈ s then 1 else 0
  have hν : ∀ i, ν i ≤ 1 := fun i => by simp only [ν]; split_ifs <;> omega
  have heq : (∏ i, e i ^ ν i) * (1 : HN.SUnit (F := F) T) ^ 2 =
      (∏ i, e i ^ (fun _ => (0 : ℕ)) i) * d ^ 2 := by
    apply hι
    simp only [map_mul, map_prod, map_pow, map_one, pow_zero, Finset.prod_const_one, one_pow, mul_one,
      one_mul]
    have h3 : ∏ i, ι (e i) ^ ν i = ∏ i ∈ s, ι (e i) := by
      simp [ν, pow_ite]
    rw [h3]
    have h4 : ι d = c := rfl
    rw [h4, pow_two, ← hc]
    rfl
  have hu := Mod2.genP_unique (sunit_vq T).2 he hν (fun _ => by simp) heq
  obtain ⟨i, hi⟩ := hs
  have := congrFun hu i
  simp [ν, hi] at this

end QuadFormsKB.OMeara
