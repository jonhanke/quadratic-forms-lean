import QuadFormsKB.Literature.OMeara.Sec55Omega
import QuadFormsKB.Literature.OMeara.Sec43Center
import QuadFormsKB.Literature.OMeara.Sec43Exc
import QuadFormsKB.Literature.OMeara.Sec43Base

/-!
# O'Meara §43D: generators of the commutator subgroup $\Omega_n$ (43:6, 43:7, 43:8)

**Setting** (as in `Sec43E.lean`): $F$ a field with $2 \ne 0$ (`[Invertible (2 : F)]`), $(V, Q)$ a
finite-dimensional quadratic space of dimension $n$ which is regular (`(QuadraticMap.associated Q).Nondegenerate`),
O'Meara's $B$ is `bil Q` ($B(x,x) = Q(x)$), $O_n = O(V)$ is `orth Q`, $O^+_n$ is `orthPlus Q`, $\Omega_n$ is
`omega Q` (the commutator subgroup $[O_n, O_n]$) and $\tau_u$ is `symmetry Q u hu` ($Q(u) \ne 0$). The identity
$1_V$ is `1` and $-1_V$ is `LinearEquiv.neg F`.

**Proves** (O'Meara 1973 printing, Chapter IV, §43D, pp. 107–108):
* `omega_eq_closure_symmetryCommutators` (**43:6**, second sentence): $\Omega_n$ is generated by the commutators
  $\tau_x\tau_y\tau_x\tau_y$ of symmetries;
* `omega_eq_closure_sq_orthPlus` (**43:6**, third sentence): $\Omega_n$ is generated by the squares of rotations;
* `omega_eq_commutator_orthPlus` (**43:7**): for $n \ge 3$, $\Omega_n$ is also the commutator subgroup of $O^+_n$;
* `orth_eq_pair_of_finrank_one`, `card_orth_of_finrank_one`, `omega_eq_bot_of_finrank_one` (**43:8**, $n = 1$):
  $O_1 = \{\pm 1_V\}$ has two elements and $\Omega_1 = 1$;
* `omega_eq_bot_iff_of_finrank_two` (**43:8**, $n = 2$, with 43:12a): $\Omega_2 = 1$ iff $V$ is a hyperbolic plane
  over a field of three elements; `omega_eq_commutator_orthPlus_iff_of_finrank_two`: for $n = 2$, 43:7 holds only in
  this exceptional case;
* `omega_ne_bot_of_three_le` (used in the proof of 43:12b): $\Omega_n \ne 1$ for $n \ge 3$.

The first sentence of 43:6 ($\sigma^2 \in \Omega_n$) is `sq_mem_omega` (`Sec55.lean`); the last sentence of 43:8
($\Omega_2 = (O^+_2)^2$) is `omega_eq_sq_orthPlus` (`Sec55Omega.lean`, for $n \le 3$).

**Proof notes.** 43:6 follows O'Meara: the subgroup $G$ generated by the $\tau_x\tau_y\tau_x\tau_y$ is normalized by
$O_n$ ($\sigma\tau_x\sigma^{-1} = \tau_{\sigma x}$), and modulo $G$ any two symmetries commute, so by
Cartan–Dieudonné (43:3, `cd_list`) all commutators lie in $G$. For 43:7 O'Meara embeds $x, y$ in a regular ternary
subspace $T$ and uses the rotations $-\tau_x \perp 1_W$, $-\tau_y \perp 1_W$. Here the same idea is used with an
isometric involution $\rho$ of determinant $-1$ commuting with $\tau_x$ and $\tau_y$: $\rho = -1_V$ when $n$ is odd,
and $\rho = -\tau_w$ with $w$ anisotropic and orthogonal to $x, y$ when $n$ is even (such a $w$ exists for $n \ge 4$);
then $\tau_x\rho, \tau_y\rho \in O^+_n$ and their commutator is $\tau_x\tau_y\tau_x\tau_y$.
-/

open QuadraticMap Submodule Module LinearMap

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.OMeara

section Sec43Omega

variable {F : Type*} [Field F] [Invertible (2 : F)]
variable {V : Type*} [AddCommGroup V] [Module F V] [FiniteDimensional F V] (Q : QuadraticForm F V)

/-! ### Generators of $\Omega_n$ (43:6) -/

/-- The commutators $\tau_x\tau_y\tau_x\tau_y$ of two symmetries (O'Meara 43:6, p. 107; note
$\tau_x^{-1} = \tau_x$). -/
def symmetryCommutators : Set (V ≃ₗ[F] V) :=
  {g | ∃ (x y : V) (hx : Q x ≠ 0) (hy : Q y ≠ 0),
    g = symmetry Q x hx * symmetry Q y hy * symmetry Q x hx * symmetry Q y hy}

theorem symmetry_inv' {u : V} (hu : Q u ≠ 0) : (symmetry Q u hu)⁻¹ = symmetry Q u hu :=
  inv_eq_of_mul_eq_one_right (iv_symmetry_mul_self Q hu)

theorem symmetry_mul_four_eq_commutator {x y : V} (hx : Q x ≠ 0) (hy : Q y ≠ 0) :
    symmetry Q x hx * symmetry Q y hy * symmetry Q x hx * symmetry Q y hy =
      symmetry Q x hx * symmetry Q y hy * (symmetry Q x hx)⁻¹ * (symmetry Q y hy)⁻¹ := by
  rw [symmetry_inv', symmetry_inv']

theorem symmetryCommutators_subset_omega : symmetryCommutators Q ⊆ omega Q := by
  rintro g ⟨x, y, hx, hy, rfl⟩
  rw [symmetry_mul_four_eq_commutator]
  have := Subgroup.commutator_mem_commutator (symmetry_mem_orth Q hx) (symmetry_mem_orth Q hy)
  rwa [commutatorElement_def] at this

/-- The subgroup generated by the commutators of symmetries is normalized by $O(V)$. -/
theorem conj_mem_closure_symmetryCommutators {g : V ≃ₗ[F] V} (hg : g ∈ orth Q) {s : V ≃ₗ[F] V}
    (hs : s ∈ Subgroup.closure (symmetryCommutators Q)) :
    g * s * g⁻¹ ∈ Subgroup.closure (symmetryCommutators Q) := by
  induction hs using Subgroup.closure_induction with
  | mem s hs =>
    obtain ⟨x, y, hx, hy, rfl⟩ := hs
    apply Subgroup.subset_closure
    have hx' : Q (g x) ≠ 0 := by rw [hg x]; exact hx
    have hy' : Q (g y) ≠ 0 := by rw [hg y]; exact hy
    refine ⟨g x, g y, hx', hy', ?_⟩
    have e : g * (symmetry Q x hx * symmetry Q y hy * symmetry Q x hx * symmetry Q y hy) * g⁻¹ =
        (g * symmetry Q x hx * g⁻¹) * (g * symmetry Q y hy * g⁻¹) * (g * symmetry Q x hx * g⁻¹) *
          (g * symmetry Q y hy * g⁻¹) := by group
    rw [e, Sp55.conj_symmetry Q hg hx, Sp55.conj_symmetry Q hg hy]
  | one => simp
  | mul a b _ _ ha hb =>
    have e : g * (a * b) * g⁻¹ = (g * a * g⁻¹) * (g * b * g⁻¹) := by group
    rw [e]; exact Subgroup.mul_mem _ ha hb
  | inv a _ ha =>
    have e : g * a⁻¹ * g⁻¹ = (g * a * g⁻¹)⁻¹ := by group
    rw [e]; exact Subgroup.inv_mem _ ha

theorem commutator_symmetry_cd_prod_mem {u : V} (hu : Q u ≠ 0) (l : List {u : V // Q u ≠ 0}) :
    symmetry Q u hu * cd_prod Q l * (symmetry Q u hu)⁻¹ * (cd_prod Q l)⁻¹ ∈
      Subgroup.closure (symmetryCommutators Q) := by
  induction l with
  | nil => simp [cd_prod]
  | cons a l ih =>
    rw [cd_prod_cons]
    set t := symmetry Q u hu
    set s := symmetry Q a.1 a.2
    have e : t * (s * cd_prod Q l) * t⁻¹ * (s * cd_prod Q l)⁻¹ =
        (t * s * t⁻¹ * s⁻¹) * (s * (t * cd_prod Q l * t⁻¹ * (cd_prod Q l)⁻¹) * s⁻¹) := by
      group
    rw [e]
    refine Subgroup.mul_mem _ ?_ (conj_mem_closure_symmetryCommutators Q (symmetry_mem_orth Q a.2) ih)
    apply Subgroup.subset_closure
    exact ⟨u, a.1, hu, a.2, (symmetry_mul_four_eq_commutator Q hu a.2).symm⟩

theorem commutator_cd_prod_mem (l m : List {u : V // Q u ≠ 0}) :
    cd_prod Q l * cd_prod Q m * (cd_prod Q l)⁻¹ * (cd_prod Q m)⁻¹ ∈
      Subgroup.closure (symmetryCommutators Q) := by
  induction l with
  | nil => simp [cd_prod]
  | cons a l ih =>
    rw [cd_prod_cons]
    set s := symmetry Q a.1 a.2
    set P := cd_prod Q l
    set R := cd_prod Q m
    have e : s * P * R * (s * P)⁻¹ * R⁻¹ =
        (s * (P * R * P⁻¹ * R⁻¹) * s⁻¹) * (s * R * s⁻¹ * R⁻¹) := by
      group
    rw [e]
    exact Subgroup.mul_mem _ (conj_mem_closure_symmetryCommutators Q (symmetry_mem_orth Q a.2) ih)
      (commutator_symmetry_cd_prod_mem Q a.2 m)

/-- **O'Meara 43:6**, second sentence (p. 107). For a regular quadratic space $V$, the commutator subgroup
$\Omega_n$ of $O_n$ is generated by the commutators $\tau_x\tau_y\tau_x\tau_y$ ($= \tau_x\tau_y\tau_x^{-1}\tau_y^{-1}$)
of symmetries $\tau_x, \tau_y$. -/
@[kb "omeara1963" "§43D, 43:6, p. 107 (Ω_n is generated by the commutators τ_xτ_yτ_xτ_y)"]
theorem omega_eq_closure_symmetryCommutators (hQ : (QuadraticMap.associated Q).Nondegenerate) :
    omega Q = Subgroup.closure (symmetryCommutators Q) := by
  apply le_antisymm
  · unfold omega
    rw [Subgroup.commutator_le]
    intro σ hσ ρ hρ
    obtain ⟨l, -, rfl⟩ := cd_list Q hQ hσ
    obtain ⟨m, -, rfl⟩ := cd_list Q hQ hρ
    rw [commutatorElement_def]
    exact commutator_cd_prod_mem Q l m
  · exact (Subgroup.closure_le _).2 (symmetryCommutators_subset_omega Q)

theorem symmetry_mul_symmetry_mem_orthPlus {x y : V} (hx : Q x ≠ 0) (hy : Q y ≠ 0) :
    symmetry Q x hx * symmetry Q y hy ∈ orthPlus Q := by
  refine ⟨Subgroup.mul_mem _ (symmetry_mem_orth Q hx) (symmetry_mem_orth Q hy), ?_⟩
  refine MonoidHom.mem_ker.mpr ?_
  rw [map_mul, det_symmetry, det_symmetry]
  simp

/-- **O'Meara 43:6**, third sentence (p. 107). For a regular quadratic space, $\Omega_n$ is generated by the
squares $\sigma^2$ of the rotations $\sigma \in O^+_n$. -/
@[kb "omeara1963" "§43D, 43:6, p. 107 (Ω_n is generated by the squares of rotations)"]
theorem omega_eq_closure_sq_orthPlus (hQ : (QuadraticMap.associated Q).Nondegenerate) :
    omega Q = Subgroup.closure {g | ∃ σ ∈ orthPlus Q, g = σ ^ 2} := by
  apply le_antisymm
  · rw [omega_eq_closure_symmetryCommutators Q hQ, Subgroup.closure_le]
    rintro g ⟨x, y, hx, hy, rfl⟩
    apply Subgroup.subset_closure
    exact ⟨_, symmetry_mul_symmetry_mem_orthPlus Q hx hy, by rw [pow_two, ← mul_assoc]⟩
  · rw [Subgroup.closure_le]
    rintro g ⟨σ, hσ, rfl⟩
    exact sq_mem_omega Q hQ hσ.1

/-! ### $\Omega_n$ is the commutator subgroup of $O^+_n$ for $n \ge 3$ (43:7) -/

theorem symmetry_comm_of_bil_eq_zero {x w : V} (hx : Q x ≠ 0) (hw : Q w ≠ 0) (hxw : bil Q x w = 0) :
    symmetry Q x hx * symmetry Q w hw = symmetry Q w hw * symmetry Q x hx := by
  have hwx : bil Q w x = 0 := by rw [bil_comm]; exact hxw
  ext v
  simp only [LinearEquiv.mul_apply, symmetry_apply, bil_sub_left, bil_smul_left, hxw, hwx, mul_zero,
    sub_zero]
  abel

/-- In a regular space of even dimension $n \ge 4$, two anisotropic vectors $x, y$ have an anisotropic vector
orthogonal to both. (The orthogonal complement $P^\perp$ of $P = Fx + Fy$ has dimension $\ge n - 2$; if it were
totally isotropic it would lie in $P^{\perp\perp} = P$, forcing $n = 4$ and $P^\perp = P \ni x$.) -/
theorem exists_aniso_orth_of_four_le (hQ : (QuadraticMap.associated Q).Nondegenerate) (h4 : 4 ≤ finrank F V)
    {x y : V} (hx : Q x ≠ 0) :
    ∃ w, Q w ≠ 0 ∧ bil Q x w = 0 ∧ bil Q y w = 0 := by
  set B : LinearMap.BilinForm F V := QuadraticMap.associated Q
  set P := Submodule.span F (Set.range ![x, y])
  set M := LinearMap.BilinForm.orthogonal B P
  have hxP : x ∈ P := Submodule.subset_span ⟨0, rfl⟩
  have hyP : y ∈ P := Submodule.subset_span ⟨1, rfl⟩
  have hmem : ∀ w, w ∈ M → bil Q x w = 0 ∧ bil Q y w = 0 := by
    intro w hw
    rw [LinearMap.BilinForm.mem_orthogonal_iff] at hw
    exact ⟨hw x hxP, hw y hyP⟩
  by_contra hno
  push Not at hno
  -- every vector of M is isotropic, hence M is totally isotropic
  have hQM : ∀ w ∈ M, Q w = 0 := by
    intro w hw
    by_contra hw0
    have := hmem w hw
    exact hno w hw0 this.1 this.2
  have hBM : ∀ a ∈ M, ∀ b ∈ M, bil Q a b = 0 := by
    intro a ha b hb
    have h := Q_add Q a b
    rw [hQM a ha, hQM b hb, hQM (a + b) (M.add_mem ha hb)] at h
    have : (2 : F) * bil Q a b = 0 := by linear_combination -h
    exact (mul_eq_zero.1 this).resolve_left iv_two_ne
  have hMP : M ≤ P := by
    have hMM : M ≤ B.orthogonal M := by
      intro a ha
      rw [LinearMap.BilinForm.mem_orthogonal_iff]
      intro b hb
      exact hBM b hb a ha
    have hrefl : B.IsRefl := fun a b h => (bil_comm Q b a).trans h
    calc M ≤ B.orthogonal M := hMM
      _ = P := LinearMap.BilinForm.orthogonal_orthogonal hQ hrefl P
  have hdimM : finrank F M + finrank F P = finrank F V := by
    have : finrank F M = finrank F V - finrank F P := LinearMap.BilinForm.finrank_orthogonal hQ P
    have hle := Submodule.finrank_le P
    omega
  have hdimP : finrank F P ≤ 2 := by
    exact (finrank_range_le_card (R := F) ![x, y]).trans (by simp)
  have hle := Submodule.finrank_mono hMP
  have hMeqP : M = P := Submodule.eq_of_le_of_finrank_eq hMP (by omega)
  have hxM : x ∈ M := hMeqP ▸ hxP
  exact hx (hQM x hxM)

/-- In a regular space of dimension $n \ge 3$, for anisotropic $x, y$ there is an isometry $\rho$ with
$\det\rho = -1$ commuting with $\tau_x$ and $\tau_y$: $-1_V$ if $n$ is odd, $-\tau_w$ ($w \perp x, y$) if $n$
is even. -/
theorem exists_reflexion_comm (hQ : (QuadraticMap.associated Q).Nondegenerate) (h3 : 3 ≤ finrank F V)
    {x y : V} (hx : Q x ≠ 0) (hy : Q y ≠ 0) :
    ∃ ρ ∈ orth Q, LinearEquiv.det ρ = -1 ∧ ρ * symmetry Q x hx = symmetry Q x hx * ρ ∧
      ρ * symmetry Q y hy = symmetry Q y hy * ρ := by
  have hneg : (LinearEquiv.neg F : V ≃ₗ[F] V) ∈ orth Q := fun v => by simp
  have hcomm : ∀ g : V ≃ₗ[F] V, (LinearEquiv.neg F : V ≃ₗ[F] V) * g = g * LinearEquiv.neg F := by
    intro g; ext v; simp
  rcases Nat.even_or_odd (finrank F V) with he | ho
  · obtain ⟨w, hw, hxw, hyw⟩ := exists_aniso_orth_of_four_le Q hQ (by
      obtain ⟨k, hk⟩ := he; omega) (y := y) hx
    refine ⟨LinearEquiv.neg F * symmetry Q w hw,
      Subgroup.mul_mem _ hneg (symmetry_mem_orth Q hw), ?_, ?_, ?_⟩
    · rw [map_mul, det_symmetry, Sp55.det_neg_eq, he.neg_one_pow]; simp
    · rw [mul_assoc, ← symmetry_comm_of_bil_eq_zero Q hx hw hxw, ← mul_assoc, hcomm, mul_assoc]
    · rw [mul_assoc, ← symmetry_comm_of_bil_eq_zero Q hy hw hyw, ← mul_assoc, hcomm, mul_assoc]
  · exact ⟨LinearEquiv.neg F, hneg, by rw [Sp55.det_neg_eq, ho.neg_one_pow], hcomm _, hcomm _⟩

/-- **O'Meara 43:7** (p. 107). For a regular quadratic space of dimension $n \ge 3$, $\Omega_n$ is also the
commutator subgroup of the rotation group: $\Omega_n = [O^+_n, O^+_n]$. -/
@[kb "omeara1963" "§43D, 43:7, p. 107"]
theorem omega_eq_commutator_orthPlus (hQ : (QuadraticMap.associated Q).Nondegenerate) (h3 : 3 ≤ finrank F V) :
    omega Q = ⁅orthPlus Q, orthPlus Q⁆ := by
  apply le_antisymm
  · rw [omega_eq_closure_symmetryCommutators Q hQ, Subgroup.closure_le]
    rintro g ⟨x, y, hx, hy, rfl⟩
    obtain ⟨ρ, hρ, hdet, hρx, hρy⟩ := exists_reflexion_comm Q hQ h3 hx hy
    have hmem : ∀ {u : V} (hu : Q u ≠ 0), symmetry Q u hu * ρ ∈ orthPlus Q := fun {u} hu =>
      ⟨Subgroup.mul_mem _ (symmetry_mem_orth Q hu) hρ, by
        refine MonoidHom.mem_ker.mpr ?_
        rw [map_mul, det_symmetry, hdet]; simp⟩
    have e : symmetry Q x hx * symmetry Q y hy * symmetry Q x hx * symmetry Q y hy =
        symmetry Q x hx * ρ * (symmetry Q y hy * ρ) * (symmetry Q x hx * ρ)⁻¹ *
          (symmetry Q y hy * ρ)⁻¹ := by
      rw [mul_inv_rev, mul_inv_rev, symmetry_inv', symmetry_inv']
      have e1 : ρ * symmetry Q y hy * ρ⁻¹ = symmetry Q y hy := by rw [hρy]; group
      have e2 : ρ * symmetry Q x hx * ρ⁻¹ = symmetry Q x hx := by rw [hρx]; group
      calc symmetry Q x hx * symmetry Q y hy * symmetry Q x hx * symmetry Q y hy
          = symmetry Q x hx * (ρ * symmetry Q y hy * ρ⁻¹) * (ρ * symmetry Q x hx * ρ⁻¹) *
              symmetry Q y hy := by rw [e1, e2]
        _ = _ := by group
    rw [e]
    have := Subgroup.commutator_mem_commutator (hmem hx) (hmem hy)
    rwa [commutatorElement_def] at this
  · exact Subgroup.commutator_mono inf_le_left inf_le_left

/-! ### The small cases (43:8) -/

theorem omega_eq_bot_iff : omega Q = ⊥ ↔ ∀ σ ∈ orth Q, ∀ ρ ∈ orth Q, σ * ρ = ρ * σ := by
  constructor
  · intro h σ hσ ρ hρ
    have := Subgroup.commutator_mem_commutator hσ hρ
    rw [← omega, h, Subgroup.mem_bot, commutatorElement_eq_one_iff_mul_comm] at this
    exact this
  · intro h
    rw [eq_bot_iff]
    unfold omega
    rw [Subgroup.commutator_le]
    intro σ hσ ρ hρ
    rw [Subgroup.mem_bot, commutatorElement_eq_one_iff_mul_comm]
    exact h σ hσ ρ hρ

/-- **O'Meara 43:8** (p. 108), the case $n = 1$: the orthogonal group of a regular line is $\{\pm 1_V\}$. -/
@[kb "omeara1963" "§43D, 43:8, p. 108 (n = 1: O_1 = {±1_V})"]
theorem orth_eq_pair_of_finrank_one (hQ : (QuadraticMap.associated Q).Nondegenerate) (h1 : finrank F V = 1) :
    (orth Q : Set (V ≃ₗ[F] V)) = {1, LinearEquiv.neg F} := by
  obtain ⟨x, hx⟩ : ∃ x : V, x ≠ 0 := by
    have : Nontrivial V := Module.nontrivial_of_finrank_pos (R := F) (by omega)
    exact exists_ne 0
  have hspan : ∀ v : V, ∃ c : F, v = c • x := by
    intro v
    have htop : (F ∙ x) = ⊤ := Submodule.eq_top_of_finrank_eq (by rw [finrank_span_singleton hx, h1])
    have hv : v ∈ (F ∙ x) := htop ▸ Submodule.mem_top
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.1 hv
    exact ⟨c, hc.symm⟩
  have hQx : Q x ≠ 0 := by
    intro h0
    apply hx
    refine hQ.1 x fun z => ?_
    obtain ⟨c, rfl⟩ := hspan z
    show bil Q x (c • x) = 0
    rw [bil_smul_right, bil_self, h0, mul_zero]
  ext σ
  simp only [SetLike.mem_coe, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · intro hσ
    obtain ⟨a, ha⟩ := hspan (σ x)
    have hQa : a ^ 2 = 1 := by
      have := hσ x
      rw [ha, Q_smul] at this
      exact mul_right_cancel₀ hQx (by rw [this, one_mul])
    have hσv : ∀ v, σ v = a • v := by
      intro v
      obtain ⟨c, rfl⟩ := hspan v
      rw [map_smul, ha, smul_comm]
    rcases mul_self_eq_one_iff.mp (show a * a = 1 by rw [← pow_two]; exact hQa) with h | h
    · left; ext v; rw [hσv, h, one_smul]; rfl
    · right; ext v; rw [hσv, h, neg_one_smul]; rfl
  · rintro (rfl | rfl)
    · exact Subgroup.one_mem _
    · intro v; simp

/-- **O'Meara 43:8** (p. 108), the case $n = 1$: $O_1$ is a group of two elements. -/
@[kb "omeara1963" "§43D, 43:8, p. 108 (n = 1: O_1 has two elements)"]
theorem card_orth_of_finrank_one (hQ : (QuadraticMap.associated Q).Nondegenerate) (h1 : finrank F V = 1) :
    Nat.card (orth Q) = 2 := by
  have hne : (1 : V ≃ₗ[F] V) ≠ LinearEquiv.neg F := by
    have : Nontrivial V := Module.nontrivial_of_finrank_pos (R := F) (by omega)
    obtain ⟨x, hx⟩ := exists_ne (0 : V)
    intro h
    have h' := congrArg (fun g : V ≃ₗ[F] V => g x) h
    simp only [LinearEquiv.coe_one, id_eq, LinearEquiv.coe_neg, Pi.neg_apply] at h'
    have : (2 : F) • x = 0 := by rw [two_smul]; nth_rewrite 1 [h']; simp
    exact hx ((smul_eq_zero.1 this).resolve_left iv_two_ne)
  rw [← SetLike.coe_sort_coe, orth_eq_pair_of_finrank_one Q hQ h1, Nat.card_coe_set_eq,
    Set.ncard_pair hne]

/-- **O'Meara 43:8** (p. 108), the case $n = 1$: $\Omega_1 = 1$. -/
@[kb "omeara1963" "§43D, 43:8, p. 108 (n = 1: Ω_1 = 1)"]
theorem omega_eq_bot_of_finrank_one (h1 : finrank F V = 1) : omega Q = ⊥ :=
  (omega_eq_bot_iff Q).2 (commutative_of_finrank_eq_one Q h1)

/-- **O'Meara 43:8** (p. 108, with Corollary 43:12a). For a regular binary space, $\Omega_2 = 1$ if and only if
$V$ is a hyperbolic plane over a field of three elements. -/
@[kb "omeara1963" "§43D, 43:8, p. 108 (n = 2: Ω_2 = 1 iff V is a hyperbolic plane over a field of three elements)"]
theorem omega_eq_bot_iff_of_finrank_two (hQ : (QuadraticMap.associated Q).Nondegenerate)
    (h2 : finrank F V = 2) : omega Q = ⊥ ↔ IsExceptional43 Q := by
  rw [omega_eq_bot_iff]
  constructor
  · intro h
    by_contra hexc
    exact not_commutative_of_two_le Q hQ hexc h2.ge h
  · exact orth_comm_of_exceptional Q hQ

/-- **O'Meara 43:8** (p. 108): "Proposition 43:7 is only exceptionally true for binary spaces". For a regular binary
space the commutator subgroup of $O^+_2$ is trivial, so $\Omega_2 = [O^+_2, O^+_2]$ holds exactly when $V$ is a
hyperbolic plane over a field of three elements. -/
@[kb "omeara1963" "§43D, 43:8, p. 108 (n = 2: 43:7 holds only in the exceptional case)"]
theorem omega_eq_commutator_orthPlus_iff_of_finrank_two (hQ : (QuadraticMap.associated Q).Nondegenerate)
    (h2 : finrank F V = 2) : omega Q = ⁅orthPlus Q, orthPlus Q⁆ ↔ IsExceptional43 Q := by
  have hbot : ⁅orthPlus Q, orthPlus Q⁆ = ⊥ := by
    rw [eq_bot_iff, Subgroup.commutator_le]
    intro σ hσ ρ hρ
    rw [Subgroup.mem_bot, commutatorElement_eq_one_iff_mul_comm]
    exact orthPlus_comm_of_finrank_le_two Q hQ h2.le hσ hρ
  rw [hbot, omega_eq_bot_iff_of_finrank_two Q hQ h2]

/-- $\Omega_n \ne 1$ for a regular space of dimension $n \ge 3$ (O'Meara, proof of 43:12b, p. 110): $O_n$ is not
commutative (43:12a). -/
@[kb "omeara1963" "§43E, 43:12b, p. 110 (proof: Ω_n ≠ 1 for n ≥ 3)"]
theorem omega_ne_bot_of_three_le (hQ : (QuadraticMap.associated Q).Nondegenerate) (h3 : 3 ≤ finrank F V) :
    omega Q ≠ ⊥ := by
  rw [Ne, omega_eq_bot_iff]
  exact not_commutative_of_two_le Q hQ (fun h => by have := h.1; omega) (by omega)

end Sec43Omega

