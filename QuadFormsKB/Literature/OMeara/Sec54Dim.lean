/-
# O'Meara §54: dimension of the Clifford algebra (54:2, 54:2a, 54:2b, 54:3, 54:3a)

**Setting** (O'Meara's Chapter V): $F$ a field of characteristic $\ne 2$ (`Invertible (2 : F)`), $V$ a finite-dimensional
$F$-vector space with a quadratic form $Q$; O'Meara's bilinear form $B$ is `QuadraticMap.associated Q`
($B(x, x) = Q(x)$). An orthogonal basis $x_0, \dots, x_{n-1}$ of $V$ is a basis
`e : Module.Basis (Fin n) F V` with $B(x_i, x_k) = 0$ for $i \ne k$ (indices are 0-based).

**Compatible algebras.** O'Meara calls an algebra $A$ *compatible* with $V$ if $V \subseteq A$ with $x^2 = Q(x)1_A$ for
all $x \in V$. Here this is a linear map `j : V →ₗ[F] A` with `∀ x, j x * j x = algebraMap F A (Q x)`. Injectivity of
`j` is not needed for 54:2, 54:2a, 54:2b (it is part of the definition `IsCliffordAlgebra`).
The *words* of an orthogonal basis are $x_0^{e_0}\cdots x_{n-1}^{e_{n-1}}$ with $e_i \in \{0, 1\}$, i.e. for a
subset $s \subseteq \{0, \dots, n-1\}$ the product of the $j(x_i)$, $i \in s$, in increasing order (`word`).

**Clifford algebra.** O'Meara's definition (a compatible algebra with a universal mapping property) is
`IsCliffordAlgebra`; Mathlib's `CliffordAlgebra Q` (with universal property `CliffordAlgebra.lift`) is the model.
O'Meara's 54:1 (uniqueness up to unique isomorphism) is exactly Mathlib's universal property
(`CliffordAlgebra.lift`, `CliffordAlgebra.lift_unique`), and is not restated.

**Generalization.** O'Meara assumes $V$ regular throughout §54. None of the statements below needs regularity
(only $2$ invertible and, where stated, finite dimension).

**Proves**
* `adjoin_range_toSubmodule_eq_span_word` (**54:2**): the subalgebra generated by $V$ in a compatible algebra $A$ is
  the span of the $2^n$ words of an orthogonal basis;
* `finrank_adjoin_range_le` (**54:2a**): its dimension is at most $2^n$;
* `exists_algEquiv_cliffordAlgebra_of_finrank_eq`, `isCliffordAlgebra_adjoin_of_finrank_eq` (**54:2b**): if the
  dimension is $2^n$, the subalgebra generated by $V$ is a Clifford algebra of $V$;
* `cliffordAlgebra_ι_injective`, `isCliffordAlgebra_cliffordAlgebra` (**54:3**): $V$ has a Clifford algebra, namely
  Mathlib's, and it contains $V$;
* `finrank_cliffordAlgebra`, `cliffordAlgebra_adjoin_range_ι`, `derivedBasis` (**54:3a**): the Clifford algebra
  is generated by $V$, has dimension $2^n$, and the words of an orthogonal basis form a basis (the derived base).
-/
import Mathlib
import QuadFormsKB.Citation

open Module

set_option linter.unusedSectionVars false

noncomputable section

universe w

namespace QuadFormsKB.OMeara

namespace CliffordDim

/-- Induction on a finset removing the minimum element (Mathlib has only the maximum version). -/
theorem finset_induction_min {α : Type*} [LinearOrder α] {P : Finset α → Prop} (s : Finset α)
    (empty : P ∅) (step : ∀ a s, (∀ b ∈ s, a < b) → P s → P (insert a s)) : P s := by
  classical
  induction' hc : s.card using Nat.strong_induction_on with m ih generalizing s
  rcases s.eq_empty_or_nonempty with rfl | hne
  · exact empty
  · have ha : s.min' hne ∈ s := Finset.min'_mem s hne
    have hs : s = insert (s.min' hne) (s.erase (s.min' hne)) := (Finset.insert_erase ha).symm
    rw [hs]
    refine step _ _ (fun b hb => ?_) (ih _ ?_ _ rfl)
    · have := Finset.mem_erase.mp hb
      exact lt_of_le_of_ne (Finset.min'_le s b this.2) (Ne.symm this.1)
    · rw [← hc]; exact Finset.card_erase_lt_of_mem ha

section Words

variable {F : Type*} [Field F] {V : Type*} [AddCommGroup V] [Module F V]
variable {A : Type*} [Ring A] [Algebra F A]
variable {n : ℕ}

/-- **The word of a subset** $s \subseteq \{0, \dots, n-1\}$ (O'Meara §54, p. 132: the products
$x_0^{e_0}\cdots x_{n-1}^{e_{n-1}}$, $e_i = 0, 1$): the product of $j(x_i)$ over $i \in s$ in increasing order of $i$,
for the basis $x_i = $ `e i` and the map `j` of $V$ into the algebra. -/
def word (j : V →ₗ[F] A) (e : Module.Basis (Fin n) F V) (s : Finset (Fin n)) : A :=
  ((s.sort (· ≤ ·)).map fun i => j (e i)).prod

variable (j : V →ₗ[F] A) (e : Module.Basis (Fin n) F V)

@[simp] theorem word_empty : word j e ∅ = 1 := by simp [word]

theorem word_singleton (i : Fin n) : word j e {i} = j (e i) := by simp [word]

theorem word_insert_min {a : Fin n} {s : Finset (Fin n)} (h : ∀ b ∈ s, a < b) :
    word j e (insert a s) = j (e a) * word j e s := by
  have ha : a ∉ s := fun hm => lt_irrefl _ (h a hm)
  unfold word
  rw [Finset.sort_insert (· ≤ ·) (fun b hb => (h b hb).le) ha, List.map_cons, List.prod_cons]

theorem word_mem_adjoin (s : Finset (Fin n)) : word j e s ∈ Algebra.adjoin F (Set.range j) := by
  refine Subalgebra.list_prod_mem _ fun x hx => ?_
  obtain ⟨i, -, rfl⟩ := List.mem_map.mp hx
  exact Algebra.subset_adjoin ⟨e i, rfl⟩

/-- The span of the words of subsets of `u`. -/
def wordSpan (u : Finset (Fin n)) : Submodule F A :=
  Submodule.span F {w | ∃ t ⊆ u, word j e t = w}

theorem word_mem_wordSpan {t u : Finset (Fin n)} (h : t ⊆ u) : word j e t ∈ wordSpan j e u :=
  Submodule.subset_span ⟨t, h, rfl⟩

theorem wordSpan_mono {u v : Finset (Fin n)} (h : u ⊆ v) : wordSpan j e u ≤ wordSpan j e v :=
  Submodule.span_mono fun _ ⟨t, ht, hw⟩ => ⟨t, ht.trans h, hw⟩

theorem wordSpan_univ : wordSpan j e Finset.univ = Submodule.span F (Set.range (word j e)) := by
  unfold wordSpan
  congr 1
  ext w
  exact ⟨fun ⟨t, _, hw⟩ => ⟨t, hw⟩, fun ⟨t, hw⟩ => ⟨t, Finset.subset_univ _, hw⟩⟩

section Orth

variable [Invertible (2 : F)] (Q : QuadraticForm F V)
variable (h : ∀ x, j x * j x = algebraMap F A (Q x))
variable (horth : ∀ i k, i ≠ k → (QuadraticMap.associated Q) (e i) (e k) = 0)
include h horth

/-- Orthogonal vectors anticommute in a compatible algebra (O'Meara §54, p. 132). -/
theorem mul_eq_neg_mul_of_orth {i k : Fin n} (hik : i ≠ k) :
    j (e i) * j (e k) = -(j (e k) * j (e i)) := by
  have ho : Q.IsOrtho (e i) (e k) := QuadraticMap.associated_isOrtho.mp (horth i k hik)
  have h1 := h (e i + e k)
  rw [map_add, ho, map_add] at h1
  have h4 : (j (e i) + j (e k)) * (j (e i) + j (e k)) =
      j (e i) * j (e i) + (j (e i) * j (e k) + j (e k) * j (e i)) + j (e k) * j (e k) := by
    noncomm_ring
  rw [h4, h, h] at h1
  have h2 : j (e i) * j (e k) + j (e k) * j (e i) = 0 := by
    have h5 : j (e i) * j (e k) + j (e k) * j (e i) =
        (algebraMap F A (Q (e i)) + (j (e i) * j (e k) + j (e k) * j (e i)) +
          algebraMap F A (Q (e k))) - (algebraMap F A (Q (e i)) + algebraMap F A (Q (e k))) := by
      abel
    rw [h5, h1, sub_self]
  exact eq_neg_of_add_eq_zero_left h2

/-- Moving one more basis vector into a word stays inside the span of the words of the enlarged support. -/
theorem mul_word_mem_wordSpan (i : Fin n) (s : Finset (Fin n)) :
    j (e i) * word j e s ∈ wordSpan j e (insert i s) := by
  induction s using finset_induction_min generalizing i with
  | empty =>
    rw [word_empty, mul_one, ← word_singleton j e i]
    exact word_mem_wordSpan j e (by simp)
  | step k s hk ih =>
    have hks : k ∉ s := fun hm => lt_irrefl _ (hk k hm)
    rcases lt_trichotomy i k with hik | hik | hki
    · have hw := word_insert_min j e (a := i) (s := insert k s) (fun b hb => by
        rcases Finset.mem_insert.mp hb with hb' | hb'
        · rw [hb']; exact hik
        · exact hik.trans (hk b hb'))
      rw [← hw]
      exact word_mem_wordSpan j e subset_rfl
    · have hik := hik.symm
      subst hik
      rw [word_insert_min j e hk, ← mul_assoc, h, ← Algebra.smul_def]
      exact Submodule.smul_mem _ _ (word_mem_wordSpan j e
        ((Finset.subset_insert _ _).trans (Finset.subset_insert _ _)))
    · rw [word_insert_min j e hk, ← mul_assoc,
        mul_eq_neg_mul_of_orth j e Q h horth hki.ne', neg_mul, mul_assoc]
      refine Submodule.neg_mem _ ?_
      have hle : wordSpan j e (insert i s) ≤
          (wordSpan j e (insert i (insert k s))).comap (LinearMap.mulLeft F (j (e k))) := by
        refine Submodule.span_le.mpr ?_
        rintro w ⟨t, ht, rfl⟩
        change j (e k) * word j e t ∈ wordSpan j e (insert i (insert k s))
        have hlt : ∀ b ∈ t, k < b := fun b hb => by
          rcases Finset.mem_insert.mp (ht hb) with hb' | hb'
          · rw [hb']; exact hki
          · exact hk b hb'
        rw [← word_insert_min j e hlt]
        refine word_mem_wordSpan j e ?_
        intro x hx
        rcases Finset.mem_insert.mp hx with hx' | hx'
        · rw [hx']; exact Finset.mem_insert_of_mem (Finset.mem_insert_self _ _)
        · rcases Finset.mem_insert.mp (ht hx') with h' | h'
          · rw [h']; exact Finset.mem_insert_self _ _
          · exact Finset.mem_insert_of_mem (Finset.mem_insert_of_mem h')
      exact hle (ih i)

theorem mul_mem_wordSpan_univ {x : A} (hx : x ∈ wordSpan j e Finset.univ) (i : Fin n) :
    j (e i) * x ∈ wordSpan j e Finset.univ := by
  have hle : wordSpan j e Finset.univ ≤
      (wordSpan j e Finset.univ).comap (LinearMap.mulLeft F (j (e i))) := by
    refine Submodule.span_le.mpr ?_
    rintro w ⟨t, -, rfl⟩
    exact wordSpan_mono j e (Finset.subset_univ _) (mul_word_mem_wordSpan j e Q h horth i t)
  exact hle hx

theorem word_mul_mem_wordSpan_univ (s : Finset (Fin n)) :
    ∀ y ∈ wordSpan j e Finset.univ, word j e s * y ∈ wordSpan j e Finset.univ := by
  induction s using finset_induction_min with
  | empty => intro y hy; rw [word_empty, one_mul]; exact hy
  | step k s hk ih =>
    intro y hy
    rw [word_insert_min j e hk, mul_assoc]
    exact mul_mem_wordSpan_univ j e Q h horth (ih y hy) k

theorem mul_mem_wordSpan_univ' {x y : A} (hx : x ∈ wordSpan j e Finset.univ)
    (hy : y ∈ wordSpan j e Finset.univ) : x * y ∈ wordSpan j e Finset.univ := by
  refine Submodule.span_induction (p := fun x _ => x * y ∈ wordSpan j e Finset.univ)
    ?_ ?_ ?_ ?_ hx
  · rintro w ⟨t, -, rfl⟩
    exact word_mul_mem_wordSpan_univ j e Q h horth t y hy
  · simp
  · intro a b _ _ ha hb
    rw [add_mul]; exact add_mem ha hb
  · intro c a _ ha
    rw [smul_mul_assoc]; exact Submodule.smul_mem _ _ ha

/-- **54:2** (O'Meara 1973, §54, 54:2, p. 132). Let $A$ be an algebra compatible with $V$ (a linear map
$j : V \to A$ with $j(x)^2 = Q(x)1_A$) and $x_0, \dots, x_{n-1}$ an orthogonal basis of $V$. Then the subalgebra
generated by $V$ in $A$ (which contains $1_A$) is spanned by the $2^n$ words
$j(x_0)^{e_0}\cdots j(x_{n-1})^{e_{n-1}}$, $e_i \in \{0, 1\}$ (`word`).
Regularity of $V$ is not used (generalization). -/
@[kb "omeara1963" "§54, 54:2, p. 132"]
theorem adjoin_range_toSubmodule_eq_span_word :
    Subalgebra.toSubmodule (Algebra.adjoin F (Set.range j)) =
      Submodule.span F (Set.range (word j e)) := by
  rw [← wordSpan_univ]
  apply le_antisymm
  · intro x hx
    have hx' : x ∈ Algebra.adjoin F (Set.range j) := hx
    clear hx
    induction hx' using Algebra.adjoin_induction with
    | mem x hxs =>
      obtain ⟨v, rfl⟩ := hxs
      rw [← e.sum_repr v, map_sum]
      refine Submodule.sum_mem _ fun i _ => ?_
      rw [map_smul, ← word_singleton j e i]
      exact Submodule.smul_mem _ _ (word_mem_wordSpan j e (Finset.subset_univ _))
    | algebraMap r =>
      rw [Algebra.algebraMap_eq_smul_one, ← word_empty j e]
      exact Submodule.smul_mem _ _ (word_mem_wordSpan j e (Finset.subset_univ _))
    | add x y _ _ hx hy => exact add_mem hx hy
    | mul x y _ _ hx hy => exact mul_mem_wordSpan_univ' j e Q h horth hx hy
  · refine Submodule.span_le.mpr ?_
    rintro w ⟨t, -, rfl⟩
    exact word_mem_adjoin j e t

/-- **54:2a** (O'Meara 1973, §54, 54:2a, p. 133): $\dim_F A' \le 2^n$ for the subalgebra $A'$ generated by $V$ in
an algebra compatible with $V$. -/
@[kb "omeara1963" "§54, 54:2a, p. 133"]
theorem finrank_adjoin_range_le : finrank F (Algebra.adjoin F (Set.range j)) ≤ 2 ^ n := by
  rw [← Subalgebra.finrank_toSubmodule,
    adjoin_range_toSubmodule_eq_span_word j e Q h horth]
  calc _ ≤ Fintype.card (Finset (Fin n)) := finrank_range_le_card _
    _ = 2 ^ n := by simp

end Orth

end Words

section Clifford

variable {F : Type*} [Field F] [Invertible (2 : F)] {V : Type*} [AddCommGroup V] [Module F V]
  [FiniteDimensional F V] (Q : QuadraticForm F V)

/-- **$C$ is a Clifford algebra of $V$** (O'Meara 1973, §54, p. 132): `i : V →ₗ[F] C` makes the algebra $C$
compatible with $V$ (that is $i(x)^2 = Q(x)1_C$) and *contains* $V$ (`i` is injective), and for every algebra
$B$ compatible with $V$ (in the same universe as $C$), given by `j : V →ₗ[F] B` with $j(x)^2 = Q(x)1_B$, there is
exactly one algebra homomorphism $\varphi : C \to B$ with $\varphi(i(x)) = j(x)$ for all $x \in V$.
(The universe restriction on $B$ is an artifact of Lean; Mathlib's `CliffordAlgebra.lift` has the universal
property for all universes.) -/
@[kb "omeara1963" "§54, definition of Clifford algebra, p. 132"]
def IsCliffordAlgebra (C : Type w) [Ring C] [Algebra F C] (i : V →ₗ[F] C) : Prop :=
  (∀ x, i x * i x = algebraMap F C (Q x)) ∧ Function.Injective i ∧
    ∀ (B : Type w) [Ring B] [Algebra F B] (j : V →ₗ[F] B),
      (∀ x, j x * j x = algebraMap F B (Q x)) → ∃! φ : C →ₐ[F] B, ∀ x, φ (i x) = j x

/-- **54:3, injectivity** (O'Meara 1973, §54, 54:3, p. 133–135): the canonical map
$V \to \mathrm{Cl}(Q)$ is injective, so that $V$ is a subspace of the Clifford algebra. Proof: compose with the
module isomorphism to the exterior algebra (`CliffordAlgebra.equivExterior`, characteristic $\ne 2$), which sends
$\iota_Q(x)$ to $\iota(x)$. Regularity is not needed (generalization). -/
@[kb "omeara1963" "§54, 54:3, p. 133–135"]
theorem cliffordAlgebra_ι_injective : Function.Injective (CliffordAlgebra.ι Q) := by
  intro x y hxy
  have h := congrArg (CliffordAlgebra.equivExterior Q) hxy
  simp only [CliffordAlgebra.equivExterior, CliffordAlgebra.changeFormEquiv_apply,
    CliffordAlgebra.changeForm_ι] at h
  exact (ExteriorAlgebra.ι_inj F x y).mp h

/-- **54:3a, dimension** (O'Meara 1973, §54, 54:3a, p. 135): $\dim_F \mathrm{Cl}(Q) = 2^n$ for $n = \dim_F V$.
Proof: the module isomorphism with the exterior algebra (`CliffordAlgebra.equivExterior`) and Mathlib's basis of
the exterior algebra indexed by the subsets of a basis of $V$. -/
@[kb "omeara1963" "§54, 54:3a, p. 135"]
theorem finrank_cliffordAlgebra : finrank F (CliffordAlgebra Q) = 2 ^ finrank F V := by
  rw [(CliffordAlgebra.equivExterior Q).finrank_eq]
  let b := Module.finBasis F V
  rw [Module.finrank_eq_card_basis b.ExteriorAlgebra]
  simp

/-- **54:3a, generation** (O'Meara 1973, §54, 54:3a, p. 135): the Clifford algebra is generated by (the image of)
$V$. This is Mathlib's `CliffordAlgebra.adjoin_range_ι`. -/
@[kb "omeara1963" "§54, 54:3a, p. 135"]
theorem cliffordAlgebra_adjoin_range_ι :
    Algebra.adjoin F (Set.range (CliffordAlgebra.ι Q)) = ⊤ :=
  CliffordAlgebra.adjoin_range_ι (Q := Q)

/-- Transport of the Clifford universal property along an algebra isomorphism from Mathlib's
`CliffordAlgebra Q` that is compatible with the maps from $V$. -/
theorem isCliffordAlgebra_of_algEquiv {C : Type w} [Ring C] [Algebra F C]
    (ψ : CliffordAlgebra Q ≃ₐ[F] C) (i : V →ₗ[F] C) (hi : ∀ x, ψ (CliffordAlgebra.ι Q x) = i x) :
    IsCliffordAlgebra Q C i := by
  refine ⟨fun x => ?_, ?_, fun B _ _ jB hB => ?_⟩
  · rw [← hi, ← map_mul, CliffordAlgebra.ι_sq_scalar, AlgEquiv.commutes]
  · intro x y hxy
    rw [← hi, ← hi] at hxy
    exact cliffordAlgebra_ι_injective Q (ψ.injective hxy)
  · refine ⟨(CliffordAlgebra.lift Q ⟨jB, hB⟩).comp ψ.symm.toAlgHom, fun x => ?_, fun θ hθ => ?_⟩
    · rw [← hi]; simp
    · have hl : θ.comp ψ.toAlgHom = CliffordAlgebra.lift Q ⟨jB, hB⟩ :=
        (CliffordAlgebra.lift_unique jB hB _).mp (LinearMap.ext fun x => by simp [hi, hθ])
      ext c
      obtain ⟨b, rfl⟩ := ψ.surjective c
      have := DFunLike.congr_fun hl b
      simpa using this

/-- **54:3** (O'Meara 1973, §54, 54:3, p. 133–135): every quadratic space has a Clifford algebra containing it,
namely Mathlib's `CliffordAlgebra Q` with the canonical map `CliffordAlgebra.ι Q` (injective). Regularity of $V$
is not needed (generalization). Uniqueness up to unique isomorphism (54:1) is the universal property. -/
@[kb "omeara1963" "§54, 54:3, p. 133–135"]
theorem isCliffordAlgebra_cliffordAlgebra :
    IsCliffordAlgebra Q (CliffordAlgebra Q) (CliffordAlgebra.ι Q) :=
  isCliffordAlgebra_of_algEquiv Q (AlgEquiv.refl) _ fun _ => rfl

section Compatible

variable {A : Type*} [Ring A] [Algebra F A] (j : V →ₗ[F] A)
  (h : ∀ x, j x * j x = algebraMap F A (Q x))

/-- The image of the canonical algebra homomorphism $\mathrm{Cl}(Q) \to A$ induced by a compatible `j` is the
subalgebra generated by $V$. -/
theorem range_lift_eq_adjoin :
    (CliffordAlgebra.lift Q ⟨j, h⟩).range = Algebra.adjoin F (Set.range j) := by
  rw [← Algebra.map_top, ← CliffordAlgebra.adjoin_range_ι (Q := Q), AlgHom.map_adjoin, ← Set.range_comp]
  have : (⇑(CliffordAlgebra.lift Q ⟨j, h⟩) ∘ CliffordAlgebra.ι Q) = j :=
    funext (CliffordAlgebra.lift_ι_apply j h)
  rw [this]

/-- **54:2b, injectivity** (O'Meara 1973, §54, 54:2b, p. 133): if the subalgebra $A'$ generated by $V$ in a
compatible algebra $A$ has dimension $2^n$ ($n = \dim V$), then the homomorphism
$\mathrm{Cl}(Q) \to A$ extending `j` is injective (its image is $A'$). -/
@[kb "omeara1963" "§54, 54:2b, p. 133"]
theorem lift_injective_of_finrank_eq
    (hdim : finrank F (Algebra.adjoin F (Set.range j)) = 2 ^ finrank F V) :
    Function.Injective (CliffordAlgebra.lift Q ⟨j, h⟩) := by
  set φ := CliffordAlgebra.lift Q ⟨j, h⟩
  have hr := range_lift_eq_adjoin Q j h
  have hfin : FiniteDimensional F (CliffordAlgebra Q) :=
    Module.finite_of_finrank_pos (by rw [finrank_cliffordAlgebra]; positivity)
  have hdim' : finrank F (CliffordAlgebra Q) = finrank F φ.range := by
    rw [finrank_cliffordAlgebra, hr, hdim]
  have hfin' : FiniteDimensional F φ.range :=
    Module.finite_of_finrank_pos (by rw [← hdim', finrank_cliffordAlgebra]; positivity)
  have hsurj : Function.Surjective (φ.rangeRestrict.toLinearMap) := φ.rangeRestrict_surjective
  have hinj := (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hdim').mpr hsurj
  intro x y hxy
  exact hinj (Subtype.ext hxy)

/-- The inclusion $V \to A'$ of $V$ into the subalgebra generated by $V$. -/
def adjoinInclusion : V →ₗ[F] Algebra.adjoin F (Set.range j) where
  toFun v := ⟨j v, Algebra.subset_adjoin ⟨v, rfl⟩⟩
  map_add' x y := Subtype.ext (map_add j x y)
  map_smul' c x := Subtype.ext (map_smul j c x)

include h

/-- **54:2b** (O'Meara 1973, §54, 54:2b, p. 133), isomorphism form: if the subalgebra $A'$ generated by $V$ in a
compatible algebra $A$ has dimension $2^n$ ($n = \dim V$), there is an algebra isomorphism
$\mathrm{Cl}(Q) \cong A'$ that is the identity on $V$. Regularity of $V$ is not needed (generalization); by 54:2a
the dimension is always at most $2^n$ (`finrank_adjoin_range_le`). -/
@[kb "omeara1963" "§54, 54:2b, p. 133"]
theorem exists_algEquiv_cliffordAlgebra_of_finrank_eq
    (hdim : finrank F (Algebra.adjoin F (Set.range j)) = 2 ^ finrank F V) :
    ∃ ψ : CliffordAlgebra Q ≃ₐ[F] Algebra.adjoin F (Set.range j),
      ∀ x, (ψ (CliffordAlgebra.ι Q x) : A) = j x := by
  have hinj := lift_injective_of_finrank_eq Q j h hdim
  refine ⟨(AlgEquiv.ofInjective _ hinj).trans
    (Subalgebra.equivOfEq _ _ (range_lift_eq_adjoin Q j h)), fun x => ?_⟩
  simp

/-- **54:2b** (O'Meara 1973, §54, 54:2b, p. 133), as stated in the book: if the subalgebra $A'$ generated by $V$
in a compatible algebra $A$ has dimension $2^n$ ($n = \dim V$), then $A'$ (with the inclusion of $V$) is a Clifford
algebra of $V$ (`IsCliffordAlgebra`). Regularity of $V$ is not needed (generalization). -/
@[kb "omeara1963" "§54, 54:2b, p. 133"]
theorem isCliffordAlgebra_adjoin_of_finrank_eq
    (hdim : finrank F (Algebra.adjoin F (Set.range j)) = 2 ^ finrank F V) :
    IsCliffordAlgebra Q (Algebra.adjoin F (Set.range j)) (adjoinInclusion j) := by
  obtain ⟨ψ, hψ⟩ := exists_algEquiv_cliffordAlgebra_of_finrank_eq Q j h hdim
  exact isCliffordAlgebra_of_algEquiv Q ψ _ fun x => Subtype.ext (hψ x)

end Compatible

section DerivedBasis

variable {n : ℕ} (e : Module.Basis (Fin n) F V)
  (horth : ∀ i k, i ≠ k → (QuadraticMap.associated Q) (e i) (e k) = 0)
include horth

/-- The words of an orthogonal basis span the Clifford algebra (54:2 together with generation by $V$). -/
theorem span_word_cliffordAlgebra :
    Submodule.span F (Set.range (word (CliffordAlgebra.ι Q) e)) = ⊤ := by
  rw [← adjoin_range_toSubmodule_eq_span_word (CliffordAlgebra.ι Q) e Q
    (CliffordAlgebra.ι_sq_scalar Q) horth, CliffordAlgebra.adjoin_range_ι (Q := Q)]
  exact Algebra.toSubmodule_eq_top.mpr rfl

/-- **The derived base** (O'Meara 1973, §54, p. 135, after 54:3a): the $2^n$ words in an orthogonal basis of $V$
span the Clifford algebra (by 54:2 and generation) and, as there are $2^n = \dim \mathrm{Cl}(Q)$ of them
(54:3a), are linearly independent. -/
@[kb "omeara1963" "§54, derived base, p. 135"]
theorem linearIndependent_word_cliffordAlgebra :
    LinearIndependent F (word (CliffordAlgebra.ι Q) e) := by
  refine linearIndependent_of_top_le_span_of_card_eq_finrank
    (span_word_cliffordAlgebra Q e horth).ge ?_
  rw [finrank_cliffordAlgebra, Module.finrank_eq_card_basis e]
  simp

/-- The **derived base** of the Clifford algebra: the basis (indexed by subsets of $\{0, \dots, n-1\}$) of
$\mathrm{Cl}(Q)$ consisting of the words $x_0^{e_0}\cdots x_{n-1}^{e_{n-1}}$ of an orthogonal basis of $V$. -/
def derivedBasis : Module.Basis (Finset (Fin n)) F (CliffordAlgebra Q) :=
  Module.Basis.mk (linearIndependent_word_cliffordAlgebra Q e horth) (
    (span_word_cliffordAlgebra Q e horth).ge)

@[simp] theorem derivedBasis_apply (s : Finset (Fin n)) :
    derivedBasis Q e horth s = word (CliffordAlgebra.ι Q) e s := by
  simp [derivedBasis]

end DerivedBasis

