/-
# O'Meara §93D: unimodular lattices over dyadic fields (93:15)

**Setting** (as in `Sec82.lean`): $R$ a discrete valuation ring with fraction field $F$, $2 \in F^\times$, a
quadratic space $(V, Q)$ over $F$, lattices = `Submodule R V`. O'Meara states 93:15 over a dyadic local field; the
proof uses only the discrete valuation ring, so no dyadic hypothesis is imposed (over a non-dyadic field
$\mathfrak nL = \mathfrak sL$ always, and the first part is the orthogonal base of §92).

**Proves**
* `exists_orthogonal_basis_iff_of_isUnimodular` (**93:15**, first part, p. 258): a unimodular lattice has an orthogonal
  base if and only if $\mathfrak nL = \mathfrak sL$;
* `exists_binary_split_of_isUnimodular` (**93:15**, second part): if $\mathfrak nL \subsetneq \mathfrak sL$, then $L$ is
  an orthogonal sum of binary (unimodular) sublattices.
-/
import QuadFormsKB.Literature.OMeara.Sec91Chain

open QuadraticMap Submodule Module IsLocalRing

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.OMeara

section DVR

variable {R : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  {F : Type*} [Field F] [Algebra R F] [IsFractionRing R F] [Invertible (2 : F)]
variable {V : Type*} [AddCommGroup V] [Module F V] [Module R V] [IsScalarTower R F V]
variable (Q : QuadraticForm F V)

/-! ### Helper lemmas -/

/-- A finite family that is independent and spans $L$ gives a base of $L$ (copy of the Sec92 lemma). -/
theorem u93_exists_basis_of_family {L : Submodule R V} {m : ℕ} {x : Fin m → V}
    (hli : LinearIndependent R x) (hspan : span R (Set.range x) = L) :
    ∃ h : finrank R L = m, ∃ b : Basis (Fin (finrank R L)) R L, ∀ i, (b i : V) = x (Fin.cast h i) := by
  let b₀ := (Basis.span hli).map (LinearEquiv.ofEq _ _ hspan)
  have h : finrank R L = m := by rw [finrank_eq_card_basis b₀, Fintype.card_fin]
  refine ⟨h, b₀.reindex (finCongr h.symm), fun i => ?_⟩
  simp [b₀, Basis.reindex_apply]

/-- An orthogonal family of anisotropic vectors is linearly independent (copy of the Sec92 lemma). -/
theorem u93_linearIndependent_of_orth {m : ℕ} {x : Fin m → V}
    (horth : ∀ i j, i ≠ j → bil Q (x i) (x j) = 0) (hQ : ∀ i, Q (x i) ≠ 0) :
    LinearIndependent R x := by
  classical
  refine linearIndependent_of_det_gram_ne_zero Q ?_
  have : gram Q x = Matrix.diagonal fun i => Q (x i) := by
    ext i j
    by_cases hij : i = j
    · subst hij; simp [gram]
    · simp [gram, Matrix.diagonal_apply_ne _ hij, horth i j hij]
  rw [this, Matrix.det_diagonal]
  exact Finset.prod_ne_zero_iff.mpr fun i _ => hQ i

/-- The ideal generated by a unit is the unit ideal. -/
theorem u93_span_unit {r : R} (hr : IsUnit r) : R ∙ algebraMap R F r = 1 := by
  apply le_antisymm
  · rw [span_singleton_le_iff_mem]; exact Submodule.mem_one.mpr ⟨r, rfl⟩
  · rw [Submodule.one_le]
    obtain ⟨s, hs⟩ := hr.exists_left_inv
    refine mem_span_singleton.mpr ⟨s, ?_⟩
    rw [Algebra.smul_def, ← map_mul, hs, map_one]

/-- If $\beta R = \mathfrak o$ then $\beta$ is a unit of $R$. -/
theorem u93_unit_of_span_eq_one {β : F} (h : R ∙ β = 1) :
    ∃ e : R, IsUnit e ∧ β = algebraMap R F e := by
  have hβ : β ∈ (1 : Submodule R F) := h ▸ mem_span_singleton_self β
  obtain ⟨e, he⟩ := Submodule.mem_one.mp hβ
  have h1 : (1 : F) ∈ R ∙ β := h ▸ Submodule.one_le.mp le_rfl
  obtain ⟨c, hc⟩ := mem_span_singleton.mp h1
  refine ⟨e, ?_, he.symm⟩
  rw [Algebra.smul_def, ← he, ← map_mul, ← map_one (algebraMap R F)] at hc
  exact IsUnit.of_mul_eq_one_right c (IsFractionRing.injective R F hc)

/-- In a local ring, a non-unit plus a unit is a unit. -/
theorem u93_isUnit_add_of_nonunit {s t : R} (hs : ¬ IsUnit s) (ht : IsUnit t) : IsUnit (s + t) := by
  by_contra h
  have h1 : s + t ∈ nonunits R := h
  have h2 : -s ∈ nonunits R := fun h' => hs (by simpa using h'.neg)
  have := IsLocalRing.nonunits_add h1 h2
  rw [show s + t + -s = t by ring] at this
  exact this ht

/-- In a local ring, a non-unit minus a unit is a unit. -/
theorem u93_isUnit_sub_of_nonunit {s t : R} (hs : ¬ IsUnit s) (ht : IsUnit t) : IsUnit (s - t) := by
  rw [sub_eq_add_neg]; exact u93_isUnit_add_of_nonunit hs ht.neg

/-- A vector of a lattice whose value $Q(z)$ is a unit of $R$ shows that $\mathfrak o \subseteq \mathfrak nK$. -/
theorem u93_one_le_normIdeal {K : Submodule R V} {z : V} (hz : z ∈ K) {q : R} (hq : IsUnit q)
    (hQ : Q z = algebraMap R F q) : (1 : Submodule R F) ≤ normIdeal Q K := by
  rw [Submodule.one_le]
  obtain ⟨s, hs⟩ := hq.exists_left_inv
  have h1 : algebraMap R F q ∈ normIdeal Q K := hQ ▸ Q_mem_normIdeal Q hz
  have h2 := (normIdeal Q K).smul_mem s h1
  rwa [Algebra.smul_def, ← map_mul, hs, map_one] at h2

/-- A line $Rw$ with $Q(w)$ a unit is a unimodular lattice of rank $1$. -/
theorem u93_isUnimodular_span_singleton {w : V} {r : R} (hr : IsUnit r) (hw : Q w = algebraMap R F r) :
    IsUnimodular Q (R ∙ w) ∧ finrank R (R ∙ w) = 1 := by
  have hQu : Q w ≠ 0 := by
    rw [hw]; exact fun h => hr.ne_zero (IsFractionRing.injective R F (h.trans (map_zero _).symm))
  let v : Fin 1 → V := fun _ => w
  have hG : gram Q v = Q w • (1 : Matrix (Fin 1) (Fin 1) R).map (algebraMap R F) := by
    ext i j; fin_cases i; fin_cases j; simp [v, gram]
  obtain ⟨hmod, hrk⟩ := isModular_span_of_gram Q hQu (by simp) hG
  have hJ : span R (Set.range v) = R ∙ w := by simp [v, Set.range_const]
  rw [hJ] at hmod hrk
  refine ⟨?_, by simpa using hrk⟩
  show IsModular Q 1 (R ∙ w)
  rwa [hw, u93_span_unit hr] at hmod

/-- An orthogonal summand $K \neq 0$ of a unimodular lattice $L = J \perp K$ with $J$ unimodular is unimodular
(by $\mathfrak vL = \mathfrak vJ\,\mathfrak vK$ and $\mathfrak sK \subseteq \mathfrak sL$). -/
theorem u93_isUnimodular_of_orth {L J K : Submodule R V} (hLfg : L.FG) (hL : IsUnimodular Q L)
    (hJ : IsUnimodular Q J) (h : IsOrthSum Q L J K) (hK0 : K ≠ ⊥) : IsUnimodular Q K := by
  classical
  have hJfg : J.FG := FG.of_le hLfg (h.sup_eq ▸ le_sup_left)
  have hKle : K ≤ L := h.sup_eq ▸ le_sup_right
  have hKfg : K.FG := FG.of_le hLfg hKle
  have hvol : volume Q K = 1 := by
    have h1 := volume_eq_mul_of_isOrthSum Q h hJfg hKfg
    rw [hL.2.2, hJ.2.2, one_pow, one_pow, one_mul] at h1
    exact h1.symm
  obtain ⟨b⟩ := exists_basis (R := R) (F := F) hKfg
  rw [volume_eq_span_det Q b] at hvol
  have hent : ∀ i j, ∃ r : R, bil Q (b i : V) (b j : V) = algebraMap R F r := fun i j => by
    have : bil Q (b i : V) (b j : V) ∈ scale Q L := bil_mem_scale Q (hKle (b i).2) (hKle (b j).2)
    rw [hL.2.1] at this
    exact (Submodule.mem_one.mp this).imp fun r hr => hr.symm
  choose U hU using hent
  have hG : gram Q (fun i => (b i : V)) = (1 : F) • (Matrix.of U).map (algebraMap R F) := by
    ext i j; simp [gram, hU i j]
  have hdetmem : (1 : F) ∈ span R {(gram Q fun i => (b i : V)).det} := hvol ▸ Submodule.one_le.mp le_rfl
  obtain ⟨c, hc⟩ := mem_span_singleton.mp hdetmem
  have hdet : (gram Q fun i => (b i : V)).det = algebraMap R F (Matrix.of U).det := by
    rw [hG, one_smul]; exact (RingHom.map_det _ _).symm
  have hunit : IsUnit (Matrix.of U).det := by
    rw [hdet, Algebra.smul_def, ← map_mul, ← map_one (algebraMap R F)] at hc
    exact IsUnit.of_mul_eq_one_right c (IsFractionRing.injective R F hc)
  have hne : Nonempty (Fin (finrank R K)) := by
    by_contra hne
    rw [not_nonempty_iff] at hne
    apply hK0
    rw [← span_basis_eq b, Set.range_eq_empty, span_empty]
  have hmod := (isModular_iff_gram Q b (one_ne_zero : (1 : F) ≠ 0)).mpr ⟨hne, Matrix.of U, hunit, hG⟩
  show IsModular Q 1 K
  rwa [← Submodule.one_eq_span] at hmod

/-- In a unimodular lattice $L$ with $\mathfrak nL \neq \mathfrak o$ there are $x, y$ with $B(x,y)$ a unit and
$Q(x), Q(y)$ non-units. -/
theorem u93_exists_binary {L : Submodule R V} (hfg : L.FG) (hL : IsUnimodular Q L)
    (hn : normIdeal Q L ≠ 1) :
    ∃ x ∈ L, ∃ y ∈ L, ∃ e qx qy : R, IsUnit e ∧ ¬ IsUnit qx ∧ ¬ IsUnit qy ∧
      bil Q x y = algebraMap R F e ∧ Q x = algebraMap R F qx ∧ Q y = algebraMap R F qy := by
  obtain ⟨x, hx, y, hy, hxy⟩ := exists_scale_eq Q hfg
  rw [hL.2.1] at hxy
  obtain ⟨e, he, hbxy⟩ := u93_unit_of_span_eq_one hxy.symm
  have hnonunit : ∀ z ∈ L, ∃ q : R, Q z = algebraMap R F q ∧ ¬ IsUnit q := by
    intro z hz
    have : Q z ∈ scale Q L := by rw [← bil_self Q z]; exact bil_mem_scale Q hz hz
    rw [hL.2.1] at this
    obtain ⟨q, hq⟩ := Submodule.mem_one.mp this
    refine ⟨q, hq.symm, fun hq' => hn ?_⟩
    exact le_antisymm ((normIdeal_le_scale Q L).trans hL.2.1.le) (u93_one_le_normIdeal Q hz hq' hq.symm)
  obtain ⟨qx, hqx, hqx'⟩ := hnonunit x hx
  obtain ⟨qy, hqy, hqy'⟩ := hnonunit y hy
  exact ⟨x, hx, y, hy, e, qx, qy, he, hqx', hqy', hbxy, hqx, hqy⟩

/-- **Splitting off a unit vector** from a unimodular lattice with $\mathfrak nL = \mathfrak o$: $L = Rw \perp K$ with
$Q(w)$ a unit and $K = 0$ or $\mathfrak nK = \mathfrak o$ (O'Meara's rank-$3$ argument, p. 258). -/
theorem u93_exists_split_unit {L : Submodule R V} (hfg : L.FG) (hL : IsUnimodular Q L)
    (hn : normIdeal Q L = 1) :
    ∃ w ∈ L, ∃ r : R, IsUnit r ∧ Q w = algebraMap R F r ∧
      ∃ K, IsOrthSum Q L (R ∙ w) K ∧ (K = ⊥ ∨ normIdeal Q K = 1) := by
  have hsc : scale Q L = 1 := hL.2.1
  obtain ⟨u, hu, hnu⟩ := exists_normIdeal_eq Q hfg
  rw [hn] at hnu
  obtain ⟨qu, hqu, hQu⟩ := u93_unit_of_span_eq_one hnu.symm
  obtain ⟨hJu, -⟩ := u93_isUnimodular_span_singleton Q hqu hQu
  have hJL : R ∙ u ≤ L := (span_singleton_le_iff_mem _ _).mpr hu
  obtain ⟨K, hK⟩ := splits_of_isModular_of_scale_eq Q hJL hJu (fg_span_singleton u) hsc
  by_cases hK0 : K = ⊥
  · exact ⟨u, hu, qu, hqu, hQu, K, hK, Or.inl hK0⟩
  have hKle : K ≤ L := hK.sup_eq ▸ le_sup_right
  have hKfg : K.FG := FG.of_le hfg hKle
  have hKun : IsUnimodular Q K := u93_isUnimodular_of_orth Q hfg hL hJu hK hK0
  by_cases hnK : normIdeal Q K = 1
  · exact ⟨u, hu, qu, hqu, hQu, K, hK, Or.inr hnK⟩
  obtain ⟨x, hx, y, hy, e, qx, qy, he, hqx', hqy', hbxy, hqx, hqy⟩ := u93_exists_binary Q hKfg hKun hnK
  have hxu : bil Q x u = 0 := by rw [bil_comm]; exact hK.orth u (mem_span_singleton_self u) x hx
  have hyu : bil Q y u = 0 := by rw [bil_comm]; exact hK.orth u (mem_span_singleton_self u) y hy
  have hQf₁ : Q (x + u) = algebraMap R F (qx + qu) := by
    rw [Q_add, hxu, hqx, hQu]; simp
  have hu1 : IsUnit (qx + qu) := u93_isUnit_add_of_nonunit hqx' hqu
  obtain ⟨ainv, hainv⟩ := hu1.exists_left_inv
  have hainvU : IsUnit ainv := IsUnit.of_mul_eq_one _ hainv
  have hyf₁ : bil Q y (x + u) = algebraMap R F e := by
    rw [bil_add_right, hyu, add_zero, bil_comm Q y x, hbxy]
  have hQf₂ : Q (y + (-(e * ainv)) • (x + u)) =
      algebraMap R F (qy - e * e * ainv) := by
    rw [Q_add, Q_rsmul, bil_rsmul_right, hyf₁, hQf₁, hqy]
    have : qy - e * e * ainv = qy + 2 * (-(e * ainv) * e) + (-(e * ainv)) ^ 2 * (qx + qu) := by
      linear_combination (-(e * e * ainv)) * hainv
    rw [this]; simp only [map_add, map_mul, map_pow, map_neg, map_ofNat]
  have hu2 : IsUnit (qy - e * e * ainv) := u93_isUnit_sub_of_nonunit hqy' ((he.mul he).mul hainvU)
  have hf₂L : y + (-(e * ainv)) • (x + u) ∈ L :=
    add_mem (hKle hy) (L.smul_mem _ (add_mem (hKle hx) hu))
  have hf₁L : x + u ∈ L := add_mem (hKle hx) hu
  have hbf : bil Q (y + (-(e * ainv)) • (x + u)) (x + u) = 0 := by
    rw [bil_add_left, bil_rsmul_left, bil_self, hQf₁, hyf₁]
    have : e + -(e * ainv) * (qx + qu) = 0 := by linear_combination (-e) * hainv
    rw [← map_mul, ← map_add, this, map_zero]
  obtain ⟨hJ1, -⟩ := u93_isUnimodular_span_singleton Q hu1 hQf₁
  have hJ1L : R ∙ (x + u) ≤ L := (span_singleton_le_iff_mem _ _).mpr hf₁L
  obtain ⟨K', hK'⟩ := splits_of_isModular_of_scale_eq Q hJ1L hJ1 (fg_span_singleton _) hsc
  have hf₂K : y + (-(e * ainv)) • (x + u) ∈ K' := by
    have hmem := hf₂L
    rw [← hK'.sup_eq] at hmem
    obtain ⟨z, hz, k, hk, hzk⟩ := mem_sup.mp hmem
    obtain ⟨a, rfl⟩ := mem_span_singleton.mp hz
    have h0 : bil Q (a • (x + u) + k) (x + u) = 0 := by rw [hzk]; exact hbf
    rw [bil_add_left, bil_rsmul_left, bil_self, hQf₁, bil_comm Q k, hK'.orth _ (mem_span_singleton_self _) k hk,
      add_zero, ← map_mul] at h0
    have ha : a * (qx + qu) = 0 := IsFractionRing.injective R F (h0.trans (map_zero _).symm)
    have ha0 : a = 0 := (mul_eq_zero.mp ha).resolve_right hu1.ne_zero
    rw [ha0, zero_smul, zero_add] at hzk
    exact hzk ▸ hk
  have hK'0 : K' ≠ ⊥ := by
    intro h0
    rw [h0, mem_bot] at hf₂K
    have := congrArg Q hf₂K
    rw [hQf₂, map_zero] at this
    exact hu2.ne_zero (IsFractionRing.injective R F (this.trans (map_zero _).symm))
  have hK'un : IsUnimodular Q K' := u93_isUnimodular_of_orth Q hfg hL hJ1 hK' hK'0
  refine ⟨x + u, hf₁L, qx + qu, hu1, hQf₁, K', hK', Or.inr ?_⟩
  exact le_antisymm ((normIdeal_le_scale Q K').trans hK'un.2.1.le)
    (u93_one_le_normIdeal Q hf₂K hu2 hQf₂)

/-- **Orthogonal family for unimodular lattices with $\mathfrak nL = \mathfrak o$** (induction on the rank). -/
theorem u93_exists_orth_family : ∀ (n : ℕ) {L : Submodule R V}, finrank R L = n → L.FG →
    IsUnimodular Q L → normIdeal Q L = 1 →
    ∃ m, ∃ x : Fin m → V, (∀ i, x i ∈ L) ∧ span R (Set.range x) = L ∧
      (∀ i j, i ≠ j → bil Q (x i) (x j) = 0) ∧ ∀ i, Q (x i) ≠ 0 := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro L hn hfg hL hnL
  obtain ⟨w, hw, r, hr, hQw, K, hK, hK'⟩ := u93_exists_split_unit Q hfg hL hnL
  obtain ⟨hJ, hrk1⟩ := u93_isUnimodular_span_singleton Q hr hQw
  have hQw0 : Q w ≠ 0 := by
    rw [hQw]; exact fun h => hr.ne_zero (IsFractionRing.injective R F (h.trans (map_zero _).symm))
  have hKle : K ≤ L := hK.sup_eq ▸ le_sup_right
  have hKfg : K.FG := FG.of_le hfg hKle
  have hrk := isOrthSum_finrank Q hK hfg
  rw [hrk1] at hrk
  by_cases hK0 : K = ⊥
  · subst hK0
    refine ⟨1, fun _ => w, fun _ => hw, ?_, fun i j hij => absurd (Subsingleton.elim i j) hij,
      fun _ => hQw0⟩
    rw [← hK.sup_eq]; simp
  have hnK := hK'.resolve_left hK0
  have hKun := u93_isUnimodular_of_orth Q hfg hL hJ hK hK0
  obtain ⟨m, y, hyK, hyspan, hyorth, hyQ⟩ := ih (finrank R K) (by omega) rfl hKfg hKun hnK
  refine ⟨m + 1, Fin.cons w y, ?_, ?_, ?_, ?_⟩
  · intro i; refine Fin.cases ?_ (fun i => ?_) i
    · simpa using hw
    · simpa using hKle (hyK i)
  · rw [Fin.range_cons, span_insert, hyspan, hK.sup_eq]
  · intro i j hij
    refine Fin.cases (fun hij => ?_) (fun i hij => ?_) i hij
    · refine Fin.cases (fun h => absurd rfl h) (fun j _ => ?_) j hij
      simpa using hK.orth w (mem_span_singleton_self w) (y j) (hyK j)
    · refine Fin.cases (fun _ => ?_) (fun j hij => ?_) j hij
      · simp only [Fin.cons_zero, Fin.cons_succ]
        rw [bil_comm]; exact hK.orth w (mem_span_singleton_self w) (y i) (hyK i)
      · simpa using hyorth i j (fun h => hij (h ▸ rfl))
  · intro i; refine Fin.cases ?_ (fun i => ?_) i
    · simpa using hQw0
    · simpa using hyQ i

/-- Prepending an orthogonal regular component to an orthogonal splitting. -/
theorem u93_isOrthSplit_cons {L J K : Submodule R V} {t : ℕ} {Ks : Fin t → Submodule R V}
    (hK : IsOrthSum Q L J K) (hKs : IsOrthSplit Q K Ks) (hJreg : IsRegular Q J)
    (hKreg : ∀ i, IsRegular Q (Ks i)) :
    IsOrthSplit Q L (Fin.cons J Ks : Fin (t + 1) → Submodule R V) := by
  have hKsle : ∀ i, Ks i ≤ K := fun i => hKs.iSup_eq ▸ le_iSup Ks i
  have horth : ∀ i j, i ≠ j → ∀ x ∈ (Fin.cons J Ks : Fin (t + 1) → Submodule R V) i,
      ∀ y ∈ (Fin.cons J Ks : Fin (t + 1) → Submodule R V) j, bil Q x y = 0 := by
    intro i j hij
    refine Fin.cases (fun hij => ?_) (fun i hij => ?_) i hij
    · refine Fin.cases (fun h => absurd rfl h) (fun j _ => ?_) j hij
      intro x hx y hy
      exact hK.orth x hx y (hKsle j hy)
    · refine Fin.cases (fun _ => ?_) (fun j hij => ?_) j hij
      · intro x hx y hy
        rw [bil_comm]; exact hK.orth y hy x (hKsle i hx)
      · exact hKs.orth i j (fun h => hij (h ▸ rfl))
  refine ⟨horth, iSupIndep_of_orth Q horth fun i => ?_, ?_⟩
  · refine Fin.cases ?_ (fun i => ?_) i
    · simpa using hJreg
    · simpa using hKreg i
  · rw [iSup_fin_cons, hKs.iSup_eq, hK.sup_eq]

/-- **Proposition 93:15, first part** (O'Meara 1963, p. 258): a unimodular lattice $L$ has an orthogonal base if and only
if $\mathfrak nL = \mathfrak sL$. (O'Meara's dyadic hypothesis is not needed.) -/
@[kb "omeara1963" "§93D, 93:15, p. 258 (orthogonal base iff nL = sL)"]
theorem exists_orthogonal_basis_iff_of_isUnimodular {L : Submodule R V} (hfg : L.FG) (hL : IsUnimodular Q L) :
    (∃ b : Basis (Fin (finrank R L)) R L, ∀ i j, i ≠ j → bil Q (b i : V) (b j : V) = 0) ↔
      normIdeal Q L = scale Q L := by
  constructor
  · rintro ⟨b, hb⟩
    have hα : (algebraMap R F 1) ≠ 0 := by simp
    have hL' : IsModular Q (R ∙ algebraMap R F 1) L := by
      have : (R ∙ algebraMap R F 1) = 1 := by rw [map_one, ← Submodule.one_eq_span]
      rw [this]; exact hL
    obtain ⟨hne, U, hU, hG⟩ := (isModular_iff_gram Q b hα).mp hL'
    have hdiag : ∀ i, Q (b i : V) = algebraMap R F (U i i) := by
      intro i
      have := congrFun (congrFun hG i) i
      simpa [gram] using this
    have hoff : ∀ i j, i ≠ j → U i j = 0 := by
      intro i j hij
      have := congrFun (congrFun hG i) j
      simp only [gram, Matrix.of_apply, Matrix.smul_apply, Matrix.map_apply, map_one,
        smul_eq_mul, one_mul] at this
      rw [hb i j hij] at this
      exact (IsFractionRing.injective R F) (this.symm.trans (map_zero _).symm)
    have hUdiag : U = Matrix.diagonal fun i => U i i := by
      ext i j
      by_cases hij : i = j
      · subst hij; simp
      · simp [Matrix.diagonal_apply_ne _ hij, hoff i j hij]
    obtain ⟨i⟩ := hne
    have hunit : IsUnit (U i i) := by
      rw [hUdiag, Matrix.det_diagonal] at hU
      exact isUnit_of_dvd_unit (Finset.dvd_prod_of_mem (fun i => U i i) (Finset.mem_univ i)) hU
    refine le_antisymm (normIdeal_le_scale Q L) ?_
    rw [hL.2.1]
    exact u93_one_le_normIdeal Q (b i).2 hunit (hdiag i)
  · intro hn
    have hn1 : normIdeal Q L = 1 := hn.trans hL.2.1
    obtain ⟨m, x, -, hspan, horth, hQ⟩ := u93_exists_orth_family Q (finrank R L) rfl hfg hL hn1
    obtain ⟨h, b, hb⟩ := u93_exists_basis_of_family (u93_linearIndependent_of_orth Q horth hQ) hspan
    exact ⟨b, fun i j hij => by
      rw [hb, hb]; exact horth _ _ (fun h' => hij (Fin.cast_injective _ h'))⟩

/-- **Proposition 93:15, second part** (O'Meara 1963, p. 258): if $\mathfrak nL \subsetneq \mathfrak sL$ for a unimodular
lattice $L$, then $L$ is an orthogonal sum of binary unimodular sublattices. -/
@[kb "omeara1963" "§93D, 93:15, p. 258 (nL ⊊ sL: orthogonal sum of binary lattices)"]
theorem exists_binary_split_of_isUnimodular {L : Submodule R V} (hfg : L.FG) (hL : IsUnimodular Q L)
    (hn : normIdeal Q L ≠ scale Q L) :
    ∃ t, ∃ Ls : Fin t → Submodule R V, IsOrthSplit Q L Ls ∧ ∀ i, finrank R (Ls i) = 2 ∧ IsUnimodular Q (Ls i) := by
  have hn1 : normIdeal Q L ≠ 1 := fun h => hn (h.trans hL.2.1.symm)
  clear hn
  induction h : finrank R L using Nat.strong_induction_on generalizing L with
  | _ n ih =>
  have hsc : scale Q L = 1 := hL.2.1
  obtain ⟨x, hx, y, hy, e, qx, qy, he, hqx', hqy', hbxy, hqx, hqy⟩ := u93_exists_binary Q hfg hL hn1
  let v : Fin 2 → V := ![x, y]
  let U : Matrix (Fin 2) (Fin 2) R := !![qx, e; e, qy]
  have hG : gram Q v = (1 : F) • U.map (algebraMap R F) := by
    ext i j; fin_cases i <;> fin_cases j <;>
      simp [v, U, gram, hqx, hqy, hbxy, bil_comm Q y x]
  have hU : IsUnit U.det := by
    rw [Matrix.det_fin_two_of]
    refine u93_isUnit_sub_of_nonunit (fun h => hqx' (isUnit_of_mul_isUnit_left h)) (he.mul he)
  obtain ⟨hmod, hrk⟩ := isModular_span_of_gram Q (one_ne_zero : (1 : F) ≠ 0) hU hG
  rw [← Submodule.one_eq_span] at hmod
  have hJL : span R (Set.range v) ≤ L := by
    rw [span_le]; rintro _ ⟨i, rfl⟩; fin_cases i
    · exact hx
    · exact hy
  have hJfg : (span R (Set.range v)).FG := fg_span (Set.finite_range v)
  obtain ⟨K, hK⟩ := splits_of_isModular_of_scale_eq Q hJL hmod hJfg hsc
  have hJrk : finrank R (span R (Set.range v)) = 2 := by simpa using hrk
  have hJreg : IsRegular Q (span R (Set.range v)) := IsModular.isRegular Q hmod hJfg
  by_cases hK0 : K = ⊥
  · subst hK0
    have hKs : IsOrthSplit Q (⊥ : Submodule R V) (fun i : Fin 0 => (⊥ : Submodule R V)) :=
      ⟨fun i => i.elim0, fun i => i.elim0, by simp⟩
    refine ⟨1, _, u93_isOrthSplit_cons Q hK hKs hJreg fun i => i.elim0, ?_⟩
    intro i
    refine Fin.cases ?_ (fun i => i.elim0) i
    simpa using ⟨hJrk, hmod⟩
  have hKle : K ≤ L := hK.sup_eq ▸ le_sup_right
  have hKfg : K.FG := FG.of_le hfg hKle
  have hKun : IsUnimodular Q K := u93_isUnimodular_of_orth Q hfg hL hmod hK hK0
  have hrkL := isOrthSum_finrank Q hK hfg
  have hnK : normIdeal Q K ≠ 1 := by
    intro h1
    apply hn1
    have h2 : normIdeal Q L = normIdeal Q (span R (Set.range v)) ⊔ normIdeal Q K := by
      rw [← hK.sup_eq]; exact normIdeal_sup_of_orth Q hK.orth
    refine le_antisymm ((normIdeal_le_scale Q L).trans hsc.le) ?_
    rw [h2, ← h1]; exact le_sup_right
  obtain ⟨t, Ks, hKs, hKs2⟩ := ih (finrank R K) (by omega) hKfg hKun hnK rfl
  have hKsle : ∀ i, Ks i ≤ K := fun i => hKs.iSup_eq ▸ le_iSup Ks i
  refine ⟨t + 1, _, u93_isOrthSplit_cons Q hK hKs hJreg fun i =>
    IsModular.isRegular Q (hKs2 i).2 (FG.of_le hKfg (hKsle i)), ?_⟩
  intro i
  refine Fin.cases ?_ (fun i => ?_) i
  · simpa using ⟨hJrk, hmod⟩
  · exact hKs2 i

end DVR

end QuadFormsKB.OMeara
