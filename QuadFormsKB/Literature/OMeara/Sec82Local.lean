/-
# O'Meara §82K: localization of scale, norm, volume, modular and maximal lattices

**Setting.** $R$ is a Dedekind domain with fraction field $F$, $2 \in F^\times$, and $(V, Q)$ a finite-dimensional
quadratic space over $F$ with O'Meara's bilinear form $B$ = `bil Q`. For a maximal ideal $\mathfrak p$ of $R$, the
local ring $\mathfrak o_{\mathfrak p}$ is here the **localization** of $R$ at $\mathfrak p$, realized inside $F$
(`locRing F p`, Mathlib's `Localization.subalgebra.ofField`), and the localizations of a lattice $L$ and of an
$R$-submodule $\mathfrak a$ of $F$ are the $\mathfrak o_{\mathfrak p}$-modules $L_{\mathfrak p}$ (`locLat p L`) and
$\mathfrak a_{\mathfrak p}$ (`locIdeal p a`) they generate in $V$ and in $F$.

**Deviation from O'Meara.** O'Meara (§81E, p. 217; §82K, p. 238) localizes at the completion $F_{\mathfrak p}$: his
$L_{\mathfrak p}$ is the $\mathfrak o_{\mathfrak p}$-module generated by $L$ in $V_{\mathfrak p} = F_{\mathfrak p}V$.
Here the localization of $R$ at $\mathfrak p$ (a discrete valuation ring with fraction field $F$) is used instead, so
that $L_{\mathfrak p}$ stays in $V$; the statements of §82K have the same form. (The library's localization at the
completion, for number fields and lattices in $F^n$, is `Lattices.loc`.) The spots of O'Meara's Dedekind set $S$ are
the maximal ideals of $R$ (when $R$ is not a field).

**Proves** (O'Meara 1963, §82K, pp. 238–239):
* `scale_locLat`, `normIdeal_locLat`, `volume_locLat` ($\mathfrak sL_{\mathfrak p} = (\mathfrak sL)_{\mathfrak p}$,
  $\mathfrak nL_{\mathfrak p} = (\mathfrak nL)_{\mathfrak p}$, $\mathfrak vL_{\mathfrak p} = (\mathfrak vL)_{\mathfrak p}$);
* `scale_eq_iff_locLat`, `normIdeal_eq_iff_locLat`, `volume_eq_iff_locLat` (two lattices have the same scale, norm or
  volume if and only if their localizations do at every $\mathfrak p$);
* `isModular_iff_locLat` ($L$ is $\mathfrak a$-modular if and only if every $L_{\mathfrak p}$ is
  $\mathfrak a_{\mathfrak p}$-modular);
* `isMaximal_iff_locLat` ($L$ is $\mathfrak a$-maximal if and only if every $L_{\mathfrak p}$ is
  $\mathfrak a_{\mathfrak p}$-maximal).
-/
import QuadFormsKB.Literature.OMeara.Sec82Volume

open QuadraticMap Submodule Module

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.OMeara

section Defs

variable {R : Type*} [CommRing R] [IsDomain R]

variable (F : Type*) [Field F] [Algebra R F] [IsFractionRing R F] in
/-- **The local ring $\mathfrak o_{\mathfrak p}$** at a prime $\mathfrak p$ of $R$, realized inside $F$: the
localization of $R$ at $\mathfrak p$ (O'Meara 1963, §81E, p. 216, uses the integers of the completion instead). -/
abbrev locRing (p : Ideal R) [p.IsPrime] : Subalgebra R F :=
  Localization.subalgebra.ofField F p.primeCompl p.primeCompl_le_nonZeroDivisors

variable {F : Type*} [Field F] [Algebra R F] [IsFractionRing R F]
variable {V : Type*} [AddCommGroup V] [Module F V] [Module R V] [IsScalarTower R F V]

/-- **The localization $L_{\mathfrak p}$** of an $R$-submodule $L$ of $V$ at a prime $\mathfrak p$: the
$\mathfrak o_{\mathfrak p}$-module generated by $L$ in $V$ (O'Meara 1963, §81E, p. 218, with the localization in place
of the completion). -/
@[kb "omeara1963" "§81E, p. 218 (the localization L_p of a lattice; here at the localization of o)"]
def locLat (p : Ideal R) [p.IsPrime] (L : Submodule R V) : Submodule (locRing F p) V :=
  span (locRing F p) (L : Set V)

/-- **The localization $\mathfrak a_{\mathfrak p}$** of an $R$-submodule $\mathfrak a$ of $F$ at a prime $\mathfrak p$:
the $\mathfrak o_{\mathfrak p}$-module generated by $\mathfrak a$ (O'Meara 1963, §81E, p. 217, with the localization
in place of the completion). -/
@[kb "omeara1963" "§81E, p. 217 (the localization a_p of an ideal; here at the localization of o)"]
def locIdeal (p : Ideal R) [p.IsPrime] (a : Submodule R F) : Submodule (locRing F p) F :=
  span (locRing F p) (a : Set F)

end Defs

variable {R : Type*} [CommRing R] [IsDedekindDomain R] {F : Type*} [Field F] [Algebra R F]
  [IsFractionRing R F] [Invertible (2 : F)]
variable {V : Type*} [AddCommGroup V] [Module F V] [Module R V] [IsScalarTower R F V] [FiniteDimensional F V]
variable (Q : QuadraticForm F V)

section Helpers

variable (p : Ideal R) [p.IsPrime]

/-- An element of `locRing F p` becomes integral after multiplying by some `u ∉ p`. -/
theorem exists_mul_eq_of_mem_locRing (s : locRing F p) :
    ∃ (u : p.primeCompl) (r : R), (u : R) • s = algebraMap R (locRing F p) r := by
  obtain ⟨⟨r, u⟩, h⟩ := IsLocalization.surj p.primeCompl s
  exact ⟨u, r, by rw [Algebra.smul_def, mul_comm]; exact h⟩

/-- A vector of the `locRing F p`-span of an `R`-submodule `b` is moved into `b` by some `t ∉ p`. -/
theorem exists_smul_mem_of_mem_locSpan {b : Submodule R V} {x : V}
    (hx : x ∈ span (locRing F p) (b : Set V)) : ∃ t : p.primeCompl, (t : R) • x ∈ b := by
  induction hx using Submodule.span_induction with
  | mem x hx => exact ⟨1, by simpa using hx⟩
  | zero => exact ⟨1, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨t, ht⟩ := hx
    obtain ⟨t', ht'⟩ := hy
    refine ⟨t * t', ?_⟩
    have : ((t * t' : p.primeCompl) : R) • (x + y) = (t' : R) • (t : R) • x + (t : R) • (t' : R) • y := by
      simp only [smul_add, smul_smul, Submonoid.coe_mul, mul_comm]
    rw [this]
    exact add_mem (b.smul_mem _ ht) (b.smul_mem _ ht')
  | smul s x _ hx =>
    obtain ⟨t, ht⟩ := hx
    obtain ⟨u, r, hur⟩ := exists_mul_eq_of_mem_locRing p s
    refine ⟨t * u, ?_⟩
    have : ((t * u : p.primeCompl) : R) • (s • x) = r • (t : R) • x := by
      rw [Submonoid.coe_mul, mul_smul, ← smul_assoc (u : R) s x, hur, algebraMap_smul, smul_comm]
    rw [this]
    exact b.smul_mem _ ht

/-- **Local-global principle for submodules**: if `K_p ≤ L_p` at every maximal `p` then `K ≤ L`. -/
theorem le_of_forall_locLat_le {K L : Submodule R V}
    (h : ∀ (p : Ideal R) [p.IsMaximal], locLat (F := F) p K ≤ locLat p L) : K ≤ L := by
  intro x hx
  by_contra hxL
  let I : Ideal R := L.comap (LinearMap.toSpanSingleton R V x)
  have hI : I ≠ ⊤ := by
    intro h1
    apply hxL
    have : (1 : R) ∈ I := h1 ▸ Submodule.mem_top
    simpa [I] using this
  obtain ⟨m, hm, hIm⟩ := Ideal.exists_le_maximal I hI
  have := hm
  have hx' : x ∈ locLat (F := F) m L := h m (subset_span hx)
  obtain ⟨t, ht⟩ := exists_smul_mem_of_mem_locSpan m hx'
  exact t.2 (hIm ht)

/-- `B(x, y)` lies in `(sL)_p` for `x, y ∈ L_p`. -/
theorem bil_mem_locIdeal_of_mem {L : Submodule R V} {x y : V} (hx : x ∈ locLat (F := F) p L)
    (hy : y ∈ locLat (F := F) p L) : bil Q x y ∈ locIdeal p (scale Q L) := by
  replace hx : x ∈ span (locRing F p) (L : Set V) := hx
  replace hy : y ∈ span (locRing F p) (L : Set V) := hy
  refine span_induction (p := fun x _ => bil Q x y ∈ locIdeal p (scale Q L)) ?_ (by simp [bil]) ?_ ?_ hx
  · intro x hx
    refine span_induction (p := fun y _ => bil Q x y ∈ locIdeal p (scale Q L)) ?_ (by simp [bil]) ?_ ?_ hy
    · intro y hy
      exact subset_span (bil_mem_scale Q hx hy)
    · intro a b _ _ ha hb
      rw [bil_add_right]; exact add_mem ha hb
    · intro s a _ ha
      rw [bil_rsmul_right, ← Algebra.smul_def]; exact Submodule.smul_mem _ s ha
  · intro a b _ _ ha hb
    rw [bil_add_left]; exact add_mem ha hb
  · intro s a _ ha
    rw [bil_rsmul_left, ← Algebra.smul_def]; exact Submodule.smul_mem _ s ha

/-- `2 (sL)_p ⊆ (nL)_p`. -/
theorem two_mul_mem_locIdeal_normIdeal {L : Submodule R V} {c : F} (hc : c ∈ locIdeal p (scale Q L)) :
    2 * c ∈ locIdeal p (normIdeal Q L) := by
  refine span_induction (p := fun c _ => 2 * c ∈ locIdeal p (normIdeal Q L)) ?_ (by simp) ?_ ?_ hc
  · intro c hc
    exact subset_span (two_mul_mem_normIdeal Q hc)
  · intro a b _ _ ha hb
    rw [mul_add]; exact add_mem ha hb
  · intro s a _ ha
    rw [mul_smul_comm]; exact Submodule.smul_mem _ s ha

/-- `Q(x)` lies in `(nL)_p` for `x ∈ L_p`. -/
theorem Q_mem_locIdeal_of_mem {L : Submodule R V} {x : V} (hx : x ∈ locLat (F := F) p L) :
    Q x ∈ locIdeal p (normIdeal Q L) := by
  replace hx : x ∈ span (locRing F p) (L : Set V) := hx
  refine span_induction (p := fun x _ => Q x ∈ locIdeal p (normIdeal Q L)) ?_ (by simp) ?_ ?_ hx
  · intro x hx
    exact subset_span (Q_mem_normIdeal Q hx)
  · intro x y hx' hy' hx hy
    rw [Q_add]
    exact add_mem (add_mem hx (two_mul_mem_locIdeal_normIdeal Q p
      (bil_mem_locIdeal_of_mem Q p hx' hy'))) hy
  · intro s x _ hx
    rw [Q_rsmul]
    have : algebraMap (locRing F p) F s ^ 2 * Q x = s • s • Q x := by
      simp only [Algebra.smul_def]; ring
    rw [this]
    exact Submodule.smul_mem _ s (Submodule.smul_mem _ s hx)

/-- The localization `R_p` of a Dedekind domain is a Dedekind domain. -/
instance instIsDedekindDomainLocRing : IsDedekindDomain (locRing F p) :=
  IsLocalization.isDedekindDomain R p.primeCompl_le_nonZeroDivisors (locRing F p)

/-- Extending scalars from `R` to `R_p` does not change a span. -/
theorem span_locRing_span {W : Type*} [AddCommGroup W] [Module R W] [Module (locRing F p) W]
    [IsScalarTower R (locRing F p) W] (t : Set W) :
    span (locRing F p) (span R t : Set W) = span (locRing F p) t :=
  le_antisymm (span_le.2 fun _ hx => span_le_restrictScalars R _ t hx) (span_mono subset_span)

/-- `(ab)_p = a_p b_p`. -/
theorem locIdeal_mul (a b : Submodule R F) : locIdeal p (a * b) = locIdeal p a * locIdeal p b := by
  unfold locIdeal
  rw [Submodule.mul_eq_span_mul_set a b, span_locRing_span, ← Submodule.span_mul_span]

/-- `o_p = 1`. -/
theorem locIdeal_one : locIdeal p (1 : Submodule R F) = 1 := by
  unfold locIdeal
  rw [Submodule.one_eq_span (R := R) (A := F), span_locRing_span,
    ← Submodule.one_eq_span (R := locRing F p) (A := F)]

/-- `(αR)_p = αR_p`. -/
theorem locIdeal_span_singleton (d : F) : locIdeal p (span R {d}) = span (locRing F p) {d} :=
  span_locRing_span p {d}

/-- Localization of fractional ideals as a monoid homomorphism. -/
def locIdealHom : Submodule R F →* Submodule (locRing F p) F where
  toFun := locIdeal p
  map_one' := locIdeal_one p
  map_mul' := locIdeal_mul p

/-- `(a^n)_p = (a_p)^n`. -/
theorem locIdeal_pow (a : Submodule R F) (n : ℕ) : locIdeal p (a ^ n) = locIdeal p a ^ n :=
  map_pow (locIdealHom p) a n

/-- `(∏ aᵢ)_p = ∏ (aᵢ)_p`. -/
theorem locIdeal_prod {ι : Type*} (s : Finset ι) (a : ι → Submodule R F) :
    locIdeal p (∏ i ∈ s, a i) = ∏ i ∈ s, locIdeal p (a i) :=
  map_prod (locIdealHom p) a s

/-- The localization of a finitely generated `R`-submodule of `F` is finitely generated. -/
theorem locIdeal_fg {a : Submodule R F} (ha : a.FG) : (locIdeal p a).FG := by
  obtain ⟨s, rfl⟩ := ha
  unfold locIdeal
  rw [span_locRing_span]
  exact Submodule.fg_span s.finite_toSet

/-- The localization of a non-zero `R`-submodule of `F` is non-zero. -/
theorem locIdeal_ne_bot {a : Submodule R F} (ha : a ≠ ⊥) : locIdeal p a ≠ ⊥ := by
  obtain ⟨x, hx, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot ha
  intro h
  have : x ∈ locIdeal p a := subset_span hx
  rw [h] at this
  exact hx0 ((Submodule.mem_bot _).1 this)

/-- `a ≤ b` implies `a_p ≤ b_p`. -/
theorem locIdeal_mono {a b : Submodule R F} (h : a ≤ b) : locIdeal p a ≤ locIdeal p b :=
  span_mono h

/-- `c ∈ a_p` and `γ y ∈ L` for `γ ∈ a` give `c y ∈ L_p`. -/
theorem smul_mem_locLat_of_mem_locIdeal {L : Submodule R V} {c : F} {y : V} (a : Submodule R F)
    (hy : ∀ γ ∈ a, γ • y ∈ L) (hc : c ∈ locIdeal p a) : c • y ∈ locLat (F := F) p L := by
  replace hc : c ∈ span (locRing F p) (a : Set F) := hc
  refine span_induction (p := fun c _ => c • y ∈ locLat (F := F) p L) ?_ (by simp) ?_ ?_ hc
  · intro c hc
    exact subset_span (hy c hc)
  · intro a b _ _ ha hb
    rw [add_smul]; exact add_mem ha hb
  · intro s c _ hc
    rw [smul_assoc]; exact Submodule.smul_mem _ s hc

/-- `L_p` for an adaptation `L = ⨆ aᵢ yᵢ`. -/
theorem locLat_iSup_smul {ι : Type*} [Fintype ι] (a : ι → Submodule R F) (y : ι → V) :
    locLat (F := F) p (⨆ i, a i • span R {y i}) =
      ⨆ i, locIdeal p (a i) • span (locRing F p) {y i} := by
  apply le_antisymm
  · refine span_le.2 fun v hv => ?_
    obtain ⟨c, hc, rfl⟩ := (mem_iSup_smul_span_iff_exists a y v).1 hv
    exact (mem_iSup_smul_span_iff_exists (fun i => locIdeal p (a i)) y _).2
      ⟨c, fun i => subset_span (hc i), rfl⟩
  · intro v hv
    obtain ⟨c, hc, rfl⟩ := (mem_iSup_smul_span_iff_exists (fun i => locIdeal p (a i)) y v).1 hv
    refine sum_mem fun i _ => smul_mem_locLat_of_mem_locIdeal p (a i) (fun γ hγ => ?_) (hc i)
    exact mem_iSup_of_mem i (smul_mem_smul hγ (mem_span_singleton_self _))

/-- `F L_p = F L`. -/
theorem span_locLat (L : Submodule R V) :
    span F ((locLat (F := F) p L : Submodule (locRing F p) V) : Set V) = span F (L : Set V) := by
  apply le_antisymm
  · refine span_le.2 fun v hv => ?_
    have h : locLat (F := F) p L ≤ (span F (L : Set V)).restrictScalars (locRing F p) :=
      span_le.2 subset_span
    exact h hv
  · exact span_mono subset_span

/-- `rank L_p = rank L`. -/
theorem finrank_locLat (L : Submodule R V) :
    finrank (locRing F p) (locLat (F := F) p L) = finrank R L := by
  rw [finrank_eq_finrank_span (R := locRing F p) (F := F), finrank_eq_finrank_span (F := F) L,
    span_locLat]

set_option synthInstance.maxHeartbeats 200000 in
/-- `L_p` is a lattice on `V` over `R_p` when `L` is a lattice on `V`. -/
theorem isLattice_locLat {L : Submodule R V} (hL : L.IsLattice F) :
    (locLat (F := F) p L).IsLattice F := by
  refine ⟨?_, ?_⟩
  · obtain ⟨s, hs⟩ := hL.fg
    unfold locLat
    rw [← hs, span_locRing_span]
    exact Submodule.fg_span s.finite_toSet
  · rw [span_locLat]; exact hL.span_eq_top

/-- If `u • x ∈ L` for some `u ∉ p`, then `x ∈ L_p`. -/
theorem mem_locLat_of_smul_mem {L : Submodule R V} {x : V} (u : p.primeCompl) (hx : (u : R) • x ∈ L) :
    x ∈ locLat (F := F) p L := by
  have h1 : IsLocalization.mk' (locRing F p) (1 : R) u * algebraMap R (locRing F p) u = 1 := by
    simp [IsLocalization.mk'_spec (locRing F p) (1 : R) u]
  have h2 : x = IsLocalization.mk' (locRing F p) (1 : R) u • ((u : R) • x) := by
    rw [← algebraMap_smul (locRing F p) (u : R) x, ← mul_smul, h1, one_smul]
  rw [h2]
  exact Submodule.smul_mem _ _ (subset_span hx)

/-- Equality of `R`-submodules of `F` can be checked after localizing at every maximal ideal. -/
theorem eq_of_forall_locIdeal_eq {a b : Submodule R F}
    (h : ∀ (p : Ideal R) [p.IsMaximal], locIdeal p a = locIdeal p b) : a = b :=
  le_antisymm (le_of_forall_locLat_le (V := F) fun p _ => (h p).le)
    (le_of_forall_locLat_le (V := F) fun p _ => (h p).ge)

/-- Inclusion of `R`-submodules of `F` can be checked after localizing at every maximal ideal. -/
theorem le_of_forall_locIdeal_le {a b : Submodule R F}
    (h : ∀ (p : Ideal R) [p.IsMaximal], locIdeal p a ≤ locIdeal p b) : a ≤ b :=
  le_of_forall_locLat_le (V := F) fun p _ => h p

/-- `𝔫L_p = (𝔫L)_p` (the proof of `normIdeal_locLat`, needed before it is stated). -/
theorem normIdeal_locLat_aux (L : Submodule R V) :
    normIdeal Q (locLat (F := F) p L) = locIdeal p (normIdeal Q L) := by
  apply le_antisymm
  · rw [normIdeal, span_le]
    rintro _ ⟨x, hx, rfl⟩
    exact Q_mem_locIdeal_of_mem Q p hx
  · have h : normIdeal Q L ≤ (normIdeal Q (locLat (F := F) p L)).restrictScalars R := by
      rw [normIdeal, span_le]
      rintro _ ⟨x, hx, rfl⟩
      exact Q_mem_normIdeal Q (subset_span hx)
    exact span_le.2 fun c hc => h hc

/-- If `L` is `𝔞`-maximal and `J ⊇ L_q` is an `R_q`-lattice on `V` with `𝔫J ⊆ 𝔞_q`, then `J ⊆ L_q`: the
lattice `L + t·(generators of J)` with `t ∉ q` suitably chosen is `𝔞`-admissible, hence equals `L`. -/
theorem locLat_le_of_isMaximal {a : Submodule R F} {L : Submodule R V} (hL : L.IsLattice F)
    (hmax : ∀ K : Submodule R V, K.IsLattice F → L ≤ K → normIdeal Q K ≤ a → K = L)
    (hn : normIdeal Q L ≤ a) (q : Ideal R) [hq : q.IsMaximal] {J : Submodule (locRing F q) V}
    (hJ : J.IsLattice F) (hnJ : normIdeal Q J ≤ locIdeal q a) (hLJ : locLat q L ≤ J) :
    J ≤ locLat (F := F) q L := by
  classical
  obtain ⟨G, hG⟩ := hJ.fg
  have hgJ : ∀ g ∈ G, g ∈ J := fun g hg => by rw [← hG]; exact subset_span hg
  have hN : (span R (G : Set V)).FG := Submodule.fg_span G.finite_toSet
  obtain ⟨d, hd0, hd⟩ := (fg_iff_exists_smul_le hL _).1 hN
  have hdG : ∀ g ∈ G, d • g ∈ L := fun g hg => hd g (subset_span hg)
  have hI : Ideal.span {d} ≠ ⊥ := by simpa using hd0
  obtain ⟨e, I', hqI, hdI⟩ : ∃ (e : ℕ) (I' : Ideal R), q ⊔ I' = ⊤ ∧ Ideal.span {d} = q ^ e * I' := by
    obtain ⟨I', h1, h2⟩ := Ideal.eq_prime_pow_mul_coprime hI q
    exact ⟨_, I', h1, h2⟩
  have hI'q : ¬ I' ≤ q := fun h => hq.ne_top ((sup_eq_left.2 h).symm.trans hqI)
  obtain ⟨t, htI, htq⟩ := Set.not_subset.1 hI'q
  have hkey : ∀ u ∈ q ^ e, ∃ w : R, w * d = u * t := fun u hu => by
    have : u * t ∈ Ideal.span {d} := hdI ▸ Ideal.mul_mem_mul hu htI
    exact Ideal.mem_span_singleton'.1 this
  let K : Submodule R V := L ⊔ span R ((fun g => t • g) '' (G : Set V))
  have hKt : ∀ g ∈ G, t • g ∈ K := fun g hg => mem_sup_right (subset_span ⟨g, hg, rfl⟩)
  have hLK : L ≤ K := le_sup_left
  have hKlat : K.IsLattice F :=
    ⟨hL.fg.sup (Submodule.fg_span (G.finite_toSet.image _)),
      eq_top_iff.2 (le_trans (le_of_eq hL.span_eq_top.symm) (span_mono hLK))⟩
  have hnK : normIdeal Q K ≤ a := by
    refine le_of_forall_locIdeal_le fun p hpm => ?_
    rw [← normIdeal_locLat_aux Q]
    by_cases hp : p = q
    · subst hp
      have hKJ : K ≤ J.restrictScalars R :=
        sup_le (fun l hl => hLJ (subset_span hl)) (span_le.2 (by
          rintro _ ⟨g, hg, rfl⟩
          exact J.smul_of_tower_mem t (hgJ g hg)))
      exact le_trans (normIdeal_mono Q (span_le.2 hKJ)) hnJ
    · have hp' : ¬ q ^ e ≤ p := by
        intro h
        have hq_le : q ≤ p := by
          rcases Nat.eq_zero_or_pos e with rfl | he
          · exact absurd (top_le_iff.1 (by simpa using h)) hpm.ne_top
          · exact (Ideal.IsPrime.pow_le_iff he.ne').1 h
        exact hp ((hq.eq_of_le hpm.ne_top hq_le).symm)
      obtain ⟨u, huq, hup⟩ := Set.not_subset.1 hp'
      obtain ⟨w, hw⟩ := hkey u huq
      have hKL : K ≤ (locLat (F := F) p L).restrictScalars R :=
        sup_le (fun l hl => subset_span hl) (span_le.2 (by
          rintro _ ⟨g, hg, rfl⟩
          refine mem_locLat_of_smul_mem p ⟨u, hup⟩ ?_
          show u • t • g ∈ L
          rw [smul_smul, ← hw, mul_smul]
          exact L.smul_mem w (hdG g hg)))
      refine le_trans (normIdeal_mono Q (span_le.2 hKL)) ?_
      rw [normIdeal_locLat_aux Q]
      exact locIdeal_mono p hn
  have hKL : K = L := hmax K hKlat hLK hnK
  rw [← hG]
  refine span_le.2 fun g hg => ?_
  have h1 := hKt g hg
  rw [hKL] at h1
  exact mem_locLat_of_smul_mem q ⟨t, htq⟩ h1

end Helpers

/-- **$\mathfrak sL_{\mathfrak p} = (\mathfrak sL)_{\mathfrak p}$** (O'Meara 1963, §82K, p. 238). -/
@[kb "omeara1963" "§82K, p. 238 (sL_p = (sL)_p)"]
theorem scale_locLat (p : Ideal R) [p.IsPrime] (L : Submodule R V) :
    scale Q (locLat p L) = locIdeal p (scale Q L) := by
  apply le_antisymm
  · rw [scale, span_le]
    rintro _ ⟨x, hx, y, hy, rfl⟩
    exact bil_mem_locIdeal_of_mem Q p hx hy
  · have h : scale Q L ≤ (scale Q (locLat (F := F) p L)).restrictScalars R := by
      rw [scale, span_le]
      rintro _ ⟨x, hx, y, hy, rfl⟩
      exact bil_mem_scale Q (subset_span hx) (subset_span hy)
    exact span_le.2 fun c hc => h hc

/-- **$\mathfrak nL_{\mathfrak p} = (\mathfrak nL)_{\mathfrak p}$** (O'Meara 1963, §82K, p. 238). -/
@[kb "omeara1963" "§82K, p. 238 (nL_p = (nL)_p)"]
theorem normIdeal_locLat (p : Ideal R) [p.IsPrime] (L : Submodule R V) :
    normIdeal Q (locLat p L) = locIdeal p (normIdeal Q L) := by
  exact normIdeal_locLat_aux Q p L

/-- **$\mathfrak vL_{\mathfrak p} = (\mathfrak vL)_{\mathfrak p}$** (O'Meara 1963, §82K, p. 238), for a lattice $L$. -/
@[kb "omeara1963" "§82K, p. 238 (vL_p = (vL)_p)"]
theorem volume_locLat (p : Ideal R) [p.IsPrime] {L : Submodule R V} (hL : L.FG) :
    volume Q (locLat p L) = locIdeal p (volume Q L) := by
  classical
  obtain ⟨r, y, hy, -, a, ha, rfl⟩ := exists_adapted (F := F) hL
  rw [locLat_iSup_smul,
    volume_eq_of_adapted Q y hy (fun i => locIdeal p (a i))
      (fun i => ⟨locIdeal_fg p (ha i).1, locIdeal_ne_bot p (ha i).2⟩),
    volume_eq_of_adapted Q y hy a ha, locIdeal_mul, locIdeal_pow, locIdeal_prod,
    locIdeal_span_singleton]

/-- **Same scale locally** (O'Meara 1963, §82K, p. 239): lattices $L$ and $K$ have the same scale if and only if
$L_{\mathfrak p}$ and $K_{\mathfrak p}$ have the same scale at every $\mathfrak p$. -/
@[kb "omeara1963" "§82K, p. 239 (same scale iff locally the same)"]
theorem scale_eq_iff_locLat (L K : Submodule R V) :
    scale Q L = scale Q K ↔
      ∀ (p : Ideal R) [p.IsMaximal], scale Q (locLat (F := F) p L) = scale Q (locLat p K) := by
  constructor
  · intro h p _
    rw [scale_locLat, scale_locLat, h]
  · intro h
    exact eq_of_forall_locIdeal_eq fun p _ => by rw [← scale_locLat, ← scale_locLat]; exact h p

/-- **Same norm locally** (O'Meara 1963, §82K, p. 239). -/
@[kb "omeara1963" "§82K, p. 239 (same norm iff locally the same)"]
theorem normIdeal_eq_iff_locLat (L K : Submodule R V) :
    normIdeal Q L = normIdeal Q K ↔
      ∀ (p : Ideal R) [p.IsMaximal], normIdeal Q (locLat (F := F) p L) = normIdeal Q (locLat p K) := by
  constructor
  · intro h p _
    rw [normIdeal_locLat, normIdeal_locLat, h]
  · intro h
    exact eq_of_forall_locIdeal_eq fun p _ => by
      rw [← normIdeal_locLat, ← normIdeal_locLat]; exact h p

/-- **Same volume locally** (O'Meara 1963, §82K, p. 239). -/
@[kb "omeara1963" "§82K, p. 239 (same volume iff locally the same)"]
theorem volume_eq_iff_locLat {L K : Submodule R V} (hL : L.FG) (hK : K.FG) :
    volume Q L = volume Q K ↔
      ∀ (p : Ideal R) [p.IsMaximal], volume Q (locLat (F := F) p L) = volume Q (locLat p K) := by
  constructor
  · intro h p _
    rw [volume_locLat Q p hL, volume_locLat Q p hK, h]
  · intro h
    exact eq_of_forall_locIdeal_eq fun p _ => by
      rw [← volume_locLat Q p hL, ← volume_locLat Q p hK]; exact h p

/-- **Modularity is local** (O'Meara 1963, §82K, p. 239): $L$ is $\mathfrak a$-modular if and only if $L_{\mathfrak p}$
is $\mathfrak a_{\mathfrak p}$-modular for every $\mathfrak p$ ($\mathfrak a$ a fractional ideal). -/
@[kb "omeara1963" "§82K, p. 239 (L a-modular iff every L_p is a_p-modular)"]
theorem isModular_iff_locLat {a : Submodule R F} (ha0 : a ≠ ⊥) {L : Submodule R V} (hL : L.FG) :
    IsModular Q a L ↔ ∀ (p : Ideal R) [p.IsMaximal], IsModular Q (locIdeal p a) (locLat p L) := by
  constructor
  · rintro ⟨-, hs, hv⟩ p _
    refine ⟨locIdeal_ne_bot p ha0, ?_, ?_⟩
    · rw [scale_locLat, hs]
    · rw [volume_locLat Q p hL, hv, finrank_locLat, locIdeal_pow]
  · intro h
    refine ⟨ha0, ?_, ?_⟩
    · exact eq_of_forall_locIdeal_eq fun p _ => by rw [← scale_locLat, (h p).2.1]
    · exact eq_of_forall_locIdeal_eq fun p _ => by
        rw [← volume_locLat Q p hL, (h p).2.2, finrank_locLat, locIdeal_pow]

/-- **Maximality is local** (O'Meara 1963, §82K, p. 239): a lattice $L$ on $V$ is $\mathfrak a$-maximal if and only if
$L_{\mathfrak p}$ is $\mathfrak a_{\mathfrak p}$-maximal on $V$ for every $\mathfrak p$ (O'Meara: $\mathfrak a$ a
fractional ideal; any $R$-submodule of $F$ works). O'Meara's proof of the converse uses 81:14 to modify $L$ at one spot; here the modified lattice is built
directly. -/
@[kb "omeara1963" "§82K, p. 239 (L a-maximal iff every L_p is a_p-maximal)"]
theorem isMaximal_iff_locLat {a : Submodule R F} {L : Submodule R V} (hL : L.IsLattice F) :
    IsMaximal Q a L ↔ ∀ (p : Ideal R) [p.IsMaximal], IsMaximal Q (locIdeal p a) (locLat p L) := by
  constructor
  · rintro ⟨-, hn, hmax⟩ q _
    refine ⟨isLattice_locLat q hL, ?_, fun J hJ hLJ hnJ => ?_⟩
    · rw [normIdeal_locLat]; exact locIdeal_mono q hn
    · exact le_antisymm (locLat_le_of_isMaximal Q hL hmax hn q hJ hnJ hLJ) hLJ
  · intro h
    refine ⟨hL, ?_, fun K hK hLK hnK => ?_⟩
    · exact le_of_forall_locIdeal_le fun p _ => by
        rw [← normIdeal_locLat]; exact (h p).2.1
    · refine le_antisymm ?_ hLK
      refine le_of_forall_locLat_le (F := F) fun p _ => ?_
      have hle : locLat (F := F) p L ≤ locLat p K := span_mono hLK
      have hn : normIdeal Q (locLat (F := F) p K) ≤ locIdeal p a := by
        rw [normIdeal_locLat]; exact locIdeal_mono p hnK
      exact ((h p).2.2 _ (isLattice_locLat p hK) hle hn).le

end QuadFormsKB.OMeara
