/-
# O'Meara §93A–§93B: notation for dyadic fields, the norm group, the weight, the matrices $A(\alpha, \beta)$

**Setting** (as in `Sec82.lean`): $R$ a discrete valuation ring with fraction field $F$, $2 \in F^\times$, a
quadratic space $(V, Q)$ over $F$, O'Meara's bilinear form $B$ = `bil Q`, lattices = `Submodule R V`. O'Meara's §93
assumes $F$ dyadic ($2 \in \mathfrak p$); the definitions below make sense in general, and the dyadic hypothesis is
added where a proof needs it.

**Defines** (O'Meara 1963, §93, pp. 250–255)
* `SqEquivMod a α β`: $\alpha \cong \beta \bmod \mathfrak a$ ($\alpha/\beta \in \mathfrak u$ and
  $\alpha \equiv \beta\varepsilon^2 \bmod \mathfrak a$ for a unit $\varepsilon$) and `SqEquiv α β`: $\alpha \cong \beta$
  ($\alpha/\beta \in \mathfrak u^2$) (p. 250);
* `DiscSqEquivMod Q L α a` (**93:2**): $dL \cong \alpha \bmod \mathfrak a$;
* `normGroup Q L` (§93A, p. 251): the norm group $\mathfrak gL = Q(L) + 2\,\mathfrak sL$, an additive subgroup of $F$;
* `normGroupIdeal Q L` ($\mathfrak mL$, the largest fractional ideal contained in $\mathfrak gL$) and `weight Q L`
  ($\mathfrak wL = \mathfrak p\,\mathfrak mL + 2\,\mathfrak sL$) (p. 253); `IsNormGenerator`, `IsWeightGenerator`;
* `matA α β` (§93B, p. 255): the matrix $A(\alpha, \beta) = \begin{pmatrix}\alpha & 1\\ 1 & \beta\end{pmatrix}$ and
  `HasMatrixA Q L α β` ($L \cong A(\alpha, \beta)$).

**Proves** the basic properties of $\mathfrak gL$ (p. 251–252: $2\mathfrak sL \subseteq \mathfrak gL \subseteq
\mathfrak nL$, $\mathfrak nL$ is generated by an element of $\mathfrak gL$, monotonicity, $\mathfrak g(K \perp L) =
\mathfrak gK + \mathfrak gL$), the inclusions $\mathfrak p\,\mathfrak mL \subseteq \mathfrak wL \subseteq \mathfrak mL$
and $2\mathfrak sL \subseteq \mathfrak wL \subseteq \mathfrak nL$ (p. 253), and **93:9** ($A(\alpha, 0) \cong
A(\alpha + 2\beta, 0)$).
-/
import QuadFormsKB.Literature.OMeara.Sec91Chain

open QuadraticMap Submodule Module IsLocalRing
open scoped Pointwise

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.OMeara

section Notation

variable {R : Type*} [CommRing R] {F : Type*} [Field F] [Algebra R F]

/-- **$\alpha \cong \beta$** (O'Meara 1963, §93, p. 250): $\alpha/\beta \in \mathfrak u^2$, i.e. $\alpha = \varepsilon^2\beta$
with $\varepsilon$ a unit of $R$. -/
@[kb "omeara1963" "§93, p. 250 (α ≅ β: α/β ∈ u²)"]
def SqEquiv (α β : F) : Prop :=
  ∃ ε : R, IsUnit ε ∧ α = algebraMap R F ε ^ 2 * β

/-- **$\alpha \cong \beta \bmod \mathfrak a$** (O'Meara 1963, §93, p. 250): $\alpha/\beta$ is a unit and
$\alpha \equiv \beta\varepsilon^2 \bmod \mathfrak a$ for some unit $\varepsilon$. -/
@[kb "omeara1963" "§93, p. 250 (α ≅ β mod a)"]
def SqEquivMod (a : Submodule R F) (α β : F) : Prop :=
  (∃ u : R, IsUnit u ∧ α = algebraMap R F u * β) ∧ ∃ ε : R, IsUnit ε ∧ α - β * algebraMap R F ε ^ 2 ∈ a

end Notation

section Defs

variable {R : Type*} [CommRing R] {F : Type*} [Field F] [Algebra R F] [Invertible (2 : F)]
variable {V : Type*} [AddCommGroup V] [Module F V] [Module R V] [IsScalarTower R F V]
variable (Q : QuadraticForm F V)

/-- **93:2** (O'Meara 1963, p. 251): $dL \cong \alpha \bmod \mathfrak a$, i.e. $L$ has a base $x_1, \dots, x_n$ with
$d(x_1, \dots, x_n) \cong \alpha \bmod \mathfrak a$. -/
@[kb "omeara1963" "§93, 93:2, p. 251 (dL ≅ α mod a)"]
def DiscSqEquivMod (L : Submodule R V) (α : F) (a : Submodule R F) : Prop :=
  ∃ b : Basis (Fin (finrank R L)) R L, SqEquivMod a (gram Q fun i => (b i : V)).det α

/-- **93:2, second part** (O'Meara 1963, p. 251): $dL\,dK \cong \alpha \bmod \mathfrak a$ for lattices $L$, $K$: there
are bases with $d(x_1, \dots, x_n)\,d(y_1, \dots, y_m) \cong \alpha \bmod \mathfrak a$. -/
@[kb "omeara1963" "§93, 93:2, p. 251 (dL dK ≅ α mod a)"]
def DiscProdSqEquivMod (L K : Submodule R V) (α : F) (a : Submodule R F) : Prop :=
  ∃ b : Basis (Fin (finrank R L)) R L, ∃ b' : Basis (Fin (finrank R K)) R K,
    SqEquivMod a ((gram Q fun i => (b i : V)).det * (gram Q fun i => (b' i : V)).det) α

/-- **The norm group** $\mathfrak gL = Q(L) + 2\,\mathfrak sL$ (O'Meara 1963, §93A, p. 251): the set of
$Q(x) + 2c$ with $x \in L$ and $c \in \mathfrak sL$; it is an additive subgroup of $F$. -/
@[kb "omeara1963" "§93A, p. 251 (the norm group gL = Q(L) + 2sL)"]
def normGroup (L : Submodule R V) : AddSubgroup F where
  carrier := {z | ∃ x ∈ L, ∃ c ∈ scale Q L, z = Q x + 2 * c}
  add_mem' := by
    rintro _ _ ⟨x, hx, c, hc, rfl⟩ ⟨y, hy, d, hd, rfl⟩
    refine ⟨x + y, L.add_mem hx hy, c + d - bil Q x y, ?_, ?_⟩
    · exact sub_mem (add_mem hc hd) (bil_mem_scale Q hx hy)
    · rw [Q_add]; ring
  zero_mem' := ⟨0, L.zero_mem, 0, zero_mem _, by simp⟩
  neg_mem' := by
    rintro _ ⟨x, hx, c, hc, rfl⟩
    refine ⟨x, hx, -c - Q x, ?_, by ring⟩
    exact sub_mem (neg_mem hc) (by rw [← bil_self]; exact bil_mem_scale Q hx hx)

/-- **$\mathfrak mL$** (O'Meara 1963, §93A, p. 253): the largest fractional ideal contained in the norm group
$\mathfrak gL$, here $\{z \in F : \mathfrak o z \subseteq \mathfrak gL\}$, the largest $R$-submodule of $F$ contained
in $\mathfrak gL$ (`normGroupIdeal_subset`, `le_normGroupIdeal`). -/
@[kb "omeara1963" "§93A, p. 253 (mL, the largest fractional ideal in gL)"]
def normGroupIdeal (L : Submodule R V) : Submodule R F where
  carrier := {z | ∀ r : R, r • z ∈ normGroup Q L}
  add_mem' := fun hz hw r => by rw [smul_add]; exact add_mem (hz r) (hw r)
  zero_mem' := fun r => by rw [smul_zero]; exact zero_mem _
  smul_mem' := fun c z hz r => by rw [smul_smul]; exact hz (r * c)

/-- **The weight** $\mathfrak wL = \mathfrak p(\mathfrak mL) + 2(\mathfrak sL)$ (O'Meara 1963, §93A, p. 253). Here
$\mathfrak p$ is the maximal ideal of $R$, as an $R$-submodule of $F$. -/
@[kb "omeara1963" "§93A, p. 253 (the weight wL = p(mL) + 2(sL))"]
def weight [IsLocalRing R] (L : Submodule R V) : Submodule R F :=
  Submodule.map (Algebra.linearMap R F) (maximalIdeal R) * normGroupIdeal Q L + (2 : F) • scale Q L

/-- **Norm generator** (O'Meara 1963, §93A, p. 253): $a \in \mathfrak gL$ with $a\mathfrak o = \mathfrak nL$ (a scalar
of largest value in $\mathfrak gL$). -/
@[kb "omeara1963" "§93A, p. 253 (norm generator)"]
def IsNormGenerator (L : Submodule R V) (a : F) : Prop :=
  a ∈ normGroup Q L ∧ R ∙ a = normIdeal Q L

/-- **Weight generator** (O'Meara 1963, §93A, p. 253): $b$ with $b\mathfrak o = \mathfrak wL$. -/
@[kb "omeara1963" "§93A, p. 253 (weight generator)"]
def IsWeightGenerator [IsLocalRing R] (L : Submodule R V) (b : F) : Prop :=
  R ∙ b = weight Q L

end Defs

section NormGroup

variable {R : Type*} [CommRing R] {F : Type*} [Field F] [Algebra R F] [Invertible (2 : F)]
variable {V : Type*} [AddCommGroup V] [Module F V] [Module R V] [IsScalarTower R F V]
variable (Q : QuadraticForm F V)

theorem Q_mem_normGroup {L : Submodule R V} {x : V} (hx : x ∈ L) : Q x ∈ normGroup Q L :=
  ⟨x, hx, 0, zero_mem _, by ring⟩

/-- $2\,\mathfrak sL \subseteq \mathfrak gL$ (O'Meara 1963, §93A, p. 251). -/
@[kb "omeara1963" "§93A, p. 251 (2(sL) ⊆ gL ⊆ nL)"]
theorem two_mul_mem_normGroup {L : Submodule R V} {c : F} (hc : c ∈ scale Q L) :
    2 * c ∈ normGroup Q L :=
  ⟨0, L.zero_mem, c, hc, by simp⟩

/-- $\mathfrak gL \subseteq \mathfrak nL$ (O'Meara 1963, §93A, p. 251). -/
@[kb "omeara1963" "§93A, p. 251 (2(sL) ⊆ gL ⊆ nL)"]
theorem normGroup_subset_normIdeal (L : Submodule R V) :
    (normGroup Q L : Set F) ⊆ normIdeal Q L := by
  rintro _ ⟨x, hx, c, hc, rfl⟩
  exact add_mem (Q_mem_normIdeal Q hx) (two_mul_mem_normIdeal Q hc)

/-- $K \subseteq L \Rightarrow \mathfrak gK \subseteq \mathfrak gL$ (O'Meara 1963, §93A, p. 252). -/
@[kb "omeara1963" "§93A, p. 252 (K ⊆ L ⇒ gK ⊆ gL)"]
theorem normGroup_mono {K L : Submodule R V} (h : K ≤ L) : normGroup Q K ≤ normGroup Q L := by
  rintro _ ⟨x, hx, c, hc, rfl⟩
  exact ⟨x, h hx, c, scale_mono Q h hc, rfl⟩

/-- $\mathfrak g(K \perp L) = \mathfrak gK + \mathfrak gL$ (O'Meara 1963, §93A, p. 252). -/
@[kb "omeara1963" "§93A, p. 252 (g(K ⊥ L) = gK + gL)"]
theorem normGroup_sup_of_orth [IsDomain R] [IsFractionRing R F] {J K : Submodule R V} (horth : ∀ x ∈ J, ∀ y ∈ K, bil Q x y = 0) :
    normGroup Q (J ⊔ K) = normGroup Q J ⊔ normGroup Q K := by
  apply le_antisymm
  · rintro _ ⟨x, hx, c, hc, rfl⟩
    obtain ⟨x₁, hx₁, x₂, hx₂, rfl⟩ := mem_sup.mp hx
    rw [scale_sup_of_orth Q horth] at hc
    obtain ⟨c₁, hc₁, c₂, hc₂, rfl⟩ := mem_sup.mp hc
    rw [Q_add, horth x₁ hx₁ x₂ hx₂]
    have : Q x₁ + 2 * 0 + Q x₂ + 2 * (c₁ + c₂) = (Q x₁ + 2 * c₁) + (Q x₂ + 2 * c₂) := by ring
    rw [this]
    exact AddSubgroup.add_mem_sup ⟨x₁, hx₁, c₁, hc₁, rfl⟩ ⟨x₂, hx₂, c₂, hc₂, rfl⟩
  · exact sup_le (normGroup_mono Q le_sup_left) (normGroup_mono Q le_sup_right)

/-- $\mathfrak mL \subseteq \mathfrak gL$: the sum of the fractional ideals contained in $\mathfrak gL$ is contained in
$\mathfrak gL$, so $\mathfrak mL$ is the largest such ideal. -/
theorem normGroupIdeal_subset (L : Submodule R V) : (normGroupIdeal Q L : Set F) ⊆ normGroup Q L :=
  fun z hz => by simpa using hz 1

/-- Every $R$-submodule of $F$ contained in $\mathfrak gL$ is contained in $\mathfrak mL$. -/
theorem le_normGroupIdeal {L : Submodule R V} {a : Submodule R F} (h : (a : Set F) ⊆ normGroup Q L) :
    a ≤ normGroupIdeal Q L :=
  fun _ hz r => h (a.smul_mem r hz)

/-- $2\,\mathfrak sL \subseteq \mathfrak mL \subseteq \mathfrak nL$ (O'Meara 1963, §93A, p. 253). -/
@[kb "omeara1963" "§93A, p. 253 (2(sL) ⊆ mL ⊆ gL ⊆ nL)"]
theorem two_smul_scale_le_normGroupIdeal (L : Submodule R V) : (2 : F) • scale Q L ≤ normGroupIdeal Q L := by
  refine le_normGroupIdeal Q ?_
  rintro _ ⟨c, hc, rfl⟩
  exact two_mul_mem_normGroup Q hc

theorem normGroupIdeal_le_normIdeal (L : Submodule R V) : normGroupIdeal Q L ≤ normIdeal Q L :=
  fun _ hz => normGroup_subset_normIdeal Q L (normGroupIdeal_subset Q L hz)

/-- $\mathfrak p(\mathfrak mL) \subseteq \mathfrak wL \subseteq \mathfrak mL$ and $2(\mathfrak sL) \subseteq \mathfrak wL
\subseteq \mathfrak nL$ (O'Meara 1963, §93A, p. 253). -/
@[kb "omeara1963" "§93A, p. 253 (p(mL) ⊆ wL ⊆ mL, 2(sL) ⊆ wL ⊆ nL)"]
theorem weight_bounds [IsLocalRing R] (L : Submodule R V) :
    Submodule.map (Algebra.linearMap R F) (maximalIdeal R) * normGroupIdeal Q L ≤ weight Q L ∧
      weight Q L ≤ normGroupIdeal Q L ∧ (2 : F) • scale Q L ≤ weight Q L ∧ weight Q L ≤ normIdeal Q L := by
  have hpm : Submodule.map (Algebra.linearMap R F) (maximalIdeal R) * normGroupIdeal Q L ≤
      normGroupIdeal Q L := by
    rw [Submodule.mul_le]
    rintro _ ⟨m, -, rfl⟩ z hz
    simp only [Algebra.linearMap_apply]
    rw [← Algebra.smul_def]
    exact (normGroupIdeal Q L).smul_mem m hz
  have hw : weight Q L ≤ normGroupIdeal Q L := sup_le hpm (two_smul_scale_le_normGroupIdeal Q L)
  exact ⟨le_sup_left, hw, le_sup_right, hw.trans (normGroupIdeal_le_normIdeal Q L)⟩

end NormGroup

section MatrixA

variable {R : Type*} [CommRing R] {F : Type*} [Field F] [Algebra R F] [Invertible (2 : F)]
variable {V : Type*} [AddCommGroup V] [Module F V] [Module R V] [IsScalarTower R F V]
variable (Q : QuadraticForm F V)

/-- **The matrix** $A(\alpha, \beta) = \begin{pmatrix}\alpha & 1 \\ 1 & \beta\end{pmatrix}$ (O'Meara 1963, §93B,
p. 255). -/
@[kb "omeara1963" "§93B, p. 255 (the matrix A(α, β))"]
def matA (α β : F) : Matrix (Fin 2) (Fin 2) F := !![α, 1; 1, β]

/-- **$L \cong A(\alpha, \beta)$** (O'Meara 1963, §93B, p. 255): $\alpha, \beta \in \mathfrak o$ with
$-1 + 4\alpha\beta \in \mathfrak u$ (so that $A(\alpha, \beta)$ is unimodular), and $L$ has a base with matrix
$A(\alpha, \beta)$. -/
@[kb "omeara1963" "§93B, p. 255 (L ≅ A(α, β))"]
def HasMatrixA (L : Submodule R V) (α β : R) : Prop :=
  IsUnit (-1 + 4 * α * β) ∧ ∃ b : Basis (Fin 2) R L,
    gram Q (fun i => (b i : V)) = matA (algebraMap R F α) (algebraMap R F β)

/-- **Example 93:9** (O'Meara 1963, p. 255): if $L \cong A(\alpha, 0)$ then $L \cong A(\alpha + 2\beta, 0)$ for every
$\beta \in \mathfrak o$ (replace the base $x, y$ by $x + \beta y, y$). -/
@[kb "omeara1963" "§93B, 93:9, p. 255"]
theorem HasMatrixA.add_two_mul {L : Submodule R V} {α : R} (h : HasMatrixA Q L α 0) (β : R) :
    HasMatrixA Q L (α + 2 * β) 0 := by
  obtain ⟨-, b, hb⟩ := h
  refine ⟨by simp, ?_⟩
  let M : Matrix (Fin 2) (Fin 2) R := !![1, 0; β, 1]
  have hM : IsUnit M.det := by simp [M, Matrix.det_fin_two_of]
  let e : L ≃ₗ[R] L := Matrix.toLinearEquiv b M hM
  refine ⟨b.map e, ?_⟩
  have h0 : ((b.map e) 0 : V) = (b 0 : V) + β • (b 1 : V) := by
    simp [e, M, Matrix.toLinearEquiv_apply, Matrix.toLin_self, Fin.sum_univ_two]
  have h1 : ((b.map e) 1 : V) = (b 1 : V) := by
    simp [e, M, Matrix.toLinearEquiv_apply, Matrix.toLin_self, Fin.sum_univ_two]
  have hg : ∀ i j, bil Q (b i : V) (b j : V) = matA (algebraMap R F α) (algebraMap R F 0) i j := fun i j => by
    rw [← hb]; rfl
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp only [gram, Matrix.of_apply, Fin.zero_eta, Fin.mk_one, h0, h1, bil_add_left, bil_add_right,
      bil_rsmul_left, bil_rsmul_right, hg] <;>
    simp [matA, map_ofNat] <;> ring

end MatrixA

section Hyperbolic

variable {R : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
  {F : Type*} [Field F] [Algebra R F] [IsFractionRing R F] [Invertible (2 : F)]
variable {V : Type*} [AddCommGroup V] [Module F V] [Module R V] [IsScalarTower R F V]
variable (Q : QuadraticForm F V)

/-- **$\mathfrak gL = Q(L)$ when $L$ contains a unimodular hyperbolic plane** (O'Meara 1963, §93A, p. 252): if
$\mathfrak sL = \mathfrak o$ and $L$ contains $x, y$ with $Q(x) = Q(y) = 0$ and $B(x, y) = 1$ (a sublattice
$H \cong \begin{pmatrix} 0 & 1 \\ 1 & 0\end{pmatrix}$), then $\mathfrak gL = Q(L)$. -/
@[kb "omeara1963" "§93A, p. 252 (gL = Q(L) when sL = o and L contains a hyperbolic plane)"]
theorem normGroup_eq_image (L : Submodule R V) (hs : scale Q L = 1) {x y : V} (hx : x ∈ L) (hy : y ∈ L)
    (hQx : Q x = 0) (hQy : Q y = 0) (hxy : bil Q x y = 1) :
    (normGroup Q L : Set F) = Q '' (L : Set V) := by
  apply le_antisymm
  · rintro _ ⟨z, hz, c, hc, rfl⟩
    -- `H = ox + oy` is unimodular and splits `L`
    let v : Fin 2 → V := ![x, y]
    let U : Matrix (Fin 2) (Fin 2) R := !![0, 1; 1, 0]
    have hG : gram Q v = (1 : F) • U.map (algebraMap R F) := by
      ext i j; fin_cases i <;> fin_cases j <;> simp [v, U, gram, hQx, hQy, hxy, bil_comm Q y x]
    have hU : IsUnit U.det := by simp [U, Matrix.det_fin_two_of]
    obtain ⟨hmod, -⟩ := isModular_span_of_gram Q one_ne_zero hU hG
    have hHL : span R (Set.range v) ≤ L := by
      rw [span_le]; rintro _ ⟨i, rfl⟩; fin_cases i
      · exact hx
      · exact hy
    have hsc : scale Q L = R ∙ (1 : F) := by rw [hs, ← Submodule.one_eq_span]
    obtain ⟨K, hK⟩ := splits_of_isModular_of_scale_eq Q hHL hmod (fg_span (Set.finite_range v)) hsc
    rw [← hK.sup_eq] at hz
    obtain ⟨h, hh, k, hk, rfl⟩ := mem_sup.mp hz
    -- `Q(H) = 2o`
    obtain ⟨d, hd⟩ : ∃ d : R, Q h = 2 * algebraMap R F d := by
      have hh' : h ∈ span R {x, y} := by
        have : Set.range v = {x, y} := by
          ext w; simp [v, eq_comm, or_comm]
        rwa [← this]
      obtain ⟨a, b, rfl⟩ := mem_span_pair.mp hh'
      refine ⟨a * b, ?_⟩
      rw [Q_add, Q_rsmul, Q_rsmul, bil_rsmul_left, bil_rsmul_right, hQx, hQy, hxy, map_mul]; ring
    obtain ⟨c', hc'⟩ : ∃ c' : R, c = algebraMap R F c' := by
      have : c ∈ (1 : Submodule R F) := hs ▸ hc
      obtain ⟨c', hc'⟩ := Submodule.mem_one.mp this
      exact ⟨c', hc'.symm⟩
    refine ⟨x + (d + c') • y + k, ?_, ?_⟩
    · exact hK.sup_eq ▸ add_mem (mem_sup_left (add_mem (subset_span ⟨0, rfl⟩)
        (smul_mem _ _ (subset_span ⟨1, rfl⟩)))) (mem_sup_right hk)
    · have horth1 : bil Q (x + (d + c') • y) k = 0 :=
        hK.orth _ (add_mem (subset_span ⟨0, rfl⟩) (smul_mem _ _ (subset_span ⟨1, rfl⟩))) k hk
      have horth2 : bil Q h k = 0 := hK.orth h hh k hk
      rw [Q_add, horth1, Q_add Q h k, horth2, Q_add, Q_rsmul, bil_rsmul_right, hQx, hQy, hxy, hd, hc',
        map_add]
      ring
  · rintro _ ⟨z, hz, rfl⟩; exact Q_mem_normGroup Q hz

end Hyperbolic

end QuadFormsKB.OMeara
