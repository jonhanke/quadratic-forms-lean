/-
# O'Meara §101C: the groups $O'_n/\Omega_n$ over a number field

**Layer:** $F$ a number field, $V = F^n$ with a nondegenerate `Q : QuadForm F n`; matrix groups $O(V_K)$ =
`orthGroup Q K`, $O'(V_K)$ = `spinorKernel Q K`, $\Omega_n(V_K)$ = `commutator (orthGroup Q K)` over a field
$K \supseteq F$ of characteristic $0$: $K = F$, a completion $F_\mathfrak p$ (`v.adicCompletion F`) or $F_w$
(`w.Completion`, $\cong \mathbb R$ or $\mathbb C$); localization `orthMap`; O'Meara's abstract $\Omega$, $O'$ through
`QIn.glEquiv`.

**Proves**
* `spinorKernel_le_commutator_of_isotropic`, `spinorKernel_le_commutator_of_isSquare_mul`,
  `spinorKernel_le_commutator_infinite`: $O'_n(V_K) = \Omega_n(V_K)$ when $V_K$ is isotropic (55:6a, via
  `OMeara.omega_eq_orthPrime_of_isotropic`), when all ratios $Q(x)/Q(y)$ are squares, hence at every infinite spot
  ("the archimedean theory of quadratic forms" O'Meara invokes on p. 295);
* `sq_mem_commutator`: $\sigma^2 \in \Omega_n(V)$ for $\sigma \in O^+_n(V)$, so $O'_n/\Omega_n$ has exponent $2$;
* `omeara101_r39_image` (§101C, p. 295, unconditional): the localization map
  $O'_n(V) \to \prod_\mathfrak p O'_n(V_\mathfrak p)/\Omega_n(V_\mathfrak p)$ is onto (the field `image` of
  `OMeara101_r39`);
* `omeara101_r39_of_101_12`, `omeara101_r40_of_101_12`: the named statements `OMeara101_r39` and `OMeara101_r40`
  follow from Proposition 101:12 (the named statement `OMeara101_12`), as O'Meara says ("this follows easily from
  Propositions 101:9 and 101:12").
-/
import QuadFormsKB.Literature.OMeara.Sec101Twelve
import QuadFormsKB.Literature.OMeara.Sec101Nine
import QuadFormsKB.Lattices.SAEqualPairs

open NumberField IsDedekindDomain

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.Lattices

variable {F : Type} [Field F] [NumberField F] {n : ℕ} (Q : QuadForm F n)

section General

variable (K : Type) [Field K] [Algebra F K] [CharZero K]

theorem nondegenerate_qk_of (hQ : Q.Nondegenerate) : (QuadraticMap.associated (qk Q K)).Nondegenerate :=
  QuadraticMap.nondegenerate_associated_iff.mpr
    (QuadraticMap.nondegenerate_polar_iff.mp (QuadForm.nondegenerate_polarBilin_toQuadraticFormIn K hQ))

/-- **$O'_n = \Omega_n$ for an isotropic space** (O'Meara 1973, §55, 55:6a, `OMeara.omega_eq_orthPrime_of_isotropic`)
in the matrix model over $K$. -/
theorem spinorKernel_le_commutator_of_isotropic (hQ : Q.Nondegenerate) (hiso : Q.IsotropicIn K) :
    spinorKernel Q K ≤ commutator (orthGroup Q K) := by
  intro σ hk
  obtain ⟨x, hx0, hx⟩ := hiso
  rw [OMeara.QIn.mem_commutator_iff, OMeara.omega_eq_orthPrime_of_isotropic _ (nondegenerate_qk_of Q K hQ)
    ⟨x, hx0, by rw [qk_apply]; exact hx⟩]
  exact OMeara.QIn.mem_orthPrime_of_mem_spinorKernel Q K hk

/-- **$O'_n = \Omega_n$ for $n \le 3$** over any $K$ (55:5). -/
theorem spinorKernel_le_commutator_of_le_three' (hQ : Q.Nondegenerate) (hn : n ≤ 3) :
    spinorKernel Q K ≤ commutator (orthGroup Q K) := by
  intro σ hk
  rw [OMeara.QIn.mem_commutator_iff, OMeara.omega_eq_orthPrime_of_finrank_le_three _ (nondegenerate_qk_of Q K hQ)
    (by rw [Module.finrank_fin_fun]; exact hn)]
  exact OMeara.QIn.mem_orthPrime_of_mem_spinorKernel Q K hk

/-- **$O'_n = \Omega_n$ when all products $Q(x)Q(y)$ of non-zero values are squares** (e.g. over $\mathbb C$, or a
definite space over $\mathbb R$): an element of $O'_n$ is a product of an even number $2k$ of symmetries
$\tau_{x_1}\cdots\tau_{x_{2k}}$, and $\tau_{x_1}\cdots\tau_{x_{2k}} \equiv \tau_{x_1}^{2k} = 1$ modulo the group
generated by the $\tau_x\tau_y$ with $Q(x) = Q(y)$, which lies in $\Omega_n$ (Witt). -/
theorem spinorKernel_le_commutator_of_isSquare_mul
    (hsq : ∀ x y : Fin n → K, Q.evalIn K x ≠ 0 → Q.evalIn K y ≠ 0 → IsSquare (Q.evalIn K x * Q.evalIn K y)) :
    spinorKernel Q K ≤ commutator (orthGroup Q K) := by
  rintro _ ⟨xs, ⟨hxa, hxe, -⟩, rfl⟩
  rcases xs with _ | ⟨x₀, xs'⟩
  · simp [symmProd]
  have hx₀ : Q.evalIn K x₀ ≠ 0 := hxa x₀ List.mem_cons_self
  have hrel : ∀ l : List (Fin n → K), (∀ x ∈ l, Q.evalIn K x ≠ 0) →
      List.Forall₂ (SqRel Q K) l (List.replicate l.length x₀) := by
    intro l
    induction l with
    | nil => intro _; exact List.Forall₂.nil
    | cons x l ih =>
      intro hl
      have hx : Q.evalIn K x ≠ 0 := hl x List.mem_cons_self
      refine List.Forall₂.cons ⟨hx, hx₀, ?_⟩ (ih fun y hy => hl y (List.mem_cons_of_mem x hy))
      obtain ⟨r, hr⟩ := hsq _ _ hx hx₀
      refine ⟨r / Q.evalIn K x, ?_⟩
      field_simp
      linear_combination hr
  have h1 := symmProd_inv_mul_mem_of_forall₂ Q K (hrel _ hxa)
  have hrep : ∀ m : ℕ, symmProd Q K (List.replicate m x₀) = symm Q K x₀ ^ m := by
    intro m
    induction m with
    | zero => simp [symmProd]
    | succ m ih =>
      rw [List.replicate_succ, symmProd, List.map_cons, List.prod_cons, ← symmProd, ih, pow_succ']
  have hys1 : symmProd Q K (List.replicate (x₀ :: xs').length x₀) = 1 := by
    obtain ⟨k, hk⟩ := hxe
    rw [hrep, hk, ← two_mul, pow_mul, sq, symm_mul_self, one_pow]
  rw [hys1, mul_one] at h1
  have h2 := (eqPairGroup Q K).inv_mem h1
  rw [inv_inv] at h2
  exact eqPairGroup_le_commutator (Q := Q) K h2

/-- **$O'_n = \Omega_n$ at every infinite spot** (the archimedean case used by O'Meara on p. 295): over $F_w$
($\mathbb R$ or $\mathbb C$) either $V_w$ is isotropic, or all products $Q(x)Q(y)$ of non-zero values are squares
(`isotropicIn_or_isSquare_mul`). -/
theorem spinorKernel_le_commutator_infinite (hQ : Q.Nondegenerate) (w : InfinitePlace F) :
    spinorKernel Q w.Completion ≤ commutator (orthGroup Q w.Completion) := by
  rcases isotropicIn_or_isSquare_mul Q w with h | h
  · exact spinorKernel_le_commutator_of_isotropic Q _ hQ h
  · exact spinorKernel_le_commutator_of_isSquare_mul Q _ h

/-- The image of a rational symmetry over any $K \supseteq F$: $\tau_x \mapsto \tau_x$. -/
theorem orthMap_symm' (x : Fin n → F) :
    orthMap Q K (symm Q F x) = symm Q K (fun i => algebraMap F K (x i)) := by
  have hval : Q.evalIn K (fun i => algebraMap F K (x i)) = algebraMap F K (Q.evalIn F x) := by
    simpa using evalIn_map_tower Q K (K := F) x
  by_cases hx : Q.evalIn F x ≠ 0
  · have hx' : Q.evalIn K (fun i => algebraMap F K (x i)) ≠ 0 := by
      rw [hval]; exact (map_ne_zero _).mpr hx
    ext1; ext1
    change ((symm Q F x : GL (Fin n) F) : Matrix (Fin n) (Fin n) F).map (algebraMap F K) = _
    rw [symm_val Q F hx, symm_val Q K hx']
    ext i j
    simp only [QuadForm.reflMat, Matrix.map_apply, Matrix.sub_apply, Matrix.one_apply, Matrix.vecMulVec_apply,
      symmVec, Pi.smul_apply, smul_eq_mul, Matrix.mulVec, dotProduct, hval]
    split_ifs <;> simp [map_sum, map_mul, map_inv₀, map_sub]
  · have hx0 : Q.evalIn F x = 0 := not_not.mp hx
    have hx0' : Q.evalIn K (fun i => algebraMap F K (x i)) = 0 := by rw [hval, hx0, map_zero]
    have h1 : symm Q F x = 1 := by ext1; simp [symm, symmGL_of_eq_zero Q F hx0]
    have h2 : symm Q K (fun i => algebraMap F K (x i)) = 1 := by
      ext1; simp [symm, symmGL_of_eq_zero Q K hx0']
    rw [h1, h2, map_one]

/-- **$O'(V) \to O'(V_K)$** over any $K \supseteq F$ of characteristic $0$ (finite or infinite completions). -/
theorem orthMap_mem_spinorKernel' {γ : orthGroup Q F} (hγ : γ ∈ spinorKernel Q F) :
    orthMap Q K γ ∈ spinorKernel Q K := by
  obtain ⟨xs, ⟨hxa, hxe, ⟨c, hc⟩⟩, rfl⟩ := hγ
  have hval : ∀ x : Fin n → F,
      Q.evalIn K (fun i => algebraMap F K (x i)) = algebraMap F K (Q.evalIn F x) := fun x => by
    simpa using evalIn_map_tower Q K (K := F) x
  refine ⟨xs.map fun x i => algebraMap F K (x i), ⟨?_, by rwa [List.length_map], ⟨algebraMap F K c, ?_⟩⟩, ?_⟩
  · intro z hz
    obtain ⟨x, hx, rfl⟩ := List.mem_map.mp hz
    rw [hval]; exact (map_ne_zero _).mpr (hxa x hx)
  · rw [← map_mul, ← hc, valProd, valProd, List.map_map, map_list_prod, List.map_map]
    congr 1
    exact List.map_congr_left fun x _ => hval x
  · rw [symmProd, symmProd, map_list_prod, List.map_map, List.map_map]
    congr 1
    exact List.map_congr_left fun x _ => (orthMap_symm' Q K x).symm

end General

/-! ### The groups $O'_n/\Omega_n$ (O'Meara §101C, p. 295) -/

/-- **$O'_n/\Omega_n$ has exponent $2$** (O'Meara 1973, §101C, p. 295, part of "$O'_4/\Omega_4$ is a direct product of
groups of order $2$"; from 55:5, `OMeara.sq_mem_omega_of_mem_orthPlus`): $\sigma^2 \in \Omega_n(V)$ for every
$\sigma \in O'_n(V)$. Unconditional. -/
@[kb "omeara1963" "§101C, p. 295 (O'_n/Ω_n has exponent 2)"]
theorem sq_mem_commutator (hQ : Q.Nondegenerate) {σ : orthGroup Q F} (hσ : σ ∈ spinorKernel Q F) :
    σ ^ 2 ∈ commutator (orthGroup Q F) := by
  rw [OMeara.QIn.mem_commutator_iff, Subgroup.coe_pow, map_pow]
  exact OMeara.sq_mem_omega_of_mem_orthPlus _ (nondegenerate_qk_of Q F hQ)
    (OMeara.orthPrime_le_orthPlus _ (OMeara.QIn.mem_orthPrime_of_mem_spinorKernel Q F hσ))

/-- **The localization map $O'_n(V) \to \prod_\mathfrak p O'_n(V_\mathfrak p)/\Omega_n(V_\mathfrak p)$ is onto**
(O'Meara 1973, §101C, p. 295, the surjectivity in "$O'_n/\Omega_n \cong \prod_\mathfrak p O'_n(V_\mathfrak p)/
\Omega_n(V_\mathfrak p)$"; the field `image` of the named statement `OMeara101_r39`): given $\varphi_\mathfrak p \in
O'(V_\mathfrak p)$ at the finite spots, almost all in $\Omega_n(V_\mathfrak p)$, and $\psi_w \in O'(V_w)$ at the infinite
spots, some $\sigma \in O'_n(V)$ has $\sigma_\mathfrak p \in \varphi_\mathfrak p\Omega_n(V_\mathfrak p)$ and $\sigma_w \in
\psi_w\Omega_n(V_w)$ everywhere. Unconditional: for $n \ge 4$ by the correction step of 104:4 (`exists_correction`, the
role of 101:9 in the book), for $n \le 3$ because $O'_n = \Omega_n$ locally (55:5); at the infinite spots
$O'_n = \Omega_n$ (`spinorKernel_le_commutator_infinite`).

*Update:* O'Meara derives the isomorphism from 101:9 and 101:12; the surjectivity does not need 101:12. -/
@[kb "omeara1963" "§101C, p. 295 (O'_n/Ω_n ≅ ∏ O'_n(V_𝔭)/Ω_n(V_𝔭): the map is onto)"]
theorem omeara101_r39_image (hQ : Q.Nondegenerate)
    (φ : ∀ v : HeightOneSpectrum (𝓞 F), orthGroup Q (v.adicCompletion F))
    (ψ : ∀ w : InfinitePlace F, orthGroup Q w.Completion)
    (hφ : ∀ v, φ v ∈ spinorKernel Q (v.adicCompletion F)) (hψ : ∀ w, ψ w ∈ spinorKernel Q w.Completion)
    (hcof : ∀ᶠ v in Filter.cofinite, φ v ∈ commutator (orthGroup Q (v.adicCompletion F))) :
    ∃ σ ∈ spinorKernel Q F,
      (∀ v, (φ v)⁻¹ * orthMap Q (v.adicCompletion F) σ ∈ commutator (orthGroup Q (v.adicCompletion F))) ∧
      ∀ w, (ψ w)⁻¹ * orthMap Q w.Completion σ ∈ commutator (orthGroup Q w.Completion) := by
  classical
  by_cases hn : 4 ≤ n
  · set T := (Filter.eventually_cofinite.mp hcof).toFinset with hT
    obtain ⟨g, hg, h1, h2⟩ := exists_correction Q hQ hn T (fun v => (φ v)⁻¹)
      fun v _ => (spinorKernel Q _).inv_mem (hφ v)
    refine ⟨g, hg, fun v => ?_, fun w => ?_⟩
    · by_cases hv : v ∈ T
      · have hN : (commutator (orthGroup Q (v.adicCompletion F))).Normal := inferInstance
        have hc := hN.conj_mem _ (h1 v hv) (φ v)⁻¹
        simpa [mul_assoc] using hc
      · have hφv : φ v ∈ commutator (orthGroup Q (v.adicCompletion F)) := by
          simpa [hT] using hv
        exact (commutator _).mul_mem ((commutator _).inv_mem hφv) (h2 v hv)
    · exact (commutator _).mul_mem
        ((commutator _).inv_mem (spinorKernel_le_commutator_infinite Q hQ w (hψ w)))
        (spinorKernel_le_commutator_infinite Q hQ w (orthMap_mem_spinorKernel' Q _ hg))
  · refine ⟨1, (spinorKernel Q F).one_mem, fun v => ?_, fun w => ?_⟩
    · rw [map_one, mul_one]
      exact (commutator _).inv_mem (spinorKernel_le_commutator_of_le_three' Q _ hQ (by omega) (hφ v))
    · rw [map_one, mul_one]
      exact (commutator _).inv_mem (spinorKernel_le_commutator_infinite Q hQ w (hψ w))

/-- **101.r39 from 101:12** (O'Meara 1973, §101C, p. 295, "this follows easily from Propositions 101:9 and 101:12"):
Proposition 101:12 (the named statement `OMeara101_12`) implies the named statement `OMeara101_r39`. The field `image`
is unconditional (`omeara101_r39_image`); the field `ker` is 101:12 for $\sigma \in O'_n$ (`omeara101_r39_ker`). -/
@[kb "omeara1963" "§101C, p. 295 (O'_n/Ω_n ≅ ∏ O'_n(V_𝔭)/Ω_n(V_𝔭), from 101:12)"]
theorem omeara101_r39_of_101_12 (h12 : OMeara101_12 F) : OMeara101_r39 F :=
  ⟨fun _ Q hQ _ hσ => omeara101_r39_ker h12 Q hQ hσ,
    fun _ Q hQ φ ψ hφ hψ hcof => omeara101_r39_image Q hQ φ ψ hφ hψ hcof⟩

/-- **101.r40 from 101:12** (O'Meara 1973, §101C, p. 295): Proposition 101:12 (the named statement `OMeara101_12`)
implies the named statement `OMeara101_r40`: $O'_n = \Omega_n$ for $n \ne 4$ ($n \le 3$ unconditionally by 55:5; for
$n \ge 5$, $V_\mathfrak p$ is isotropic at every finite spot, so $O'_n(V_\mathfrak p) = \Omega_n(V_\mathfrak p)$, and
$O'_n = \Omega_n$ at the infinite spots), and $O'_4/\Omega_4$ has exponent $2$ (unconditional, `sq_mem_commutator`)
and is finite: by 101:12 the class of $\sigma$ is determined by the local classes at the finitely many spots where
$V_\mathfrak p$ is anisotropic, each of which takes at most two values (95:1, `OMeara.quaternarySpinor_index`). -/
@[kb "omeara1963" "§101C, p. 295 (O'_n = Ω_n for n ≠ 4; O'_4/Ω_4 a finite product of groups of order 2, from 101:12)"]
theorem omeara101_r40_of_101_12 (h12 : OMeara101_12 F) : OMeara101_r40 F := by
  classical
  refine ⟨fun n Q hQ hn4 => ?_, fun Q hQ => ⟨fun σ hσ => sq_mem_commutator Q hQ hσ, ?_⟩⟩
  · by_cases hn : n ≤ 3
    · exact spinorKernel_le_commutator_of_le_three Q hQ hn
    · intro σ hσ
      rw [h12.holds n Q hQ σ (spinorKernel_le_soSub Q F hσ)]
      exact ⟨fun v => spinorKernel_le_commutator_of_isotropic Q _ hQ
          (isotropicIn_completion_of_five_le Q (by omega) hQ v) (orthMap_mem_spinorKernel Q v hσ),
        fun w => spinorKernel_le_commutator_infinite Q hQ w (orthMap_mem_spinorKernel' Q _ hσ)⟩
  · set T0 := (finite_anisotropic Q hQ (by norm_num)).toFinset with hT0
    let pat : orthGroup Q F → Finset (HeightOneSpectrum (𝓞 F)) := fun σ =>
      T0.filter fun v => orthMap Q (v.adicCompletion F) σ ∉ commutator (orthGroup Q (v.adicCompletion F))
    let rep : Finset (HeightOneSpectrum (𝓞 F)) → orthGroup Q F := fun A =>
      if h : ∃ σ ∈ spinorKernel Q F, pat σ = A then h.choose else 1
    refine ⟨T0.powerset.image rep, fun σ hσ => ?_⟩
    have hex : ∃ τ ∈ spinorKernel Q F, pat τ = pat σ := ⟨σ, hσ, rfl⟩
    have hs : rep (pat σ) = hex.choose := by simp only [rep, hex, dite_true]
    obtain ⟨hsk, hspat⟩ := hex.choose_spec
    set s := hex.choose with hsdef
    refine ⟨s, Finset.mem_image.mpr ⟨pat σ, Finset.mem_powerset.mpr (Finset.filter_subset _ _), hs⟩, ?_⟩
    have hsσ : s⁻¹ * σ ∈ spinorKernel Q F := (spinorKernel Q F).mul_mem ((spinorKernel Q F).inv_mem hsk) hσ
    rw [h12.holds 4 Q hQ _ (spinorKernel_le_soSub Q F hsσ)]
    refine ⟨fun v => ?_, fun w => spinorKernel_le_commutator_infinite Q hQ w (orthMap_mem_spinorKernel' Q _ hsσ)⟩
    by_cases hv : v ∈ T0
    · rw [map_mul, map_inv]
      have hiff : orthMap Q (v.adicCompletion F) s ∈ commutator (orthGroup Q (v.adicCompletion F)) ↔
          orthMap Q (v.adicCompletion F) σ ∈ commutator (orthGroup Q (v.adicCompletion F)) := by
        have h := congrArg (fun A => v ∈ A) hspat
        simp only [pat, Finset.mem_filter, hv, true_and, eq_iff_iff] at h
        exact not_iff_not.mp h
      by_cases hσv : orthMap Q (v.adicCompletion F) σ ∈ commutator (orthGroup Q (v.adicCompletion F))
      · exact (commutator _).mul_mem ((commutator _).inv_mem (hiff.mpr hσv)) hσv
      · have hsv : orthMap Q (v.adicCompletion F) s ∉ commutator (orthGroup Q (v.adicCompletion F)) :=
          fun h => hσv (hiff.mp h)
        refine OMeara.quaternarySpinor_index Q hQ v _ _
          ((spinorKernel Q _).inv_mem (orthMap_mem_spinorKernel Q v hsk)) (orthMap_mem_spinorKernel Q v hσ)
          (fun h => hsv ?_) hσv
        simpa using (commutator _).inv_mem h
    · have hiso : Q.IsotropicIn (v.adicCompletion F) := by
        by_contra h
        exact hv ((Set.Finite.mem_toFinset _).mpr h)
      exact spinorKernel_le_commutator_of_isotropic Q _ hQ hiso (orthMap_mem_spinorKernel Q v hsσ)

end QuadFormsKB.Lattices
