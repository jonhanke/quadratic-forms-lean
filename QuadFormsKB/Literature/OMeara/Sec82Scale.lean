/-
# O'Meara §82E: scale and norm of $\mathfrak a_1z_1 + \cdots + \mathfrak a_rz_r$ over a Dedekind domain

**Setting.** $R$ is a Dedekind domain with fraction field $F$, $2 \in F^\times$ (`Invertible (2 : F)`), and $(V, Q)$
is a quadratic space over $F$ with O'Meara's bilinear form $B$ = `bil Q` ($B(x, x) = Q(x)$). Lattices, fractional
ideals and $\mathfrak aL$ (`a • L`) are as in `Sec81.lean`; the scale $\mathfrak sL$ (`scale`) and the norm
$\mathfrak nL$ (`normIdeal`) are the definitions of `Sec82.lean`.

**Proves** (O'Meara 1963, §82E, pp. 227–228):
* `span_pair_sq`, `span_sq_image_eq`, `span_sq_eq_sq`: the squares of the elements of a fractional ideal
  $\mathfrak a$ generate $\mathfrak a^2$ (used in O'Meara's proof of 82:8 through Example 22:3);
* `scale_iSup_smul`, `normIdeal_iSup_smul` (**82:8**), `scale_smul`, `normIdeal_smul` (**82:8a**).
-/
import QuadFormsKB.Literature.OMeara.Sec81

open QuadraticMap Submodule Module

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.OMeara

section Squares

variable {R : Type*} [CommRing R] [IsDedekindDomain R] {F : Type*} [Field F] [Algebra R F]
  [IsFractionRing R F]

/-- Cancellation of a nonzero finitely generated submodule of `F`. -/
theorem mul_left_cancel_of_fg {I J K : Submodule R F} (hI : I.FG) (h0 : I ≠ ⊥)
    (h : I * J = I * K) : J = K := by
  have h1 := mul_one_div_cancel_of_fg hI h0
  calc J = (I * (1 / I)) * J := by rw [h1, one_mul]
    _ = (1 / I) * (I * J) := by ring
    _ = (1 / I) * (I * K) := by rw [h]
    _ = (I * (1 / I)) * K := by ring
    _ = K := by rw [h1, one_mul]

/-- The square of a pair ideal is generated by `α²`, `αβ`, `β²`. -/
theorem span_pair_pow_two (α β : F) :
    (span R {α, β}) ^ 2 = span R {α ^ 2, α * β, β ^ 2} := by
  rw [pow_two, span_mul_span]
  congr 1
  ext x
  simp only [Set.mem_mul, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨a, ha, b, hb, rfl⟩
    rcases ha with rfl | rfl <;> rcases hb with rfl | rfl
    · left; ring
    · right; left; rfl
    · right; left; ring
    · right; right; ring
  · rintro (rfl | rfl | rfl)
    · exact ⟨α, Or.inl rfl, α, Or.inl rfl, by ring⟩
    · exact ⟨α, Or.inl rfl, β, Or.inr rfl, rfl⟩
    · exact ⟨β, Or.inr rfl, β, Or.inr rfl, by ring⟩

/-- **$(\alpha, \beta)^2 = (\alpha^2, \beta^2)$** for $\alpha, \beta \in F$ (in a Dedekind domain; compare O'Meara
1963, Example 22:3). -/
theorem span_pair_sq (α β : F) : span R {α ^ 2, β ^ 2} = (span R {α, β}) ^ 2 := by
  set I : Submodule R F := span R {α, β} with hI
  set K : Submodule R F := span R {α ^ 2, β ^ 2} with hK
  by_cases h0 : I = ⊥
  · have hα : α = 0 := by
      have : α ∈ I := subset_span (by simp)
      rw [h0] at this; simpa using this
    have hβ : β = 0 := by
      have : β ∈ I := subset_span (by simp)
      rw [h0] at this; simpa using this
    subst hα hβ
    simp [hK, h0]
  have hfg : I.FG := by classical exact ⟨{α, β}, by simp [hI]⟩
  have hKI : K ≤ I ^ 2 := by
    rw [hK, span_le, hI, span_pair_pow_two]
    rintro _ (rfl | rfl)
    · exact subset_span (by simp)
    · exact subset_span (by simp)
  have hmain : I ^ 2 * I ^ 2 ≤ K * I ^ 2 := by
    rw [Submodule.mul_le]
    intro m hm n hn
    rw [hI, span_pair_pow_two] at hm hn
    refine span_induction (p := fun m _ => m * n ∈ K * I ^ 2) ?_ (by simp) ?_ ?_ hm
    · intro m hm
      refine span_induction (p := fun n _ => m * n ∈ K * I ^ 2) ?_ (by simp) ?_ ?_ hn
      · intro n hn
        have hαβ : α * β ∈ I ^ 2 := by
          rw [hI, span_pair_pow_two]; exact subset_span (by simp)
        have hα2 : α ^ 2 ∈ I ^ 2 := by
          rw [hI, span_pair_pow_two]; exact subset_span (by simp)
        have hβ2 : β ^ 2 ∈ I ^ 2 := by
          rw [hI, span_pair_pow_two]; exact subset_span (by simp)
        have kα : α ^ 2 ∈ K := subset_span (by simp)
        have kβ : β ^ 2 ∈ K := subset_span (by simp)
        rcases hm with rfl | rfl | rfl <;> rcases hn with rfl | rfl | rfl
        · exact mul_mem_mul kα hα2
        · exact mul_mem_mul kα hαβ
        · exact mul_mem_mul kα hβ2
        · have := mul_mem_mul kα hαβ; convert this using 1; ring
        · have := mul_mem_mul kα hβ2; convert this using 1; ring
        · have := mul_mem_mul kβ hαβ; convert this using 1; ring
        · exact mul_mem_mul kβ hα2
        · exact mul_mem_mul kβ hαβ
        · exact mul_mem_mul kβ hβ2
      · intro a b _ _ ha hb; rw [mul_add]; exact add_mem ha hb
      · intro r a _ ha; rw [mul_smul_comm]; exact smul_mem _ r ha
    · intro a b _ _ ha hb; rw [add_mul]; exact add_mem ha hb
    · intro r a _ ha; rw [smul_mul_assoc]; exact smul_mem _ r ha
  have hle : K * I ^ 2 ≤ I ^ 2 * I ^ 2 := mul_le_mul' hKI le_rfl
  have e : I * (I * K) = I * (I * I ^ 2) := by
    calc I * (I * K) = K * I ^ 2 := by ring
      _ = I ^ 2 * I ^ 2 := le_antisymm hle hmain
      _ = I * (I * I ^ 2) := by ring
  exact mul_left_cancel_of_fg hfg h0 (mul_left_cancel_of_fg hfg h0 e)

/-- **The squares of a fractional ideal generate its square**: $\mathfrak a^2$ is generated by the $\alpha^2$,
$\alpha \in \mathfrak a$ (used by O'Meara 1963 in the proof of 82:8, p. 228, through Example 22:3). More generally the
squares of a generating set $S$ of $\mathfrak a$ generate $\mathfrak a^2$. -/
theorem span_sq_image_eq (S : Set F) : span R ((fun c => c ^ 2) '' S) = (span R S) ^ 2 := by
  apply le_antisymm
  · rw [span_le]
    rintro _ ⟨c, hc, rfl⟩
    show c ^ 2 ∈ span R S ^ 2
    rw [sq c, sq (span R S)]
    exact mul_mem_mul (subset_span hc) (subset_span hc)
  · rw [pow_two, Submodule.mul_le]
    intro m hm n hn
    refine span_induction (p := fun m _ => m * n ∈ span R ((fun c => c ^ 2) '' S)) ?_ (by simp) ?_ ?_ hm
    · intro s hs
      refine span_induction (p := fun n _ => s * n ∈ span R ((fun c => c ^ 2) '' S)) ?_ (by simp) ?_ ?_ hn
      · intro t ht
        have h1 : s * t ∈ span R {s ^ 2, t ^ 2} := by
          rw [span_pair_sq, span_pair_pow_two]; exact subset_span (by simp)
        refine span_le.mpr ?_ h1
        rintro _ (rfl | rfl)
        · exact subset_span ⟨s, hs, rfl⟩
        · exact subset_span ⟨t, ht, rfl⟩
      · intro a b _ _ ha hb; rw [mul_add]; exact add_mem ha hb
      · intro r a _ ha; rw [mul_smul_comm]; exact smul_mem _ r ha
    · intro a b _ _ ha hb; rw [add_mul]; exact add_mem ha hb
    · intro r a _ ha; rw [smul_mul_assoc]; exact smul_mem _ r ha

theorem span_sq_eq_sq (a : Submodule R F) : span R ((fun c => c ^ 2) '' (a : Set F)) = a ^ 2 := by
  simpa using span_sq_image_eq (R := R) (a : Set F)

end Squares

section Scale

variable {R : Type*} [CommRing R] [IsDedekindDomain R] {F : Type*} [Field F] [Algebra R F]
  [IsFractionRing R F] [Invertible (2 : F)]
variable {V : Type*} [AddCommGroup V] [Module F V] [Module R V] [IsScalarTower R F V]
variable (Q : QuadraticForm F V)

/-- Elements of `a • span R {z}` are the `γ • z` with `γ ∈ a`. -/
theorem mem_smul_span_singleton_iff' (a : Submodule R F) (z x : V) :
    x ∈ a • span R {z} ↔ ∃ γ ∈ a, x = γ • z := by
  constructor
  · intro h
    refine Submodule.smul_induction_on h (fun r hr n hn => ?_) ?_
    · obtain ⟨c, rfl⟩ := mem_span_singleton.1 hn
      refine ⟨r * algebraMap R F c, ?_, ?_⟩
      · rw [mul_comm, ← Algebra.smul_def]; exact a.smul_mem c hr
      · rw [← algebraMap_smul F c z, smul_smul]
    · rintro x y ⟨g, hg, rfl⟩ ⟨h, hh, rfl⟩
      exact ⟨g + h, add_mem hg hh, by rw [add_smul]⟩
  · rintro ⟨γ, hγ, rfl⟩
    exact smul_mem_smul hγ (mem_span_singleton_self z)

/-- **Proposition 82:8 (1)** (O'Meara 1963, p. 227). If $L = \mathfrak a_1z_1 + \cdots + \mathfrak a_rz_r$ with
$\mathfrak a_i$ $R$-submodules of $F$ (O'Meara: fractional ideals) and $z_i \in V$, then
$\mathfrak sL = \sum_{i,j}\mathfrak a_i\mathfrak a_jB(z_i, z_j)$. -/
@[kb "omeara1963" "§82E, 82:8 (1), p. 227"]
theorem scale_iSup_smul {ι : Type*} (a : ι → Submodule R F) (z : ι → V) :
    scale Q (⨆ i, a i • span R {z i}) = ⨆ i, ⨆ j, a i * a j * span R {bil Q (z i) (z j)} := by
  set L : Submodule R V := ⨆ i, a i • span R {z i} with hL
  set T : Submodule R F := ⨆ i, ⨆ j, a i * a j * span R {bil Q (z i) (z j)} with hT
  have hmem : ∀ i (γ : F), γ ∈ a i → γ • z i ∈ L := fun i γ hγ =>
    mem_iSup_of_mem i (smul_mem_smul hγ (mem_span_singleton_self _))
  apply le_antisymm
  · rw [scale, span_le]
    rintro _ ⟨x, hx, y, hy, rfl⟩
    show bil Q x y ∈ T
    refine Submodule.iSup_induction _ (motive := fun x => bil Q x y ∈ T) hx ?_ ?_ ?_
    · intro i x hx
      obtain ⟨γ, hγ, rfl⟩ := (mem_smul_span_singleton_iff' _ _ _).1 hx
      refine Submodule.iSup_induction _ (motive := fun y => bil Q (γ • z i) y ∈ T) hy ?_ ?_ ?_
      · intro j y hy
        obtain ⟨δ, hδ, rfl⟩ := (mem_smul_span_singleton_iff' _ _ _).1 hy
        show bil Q (γ • z i) (δ • z j) ∈ T
        rw [bil_smul_left, bil_smul_right, ← mul_assoc]
        exact mem_iSup_of_mem i (mem_iSup_of_mem j
          (mul_mem_mul (mul_mem_mul hγ hδ) (mem_span_singleton_self _)))
      · simp [bil]
      · intro u v hu hv; rw [bil_add_right]; exact add_mem hu hv
    · simp [bil]
    · intro u v hu hv; rw [bil_add_left]; exact add_mem hu hv
  · refine iSup_le fun i => iSup_le fun j => ?_
    rw [Submodule.mul_le]
    intro m hm n hn
    obtain ⟨c, rfl⟩ := mem_span_singleton.1 hn
    rw [mul_smul_comm]
    refine (scale Q L).smul_mem c ?_
    refine Submodule.mul_induction_on hm (fun α hα β hβ => ?_) (fun u v hu hv => ?_)
    · have := bil_mem_scale Q (hmem i α hα) (hmem j β hβ)
      rw [bil_smul_left, bil_smul_right, ← mul_assoc] at this
      exact this
    · rw [add_mul]; exact add_mem hu hv

/-- **Proposition 82:8 (2)** (O'Meara 1963, pp. 227–228). If $L = \mathfrak a_1z_1 + \cdots + \mathfrak a_rz_r$ with
fractional ideals $\mathfrak a_i$ (here any $R$-submodules of $F$, and any number of them) and $z_i \in V$, then
$\mathfrak nL = \sum_i\mathfrak a_i^2Q(z_i) + 2\,\mathfrak sL$. -/
@[kb "omeara1963" "§82E, 82:8 (2), pp. 227–228"]
theorem normIdeal_iSup_smul {ι : Type*} (a : ι → Submodule R F) (z : ι → V) :
    normIdeal Q (⨆ i, a i • span R {z i}) =
      (⨆ i, a i ^ 2 * span R {Q (z i)}) ⊔ span R {2} * scale Q (⨆ i, a i • span R {z i}) := by
  set L : Submodule R V := ⨆ i, a i • span R {z i} with hL
  set N : Submodule R F :=
    (⨆ i, a i ^ 2 * span R {Q (z i)}) ⊔ span R {2} * scale Q L with hN
  have hmem : ∀ i (γ : F), γ ∈ a i → γ • z i ∈ L := fun i γ hγ =>
    mem_iSup_of_mem i (smul_mem_smul hγ (mem_span_singleton_self _))
  apply le_antisymm
  · rw [normIdeal, span_le]
    rintro _ ⟨x, hx, rfl⟩
    have key : x ∈ L ∧ Q x ∈ N := by
      refine Submodule.iSup_induction _ (motive := fun x => x ∈ L ∧ Q x ∈ N) hx ?_ ?_ ?_
      · intro i x hx
        obtain ⟨γ, hγ, rfl⟩ := (mem_smul_span_singleton_iff' _ _ _).1 hx
        refine ⟨hmem i γ hγ, mem_sup_left (mem_iSup_of_mem i ?_)⟩
        rw [Q_smul, pow_two γ, pow_two (a i)]
        exact mul_mem_mul (mul_mem_mul hγ hγ) (mem_span_singleton_self _)
      · exact ⟨zero_mem _, by simp⟩
      · rintro u v ⟨hu, hu'⟩ ⟨hv, hv'⟩
        refine ⟨add_mem hu hv, ?_⟩
        rw [Q_add]
        exact add_mem (add_mem hu' (mem_sup_right
          (mul_mem_mul (mem_span_singleton_self 2) (bil_mem_scale Q hu hv)))) hv'
    exact key.2
  · refine sup_le (iSup_le fun i => ?_) ?_
    · rw [Submodule.mul_le]
      intro m hm n hn
      obtain ⟨c, rfl⟩ := mem_span_singleton.1 hn
      rw [mul_smul_comm]
      refine (normIdeal Q L).smul_mem c ?_
      rw [← span_sq_eq_sq (R := R) (a i)] at hm
      refine span_induction (p := fun m _ => m * Q (z i) ∈ normIdeal Q L) ?_ (by simp) ?_ ?_ hm
      · rintro _ ⟨γ, hγ, rfl⟩
        have := Q_mem_normIdeal Q (hmem i γ hγ)
        rw [Q_smul] at this
        exact this
      · intro u v _ _ hu hv; rw [add_mul]; exact add_mem hu hv
      · intro r u _ hu; rw [smul_mul_assoc]; exact smul_mem _ r hu
    · rw [Submodule.mul_le]
      intro m hm n hn
      obtain ⟨c, rfl⟩ := mem_span_singleton.1 hm
      rw [smul_mul_assoc]
      exact smul_mem _ c (two_mul_mem_normIdeal Q hn)

/-- **Corollary 82:8a, scale** (O'Meara 1963, p. 228): $\mathfrak s(\mathfrak aL) = \mathfrak a^2\,\mathfrak sL$ for a
fractional ideal $\mathfrak a$ (here any $R$-submodule of $F$). -/
@[kb "omeara1963" "§82E, 82:8a, p. 228 (s(aL) = a² sL)"]
theorem scale_smul (a : Submodule R F) (L : Submodule R V) : scale Q (a • L) = a ^ 2 * scale Q L := by
  set T : Submodule R F := a ^ 2 * scale Q L with hT
  apply le_antisymm
  · rw [scale, span_le]
    rintro _ ⟨x, hx, y, hy, rfl⟩
    show bil Q x y ∈ T
    refine Submodule.smul_induction_on (p := fun x => bil Q x y ∈ T) hx
      (fun α hα l hl => ?_) (fun u v hu hv => ?_)
    · refine Submodule.smul_induction_on (p := fun y => bil Q (α • l) y ∈ T) hy
        (fun β hβ m hm => ?_) (fun u v hu hv => ?_)
      · show bil Q (α • l) (β • m) ∈ T
        rw [bil_smul_left, bil_smul_right, ← mul_assoc]
        exact mul_mem_mul (by rw [pow_two]; exact mul_mem_mul hα hβ) (bil_mem_scale Q hl hm)
      · rw [bil_add_right]; exact add_mem hu hv
    · rw [bil_add_left]; exact add_mem hu hv
  · rw [hT, pow_two, Submodule.mul_le]
    intro m hm n hn
    rw [scale] at hn
    refine span_induction (p := fun n _ => m * n ∈ scale Q (a • L)) ?_ (by simp) ?_ ?_ hn
    · rintro _ ⟨l, hl, l', hl', rfl⟩
      refine Submodule.mul_induction_on hm (fun α hα β hβ => ?_) (fun u v hu hv => ?_)
      · have := bil_mem_scale Q (smul_mem_smul hα hl) (smul_mem_smul hβ hl')
        rw [bil_smul_left, bil_smul_right, ← mul_assoc] at this
        exact this
      · rw [add_mul]; exact add_mem hu hv
    · intro u v _ _ hu hv; rw [mul_add]; exact add_mem hu hv
    · intro r u _ hu; rw [mul_smul_comm]; exact smul_mem _ r hu

/-- **Corollary 82:8a, norm** (O'Meara 1963, p. 228): $\mathfrak n(\mathfrak aL) = \mathfrak a^2\,\mathfrak nL$ for a
fractional ideal $\mathfrak a$ (here any $R$-submodule of $F$) and a lattice $L$. -/
@[kb "omeara1963" "§82E, 82:8a, p. 228 (n(aL) = a² nL)"]
theorem normIdeal_smul (a : Submodule R F) {L : Submodule R V} (hL : L.FG) :
    normIdeal Q (a • L) = a ^ 2 * normIdeal Q L := by
  classical
  obtain ⟨s, hs⟩ := hL
  let z : s → V := fun i => (i : V)
  have hrange : Set.range z = (s : Set V) := by ext x; simp [z]
  have hL' : L = ⨆ i : s, span R {z i} := by
    rw [← span_range_eq_iSup, hrange, hs]
  have h1 := normIdeal_iSup_smul Q (fun _ : s => (1 : Submodule R F)) z
  have h2 := normIdeal_iSup_smul Q (fun _ : s => a) z
  have hone_smul : ∀ M : Submodule R V, (1 : Submodule R F) • M = M := by
    intro M
    apply le_antisymm
    · rw [Submodule.smul_le]
      intro r hr n hn
      obtain ⟨c, rfl⟩ := Submodule.mem_one.1 hr
      rw [algebraMap_smul]; exact M.smul_mem c hn
    · intro n hn
      simpa using smul_mem_smul (Submodule.one_le.1 le_rfl : (1 : F) ∈ (1 : Submodule R F)) hn
  simp only [hone_smul, one_pow, one_mul] at h1
  rw [← hL'] at h1
  rw [← smul_iSup, ← hL'] at h2
  rw [h2, h1, scale_smul Q a L, Submodule.mul_sup, Submodule.mul_iSup]
  exact congrArg₂ _ rfl (by ring)

end Scale

end QuadFormsKB.OMeara
