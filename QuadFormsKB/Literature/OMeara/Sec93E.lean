/-
# O'Meara §93E–§93F: the fundamental invariants of a lattice over a dyadic field, and the statement of 93:28

**Setting** (as in `Sec93Gap2.lean`): $R$ a discrete valuation ring with fraction field $F$, $2 \in F^\times$; O'Meara's
§93 takes $F$ a dyadic local field, which is the hypothesis `¬ IsUnit (2 : R)` together with `[HenselianLocalRing R]`
and `[Finite (ResidueField R)]` where a proof needs them. $(V, Q)$ is a quadratic space over $F$, O'Meara's $B$ is
`bil Q`, lattices are `Submodule R V`, and a Jordan splitting $L = L_1 \perp \cdots \perp L_t$ is
`IsJordanSplitting Q L Ls` with `Ls : Fin t → Submodule R V`. **Indices are $0$-based**: O'Meara's $L_i$,
$\mathfrak s_i$, $\mathfrak g_i$, $\mathfrak w_i$, $a_i$ ($1 \le i \le t$) are the values at `i - 1 : Fin t`, and his
$\mathfrak f_i$ ($1 \le i \le t - 1$) is `fIdeal Q L Ls (i - 1) i`.

**Defines** (O'Meara 1963, §93E, pp. 262–264, and §93F, p. 268)
* `fundSub Q L Ls i` $= L^{\mathfrak s_i}$, the sublattice of §82I for the scale $\mathfrak s_i = \mathfrak sL_i$;
* `fundNormGroup` ($\mathfrak g_i = \mathfrak gL^{\mathfrak s_i}$), `fundWeight` ($\mathfrak w_i = \mathfrak wL^{\mathfrak
  s_i}$), `fundNormIdeal` ($\mathfrak nL^{\mathfrak s_i} = a_i\mathfrak o$), `IsFundNormGenerators` (the $a_i$);
* `SameFundamentalType` (p. 263) and `SameFundamentalInvariants` (p. 264);
* `fIdealOf`, `fIdeal`: the ideals $\mathfrak f_i$ (p. 264);
* `IsSaturated` (p. 264): saturated Jordan splittings;
* `SpanRepresents Q M N c`: $FM \to FN \perp \langle c\rangle$, and `DiscQuotSqEquivMod Q M N 𝔞`:
  $dM/dN \cong 1 \bmod \mathfrak a$ (the conditions of 93:28);
* the named statement `DyadicClassification` (**Theorem 93:28**, pp. 267–268), derived from its named core in
  `Sec93FMain.lean`.
-/
import QuadFormsKB.Literature.OMeara.Sec93Gap3
import QuadFormsKB.Literature.OMeara.Sec93C
import QuadFormsKB.Literature.OMeara.Sec91Type

open QuadraticMap Submodule Module IsLocalRing
open scoped Pointwise

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.OMeara

section Defs

variable {R : Type*} [CommRing R] [IsLocalRing R] {F : Type*} [Field F] [Algebra R F] [Invertible (2 : F)]
variable {V : Type*} [AddCommGroup V] [Module F V] [Module R V] [IsScalarTower R F V]
variable {V' : Type*} [AddCommGroup V'] [Module F V'] [Module R V'] [IsScalarTower R F V']
variable (Q : QuadraticForm F V) (Q' : QuadraticForm F V')

/-- **The lattice $L^{\mathfrak s_i}$** (O'Meara 1963, §93E, p. 263): for a Jordan splitting
$L = L_1 \perp \cdots \perp L_t$ and the fundamental scale $\mathfrak s_i = \mathfrak sL_i$, the sublattice
$L^{\mathfrak s_i} = \{x \in L : B(x, L) \subseteq \mathfrak s_i\}$ of §82I (`subA`). (`i` is $0$-based.) -/
@[kb "omeara1963" "§93E, p. 263 (the lattices L^{s_i})"]
def fundSub (L : Submodule R V) {t : ℕ} (Ls : Fin t → Submodule R V) (i : Fin t) : Submodule R V :=
  subA Q (scale Q (Ls i)) L

/-- **The fundamental norm group** $\mathfrak g_i = \mathfrak gL^{\mathfrak s_i}$ (O'Meara 1963, §93E, p. 263). -/
@[kb "omeara1963" "§93E, p. 263 (fundamental norm groups g_i = gL^{s_i})"]
def fundNormGroup (L : Submodule R V) {t : ℕ} (Ls : Fin t → Submodule R V) (i : Fin t) : AddSubgroup F :=
  normGroup Q (fundSub Q L Ls i)

/-- **The fundamental weight** $\mathfrak w_i = \mathfrak wL^{\mathfrak s_i}$ (O'Meara 1963, §93E, p. 263). -/
@[kb "omeara1963" "§93E, p. 263 (fundamental weights w_i = wL^{s_i})"]
def fundWeight (L : Submodule R V) {t : ℕ} (Ls : Fin t → Submodule R V) (i : Fin t) : Submodule R F :=
  weight Q (fundSub Q L Ls i)

/-- **The norm $\mathfrak nL^{\mathfrak s_i}$** (O'Meara 1963, §93E, p. 263): the ideal $a_i\mathfrak o$ generated by
any fundamental norm generator $a_i$. -/
def fundNormIdeal (L : Submodule R V) {t : ℕ} (Ls : Fin t → Submodule R V) (i : Fin t) : Submodule R F :=
  normIdeal Q (fundSub Q L Ls i)

/-- **Fundamental norm generators** $a_1, \dots, a_t$ (O'Meara 1963, §93E, p. 263): $a_i$ is a norm generator of
$L^{\mathfrak s_i}$ for every $i$. -/
@[kb "omeara1963" "§93E, p. 263 (fundamental norm generators a_i)"]
def IsFundNormGenerators (L : Submodule R V) {t : ℕ} (Ls : Fin t → Submodule R V) (a : Fin t → F) : Prop :=
  ∀ i, IsNormGenerator Q (fundSub Q L Ls i) (a i)

/-- **Same fundamental type** (O'Meara 1963, §93E, p. 263): for Jordan splittings $L = L_1 \perp \cdots \perp L_t$
and $L' = L_1' \perp \cdots \perp L_{t'}'$ (in quadratic spaces over the same field), $t = t'$ and
$\dim L_i = \dim L_i'$, $\mathfrak s_i = \mathfrak s_i'$, $\mathfrak g_i = \mathfrak g_i'$ for all $i$. -/
@[kb "omeara1963" "§93E, pp. 263–264 (lattices of the same fundamental type)"]
def SameFundamentalType (L : Submodule R V) (L' : Submodule R V') {t t' : ℕ} (Ls : Fin t → Submodule R V)
    (Ks : Fin t' → Submodule R V') : Prop :=
  ∃ h : t = t', ∀ i : Fin t, finrank R (Ls i) = finrank R (Ks (Fin.cast h i)) ∧
    scale Q (Ls i) = scale Q' (Ks (Fin.cast h i)) ∧
    fundNormGroup Q L Ls i = fundNormGroup Q' L' Ks (Fin.cast h i)

/-- **The same set of fundamental invariants** (O'Meara 1963, §93E, p. 264): $L$ and $L'$ are of the same
fundamental type and the scalars $a_1, \dots, a_t$ are fundamental norm generators of both. -/
@[kb "omeara1963" "§93E, p. 264 (the same set of fundamental invariants)"]
def SameFundamentalInvariants (L : Submodule R V) (L' : Submodule R V') {t : ℕ} (Ls : Fin t → Submodule R V)
    (Ks : Fin t → Submodule R V') (a : Fin t → F) : Prop :=
  SameFundamentalType Q Q' L L' Ls Ks ∧ IsFundNormGenerators Q L Ls a ∧ IsFundNormGenerators Q' L' Ks a

/-- **Saturated Jordan splitting** (O'Meara 1963, §93E, p. 264): a Jordan splitting $L = L_1 \perp \cdots \perp L_t$
with $\mathfrak gL_i = \mathfrak g_i$ for every $i$. -/
@[kb "omeara1963" "§93E, p. 264 (saturated Jordan splitting)"]
def IsSaturated (L : Submodule R V) {t : ℕ} (Ls : Fin t → Submodule R V) : Prop :=
  IsJordanSplitting Q L Ls ∧ ∀ i, normGroup Q (Ls i) = fundNormGroup Q L Ls i

end Defs

section FIdeal

variable (R : Type*) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] {F : Type*} [Field F] [Algebra R F]
  [IsFractionRing R F]

/-- **The ideal $\mathfrak f$ attached to consecutive fundamental invariants** (O'Meara 1963, §93E, p. 264). With
$\mathfrak s = \mathfrak s_i$, $\mathfrak g = \mathfrak g_i$, $\mathfrak g' = \mathfrak g_{i+1}$,
$\mathfrak n = a_i\mathfrak o$, $\mathfrak n' = a_{i+1}\mathfrak o$, O'Meara defines $\mathfrak f_i$ by
$$\mathfrak s_i^2\mathfrak f_i = \sum_{\alpha \in \mathfrak g_i,\ \beta \in \mathfrak g_{i+1}} \mathfrak d(\alpha\beta)
\quad (u_i + u_{i+1} \text{ odd}), \qquad
\mathfrak s_i^2\mathfrak f_i = \sum \mathfrak d(\alpha\beta) + 2\mathfrak p^{\frac12(u_i + u_{i+1}) + s_i}
\quad (u_i + u_{i+1} \text{ even}),$$
$u_i = \operatorname{ord}_\mathfrak p a_i$, $s_i = \operatorname{ord}_\mathfrak p \mathfrak s_i$, $\mathfrak d$ the
quadratic defect (`quadDefect`). Here both cases are one formula: the ideal $\mathfrak c$ spanned by the $z \in F$
with $(z\mathfrak o)^2 = \mathfrak n\mathfrak n'$ is $\mathfrak p^{\frac12(u_i + u_{i+1})}$ when $u_i + u_{i+1}$ is
even and $0$ when it is odd, and $2\mathfrak p^{\frac12(u_i+u_{i+1}) + s_i} = 2\,\mathfrak c\,\mathfrak s_i$; then
$\mathfrak f = (\sum\mathfrak d(\alpha\beta) + 2\mathfrak c\mathfrak s) / \mathfrak s^2$ (`Submodule` division, the
inverse of multiplication by the invertible ideal $\mathfrak s^2$; `mul_fIdealOf` is O'Meara's defining equation). -/
@[kb "omeara1963" "§93E, p. 264 (the ideals f_i)"]
def fIdealOf (s : Submodule R F) (g g' : AddSubgroup F) (n n' : Submodule R F) : Submodule R F :=
  ((⨆ (α : F) (_ : α ∈ g) (β : F) (_ : β ∈ g'), quadDefect R (α * β)) ⊔
      (2 : F) • (span R {z : F | (R ∙ z) * (R ∙ z) = n * n'} * s)) / (s * s)

variable {R}
variable [Invertible (2 : F)] {V : Type*} [AddCommGroup V] [Module F V] [Module R V] [IsScalarTower R F V]
variable (Q : QuadraticForm F V)

/-- **The ideals $\mathfrak f_i$** (O'Meara 1963, §93E, p. 264) of a lattice $L$ with Jordan splitting `Ls`:
`fIdeal Q L Ls i j` is `fIdealOf` for the fundamental invariants of indices `i` and `j`; O'Meara's $\mathfrak f_i$
($1 \le i \le t-1$, $1$-based) is `fIdeal Q L Ls (i-1) i` ($0$-based `i - 1` and `i`). -/
@[kb "omeara1963" "§93E, p. 264 (the ideals f_i)"]
def fIdeal (L : Submodule R V) {t : ℕ} (Ls : Fin t → Submodule R V) (i j : Fin t) : Submodule R F :=
  fIdealOf R (scale Q (Ls i)) (fundNormGroup Q L Ls i) (fundNormGroup Q L Ls j) (fundNormIdeal Q L Ls i)
    (fundNormIdeal Q L Ls j)

end FIdeal

section Conditions

variable {R : Type*} [CommRing R] {F : Type*} [Field F] [Algebra R F] [Invertible (2 : F)]
variable {V : Type*} [AddCommGroup V] [Module F V] [Module R V] [IsScalarTower R F V]
variable (Q : QuadraticForm F V)

/-- **$FM \to FN \perp \langle c\rangle$** (O'Meara 1963, §93F, 93:28 (ii), (iii), p. 268; representations of
quadratic spaces, §63B): the quadratic space $FM$ is represented by the orthogonal sum of the quadratic space $FN$ and
a line $\langle c\rangle$ (a vector $e$ with $Q(e) = c$), i.e. there is an injective $F$-linear map
$f : FM \to FN \times F$ with $Q(f_1(x)) + c\,f_2(x)^2 = Q(x)$. Here $M$, $N$ are lattices in the same space $V$. -/
@[kb "omeara1963" "§93F, 93:28, p. 268 (FL_(i) → FK_(i) ⊥ ⟨a⟩)"]
def SpanRepresents (M N : Submodule R V) (c : F) : Prop :=
  ∃ f : span F (M : Set V) →ₗ[F] span F (N : Set V) × F, Function.Injective f ∧
    ∀ x, Q ((f x).1 : V) + c * (f x).2 ^ 2 = Q (x : V)

/-- **$dM/dN \cong 1 \bmod \mathfrak a$** (O'Meara 1963, §93F, 93:28 (i), p. 268, with the notation of p. 250 and
93:2): there are bases $x_1, \dots, x_m$ of $M$ and $y_1, \dots, y_k$ of $N$ with
$d(x_1, \dots, x_m)/d(y_1, \dots, y_k) \cong 1 \bmod \mathfrak a$ (`SqEquivMod`). -/
@[kb "omeara1963" "§93F, 93:28 (i), p. 268 (dL_(i)/dK_(i) ≅ 1 mod f_i)"]
def DiscQuotSqEquivMod (M N : Submodule R V) (a : Submodule R F) : Prop :=
  ∃ b : Basis (Fin (finrank R M)) R M, ∃ b' : Basis (Fin (finrank R N)) R N,
    SqEquivMod a ((gram Q fun i => (b i : V)).det / (gram Q fun i => (b' i : V)).det) 1

end Conditions

section Classification

variable (R : Type*) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] [HenselianLocalRing R]
  [Finite (ResidueField R)] {F : Type*} [Field F] [Algebra R F] [IsFractionRing R F] [Invertible (2 : F)]
variable {V : Type*} [AddCommGroup V] [Module F V] [Module R V] [IsScalarTower R F V] [FiniteDimensional F V]
variable (Q : QuadraticForm F V)

/-- **Theorem 93:28** (O'Meara 1963, §93F, pp. 267–268), *named statement* (assumed, not proved here). Let $L$ and $K$
be lattices on a regular quadratic space $V$ over a dyadic local field $F$, with Jordan splittings
$L = L_1 \perp \cdots \perp L_t$, $K = K_1 \perp \cdots \perp K_t$ and the same set of fundamental invariants
$t, \dim L_i, \mathfrak s_i, \mathfrak w_i, a_i$, and let $L_{(1)} \subset \cdots \subset L_{(t)}$,
$K_{(1)} \subset \cdots \subset K_{(t)}$ be the Jordan chains. Then $\operatorname{cls} L = \operatorname{cls} K$ if
and only if for $1 \le i \le t-1$:
1. $dL_{(i)}/dK_{(i)} \cong 1 \bmod \mathfrak f_i$;
2. $FL_{(i)} \to FK_{(i)} \perp \langle a_{i+1}\rangle$ when $\mathfrak f_i \subsetneq 4a_{i+1}\mathfrak w_{i+1}^{-1}$;
3. $FL_{(i)} \to FK_{(i)} \perp \langle a_i\rangle$ when $\mathfrak f_i \subsetneq 4a_i\mathfrak w_i^{-1}$.

Indices are $0$-based here: the condition for O'Meara's $i$ is stated for the pair `i`, `j` with `j = i + 1`
($0$-based), $L_{(i)}$ is `jordanChain Ls i`, $\mathfrak f_i$ is `fIdeal Q L Ls i j`, and
$4a\mathfrak w^{-1}$ is `4 * a • (1 / w)` (`Submodule` division). O'Meara's "$\subset$" is strict inclusion. The local
field is a Henselian discrete valuation ring with finite residue field and $2$ not a unit; "regular" is the
nondegeneracy of the polar form. *Status:* derived from the smaller named statement
`Suff28.SuffCore` (O'Meara's steps 4–8 of the sufficiency) in `Main28.dyadicClassification_of_core` and, over
completions of number fields, `Main28.dyadicClassification_nf` (`Sec93FMain.lean`); the necessity is proved outright
(`Main28.necessity`). -/
@[kb "omeara1963" "§93F, 93:28, pp. 267–268"]
structure DyadicClassification : Prop where
  cls_eq_iff : ¬ IsUnit (2 : R) → (QuadraticMap.associated Q).Nondegenerate →
    ∀ (L K : Submodule R V) [L.IsLattice F] [K.IsLattice F] {t : ℕ} (Ls Ks : Fin t → Submodule R V)
      (a : Fin t → F), IsJordanSplitting Q L Ls → IsJordanSplitting Q K Ks →
      SameFundamentalInvariants Q Q L K Ls Ks a →
      (cls Q L = cls Q K ↔ ∀ i j : Fin t, (j : ℕ) = i + 1 →
        DiscQuotSqEquivMod Q (jordanChain Ls i) (jordanChain Ks i) (fIdeal Q L Ls i j) ∧
        (fIdeal Q L Ls i j < (4 * a j) • (1 / fundWeight Q L Ls j) →
          SpanRepresents Q (jordanChain Ls i) (jordanChain Ks i) (a j)) ∧
        (fIdeal Q L Ls i j < (4 * a i) • (1 / fundWeight Q L Ls i) →
          SpanRepresents Q (jordanChain Ls i) (jordanChain Ks i) (a i)))

end Classification

end QuadFormsKB.OMeara
