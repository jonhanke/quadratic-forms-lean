/-
# O'Meara §81E: the localization of a fractional ideal is its closure (81:13)

**Setting.** $F$ a number field with ring of integers $\mathfrak o = \mathcal O_F$, $\mathfrak p$ a nonzero prime
(`v : HeightOneSpectrum (𝓞 F)`), $F_\mathfrak p$ = `v.adicCompletion F` with its valuation `Valued.v` (which restricts
to the $\mathfrak p$-adic valuation `v.valuation F` on $F$), $\mathfrak o_\mathfrak p$ = `v.adicCompletionIntegers F`.
A fractional ideal $\mathfrak a$ is an $\mathfrak o$-submodule of $F$ (`Submodule (𝓞 F) F`). O'Meara (§81E, p. 217)
writes $\mathfrak a_\mathfrak p$ for the $\mathfrak o_\mathfrak p$-ideal generated by $\mathfrak a$ and notes
$\mathfrak a_\mathfrak p = \{x \in F_\mathfrak p : |x|_\mathfrak p \le |\mathfrak a|_\mathfrak p\}$, where
$|\mathfrak a|_\mathfrak p$ is the largest value $|a|_\mathfrak p$, $a \in \mathfrak a$; that description is the one
used here.

**Proves**
* `closure_image_eq_closedBall` (**81:13**): if $a_0 \in \mathfrak a$ has the largest valuation $|a_0|_\mathfrak p =
  |\mathfrak a|_\mathfrak p$, the closure of $\mathfrak a$ in $F_\mathfrak p$ is
  $\{x \in F_\mathfrak p : |x|_\mathfrak p \le |a_0|_\mathfrak p\} = \mathfrak a_\mathfrak p$;
* `subset_closure_integers` : $\mathfrak o_\mathfrak p$ is contained in the closure of $\mathfrak o$ (the case
  $\mathfrak a = \mathfrak o$, used in the proof).

**Proof notes.** The ball is closed (it is a closed metric ball for the norm of $F_\mathfrak p$). Conversely $F$ is dense
in $F_\mathfrak p$ (`HeightOneSpectrum.denseRange_algebraMap`), so the $\mathfrak p$-integral elements of $F$ are dense in
$\mathfrak o_\mathfrak p$, and $\mathfrak o$ is $\mathfrak p$-adically dense in them
(`HeightOneSpectrum.exists_valuation_sub_lt_of_integer`); multiplying by $a_0$ gives the general case. O'Meara proves only
the closedness explicitly; the density is implicit in his use of the closure.
-/
import Mathlib
import QuadFormsKB.Citation

open IsDedekindDomain NumberField Topology

noncomputable section

namespace QuadFormsKB.OMeara

variable {F : Type*} [Field F] [NumberField F] (v : HeightOneSpectrum (𝓞 F))

local notation "Fv" => v.adicCompletion F

private theorem valued_ι (x : F) : Valued.v (algebraMap F Fv x) = v.valuation F x :=
  HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v x

/-- The $\mathfrak p$-integral elements of $F$ lie in the closure of $\mathfrak o$ in $F_\mathfrak p$. -/
private theorem mem_closure_int {y : F} (hy : v.valuation F y ≤ 1) :
    algebraMap F Fv y ∈ closure (algebraMap F Fv '' Set.range (algebraMap (𝓞 F) F)) := by
  rw [Metric.mem_closure_iff]
  intro ε hε
  obtain ⟨π, hπ⟩ := v.valuation_exists_uniformizer F
  have hπ1 : ‖algebraMap F Fv π‖ < 1 := by
    rw [Valued.toNormedField.norm_lt_one_iff, valued_ι, hπ]
    exact WithZero.exp_lt_exp.mpr (by norm_num)
  obtain ⟨k, hk⟩ := exists_pow_lt_of_lt_one hε hπ1
  have hπ0 : v.valuation F (π ^ k) ≠ 0 := by
    rw [map_pow, hπ]; exact pow_ne_zero _ WithZero.exp_ne_zero
  obtain ⟨a, ha⟩ := v.exists_valuation_sub_lt_of_integer (K := F) hy (Units.mk0 _ hπ0)
  refine ⟨algebraMap F Fv (algebraMap (𝓞 F) F a), ⟨_, ⟨a, rfl⟩, rfl⟩, ?_⟩
  rw [dist_eq_norm]
  calc ‖algebraMap F Fv y - algebraMap F Fv (algebraMap (𝓞 F) F a)‖
      < ‖algebraMap F Fv (π ^ k)‖ := by
        rw [Valued.toNormedField.norm_lt_iff, ← map_sub, valued_ι, valued_ι, Valuation.map_sub_swap]
        exact ha
    _ = ‖algebraMap F Fv π‖ ^ k := by rw [map_pow, norm_pow]
    _ < ε := hk

/-- **$\mathfrak o_\mathfrak p$ is contained in the closure of $\mathfrak o$** in $F_\mathfrak p$ (O'Meara 1963, 81:13 for
$\mathfrak a = \mathfrak o$, p. 217): every $t \in F_\mathfrak p$ with $|t|_\mathfrak p \le 1$ is a limit of elements of
$\mathcal O_F$. -/
@[kb "omeara1963" "§81E, 81:13, p. 217 (case a = o: o_p ⊆ closure of o)"]
theorem subset_closure_integers {t : Fv} (ht : Valued.v t ≤ 1) :
    t ∈ closure (algebraMap F Fv '' Set.range (algebraMap (𝓞 F) F)) := by
  have h1 : t ∈ closure (algebraMap F Fv '' {y : F | v.valuation F y ≤ 1}) := by
    rw [Metric.mem_closure_iff]
    intro ε hε
    obtain ⟨y, hy⟩ := Metric.denseRange_iff.mp (HeightOneSpectrum.denseRange_algebraMap F v) t (min ε 1)
      (lt_min hε one_pos)
    refine ⟨algebraMap F Fv y, ⟨y, ?_, rfl⟩, lt_of_lt_of_le hy (min_le_left _ _)⟩
    have h2 : ‖t - algebraMap F Fv y‖ < 1 := by
      rw [← dist_eq_norm]; exact lt_of_lt_of_le hy (min_le_right _ _)
    rw [Valued.toNormedField.norm_lt_one_iff] at h2
    show v.valuation F y ≤ 1
    rw [← valued_ι]
    have : algebraMap F Fv y = t - (t - algebraMap F Fv y) := by ring
    rw [this]
    exact (Valuation.map_sub _ _ _).trans (max_le ht h2.le)
  refine closure_minimal ?_ isClosed_closure h1
  rintro _ ⟨y, hy, rfl⟩
  exact mem_closure_int v hy

/-- **Proposition 81:13** (O'Meara 1963, p. 217): for a fractional ideal $\mathfrak a$ of $F$ and an element
$a_0 \in \mathfrak a$ of largest $\mathfrak p$-adic absolute value ($|a|_\mathfrak p \le |a_0|_\mathfrak p$ for all
$a \in \mathfrak a$), the closure of $\mathfrak a$ in $F_\mathfrak p$ is
$$\overline{\mathfrak a} = \{x \in F_\mathfrak p : |x|_\mathfrak p \le |a_0|_\mathfrak p\} = \mathfrak a_\mathfrak p .$$ -/
@[kb "omeara1963" "§81E, 81:13, p. 217"]
theorem closure_image_eq_closedBall (I : Submodule (𝓞 F) F) {a₀ : F} (ha₀ : a₀ ∈ I)
    (hmax : ∀ a ∈ I, v.valuation F a ≤ v.valuation F a₀) :
    closure (algebraMap F Fv '' I) = {x : Fv | Valued.v x ≤ Valued.v (algebraMap F Fv a₀)} := by
  have hball : {x : Fv | Valued.v x ≤ Valued.v (algebraMap F Fv a₀)} =
      Metric.closedBall 0 ‖algebraMap F Fv a₀‖ := by
    ext x
    simp only [Set.mem_ofPred_eq, Metric.mem_closedBall, dist_zero_right]
    exact Valued.toNormedField.norm_le_iff.symm
  apply le_antisymm
  · rw [hball]
    refine closure_minimal ?_ Metric.isClosed_closedBall
    rintro _ ⟨a, ha, rfl⟩
    rw [← hball]
    show Valued.v (algebraMap F Fv a) ≤ _
    rw [valued_ι, valued_ι]
    exact hmax a ha
  · intro x hx
    simp only [Set.mem_ofPred_eq] at hx
    by_cases h0 : a₀ = 0
    · subst h0
      rw [map_zero, map_zero, le_zero_iff, Valuation.zero_iff] at hx
      subst hx
      exact subset_closure ⟨0, I.zero_mem, map_zero _⟩
    · have hι0 : algebraMap F Fv a₀ ≠ 0 := (map_ne_zero _).mpr h0
      set t := x / algebraMap F Fv a₀ with ht
      have htv : Valued.v t ≤ 1 := by
        rw [ht, map_div₀]
        exact div_le_one_of_le₀ hx zero_le
      have hcl := subset_closure_integers v htv
      let f : Fv → Fv := fun z => z * algebraMap F Fv a₀
      have hf : Continuous f := continuous_id.mul continuous_const
      have hxt : x = f t := by simp only [f, ht]; field_simp
      rw [hxt]
      refine closure_mono ?_ (image_closure_subset_closure_image hf ⟨t, hcl, rfl⟩)
      rintro _ ⟨_, ⟨_, ⟨b, rfl⟩, rfl⟩, rfl⟩
      refine ⟨algebraMap (𝓞 F) F b * a₀, ?_, by simp [f]⟩
      have := I.smul_mem b ha₀
      rwa [Algebra.smul_def] at this

end QuadFormsKB.OMeara
