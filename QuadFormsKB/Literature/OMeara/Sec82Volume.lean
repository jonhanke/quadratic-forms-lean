/-
# O'Meara §82E: the volume over a Dedekind domain

**Setting.** $R$ is a Dedekind domain with fraction field $F$, $2 \in F^\times$ (`Invertible (2 : F)`), and $(V, Q)$
is a quadratic space over $F$ with O'Meara's bilinear form $B$ = `bil Q` ($B(x, x) = Q(x)$). Lattices, fractional
ideals and $\mathfrak aL$ are as in `Sec81.lean`. The scale $\mathfrak sL$ (`scale`), the norm $\mathfrak nL$
(`normIdeal`) and the volume $\mathfrak vL$ (`volume`) are the definitions of `Sec82.lean`; there the volume is the
$R$-module generated by the discriminants of all $r$-tuples of vectors of $L$ ($r = \operatorname{rank} L$), and
`volume_eq_of_adapted` below shows that this is O'Meara's $\mathfrak a_1^2 \cdots \mathfrak a_r^2\,d(x_1, \dots, x_r)$
for every adaptation $L = \mathfrak a_1x_1 + \cdots + \mathfrak a_rx_r$ (so the definition agrees with O'Meara's, which
he shows to be well defined using 81:8).

Results of §82 already proved over a discrete valuation ring in `Sec82.lean`–`Sec91*.lean` are proved here for a
Dedekind domain in the namespace `QuadFormsKB.OMeara.Dedekind`.

**Proves** (O'Meara 1963, §82E, pp. 229–230; 82:8 and 82:8a are in `Sec82Scale.lean`):
* `volume_eq_of_adapted` (the volume of an adaptation, §82E, p. 229), `volume_eq_bot_iff` ($\mathfrak vL = 0$ if and
  only if $L$ is not regular, p. 229), `Dedekind.volume_eq_mul_of_isOrthSum` ($\mathfrak v(J \perp K) =
  \mathfrak vJ\,\mathfrak vK$, p. 229);
* `volume_le_scale_pow` (**82:10**);
* `exists_volume_eq_sq_mul` (**82:11**, with the ideal $\mathfrak a$ given by adapted bases), `volume_le_of_le`
  (**82:11a**), `eq_of_le_of_volume_eq`;
* `volume_latMap` and `latMap_eq_of_le` (**82:12**).
-/
import QuadFormsKB.Literature.OMeara.Sec82Scale
import QuadFormsKB.Literature.OMeara.Sec81Adapted
import QuadFormsKB.Literature.OMeara.Sec81Change
import QuadFormsKB.Literature.OMeara.Sec91Chain

open QuadraticMap Submodule Module
open scoped Matrix

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.OMeara

section Volume

variable {R : Type*} [CommRing R] [IsDedekindDomain R] {F : Type*} [Field F] [Algebra R F]
  [IsFractionRing R F] [Invertible (2 : F)]
variable {V : Type*} [AddCommGroup V] [Module F V] [Module R V] [IsScalarTower R F V]
variable (Q : QuadraticForm F V)

/-- Membership in an adaptation `⨆ aᵢ • R xᵢ`: coordinates `cᵢ ∈ aᵢ`. -/
theorem mem_iSup_smul_span_iff_exists {ι : Type*} [Fintype ι] (a : ι → Submodule R F) (x : ι → V)
    (v : V) : v ∈ ⨆ i, a i • span R {x i} ↔ ∃ c : ι → F, (∀ i, c i ∈ a i) ∧ v = ∑ i, c i • x i := by
  classical
  constructor
  · intro hv
    refine Submodule.iSup_induction _
      (motive := fun v => ∃ c : ι → F, (∀ i, c i ∈ a i) ∧ v = ∑ i, c i • x i) hv ?_ ?_ ?_
    · intro i v hv
      obtain ⟨γ, hγ, rfl⟩ := (mem_smul_span_singleton_iff' _ _ _).1 hv
      refine ⟨Pi.single i γ, fun j => ?_, ?_⟩
      · by_cases h : j = i
        · subst h; simpa using hγ
        · simp [h]
      · simp [Pi.single_apply]
    · exact ⟨0, fun i => zero_mem _, by simp⟩
    · rintro u w ⟨c, hc, rfl⟩ ⟨c', hc', rfl⟩
      exact ⟨c + c', fun i => add_mem (hc i) (hc' i), by simp [add_smul, Finset.sum_add_distrib]⟩
  · rintro ⟨c, hc, rfl⟩
    exact sum_mem fun i _ => mem_iSup_of_mem i (smul_mem_smul (hc i) (mem_span_singleton_self _))

/-- Coordinates of a vector of an adaptation (independent `x`) lie in the `aᵢ`. -/
theorem coord_mem_of_mem {ι : Type*} [Fintype ι] (a : ι → Submodule R F) (x : ι → V)
    (hx : LinearIndependent F x) (c : ι → F) (h : ∑ i, c i • x i ∈ ⨆ i, a i • span R {x i}) (i : ι) :
    c i ∈ a i := by
  obtain ⟨c', hc', he⟩ := (mem_iSup_smul_span_iff_exists a x _).1 h
  have h0 : ∑ j, (c j - c' j) • x j = 0 := by
    simp only [sub_smul, Finset.sum_sub_distrib]; rw [he]; simp
  have := Fintype.linearIndependent_iff.1 hx _ h0 i
  rw [sub_eq_zero.1 this]; exact hc' i

/-- A non-zero multiple of each `xᵢ` lies in the adaptation. -/
theorem exists_ne_zero_smul_mem_adapted {ι : Type*} (a : ι → Submodule R F) (ha : ∀ i, a i ≠ ⊥)
    (x : ι → V) (i : ι) : ∃ α : F, α ≠ 0 ∧ α • x i ∈ ⨆ j, a j • span R {x j} := by
  obtain ⟨α, hα, hα0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot (ha i)
  refine ⟨α, hα0, mem_iSup_of_mem i ?_⟩
  simpa using smul_mem_smul hα (mem_span_singleton_self (x i))

/-- The `F`-span of an adaptation is the span of the family. -/
theorem span_adapted {ι : Type*} [Fintype ι] (a : ι → Submodule R F) (ha : ∀ i, a i ≠ ⊥) (x : ι → V) :
    span F ((⨆ i, a i • span R {x i} : Submodule R V) : Set V) = span F (Set.range x) := by
  apply le_antisymm
  · rw [span_le]
    intro l hl
    obtain ⟨c, -, rfl⟩ := (mem_iSup_smul_span_iff_exists a x l).1 hl
    exact sum_mem fun i _ => smul_mem _ _ (subset_span ⟨i, rfl⟩)
  · rw [span_le]
    rintro _ ⟨i, rfl⟩
    obtain ⟨α, hα0, hα⟩ := exists_ne_zero_smul_mem_adapted a ha x i
    have : x i = α⁻¹ • (α • x i) := by rw [smul_smul, inv_mul_cancel₀ hα0, one_smul]
    rw [this]
    exact smul_mem _ _ (subset_span hα)

/-- The rank of an adaptation by an independent family is the number of vectors. -/
theorem finrank_adapted {ι : Type*} [Fintype ι] (a : ι → Submodule R F) (ha : ∀ i, a i ≠ ⊥) (x : ι → V)
    (hx : LinearIndependent F x) : finrank R (⨆ i, a i • span R {x i} : Submodule R V) = Fintype.card ι := by
  rw [finrank_eq_finrank_span (F := F), span_adapted a ha x, finrank_span_eq_card hx]

/-- The `F`-matrix of a family `∑ⱼ Tᵢⱼ bⱼ` is `T G Tᵀ`. -/
theorem gram_comb_F {ι κ : Type*} [Fintype κ] (b : κ → V) (T : Matrix ι κ F) :
    gram Q (fun i => ∑ j, T i j • b j) = T * gram Q b * Tᵀ := by
  ext i k
  simp only [gram, Matrix.of_apply, Matrix.mul_apply, Matrix.transpose_apply,
    bil_sum_left, bil_sum_right, bil_smul_left, bil_smul_right, Finset.sum_mul, Finset.mul_sum]
  refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun l _ => ?_
  ring

/-- The volume as generated by determinants of tuples indexed by any `ι` with `|ι| = rank`. -/
theorem volume_eq_span_family (L : Submodule R V) {ι : Type*} [Fintype ι] [DecidableEq ι]
    (h : Fintype.card ι = finrank R L) :
    volume Q L = span R {d | ∃ x : ι → V, (∀ i, x i ∈ L) ∧ (gram Q x).det = d} := by
  let e : ι ≃ Fin (finrank R L) := Fintype.equivFinOfCardEq h
  apply le_antisymm
  · refine span_mono ?_
    rintro _ ⟨t, ht, rfl⟩
    refine ⟨fun i => t (e i), fun i => ht _, ?_⟩
    have : gram Q (fun i => t (e i)) = (gram Q t).submatrix e e := by ext i j; simp [gram]
    rw [this, Matrix.det_submatrix_equiv_self]
  · refine span_mono ?_
    rintro _ ⟨t, ht, rfl⟩
    refine ⟨fun i => t (e.symm i), fun i => ht _, ?_⟩
    have : gram Q (fun i => t (e.symm i)) = (gram Q t).submatrix e.symm e.symm := by
      ext i j; simp [gram]
    rw [this, Matrix.det_submatrix_equiv_self]

/-- A product of elements of the `aᵢ` lies in `∏ aᵢ`. -/
theorem prod_mem_prod_submodule {ι : Type*} (s : Finset ι) (a : ι → Submodule R F) (γ : ι → F)
    (h : ∀ i ∈ s, γ i ∈ a i) : ∏ i ∈ s, γ i ∈ ∏ i ∈ s, a i := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert j s hj ih =>
    rw [Finset.prod_insert hj, Finset.prod_insert hj]
    exact mul_mem_mul (h j (Finset.mem_insert_self _ _)) (ih fun i hi => h i (Finset.mem_insert_of_mem hi))

/-- `∏ aᵢ` is spanned by the products `∏ γᵢ` with `γᵢ ∈ aᵢ`. -/
theorem prod_eq_span_prod {ι : Type*} [Fintype ι] (a : ι → Submodule R F) :
    ∏ i, a i = span R {p | ∃ γ : ι → F, (∀ i, γ i ∈ a i) ∧ ∏ i, γ i = p} := by
  classical
  have : ∏ i, a i = ∏ i, span R (a i : Set F) := by simp
  rw [this, Submodule.prod_span]
  congr 1
  ext p
  rw [Set.mem_finsetProd]
  constructor
  · rintro ⟨g, hg, rfl⟩
    exact ⟨g, fun i => hg (Finset.mem_univ i), rfl⟩
  · rintro ⟨g, hg, rfl⟩
    exact ⟨g, fun {i} _ => hg i, rfl⟩

/-- The volume of an adaptation indexed by any finite type. -/
theorem volume_eq_of_adapted_fintype {ι : Type*} [Fintype ι] [DecidableEq ι] (x : ι → V)
    (hx : LinearIndependent F x) (a : ι → Submodule R F) (ha : ∀ i, (a i).FG ∧ a i ≠ ⊥) :
    volume Q (⨆ i, a i • span R {x i}) = (∏ i, a i) ^ 2 * span R {(gram Q x).det} := by
  set L : Submodule R V := ⨆ i, a i • span R {x i} with hL
  have hrk : Fintype.card ι = finrank R L := (finrank_adapted a (fun i => (ha i).2) x hx).symm
  rw [volume_eq_span_family Q L hrk]
  apply le_antisymm
  · rw [span_le]
    rintro _ ⟨t, ht, rfl⟩
    choose C hC hCe using fun k => (mem_iSup_smul_span_iff_exists a x (t k)).1 (ht k)
    have htC : t = fun k => ∑ i, C k i • x i := funext hCe
    have hdet : (gram Q t).det = (Matrix.of C).det ^ 2 * (gram Q x).det := by
      have := gram_comb_F Q x (Matrix.of C)
      simp only [Matrix.of_apply] at this
      rw [htC, this, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose]
      ring
    have h1 : span R {(Matrix.of C).det} * ∏ k : ι, (1 : Submodule R F) ≤ ∏ l, a l := by
      refine span_det_mul_prod_le (Matrix.of C) a (fun _ => 1) fun k l => ?_
      rw [mul_one, span_singleton_le_iff_mem]
      exact hC k l
    have h2 : (Matrix.of C).det ∈ ∏ l, a l := by
      refine h1 ?_
      simp
    rw [hdet]
    exact mul_mem_mul (Submodule.pow_mem_pow _ h2 2) (mem_span_singleton_self _)
  · rw [mul_comm, span_singleton_mul]
    intro t ht
    obtain ⟨m, hm, rfl⟩ := (mem_smul_pointwise_iff_exists _ _ _).1 ht
    rw [prod_eq_span_prod, ← span_sq_image_eq] at hm
    refine span_induction (p := fun m _ => (gram Q x).det • m ∈
      span R {d | ∃ x : ι → V, (∀ i, x i ∈ L) ∧ (gram Q x).det = d}) ?_ ?_ ?_ ?_ hm
    · rintro _ ⟨p, ⟨γ, hγ, rfl⟩, rfl⟩
      refine subset_span ⟨fun i => γ i • x i, fun i => mem_iSup_of_mem i
        (smul_mem_smul (hγ i) (mem_span_singleton_self _)), ?_⟩
      have := gram_comb_F Q x (Matrix.diagonal γ)
      have e : (fun i => γ i • x i) = fun i => ∑ j, Matrix.diagonal γ i j • x j := by
        funext i; simp [Matrix.diagonal_apply]
      rw [e, this, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, Matrix.det_diagonal]
      simp only [smul_eq_mul]
      ring
    · simp
    · intro u v _ _ hu hv
      rw [smul_add]; exact add_mem hu hv
    · intro r u _ hu
      rw [smul_comm]; exact smul_mem _ r hu

/-- **The volume of an adaptation** (O'Meara 1963, §82E, p. 229). If $L = \mathfrak a_1x_1 + \cdots + \mathfrak a_rx_r$
with $x_1, \dots, x_r$ independent and $\mathfrak a_i$ fractional ideals, then
$\mathfrak vL = \mathfrak a_1^2 \cdots \mathfrak a_r^2\,d(x_1, \dots, x_r)$, where
$d(x_1, \dots, x_r) = \det(B(x_i, x_j))$. This is O'Meara's definition of the volume; it shows that the definition
`volume` agrees with it. -/
@[kb "omeara1963" "§82E, p. 229 (vL = a₁² ⋯ a_r² d(x₁, …, x_r))"]
theorem volume_eq_of_adapted {r : ℕ} (x : Fin r → V) (hx : LinearIndependent F x) (a : Fin r → Submodule R F)
    (ha : ∀ i, (a i).FG ∧ a i ≠ ⊥) :
    volume Q (⨆ i, a i • span R {x i}) = (∏ i, a i) ^ 2 * span R {(gram Q x).det} :=
  volume_eq_of_adapted_fintype Q x hx a ha

/-- `B(∑ cᵢ xᵢ, xⱼ)` is the `j`-th entry of `c G`. -/
theorem bil_sum_smul_left {ι : Type*} [Fintype ι] (c : ι → F) (x : ι → V) (j : ι) :
    bil Q (∑ i, c i • x i) (x j) = (c ᵥ* gram Q x) j := by
  simp [bil_sum_left, bil_smul_left, Matrix.vecMul, dotProduct, gram]

/-- An adaptation by an independent family is regular iff the discriminant of the family is non-zero. -/
theorem isRegular_adapted_iff {ι : Type*} [Fintype ι] [DecidableEq ι] (x : ι → V)
    (hx : LinearIndependent F x) (a : ι → Submodule R F) (ha : ∀ i, a i ≠ ⊥) :
    IsRegular Q (⨆ i, a i • span R {x i}) ↔ (gram Q x).det ≠ 0 := by
  set L : Submodule R V := ⨆ i, a i • span R {x i} with hL
  have htf := isTorsionFree_of_fractionRing (R := R) (F := F) (V := V)
  constructor
  · intro hreg hdet
    obtain ⟨c, hc0, hcG⟩ := Matrix.exists_vecMul_eq_zero_iff.2 hdet
    set x0 : V := ∑ i, c i • x i with hx0
    have hx0ne : x0 ≠ 0 := by
      intro h0
      apply hc0
      funext i
      exact Fintype.linearIndependent_iff.1 hx c h0 i
    have hx0span : x0 ∈ span F (L : Set V) := by
      rw [span_adapted a ha x]
      exact sum_mem fun i _ => smul_mem _ _ (subset_span ⟨i, rfl⟩)
    obtain ⟨d, hd0, hdL⟩ := exists_smul_mem_of_mem_span (F := F) hx0span
    have hz := hreg (d • x0) hdL (fun l hl => by
      obtain ⟨e, -, rfl⟩ := (mem_iSup_smul_span_iff_exists a x l).1 hl
      rw [bil_rsmul_left, bil_sum_right]
      simp only [bil_smul_right]
      have : ∀ j, bil Q x0 (x j) = 0 := fun j => by
        rw [hx0, bil_sum_smul_left, hcG]; rfl
      simp [this])
    exact hx0ne ((smul_eq_zero.1 hz).resolve_left hd0)
  · intro hdet y hy hy0
    obtain ⟨c, -, rfl⟩ := (mem_iSup_smul_span_iff_exists a x y).1 hy
    have hcG : c ᵥ* gram Q x = 0 := by
      funext j
      obtain ⟨α, hα0, hα⟩ := exists_ne_zero_smul_mem_adapted a ha x j
      have h1 := hy0 _ hα
      rw [bil_smul_right] at h1
      rw [← bil_sum_smul_left]
      exact (mul_eq_zero.1 h1).resolve_left hα0
    have hc : c = 0 := by
      by_contra hc
      exact hdet (Matrix.exists_vecMul_eq_zero_iff.1 ⟨c, hc, hcG⟩)
    simp [hc]

/-- **$\mathfrak vL$ is $0$ exactly when $L$ is not regular** (O'Meara 1963, §82E, p. 229: "this quantity is $0$ when
$L$ is not regular, it is a fractional ideal in $F$ when $L$ is regular"). -/
@[kb "omeara1963" "§82E, p. 229 (vL = 0 iff L is not regular)"]
theorem volume_eq_bot_iff [FiniteDimensional F V] {L : Submodule R V} (hL : L.FG) :
    volume Q L = ⊥ ↔ ¬ IsRegular Q L := by
  classical
  obtain ⟨r, y, hy, -, a, ha, hLeq⟩ := exists_adapted (F := F) hL
  subst hLeq
  rw [volume_eq_of_adapted Q y hy a ha, isRegular_adapted_iff Q y hy a fun i => (ha i).2, not_not]
  have hP : (∏ i, a i) ^ 2 ≠ 0 := pow_ne_zero 2 (by
    rw [Submodule.zero_eq_bot]; exact (prod_fg_ne_bot _ a ha).2)
  rw [← Submodule.zero_eq_bot, mul_eq_zero, Submodule.zero_eq_bot, span_singleton_eq_bot]
  have hP' : (∏ i, a i) ^ 2 ≠ ⊥ := by rwa [← Submodule.zero_eq_bot]
  simp [hP']

/-- **The volume of a regular lattice is a fractional ideal** (O'Meara 1963, §82E, p. 229). -/
theorem volume_fg [FiniteDimensional F V] {L : Submodule R V} (hL : L.FG) : (volume Q L).FG := by
  classical
  obtain ⟨r, y, hy, -, a, ha, hLeq⟩ := exists_adapted (F := F) hL
  subst hLeq
  rw [volume_eq_of_adapted Q y hy a ha, pow_two]
  exact ((prod_fg_ne_bot _ a ha).1.mul (prod_fg_ne_bot _ a ha).1).mul (fg_span_singleton _)

/-- **Volume of an orthogonal sum** over a Dedekind domain (O'Meara 1963, §82E, p. 229):
$\mathfrak v(J \perp K) = \mathfrak vJ \cdot \mathfrak vK$. -/
@[kb "omeara1963" "§82E, p. 229 (v(J ⊥ K) = vJ · vK)"]
theorem Dedekind.volume_eq_mul_of_isOrthSum [FiniteDimensional F V] {M J K : Submodule R V}
    (h : IsOrthSum Q M J K) (hJ : J.FG) (hK : K.FG) : volume Q M = volume Q J * volume Q K := by
  classical
  have htf := isTorsionFree_of_fractionRing (R := R) (F := F) (V := V)
  obtain ⟨r, x, hx, hxs, a, ha, hJeq⟩ := exists_adapted (F := F) hJ
  obtain ⟨s, y, hy, hys, b, hb, hKeq⟩ := exists_adapted (F := F) hK
  have hdisj : Disjoint (span F (Set.range x)) (span F (Set.range y)) := by
    rw [disjoint_iff, eq_bot_iff]
    rintro z ⟨hz1, hz2⟩
    rw [SetLike.mem_coe, hxs] at hz1
    rw [SetLike.mem_coe, hys] at hz2
    obtain ⟨d, hd, hdz⟩ := exists_smul_mem_of_mem_span (F := F) hz1
    obtain ⟨d', hd', hdz'⟩ := exists_smul_mem_of_mem_span (F := F) hz2
    have h1 : d' • d • z ∈ J := J.smul_mem d' hdz
    have h2 : d' • d • z ∈ K := by rw [smul_comm]; exact K.smul_mem d hdz'
    have h3 : d' • d • z = 0 := (Submodule.disjoint_def.1 h.disjoint) _ h1 h2
    have h4 := (smul_eq_zero.1 h3).resolve_left hd'
    exact (mem_bot F).2 ((smul_eq_zero.1 h4).resolve_left hd)
  have horth : ∀ i j, bil Q (x i) (y j) = 0 := by
    intro i j
    obtain ⟨α, hα0, hα⟩ := exists_ne_zero_smul_mem_adapted a (fun i => (ha i).2) x i
    obtain ⟨β, hβ0, hβ⟩ := exists_ne_zero_smul_mem_adapted b (fun i => (hb i).2) y j
    have := h.orth _ (hJeq ▸ hα) _ (hKeq ▸ hβ)
    rw [bil_smul_left, bil_smul_right] at this
    exact (mul_eq_zero.1 ((mul_eq_zero.1 this).resolve_left hα0)).resolve_left hβ0
  have hz : LinearIndependent F (Sum.elim x y) := hx.sum_type hy hdisj
  have hM : M = ⨆ i, Sum.elim a b i • span R {Sum.elim x y i} := by
    rw [← h.sup_eq, hJeq, hKeq, iSup_sum]; rfl
  have hG : gram Q (Sum.elim x y) = Matrix.fromBlocks (gram Q x) 0 0 (gram Q y) := by
    ext (i | i) (j | j)
    · simp [gram]
    · simp [gram, horth i j]
    · simp [gram, bil_comm Q (y i), horth j i]
    · simp [gram]
  have hha : ∀ i, (Sum.elim a b i).FG ∧ Sum.elim a b i ≠ ⊥ := by
    rintro (i | i)
    · exact ha i
    · exact hb i
  rw [hM, volume_eq_of_adapted_fintype Q _ hz _ hha, hG, Matrix.det_fromBlocks_zero₂₁,
    Fintype.prod_sum_type, hJeq, hKeq, volume_eq_of_adapted Q x hx a ha,
    volume_eq_of_adapted Q y hy b hb]
  simp only [Sum.elim_inl, Sum.elim_inr]
  have : span R {(gram Q x).det * (gram Q y).det} =
      span R {(gram Q x).det} * span R {(gram Q y).det} := by
    rw [span_mul_span, Set.singleton_mul_singleton]
  rw [this, mul_pow]
  ring

/-- **Proposition 82:10** (O'Meara 1963, pp. 229–230): $\mathfrak vL \subseteq (\mathfrak sL)^r$, $r$ the rank of $L$.
(O'Meara assumes $L \ne 0$; for $L = 0$ both sides are $\mathfrak o$. Any commutative ring $R$.) -/
@[kb "omeara1963" "§82E, 82:10, pp. 229–230"]
theorem volume_le_scale_pow (L : Submodule R V) : volume Q L ≤ scale Q L ^ finrank R L := by
  have hprod : ∀ (s : Finset (Fin (finrank R L))) (f : Fin (finrank R L) → F),
      (∀ k ∈ s, f k ∈ scale Q L) → ∏ k ∈ s, f k ∈ scale Q L ^ s.card := by
    intro s f hf
    induction s using Finset.induction_on with
    | empty => simp
    | insert j s hj ih =>
      rw [Finset.prod_insert hj, Finset.card_insert_of_notMem hj, pow_succ']
      exact mul_mem_mul (hf j (Finset.mem_insert_self _ _))
        (ih fun k hk => hf k (Finset.mem_insert_of_mem hk))
  rw [volume, span_le]
  rintro _ ⟨t, ht, rfl⟩
  rw [SetLike.mem_coe, Matrix.det_apply]
  refine sum_mem fun σ _ => ?_
  have h1 : ∏ k, gram Q t (σ k) k ∈ scale Q L ^ finrank R L := by
    have := hprod Finset.univ (fun k => gram Q t (σ k) k) fun k _ => bil_mem_scale Q (ht _) (ht _)
    simpa using this
  rw [Units.smul_def]
  exact zsmul_mem h1 _

/-- **Corollary 82:11a** (O'Meara 1963, p. 230): $\mathfrak vK \subseteq \mathfrak vL$ for lattices $K \subseteq L$ on
the same space. -/
@[kb "omeara1963" "§82E, 82:11a, p. 230"]
theorem volume_le_of_le [FiniteDimensional F V] {K L : Submodule R V}
    (hspan : span F (K : Set V) = span F (L : Set V)) (h : K ≤ L) : volume Q K ≤ volume Q L := by
  have hr : finrank R K = finrank R L := by
    rw [finrank_eq_finrank_span (F := F) K, finrank_eq_finrank_span (F := F) L, hspan]
  rw [volume_eq_span_family Q K (ι := Fin (finrank R L)) (by simp [hr])]
  refine span_le.2 ?_
  rintro _ ⟨x, hx, rfl⟩
  exact subset_span ⟨x, fun i => h (hx i), rfl⟩

/-- Two independent-family changes of coordinates `y = A x`, `x = B y` have `A B = 1`. -/
theorem mul_eq_one_of_comb {ι : Type*} [Fintype ι] [DecidableEq ι] (x y : ι → V)
    (hy : LinearIndependent F y) (A B : Matrix ι ι F) (hA : ∀ i, y i = ∑ j, A i j • x j)
    (hB : ∀ i, x i = ∑ j, B i j • y j) : A * B = 1 := by
  ext i k
  have h0 : ∑ k, ((A * B) i k - (1 : Matrix ι ι F) i k) • y k = 0 := by
    have h1 : ∑ k, (A * B) i k • y k = y i := by
      calc ∑ k, (A * B) i k • y k = ∑ k, ∑ j, (A i j * B j k) • y k := by
            simp [Matrix.mul_apply, Finset.sum_smul]
        _ = ∑ j, A i j • ∑ k, B j k • y k := by
            rw [Finset.sum_comm]
            simp [Finset.smul_sum, smul_smul]
        _ = y i := by
            rw [hA i]
            exact Finset.sum_congr rfl fun j _ => by rw [← hB j]
    have h2 : ∑ k, (1 : Matrix ι ι F) i k • y k = y i := by
      simp [Matrix.one_apply]
    simp only [sub_smul, Finset.sum_sub_distrib, h1, h2, sub_self]
  have := Fintype.linearIndependent_iff.1 hy _ h0 k
  exact sub_eq_zero.1 this

/-- `1 • M = M` for the action of `Submodule R F` on `Submodule R V`. -/
theorem one_smul_submodule (M : Submodule R V) : (1 : Submodule R F) • M = M := by
  apply le_antisymm
  · rw [Submodule.smul_le]
    intro r hr n hn
    obtain ⟨c, rfl⟩ := Submodule.mem_one.1 hr
    rw [algebraMap_smul]; exact M.smul_mem c hn
  · intro n hn
    simpa using smul_mem_smul (Submodule.one_le.1 le_rfl : (1 : F) ∈ (1 : Submodule R F)) hn

/-- **Proposition 82:11** (O'Meara 1963, p. 230), with the ideal given by adapted bases. Let $K \subseteq L$ be regular
lattices spanning the same space ($r$ = rank). There is an integral ideal $\mathfrak a$ (a non-zero finitely generated
$R$-submodule of $\mathfrak o$) with $\mathfrak vK = \mathfrak a^2\,\mathfrak vL$ and $\mathfrak aL \subseteq K$, and
$\mathfrak a = \mathfrak o$ only if $K = L$. (O'Meara's $\mathfrak a$ is the product of the invariant factors of $K$ in
$L$, 81:11; the ideal constructed here is $\mathfrak b_1 \cdots \mathfrak b_r\det(a_{ij})(\mathfrak a_1 \cdots
\mathfrak a_r)^{-1}$ for adaptations $L = \sum\mathfrak a_ix_i$, $K = \sum\mathfrak b_iy_i$, $y_i = \sum_j a_{ij}x_j$,
which is that product.) -/
@[kb "omeara1963" "§82E, 82:11, p. 230"]
theorem exists_volume_eq_sq_mul [FiniteDimensional F V] {K L : Submodule R V} (hK : K.FG) (hL : L.FG)
    (hspan : span F (K : Set V) = span F (L : Set V)) (h : K ≤ L) :
    ∃ a : Submodule R F, a.FG ∧ a ≠ ⊥ ∧ a ≤ 1 ∧ volume Q K = a ^ 2 * volume Q L ∧ a • L ≤ K ∧
      (a = 1 → K = L) := by
  classical
  obtain ⟨r, x, hx, hxs, a, ha, hLeq⟩ := exists_adapted (F := F) hL
  obtain ⟨s, y, hy, hys, b, hb, hKeq⟩ := exists_adapted (F := F) hK
  have hrs : s = r := by
    have h1 := finrank_span_eq_card hx
    have h2 := finrank_span_eq_card hy
    rw [hxs] at h1
    rw [hys, hspan] at h2
    simp only [Fintype.card_fin] at h1 h2
    omega
  subst hrs
  have hxy : span F (Set.range y) = span F (Set.range x) := by rw [hys, hspan, hxs]
  have hyx : ∀ i, y i ∈ span F (Set.range x) := fun i => hxy ▸ subset_span ⟨i, rfl⟩
  have hxy' : ∀ i, x i ∈ span F (Set.range y) := fun i => hxy.symm ▸ subset_span ⟨i, rfl⟩
  choose A hA using fun i => (mem_span_range_iff_exists_fun F).1 (hyx i)
  choose B hB using fun i => (mem_span_range_iff_exists_fun F).1 (hxy' i)
  have hA' : ∀ i, y i = ∑ j, Matrix.of A i j • x j := fun i => (hA i).symm
  have hB' : ∀ i, x i = ∑ j, Matrix.of B i j • y j := fun i => (hB i).symm
  set Am : Matrix (Fin _) (Fin _) F := Matrix.of A with hAm
  set Bm : Matrix (Fin _) (Fin _) F := Matrix.of B with hBm
  have hAB : Am * Bm = 1 := mul_eq_one_of_comb x y hy Am Bm hA' hB'
  have hdet : Am.det * Bm.det = 1 := by rw [← Matrix.det_mul, hAB, Matrix.det_one]
  have hdetne : Am.det ≠ 0 := left_ne_zero_of_mul_eq_one hdet
  have hadj : Am.adjugate = Am.det • Bm := by
    calc Am.adjugate = Am.adjugate * (Am * Bm) := by rw [hAB, mul_one]
      _ = (Am.adjugate * Am) * Bm := by rw [mul_assoc]
      _ = Am.det • Bm := by rw [Matrix.adjugate_mul, smul_mul_assoc, one_mul]
  have hBadj : ∀ i j, Bm i j = (Am.det)⁻¹ * Am.adjugate i j := fun i j => by
    rw [hadj]; simp [hdetne]
  have hmemL : ∀ v, v ∈ L ↔ ∃ c : Fin _ → F, (∀ i, c i ∈ a i) ∧ v = ∑ i, c i • x i := fun v => by
    rw [hLeq]; exact mem_iSup_smul_span_iff_exists a x v
  have hmemK : ∀ v, v ∈ K ↔ ∃ c : Fin _ → F, (∀ i, c i ∈ b i) ∧ v = ∑ i, c i • y i := fun v => by
    rw [hKeq]; exact mem_iSup_smul_span_iff_exists b y v
  -- the coefficient inequalities from `K ≤ L`
  have h1 : ∀ i j, span R {Am i j} * b i ≤ a j := by
    intro i j
    rw [Submodule.span_singleton_mul]
    intro t ht
    obtain ⟨β, hβ, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).1 ht
    have hβK : β • y i ∈ K := by
      rw [hKeq]
      exact mem_iSup_of_mem i (smul_mem_smul hβ (mem_span_singleton_self _))
    have hβL : ∑ j, (β * Am i j) • x j ∈ L := by
      have : β • y i = ∑ j, (β * Am i j) • x j := by
        rw [hA' i, Finset.smul_sum]
        exact Finset.sum_congr rfl fun j _ => by rw [smul_smul]
      rw [← this]; exact h hβK
    have := coord_mem_of_mem a x hx _ (hLeq ▸ hβL) j
    simpa [mul_comm] using this
  set P : Submodule R F := ∏ i, a i with hP
  set Pb : Submodule R F := ∏ i, b i with hPb
  obtain ⟨hPfg, hPne⟩ := prod_fg_ne_bot Finset.univ a ha
  obtain ⟨hPbfg, hPbne⟩ := prod_fg_ne_bot Finset.univ b hb
  have hPinv : P * (1 / P) = 1 := mul_one_div_cancel_of_fg hPfg hPne
  obtain ⟨hPifg, hPine⟩ := one_div_fg hPfg hPne
  set 𝔞 : Submodule R F := Pb * span R {Am.det} * (1 / P) with h𝔞
  have hle : span R {Am.det} * Pb ≤ P := span_det_mul_prod_le Am a b h1
  have h𝔞P : 𝔞 * P = Pb * span R {Am.det} := by
    calc 𝔞 * P = Pb * span R {Am.det} * (P * (1 / P)) := by rw [h𝔞]; ring
      _ = Pb * span R {Am.det} := by rw [hPinv, mul_one]
  have h𝔞le : 𝔞 ≤ 1 := by
    calc 𝔞 = (span R {Am.det} * Pb) * (1 / P) := by rw [h𝔞]; ring
      _ ≤ P * (1 / P) := mul_le_mul' hle le_rfl
      _ = 1 := hPinv
  have h𝔞fg : 𝔞.FG := (hPbfg.mul (fg_span_singleton _)).mul hPifg
  have h𝔞ne : 𝔞 ≠ ⊥ := by
    rw [← Submodule.zero_eq_bot] at hPbne hPine ⊢
    have hs : span R {Am.det} ≠ 0 := by
      rw [Submodule.zero_eq_bot]
      exact fun h0 => hdetne (by simpa using span_singleton_eq_bot.1 h0)
    exact mul_ne_zero (mul_ne_zero hPbne hs) hPine
  -- the reverse coefficient bound
  have h2 : ∀ i j, span R {Bm i j} * (𝔞 * a i) ≤ b j := by
    intro i j
    obtain ⟨hPjfg, hPjne⟩ := prod_fg_ne_bot (Finset.univ.erase j) b hb
    set Pj : Submodule R F := ∏ k ∈ Finset.univ.erase j, b k with hPj
    have hPjinv := mul_one_div_cancel_of_fg hPjfg hPjne
    let N : Matrix (Fin _) (Fin _) F := Am.updateRow j (Pi.single i 1)
    let d : Fin _ → Submodule R F := Function.update b j (a i)
    have hN : ∀ k l, span R {N k l} * d k ≤ a l := by
      intro k l
      by_cases hk : k = j
      · subst hk
        simp only [N, d, Matrix.updateRow_self, Function.update_self]
        by_cases hl : l = i
        · subst hl; simp; rw [← Submodule.one_eq_span, one_mul]
        · simp [hl]
      · simp only [N, d, Matrix.updateRow_ne hk, Function.update_of_ne hk]
        exact h1 k l
    have key := span_det_mul_prod_le N a d hN
    have hdprod : ∏ k, d k = a i * Pj := by
      rw [← Finset.mul_prod_erase Finset.univ d (Finset.mem_univ j)]
      congr 1
      · simp [d]
      · exact Finset.prod_congr rfl fun k hk => by simp [d, Finset.ne_of_mem_erase hk]
    have hbprod : Pb = b j * Pj := (Finset.mul_prod_erase _ _ (Finset.mem_univ j)).symm
    have hNdet : N.det = Am.adjugate i j := by rw [Matrix.adjugate_apply]
    rw [hNdet, hdprod] at key
    have key' : span R {Am.adjugate i j} * (𝔞 * a i) * Pj ≤ b j * Pj * span R {Am.det} := by
      calc span R {Am.adjugate i j} * (𝔞 * a i) * Pj
          = 𝔞 * (span R {Am.adjugate i j} * (a i * Pj)) := by ring
        _ ≤ 𝔞 * P := mul_le_mul' le_rfl key
        _ = Pb * span R {Am.det} := h𝔞P
        _ = b j * Pj * span R {Am.det} := by rw [hbprod]
    have key2 : span R {Am.adjugate i j} * (𝔞 * a i) ≤ b j * span R {Am.det} := by
      calc span R {Am.adjugate i j} * (𝔞 * a i)
          = span R {Am.adjugate i j} * (𝔞 * a i) * (Pj * (1 / Pj)) := by rw [hPjinv, mul_one]
        _ = (span R {Am.adjugate i j} * (𝔞 * a i) * Pj) * (1 / Pj) := by ring
        _ ≤ (b j * Pj * span R {Am.det}) * (1 / Pj) := mul_le_mul' key' le_rfl
        _ = b j * span R {Am.det} * (Pj * (1 / Pj)) := by ring
        _ = b j * span R {Am.det} := by rw [hPjinv, mul_one]
    calc span R {Bm i j} * (𝔞 * a i)
        = span R {(Am.det)⁻¹} * (span R {Am.adjugate i j} * (𝔞 * a i)) := by
          have e : span R {(Am.det)⁻¹ * Am.adjugate i j} =
              span R {(Am.det)⁻¹} * span R {Am.adjugate i j} := by
            rw [Submodule.span_mul_span, Set.singleton_mul_singleton]
          rw [hBadj, e, mul_assoc]
      _ ≤ span R {(Am.det)⁻¹} * (b j * span R {Am.det}) := mul_le_mul' le_rfl key2
      _ = b j * (span R {(Am.det)⁻¹} * span R {Am.det}) := by ring
      _ = b j := by
          rw [Submodule.span_mul_span, Set.singleton_mul_singleton, inv_mul_cancel₀ hdetne,
            ← Submodule.one_eq_span, mul_one]
  -- `𝔞 L ⊆ K`
  have hsmul : 𝔞 • L ≤ K := by
    rw [Submodule.smul_le]
    intro α hα l hl
    obtain ⟨c, hc, rfl⟩ := (hmemL l).1 hl
    refine (hmemK _).2 ⟨fun k => ∑ i, α * c i * Bm i k, fun k => sum_mem fun i _ => ?_, ?_⟩
    · have : α * c i * Bm i k = Bm i k * (α * c i) := by ring
      rw [this]
      exact h2 i k (mul_mem_mul (mem_span_singleton_self _) (mul_mem_mul hα (hc i)))
    · calc α • ∑ i, c i • x i = ∑ i, (α * c i) • x i := by simp [Finset.smul_sum, smul_smul]
        _ = ∑ i, (α * c i) • ∑ k, Bm i k • y k := by
            exact Finset.sum_congr rfl fun i _ => by rw [← hB' i]
        _ = ∑ k, (∑ i, α * c i * Bm i k) • y k := by
            simp only [Finset.smul_sum, smul_smul, Finset.sum_smul]
            rw [Finset.sum_comm]
  refine ⟨𝔞, h𝔞fg, h𝔞ne, h𝔞le, ?_, hsmul, fun h1' => ?_⟩
  · rw [hLeq, hKeq, volume_eq_of_adapted Q x hx a ha, volume_eq_of_adapted Q y hy b hb]
    have hy' : y = fun i => ∑ j, Am i j • x j := funext hA'
    have hgy : (gram Q y).det = Am.det ^ 2 * (gram Q x).det := by
      rw [hy', gram_comb_F, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose]
      ring
    have hs : span R {Am.det} ^ 2 * span R {(gram Q x).det} =
        span R {(gram Q y).det} := by
      rw [hgy, pow_two (span R {Am.det}), span_mul_span, span_mul_span, Set.singleton_mul_singleton,
        Set.singleton_mul_singleton, _root_.sq]
    calc Pb ^ 2 * span R {(gram Q y).det}
        = (Pb * span R {Am.det}) ^ 2 * span R {(gram Q x).det} := by rw [← hs]; ring
      _ = (𝔞 * P) ^ 2 * span R {(gram Q x).det} := by rw [h𝔞P]
      _ = 𝔞 ^ 2 * (P ^ 2 * span R {(gram Q x).det}) := by ring
  · rw [h1'] at hsmul
    refine le_antisymm h ?_
    rw [← one_smul_submodule (F := F) L]
    exact hsmul

/-- **Lattices with the same volume** (O'Meara 1963, §82E, p. 230, the step used in 82:12 and 82:14): if $K \subseteq
L$ are regular lattices spanning the same space and $\mathfrak vK = \mathfrak vL$, then $K = L$. -/
@[kb "omeara1963" "§82E, 82:11, p. 230 (K ⊆ L and vK = vL give K = L)"]
theorem eq_of_le_of_volume_eq [FiniteDimensional F V] {K L : Submodule R V} (hK : K.FG) (hL : L.FG)
    (hspan : span F (K : Set V) = span F (L : Set V)) (hreg : IsRegular Q L) (h : K ≤ L)
    (hv : volume Q K = volume Q L) : K = L := by
  obtain ⟨𝔞, h𝔞fg, h𝔞ne, h𝔞le, hvol, -, hone⟩ := exists_volume_eq_sq_mul Q hK hL hspan h
  refine hone ?_
  have hLne : volume Q L ≠ ⊥ := fun h0 => (volume_eq_bot_iff Q hL).1 h0 hreg
  have hcancel : volume Q L * 𝔞 ^ 2 = volume Q L * 1 := by
    rw [mul_one, mul_comm, ← hvol, hv]
  have hsq : 𝔞 ^ 2 = 1 := mul_left_cancel_of_fg (volume_fg Q hL) hLne hcancel
  apply le_antisymm h𝔞le
  calc (1 : Submodule R F) = 𝔞 ^ 2 := hsq.symm
    _ = 𝔞 * 𝔞 := pow_two _
    _ ≤ 1 * 𝔞 := mul_le_mul' h𝔞le le_rfl
    _ = 𝔞 := one_mul _

/-- **An isometry preserves volume** (O'Meara 1963, 82:12, p. 230): $\mathfrak v(\sigma L) = \mathfrak vL$ for
$\sigma \in O(V)$. -/
theorem volume_latMap {σ : V ≃ₗ[F] V} (hσ : σ ∈ orth Q) (L : Submodule R V) :
    volume Q (latMap σ L) = volume Q L := by
  have hbil : ∀ u v, bil Q (σ u) (σ v) = bil Q u v := fun u v => by
    have h2 : (2 : F) ≠ 0 := two_ne_zero' F
    have h := Q_add Q u v
    have h' := Q_add Q (σ u) (σ v)
    rw [← map_add, hσ, hσ, hσ] at h'
    rw [h] at h'
    apply mul_left_cancel₀ h2
    linear_combination -h'
  have hinj : Function.Injective ((σ : V →ₗ[F] V).restrictScalars R) := σ.injective
  have hr : finrank R (latMap σ L) = finrank R L :=
    (LinearEquiv.finrank_eq (Submodule.equivMapOfInjective _ hinj L)).symm
  rw [volume_eq_span_family Q (latMap σ L) (ι := Fin (finrank R L)) (by simp [hr]),
    volume_eq_span_family Q L (ι := Fin (finrank R L)) (by simp)]
  congr 1
  ext d
  constructor
  · rintro ⟨t, ht, rfl⟩
    choose u hu hut using fun i => (Submodule.mem_map).1 (ht i)
    refine ⟨u, hu, ?_⟩
    have : gram Q t = gram Q u := by
      ext i j
      simp only [gram, Matrix.of_apply]
      rw [← hut i, ← hut j]
      exact hbil _ _
    rw [this]
  · rintro ⟨t, ht, rfl⟩
    refine ⟨fun i => σ (t i), fun i => Submodule.mem_map.2 ⟨t i, ht i, rfl⟩, ?_⟩
    congr 1
    ext i j
    simp only [gram, Matrix.of_apply]
    exact hbil _ _

/-- **Example 82:12** (O'Meara 1963, p. 230). Let $L$ be a lattice on the regular quadratic space $V$ and
$\sigma \in O(V)$ with $\sigma L \subseteq L$. Then $\sigma L = L$, i.e. $\sigma \in O(L)$. -/
@[kb "omeara1963" "§82E, 82:12, p. 230"]
theorem latMap_eq_of_le [FiniteDimensional F V] (hV : (QuadraticMap.associated Q).Nondegenerate)
    {L : Submodule R V} (hL : L.IsLattice F) {σ : V ≃ₗ[F] V} (hσ : σ ∈ orth Q) (h : latMap σ L ≤ L) :
    σ ∈ orthLat Q L := by
  refine ⟨hσ, ?_⟩
  have hreg : IsRegular Q L := by
    intro x hx hx0
    have hall : ∀ y, bil Q x y = 0 := by
      intro y
      have hy : y ∈ span F (L : Set V) := by rw [hL.span_eq_top]; trivial
      refine span_induction (p := fun y _ => bil Q x y = 0) hx0 (by simp [bil]) ?_ ?_ hy
      · intro u v _ _ hu hv; rw [bil_add_right, hu, hv, add_zero]
      · intro c u _ hu; rw [bil_smul_right, hu, mul_zero]
    exact hV.1 x fun y => by simpa [bil] using hall y
  have hfg : (latMap σ L).FG := hL.fg.map _
  have hspan : span F ((latMap σ L : Submodule R V) : Set V) = span F (L : Set V) := by
    rw [hL.span_eq_top, eq_top_iff]
    intro v _
    have hv : σ.symm v ∈ span F (L : Set V) := by rw [hL.span_eq_top]; trivial
    have := Submodule.mem_map_of_mem (f := (σ : V →ₗ[F] V)) hv
    rw [Submodule.map_span] at this
    have e : ((σ : V →ₗ[F] V) : V → V) '' (L : Set V) = ((latMap σ L : Submodule R V) : Set V) := by
      ext w
      constructor
      · rintro ⟨l, hl, rfl⟩; exact ⟨l, hl, rfl⟩
      · rintro ⟨l, hl, rfl⟩; exact ⟨l, hl, rfl⟩
    rw [e] at this
    simpa using this
  exact eq_of_le_of_volume_eq Q hfg hL.fg hspan hreg h (volume_latMap Q hσ L)

end Volume

end QuadFormsKB.OMeara
