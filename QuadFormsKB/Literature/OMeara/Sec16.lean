/-
# O'Meara §16: discrete valuations (16:1–16:4)

**Setting.** As in `Sec13A.lean` and `Sec13B.lean`: valuations are Mathlib `AbsoluteValue F ℝ`, the value group is
`absValueGroup v` (a subgroup of $\mathbb R^\times$), the ring of integers `integers v hv`, its maximal ideal
`maximalIdealOf v hv`; for an extension $E/F$ the induced valuation is `w.under _` and the ramification index and
degree of inertia are `ramificationIndexAbs w`, `inertiaDegAbs w hw`.

**Defines**
* `IsDiscreteAbs v` (§16, p. 37): $v$ is *discrete*: non-trivial with infinite cyclic value group (an infinite cyclic
  subgroup of the positive reals is discrete);
* `IsPrimeElt v hv π` (§16, p. 38): $\pi$ is a *prime element* of $F$ at $v$: an irreducible element of the ring
  $\mathfrak o(\mathfrak p)$ (a non-unit that has a unit factor in every factorization);
* `ordAbs v hd α` (§16, p. 38): the *order* $\operatorname{ord}_{\mathfrak p}\alpha$, the exponent $\nu$ in
  $\alpha = \varepsilon\pi^{\nu}$ (O'Meara puts $\operatorname{ord}_{\mathfrak p} 0 = \infty$; here the value at $0$
  is $0$ and the statements exclude $\alpha = 0$);
* `IsRepresentativeSet v hv C` (§16, p. 39): a representative set in $\mathfrak o(\mathfrak p)$ of the residue class
  field, containing $0$.

**Proves**
* the facts of §16, pp. 37–38: discreteness depends only on the spot (`IsDiscreteAbs.of_isEquiv`), a discrete
  valuation is non-trivial and non-archimedean (`IsDiscreteAbs.isNontrivial`, `IsDiscreteAbs.isNonarchimedean`),
  prime elements exist and are the elements whose value generates $|F|$ (`exists_isPrimeElt`, `isPrimeElt_iff`),
  $\mathfrak m(\mathfrak p) = \pi\,\mathfrak o(\mathfrak p)$ (`maximalIdealOf_eq_span`), and the rules for
  $\operatorname{ord}$ (`apply_eq_zpow_ordAbs`, `ordAbs_mul`, `ordAbs_nonneg_iff`, `ordAbs_pos_iff`);
* `isDiscreteAbs_iff_under` (**16:1**), `ordAbs_algebraMap` (**16:2**), `exists_unique_expansion` (**16:3**),
  `ramificationIndexAbs_mul_inertiaDegAbs_eq` (**16:4**).
-/
import QuadFormsKB.Citation
import QuadFormsKB.Literature.OMeara.Sec12A
import QuadFormsKB.Literature.OMeara.Sec13B

open Filter Topology

namespace QuadFormsKB.OMeara

section Discrete

variable {F : Type*} [Field F]

/-- A valuation $v$ is *discrete* (§16, p. 37) if it is non-trivial and its value group is a discrete infinite
cyclic subgroup of the positive reals: $|F| = \langle g\rangle$ for some $g \ne 1$. A prime spot is discrete when it
contains a discrete valuation; then every valuation in it is discrete (`IsDiscreteAbs.of_isEquiv`). -/
@[kb "omeara1963" "§16, p. 37 (discrete valuation, discrete spot)"]
def IsDiscreteAbs (v : AbsoluteValue F ℝ) : Prop :=
  ∃ g : ℝˣ, (g : ℝ) ≠ 1 ∧ absValueGroup v = Subgroup.zpowers g

/-- A subgroup of `ℝˣ` contained in a cyclic subgroup `⟨h⟩` and containing a unit `u ≠ 1` is generated by some
`g ≠ 1`. -/
theorem exists_zpowers_of_le_zpowers {H : Subgroup ℝˣ} {h u : ℝˣ} (hH : H ≤ Subgroup.zpowers h)
    (hu : u ∈ H) (hu1 : u ≠ 1) : ∃ g : ℝˣ, g ≠ 1 ∧ H = Subgroup.zpowers g := by
  have : IsCyclic H := Subgroup.isCyclic_of_le hH
  obtain ⟨g, hg⟩ := (H.isCyclic_iff_exists_zpowers_eq_top).1 this
  refine ⟨g, ?_, hg.symm⟩
  rintro rfl
  rw [Subgroup.zpowers_one_eq_bot] at hg
  rw [← hg] at hu
  exact hu1 (Subgroup.mem_bot.1 hu)

/-- Discreteness depends only on the spot (§16, p. 37). -/
theorem IsDiscreteAbs.of_isEquiv {v w : AbsoluteValue F ℝ} (h : v.IsEquiv w) (hv : IsDiscreteAbs v) :
    IsDiscreteAbs w := by
  obtain ⟨c, hc, hcw⟩ := AbsoluteValue.isEquiv_iff_exists_rpow_eq.1 h
  obtain ⟨g, hg1, hg⟩ := hv
  have hgpos : (0 : ℝ) < g := absValueGroup_le_pos v (hg ▸ Subgroup.mem_zpowers g)
  refine ⟨rpowUnitHom c g, ?_, ?_⟩
  · rw [rpowUnitHom_val, abs_of_pos hgpos]
    intro h1
    exact hg1 ((Real.rpow_left_inj hgpos.le zero_le_one hc.ne').1 (by rw [h1, Real.one_rpow]))
  · rw [absValueGroup_rpow v w (c := c) (fun x => (congrFun hcw x).symm), hg, MonoidHom.map_zpowers]

/-- The normalized generator: a discrete valuation has a generator $g$ of $|F|$ with $0 < g < 1$, which is itself a
value, and every non-zero value is an integer power of $g$. -/
theorem IsDiscreteAbs.exists_gen {v : AbsoluteValue F ℝ} (hd : IsDiscreteAbs v) :
    ∃ g : ℝ, 0 < g ∧ g < 1 ∧ (∃ π : F, π ≠ 0 ∧ v π = g) ∧ ∀ x : F, x ≠ 0 → ∃ n : ℤ, v x = g ^ n := by
  obtain ⟨g, hg1, hg⟩ := hd
  have hgpos : (0 : ℝ) < g := absValueGroup_le_pos v (hg ▸ Subgroup.mem_zpowers g)
  obtain ⟨u, hu1, hu⟩ : ∃ u : ℝˣ, (u : ℝ) < 1 ∧ absValueGroup v = Subgroup.zpowers u := by
    rcases lt_or_gt_of_ne hg1 with h | h
    · exact ⟨g, h, hg⟩
    · refine ⟨g⁻¹, ?_, by rw [hg, Subgroup.zpowers_inv]⟩
      rw [Units.val_inv_eq_inv_val]
      exact inv_lt_one_of_one_lt₀ h
  have hupos : (0 : ℝ) < u := absValueGroup_le_pos v (hu ▸ Subgroup.mem_zpowers u)
  refine ⟨u, hupos, hu1, ?_, fun x hx => ?_⟩
  · have : u ∈ absValueGroup v := hu ▸ Subgroup.mem_zpowers u
    exact this
  · have hx' : Units.mk0 (v x) (v.pos hx).ne' ∈ absValueGroup v := ⟨x, hx, rfl⟩
    rw [hu, Subgroup.mem_zpowers_iff] at hx'
    obtain ⟨n, hn⟩ := hx'
    refine ⟨n, ?_⟩
    have := congrArg (fun y : ℝˣ => (y : ℝ)) hn
    simpa [Units.val_zpow_eq_zpow_val] using this.symm

/-- A discrete valuation is non-trivial (§16, p. 37). -/
theorem IsDiscreteAbs.isNontrivial {v : AbsoluteValue F ℝ} (hv : IsDiscreteAbs v) : v.IsNontrivial := by
  obtain ⟨g, -, hg1, ⟨π, hπ, hπg⟩, -⟩ := hv.exists_gen
  exact ⟨π, hπ, by rw [hπg]; exact hg1.ne⟩

/-- For `0 < g < 1`, a real number `> 1` that is an integer power of `g` is the inverse of a positive natural power. -/
theorem exists_nat_of_one_lt_zpow {g x : ℝ} (hg0 : 0 < g) (hg1 : g < 1) (hx : 1 < x) {n : ℤ}
    (h : x = g ^ n) : ∃ A : ℕ, 0 < A ∧ x = (g ^ A)⁻¹ := by
  rcases le_or_gt 0 n with hn | hn
  · obtain ⟨m, rfl⟩ := Int.eq_ofNat_of_zero_le hn
    rw [zpow_natCast] at h
    exact absurd (h ▸ hx) (not_lt.2 (pow_le_one₀ hg0.le hg1.le))
  · refine ⟨(-n).toNat, ?_, ?_⟩
    · omega
    · rw [h, ← zpow_natCast, ← zpow_neg, Int.toNat_of_nonneg (by omega), neg_neg]

/-- An archimedean valuation is not discrete (§16, p. 37), so a discrete valuation is non-archimedean. -/
@[kb "omeara1963" "§16, p. 37 (an archimedean valuation cannot be discrete)"]
theorem IsDiscreteAbs.isNonarchimedean {v : AbsoluteValue F ℝ} (hv : IsDiscreteAbs v) :
    IsNonarchimedean v := by
  by_contra hna
  obtain ⟨g, hg0, hg1, -, hpow⟩ := hv.exists_gen
  have hchar : CharZero F := by
    obtain ⟨p, hp⟩ := CharP.exists F
    by_cases h0 : p = 0
    · subst h0; exact CharP.charP_to_charZero F
    · exfalso; apply hna
      rw [isNonarchimedean_iff_natCast_bounded]
      refine ⟨∑ i ∈ Finset.range p, v (i : F), fun n => ?_⟩
      have : (n : F) = ((n % p : ℕ) : F) := by
        conv_lhs => rw [← Nat.div_add_mod n p]
        push_cast
        rw [CharP.cast_eq_zero F p]; simp
      rw [this]
      exact Finset.single_le_sum (f := fun i : ℕ => v (i : F)) (fun i _ => v.nonneg _)
        (Finset.mem_range.2 (Nat.mod_lt _ (Nat.pos_of_ne_zero h0)))
  let vq : AbsoluteValue ℚ ℝ := v.comp (f := Rat.castHom F) (Rat.castHom F).injective
  have hvq : ∀ x : ℚ, vq x = v (x : F) := fun x => rfl
  have hqna : ¬ IsNonarchimedean vq := by
    intro h
    apply hna
    obtain ⟨M, hM⟩ := (isNonarchimedean_iff_natCast_bounded vq).1 h
    rw [isNonarchimedean_iff_natCast_bounded]
    exact ⟨M, fun n => by simpa [hvq] using hM n⟩
  obtain ⟨ρ, hρ0, -, hρ⟩ := rat_archimedean_exists_rpow vq hqna
  have hvn : ∀ n : ℕ, v (n : F) = (n : ℝ) ^ ρ := fun n => by
    have := hρ (n : ℚ)
    rw [hvq] at this
    simpa using this
  have h2 : 1 < v ((2 : ℕ) : F) := by
    rw [hvn]; exact Real.one_lt_rpow (by norm_num) hρ0
  have h3 : 1 < v ((3 : ℕ) : F) := by
    rw [hvn]; exact Real.one_lt_rpow (by norm_num) hρ0
  obtain ⟨a, ha⟩ := hpow ((2 : ℕ) : F) (by simp)
  obtain ⟨b, hb⟩ := hpow ((3 : ℕ) : F) (by simp)
  obtain ⟨A, hA, hA'⟩ := exists_nat_of_one_lt_zpow hg0 hg1 h2 ha
  obtain ⟨B, hB, hB'⟩ := exists_nat_of_one_lt_zpow hg0 hg1 h3 hb
  have key : ((2 : ℝ) ^ ρ) ^ B = ((3 : ℝ) ^ ρ) ^ A := by
    have e2 := hvn 2
    have e3 := hvn 3
    simp only [Nat.cast_ofNat] at e2 e3 hA' hB'
    rw [← e2, ← e3, hA', hB', inv_pow, inv_pow, ← pow_mul, ← pow_mul, mul_comm]
  have key2 : (2 : ℝ) ^ B = (3 : ℝ) ^ A := by
    have h1 : ((2 : ℝ) ^ B) ^ ρ = ((3 : ℝ) ^ A) ^ ρ := by
      rw [← Real.rpow_natCast, ← Real.rpow_natCast (3 : ℝ), ← Real.rpow_mul (by norm_num),
        ← Real.rpow_mul (by norm_num), mul_comm, Real.rpow_mul (by norm_num),
        mul_comm (A : ℝ), Real.rpow_mul (by norm_num), Real.rpow_natCast, Real.rpow_natCast, key]
    exact (Real.rpow_left_inj (by positivity) (by positivity) hρ0.ne').1 h1
  have key3 : 2 ^ B = 3 ^ A := by exact_mod_cast key2
  have : 2 ∣ 3 ^ A := key3 ▸ dvd_pow_self 2 hB.ne'
  have := Nat.Prime.dvd_of_dvd_pow Nat.prime_two this
  omega

/-- A *prime element* of $F$ at the non-archimedean valuation $v$ (§16, p. 38): an element $\pi$ of
$\mathfrak o(\mathfrak p)$ that is a prime element of this integral domain in O'Meara's sense, i.e. an irreducible
element (a non-unit $\pi$ such that in every factorization $\pi = \alpha\beta$ in $\mathfrak o(\mathfrak p)$ one of
$\alpha, \beta$ is a unit). -/
@[kb "omeara1963" "§16, p. 38 (prime element of F at p)"]
def IsPrimeElt (v : AbsoluteValue F ℝ) (hv : IsNonarchimedean v) (π : F) : Prop :=
  ∃ h : v π ≤ 1, Irreducible (⟨π, h⟩ : integers v hv)

variable {v : AbsoluteValue F ℝ}

/-- The normalized generator $g$ of the value group of a discrete valuation, $0 < g < 1$ (chosen with
`Classical.choose`). -/
noncomputable def genAbs (hd : IsDiscreteAbs v) : ℝ := Classical.choose hd.exists_gen

theorem genAbs_pos (hd : IsDiscreteAbs v) : 0 < genAbs hd := (Classical.choose_spec hd.exists_gen).1

theorem genAbs_lt_one (hd : IsDiscreteAbs v) : genAbs hd < 1 := (Classical.choose_spec hd.exists_gen).2.1

theorem exists_apply_eq_genAbs (hd : IsDiscreteAbs v) : ∃ π : F, π ≠ 0 ∧ v π = genAbs hd :=
  (Classical.choose_spec hd.exists_gen).2.2.1

theorem exists_zpow_genAbs (hd : IsDiscreteAbs v) {x : F} (hx : x ≠ 0) : ∃ n : ℤ, v x = genAbs hd ^ n :=
  (Classical.choose_spec hd.exists_gen).2.2.2 x hx

theorem genAbs_ne_one (hd : IsDiscreteAbs v) : genAbs hd ≠ 1 := (genAbs_lt_one hd).ne

theorem genAbs_zpow_injective (hd : IsDiscreteAbs v) : Function.Injective fun n : ℤ => genAbs hd ^ n :=
  zpow_right_injective₀ (genAbs_pos hd) (genAbs_ne_one hd)

theorem genAbs_zpow_le_iff (hd : IsDiscreteAbs v) {m n : ℤ} : genAbs hd ^ m ≤ genAbs hd ^ n ↔ n ≤ m :=
  zpow_le_zpow_iff_right_of_lt_one₀ (genAbs_pos hd) (genAbs_lt_one hd)

theorem genAbs_zpow_lt_iff (hd : IsDiscreteAbs v) {m n : ℤ} : genAbs hd ^ m < genAbs hd ^ n ↔ n < m :=
  zpow_lt_zpow_iff_right_of_lt_one₀ (genAbs_pos hd) (genAbs_lt_one hd)

/-- The units of the ring of integers are the elements of value $1$. -/
theorem isUnit_integers_iff (hv : IsNonarchimedean v) (x : integers v hv) :
    IsUnit x ↔ v (x : F) = 1 := by
  constructor
  · rintro ⟨u, rfl⟩
    have h1 : v ((u : integers v hv) : F) * v ((u⁻¹ : (integers v hv)ˣ) : F) = 1 := by
      rw [← map_mul]
      have h := congrArg (fun y : integers v hv => (y : F)) (Units.mul_inv u)
      simp only [Subring.coe_mul, Subring.coe_one] at h
      rw [h, map_one]
    have ha : v ((u : integers v hv) : F) ≤ 1 := (u : integers v hv).2
    have hb : v ((u⁻¹ : (integers v hv)ˣ) : F) ≤ 1 := ((u⁻¹ : (integers v hv)ˣ) : integers v hv).2
    nlinarith [v.nonneg ((u : integers v hv) : F), v.nonneg ((u⁻¹ : (integers v hv)ˣ) : F)]
  · intro h
    have hx0 : (x : F) ≠ 0 := by
      intro h0; rw [h0] at h; simp at h
    have hinv : (x : F)⁻¹ ∈ integers v hv := by
      show v ((x : F)⁻¹) ≤ 1
      simp [h]
    refine isUnit_iff_exists_inv.2 ⟨⟨(x : F)⁻¹, hinv⟩, Subtype.ext ?_⟩
    show (x : F) * (x : F)⁻¹ = 1
    field_simp

/-- A prime element is a nonzero element of value exactly the normalized generator $g$. -/
theorem isPrimeElt_iff_apply_eq (hd : IsDiscreteAbs v) {π : F} :
    IsPrimeElt v hd.isNonarchimedean π ↔ π ≠ 0 ∧ v π = genAbs hd := by
  have hg0 := genAbs_pos hd
  have hg1 := genAbs_lt_one hd
  constructor
  · rintro ⟨h, hirr⟩
    have hπ0 : π ≠ 0 := fun h0 => hirr.ne_zero (Subtype.ext h0)
    refine ⟨hπ0, ?_⟩
    obtain ⟨ρ, hρ0, hρ⟩ := exists_apply_eq_genAbs hd
    have hρle : v ρ ≤ 1 := hρ ▸ hg1.le
    have hnu : ¬ IsUnit (⟨π, h⟩ : integers v hd.isNonarchimedean) := hirr.not_isUnit
    rw [isUnit_integers_iff] at hnu
    obtain ⟨k, hk⟩ := exists_zpow_genAbs hd hπ0
    have hk0 : 0 < k := by
      have : genAbs hd ^ k < genAbs hd ^ (0 : ℤ) := by
        rw [← hk, zpow_zero]; exact lt_of_le_of_ne h hnu
      exact (genAbs_zpow_lt_iff hd).1 this
    have hle : v (π / ρ) ≤ 1 := by
      rw [map_div₀, hρ, hk, div_le_one hg0]
      have := (genAbs_zpow_le_iff hd (m := k) (n := 1)).2 (by omega)
      rwa [zpow_one] at this
    have hfac : (⟨π, h⟩ : integers v hd.isNonarchimedean) = ⟨ρ, hρle⟩ * ⟨π / ρ, hle⟩ :=
      Subtype.ext (by show π = ρ * (π / ρ); field_simp)
    rcases hirr.isUnit_or_isUnit hfac with hu | hu
    · rw [isUnit_integers_iff] at hu
      exact absurd hu (by simp only [hρ]; exact hg1.ne)
    · rw [isUnit_integers_iff] at hu
      simp only [map_div₀, hρ] at hu
      rw [div_eq_one_iff_eq hg0.ne'] at hu
      exact hu
  · rintro ⟨hπ0, hπ⟩
    have h : v π ≤ 1 := hπ ▸ hg1.le
    refine ⟨h, ?_, fun a b hab => ?_⟩
    · rw [isUnit_integers_iff]
      exact fun h1 => hg1.ne (hπ ▸ h1)
    · have hab' : π = (a : F) * (b : F) := congrArg (fun y : integers v hd.isNonarchimedean => (y : F)) hab
      have ha0 : (a : F) ≠ 0 := fun h0 => hπ0 (by rw [hab', h0, zero_mul])
      have hb0 : (b : F) ≠ 0 := fun h0 => hπ0 (by rw [hab', h0, mul_zero])
      obtain ⟨i, hi⟩ := exists_zpow_genAbs hd ha0
      obtain ⟨j, hj⟩ := exists_zpow_genAbs hd hb0
      have hi0 : 0 ≤ i := (genAbs_zpow_le_iff hd (m := i) (n := 0)).1 (by rw [← hi, zpow_zero]; exact a.2) |> fun h => by omega
      have hj0 : 0 ≤ j := (genAbs_zpow_le_iff hd (m := j) (n := 0)).1 (by rw [← hj, zpow_zero]; exact b.2) |> fun h => by omega
      have hsum : genAbs hd ^ (i + j) = genAbs hd ^ (1 : ℤ) := by
        rw [zpow_add₀ hg0.ne', ← hi, ← hj, ← map_mul, ← hab', hπ, zpow_one]
      have := genAbs_zpow_injective hd hsum
      by_cases hi' : i = 0
      · left
        rw [isUnit_integers_iff, hi, hi', zpow_zero]
      · right
        have : j = 0 := by omega
        rw [isUnit_integers_iff, hj, this, zpow_zero]

/-- **Prime elements and the value group** (§16, p. 38). For a discrete valuation, $\pi$ is a prime element if and
only if $\pi \ne 0$, $|\pi| < 1$ and $|\pi|$ generates the value group $|F|$. -/
@[kb "omeara1963" "§16, p. 38 (π is a prime element iff |π| generates |F|)"]
theorem isPrimeElt_iff (hd : IsDiscreteAbs v) {π : F} :
    IsPrimeElt v hd.isNonarchimedean π ↔
      π ≠ 0 ∧ v π < 1 ∧ ∀ x : F, x ≠ 0 → ∃ n : ℤ, v x = v π ^ n := by
  have hg0 := genAbs_pos hd
  have hg1 := genAbs_lt_one hd
  rw [isPrimeElt_iff_apply_eq]
  constructor
  · rintro ⟨hπ0, hπ⟩
    exact ⟨hπ0, hπ ▸ hg1, fun x hx => by rw [hπ]; exact exists_zpow_genAbs hd hx⟩
  · rintro ⟨hπ0, hlt, hgen⟩
    refine ⟨hπ0, ?_⟩
    obtain ⟨ρ, hρ0, hρ⟩ := exists_apply_eq_genAbs hd
    obtain ⟨m, hm⟩ := hgen ρ hρ0
    obtain ⟨k, hk⟩ := exists_zpow_genAbs hd hπ0
    have hk0 : 0 < k := by
      have : genAbs hd ^ k < genAbs hd ^ (0 : ℤ) := by
        rw [← hk, zpow_zero]; exact hlt
      exact (genAbs_zpow_lt_iff hd).1 this
    have h1 : genAbs hd ^ (k * m) = genAbs hd ^ (1 : ℤ) := by
      rw [zpow_mul, ← hk, ← hm, hρ, zpow_one]
    have := genAbs_zpow_injective hd h1
    have hk1 : k = 1 := Int.eq_one_of_mul_eq_one_right hk0.le this
    rw [hk, hk1, zpow_one]

/-- **Prime elements exist** (§16, p. 38). -/
theorem exists_isPrimeElt (hd : IsDiscreteAbs v) : ∃ π : F, IsPrimeElt v hd.isNonarchimedean π := by
  obtain ⟨π, hπ0, hπ⟩ := exists_apply_eq_genAbs hd
  exact ⟨π, (isPrimeElt_iff_apply_eq hd).2 ⟨hπ0, hπ⟩⟩

/-- **Prime elements differ by units** (§16, p. 38): if $\pi$ is a prime element, then $\pi'$ is a prime element if
and only if $\pi/\pi'$ is a unit, i.e. $|\pi/\pi'| = 1$. -/
theorem isPrimeElt_iff_div (hd : IsDiscreteAbs v) {π π' : F} (hπ : IsPrimeElt v hd.isNonarchimedean π) :
    IsPrimeElt v hd.isNonarchimedean π' ↔ π' ≠ 0 ∧ v (π / π') = 1 := by
  obtain ⟨hπ0, hπg⟩ := (isPrimeElt_iff_apply_eq hd).1 hπ
  rw [isPrimeElt_iff_apply_eq]
  refine and_congr_right fun hπ'0 => ?_
  have hpos : 0 < v π' := v.pos hπ'0
  rw [map_div₀, hπg, div_eq_one_iff_eq hpos.ne']
  exact eq_comm

/-- **The maximal ideal is principal** (§16, p. 38): $\mathfrak m(\mathfrak p) = \pi\,\mathfrak o(\mathfrak p)$ for
a prime element $\pi$. -/
@[kb "omeara1963" "§16, p. 38 (m(p) = π o(p))"]
theorem maximalIdealOf_eq_span (hd : IsDiscreteAbs v) {π : F} (hπ : IsPrimeElt v hd.isNonarchimedean π) :
    maximalIdealOf v hd.isNonarchimedean = Ideal.span {⟨π, hπ.1⟩} := by
  obtain ⟨hπ0, hπg⟩ := (isPrimeElt_iff_apply_eq hd).1 hπ
  have hg0 := genAbs_pos hd
  have hg1 := genAbs_lt_one hd
  ext ⟨a, ha⟩
  rw [Ideal.mem_span_singleton]
  show v a < 1 ↔ _
  constructor
  · intro hlt
    by_cases ha0 : a = 0
    · subst ha0; exact dvd_zero _
    · obtain ⟨n, hn⟩ := exists_zpow_genAbs hd ha0
      have hn0 : 0 < n := by
        have : genAbs hd ^ n < genAbs hd ^ (0 : ℤ) := by rw [← hn, zpow_zero]; exact hlt
        exact (genAbs_zpow_lt_iff hd).1 this
      have hle : v (a / π) ≤ 1 := by
        rw [map_div₀, hπg, hn, div_le_one hg0]
        have := (genAbs_zpow_le_iff hd (m := n) (n := 1)).2 (by omega)
        rwa [zpow_one] at this
      exact ⟨⟨a / π, hle⟩, Subtype.ext (by show a = π * (a / π); field_simp)⟩
  · rintro ⟨c, hc⟩
    have : a = π * (c : F) := congrArg (fun y : integers v hd.isNonarchimedean => (y : F)) hc
    have hcle : v (c : F) ≤ 1 := c.2
    rw [this, map_mul, hπg]
    calc genAbs hd * v (c : F) ≤ genAbs hd * 1 := by gcongr
      _ < 1 := by simpa using hg1

/-- The *order* $\operatorname{ord}_{\mathfrak p}\alpha$ of $\alpha \in F$ at the discrete valuation $v$ (§16, p. 38):
the exponent $\nu \in \mathbb Z$ in $\alpha = \varepsilon\pi^{\nu}$ with $\varepsilon$ a unit and $\pi$ a prime
element; it does not depend on $\pi$ (`apply_eq_zpow_ordAbs`). O'Meara puts $\operatorname{ord}_{\mathfrak p}0 =
\infty$; this definition gives $0$ there. -/
@[kb "omeara1963" "§16, p. 38 (order ord_p α)"]
noncomputable def ordAbs (v : AbsoluteValue F ℝ) (hd : IsDiscreteAbs v) (α : F) : ℤ :=
  by classical exact if h : α = 0 then 0 else Classical.choose (exists_zpow_genAbs hd h)

theorem ordAbs_zero (hd : IsDiscreteAbs v) : ordAbs v hd 0 = 0 := by simp [ordAbs]

/-- $|\alpha| = g^{\operatorname{ord}\alpha}$ for the normalized generator $g$. -/
theorem apply_eq_genAbs_zpow_ordAbs (hd : IsDiscreteAbs v) {α : F} (hα : α ≠ 0) :
    v α = genAbs hd ^ ordAbs v hd α := by
  unfold ordAbs
  split_ifs with h
  · exact absurd h hα
  · exact Classical.choose_spec (exists_zpow_genAbs hd hα)

theorem ordAbs_eq_of_apply_eq (hd : IsDiscreteAbs v) {α : F} {n : ℤ} (hα : α ≠ 0)
    (h : v α = genAbs hd ^ n) : ordAbs v hd α = n :=
  genAbs_zpow_injective hd ((apply_eq_genAbs_zpow_ordAbs hd hα).symm.trans h)

/-- **Unique factorization** $\alpha = \varepsilon\pi^{\nu}$ (§16, p. 38): for every prime element $\pi$ and
$\alpha \ne 0$, $|\alpha| = |\pi|^{\operatorname{ord}\alpha}$, and $\alpha = \varepsilon\pi^{\nu}$ with
$|\varepsilon| = 1$ holds exactly for $\nu = \operatorname{ord}\alpha$. -/
@[kb "omeara1963" "§16, p. 38 (α = ε π^ν, ν = ord_p α independent of π)"]
theorem apply_eq_zpow_ordAbs (hd : IsDiscreteAbs v) {π : F} (hπ : IsPrimeElt v hd.isNonarchimedean π)
    {α : F} (hα : α ≠ 0) :
    v α = v π ^ ordAbs v hd α ∧ ∀ ν : ℤ, v (α / π ^ ν) = 1 ↔ ν = ordAbs v hd α := by
  obtain ⟨hπ0, hπg⟩ := (isPrimeElt_iff_apply_eq hd).1 hπ
  have hg0 := genAbs_pos hd
  refine ⟨by rw [hπg]; exact apply_eq_genAbs_zpow_ordAbs hd hα, fun ν => ?_⟩
  rw [map_div₀, map_zpow₀, hπg, apply_eq_genAbs_zpow_ordAbs hd hα,
    div_eq_one_iff_eq (zpow_pos hg0 ν).ne']
  constructor
  · intro h; exact (genAbs_zpow_injective hd h).symm
  · intro h; rw [h]

/-- $\operatorname{ord}_{\mathfrak p}\alpha\beta = \operatorname{ord}_{\mathfrak p}\alpha +
\operatorname{ord}_{\mathfrak p}\beta$ (§16, p. 38). -/
theorem ordAbs_mul (hd : IsDiscreteAbs v) {α β : F} (hα : α ≠ 0) (hβ : β ≠ 0) :
    ordAbs v hd (α * β) = ordAbs v hd α + ordAbs v hd β := by
  apply ordAbs_eq_of_apply_eq hd (mul_ne_zero hα hβ)
  rw [map_mul, apply_eq_genAbs_zpow_ordAbs hd hα, apply_eq_genAbs_zpow_ordAbs hd hβ,
    zpow_add₀ (genAbs_pos hd).ne']

/-- $|\alpha| \le |\beta| \iff \operatorname{ord}\alpha \ge \operatorname{ord}\beta$ (§16, p. 38). -/
theorem apply_le_apply_iff_ordAbs (hd : IsDiscreteAbs v) {α β : F} (hα : α ≠ 0) (hβ : β ≠ 0) :
    v α ≤ v β ↔ ordAbs v hd β ≤ ordAbs v hd α := by
  rw [apply_eq_genAbs_zpow_ordAbs hd hα, apply_eq_genAbs_zpow_ordAbs hd hβ, genAbs_zpow_le_iff]

/-- $\operatorname{ord}\alpha \ge 0 \iff \alpha \in \mathfrak o(\mathfrak p)$ (§16, p. 38). -/
theorem ordAbs_nonneg_iff (hd : IsDiscreteAbs v) {α : F} (hα : α ≠ 0) :
    0 ≤ ordAbs v hd α ↔ v α ≤ 1 := by
  rw [apply_eq_genAbs_zpow_ordAbs hd hα, ← genAbs_zpow_le_iff hd (m := ordAbs v hd α) (n := 0), zpow_zero,
    ← apply_eq_genAbs_zpow_ordAbs hd hα]

/-- $\operatorname{ord}\alpha > 0 \iff \alpha \in \mathfrak m(\mathfrak p)$ (§16, p. 38). -/
theorem ordAbs_pos_iff (hd : IsDiscreteAbs v) {α : F} (hα : α ≠ 0) :
    0 < ordAbs v hd α ↔ v α < 1 := by
  rw [apply_eq_genAbs_zpow_ordAbs hd hα, ← genAbs_zpow_lt_iff hd (m := ordAbs v hd α) (n := 0), zpow_zero,
    ← apply_eq_genAbs_zpow_ordAbs hd hα]

/-- A *representative set* in $\mathfrak o(\mathfrak p)$ of the residue class field of $F$ at the non-archimedean
valuation $v$ (§16, p. 39): a set $C$ of integers containing exactly one element of each coset of
$\mathfrak o(\mathfrak p)$ modulo $\mathfrak m(\mathfrak p)$, with $0 \in C$ representing $\mathfrak m(\mathfrak p)$. -/
@[kb "omeara1963" "§16, p. 39 (representative set of the residue class field)"]
def IsRepresentativeSet (v : AbsoluteValue F ℝ) (C : Set F) : Prop :=
  0 ∈ C ∧ (∀ c ∈ C, v c ≤ 1) ∧ ∀ x : F, v x ≤ 1 → ∃! c, c ∈ C ∧ v (x - c) < 1

/-- A value strictly below $g^n$ is at most $g^{n+1}$. -/
theorem apply_le_genAbs_succ (hd : IsDiscreteAbs v) {y : F} {n : ℤ} (h : v y < genAbs hd ^ n) :
    v y ≤ genAbs hd ^ (n + 1) := by
  by_cases hy : y = 0
  · subst hy; simpa using (zpow_pos (genAbs_pos hd) _).le
  · obtain ⟨j, hj⟩ := exists_zpow_genAbs hd hy
    rw [hj, genAbs_zpow_lt_iff] at h
    rw [hj, genAbs_zpow_le_iff]
    omega

theorem apply_of_ordAbs_eq (hd : IsDiscreteAbs v) {x : F} {ν : ℤ} (hx : x ≠ 0) (h : ordAbs v hd x = ν) :
    v x = genAbs hd ^ ν := by
  rw [← h]; exact apply_eq_genAbs_zpow_ordAbs hd hx

/-- One step of the expansion: from a remainder of value $\le g^n$ we can subtract $c\pi_n$ with $c \in C$ to get a
remainder of value $\le g^{n+1}$, and $c \ne 0$ if the value was exactly $g^n$. -/
theorem expansion_step (hd : IsDiscreteAbs v) {C : Set F} (h0 : (0 : F) ∈ C)
    (hex : ∀ x : F, v x ≤ 1 → ∃ c ∈ C, v (x - c) < 1)
    (πs : ℤ → F) (hπs : ∀ ν, πs ν ≠ 0 ∧ ordAbs v hd (πs ν) = ν) (n : ℤ) (r : F) :
    ∃ c ∈ C, (v r ≤ genAbs hd ^ n →
      v (r - c * πs n) ≤ genAbs hd ^ (n + 1) ∧ (v r = genAbs hd ^ n → c ≠ 0)) := by
  by_cases hr : v r ≤ genAbs hd ^ n
  · have hg0 := genAbs_pos hd
    have hπn := apply_of_ordAbs_eq hd (hπs n).1 (hπs n).2
    have hpn : 0 < genAbs hd ^ n := zpow_pos hg0 n
    have hx : v (r / πs n) ≤ 1 := by
      rw [map_div₀, hπn, div_le_one hpn]; exact hr
    obtain ⟨c, hcC, hcv⟩ := hex _ hx
    refine ⟨c, hcC, fun _ => ⟨?_, fun hrn hc0 => ?_⟩⟩
    · have hfac : r - c * πs n = πs n * (r / πs n - c) := by field_simp [(hπs n).1]
      apply apply_le_genAbs_succ hd
      rw [hfac, map_mul, hπn]
      calc genAbs hd ^ n * v (r / πs n - c) < genAbs hd ^ n * 1 := by gcongr
        _ = _ := mul_one _
    · subst hc0
      have : v (r / πs n) = 1 := by rw [map_div₀, hπn, hrn, div_self hpn.ne']
      rw [sub_zero, this] at hcv
      exact lt_irrefl _ hcv
  · exact ⟨0, h0, fun h => absurd h hr⟩

/-- The expansion exists (existence part of 16:3). -/
theorem expansion_exists (hd : IsDiscreteAbs v) {C : Set F} (h0 : (0 : F) ∈ C)
    (hex : ∀ x : F, v x ≤ 1 → ∃ c ∈ C, v (x - c) < 1)
    (πs : ℤ → F) (hπs : ∀ ν, πs ν ≠ 0 ∧ ordAbs v hd (πs ν) = ν) {α : F} (hα : α ≠ 0) :
    ∃ c : ℕ → F, (∀ k, c k ∈ C) ∧ c 0 ≠ 0 ∧
      Tendsto (fun N => v (α - ∑ k ∈ Finset.range N, c k * πs (ordAbs v hd α + k))) atTop (𝓝 0) := by
  have hg0 := genAbs_pos hd
  have hg1 := genAbs_lt_one hd
  set m := ordAbs v hd α with hm
  choose cc hccC hccs using expansion_step hd h0 hex πs hπs
  obtain ⟨rem, hrem0, hremS⟩ : ∃ rem : ℕ → F, rem 0 = α ∧
      ∀ N : ℕ, rem (N + 1) = rem N - cc (m + N) (rem N) * πs (m + N) :=
    ⟨fun N => Nat.rec α (fun N r => r - cc (m + N) r * πs (m + N)) N, rfl, fun N => rfl⟩
  have hinv : ∀ N : ℕ, v (rem N) ≤ genAbs hd ^ (m + N) := by
    intro N
    induction N with
    | zero => rw [hrem0]; simpa using (apply_eq_genAbs_zpow_ordAbs hd hα).le
    | succ N ih =>
      rw [hremS]
      have := (hccs (m + N) (rem N) ih).1
      simpa [add_assoc] using this
  have hsum : ∀ N : ℕ, α - ∑ k ∈ Finset.range N, cc (m + k) (rem k) * πs (m + k) = rem N := by
    intro N
    induction N with
    | zero => simp [hrem0]
    | succ N ih =>
      rw [Finset.sum_range_succ, hremS, ← ih]; ring
  refine ⟨fun k => cc (m + k) (rem k), fun k => hccC _ _, ?_, ?_⟩
  · have := (hccs (m + (0 : ℕ)) (rem 0) (hinv 0)).2
    show cc (m + ((0 : ℕ) : ℤ)) (rem 0) ≠ 0
    rw [hrem0] at this ⊢
    simp only [Nat.cast_zero, add_zero] at this ⊢
    exact this (apply_eq_genAbs_zpow_ordAbs hd hα)
  · simp only [hsum]
    have h1 : Tendsto (fun N : ℕ => genAbs hd ^ (m + N)) atTop (𝓝 0) := by
      have := (tendsto_pow_atTop_nhds_zero_of_lt_one hg0.le hg1).const_mul (genAbs hd ^ m)
      simp only [mul_zero] at this
      refine this.congr fun N => ?_
      rw [zpow_add₀ hg0.ne', zpow_natCast]
    exact squeeze_zero (fun N => v.nonneg _) hinv h1

/-- Uniqueness of the expansion (uniqueness part of 16:3): two expansions of the same element with digits in $C$
coincide. -/
theorem expansion_unique (hd : IsDiscreteAbs v) {C : Set F} (hC : IsRepresentativeSet v C)
    (πs : ℤ → F) (hπs : ∀ ν, πs ν ≠ 0 ∧ ordAbs v hd (πs ν) = ν) (m : ℤ) {α : F} {c d : ℕ → F}
    (hc : ∀ k, c k ∈ C) (hd' : ∀ k, d k ∈ C)
    (tc : Tendsto (fun N => v (α - ∑ k ∈ Finset.range N, c k * πs (m + k))) atTop (𝓝 0))
    (td : Tendsto (fun N => v (α - ∑ k ∈ Finset.range N, d k * πs (m + k))) atTop (𝓝 0)) : c = d := by
  by_contra hne
  have hg0 := genAbs_pos hd
  have hg1 := genAbs_lt_one hd
  have hna := hd.isNonarchimedean
  have hex : ∃ k, c k ≠ d k := by
    by_contra h; push Not at h; exact hne (funext h)
  classical
  set i := Nat.find hex with hi
  have hi1 : c i ≠ d i := Nat.find_spec hex
  have hi2 : ∀ k < i, c k = d k := fun k hk => by
    have := Nat.find_min hex hk; push Not at this; exact this
  have hπv : ∀ k : ℕ, v (πs (m + k)) = genAbs hd ^ (m + k) := fun k =>
    apply_of_ordAbs_eq hd (hπs _).1 (hπs _).2
  have hdiff_le : ∀ k : ℕ, v (c k - d k) ≤ 1 := fun k => by
    rw [sub_eq_add_neg]
    refine (hna _ _).trans (max_le (hC.2.1 _ (hc k)) ?_)
    rw [AbsoluteValue.map_neg]; exact hC.2.1 _ (hd' k)
  have hunit : v (c i - d i) = 1 := by
    refine le_antisymm (hdiff_le i) (not_lt.1 fun hlt => hi1 ?_)
    have hx : v (c i) ≤ 1 := hC.2.1 _ (hc i)
    obtain ⟨e, -, he⟩ := hC.2.2 (c i) hx
    have h1 := he (c i) ⟨hc i, by simp⟩
    have h2 := he (d i) ⟨hd' i, hlt⟩
    exact h1.trans h2.symm
  set t : ℕ → F := fun k => (c k - d k) * πs (m + k) with ht
  have hD : ∀ N, ∑ k ∈ Finset.range N, t k =
      (α - ∑ k ∈ Finset.range N, d k * πs (m + k)) - (α - ∑ k ∈ Finset.range N, c k * πs (m + k)) := by
    intro N
    simp only [ht, sub_mul, Finset.sum_sub_distrib]; ring
  have hlim : Tendsto (fun N => v (∑ k ∈ Finset.range N, t k)) atTop (𝓝 0) := by
    simp only [hD]
    refine squeeze_zero (fun N => v.nonneg _) (fun N => v.sub_le_add _ _) ?_
    simpa using td.add tc
  have hconst : ∀ j : ℕ, v (∑ k ∈ Finset.range (i + (j + 1)), t k) = genAbs hd ^ (m + i) := by
    intro j
    rw [Finset.sum_range_add, Finset.sum_eq_zero (fun k hk => by
        simp only [ht, hi2 k (Finset.mem_range.1 hk), sub_self, zero_mul]),
      zero_add, Finset.sum_range_succ', add_comm]
    have h0 : v (t (i + 0)) = genAbs hd ^ (m + i) := by
      simp only [ht, add_zero, map_mul, hunit, one_mul, hπv]
    rw [← h0]
    apply domination_sum v hna
    intro l _
    have : v (t (i + (l + 1))) ≤ genAbs hd ^ (m + ↑(i + (l + 1))) := by
      simp only [ht, map_mul, hπv]
      calc v (c (i + (l + 1)) - d (i + (l + 1))) * genAbs hd ^ (m + ↑(i + (l + 1)))
          ≤ 1 * genAbs hd ^ (m + ↑(i + (l + 1))) := by
            gcongr; exact hdiff_le _
        _ = _ := one_mul _
    refine this.trans_lt ?_
    rw [h0, genAbs_zpow_lt_iff]
    push_cast; omega
  have hlim2 : Tendsto (fun j : ℕ => v (∑ k ∈ Finset.range (i + (j + 1)), t k)) atTop (𝓝 0) :=
    hlim.comp (tendsto_atTop_mono (fun j => (show j ≤ i + (j + 1) by omega)) tendsto_id)
  simp only [hconst] at hlim2
  have := tendsto_nhds_unique hlim2 tendsto_const_nhds
  exact (zpow_pos hg0 (m + i)).ne this

/-- **16:3.** Let $v$ be a discrete valuation of $F$, $C$ a representative set of the residue class field, and for
each $\nu \in \mathbb Z$ let $\pi_\nu \in F$ have $\operatorname{ord}\pi_\nu = \nu$. Then every $\alpha \ne 0$ in $F$
has a unique expansion $\alpha = \sum_{k \ge 0} c_k\pi_{m+k}$ with $c_k \in C$, $m = \operatorname{ord}\alpha$ and
$c_0 \ne 0$, the series converging to $\alpha$ in the topology of $v$ (stated with the partial sums:
$|\alpha - \sum_{k<N} c_k\pi_{m+k}| \to 0$). -/
@[kb "omeara1963" "§16, 16:3, p. 39"]
theorem exists_unique_expansion (hd : IsDiscreteAbs v) {C : Set F} (hC : IsRepresentativeSet v C)
    (πs : ℤ → F) (hπs : ∀ ν, πs ν ≠ 0 ∧ ordAbs v hd (πs ν) = ν) {α : F} (hα : α ≠ 0) :
    ∃! c : ℕ → F, (∀ k, c k ∈ C) ∧ c 0 ≠ 0 ∧
      Tendsto (fun N => v (α - ∑ k ∈ Finset.range N, c k * πs (ordAbs v hd α + k))) atTop (𝓝 0) := by
  obtain ⟨c, hcC, hc0, hct⟩ :=
    expansion_exists hd hC.1 (fun x hx => (hC.2.2 x hx).exists.imp fun c hc => ⟨hc.1, hc.2⟩) πs hπs hα
  exact ⟨c, ⟨hcC, hc0, hct⟩, fun c' ⟨hC', _, hct'⟩ =>
    expansion_unique hd hC πs hπs _ hC' hcC hct' hct⟩

end Discrete

section Extension

variable {F E : Type*} [Field F] [Field E] [Algebra F E]

/-- The value group of a discrete valuation is generated by its normalized generator. -/
theorem absValueGroup_eq_zpowers_genAbs {K : Type*} [Field K] {v : AbsoluteValue K ℝ} (hd : IsDiscreteAbs v) :
    absValueGroup v = Subgroup.zpowers (Units.mk0 (genAbs hd) (genAbs_pos hd).ne') := by
  ext u
  rw [Subgroup.mem_zpowers_iff]
  constructor
  · rintro ⟨x, hx, hxu⟩
    obtain ⟨n, hn⟩ := exists_zpow_genAbs hd hx
    exact ⟨n, Units.ext (by rw [Units.val_zpow_eq_zpow_val, Units.val_mk0, ← hn, hxu])⟩
  · rintro ⟨n, rfl⟩
    obtain ⟨π, hπ0, hπ⟩ := exists_apply_eq_genAbs hd
    exact ⟨π ^ n, zpow_ne_zero n hπ0, by
      rw [map_zpow₀, hπ, Units.val_zpow_eq_zpow_val, Units.val_mk0]⟩

/-- The value group of the induced valuation lies in that of $w$. -/
theorem absValueGroup_under_le (w : AbsoluteValue E ℝ) :
    absValueGroup (w.under F) ≤ absValueGroup w := by
  rintro u ⟨x, hx, hxu⟩
  exact ⟨algebraMap F E x, by simpa using hx, by rw [← hxu]; rfl⟩

/-- **16:1.** Let $E/F$ be a finite extension with spots $\mathfrak P \mid \mathfrak p$ ($w$ a valuation of $E$,
$\mathfrak p$ the spot of its restriction). Then $\mathfrak P$ is discrete if and only if $\mathfrak p$ is. -/
@[kb "omeara1963" "§16, 16:1, p. 38"]
theorem isDiscreteAbs_iff_under [FiniteDimensional F E] (w : AbsoluteValue E ℝ) :
    IsDiscreteAbs w ↔ IsDiscreteAbs (w.under F) := by
  constructor
  · intro hw
    have hg := absValueGroup_eq_zpowers_genAbs hw
    have hnt : ∃ x : F, x ≠ 0 ∧ w (algebraMap F E x) ≠ 1 := by
      by_contra h
      push Not at h
      have := eq_one_of_trivial_on_algebraic (F := F) w h
      obtain ⟨y, hy, hy1⟩ := hw.isNontrivial
      exact hy1 (this y hy)
    obtain ⟨x, hx, hx1⟩ := hnt
    have hpos : 0 < (w.under F) x := (w.under F).pos hx
    obtain ⟨g, hg1, hgg⟩ := exists_zpowers_of_le_zpowers (H := absValueGroup (w.under F))
      (h := Units.mk0 (genAbs hw) (genAbs_pos hw).ne') (by rw [← hg]; exact absValueGroup_under_le w)
      (u := Units.mk0 ((w.under F) x) hpos.ne') ⟨x, hx, rfl⟩
      (fun h => hx1 (by
        have h' := congrArg Units.val h
        simp only [Units.val_mk0, Units.val_one] at h'
        exact h'))
    exact ⟨g, fun h => hg1 (Units.ext h), hgg⟩
  · intro hv
    have hna_v := hv.isNonarchimedean
    have hna : IsNonarchimedean w := by
      rw [isNonarchimedean_iff_natCast_bounded]
      refine ⟨1, fun n => ?_⟩
      have h1 : w (n : E) = (w.under F) (n : F) := by rw [under_apply_eq]; simp
      rw [h1]; exact hna_v.apply_natCast_le_one (by simp) (map_one _)
    obtain ⟨he0, -, -⟩ := ramificationIndexAbs_mul_inertiaDegAbs_le (F := F) w hna
    have hgF := absValueGroup_eq_zpowers_genAbs hv
    have hgpos := genAbs_pos hv
    set h : ℝ := genAbs hv ^ ((ramificationIndexAbs (F := F) w : ℝ)⁻¹) with hh
    have hhpos : 0 < h := Real.rpow_pos_of_pos hgpos _
    have hhe : h ^ ramificationIndexAbs (F := F) w = genAbs hv := Real.rpow_inv_natCast_pow hgpos.le he0
    have hle : absValueGroup w ≤ Subgroup.zpowers (Units.mk0 h hhpos.ne') := by
      intro u hu
      have hu_pos : (0 : ℝ) < u := absValueGroup_le_pos w hu
      have hmem : u ^ ramificationIndexAbs (F := F) w ∈ absValueGroup (w.under F) :=
        Subgroup.pow_relIndex_mem (absValueGroup (w.under F)) hu
      rw [hgF, Subgroup.mem_zpowers_iff] at hmem
      obtain ⟨k, hk⟩ := hmem
      rw [Subgroup.mem_zpowers_iff]
      refine ⟨k, Units.ext ?_⟩
      have hk' : (u : ℝ) ^ ramificationIndexAbs (F := F) w = genAbs hv ^ k := by
        have := congrArg (fun y : ℝˣ => (y : ℝ)) hk
        simpa [Units.val_zpow_eq_zpow_val] using this.symm
      simp only [Units.val_zpow_eq_zpow_val, Units.val_mk0]
      refine ((pow_left_inj₀ hu_pos.le (zpow_pos hhpos k).le he0).1 ?_).symm
      rw [hk', ← zpow_natCast (h ^ k), ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, hhe]
    have hgF_mem : Units.mk0 (genAbs hv) hgpos.ne' ∈ absValueGroup w :=
      absValueGroup_under_le w (by rw [hgF]; exact Subgroup.mem_zpowers _)
    obtain ⟨g, hg1, hgg⟩ := exists_zpowers_of_le_zpowers hle hgF_mem
      (fun h1 => genAbs_ne_one hv (by simpa using congrArg Units.val h1))
    exact ⟨g, fun h => hg1 (Units.ext h), hgg⟩

/-- The normalized generators are related by the ramification index: $g_{\mathfrak p} = g_{\mathfrak P}^{\,e}$. -/
theorem genAbs_under_eq_pow {w : AbsoluteValue E ℝ} (hw : IsDiscreteAbs w) (hv : IsDiscreteAbs (w.under F)) :
    genAbs hv = genAbs hw ^ ramificationIndexAbs (F := F) w := by
  have hgE := absValueGroup_eq_zpowers_genAbs hw
  have hgF := absValueGroup_eq_zpowers_genAbs hv
  have hmem : Units.mk0 (genAbs hv) (genAbs_pos hv).ne' ∈
      Subgroup.zpowers (Units.mk0 (genAbs hw) (genAbs_pos hw).ne') := by
    rw [← hgE]; exact absValueGroup_under_le w (by rw [hgF]; exact Subgroup.mem_zpowers _)
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1 hmem
  have hkR : genAbs hw ^ k = genAbs hv := by
    have := congrArg (fun y : ℝˣ => (y : ℝ)) hk
    simpa [Units.val_zpow_eq_zpow_val] using this
  have hord : orderOf (Units.mk0 (genAbs hw) (genAbs_pos hw).ne') = 0 := by
    rw [orderOf_eq_zero_iff, isOfFinOrder_iff_pow_eq_one]
    rintro ⟨n, hn, h1⟩
    have h2 := congrArg (fun y : ℝˣ => (y : ℝ)) h1
    simp only [Units.val_pow_eq_pow_val, Units.val_mk0, Units.val_one] at h2
    exact (pow_lt_one₀ (genAbs_pos hw).le (genAbs_lt_one hw) hn.ne').ne h2
  have he : ramificationIndexAbs (F := F) w = k.natAbs := by
    unfold ramificationIndexAbs
    rw [hgF, ← hk, hgE, Subgroup.relIndex_zpowers_zpow, hord, Nat.cast_zero, Int.gcd_zero_right]
  have hkpos : 0 < k := by
    by_contra hk0
    have : genAbs hw ^ (0 : ℤ) ≤ genAbs hw ^ k := (genAbs_zpow_le_iff hw).2 (not_lt.1 hk0)
    rw [hkR, zpow_zero] at this
    exact absurd (genAbs_lt_one hv) (not_lt.2 this)
  rw [he, ← hkR, ← zpow_natCast, Int.natAbs_of_nonneg hkpos.le]



/-- **16:2.** Let $E/F$ be a finite extension with discrete spots $\mathfrak P \mid \mathfrak p$. Then
$\operatorname{ord}_{\mathfrak P}\alpha = e(\mathfrak P|\mathfrak p)\operatorname{ord}_{\mathfrak p}\alpha$ for all
$\alpha \in F$. -/
@[kb "omeara1963" "§16, 16:2, p. 38"]
theorem ordAbs_algebraMap [FiniteDimensional F E] {w : AbsoluteValue E ℝ} (hw : IsDiscreteAbs w)
    (hv : IsDiscreteAbs (w.under F)) (α : F) :
    ordAbs w hw (algebraMap F E α) = ramificationIndexAbs (F := F) w * ordAbs _ hv α := by
  by_cases hα : α = 0
  · subst hα; simp [ordAbs_zero]
  · apply ordAbs_eq_of_apply_eq hw (by simpa using hα)
    have h1 : w (algebraMap F E α) = genAbs hv ^ ordAbs _ hv α := apply_eq_genAbs_zpow_ordAbs hv hα
    rw [h1, genAbs_under_eq_pow hw hv, ← zpow_natCast, ← zpow_mul]

/-- In a complete non-archimedean valued field, a series whose terms tend to $0$ converges (11:9, in terms of the
valuation `v`). -/
theorem exists_sum_limit {K : Type*} [Field K] (v : AbsoluteValue K ℝ) (hna : IsNonarchimedean v)
    [CompleteSpace (WithAbs v)] (a : ℕ → K) (ha : Tendsto (fun k => v (a k)) atTop (𝓝 0)) :
    ∃ S : K, Tendsto (fun N => v (S - ∑ k ∈ Finset.range N, a k)) atTop (𝓝 0) := by
  have hna' : IsNonarchimedean (norm : WithAbs v → ℝ) := fun x y => by
    simpa [WithAbs.norm_eq_apply_ofAbs] using hna x.ofAbs y.ofAbs
  have ha' : Tendsto (fun k => WithAbs.toAbs v (a k)) atTop (𝓝 0) := by
    rw [tendsto_zero_iff_norm_tendsto_zero]
    simpa [WithAbs.norm_toAbs_eq] using ha
  have hs := (summable_of_tendsto_zero hna' ha').hasSum.tendsto_sum_nat
  refine ⟨(∑' k, WithAbs.toAbs v (a k)).ofAbs, ?_⟩
  rw [tendsto_iff_norm_sub_tendsto_zero] at hs
  have hsum : ∀ N, (∑ k ∈ Finset.range N, WithAbs.toAbs v (a k)).ofAbs = ∑ k ∈ Finset.range N, a k := by
    intro N
    induction N with
    | zero => simp
    | succ N ih => rw [Finset.sum_range_succ, Finset.sum_range_succ, WithAbs.ofAbs_add, ih]
  refine hs.congr fun N => ?_
  rw [norm_sub_rev, WithAbs.norm_eq_apply_ofAbs, WithAbs.ofAbs_sub, hsum]

/-- Every integer of $E$ is congruent modulo $\mathfrak m(\mathfrak P)$ to an $\mathfrak o(\mathfrak p)$-combination
of given $\omega_i$ whose residues span the residue class field of $E$ over that of $F$. -/
theorem exists_digit_rep {w : AbsoluteValue E ℝ} (hw : IsNonarchimedean w) {ι : Type*} [Fintype ι]
    (ω : ι → integers w hw)
    (hspan : ∀ x : residueFieldOf w hw, ∃ r : ι → residueFieldOf (w.under F) (isNonarchimedean_under hw),
        x = ∑ i, residueMap w hw (r i) * Ideal.Quotient.mk _ (ω i))
    (x : integers w hw) :
    ∃ y : ι → integers (w.under F) (isNonarchimedean_under hw),
      w ((x : E) - ∑ i, algebraMap F E ((y i : integers _ _) : F) * (ω i : E)) < 1 := by
  obtain ⟨r, hr⟩ := hspan (Ideal.Quotient.mk _ x)
  choose y hy using fun i => Ideal.Quotient.mk_surjective (I := maximalIdealOf (w.under F)
    (isNonarchimedean_under hw)) (r i)
  refine ⟨y, ?_⟩
  have h1 : (Ideal.Quotient.mk (maximalIdealOf w hw) x) =
      Ideal.Quotient.mk (maximalIdealOf w hw) (∑ i, integersRestrictMap w hw (y i) * ω i) := by
    rw [hr, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← hy i, residueMap_mk, map_mul]
  rw [Ideal.Quotient.eq] at h1
  have h2 : w (((x - ∑ i, integersRestrictMap w hw (y i) * ω i : integers w hw)) : E) < 1 := h1
  simpa [integersRestrictMap] using h2

/-- If the terms $u_k$ of a series converging to $\alpha$ are $\mathfrak o(\mathfrak p)$-combinations of the $B_i$
with coordinates tending to $0$, and $F$ is complete, then $\alpha$ is an $F$-linear combination of the $B_i$. -/
theorem mem_span_of_coordinate_series {w : AbsoluteValue E ℝ} (hw : IsNonarchimedean w)
    [CompleteSpace (WithAbs (w.under F))] {ι : Type*} [Fintype ι] (B : ι → E) (hB : ∀ i, w (B i) ≤ 1)
    (u : ℕ → E) (a : ℕ → ι → F) (hu : ∀ k, u k = ∑ i, algebraMap F E (a k i) * B i)
    (ha : ∀ i, Tendsto (fun k => (w.under F) (a k i)) atTop (𝓝 0)) {α : E}
    (hα : Tendsto (fun N => w (α - ∑ k ∈ Finset.range N, u k)) atTop (𝓝 0)) :
    α ∈ Submodule.span F (Set.range B) := by
  have hvna := isNonarchimedean_under (F := F) hw
  choose T hT using fun i => exists_sum_limit (w.under F) hvna (fun k => a k i) (ha i)
  have hP : ∀ N, ∑ k ∈ Finset.range N, u k =
      ∑ i, algebraMap F E (∑ k ∈ Finset.range N, a k i) * B i := by
    intro N
    simp only [hu, map_sum, Finset.sum_mul]
    exact Finset.sum_comm
  have hbound : ∀ N, w (α - ∑ i, algebraMap F E (T i) * B i) ≤
      w (α - ∑ k ∈ Finset.range N, u k) +
        ∑ i, (w.under F) (T i - ∑ k ∈ Finset.range N, a k i) := by
    intro N
    have hsplit : α - ∑ i, algebraMap F E (T i) * B i =
        (α - ∑ k ∈ Finset.range N, u k) +
          ∑ i, algebraMap F E (∑ k ∈ Finset.range N, a k i - T i) * B i := by
      rw [hP N]
      simp only [map_sub, sub_mul, Finset.sum_sub_distrib]
      ring
    rw [hsplit]
    refine (w.add_le _ _).trans (add_le_add le_rfl ?_)
    refine (AbsoluteValue.sum_le _ _ _).trans (Finset.sum_le_sum fun i _ => ?_)
    rw [map_mul]
    calc w (algebraMap F E (∑ k ∈ Finset.range N, a k i - T i)) * w (B i)
        ≤ w (algebraMap F E (∑ k ∈ Finset.range N, a k i - T i)) * 1 :=
          mul_le_mul_of_nonneg_left (hB i) (w.nonneg _)
      _ = (w.under F) (T i - ∑ k ∈ Finset.range N, a k i) := by
          rw [mul_one]
          show _ = w (algebraMap F E (T i - ∑ k ∈ Finset.range N, a k i))
          rw [← neg_sub (∑ k ∈ Finset.range N, a k i) (T i), map_neg, AbsoluteValue.map_neg]
  have hlim : Tendsto (fun N => w (α - ∑ k ∈ Finset.range N, u k) +
      ∑ i, (w.under F) (T i - ∑ k ∈ Finset.range N, a k i)) atTop (𝓝 0) := by
    have := hα.add (tendsto_finsetSum Finset.univ fun i _ => hT i)
    simpa using this
  have h0 : w (α - ∑ i, algebraMap F E (T i) * B i) ≤ 0 := ge_of_tendsto' hlim hbound
  have h1 : α = ∑ i, algebraMap F E (T i) * B i :=
    sub_eq_zero.1 ((AbsoluteValue.eq_zero w).1 (le_antisymm h0 (w.nonneg _)))
  rw [h1]
  refine Submodule.sum_mem _ fun i _ => ?_
  rw [← Algebra.smul_def]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)

/-- **16:4 (Theorem).** Let $E/F$ be a finite extension of degree $n$ with discrete spots $\mathfrak P \mid \mathfrak p$,
and suppose both are complete. Then $e(\mathfrak P|\mathfrak p)\,f(\mathfrak P|\mathfrak p) = n$. -/
@[kb "omeara1963" "§16, 16:4, p. 40"]
theorem ramificationIndexAbs_mul_inertiaDegAbs_eq [FiniteDimensional F E] {w : AbsoluteValue E ℝ}
    (hw : IsDiscreteAbs w) [CompleteSpace (WithAbs w)]
    [CompleteSpace (WithAbs (w.under F))] :
    ramificationIndexAbs (F := F) w * inertiaDegAbs (F := F) w hw.isNonarchimedean = Module.finrank F E := by
  have hna := hw.isNonarchimedean
  have hv := (isDiscreteAbs_iff_under (F := F) w).1 hw
  obtain ⟨he0, hf0, hle⟩ := ramificationIndexAbs_mul_inertiaDegAbs_le (F := F) w hna
  have hgpos := genAbs_pos hw
  have hg1 := genAbs_lt_one hw
  have hgFE : genAbs hv = genAbs hw ^ ramificationIndexAbs (F := F) w := genAbs_under_eq_pow hw hv
  obtain ⟨Pe, hPe0, hPe⟩ := exists_apply_eq_genAbs hw
  obtain ⟨pF, hpF0, hpF⟩ := exists_apply_eq_genAbs hv
  -- the basis of the residue class field extension and lifts
  obtain ⟨ω, hspan⟩ : ∃ ω : Fin (inertiaDegAbs (F := F) w hna) → integers w hna,
      ∀ x : residueFieldOf w hna, ∃ r : Fin (inertiaDegAbs (F := F) w hna) →
        residueFieldOf (w.under F) (isNonarchimedean_under hna),
        x = ∑ i, residueMap w hna (r i) * Ideal.Quotient.mk _ (ω i) := by
    let _ := residueAlgebra (F := F) w hna
    have : Module.Finite (residueFieldOf (w.under F) (isNonarchimedean_under hna)) (residueFieldOf w hna) :=
      Module.finite_of_finrank_pos (Nat.pos_of_ne_zero hf0)
    let bas : Module.Basis (Fin (inertiaDegAbs (F := F) w hna))
        (residueFieldOf (w.under F) (isNonarchimedean_under hna)) (residueFieldOf w hna) :=
      Module.finBasis _ _
    choose ω hω using fun i => Ideal.Quotient.mk_surjective (I := maximalIdealOf w hna) (bas i)
    refine ⟨ω, fun x => ⟨bas.repr x, ?_⟩⟩
    conv_lhs => rw [← bas.sum_repr x]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Algebra.smul_def, hω i]
    rfl
  have hdig := exists_digit_rep (F := F) hna ω hspan
  -- the representative set
  set C : Set E := {x | ∃ y : Fin (inertiaDegAbs (F := F) w hna) → F, (∀ i, (w.under F) (y i) ≤ 1) ∧
    x = ∑ i, algebraMap F E (y i) * (ω i : E)} with hC
  have h0 : (0 : E) ∈ C := ⟨0, fun i => by simp, by simp⟩
  have hex : ∀ x : E, w x ≤ 1 → ∃ c ∈ C, w (x - c) < 1 := by
    intro x hx
    obtain ⟨y, hy⟩ := hdig ⟨x, hx⟩
    exact ⟨_, ⟨fun i => (y i : F), fun i => (y i).2, rfl⟩, hy⟩
  -- the elements π_ν
  have he_pos : (0 : ℤ) < (ramificationIndexAbs (F := F) w : ℤ) := by exact_mod_cast Nat.pos_of_ne_zero he0
  have he_ne : (ramificationIndexAbs (F := F) w : ℤ) ≠ 0 := he_pos.ne'
  set e := ramificationIndexAbs (F := F) w with he
  let πs : ℤ → E := fun ν => algebraMap F E (pF ^ (ν / (e : ℤ))) * Pe ^ (ν % (e : ℤ)).toNat
  have hval : ∀ ν : ℤ, w (πs ν) = genAbs hw ^ ν := by
    intro ν
    have h1 : w (algebraMap F E (pF ^ (ν / (e : ℤ)))) = genAbs hw ^ ((e : ℤ) * (ν / (e : ℤ))) := by
      show (w.under F) (pF ^ (ν / (e : ℤ))) = _
      rw [map_zpow₀, hpF, hgFE, zpow_mul, zpow_natCast]
    have h2 : w (Pe ^ (ν % (e : ℤ)).toNat) = genAbs hw ^ (ν % (e : ℤ)) := by
      rw [map_pow, hPe, ← zpow_natCast, Int.toNat_of_nonneg (Int.emod_nonneg _ he_ne)]
    simp only [πs, map_mul, h1, h2]
    rw [← zpow_add₀ hgpos.ne', Int.mul_ediv_add_emod]
  have hπs : ∀ ν, πs ν ≠ 0 ∧ ordAbs w hw (πs ν) = ν := by
    intro ν
    have hne : πs ν ≠ 0 := by
      intro h; have := hval ν; rw [h, map_zero] at this; exact (zpow_pos hgpos ν).ne this
    exact ⟨hne, ordAbs_eq_of_apply_eq hw hne (hval ν)⟩
  let tmod : ℤ → Fin e := fun ν => ⟨(ν % (e : ℤ)).toNat, by
    have h1 := Int.emod_nonneg ν he_ne
    have h2 := Int.emod_lt_of_pos ν he_pos
    omega⟩
  let B : Fin (inertiaDegAbs (F := F) w hna) × Fin e → E := fun p => (ω p.1 : E) * Pe ^ (p.2 : ℕ)
  have hB : ∀ p, w (B p) ≤ 1 := by
    intro p
    simp only [B, map_mul, map_pow, hPe]
    calc w (ω p.1 : E) * genAbs hw ^ (p.2 : ℕ) ≤ 1 * 1 :=
          mul_le_mul (ω p.1).2 (pow_le_one₀ hgpos.le hg1.le) (pow_nonneg hgpos.le _) zero_le_one
      _ = 1 := one_mul 1
  have key : ∀ α : E, α ∈ Submodule.span F (Set.range B) := by
    intro α
    by_cases hα : α = 0
    · rw [hα]; exact Submodule.zero_mem _
    obtain ⟨c, hcC, -, hct⟩ := expansion_exists hw h0 hex πs hπs hα
    have hcC' : ∀ k, ∃ y : Fin (inertiaDegAbs (F := F) w hna) → F, (∀ i, (w.under F) (y i) ≤ 1) ∧
        c k = ∑ i, algebraMap F E (y i) * (ω i : E) := hcC
    choose b hb1 hbc using hcC'
    set m := ordAbs w hw α with hm
    let a : ℕ → Fin (inertiaDegAbs (F := F) w hna) × Fin e → F := fun k p =>
      if p.2 = tmod (m + k) then b k p.1 * pF ^ ((m + k) / (e : ℤ)) else 0
    refine mem_span_of_coordinate_series hna B hB (fun k => c k * πs (m + k)) a ?_ ?_ hct
    · intro k
      show c k * πs (m + k) = _
      rw [Fintype.sum_prod_type]
      have hin : ∀ l, ∑ μ : Fin e, algebraMap F E (a k (l, μ)) * B (l, μ) =
          algebraMap F E (b k l * pF ^ ((m + k) / (e : ℤ))) *
            ((ω l : E) * Pe ^ (tmod (m + k) : ℕ)) := by
        intro l
        rw [Finset.sum_eq_single (tmod (m + k))]
        · simp [a, B]
        · intro μ _ hμ
          simp [a, hμ]
        · intro h; exact absurd (Finset.mem_univ _) h
      rw [Finset.sum_congr rfl fun l _ => hin l, hbc k, Finset.sum_mul]
      refine Finset.sum_congr rfl fun l _ => ?_
      simp only [πs, map_mul, tmod]
      ring
    · intro p
      have hbd : ∀ k : ℕ, (w.under F) (a k p) ≤ genAbs hw ^ (m - e) * genAbs hw ^ k := by
        intro k
        simp only [a]
        split_ifs with hp
        · rw [map_mul, map_zpow₀, hpF, hgFE]
          have hbk : (w.under F) (b k p.1) ≤ 1 := hb1 k p.1
          have hq : (genAbs hw ^ e) ^ ((m + k) / (e : ℤ)) ≤ genAbs hw ^ (m - e) * genAbs hw ^ k := by
            rw [← zpow_natCast, ← zpow_mul, ← zpow_natCast (genAbs hw) k, ← zpow_add₀ hgpos.ne',
              genAbs_zpow_le_iff]
            have h1 := Int.emod_lt_of_pos (m + k) he_pos
            have h2 := Int.mul_ediv_add_emod (m + k) (e : ℤ)
            generalize (e : ℤ) * ((m + k) / (e : ℤ)) = X at *
            omega
          calc (w.under F) (b k p.1) * (genAbs hw ^ e) ^ ((m + k) / (e : ℤ))
              ≤ 1 * (genAbs hw ^ e) ^ ((m + k) / (e : ℤ)) :=
                mul_le_mul_of_nonneg_right hbk (zpow_nonneg (pow_nonneg hgpos.le _) _)
            _ ≤ _ := by rw [one_mul]; exact hq
        · rw [map_zero]
          exact mul_nonneg (zpow_nonneg hgpos.le _) (pow_nonneg hgpos.le _)
      have hlim : Tendsto (fun k : ℕ => genAbs hw ^ (m - e) * genAbs hw ^ k) atTop (𝓝 0) := by
        simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one hgpos.le hg1).const_mul (genAbs hw ^ (m - (e : ℤ)))
      exact squeeze_zero (fun k => (w.under F).nonneg _) hbd hlim
  have hspanTop : Submodule.span F (Set.range B) = ⊤ := eq_top_iff.2 fun α _ => key α
  have hcard : Module.finrank F E ≤ inertiaDegAbs (F := F) w hna * e := by
    calc Module.finrank F E = Module.finrank F (Submodule.span F (Set.range B)) := by
          rw [hspanTop, finrank_top]
      _ ≤ Fintype.card (Fin (inertiaDegAbs (F := F) w hna) × Fin e) := finrank_range_le_card B
      _ = _ := by simp
  exact le_antisymm hle (by rw [mul_comm]; exact hcard)

end Extension

