/-
# O'Meara §32B: roots of unity in the ring of integers of a local field

**Setting.** $\mathfrak o$ a local domain (`IsDomain`, `IsLocalRing`) that is Henselian (`HenselianLocalRing`; every
$\mathfrak m$-adically complete local ring is Henselian, `IsAdicComplete.henselianRing`, so the ring of integers
of a complete discretely valued field qualifies) with finite residue class field of $N\mathfrak p$ elements
(`residueCard`). These statements are stated for such rings $\mathfrak o$ (a generalization of the local-field
setting), and speak about roots of unity in $\mathfrak o$ (roots of unity of the field lie in $\mathfrak o$).

**Proves** 32:7 `residue_injOn_rootsOfUnity` (the book's proof via the derivative of $x^m - 1$ is replaced by the
identity $\prod_{k=1}^{m-1}(1 - \zeta^k) = m$), 32:8 `rootsOfUnity_residueCard_sub_one`, 32:8a
`bijOn_residue_teichmuller` (Hensel's lemma applied to $x^{N\mathfrak p - 1} - 1$ replaces the unramified
extension argument of the book).
-/
import Mathlib.RingTheory.Henselian
import Mathlib.RingTheory.RootsOfUnity.Lemmas
import Mathlib.RingTheory.RootsOfUnity.PrimitiveRoots
import Mathlib.FieldTheory.Finite.Basic
import QuadFormsKB.Citation

set_option linter.unusedSectionVars false
set_option linter.overlappingInstances false
set_option linter.style.haveILetI false

open IsLocalRing Polynomial

noncomputable section

namespace QuadFormsKB.OMeara

variable (O : Type*) [CommRing O] [IsDomain O] [IsLocalRing O]

/-- **O'Meara 32:7.** Let $\mathfrak o$ be the ring of integers of a local field and let $C$ be a cyclic subgroup of
order $m$ of $F^{\times}$ generated by a primitive $m$-th root of unity $\zeta$ (necessarily in $\mathfrak o$), with
$m$ a unit of $\mathfrak o$ (that is, $m$ prime to $N\mathfrak p$). Then distinct elements $\zeta^i$
($0 \le i < m$) of $C$ fall in distinct cosets of $\mathfrak o$ modulo $\mathfrak m$: the residue map is injective on
$C$. -/
@[kb "omeara1963" "§32B, 32:7, p. 61"]
theorem residue_injOn_rootsOfUnity {m : ℕ} {ζ : O} (hζ : IsPrimitiveRoot ζ m) (hm : IsUnit (m : O)) :
    Set.InjOn (fun i : ℕ => residue O (ζ ^ i)) (Set.Iio m) := by
  have hm0 : 0 < m := by
    rcases Nat.eq_zero_or_pos m with h | h
    · subst h; simp at hm
    · exact h
  obtain ⟨n, rfl⟩ : ∃ n, m = n + 1 := ⟨m - 1, by omega⟩
  have hmk : ((n + 1 : ℕ) : ResidueField O) ≠ 0 := by
    have := hm.map (residue O)
    simpa using this.ne_zero
  have hunit : residue O ζ ≠ 0 := by
    intro h
    have h1 : residue O ζ ^ (n + 1) = 1 := by rw [← map_pow, hζ.pow_eq_one, map_one]
    rw [h] at h1; simp at h1
  have key : ∀ i j : ℕ, i < j → j < n + 1 → residue O (ζ ^ i) = residue O (ζ ^ j) → False := by
    intro i j hij hj h
    obtain ⟨k, rfl⟩ : ∃ k, j = i + (k + 1) := ⟨j - i - 1, by omega⟩
    have hk : residue O ζ ^ (k + 1) = 1 := by
      rw [map_pow, map_pow, pow_add] at h
      have hi0 : residue O ζ ^ i ≠ 0 := pow_ne_zero _ hunit
      have := mul_left_cancel₀ hi0 (a := residue O ζ ^ i) (b := 1) (c := residue O ζ ^ (k + 1))
        (by rw [mul_one]; exact h)
      exact this.symm
    have hprod := hζ.prod_one_sub_pow_eq_order
    have hk' : k < n := by omega
    have h2 := congrArg (residue O) hprod
    rw [map_prod] at h2
    have : ∏ k ∈ Finset.range n, residue O (1 - ζ ^ (k + 1)) = 0 :=
      Finset.prod_eq_zero (Finset.mem_range.2 hk') (by simp [map_pow, hk])
    rw [this] at h2
    apply hmk
    simpa using h2.symm
  intro i hi j hj hij
  simp only [Set.mem_Iio] at hi hj
  have hij : residue O (ζ ^ i) = residue O (ζ ^ j) := hij
  rcases lt_trichotomy i j with h | h | h
  · exact (key i j h hj hij).elim
  · exact h
  · exact (key j i h hi hij.symm).elim


section Henselian

variable [HenselianLocalRing O] [Finite (ResidueField O)]

/-- The number $N\mathfrak p$ of elements of the residue class field. -/
def residueCard : ℕ := Nat.card (ResidueField O)

theorem residueCard_ge_two : 2 ≤ residueCard O := by
  have : Nontrivial (ResidueField O) := inferInstance
  have h := Finite.one_lt_card (α := ResidueField O)
  exact h

theorem cast_residueCard_sub_one_ne_zero : ((residueCard O - 1 : ℕ) : ResidueField O) ≠ 0 := by
  classical
  haveI : Fintype (ResidueField O) := Fintype.ofFinite _
  have h2 := residueCard_ge_two O
  have h0 : ((residueCard O : ℕ) : ResidueField O) = 0 := by
    rw [residueCard, Nat.card_eq_fintype_card]
    exact FiniteField.cast_card_eq_zero _
  rw [Nat.cast_sub (by omega), h0]
  simp

/-- Every nonzero residue class contains a root of $x^{N\mathfrak p - 1} - 1$ (Hensel's lemma). -/
theorem exists_root_lift (r : ResidueField O) (hr : r ≠ 0) :
    ∃ y : O, y ^ (residueCard O - 1) = 1 ∧ residue O y = r := by
  classical
  haveI : Fintype (ResidueField O) := Fintype.ofFinite _
  obtain ⟨a₀, rfl⟩ := residue_surjective r
  have h2 := residueCard_ge_two O
  set N := residueCard O - 1 with hN
  have hNpos : 0 < N := by omega
  let f : O[X] := X ^ N - 1
  have hf : f.Monic := monic_X_pow_sub_C 1 hNpos.ne'
  have hr1 : residue O a₀ ^ N = 1 := by
    have := FiniteField.pow_card_sub_one_eq_one (residue O a₀) hr
    rw [hN, residueCard, Nat.card_eq_fintype_card]; exact this
  have hev : f.eval a₀ ∈ maximalIdeal O := by
    rw [← residue_eq_zero_iff]
    simp [f, map_sub, map_pow, hr1]
  have hder : IsUnit (f.derivative.eval a₀) := by
    rw [← isUnit_map_iff (residue O)]
    have : residue O (f.derivative.eval a₀) = (N : ResidueField O) * residue O a₀ ^ (N - 1) := by
      simp [f, derivative_X_pow, map_mul, map_pow]
    rw [this]
    refine isUnit_iff_ne_zero.2 (mul_ne_zero (cast_residueCard_sub_one_ne_zero O) (pow_ne_zero _ hr))
  obtain ⟨a, ha, hadiff⟩ := HenselianLocalRing.is_henselian f hf a₀ hev hder
  refine ⟨a, ?_, ?_⟩
  · simpa [f, sub_eq_zero] using ha
  · have : residue O (a - a₀) = 0 := (residue_eq_zero_iff _).2 hadiff
    rw [map_sub, sub_eq_zero] at this
    exact this


theorem isUnit_residueCard_sub_one : IsUnit ((residueCard O - 1 : ℕ) : O) := by
  rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
  simpa using cast_residueCard_sub_one_ne_zero O

/-- A primitive $(N\mathfrak p - 1)$-st root of unity exists in $\mathfrak o$. -/
theorem exists_isPrimitiveRoot_residueCard_sub_one :
    ∃ ζ : O, IsPrimitiveRoot ζ (residueCard O - 1) := by
  classical
  haveI : Fintype (ResidueField O) := Fintype.ofFinite _
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := (ResidueField O)ˣ)
  obtain ⟨y, hy1, hy2⟩ := exists_root_lift O (g : ResidueField O) g.ne_zero
  have hord : orderOf g = residueCard O - 1 := by
    rw [orderOf_eq_card_of_forall_mem_zpowers hg, Nat.card_units, residueCard]
  refine ⟨y, ⟨hy1, fun l hl => ?_⟩⟩
  have : g ^ l = 1 := by
    apply Units.ext
    have := congrArg (residue O) hl
    simpa [map_pow, hy2] using this
  rw [← hord]
  exact orderOf_dvd_of_pow_eq_one this

/-- **O'Meara 32:8a.** The $(N\mathfrak p - 1)$-st roots of unity together with $0$ form a representative set in
$\mathfrak o$ of the residue class field: the residue map is a bijection from $\{0\} \cup \mu_{N\mathfrak p - 1}$
onto the residue class field. -/
@[kb "omeara1963" "§32B, 32:8a, p. 62"]
theorem bijOn_residue_teichmuller :
    Set.BijOn (residue O) ({0} ∪ {y : O | y ^ (residueCard O - 1) = 1}) Set.univ := by
  have h2 := residueCard_ge_two O
  have hNpos : 0 < residueCard O - 1 := by omega
  have hroot_ne : ∀ y : O, y ^ (residueCard O - 1) = 1 → residue O y ≠ 0 := by
    intro y hy h
    have := congrArg (residue O) hy
    rw [map_pow, h, zero_pow hNpos.ne', map_one] at this
    exact zero_ne_one this
  refine ⟨fun _ _ => Set.mem_univ _, ?_, ?_⟩
  · obtain ⟨ζ, hζ⟩ := exists_isPrimitiveRoot_residueCard_sub_one O
    have hu := isUnit_residueCard_sub_one O
    have inj := residue_injOn_rootsOfUnity O hζ hu
    haveI : NeZero (residueCard O - 1) := NeZero.of_pos hNpos
    rintro a (ha | ha) b (hb | hb) hab
    · rw [ha, hb]
    · exfalso
      simp only [Set.mem_singleton_iff] at ha
      subst ha
      exact hroot_ne b hb (by simpa using hab.symm)
    · exfalso
      simp only [Set.mem_singleton_iff] at hb
      subst hb
      exact hroot_ne a ha (by simpa using hab)
    · obtain ⟨i, hi, rfl⟩ := hζ.eq_pow_of_pow_eq_one ha
      obtain ⟨j, hj, rfl⟩ := hζ.eq_pow_of_pow_eq_one hb
      rw [inj hi hj hab]
  · intro r _
    by_cases hr : r = 0
    · exact ⟨0, Or.inl rfl, by simp [hr]⟩
    · obtain ⟨y, hy1, hy2⟩ := exists_root_lift O r hr
      exact ⟨y, Or.inr hy1, hy2⟩

/-- **O'Meara 32:8.** The group of $(N\mathfrak p - 1)$-st roots of unity of $\mathfrak o$ is cyclic of order
$N\mathfrak p - 1$ (so $\mathfrak o$ contains a primitive $(N\mathfrak p - 1)$-st root of unity), and every root of
unity of $\mathfrak o$ whose period $n$ is prime to $N\mathfrak p$ (a unit of $\mathfrak o$) is one of them:
$n \mid N\mathfrak p - 1$. -/
@[kb "omeara1963" "§32B, 32:8, p. 62"]
theorem rootsOfUnity_residueCard_sub_one :
    (∃ ζ : O, IsPrimitiveRoot ζ (residueCard O - 1)) ∧
    ∀ (y : O) (n : ℕ), IsPrimitiveRoot y n → IsUnit (n : O) → n ∣ residueCard O - 1 := by
  refine ⟨exists_isPrimitiveRoot_residueCard_sub_one O, fun y n hy hn => ?_⟩
  classical
  haveI : Fintype (ResidueField O) := Fintype.ofFinite _
  have hn0 : 0 < n := by
    rcases Nat.eq_zero_or_pos n with h | h
    · subst h; simp at hn
    · exact h
  have inj := residue_injOn_rootsOfUnity O hy hn
  have hne : residue O y ≠ 0 := by
    intro h
    have h1 := congrArg (residue O) hy.pow_eq_one
    rw [map_pow, h, zero_pow hn0.ne', map_one] at h1
    exact zero_ne_one h1
  let u : (ResidueField O)ˣ := Units.mk0 _ hne
  have hord : orderOf u = n := by
    rw [orderOf_eq_iff hn0]
    refine ⟨?_, fun m hm hm0 h => ?_⟩
    · apply Units.ext; simp [u, ← map_pow, hy.pow_eq_one]
    · have h1 : residue O (y ^ m) = residue O (y ^ 0) := by
        have := congrArg (fun z : (ResidueField O)ˣ => (z : ResidueField O)) h
        simpa [u, map_pow] using this
      have := inj hm hn0 h1
      omega
  rw [← hord]
  have := orderOf_dvd_card (G := (ResidueField O)ˣ) (x := u)
  rwa [← Nat.card_eq_fintype_card, Nat.card_units, ← residueCard] at this

end Henselian

end QuadFormsKB.OMeara
