/-
# O'Meara 103:5: finitely many spaces carry a lattice of integral scale and given volume

**Setting.** $F$ is a number field with ring of integers $\mathfrak o = \mathcal O_F$, $V = F^n$ with a form
`Q : QuadForm F n` (O'Meara's $B$ = `OMeara.bil Q.toQuadraticForm`, $B(x,x) = Q(x)$), $L$ a lattice on $V$ (`Lat F n`),
and $\mathfrak c$ a fixed integral ideal of $\mathfrak o$.

**Proves** `omeara103_5_holds : OMeara103_5 F n c` (O'Meara 1973, Remark 103:5, pp. 310–311): the nondegenerate
$Q$ carrying a lattice $L$ with $\mathfrak sL \subseteq \mathfrak o$ and $\mathfrak vL = \mathfrak c$ fall into finitely
many isometry classes over $F$.

**Route** (O'Meara's argument, with one simplification in the global step).
1. *Discriminants.* Write $L = \mathfrak a_0y_0 + \dots + \mathfrak a_{n-1}y_{n-1}$ (adapted base, 81:3). Then
   $\mathfrak c = \mathfrak vL = \mathfrak b^2\,d(y)\,\mathfrak o$ with $\mathfrak b = \prod_i\mathfrak a_i$ (§82E), and
   $\det H_Q = 2^n\det(y)^{-2}d(y)$. Scaling, $\mathfrak b$ may be taken integral. For two such data with $\mathfrak b,
   \mathfrak b'$ in the same ideal class, $d(y)/d(y')$ is a unit of $\mathfrak o$ times a square; since the class
   group is finite and $\mathfrak o^\times/\mathfrak o^{\times2}$ is finite (Dirichlet's unit theorem), $\det H_Q$ lies in
   one of finitely many square classes (`exists_finite_disc_classes`). *Update (simplification):* O'Meara enlarges $T$
   so that $J_F = P_FJ_F^T$ (33:14a) and uses $\mathfrak u(T)/\mathfrak u(T)^2$ (65:6); here $T = \emptyset$ suffices,
   the class group being handled by the pigeonhole principle on ideal classes.
2. *Good primes.* At a non-dyadic $\mathfrak p \nmid \mathfrak c$ the localization $L_{\mathfrak p}$ (at the localization of
   $\mathfrak o$, `OMeara.locLat`) is unimodular, so it has an orthogonal base with unit lengths (§92, p. 246), whence
   $Q \cong \langle\varepsilon_0, \dots, \varepsilon_{n-1}\rangle$ over $F$ with $\mathfrak p$-adic units $\varepsilon_i$ and
   the Hasse invariant at $\mathfrak p$ is $1$ (63:12) (`hasseSerreForm_eq_one_of_good`).
3. *Finitely many local invariants* at the remaining finitely many places (Hasse invariants $\pm1$, negative indices
   $\le n$), and the classification 63:20 at every place (`NFPlace.isometric_iff_general`) together with the
   Hasse–Minkowski theorem (66:4, `Tamagawa.FormClassNF.isometricIn_of_everywhere_nf`) give finitely many classes.
-/
import QuadFormsKB.Literature.OMeara.Sec102To104
import QuadFormsKB.Tamagawa.FormClassNF
import QuadFormsKB.Literature.LocalGlobal.LocalClassificationGeneralNF
import QuadFormsKB.Literature.OMeara.Sec92
import QuadFormsKB.Literature.OMeara.Sec82Local
import QuadFormsKB.Tamagawa.SquareClassDuality
import QuadFormsKB.Literature.OMeara.Sec104LocalMod

open NumberField IsDedekindDomain Matrix
open scoped nonZeroDivisors

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.Lattices.Sec103Five

variable {F : Type} [Field F] [NumberField F]

/-! ### Units modulo squares and discriminant classes -/

/-- **$\mathfrak o^\times/\mathfrak o^{\times2}$ is finite** (Dirichlet's unit theorem): there is a finite set $U \subseteq
F^\times$ such that every unit $u$ of $\mathcal O_F$ is $u = u_0w^2$ with $u_0 \in U$ and $w \in F^\times$. -/
theorem exists_finite_unit_sq_reps :
    ∃ U : Set F, U.Finite ∧ (0 : F) ∉ U ∧
      ∀ u : (𝓞 F)ˣ, ∃ u₀ ∈ U, ∃ w : F, w ≠ 0 ∧ ((u : 𝓞 F) : F) = u₀ * w ^ 2 := by
  classical
  let f : (Units.torsion F) × (Fin (Units.rank F) → Fin 2) → F := fun p =>
    (((p.1 : (𝓞 F)ˣ) * ∏ i, Units.fundSystem F i ^ ((p.2 i : ℕ)) : (𝓞 F)ˣ) : 𝓞 F)
  refine ⟨Set.range f, Set.finite_range f, ?_, fun u => ?_⟩
  · rintro ⟨p, hp⟩
    simp only [f] at hp
    exact (Units.ne_zero _) (by exact_mod_cast hp)
  obtain ⟨⟨ζ, e⟩, he, -⟩ := Units.exist_unique_eq_mul_prod F u
  have hb : ∀ i, (e i % 2).toNat < 2 := fun i => by omega
  let b : Fin (Units.rank F) → Fin 2 := fun i => ⟨(e i % 2).toNat, hb i⟩
  let w : (𝓞 F)ˣ := ∏ i, Units.fundSystem F i ^ (e i / 2)
  have key : u = (ζ : (𝓞 F)ˣ) * (∏ i, Units.fundSystem F i ^ ((b i : ℕ))) * w ^ 2 := by
    rw [he, mul_assoc]
    congr 1
    simp only [w, b, ← Finset.prod_pow, ← Finset.prod_mul_distrib]
    refine Finset.prod_congr rfl fun i _ => ?_
    rw [← zpow_natCast, ← zpow_natCast, ← _root_.zpow_mul, ← _root_.zpow_add]
    congr 1
    have h0 : 0 ≤ e i % 2 := Int.emod_nonneg _ two_ne_zero
    rw [Int.toNat_of_nonneg h0]
    push_cast
    omega
  refine ⟨f (ζ, b), ⟨_, rfl⟩, ((w : 𝓞 F) : F), ?_, ?_⟩
  · exact_mod_cast Units.ne_zero w
  · conv_lhs => rw [key]
    simp only [f]
    push_cast
    rfl

/-- Notation-free abbreviation: the fractional ideal $\delta\mathfrak o$ of $F$ generated by $\delta \in F$. -/
abbrev sp (δ : F) : FractionalIdeal (𝓞 F)⁰ F := FractionalIdeal.spanSingleton (𝓞 F)⁰ δ

/-- **Finitely many discriminant classes** (the global step of O'Meara 103:5): for a fixed integral ideal
$\mathfrak c$ of $\mathcal O_F$ there is a finite set $\Delta \subseteq F^\times$ such that whenever
$\mathfrak c = \mathfrak b^2\,\delta\mathfrak o$ with $\mathfrak b$ a non-zero integral ideal and $\delta \in F^\times$,
the class of $\delta$ in $F^\times/F^{\times2}$ is that of some $\delta_0 \in \Delta$ ($\delta/\delta_0$ is a square).

*Proof.* For each ideal class $\kappa$ fix one such $(\mathfrak b_\kappa, \delta_\kappa)$ with $[\mathfrak b_\kappa] = \kappa$
(if any). If $[\mathfrak b] = [\mathfrak b_\kappa]$ then $x\mathfrak b = y\mathfrak b_\kappa$ for some $x, y \ne 0$, so
$x^2\delta_\kappa\mathfrak o = y^2\delta\mathfrak o$ (cancel $\mathfrak c \ne 0$), i.e. $\delta = z\,\delta_\kappa\,(x/y)^2$ with
$z \in \mathcal O_F^\times$; write $z = u_0w^2$ (`exists_finite_unit_sq_reps`). Take
$\Delta = \{u_0\delta_\kappa\}$. -/
theorem exists_finite_disc_classes (c : Ideal (𝓞 F)) :
    ∃ Δ : Set F, Δ.Finite ∧ (0 : F) ∉ Δ ∧ ∀ J : Ideal (𝓞 F), J ≠ ⊥ → ∀ δ : F, δ ≠ 0 →
      (J : FractionalIdeal (𝓞 F)⁰ F) ^ 2 * sp δ = c → ∃ δ₀ ∈ Δ, IsSquare (δ / δ₀) := by
  classical
  obtain ⟨U, hU, hU0, hUrep⟩ := exists_finite_unit_sq_reps (F := F)
  have hrep : ∀ κ : ClassGroup (𝓞 F), ∃ r : F, (∃ J : Ideal (𝓞 F), ∃ hJ : J ≠ ⊥, ∃ δ : F, δ ≠ 0 ∧
      (J : FractionalIdeal (𝓞 F)⁰ F) ^ 2 * sp δ = c ∧
        ClassGroup.mk0 ⟨J, mem_nonZeroDivisors_of_ne_zero hJ⟩ = κ) →
      r ≠ 0 ∧ ∃ J : Ideal (𝓞 F), ∃ hJ : J ≠ ⊥, (J : FractionalIdeal (𝓞 F)⁰ F) ^ 2 * sp r = c ∧
        ClassGroup.mk0 ⟨J, mem_nonZeroDivisors_of_ne_zero hJ⟩ = κ := by
    intro κ
    by_cases h : ∃ J : Ideal (𝓞 F), ∃ hJ : J ≠ ⊥, ∃ δ : F, δ ≠ 0 ∧
        (J : FractionalIdeal (𝓞 F)⁰ F) ^ 2 * sp δ = c ∧
          ClassGroup.mk0 ⟨J, mem_nonZeroDivisors_of_ne_zero hJ⟩ = κ
    · obtain ⟨J, hJ, δ, hδ, he, hk⟩ := h
      exact ⟨δ, fun _ => ⟨hδ, J, hJ, he, hk⟩⟩
    · exact ⟨1, fun h' => absurd h' h⟩
  choose r hr using hrep
  refine ⟨Set.image2 (· * ·) U (Set.range r ∩ {x | x ≠ 0}),
    hU.image2 _ ((Set.finite_range r).subset Set.inter_subset_left), ?_, ?_⟩
  · rintro ⟨u₀, hu₀, x, ⟨-, hx0⟩, h⟩
    rcases mul_eq_zero.mp h with h | h
    · exact hU0 (h ▸ hu₀)
    · exact hx0 h
  intro J hJ δ hδ he
  set κ := ClassGroup.mk0 ⟨J, mem_nonZeroDivisors_of_ne_zero hJ⟩
  obtain ⟨hr0, J', hJ', he', hk'⟩ := hr κ ⟨J, hJ, δ, hδ, he, rfl⟩
  obtain ⟨x, y, hx, hy, hxy⟩ := ClassGroup.mk0_eq_mk0_iff.mp hk'
  -- in fractional ideals: `x J' = y J`
  have hX : sp (x : F) * (J' : FractionalIdeal (𝓞 F)⁰ F) = sp (y : F) * (J : FractionalIdeal (𝓞 F)⁰ F) := by
    have := congrArg (fun I : Ideal (𝓞 F) => (I : FractionalIdeal (𝓞 F)⁰ F)) hxy
    simpa only [FractionalIdeal.coeIdeal_mul, FractionalIdeal.coeIdeal_span_singleton] using this
  have hc0 : (c : FractionalIdeal (𝓞 F)⁰ F) ≠ 0 := by
    rw [← he]
    refine mul_ne_zero (pow_ne_zero _ (FractionalIdeal.coeIdeal_ne_zero.mpr hJ)) ?_
    exact (FractionalIdeal.spanSingleton_ne_zero_iff).mpr hδ
  have key : sp ((y : F) ^ 2 * r κ) * (c : FractionalIdeal (𝓞 F)⁰ F) =
      sp ((x : F) ^ 2 * δ) * (c : FractionalIdeal (𝓞 F)⁰ F) := by
    calc sp ((y : F) ^ 2 * r κ) * (c : FractionalIdeal (𝓞 F)⁰ F)
        = (sp (y : F) * (J : FractionalIdeal (𝓞 F)⁰ F)) ^ 2 * (sp (r κ) * sp δ) := by
          rw [← he]; simp only [sp, map_mul, map_pow]; ring
      _ = (sp (x : F) * (J' : FractionalIdeal (𝓞 F)⁰ F)) ^ 2 * (sp (r κ) * sp δ) := by rw [hX]
      _ = sp ((x : F) ^ 2 * δ) * (c : FractionalIdeal (𝓞 F)⁰ F) := by
          rw [← he']; simp only [sp, map_mul, map_pow]; ring
  have h1 := mul_right_cancel₀ hc0 key
  obtain ⟨z, hz⟩ := (FractionalIdeal.spanSingleton_eq_spanSingleton).mp h1
  obtain ⟨u₀, hu₀, w, hw0, hzw⟩ := hUrep z
  have hxF : (x : F) ≠ 0 := by exact_mod_cast hx
  have hyF : (y : F) ≠ 0 := by exact_mod_cast hy
  have hu₀0 : u₀ ≠ 0 := fun h => hU0 (h ▸ hu₀)
  refine ⟨u₀ * r κ, ⟨u₀, hu₀, r κ, ⟨⟨κ, rfl⟩, hr0⟩, rfl⟩, ⟨w * y / x, ?_⟩⟩
  have hz' : ((z : 𝓞 F) : F) * ((y : F) ^ 2 * r κ) = (x : F) ^ 2 * δ := by
    rw [← hz, Units.smul_def, Algebra.smul_def]
  rw [hzw] at hz'
  field_simp
  linear_combination -hz'

/-! ### O'Meara's bilinear form and the Hessian -/

section Forms

variable {n : ℕ} (Q : QuadForm F n)

/-- **O'Meara's $B$ in terms of the Hessian:** $B(x, y) = \tfrac12\,x^{\mathsf T}Hy$ for $x, y \in F^n$, where
$H = C + C^{\mathsf T}$ is the Hessian of $Q$ (`QuadForm.hessian`) and $B$ = `OMeara.bil Q.toQuadraticForm`. -/
theorem bil_eq_hessian (x y : Fin n → F) :
    OMeara.bil Q.toQuadraticForm x y = (x ⬝ᵥ (Q.hessian *ᵥ y)) / 2 := by
  rw [OMeara.bil_eq_half, QuadForm.toQuadraticForm_apply, QuadForm.toQuadraticForm_apply,
    QuadForm.toQuadraticForm_apply]
  have h := QuadForm.polar_eq_hessian F Q x y
  rw [ClassFin.hessian_map_id] at h
  unfold QuadForm.eval
  rw [h]

/-- **The matrix of a family in terms of the Hessian:** for vectors $y_0, \dots, y_{n-1} \in F^n$ (the rows of
$Y$ = `Matrix.of y`), $(B(y_i, y_j))_{ij} = \tfrac12\,YHY^{\mathsf T}$. -/
theorem gram_eq_hessian (y : Fin n → Fin n → F) :
    OMeara.gram Q.toQuadraticForm y = (1 / 2 : F) • (Matrix.of y * Q.hessian * (Matrix.of y)ᵀ) := by
  ext i j
  simp only [OMeara.gram, Matrix.of_apply, bil_eq_hessian, Matrix.smul_apply, smul_eq_mul,
    Matrix.mul_apply, Matrix.transpose_apply, dotProduct, Matrix.mulVec, Finset.mul_sum, Finset.sum_mul,
    Finset.sum_div]
  rw [Finset.sum_comm (f := fun x x_1 => 1 / 2 * (y i x_1 * Q.hessian x_1 x * y j x))]
  refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun l _ => ?_
  ring

/-- **The discriminant of a family:** $\det(B(y_i, y_j)) = 2^{-n}\det(Y)^2\det H$. -/
theorem det_gram_eq (y : Fin n → Fin n → F) :
    (OMeara.gram Q.toQuadraticForm y).det = (1 / 2 : F) ^ n * (Matrix.of y).det ^ 2 * Q.hessian.det := by
  rw [gram_eq_hessian, Matrix.det_smul, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, Fintype.card_fin]
  ring

/-- **A diagonal form from an orthogonal family:** if $b_0, \dots, b_{n-1} \in F^n$ are pairwise orthogonal for $B$
(hypothesis `horth`) with $Q(b_i) \ne 0$ (hypothesis `hb`), then $Q \cong \langle Q(b_0), \dots, Q(b_{n-1})\rangle$ over $F$
(the change of variables is the matrix with columns $b_i$, invertible since $\det(B(b_i, b_j)) = \prod_i Q(b_i) \ne 0$). -/
theorem isometricIn_diag_of_orth (b : Fin n → Fin n → F)
    (horth : ∀ i j, i ≠ j → OMeara.bil Q.toQuadraticForm (b i) (b j) = 0)
    (hb : ∀ i, Q.toQuadraticForm (b i) ≠ 0) :
    Q.IsometricIn F (QuadForm.diag fun i => Q.toQuadraticForm (b i)) := by
  classical
  have hgram : OMeara.gram Q.toQuadraticForm b = Matrix.diagonal fun i => Q.toQuadraticForm (b i) := by
    ext i j
    by_cases hij : i = j
    · subst hij; simp [OMeara.gram]
    · simp [OMeara.gram, Matrix.diagonal_apply_ne _ hij, horth i j hij]
  have hdet := det_gram_eq Q b
  rw [hgram, Matrix.det_diagonal] at hdet
  have hprod : ∏ i, Q.toQuadraticForm (b i) ≠ 0 := Finset.prod_ne_zero_iff.mpr fun i _ => hb i
  have hB : (Matrix.of b).det ≠ 0 := by
    intro h0; rw [h0] at hdet; simp at hdet; exact hprod hdet
  refine ⟨(Matrix.of b)ᵀ, by rw [Matrix.det_transpose]; exact isUnit_iff_ne_zero.mpr hB, fun x => ?_⟩
  have hPx : (Matrix.of b)ᵀ *ᵥ x = ∑ i, x i • b i := by
    ext r
    simp [Matrix.mulVec, dotProduct, Finset.sum_apply, mul_comm]
  rw [QuadForm.evalIn_diag, hPx]
  change Q.eval _ = _
  rw [← QuadForm.toQuadraticForm_apply, ← OMeara.bil_self, OMeara.bil_sum_left]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [OMeara.bil_sum_right, Finset.sum_eq_single i]
  · rw [OMeara.bil_smul_left, OMeara.bil_smul_right, OMeara.bil_self, Algebra.algebraMap_self,
      RingHom.id_apply]; ring
  · intro j _ hji
    rw [OMeara.bil_smul_left, OMeara.bil_smul_right, horth i j (Ne.symm hji)]; ring
  · simp

/-- **The discriminant of $Q$ from a lattice of volume $\mathfrak c$** (O'Meara 1963, §82E, p. 229): if the lattice $L$
on $V = F^n$ has volume $\mathfrak vL = \mathfrak c$ (hypothesis `hv`) and $Q$ is nondegenerate (hypothesis `hQ`), then
$\mathfrak c = \mathfrak b^2\,\delta\mathfrak o$ for a non-zero integral ideal $\mathfrak b$ and $\delta \in F^\times$ with
$\det H_Q / (2^n\delta)$ a square. (From an adapted base $L = \sum_i\mathfrak a_iy_i$: $\mathfrak vL =
(\prod_i\mathfrak a_i)^2\,d(y)$, $d(y) = 2^{-n}\det(Y)^2\det H_Q$, and $\prod_i\mathfrak a_i = m^{-1}\mathfrak b$ with
$\mathfrak b$ integral.) -/
theorem exists_ideal_disc (hQ : Q.Nondegenerate) (L : Lat F n) (c : Ideal (𝓞 F))
    (hv : OMeara.volume Q.toQuadraticForm L.1 = ((c : FractionalIdeal (𝓞 F)⁰ F) : Submodule (𝓞 F) F)) :
    ∃ J : Ideal (𝓞 F), J ≠ ⊥ ∧ ∃ δ : F, δ ≠ 0 ∧ (J : FractionalIdeal (𝓞 F)⁰ F) ^ 2 * sp δ = c ∧
      IsSquare (Q.hessian.det / (2 ^ n * δ)) := by
  classical
  obtain ⟨r, y, hy, hspan, a, ha, hLeq⟩ := OMeara.exists_adapted (R := 𝓞 F) (F := F) L.2.fg
  have hspan' : Submodule.span F (Set.range y) = ⊤ := hspan.trans L.2.span_eq_top
  have hr : r = n := by
    have := Module.finrank_eq_card_basis (Module.Basis.mk hy hspan'.ge)
    simpa using this.symm
  subst hr
  have hvol := OMeara.volume_eq_of_adapted Q.toQuadraticForm y hy a ha
  rw [← hLeq, hv] at hvol
  -- the fractional ideals `a i` and their product
  let A : Fin r → FractionalIdeal (𝓞 F)⁰ F := fun i => ⟨a i, FractionalIdeal.isFractional_of_fg (ha i).1⟩
  have hA0 : ∀ i, A i ≠ 0 := fun i h => (ha i).2 (by
    have := congrArg (fun I : FractionalIdeal (𝓞 F)⁰ F => (I : Submodule (𝓞 F) F)) h
    simpa [A] using this)
  set B : FractionalIdeal (𝓞 F)⁰ F := ∏ i, A i with hBdef
  have hB0 : B ≠ 0 := Finset.prod_ne_zero_iff.mpr fun i _ => hA0 i
  set δy := (OMeara.gram Q.toQuadraticForm y).det with hδy
  have hBc : B ^ 2 * sp δy = c := by
    apply FractionalIdeal.coeToSubmodule_injective
    show ((B ^ 2 * sp δy : FractionalIdeal (𝓞 F)⁰ F) : Submodule (𝓞 F) F) =
      ((c : FractionalIdeal (𝓞 F)⁰ F) : Submodule (𝓞 F) F)
    rw [FractionalIdeal.coe_mul, FractionalIdeal.coe_pow, FractionalIdeal.coe_spanSingleton, hvol]
    congr 2
    have := map_prod (FractionalIdeal.coeSubmoduleHom (𝓞 F)⁰ F) A Finset.univ
    exact this.trans (Finset.prod_congr rfl fun i _ => rfl)
  -- `B = m⁻¹ J` with `J` integral
  obtain ⟨m, J, hm, hBJ⟩ := FractionalIdeal.exists_eq_spanSingleton_mul B
  have hmF : algebraMap (𝓞 F) F m ≠ 0 := by
    simpa using hm
  have hJ : J ≠ ⊥ := by
    rintro rfl
    apply hB0
    rw [hBJ, FractionalIdeal.coeIdeal_bot, mul_zero]
  have hY : (Matrix.of y).det ≠ 0 :=
    ((Matrix.isUnit_iff_isUnit_det _).mp (Matrix.linearIndependent_row_iff_isUnit.mp hy)).ne_zero
  have hδy0 : δy ≠ 0 := by
    rw [hδy, det_gram_eq]
    exact mul_ne_zero (mul_ne_zero (pow_ne_zero _ (by norm_num)) (pow_ne_zero _ hY)) hQ
  refine ⟨J, hJ, (algebraMap (𝓞 F) F m)⁻¹ ^ 2 * δy, mul_ne_zero (pow_ne_zero _ (inv_ne_zero hmF)) hδy0, ?_, ?_⟩
  · rw [← hBc, hBJ]
    show (J : FractionalIdeal (𝓞 F)⁰ F) ^ 2 *
        FractionalIdeal.spanSingleton (𝓞 F)⁰ ((algebraMap (𝓞 F) F m)⁻¹ ^ 2 * δy) =
      (FractionalIdeal.spanSingleton (𝓞 F)⁰ (algebraMap (𝓞 F) F m)⁻¹ * (J : FractionalIdeal (𝓞 F)⁰ F)) ^ 2 *
        FractionalIdeal.spanSingleton (𝓞 F)⁰ δy
    rw [map_mul, map_pow]
    ring
  · refine ⟨algebraMap (𝓞 F) F m / (Matrix.of y).det, ?_⟩
    have hH : Q.hessian.det ≠ 0 := hQ
    rw [hδy, det_gram_eq]
    field_simp
    rw [← mul_pow]; norm_num

end Forms

/-! ### The good primes -/

section Good

variable {n : ℕ} (Q : QuadForm F n)

/-- **Units of the localization are valuation units:** for a prime $\mathfrak p$ of $\mathcal O_F$ (`v`), every unit $s$ of
the localization $\mathfrak o_{(\mathfrak p)} \subseteq F$ (`OMeara.locRing F 𝔭`) has $|s|_{\mathfrak p} = 1$. -/
theorem valuation_eq_one_of_isUnit (v : HeightOneSpectrum (𝓞 F)) {s : OMeara.locRing F v.asIdeal}
    (hs : IsUnit s) : v.valuation F (s : F) = 1 := by
  have hle : ∀ t : OMeara.locRing F v.asIdeal, v.valuation F (t : F) ≤ 1 := by
    intro t
    obtain ⟨⟨r, u⟩, h⟩ := IsLocalization.surj v.asIdeal.primeCompl t
    have h' : (t : F) * algebraMap (𝓞 F) F u = algebraMap (𝓞 F) F r := by
      have := congrArg (fun z : OMeara.locRing F v.asIdeal => (z : F)) h
      simpa using this
    have hu : v.valuation F (algebraMap (𝓞 F) F u) = 1 := by
      rw [HeightOneSpectrum.valuation_of_algebraMap, HeightOneSpectrum.intValuation_eq_one_iff]
      exact u.2
    have := congrArg (v.valuation F) h'
    rw [map_mul, hu, mul_one] at this
    rw [this]
    exact HeightOneSpectrum.valuation_le_one v r
  obtain ⟨u, rfl⟩ := hs
  have h1 : v.valuation F ((u : OMeara.locRing F v.asIdeal) : F) *
      v.valuation F (((u⁻¹ : (OMeara.locRing F v.asIdeal)ˣ) : OMeara.locRing F v.asIdeal) : F) = 1 := by
    rw [← map_mul]
    have : ((u : OMeara.locRing F v.asIdeal) : F) *
        (((u⁻¹ : (OMeara.locRing F v.asIdeal)ˣ) : OMeara.locRing F v.asIdeal) : F) = 1 := by
      rw [← Subalgebra.coe_mul, Units.mul_inv, Subalgebra.coe_one]
    rw [this, map_one]
  refine le_antisymm (hle _) ?_
  calc (1 : _) = _ := h1.symm
    _ ≤ v.valuation F ((u : OMeara.locRing F v.asIdeal) : F) := mul_le_of_le_one_right' (hle _)

/-- **The localization of an integral ideal prime to $\mathfrak p$ is the unit ideal:** if the integral ideal
$\mathfrak c$ is not contained in the prime $\mathfrak p$ (hypothesis `hc`), then $\mathfrak c_{(\mathfrak p)} =
\mathfrak o_{(\mathfrak p)}$ (`OMeara.locIdeal`, at the localization of $\mathcal O_F$). -/
theorem locIdeal_coeIdeal_eq_one (c : Ideal (𝓞 F)) (v : HeightOneSpectrum (𝓞 F)) (hc : ¬ c ≤ v.asIdeal) :
    OMeara.locIdeal v.asIdeal ((c : FractionalIdeal (𝓞 F)⁰ F) : Submodule (𝓞 F) F) = 1 := by
  apply le_antisymm
  · have h1 : ((c : FractionalIdeal (𝓞 F)⁰ F) : Submodule (𝓞 F) F) ≤ 1 := by
      rw [← FractionalIdeal.coe_one]
      exact FractionalIdeal.coe_le_coe.mpr FractionalIdeal.coeIdeal_le_one
    exact (OMeara.locIdeal_mono _ h1).trans (OMeara.locIdeal_one _).le
  · obtain ⟨t, htc, htv⟩ := Set.not_subset.mp hc
    rw [Submodule.one_eq_span, Submodule.span_le, Set.singleton_subset_iff]
    have ht : algebraMap (𝓞 F) F t ∈ ((c : FractionalIdeal (𝓞 F)⁰ F) : Submodule (𝓞 F) F) :=
      (FractionalIdeal.mem_coeIdeal _).mpr ⟨t, htc, rfl⟩
    obtain ⟨u, hu⟩ := IsLocalization.map_units (OMeara.locRing F v.asIdeal)
      (⟨t, htv⟩ : v.asIdeal.primeCompl)
    have htu : algebraMap (𝓞 F) F t = ((u : OMeara.locRing F v.asIdeal) : F) := by
      rw [hu, IsScalarTower.algebraMap_apply (𝓞 F) (OMeara.locRing F v.asIdeal) F]
      rfl
    have h1 : (1 : F) = ((u⁻¹ : (OMeara.locRing F v.asIdeal)ˣ) : OMeara.locRing F v.asIdeal) •
        algebraMap (𝓞 F) F t := by
      rw [htu, Algebra.smul_def]
      change (1 : F) = ((((u⁻¹ : (OMeara.locRing F v.asIdeal)ˣ) : OMeara.locRing F v.asIdeal) : F)) *
        ((u : OMeara.locRing F v.asIdeal) : F)
      rw [← Subalgebra.coe_mul, Units.inv_mul, Subalgebra.coe_one]
    rw [SetLike.mem_coe, h1]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ht)

/-- **The Hasse invariant at a good prime is $1$** (the local step of O'Meara 103:5): let $Q$ be nondegenerate
(hypothesis `hQ`) and let $L$ be a lattice on $F^n$ with integral scale $\mathfrak sL \subseteq \mathfrak o$ (hypothesis
`hs`) and volume $\mathfrak vL = \mathfrak c$ (hypothesis `hv`). At a finite place $\mathfrak p$ (`v`) that is non-dyadic
(`h2`: $2 \notin \mathfrak p$) and prime to $\mathfrak c$ (`hc`: $\mathfrak c \not\subseteq \mathfrak p$), Serre's Hasse
invariant $\varepsilon_{\mathfrak p}(Q)$ (`NFPlace.hasseSerreForm`) is $1$.

*Proof.* The localization $L_{(\mathfrak p)}$ is regular, so it has an orthogonal base $b$ (O'Meara §92, p. 246,
`OMeara.exists_orthogonal_basis`); its volume $\prod_iQ(b_i)\,\mathfrak o_{(\mathfrak p)} = \mathfrak c_{(\mathfrak p)} =
\mathfrak o_{(\mathfrak p)}$ and $Q(b_i) \in \mathfrak sL_{(\mathfrak p)} \subseteq \mathfrak o_{(\mathfrak p)}$ make all
$Q(b_i)$ $\mathfrak p$-adic units. Then $Q \cong \langle Q(b_0), \dots, Q(b_{n-1})\rangle$ over $F$ and
$\varepsilon_{\mathfrak p} = \prod_{i<j}(Q(b_i), Q(b_j))_{\mathfrak p} = 1$ (63:12, `SqDual.hilbert_units_nondyadic`). -/
@[kb "omeara1963" "§103, 103:5, pp. 310–311 (proof: S_pV = 1 at the good spots)"]
theorem hasseSerreForm_eq_one_of_good (hQ : Q.Nondegenerate) (L : Lat F n) (c : Ideal (𝓞 F))
    (hs : OMeara.scale Q.toQuadraticForm L.1 ≤ 1)
    (hv : OMeara.volume Q.toQuadraticForm L.1 = ((c : FractionalIdeal (𝓞 F)⁰ F) : Submodule (𝓞 F) F))
    (v : HeightOneSpectrum (𝓞 F)) (h2 : (2 : 𝓞 F) ∉ v.asIdeal) (hc : ¬ c ≤ v.asIdeal) :
    (NFPlace.finite v).hasseSerreForm Q = 1 := by
  classical
  have : IsDiscreteValuationRing (OMeara.locRing F v.asIdeal) :=
    IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain (𝓞 F) v.ne_bot _
  set R := OMeara.locRing F v.asIdeal with hRdef
  set L' : Submodule R (Fin n → F) := OMeara.locLat (F := F) v.asIdeal L.1 with hL'def
  have hL' : L'.IsLattice F := OMeara.isLattice_locLat v.asIdeal L.2
  have h2R : IsUnit (2 : R) := by
    have := IsLocalization.map_units R (⟨2, h2⟩ : v.asIdeal.primeCompl)
    have h : algebraMap (𝓞 F) R 2 = 2 := map_ofNat _ 2
    rw [← h]; exact this
  have hreg : OMeara.IsRegular Q.toQuadraticForm L' := by
    intro x _ h0
    have hall : ∀ y, OMeara.bil Q.toQuadraticForm x y = 0 := by
      have hle : Submodule.span F (L' : Set (Fin n → F)) ≤
          LinearMap.ker (QuadraticMap.associated Q.toQuadraticForm x) := by
        rw [Submodule.span_le]; intro y hy; exact h0 y hy
      rw [hL'.span_eq_top] at hle
      intro y; exact hle Submodule.mem_top
    apply Matrix.eq_zero_of_vecMul_eq_zero hQ
    ext j
    have := hall (Pi.single j 1)
    rw [bil_eq_hessian, Matrix.dotProduct_mulVec, dotProduct_single, mul_one] at this
    simpa using this
  obtain ⟨b, horth, hb0⟩ := OMeara.exists_orthogonal_basis Q.toQuadraticForm h2R hL'.fg hreg
  have hrk : Module.finrank R L' = n := by
    rw [hL'def, OMeara.finrank_locLat, finrank_lat]
  set q : Fin (Module.finrank R L') → F := fun i => Q.toQuadraticForm (b i : Fin n → F) with hq
  have hgram : OMeara.gram Q.toQuadraticForm (fun i => (b i : Fin n → F)) = Matrix.diagonal q := by
    ext i j
    by_cases hij : i = j
    · subst hij; simp [OMeara.gram, q]
    · simp [OMeara.gram, Matrix.diagonal_apply_ne _ hij, horth i j hij]
  have hvol1 : OMeara.volume Q.toQuadraticForm L' = Submodule.span R {∏ i, q i} := by
    rw [OMeara.volume_eq_span_det Q.toQuadraticForm b, hgram, Matrix.det_diagonal]
  have hvol2 : OMeara.volume Q.toQuadraticForm L' = 1 := by
    rw [hL'def, OMeara.volume_locLat Q.toQuadraticForm v.asIdeal L.2.fg, hv,
      locIdeal_coeIdeal_eq_one c v hc]
  -- the `Q (b i)` are integral
  have hint : ∀ i, q i ∈ (1 : Submodule R F) := by
    intro i
    have h1 : q i ∈ OMeara.scale Q.toQuadraticForm L' := by
      have := OMeara.bil_mem_scale Q.toQuadraticForm (b i).2 (b i).2
      rwa [OMeara.bil_self] at this
    rw [hL'def, OMeara.scale_locLat] at h1
    exact ((OMeara.locIdeal_mono _ hs).trans (OMeara.locIdeal_one _).le) h1
  choose r hr using fun i => Submodule.mem_one.mp (hint i)
  -- and their product is a unit
  rw [hvol1, Submodule.one_eq_span] at hvol2
  obtain ⟨z, hz⟩ := (Submodule.span_singleton_eq_span_singleton).mp hvol2
  have hprod : z * ∏ i, r i = 1 := by
    apply IsFractionRing.injective R F
    rw [map_mul, map_prod, map_one]
    simp only [hr]
    rw [← hz, Units.smul_def, Algebra.smul_def]
  have hval : ∀ i, v.valuation F (q i) = 1 := by
    intro i
    have hu : IsUnit (r i) := isUnit_of_dvd_unit (Finset.dvd_prod_of_mem r (Finset.mem_univ i))
      (IsUnit.of_mul_eq_one_right _ hprod)
    rw [← hr i]
    exact valuation_eq_one_of_isUnit v hu
  -- the diagonalization
  let b' : Fin n → Fin n → F := fun i => (b (Fin.cast hrk.symm i) : Fin n → F)
  have horth' : ∀ i j, i ≠ j → OMeara.bil Q.toQuadraticForm (b' i) (b' j) = 0 :=
    fun i j hij => horth _ _ (fun h => hij (Fin.cast_injective _ h))
  have hb0' : ∀ i, Q.toQuadraticForm (b' i) ≠ 0 := fun i => hb0 _
  have hiso := isometricIn_diag_of_orth Q b' horth' hb0'
  rw [NFPlace.hasseSerreForm_eq_of_isometric (NFPlace.finite v) hQ hb0' hiso]
  unfold NFPlace.hasseSerre
  refine Finset.prod_eq_one fun i _ => Finset.prod_eq_one fun j _ => ?_
  split_ifs
  · exact SqDual.hilbert_units_nondyadic v h2 _ _ (hval _) (hval _)
  · rfl

end Good

/-! ### Finitely many local invariants, and the assembly -/

section Assembly

variable {n : ℕ}

/-- **Finitely many discriminant classes of forms** (the global step of O'Meara 103:5): for fixed $n$ and $\mathfrak c$
there is a finite set $\Delta \subseteq F^\times$ such that every nondegenerate $Q$ on $F^n$ (hypothesis `hQ`) carrying a
lattice $L$ of volume $\mathfrak vL = \mathfrak c$ (hypothesis `hv`) has $\det H_Q \in \delta_0F^{\times2}$ for some
$\delta_0 \in \Delta$ (`exists_ideal_disc` and `exists_finite_disc_classes`). -/
theorem exists_finite_hessian_classes (n : ℕ) (c : Ideal (𝓞 F)) :
    ∃ Δ : Set F, Δ.Finite ∧ (0 : F) ∉ Δ ∧ ∀ Q : QuadForm F n, Q.Nondegenerate → ∀ L : Lat F n,
      OMeara.volume Q.toQuadraticForm L.1 = ((c : FractionalIdeal (𝓞 F)⁰ F) : Submodule (𝓞 F) F) →
        ∃ δ₀ ∈ Δ, IsSquare (Q.hessian.det / δ₀) := by
  obtain ⟨Δ, hΔ, hΔ0, hrep⟩ := exists_finite_disc_classes c
  refine ⟨(fun d => 2 ^ n * d) '' Δ, hΔ.image _, ?_, fun Q hQ L hv => ?_⟩
  · rintro ⟨d, hd, h⟩
    rcases mul_eq_zero.mp h with h | h
    · exact pow_ne_zero n two_ne_zero h
    · exact hΔ0 (h ▸ hd)
  obtain ⟨J, hJ, δ, hδ, he, hsq⟩ := exists_ideal_disc Q hQ L c hv
  obtain ⟨δ₀, h0, hsq0⟩ := hrep J hJ δ hδ he
  have hδ₀ : δ₀ ≠ 0 := fun h => hΔ0 (h ▸ h0)
  refine ⟨2 ^ n * δ₀, ⟨δ₀, h0, rfl⟩, ?_⟩
  have e : Q.hessian.det / (2 ^ n * δ₀) = Q.hessian.det / (2 ^ n * δ) * (δ / δ₀) := by
    field_simp
  rw [e]
  exact hsq.mul hsq0

/-- **Hasse invariants are signs:** $\varepsilon_v(Q) \in \{1, -1\}$ at every place $v$ (a product of Hilbert symbols,
each $\pm1$). -/
theorem hasseSerreForm_mem (v : NFPlace F) (Q : QuadForm F n) :
    v.hasseSerreForm Q ∈ ({1, -1} : Set ℤ) := by
  unfold NFPlace.hasseSerreForm NFPlace.hasseSerre
  have hmul : ∀ a b : ℤ, a ∈ ({1, -1} : Set ℤ) → b ∈ ({1, -1} : Set ℤ) → a * b ∈ ({1, -1} : Set ℤ) := by
    rintro a b (rfl | rfl) (rfl | rfl) <;> simp
  have hone : (1 : ℤ) ∈ ({1, -1} : Set ℤ) := by simp
  refine Finset.prod_induction _ (fun z => z ∈ ({1, -1} : Set ℤ)) hmul hone fun i _ => ?_
  refine Finset.prod_induction _ (fun z => z ∈ ({1, -1} : Set ℤ)) hmul hone fun j _ => ?_
  split_ifs
  · cases v <;> simp only [NFPlace.hilbert, hilbertSymbol] <;> split_ifs <;> simp
  · exact hone

/-- **Negative indices are at most $n$** at every place $v$ (the number of negative entries of a diagonalization at a
real place; $0$ elsewhere). -/
theorem negIndexForm_le (v : NFPlace F) (Q : QuadForm F n) : v.negIndexForm Q ≤ n := by
  unfold NFPlace.negIndexForm
  rcases v with w | p
  · simp only [NFPlace.negIndex]
    split_ifs with hw
    · unfold LocalClassNF.realNegCount
      exact (Finset.card_filter_le _ _).trans (by simp)
    · exact Nat.zero_le _
  · exact Nat.zero_le _

/-- **Finitely many representatives** (pigeonhole): if $\Phi$ takes finitely many values on a set $A$ and $\Phi(x) =
\Phi(y)$ implies $r(x, y)$ for $x, y \in A$ (hypothesis `h`), then a finite subset $s$ of $X$ has, for every $x \in A$,
some $y \in s$ with $r(x, y)$. -/
theorem exists_finset_reps {X Y : Type*} (A : Set X) (Φ : X → Y) (hfin : (Φ '' A).Finite)
    (r : X → X → Prop) (h : ∀ x ∈ A, ∀ y ∈ A, Φ x = Φ y → r x y) :
    ∃ s : Finset X, ∀ x ∈ A, ∃ y ∈ s, r x y := by
  classical
  by_cases hA : A.Nonempty
  · have : Nonempty X := ⟨hA.some⟩
    refine ⟨hfin.toFinset.image (Function.invFunOn Φ A), fun x hx => ?_⟩
    have hpos := Function.invFunOn_pos (f := Φ) (s := A) (b := Φ x) ⟨x, hx, rfl⟩
    exact ⟨_, Finset.mem_image.mpr ⟨Φ x, hfin.mem_toFinset.mpr ⟨x, hx, rfl⟩, rfl⟩,
      h x hx _ hpos.1 hpos.2.symm⟩
  · exact ⟨∅, fun x hx => absurd ⟨x, hx⟩ hA⟩

end Assembly

end Sec103Five

open Sec103Five in
/-- **O'Meara 103:5** (O'Meara 1973, §103, Remark 103:5, pp. 310–311): for a number field $F$, a dimension $n$ and an
integral ideal $\mathfrak c$ of $\mathcal O_F$, there is a finite set $s$ of forms such that every nondegenerate
$Q$ on $F^n$ carrying a lattice $L$ with integral scale ($\mathfrak sL \subseteq \mathfrak o_F$) and volume
$\mathfrak vL = \mathfrak c$ is isometric over $F$ to a member of $s$: only finitely many regular $n$-ary quadratic
spaces over $F$ carry such a lattice.

*Proof* (O'Meara's, see the module docstring). The invariant $Q \mapsto (\text{discriminant class},
(\varepsilon_v(Q), \operatorname{ind}^-_v(Q))_{v \in P})$, with $P$ the infinite places and the finite places that are
dyadic or divide $\mathfrak c$, takes finitely many values (`exists_finite_hessian_classes`, `hasseSerreForm_mem`,
`negIndexForm_le`); outside $P$ every such $Q$ has $\varepsilon_{\mathfrak p}(Q) = 1$ (`hasseSerreForm_eq_one_of_good`)
and $\operatorname{ind}^- = 0$. Two forms with the same invariant are isometric at every place (63:20,
`NFPlace.isometric_iff_general`), hence over $F$ (Hasse–Minkowski, 66:4). If $\mathfrak c = 0$ no form qualifies. -/
@[kb "omeara1963" "§103, 103:5, pp. 310–311"]
theorem omeara103_5_holds (F : Type) [Field F] [NumberField F] (n : ℕ) (c : Ideal (𝓞 F)) :
    OMeara103_5 F n c := by
  classical
  set A : Set (QuadForm F n) := {Q | Q.Nondegenerate ∧ ∃ L : Lat F n,
    OMeara.scale Q.toQuadraticForm L.1 ≤ 1 ∧
      OMeara.volume Q.toQuadraticForm L.1 = ((c : FractionalIdeal (𝓞 F)⁰ F) : Submodule (𝓞 F) F)} with hA
  by_cases hc0 : c = ⊥
  · refine ⟨∅, fun Q hQ ⟨L, _, hv⟩ => ?_⟩
    exfalso
    obtain ⟨J, hJ, δ, hδ, he, -⟩ := exists_ideal_disc Q hQ L c hv
    rw [hc0, FractionalIdeal.coeIdeal_bot] at he
    exact mul_ne_zero (pow_ne_zero _ (FractionalIdeal.coeIdeal_ne_zero.mpr hJ))
      ((FractionalIdeal.spanSingleton_ne_zero_iff).mpr hδ) he
  -- the bad finite places
  set S : Set (HeightOneSpectrum (𝓞 F)) := {v | (2 : 𝓞 F) ∈ v.asIdeal ∨ c ≤ v.asIdeal} with hSdef
  have hS : S.Finite := by
    have h2 : Ideal.span {(2 : 𝓞 F)} ≠ 0 := by
      rw [Ne, Submodule.zero_eq_bot, Ideal.span_singleton_eq_bot]; exact two_ne_zero
    refine ((Ideal.finite_factors h2).union (Ideal.finite_factors hc0)).subset ?_
    rintro v (hv | hv)
    · left; exact Ideal.dvd_iff_le.mpr ((Ideal.span_singleton_le_iff_mem _).mpr hv)
    · right; exact Ideal.dvd_iff_le.mpr hv
  set P : Set (NFPlace F) := Set.range NFPlace.infinite ∪ NFPlace.finite '' S with hPdef
  have hP : P.Finite := (Set.finite_range _).union (hS.image _)
  obtain ⟨Δ, hΔ, hΔ0, hΔrep⟩ := exists_finite_hessian_classes n c
  let δsel : QuadForm F n → F := fun Q =>
    if h : ∃ δ₀ ∈ Δ, IsSquare (Q.hessian.det / δ₀) then h.choose else 0
  have hδsel : ∀ Q ∈ A, δsel Q ∈ Δ ∧ IsSquare (Q.hessian.det / δsel Q) := by
    rintro Q ⟨hQ, L, -, hv⟩
    have h := hΔrep Q hQ L hv
    simp only [δsel, h, ↓reduceDIte]
    exact h.choose_spec
  let Φ : QuadForm F n → F × (P → ℤ × ℕ) := fun Q =>
    (δsel Q, fun v => (v.1.hasseSerreForm Q, v.1.negIndexForm Q))
  have hΦ : (Φ '' A).Finite := by
    have : Finite P := hP.to_subtype
    refine (hΔ.prod (Set.Finite.pi (t := fun _ : P => ({1, -1} : Set ℤ) ×ˢ Set.Iic n)
      fun _ => (Set.toFinite _).prod (Set.finite_Iic n))).subset ?_
    rintro _ ⟨Q, hQA, rfl⟩
    refine ⟨(hδsel Q hQA).1, ?_⟩
    intro v _
    exact ⟨hasseSerreForm_mem v.1 Q, negIndexForm_le v.1 Q⟩
  have key : ∀ Q ∈ A, ∀ R ∈ A, Φ Q = Φ R → Q.IsometricIn F R := by
    rintro Q hQA R hRA he
    obtain ⟨hQ, L, hsL, hvL⟩ := hQA
    obtain ⟨hR, M, hsM, hvM⟩ := hRA
    have hδ : δsel Q = δsel R := congrArg Prod.fst he
    have hloc : ∀ v : P, v.1.hasseSerreForm Q = v.1.hasseSerreForm R ∧
        v.1.negIndexForm Q = v.1.negIndexForm R := fun v =>
      Prod.ext_iff.mp (congrFun (congrArg Prod.snd he) v)
    have hsq : IsSquare (Q.hessian.det / R.hessian.det) := by
      obtain ⟨h1, hQ0⟩ := hδsel Q ⟨hQ, L, hsL, hvL⟩
      obtain ⟨-, hR0⟩ := hδsel R ⟨hR, M, hsM, hvM⟩
      rw [← hδ] at hR0
      have hd0 : δsel Q ≠ 0 := fun h => hΔ0 (h ▸ h1)
      have hRd : R.hessian.det ≠ 0 := hR
      have e : Q.hessian.det / R.hessian.det =
          (Q.hessian.det / δsel Q) / (R.hessian.det / δsel Q) := by
        field_simp
      rw [e]
      exact hQ0.div hR0
    apply Tamagawa.FormClassNF.isometricIn_of_everywhere_nf Q R hQ hR
    intro v
    rw [NFPlace.isometric_iff_general v Q R hQ hR]
    refine ⟨?_, ?_, ?_⟩
    · cases v <;> exact hsq.map (algebraMap F _)
    · rcases v with w | p
      · exact (hloc ⟨_, Or.inl ⟨w, rfl⟩⟩).1
      · by_cases hp : p ∈ S
        · exact (hloc ⟨_, Or.inr ⟨p, hp, rfl⟩⟩).1
        · simp only [hSdef, Set.mem_ofPred_eq, not_or] at hp
          rw [hasseSerreForm_eq_one_of_good Q hQ L c hsL hvL p hp.1 hp.2,
            hasseSerreForm_eq_one_of_good R hR M c hsM hvM p hp.1 hp.2]
    · rcases v with w | p
      · exact (hloc ⟨_, Or.inl ⟨w, rfl⟩⟩).2
      · rfl
  obtain ⟨s, hs⟩ := exists_finset_reps A Φ hΦ (fun Q Q' => Q.IsometricIn F Q') key
  exact ⟨s, fun Q hQ hL => hs Q ⟨hQ, hL⟩⟩

end QuadFormsKB.Lattices
