/-
# Kitaoka 1993, Theorem 5.2.3: representation by a maximal lattice over $\mathbb Z_p$

**Source.** Y. Kitaoka, *Arithmetic of Quadratic Forms* (Cambridge Tracts in Mathematics 106, 1993), §5.2,
Theorem 5.2.3 (printed p. 76).

**Statement (in the book's terms).** Let $L$ and $M$ be regular quadratic lattices over $R = \mathbb Z_p$ and
suppose that $\operatorname{rank} L + 3 \le \operatorname{rank} M$, that $M$ is $(a)$-maximal and that
$n(L) \subseteq (a)$. Then $L$ is represented by $M$.

Here (as in the repository's lattice framework, `OMeara.IsMaximal`) a lattice is a finitely generated
$\mathbb Z_p$-submodule of a quadratic space over $\mathbb Q_p$ spanning that space ("lattice on the space"), the
space of $L$ is $V = \mathbb Q_p^k$ with the regular form `QL`, the space of $M$ is $W = \mathbb Q_p^n$ with the
regular form `QM`, $n(\cdot)$ is the norm ideal `OMeara.normIdeal` (the $\mathbb Z_p$-module generated by the
values of the form), "$M$ is $(a)$-maximal" is `OMeara.IsMaximal QM a M` (maximal among the lattices on $W$ with norm
contained in $a$), and "represented by" is `OMeara.LatticeIsometryInto QL QM L M`: an injective
$\mathbb Z_p$-linear map $f \colon L \to M$ with $Q_M(f x) = Q_L(x)$.

**Differences from the printed statement.** The ideal $(a)$ is an arbitrary $\mathbb Z_p$-submodule `a` of
$\mathbb Q_p$ (the hypothesis that $M$ is $a$-maximal forces $a = \alpha\mathbb Z_p$ with $\alpha \ne 0$, repository
lemma `exists_eq_span_singleton_of_isMaximal`). Both quadratic spaces are given as coordinate spaces
$\mathbb Q_p^k$, $\mathbb Q_p^n$; regularity of the lattices is regularity of the spaces
(`(QuadraticMap.associated Q).Nondegenerate`). Since $k + 3 \le n$, the space of $M$ is non-zero.

**Proof (the book's).** Put $V = FL$, $W = FM$. By Corollary 3.5.4 ($n - k \ge 3$) $V$ is represented by $W$: there
is an injective isometry $\sigma \colon V \to W$. The submodule $K = \sigma(L) \subseteq W$ is isometric to $L$ but
is not a lattice on $W$ (its rank is $k < n$). By the preceding lemma (here `exists_lattice_ge_of_fg`) there is a
lattice $K' \supseteq K$ on $W$ with $n(K') \subseteq (a)$; it is the sum of $K$ and a small multiple
$c J_0$ of a lattice $J_0$ on $W$, where $c$ is chosen (using that the $\mathbb Z_p$-modules generated by the
finitely many relevant values of the bilinear form are finitely generated, hence have a common denominator) so
that $n(c J_0)$ and $2B(K, c J_0)$ lie in $(a)$. By O'Meara 82:18 (`OMeara.exists_isMaximal_ge`) $K'$ lies in an
$(a)$-maximal lattice $N$ on $W$. By Theorem 5.2.2 (O'Meara 91:2, `OMeara.cls_eq_of_isMaximal`) $M$ and $N$ are
isometric: $N = \tau M$ with $\tau \in O(W)$. Hence $\tau^{-1}\sigma$ restricted to $L$ is an injective isometry
of $L$ into $M$.

**Repository results used.** `Kitaoka.corollary354` (Corollary 3.5.4);
`OMeara.exists_isMaximal_ge` (82:18), `OMeara.exists_eq_span_singleton_of_isMaximal`,
`OMeara.cls_eq_of_isMaximal` (91:2 = Theorem 5.2.2; needs the Henselian property of $\mathbb Z_p$, which holds
because $\mathbb Z_p$ is complete: Mathlib's `IsAdicComplete.henselianRing`).

**Status.** Unconditional (no named input): the proof uses only the proved results above.
-/
import Mathlib.NumberTheory.Padics.PadicIntegers
import Mathlib.RingTheory.Henselian
import Mathlib.RingTheory.FractionalIdeal.Operations
import Mathlib.RingTheory.Finiteness.Bilinear
import QuadFormsKB.Literature.OMeara.Sec82Classes
import QuadFormsKB.Literature.OMeara.Sec91Max3
import QuadFormsKB.Literature.Kitaoka.Wave2.Ch3Corollary354

open QuadraticMap Submodule Module QuadFormsKB

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.Kitaoka

section Aux

variable (p : ℕ) [Fact p.Prime]

/-- **Extension of a finitely generated submodule to a lattice of small norm** (the "previous lemma" in the proof
of Kitaoka's Theorem 5.2.3). Let $W$ be a quadratic space over $\mathbb Q_p$ with form `Q`, let
$a = \alpha\mathbb Z_p$ with $\alpha \ne 0$, let $K \subseteq W$ be a finitely generated $\mathbb Z_p$-submodule with
$n(K) \subseteq a$, and let $J_0$ be a finitely generated $\mathbb Z_p$-submodule spanning $W$ over $\mathbb Q_p$.
Then there is a lattice $K' \supseteq K$ on $W$ with $n(K') \subseteq a$. (Take $K' = K + cJ_0$ with
$c \in \mathbb Q_p^\times$ small.) -/
theorem exists_lattice_ge_of_fg {W : Type*} [AddCommGroup W] [Module ℚ_[p] W] [Module ℤ_[p] W]
    [IsScalarTower ℤ_[p] ℚ_[p] W] (Q : QuadraticForm ℚ_[p] W) {α : ℚ_[p]} (hα : α ≠ 0)
    {K J0 : Submodule ℤ_[p] W} (hK : K.FG) (hJ0 : J0.FG)
    (hspan : span ℚ_[p] (J0 : Set W) = ⊤) (hnK : OMeara.normIdeal Q K ≤ ℤ_[p] ∙ α) :
    ∃ K' : Submodule ℤ_[p] W, K ≤ K' ∧ K'.IsLattice ℚ_[p] ∧ OMeara.normIdeal Q K' ≤ ℤ_[p] ∙ α := by
  classical
  -- the `ℤ_[p]`-bilinear form `2B` is not needed: we use `B` itself
  let B : W →ₗ[ℤ_[p]] W →ₗ[ℤ_[p]] ℚ_[p] :=
    LinearMap.mk₂ ℤ_[p] (fun x y => OMeara.bil Q x y)
      (fun x x' y => OMeara.bil_add_left Q x x' y)
      (fun c x y => by rw [OMeara.bil_rsmul_left, Algebra.smul_def])
      (fun x y y' => OMeara.bil_add_right Q x y y')
      (fun c x y => by rw [OMeara.bil_rsmul_right, Algebra.smul_def])
  have hB : ∀ x y, B x y = OMeara.bil Q x y := fun x y => rfl
  set S1 : Submodule ℤ_[p] ℚ_[p] :=
    Submodule.map₂ B K J0 ⊔ Submodule.map₂ B J0 J0 ⊔ ℤ_[p] ∙ α with hS1
  have hS1fg : S1.FG :=
    ((Submodule.FG.map₂ B hK hJ0).sup (Submodule.FG.map₂ B hJ0 hJ0)).sup (fg_span_singleton α)
  obtain ⟨d, hdmem, hd⟩ := FractionalIdeal.isFractional_of_fg (S := nonZeroDivisors ℤ_[p])
    (P := ℚ_[p]) hS1fg
  have hd0 : d ≠ 0 := nonZeroDivisors.ne_zero hdmem
  have hdint : ∀ s ∈ S1, ∃ r : ℤ_[p], algebraMap ℤ_[p] ℚ_[p] d * s = algebraMap ℤ_[p] ℚ_[p] r := by
    intro s hs
    obtain ⟨r, hr⟩ := hd s hs
    exact ⟨r, by rw [hr, Algebra.smul_def]⟩
  have hdne : algebraMap ℤ_[p] ℚ_[p] d ≠ 0 := by
    intro h
    exact hd0 ((injective_iff_map_eq_zero _).mp (IsFractionRing.injective ℤ_[p] ℚ_[p]) d h)
  set c : ℚ_[p] := α * algebraMap ℤ_[p] ℚ_[p] d with hc
  have hc0 : c ≠ 0 := mul_ne_zero hα hdne
  let cL : W →ₗ[ℤ_[p]] W := (LinearMap.lsmul ℚ_[p] W c).restrictScalars ℤ_[p]
  have hcL : ∀ w, cL w = c • w := fun w => rfl
  set J : Submodule ℤ_[p] W := J0.map cL with hJ
  have hJfg : J.FG := hJ0.map cL
  have hJspan : span ℚ_[p] (J : Set W) = ⊤ := by
    rw [eq_top_iff, ← hspan]
    refine Submodule.span_le.mpr fun v hv => ?_
    have hmem : c • v ∈ span ℚ_[p] (J : Set W) :=
      subset_span ⟨v, hv, hcL v⟩
    have := Submodule.smul_mem _ c⁻¹ hmem
    rwa [smul_smul, inv_mul_cancel₀ hc0, one_smul] at this
  have hJlat : J.IsLattice ℚ_[p] := ⟨hJfg, hJspan⟩
  have hmemα : ∀ r : ℤ_[p], algebraMap ℤ_[p] ℚ_[p] r * α ∈ ℤ_[p] ∙ α := fun r => by
    rw [← Algebra.smul_def]; exact Submodule.smul_mem _ r (mem_span_singleton_self α)
  refine ⟨K ⊔ J, le_sup_left, ?_, ?_⟩
  · exact Submodule.IsLattice.of_le_of_isLattice_of_fg ℚ_[p] le_sup_right (hK.sup hJfg)
  · refine Submodule.span_le.mpr ?_
    rintro _ ⟨v, hv, rfl⟩
    obtain ⟨x, hx, y, hy, rfl⟩ := Submodule.mem_sup.mp hv
    obtain ⟨j, hj, rfl⟩ := hy
    show Q (x + c • j) ∈ ℤ_[p] ∙ α
    rw [OMeara.Q_add, OMeara.bil_smul_right, OMeara.Q_smul]
    refine add_mem (add_mem (hnK (OMeara.Q_mem_normIdeal Q hx)) ?_) ?_
    · have h1 : OMeara.bil Q x j ∈ S1 :=
        mem_sup_left (mem_sup_left (by rw [← hB]; exact Submodule.apply_mem_map₂ B hx hj))
      obtain ⟨r, hr⟩ := hdint _ h1
      have : 2 * (c * OMeara.bil Q x j) = algebraMap ℤ_[p] ℚ_[p] (2 * r) * α := by
        rw [hc, map_mul, map_ofNat, ← hr]; ring
      rw [this]; exact hmemα _
    · have h1 : OMeara.bil Q j j ∈ S1 :=
        mem_sup_left (mem_sup_right (by rw [← hB]; exact Submodule.apply_mem_map₂ B hj hj))
      have h2 : α ∈ S1 := mem_sup_right (mem_span_singleton_self α)
      obtain ⟨r, hr⟩ := hdint _ h1
      obtain ⟨r', hr'⟩ := hdint _ h2
      rw [OMeara.bil_self] at hr
      have : c ^ 2 * Q j = algebraMap ℤ_[p] ℚ_[p] (r' * r) * α := by
        rw [map_mul, ← hr, ← hr', hc]; ring
      rw [this]; exact hmemα _

/-- A regular quadratic form on $\mathbb Q_p^m$ has non-zero determinant `discr'`. -/
theorem discr'_ne_zero_of_nondegenerate {m : ℕ} (Q : QuadraticForm ℚ_[p] (Fin m → ℚ_[p]))
    (h : (QuadraticMap.associated Q).Nondegenerate) : Q.discr' ≠ 0 := by
  have h2 : (LinearMap.BilinForm.toMatrix' (associated (R := ℚ_[p]) Q)).Nondegenerate :=
    LinearMap.BilinForm.nondegenerate_toMatrix'_iff.mpr h
  exact Matrix.nondegenerate_iff_det_ne_zero.mp h2

/-- $\mathbb Z_p$ is a Henselian local ring: it is complete for its maximal ideal (Mathlib's
`IsAdicComplete.henselianRing`). -/
theorem henselianLocalRing_padicInt : HenselianLocalRing ℤ_[p] where
  is_henselian f hf a₀ h₁ h₂ :=
    HenselianRing.is_henselian (I := IsLocalRing.maximalIdeal ℤ_[p]) f hf a₀ h₁
      (h₂.map (Ideal.Quotient.mk _))

end Aux

/-- **Kitaoka, *Arithmetic of Quadratic Forms* (1993), Theorem 5.2.3 (p. 76).** Let $L$ and $M$ be regular
quadratic lattices over $\mathbb Z_p$ (lattices on the regular quadratic spaces $(\mathbb Q_p^k, Q_L)$ and
$(\mathbb Q_p^n, Q_M)$) with $k + 3 \le n$, $M$ $a$-maximal (maximal among the lattices on $\mathbb Q_p^n$ with norm
contained in $a$) and $n(L) \subseteq a$. Then $L$ is represented by $M$: there is an injective
$\mathbb Z_p$-linear map $f \colon L \to M$ with $Q_M(f x) = Q_L(x)$.

Unconditional (see the module docstring for the proof). -/
@[kb "kitaoka1993" "§5.2, Thm. 5.2.3, p. 76"]
theorem theorem523 (p : ℕ) [Fact p.Prime] {k n : ℕ}
    (QL : QuadraticForm ℚ_[p] (Fin k → ℚ_[p])) (QM : QuadraticForm ℚ_[p] (Fin n → ℚ_[p]))
    (L : Submodule ℤ_[p] (Fin k → ℚ_[p])) (M : Submodule ℤ_[p] (Fin n → ℚ_[p]))
    (a : Submodule ℤ_[p] ℚ_[p])
    (hQL : (QuadraticMap.associated QL).Nondegenerate) (hQM : (QuadraticMap.associated QM).Nondegenerate)
    (hL : L.IsLattice ℚ_[p]) (hkn : k + 3 ≤ n) (hM : OMeara.IsMaximal QM a M)
    (hnL : OMeara.normIdeal QL L ≤ a) :
    OMeara.LatticeIsometryInto QL QM L M := by
  classical
  have : HenselianLocalRing ℤ_[p] := henselianLocalRing_padicInt p
  have : Nontrivial (Fin n → ℚ_[p]) := by
    have : Nonempty (Fin n) := ⟨⟨0, by omega⟩⟩
    infer_instance
  -- the ideal `a` is `α ℤ_p` with `α ≠ 0`
  obtain ⟨α, hα, rfl⟩ := OMeara.exists_eq_span_singleton_of_isMaximal QM hQM hM
  -- Step 1: a representation of the space of `L` by the space of `M` (Corollary 3.5.4)
  obtain ⟨σ, hσinj⟩ : OMeara.IsRepresentedBy QL QM :=
    ((corollary354 p k n QL QM (discr'_ne_zero_of_nondegenerate p QL hQL)
      (discr'_ne_zero_of_nondegenerate p QM hQM) (by omega)).mpr (Or.inl (by omega)))
  have hσQ : ∀ x, QM (σ x) = QL x := σ.map_app
  -- Step 2: `K = σ L` and its extension to a lattice `K'` on the space of `M` of norm contained in `a`
  let σL : (Fin k → ℚ_[p]) →ₗ[ℤ_[p]] (Fin n → ℚ_[p]) := (σ.toLinearMap).restrictScalars ℤ_[p]
  have hσL : ∀ x, σL x = σ x := fun x => rfl
  let K : Submodule ℤ_[p] (Fin n → ℚ_[p]) := L.map σL
  have hKfg : K.FG := hL.fg.map σL
  have hnK : OMeara.normIdeal QM K ≤ ℤ_[p] ∙ α := by
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨v, hv, rfl⟩
    obtain ⟨l, hl, rfl⟩ := hv
    show QM (σ l) ∈ ℤ_[p] ∙ α
    rw [hσQ]
    exact hnL (OMeara.Q_mem_normIdeal QL hl)
  let J0 : Submodule ℤ_[p] (Fin n → ℚ_[p]) :=
    span ℤ_[p] (Set.range fun i : Fin n => (Pi.single i (1 : ℚ_[p]) : Fin n → ℚ_[p]))
  have hJ0fg : J0.FG := fg_span (Set.finite_range _)
  have hspan : span ℚ_[p] (J0 : Set (Fin n → ℚ_[p])) = ⊤ := by
    rw [Submodule.span_span_of_tower]
    have h := (Pi.basisFun ℚ_[p] (Fin n)).span_eq
    convert h using 2
    ext x
    simp [Pi.basisFun_apply]
  obtain ⟨K', hKK', hK'lat, hnK'⟩ := exists_lattice_ge_of_fg p QM hα hKfg hJ0fg hspan hnK
  -- Step 3: an `a`-maximal lattice `N ⊇ K'` (O'Meara 82:18)
  obtain ⟨N, hK'N, hNmax⟩ := OMeara.exists_isMaximal_ge QM hQM hM hK'lat hnK'
  -- Step 4: `N = τ M` for some `τ` in the orthogonal group (Theorem 5.2.2 = O'Meara 91:2)
  have hcls := OMeara.cls_eq_of_isMaximal QM hQM hM hNmax
  have hNcls : N ∈ OMeara.cls QM N :=
    ⟨1, (OMeara.orth QM).one_mem, by ext x; simp [OMeara.latMap]⟩
  rw [hcls] at hNcls
  obtain ⟨τ, hτ, hNτ⟩ := hNcls
  have hτQ : ∀ x, QM (τ x) = QM x := hτ
  have hτsymm : ∀ y, QM (τ.symm y) = QM y := fun y => by
    have h := hτQ (τ.symm y)
    rw [LinearEquiv.apply_symm_apply] at h
    exact h.symm
  -- Step 5: `τ⁻¹ σ` maps `L` into `M`
  have hmemM : ∀ x : L, τ.symm (σ x) ∈ M := by
    intro x
    have hxK : σ x ∈ K := ⟨x, x.2, rfl⟩
    have hxN : σ x ∈ N := hK'N (hKK' hxK)
    rw [hNτ] at hxN
    obtain ⟨m, hm, hmx⟩ := hxN
    have : τ m = σ x := hmx
    rw [← this, LinearEquiv.symm_apply_apply]
    exact hm
  let g : L →ₗ[ℤ_[p]] M :=
    LinearMap.codRestrict M
      (((τ.symm : (Fin n → ℚ_[p]) →ₗ[ℚ_[p]] (Fin n → ℚ_[p])).restrictScalars ℤ_[p]) ∘ₗ σL ∘ₗ
        L.subtype) hmemM
  refine ⟨g, ?_, ?_⟩
  · intro x y hxy
    have h1 : τ.symm (σ x) = τ.symm (σ y) := congrArg Subtype.val hxy
    have h2 : σ x = σ y := τ.symm.injective h1
    exact Subtype.ext (hσinj h2)
  · intro x
    show QM (τ.symm (σ x)) = QL x
    rw [hτsymm, hσQ]

end QuadFormsKB.Kitaoka
