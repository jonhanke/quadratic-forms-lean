import QuadFormsKB.Citation
import Mathlib.NumberTheory.Padics.PadicIntegers
import Mathlib.Algebra.Module.Lattice
import QuadFormsKB.Literature.OMeara.Sec82Classes
import QuadFormsKB.Literature.OMeara.Sec55

/-!
# Kitaoka 1993, Chapter 5: the norm of an $(a)$-maximal lattice (Remark 5.2.r2) and Proposition 5.5.2

**Source.** Y. Kitaoka, *Arithmetic of Quadratic Forms* (Cambridge Tracts in Mathematics 106, 1993), Chapter 5:
the remark after the definition of $(a)$-maximal lattices in §5.2 (printed p. 72; called "Remark 5.2.r2" in the
knowledge base) and §5.5, Proposition 5.5.2 (printed p. 92). Printed page numbers.

**Setting** (Kitaoka, p. 70): $p$ is a prime, $R = \mathbb Z_p$, $F = \mathbb Q_p$, $(a) = aR$ for $a \in F$. A
quadratic space is $V = F^n$ with a quadratic form $Q$ (Mathlib `QuadraticForm ℚ_[p] (Fin n → ℚ_[p])`), with
Kitaoka's bilinear form $B(x, y) = \tfrac12(Q(x+y) - Q(x) - Q(y))$, so $B(x,x) = Q(x)$. This is the form
`OMeara.bil Q`; the repository's lattice notions of O'Meara's framework are reused: a lattice is a finitely generated
$\mathbb Z_p$-submodule `L` of $V$ spanning $V$ (`L.IsLattice ℚ_[p]`), `OMeara.normIdeal Q L` is Kitaoka's norm
$\mathfrak n(L)$, `OMeara.IsMaximal Q (ℤ_[p] ∙ a) L` is "$L$ is $(a)$-maximal" (the lattice $L$ has $\mathfrak n(L)
\subseteq (a)$ and is not properly contained in a lattice $K$ with $\mathfrak n(K) \subseteq (a)$),
`OMeara.orthPlus Q` is $O^+(V)$ and `OMeara.HasSpinorNorm Q σ c` says that the rotation $\sigma$ has spinor norm
$cF^{\times2}$ (O'Meara 1963, §55).

**Proves** (unconditionally)
* `remark52r2`: Remark 5.2.r2 (p. 72), the norm of an $(a)$-maximal lattice is $(a)$ or $(pa)$;
* `proposition552`: Proposition 5.5.2 (p. 92), the spinor norms of a regular anisotropic binary space.

**Stated only:** nothing in this file.
-/

open QuadraticMap Submodule Module QuadFormsKB

noncomputable section

namespace QuadFormsKB.Kitaoka.Padic

variable {p : ℕ} [Fact p.Prime]

section Remark52

/-- **Kitaoka 1993, Remark 5.2.r2** (p. 72): *proved*. Let $L$ be an $(a)$-maximal lattice on a regular quadratic
space $V = \mathbb Q_p^n$ over $\mathbb Q_p$, for $a \in \mathbb Q_p^\times$. Then the norm of $L$ is
$\mathfrak n(L) = (a)$ or $\mathfrak n(L) = (pa)$, where $(c) = c\,\mathbb Z_p$.

*Hypotheses.* `hn : 0 < n` ($V \ne 0$), `hQ` ($V$ is regular: the polar form of $Q$ is nondegenerate), `ha : a ≠ 0`
and `hL` ($L$ is an $(a)$-maximal lattice on $V$).

*Hypothesis made explicit.* The book does not mention $V \ne 0$ (`hn : 0 < n`); it is necessary, since for $V = 0$
the lattice $L = 0$ is $(a)$-maximal with $\mathfrak n(L) = 0 \ne (a)$. (*Update:* missing hypothesis.)

*Proof (the book's).* The norm $\mathfrak n(L) = (c)$ is generated by $c = Q(x_0)$, $x_0 \in L$, is nonzero because
$V$ is regular and $V \ne 0$, and lies in $(a)$, so $c = p^m u a$ with $u$ a unit and $m \ge 0$. If $m \ge 2$ then
$K = p^{-1}L \supsetneq L$ has $\mathfrak n(K) = p^{-2}\mathfrak n(L) \subseteq (a)$, contradicting the
maximality of $L$. -/
@[kb "kitaoka1993" "§5.2, Remark 5.2.r2, p. 72"]
theorem remark52r2 {n : ℕ} (hn : 0 < n) (Q : QuadraticForm ℚ_[p] (Fin n → ℚ_[p]))
    (hQ : (polarBilin Q).Nondegenerate) {a : ℚ_[p]} (ha : a ≠ 0)
    {L : Submodule ℤ_[p] (Fin n → ℚ_[p])} (hL : OMeara.IsMaximal Q (ℤ_[p] ∙ a) L) :
    OMeara.normIdeal Q L = ℤ_[p] ∙ a ∨ OMeara.normIdeal Q L = ℤ_[p] ∙ ((p : ℚ_[p]) * a) := by
  obtain ⟨hlat, hn', hmax⟩ := hL
  have := hlat
  have hp0 : (p : ℚ_[p]) ≠ 0 := Nat.cast_ne_zero.mpr (Fact.out : p.Prime).ne_zero
  obtain ⟨x0, hx0L, hx0⟩ := OMeara.exists_normIdeal_eq Q hlat.fg
  have hcmem : Q x0 ∈ ℤ_[p] ∙ a := hn' (by rw [hx0]; exact mem_span_singleton_self _)
  obtain ⟨r, hr⟩ := mem_span_singleton.mp hcmem
  have hcr : Q x0 = (r : ℚ_[p]) * a := by rw [← hr, Algebra.smul_def]; rfl
  have hc0 : Q x0 ≠ 0 := by
    intro h0
    have hQ0 : ∀ x ∈ L, Q x = 0 := by
      intro x hx
      have : Q x ∈ OMeara.normIdeal Q L := OMeara.Q_mem_normIdeal Q hx
      rw [hx0, h0] at this
      simpa using this
    have hbilL : ∀ x ∈ L, ∀ y ∈ L, OMeara.bil Q x y = 0 := by
      intro x hx y hy
      have h := OMeara.Q_add Q x y
      rw [hQ0 _ (L.add_mem hx hy), hQ0 x hx, hQ0 y hy] at h
      have h2 : 2 * OMeara.bil Q x y = 0 := by
        rw [zero_add, add_zero] at h; exact h.symm
      exact (mul_eq_zero.mp h2).resolve_left two_ne_zero
    have hbilAll : ∀ x y : Fin n → ℚ_[p], OMeara.bil Q x y = 0 := by
      have h1 : ∀ y ∈ L, ∀ x : Fin n → ℚ_[p], OMeara.bil Q x y = 0 := by
        intro y hy x
        have hx : x ∈ span ℚ_[p] (L : Set (Fin n → ℚ_[p])) := by
          rw [hlat.span_eq_top]; trivial
        induction hx using Submodule.span_induction with
        | mem x hx => exact hbilL x hx y hy
        | zero => simp [OMeara.bil]
        | add x y' _ _ hx hy' => rw [OMeara.bil_add_left, hx, hy', add_zero]
        | smul a x _ hx => rw [OMeara.bil_smul_left, hx, mul_zero]
      intro x y
      have hy : y ∈ span ℚ_[p] (L : Set (Fin n → ℚ_[p])) := by
        rw [hlat.span_eq_top]; trivial
      induction hy using Submodule.span_induction with
      | mem y hy => exact h1 y hy x
      | zero => simp [OMeara.bil]
      | add y y' _ _ hy hy' => rw [OMeara.bil_add_right, hy, hy', add_zero]
      | smul a y _ hy => rw [OMeara.bil_smul_right, hy, mul_zero]
    have hpol : polarBilin Q = 0 := by
      refine LinearMap.ext fun x => LinearMap.ext fun y => ?_
      show polar Q x y = 0
      have h := OMeara.Q_add Q x y
      rw [hbilAll x y] at h
      rw [QuadraticMap.polar, h]; ring
    have : Nonempty (Fin n) := ⟨⟨0, hn⟩⟩
    exact LinearMap.BilinForm.Nondegenerate.ne_zero hQ hpol
  have hr0 : r ≠ 0 := by
    rintro rfl
    apply hc0
    rw [← hr]; simp
  have hspec := PadicInt.unitCoeff_spec hr0
  set u := PadicInt.unitCoeff hr0 with hu
  set m := r.valuation with hm
  have hrq : (r : ℚ_[p]) = (u : ℤ_[p]) * (p : ℚ_[p]) ^ m := by
    have := congrArg (fun z : ℤ_[p] => (z : ℚ_[p])) hspec
    simpa using this
  have huw : ((↑(u⁻¹ : ℤ_[p]ˣ) : ℤ_[p]) : ℚ_[p]) * ((u : ℤ_[p]) : ℚ_[p]) = 1 := by
    rw [← PadicInt.coe_mul, ← Units.val_mul, inv_mul_cancel]; simp
  rcases Nat.lt_or_ge m 2 with hm2 | hm2
  · interval_cases hmv : m
    · left
      apply le_antisymm
      · rw [hx0]; exact (span_singleton_le_iff_mem _ _).mpr hcmem
      · rw [hx0]
        refine (span_singleton_le_iff_mem _ _).mpr (mem_span_singleton.mpr ⟨(↑(u⁻¹ : ℤ_[p]ˣ) : ℤ_[p]), ?_⟩)
        rw [Algebra.smul_def, hcr, hrq]
        show ((↑(u⁻¹ : ℤ_[p]ˣ) : ℤ_[p]) : ℚ_[p]) * _ = a
        linear_combination a * huw
    · right
      apply le_antisymm
      · rw [hx0]
        refine (span_singleton_le_iff_mem _ _).mpr (mem_span_singleton.mpr ⟨(u : ℤ_[p]), ?_⟩)
        rw [Algebra.smul_def, hcr, hrq]
        show ((u : ℤ_[p]) : ℚ_[p]) * _ = _
        ring
      · rw [hx0]
        refine (span_singleton_le_iff_mem _ _).mpr (mem_span_singleton.mpr ⟨(↑(u⁻¹ : ℤ_[p]ˣ) : ℤ_[p]), ?_⟩)
        rw [Algebra.smul_def, hcr, hrq]
        show ((↑(u⁻¹ : ℤ_[p]ˣ) : ℤ_[p]) : ℚ_[p]) * _ = _
        linear_combination ((p : ℚ_[p]) * a) * huw
  · exfalso
    obtain ⟨k, hk⟩ : ∃ k, m = k + 2 := ⟨m - 2, by omega⟩
    let cL : (Fin n → ℚ_[p]) →ₗ[ℤ_[p]] (Fin n → ℚ_[p]) :=
      (LinearMap.lsmul ℚ_[p] (Fin n → ℚ_[p]) (p : ℚ_[p])⁻¹).restrictScalars ℤ_[p]
    have hcL : ∀ x, cL x = (p : ℚ_[p])⁻¹ • x := fun x => rfl
    have hLK : L ≤ L.map cL := by
      intro x hx
      refine Submodule.mem_map.mpr ⟨(p : ℤ_[p]) • x, L.smul_mem _ hx, ?_⟩
      rw [hcL, ← algebraMap_smul ℚ_[p] (p : ℤ_[p]) x, smul_smul]
      have : (p : ℚ_[p])⁻¹ * algebraMap ℤ_[p] ℚ_[p] (p : ℤ_[p]) = 1 := by
        simp [hp0]
      rw [this, one_smul]
    have hKlat : (L.map cL).IsLattice ℚ_[p] :=
      Submodule.IsLattice.of_le_of_isLattice_of_fg ℚ_[p] hLK (hlat.fg.map cL)
    have hnK : OMeara.normIdeal Q (L.map cL) ≤ ℤ_[p] ∙ a := by
      refine Submodule.span_le.mpr ?_
      rintro _ ⟨v, hv, rfl⟩
      obtain ⟨s, hs, rfl⟩ := Submodule.mem_map.mp hv
      have hs' : Q s ∈ ℤ_[p] ∙ Q x0 := hx0 ▸ OMeara.Q_mem_normIdeal Q hs
      obtain ⟨t, ht⟩ := mem_span_singleton.mp hs'
      show Q (cL s) ∈ ℤ_[p] ∙ a
      rw [hcL, OMeara.Q_smul, ← ht, Algebra.smul_def, hcr, hrq, hk]
      refine mem_span_singleton.mpr ⟨t * u * (p : ℤ_[p]) ^ k, ?_⟩
      rw [Algebra.smul_def]
      simp only [map_mul, map_pow, map_natCast, PadicInt.algebraMap_apply]
      field_simp
      ring
    have hKL : L.map cL = L := hmax _ hKlat hLK hnK
    have hx1 : (p : ℚ_[p])⁻¹ • x0 ∈ L := hKL ▸ Submodule.mem_map_of_mem (f := cL) hx0L
    have hq : Q ((p : ℚ_[p])⁻¹ • x0) ∈ ℤ_[p] ∙ Q x0 := hx0 ▸ OMeara.Q_mem_normIdeal Q hx1
    obtain ⟨s, hs⟩ := mem_span_singleton.mp hq
    rw [OMeara.Q_smul, Algebra.smul_def] at hs
    have hs2 : (s : ℚ_[p]) = ((p : ℚ_[p])⁻¹) ^ 2 := by
      have := hs
      change (s : ℚ_[p]) * Q x0 = _ at this
      exact mul_right_cancel₀ hc0 this
    have h1 : ‖(s : ℚ_[p])‖ ≤ 1 := s.2
    rw [hs2, norm_pow, norm_inv, Padic.norm_p, inv_inv] at h1
    have hp2 : (2 : ℝ) ≤ p := by exact_mod_cast (Fact.out : p.Prime).two_le
    nlinarith

end Remark52

section Prop552

/-- **The discriminant $dV$ of a binary space** $V = \mathbb Q_p^2$ with form $Q$ (Kitaoka 1993, §1.1): the
determinant of the Gram matrix $(B(\varepsilon_i, \varepsilon_j))_{i,j}$ in the standard basis, i.e.
$dV = B(\varepsilon_0,\varepsilon_0)B(\varepsilon_1,\varepsilon_1) - B(\varepsilon_0,\varepsilon_1)^2$ (a representative of
the class of $dV$ in $F^\times/(F^\times)^2$). -/
def binaryDisc (Q : QuadraticForm ℚ_[p] (Fin 2 → ℚ_[p])) : ℚ_[p] :=
  (OMeara.gram Q fun i : Fin 2 => (Pi.single i 1 : Fin 2 → ℚ_[p])).det

/-- **Kitaoka 1993, Proposition 5.5.2** (p. 92): *proved*. Let $V = \mathbb Q_p^2$ be a regular anisotropic binary
quadratic space over $F = \mathbb Q_p$ (`hQ`: the form is regular; `haniso`: $Q(x) \ne 0$ for $x \ne 0$), with
discriminant $dV$ (`binaryDisc Q`). Then the spinor norms of the rotations $O^+(V)$ form the norm group
$N_{K/F}(K^\times)$ of $K = F(\sqrt{-dV})$. Here "$c$ is a spinor norm" is `∃ σ ∈ orthPlus Q, HasSpinorNorm Q σ c`
($\theta(\sigma) = cF^{\times 2}$; the image of $\theta$ is identified with its inverse image in $F^\times$, as in
Kitaoka §5.5), and the norm group is written with the explicit norm form of $K$:
$N_{K/F}(x + y\sqrt{-dV}) = x^2 + dV\,y^2$, for $(x, y) \ne (0, 0)$.

*Deviation.* $K$ is not constructed as a field extension: the norm group is described by the norm form
$x^2 + dV\,y^2$ (nonzero values; $-dV$ is not a square, as $V$ is anisotropic, so $K$ is a field and this is
$N_{K/F}(K^\times)$).

*Proof.* For vectors $u, v$ of $V$, $Q(u)Q(v) = B(u,v)^2 + dV\det(u,v)^2$ (Lagrange's identity for the Gram
determinant). By O'Meara's 55:2 (`OMeara.exists_hasSpinorNorm_iff`) the spinor norms are $1$ and the products
$Q(u)Q(v)$ of two nonzero values. Conversely, for $c = x^2 + dV y^2$ take $u = \varepsilon_0$ and $v$ with
$B(u, v) = x$, $\det(u, v) = y$. -/
@[kb "kitaoka1993" "§5.5, Prop. 5.5.2, p. 92"]
theorem proposition552 (Q : QuadraticForm ℚ_[p] (Fin 2 → ℚ_[p]))
    (hQ : (QuadraticMap.associated Q).Nondegenerate) (haniso : ∀ x : Fin 2 → ℚ_[p], x ≠ 0 → Q x ≠ 0)
    (c : ℚ_[p]) :
    (∃ σ ∈ OMeara.orthPlus Q, OMeara.HasSpinorNorm Q σ c) ↔
      ∃ x y : ℚ_[p], (x ≠ 0 ∨ y ≠ 0) ∧ c = x ^ 2 + binaryDisc Q * y ^ 2 := by
  set e0 : Fin 2 → ℚ_[p] := Pi.single 0 1 with he0
  set e1 : Fin 2 → ℚ_[p] := Pi.single 1 1 with he1
  set a := Q e0 with ha
  set b := OMeara.bil Q e0 e1 with hb
  set c' := Q e1 with hc'
  have hdec : ∀ u : Fin 2 → ℚ_[p], u = u 0 • e0 + u 1 • e1 := by
    intro u
    ext i
    fin_cases i <;> simp [he0, he1]
  have hd : binaryDisc Q = a * c' - b ^ 2 := by
    simp only [binaryDisc, OMeara.gram, Matrix.det_fin_two, Matrix.of_apply]
    rw [OMeara.bil_comm Q e1 e0, OMeara.bil_self, OMeara.bil_self]
    ring
  have hQf : ∀ u : Fin 2 → ℚ_[p], Q u = a * u 0 ^ 2 + 2 * b * (u 0 * u 1) + c' * u 1 ^ 2 := by
    intro u
    conv_lhs => rw [hdec u]
    rw [OMeara.Q_add, OMeara.Q_smul, OMeara.Q_smul, OMeara.bil_smul_left, OMeara.bil_smul_right]
    ring
  have hbf : ∀ u v : Fin 2 → ℚ_[p],
      OMeara.bil Q u v = a * (u 0 * v 0) + b * (u 0 * v 1 + u 1 * v 0) + c' * (u 1 * v 1) := by
    intro u v
    conv_lhs => rw [hdec u, hdec v]
    simp only [OMeara.bil_add_left, OMeara.bil_add_right, OMeara.bil_smul_left, OMeara.bil_smul_right]
    rw [OMeara.bil_comm Q e1 e0, OMeara.bil_self, OMeara.bil_self]
    ring
  have hkey : ∀ u v : Fin 2 → ℚ_[p],
      Q u * Q v = OMeara.bil Q u v ^ 2 + binaryDisc Q * (u 0 * v 1 - u 1 * v 0) ^ 2 := by
    intro u v
    rw [hQf u, hQf v, hbf u v, hd]
    ring
  have hfr : Module.finrank ℚ_[p] (Fin 2 → ℚ_[p]) = 2 := by simp
  have h2 := OMeara.exists_hasSpinorNorm_iff Q hQ (c := c) (by rw [hfr])
  rw [h2]
  constructor
  · rintro ⟨l, hl, hev, hlen, hprod⟩
    rcases l with _ | ⟨u, _ | ⟨v, _ | ⟨w, rest⟩⟩⟩
    · exact ⟨1, 0, Or.inl one_ne_zero, by simpa using hprod.symm⟩
    · simp at hev
    · have hu := hl u (by simp)
      have hv := hl v (by simp)
      simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one] at hprod
      refine ⟨OMeara.bil Q u v, u 0 * v 1 - u 1 * v 0, ?_, by rw [← hprod]; exact hkey u v⟩
      by_contra hcon
      push Not at hcon
      have h0 : c = 0 := by
        rw [← hprod, hkey u v, hcon.1, hcon.2]; ring
      rw [← hprod] at h0
      exact mul_ne_zero hu hv h0
    · simp at hlen
  · rintro ⟨x, y, hxy, hc⟩
    have hae : a ≠ 0 := haniso e0 (by simp [he0])
    set v : Fin 2 → ℚ_[p] := ![(x - b * y) / a, y] with hv
    have hv0 : v ≠ 0 := by
      intro h
      have h1 : y = 0 := by simpa [hv] using congrFun h 1
      have h0 : (x - b * y) / a = 0 := by simpa [hv] using congrFun h 0
      rw [h1] at h0
      have hx : x = 0 := by
        rw [mul_zero, sub_zero, div_eq_zero_iff] at h0
        exact h0.resolve_right hae
      rcases hxy with h | h
      · exact h hx
      · exact h h1
    have he0' : e0 ≠ 0 := by
      intro h
      have := congrFun h 0
      simp [he0] at this
    have hb1 : OMeara.bil Q e0 v = x := by
      rw [hbf e0 v]
      simp [he0, hv]
      field_simp
      ring
    have hdet : e0 0 * v 1 - e0 1 * v 0 = y := by simp [he0, hv]
    have hcQ : c = Q e0 * Q v := by
      rw [hkey, hb1, hdet, hc]
    refine ⟨[e0, v], ?_, by simp, by simp [hfr], ?_⟩
    · intro w hw
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hw
      rcases hw with rfl | rfl
      · exact haniso _ he0'
      · exact haniso _ hv0
    · simp [hcQ]

end Prop552

end QuadFormsKB.Kitaoka.Padic
