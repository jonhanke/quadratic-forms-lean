/-
# Shimura 2004, Theorem 14.2 (iv): the maximal compact subgroup $G^1(X)G^1(Y)$ of $G^1(V)$

**Source.** G. Shimura, *Arithmetic and Analytic Theories of Quadratic Forms and Clifford Groups*, Mathematical
Surveys and Monographs 109, American Mathematical Society, 2004 (key `shimura2004`), Chapter IV, Theorem 14.2 (iv)
(printed p. 139). Page numbers are printed pages.

**Setting and dictionary.** $V$ a finite-dimensional real vector space with a nondegenerate form
`Q : QuadraticForm ℝ V`, $V = X \oplus Y$ an orthogonal decomposition with $\varphi$ positive definite on $X$ and
negative definite on $Y$. $G^1(X)$, $G^1(Y)$ are the elements of $G^1(V)$ in the subalgebras of $A(V)$ generated by
$X$, resp. $Y$ (`subspaceSpinSet`, `Wave3/Iwasawa.lean`). The topology is the natural one: $A(V)$ is a
finite-dimensional real vector space (`moduleTopology ℝ`) and $A(V)^\times$ carries the units topology.

**States** (named proposition, not proved): `Theorem14_2_iv`: $K = G^1(X)G^1(Y)$ is a compact subgroup of $G^1(V)$,
maximal among compact subgroups of $G^1(V)$, and $G^1(X) \cap G^1(Y) = \{\pm 1\}$. (The book's further assertion that
$\tau(K) = SO^0(X) \times SO^0(Y)$ is not included.)

**Proves** (unconditional, standard axioms only): `spin_inter_eq_one_or_neg_one`, the algebraic part
$G^1(X) \cap G^1(Y) = \{\pm 1\}$, which holds over any field of characteristic $\ne 2$ for any orthogonal
decomposition $V = X \oplus Y$: an element of $G^1(X) \cap G^1(Y)$ is even and commutes with $X$ and with $Y$, hence
is a scalar (Cassels, Chapter 10, Lemma 2.3), and a scalar of multiplier $1$ is $\pm 1$.
-/
import QuadFormsKB.Literature.Shimura2004.Wave3.Iwasawa
import QuadFormsKB.Citation

open Module CliffordAlgebra

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.Shimura2004

open QuadFormsKB.Cassels QuadFormsKB.OMeara

section General

variable {F V : Type*} [Field F] [Invertible (2 : F)] [AddCommGroup V] [Module F V] [FiniteDimensional F V]
  {Q : QuadraticForm F V}

local notation "A" => CliffordAlgebra Q

/-- A vector $y$ orthogonal to a subspace $X$ satisfies $ya = a'y$ for $a$ in the subalgebra generated by $X$. -/
theorem ι_mul_eq_involute_mul_of_orth {X : Submodule F V} {y : V} (hy : ∀ x ∈ X, Q.IsOrtho y x) {a : A}
    (ha : a ∈ Algebra.adjoin F (ι Q '' (X : Set V))) : ι Q y * a = involute a * ι Q y := by
  induction ha using Algebra.adjoin_induction with
  | mem z hz =>
    obtain ⟨x, hx, rfl⟩ := hz
    rw [involute_ι, neg_mul, ι_mul_ι_comm_of_isOrtho (hy x hx)]
  | algebraMap r => rw [AlgHom.commutes, Algebra.commutes]
  | add a b _ _ iha ihb => rw [mul_add, iha, ihb, map_add, add_mul]
  | mul a b _ _ iha ihb => rw [← mul_assoc, iha, mul_assoc, ihb, ← mul_assoc, map_mul]

/-- **$G^1(X) \cap G^1(Y) = \{\pm 1\}$** (Shimura 2004, Theorem 14.2 (iv), p. 139, last assertion), for an
orthogonal decomposition $V = X + Y$ ($X \perp Y$, $X + Y = V$) of a nondegenerate space over a field of
characteristic $\ne 2$: an element of $G^1(V)$ lying in both subalgebras $A(X)$ and $A(Y)$ is $\pm 1$. -/
@[kb "shimura2004" "Thm. 14.2 (iv), p. 139 (G¹(X) ∩ G¹(Y) = {±1})"]
theorem spin_inter_eq_one_or_neg_one (hQ : (QuadraticMap.associated Q).Nondegenerate) {X Y : Submodule F V}
    (horth : ∀ x ∈ X, ∀ y ∈ Y, Q.IsOrtho x y) (hXY : X ⊔ Y = ⊤) {a : (CliffordAlgebra Q)ˣ}
    (ha : a ∈ spinGroupG1 Q) (haX : (a : A) ∈ Algebra.adjoin F (ι Q '' (X : Set V)))
    (haY : (a : A) ∈ Algebra.adjoin F (ι Q '' (Y : Set V))) : a = 1 ∨ a = -1 := by
  have ha0 : (a : A) ∈ evenOdd Q 0 := ha.1.1
  have hcomm : ∀ v : V, (a : A) * ι Q v = ι Q v * a := by
    intro v
    have hv : v ∈ X ⊔ Y := by rw [hXY]; trivial
    obtain ⟨x, hx, y, hy, rfl⟩ := Submodule.mem_sup.1 hv
    have h1 : ι Q x * a = involute (a : A) * ι Q x :=
      ι_mul_eq_involute_mul_of_orth (fun y' hy' => horth x hx y' hy') haY
    have h2 : ι Q y * a = involute (a : A) * ι Q y :=
      ι_mul_eq_involute_mul_of_orth (fun x' hx' => (horth x' hx' y hy).symm) haX
    rw [involute_eq_of_mem_even ha0] at h1 h2
    rw [map_add, mul_add, add_mul, h1, h2]
  obtain ⟨c, hc⟩ := mem_range_algebraMap_of_even_comm hQ ha0 hcomm
  have hc0 : c ≠ 0 := by
    rintro rfl
    exact a.ne_zero (by rw [← hc, map_zero])
  have hau : a = Units.map (algebraMap F A).toMonoidHom (Units.mk0 c hc0) := Units.ext (by simp [hc])
  rw [hau] at ha
  rcases (algebraMap_mem_spinGroupG1_iff (Q := Q) _).1 ha with h | h
  · left; rw [hau, h, map_one]
  · right; rw [hau, h]; ext; simp

end General

/-- **Theorem 14.2 (iv)** (Shimura 2004, p. 139), *stated, not proved* (the last assertion is
`spin_inter_eq_one_or_neg_one`): for a nondegenerate real quadratic space and an orthogonal decomposition
$V = X \oplus Y$ with $\varphi$ positive definite on $X$ and negative definite on $Y$, the set
$K = G^1(X)G^1(Y)$ is a compact subgroup of $G^1(V)$, every compact subgroup of $G^1(V)$ containing $K$ equals
$K$, and $G^1(X) \cap G^1(Y) = \{\pm 1\}$. The topology is `moduleTopology ℝ` on $A(V)$ and the units topology
on $A(V)^\times$. -/
@[kb "shimura2004" "Thm. 14.2 (iv), p. 139 (G¹(X)G¹(Y) is a maximal compact subgroup of G¹(V))"]
def Theorem14_2_iv : Prop :=
  ∀ (V : Type) [AddCommGroup V] [Module ℝ V] [FiniteDimensional ℝ V] (Q : QuadraticForm ℝ V)
    (_hQ : (QuadraticMap.associated Q).Nondegenerate) (X Y : Submodule ℝ V),
    IsCompl X Y → (∀ x ∈ X, ∀ y ∈ Y, Q.IsOrtho x y) →
    (∀ x ∈ X, x ≠ 0 → 0 < Q x) → (∀ y ∈ Y, y ≠ 0 → Q y < 0) →
    letI : TopologicalSpace (CliffordAlgebra Q) := moduleTopology ℝ (CliffordAlgebra Q)
    let K : Set (CliffordAlgebra Q)ˣ :=
      {k | ∃ k₁ ∈ subspaceSpinSet Q X, ∃ k₂ ∈ subspaceSpinSet Q Y, k = k₁ * k₂}
    (∃ S : Subgroup (CliffordAlgebra Q)ˣ, (S : Set (CliffordAlgebra Q)ˣ) = K ∧ S ≤ spinGroupG1 Q) ∧
    IsCompact K ∧
    (∀ S : Subgroup (CliffordAlgebra Q)ˣ, S ≤ spinGroupG1 Q → K ⊆ S →
      IsCompact (S : Set (CliffordAlgebra Q)ˣ) → (S : Set (CliffordAlgebra Q)ˣ) = K) ∧
    (subspaceSpinSet Q X ∩ subspaceSpinSet Q Y = {1, -1})

end QuadFormsKB.Shimura2004
