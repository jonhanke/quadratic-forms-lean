/-
# Shimura 2004, Theorem 14.3: Iwasawa-type decompositions of the real Clifford groups

**Source.** G. Shimura, *Arithmetic and Analytic Theories of Quadratic Forms and Clifford Groups*, Mathematical
Surveys and Monographs 109, American Mathematical Society, 2004 (key `shimura2004`), Chapter IV, Theorem 14.3
(printed p. 140). Page numbers are printed pages.

**Setting and dictionary.** $V$ a finite-dimensional real vector space with a nondegenerate form
`Q : QuadraticForm ℝ V`, $\varphi(x,y)$ = `OMeara.bil Q x y`. A Witt decomposition
$V = Z + \sum_{i}(\mathbb R e_i + \mathbb R f_i)$ ($r$ hyperbolic planes, indices $0, \dots, r-1$ here,
$1, \dots, r$ in the book) is given by vectors $e_i, f_i$ with $\varphi(e_i, e_j) = \varphi(f_i, f_j) = 0$,
$\varphi(e_i, f_j) = \delta_{ij}$, and a subspace $Z$ orthogonal to all of them, complementary to their span, on which
$\varphi$ is negative definite (`IsWittDecomposition`). The associated definite subspaces are
$X = \sum_i \mathbb R(e_i + f_i)$ and $Y = Z + \sum_i \mathbb R(e_i - f_i)$. The parabolic subgroups $P^1$, $P^+$ of
(4.8c) are the library's `parabolicG1 Q J`, `parabolicGPlus Q J` for the maximal isotropic subspace
$J = \sum_i \mathbb R e_i$. For a subspace $X$, $G^1(X)$ is the set of elements of $G^1(V)$ lying in the subalgebra of
$A(V)$ generated by $X$ (`subspaceSpinSet`), and $K = G^1(X)G^1(Y)$.

**States** (named proposition, not proved): `Theorem14_3`, the decompositions
$G^1(V) = P^1K$, $G^+(V) = P^+K$ and $G^0(V) = (P^+ \cap G^0(V))K$, together with the definiteness of $\varphi$ on
$X$ (positive) and on $Y$ (negative). The book's further assertion for even $\dim V$ ($G(V) = PK'$ with a compact
$K'$) is not included.

**Proves** (unconditional): `isWittDecomposition_definite`, the definiteness part.
-/
import QuadFormsKB.Literature.Shimura2004.Wave2.Parabolic
import QuadFormsKB.Literature.Shimura2004.Wave2.RealClifford
import QuadFormsKB.Citation

open Module CliffordAlgebra

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.Shimura2004

open QuadFormsKB.Cassels QuadFormsKB.OMeara

/-- A **Witt decomposition** $V = Z + \sum_{i<r}(\mathbb R e_i + \mathbb R f_i)$ with $\varphi$ negative definite on
$Z$ (Shimura 2004, §14.3, p. 140; cf. §4.1): isotropic vectors $e_i, f_i$ with $\varphi(e_i, f_j) = \delta_{ij}$,
$\varphi(e_i, e_j) = \varphi(f_i, f_j) = 0$, and $Z$ orthogonal to them and complementary to their span. -/
structure IsWittDecomposition {V : Type*} [AddCommGroup V] [Module ℝ V] (Q : QuadraticForm ℝ V) {r : ℕ}
    (e f : Fin r → V) (Z : Submodule ℝ V) : Prop where
  bil_e_e : ∀ i j, bil Q (e i) (e j) = 0
  bil_f_f : ∀ i j, bil Q (f i) (f j) = 0
  bil_e_f : ∀ i j, bil Q (e i) (f j) = if i = j then 1 else 0
  orth_e : ∀ z ∈ Z, ∀ i, bil Q z (e i) = 0
  orth_f : ∀ z ∈ Z, ∀ i, bil Q z (f i) = 0
  compl : IsCompl Z (Submodule.span ℝ (Set.range e ⊔ Set.range f))
  negDef : ∀ z ∈ Z, z ≠ 0 → Q z < 0

/-- $G^1(X)$ for a subspace $X \subseteq V$: the elements of $G^1(V)$ in the subalgebra of $A(V)$ generated by $X$. -/
def subspaceSpinSet {V : Type*} [AddCommGroup V] [Module ℝ V] [FiniteDimensional ℝ V] (Q : QuadraticForm ℝ V) (X : Submodule ℝ V) :
    Set (CliffordAlgebra Q)ˣ :=
  {a | a ∈ spinGroupG1 Q ∧ (a : CliffordAlgebra Q) ∈ Algebra.adjoin ℝ (ι Q '' (X : Set V))}

section Definite

variable {V : Type*} [AddCommGroup V] [Module ℝ V] {Q : QuadraticForm ℝ V} {r : ℕ} {e f : Fin r → V}
  {Z : Submodule ℝ V}

/-- $\varphi\bigl(\sum_i c_i u_i, \sum_j d_j w_j\bigr) = \sum_{i,j} c_i d_j\,\varphi(u_i, w_j)$. -/
theorem bil_sum_sum (c d : Fin r → ℝ) (u w : Fin r → V) :
    bil Q (∑ i, c i • u i) (∑ j, d j • w j) = ∑ i, ∑ j, c i * d j * bil Q (u i) (w j) := by
  rw [bil_sum_left]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [bil_smul_left, bil_sum_right, Finset.mul_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [bil_smul_right]; ring

/-- $\varphi[\sum_i c_i(e_i \pm f_i)] = \pm 2\sum_i c_i^2$ for a Witt decomposition. -/
theorem Q_sum_e_add_f (hW : IsWittDecomposition Q e f Z) (c : Fin r → ℝ) (s : ℝ) :
    Q (∑ i, c i • (e i + s • f i)) = 2 * s * ∑ i, c i ^ 2 := by
  rw [← bil_self, bil_sum_sum]
  have hb : ∀ i j, bil Q (e i + s • f i) (e j + s • f j) = if i = j then 2 * s else 0 := by
    intro i j
    rw [bil_add_left, bil_add_right, bil_add_right, bil_smul_left, bil_smul_left, bil_smul_right,
      bil_smul_right, hW.bil_e_e, hW.bil_f_f, hW.bil_e_f, bil_comm Q (f i), hW.bil_e_f]
    by_cases hij : i = j
    · subst hij; simp; ring
    · simp [hij, Ne.symm hij]
  simp_rw [hb, mul_ite, mul_zero, Finset.sum_ite_eq, Finset.mem_univ, ite_true, Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  ring

/-- **Theorem 14.3** (Shimura 2004, p. 140), first assertion: $\varphi$ is positive definite on
$X = \sum_i \mathbb R(e_i + f_i)$ and negative definite on $Y = Z + \sum_i \mathbb R(e_i - f_i)$. -/
@[kb "shimura2004" "Thm. 14.3, p. 140 (φ positive definite on X, negative definite on Y)"]
theorem isWittDecomposition_definite (hW : IsWittDecomposition Q e f Z) :
    (∀ x ∈ Submodule.span ℝ (Set.range (e + f)), x ≠ 0 → 0 < Q x) ∧
    (∀ y ∈ Z ⊔ Submodule.span ℝ (Set.range (e - f)), y ≠ 0 → Q y < 0) := by
  constructor
  · intro x hx hx0
    obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).1 hx
    have h := Q_sum_e_add_f hW c 1
    simp only [one_smul, mul_one] at h
    simp only [Pi.add_apply] at hx0 ⊢
    rw [h]
    have : ∃ i, c i ≠ 0 := by
      by_contra hc
      push Not at hc
      exact hx0 (by simp [hc])
    obtain ⟨i, hi⟩ := this
    have hpos : 0 < ∑ j, c j ^ 2 :=
      lt_of_lt_of_le (by positivity : 0 < c i ^ 2) (Finset.single_le_sum (fun j _ => sq_nonneg (c j))
        (Finset.mem_univ i))
    linarith
  · intro y hy hy0
    obtain ⟨z, hz, w, hw, rfl⟩ := Submodule.mem_sup.1 hy
    obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).1 hw
    have h := Q_sum_e_add_f hW c (-1)
    simp only [neg_one_smul, ← sub_eq_add_neg] at h
    simp only [Pi.sub_apply] at hy0 ⊢
    have hzw : bil Q z (∑ i, c i • (e i - f i)) = 0 := by
      rw [bil_sum_right]
      refine Finset.sum_eq_zero fun i _ => ?_
      rw [bil_smul_right, bil_sub_right, hW.orth_e z hz, hW.orth_f z hz]; ring
    rw [Q_add, hzw, h]
    have hQz : Q z ≤ 0 := by
      by_cases hz0 : z = 0
      · rw [hz0, QuadraticMap.map_zero]
      · exact (hW.negDef z hz hz0).le
    have hsq : 0 ≤ ∑ i, c i ^ 2 := Finset.sum_nonneg fun i _ => sq_nonneg (c i)
    by_cases hz0 : z = 0
    · have : ∃ i, c i ≠ 0 := by
        by_contra hc
        push Not at hc
        exact hy0 (by simp [hc, hz0])
      obtain ⟨i, hi⟩ := this
      have hpos : 0 < ∑ j, c j ^ 2 :=
        lt_of_lt_of_le (by positivity : 0 < c i ^ 2) (Finset.single_le_sum (fun j _ => sq_nonneg (c j))
          (Finset.mem_univ i))
      linarith
    · have := hW.negDef z hz hz0
      linarith

end Definite

/-- **Theorem 14.3** (Shimura 2004, p. 140), *stated, not proved*: for a nondegenerate real quadratic space with a
Witt decomposition $V = Z + \sum_i(\mathbb R e_i + \mathbb R f_i)$, $\varphi$ negative definite on $Z$, let
$X = \sum_i\mathbb R(e_i + f_i)$, $Y = Z + \sum_i\mathbb R(e_i - f_i)$, $J = \sum_i \mathbb R e_i$ and
$K = G^1(X)G^1(Y)$. Then $\varphi$ is positive definite on $X$ and negative definite on $Y$, and
$G^1(V) = P^1K$, $G^+(V) = P^+K$, $G^0(V) = (P^+ \cap G^0(V))K$. -/
@[kb "shimura2004" "Thm. 14.3, p. 140 (G¹(V) = P¹K, G⁺(V) = P⁺K, G⁰(V) = (P⁺ ∩ G⁰(V))K, K = G¹(X)G¹(Y))"]
def Theorem14_3 : Prop :=
  ∀ (V : Type) [AddCommGroup V] [Module ℝ V] [FiniteDimensional ℝ V] (Q : QuadraticForm ℝ V)
    (hQ : (QuadraticMap.associated Q).Nondegenerate) (r : ℕ) (e f : Fin r → V) (Z : Submodule ℝ V),
    IsWittDecomposition Q e f Z →
    let X := Submodule.span ℝ (Set.range (e + f))
    let Y := Z ⊔ Submodule.span ℝ (Set.range (e - f))
    let J := Submodule.span ℝ (Set.range e)
    (∀ x ∈ X, x ≠ 0 → 0 < Q x) ∧ (∀ y ∈ Y, y ≠ 0 → Q y < 0) ∧
    (∀ a ∈ spinGroupG1 Q, ∃ p ∈ parabolicG1 Q J, ∃ k₁ ∈ subspaceSpinSet Q X, ∃ k₂ ∈ subspaceSpinSet Q Y,
      a = p * k₁ * k₂) ∧
    (∀ a ∈ M0 Q, ∃ p ∈ parabolicGPlus Q J, ∃ k₁ ∈ subspaceSpinSet Q X, ∃ k₂ ∈ subspaceSpinSet Q Y,
      a = p * k₁ * k₂) ∧
    (∀ a : M0 Q, a ∈ G0 hQ → ∃ p : M0 Q, p ∈ G0 hQ ∧ (p : (CliffordAlgebra Q)ˣ) ∈ parabolicGPlus Q J ∧
      ∃ k₁ ∈ subspaceSpinSet Q X, ∃ k₂ ∈ subspaceSpinSet Q Y, (a : (CliffordAlgebra Q)ˣ) = p * k₁ * k₂)

end QuadFormsKB.Shimura2004
