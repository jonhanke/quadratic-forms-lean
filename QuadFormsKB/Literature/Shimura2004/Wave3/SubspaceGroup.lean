/-
# Shimura 2004, (3.15): the Clifford groups $G^\pm(W)$ of a hyperplane $W = (F\kappa)^\perp$

**Source.** G. Shimura, *Arithmetic and Analytic Theories of Quadratic Forms and Clifford Groups*, Mathematical
Surveys and Monographs 109, American Mathematical Society, 2004 (key `shimura2004`), Chapter I, §3.4, formula
(3.15) (printed p. 26). Page numbers are printed pages.

**Setting and dictionary.** As in `Wave3/Splitting.lean`: $\kappa \in V$ with $\varphi[\kappa] \ne 0$,
$W = (F\kappa)^\perp$ (`orthHyperplane Q κ`), $A(W) \subseteq A(V)$ the subalgebra generated by $W$
(`cliffordSubalgebra Q κ`), $A^\pm(W) = A(W) \cap A^\pm(V)$.

**Shimura's $G^\pm(W)$.** Definition (3.1) applied to the space $W$: $G(W)$ is the set of $a \in A(W)^\times$ with
$a^{-1}Wa = W$, and $G^\pm(W) = G(W) \cap A^\pm(W)$. Here (`subspaceCliffordGroup Q κ i`, $i = 0$ for $+$,
$i = 1$ for $-$) an element of $G^\pm(W)$ is a unit $a$ of $A(V)$ with $a \in A^\pm(W)$, $a^{-1} \in A(W)$ (so $a$ is a
unit of $A(W)$) and $a^{-1}wa \in W$ for every $w \in W$. (Shimura identifies $A(W)$ with the subalgebra of $A(V)$
generated by $W$, which is legitimate because the natural map is injective for nondegenerate $\varphi$; that
injectivity is not needed below.)

**Proves** (unconditional; standard axioms only), for nondegenerate $\varphi$ and $\varphi[\kappa] \ne 0$:
* (3.15), second part: $G^+(W) = A(W) \cap G^+(V)$ (`mem_subspaceCliffordGroup_zero_iff`), and the odd companion
  $G^-(W) = A(W) \cap G^-(V)$ (`mem_subspaceCliffordGroup_one_iff`);
* the canonical involution preserves $A(W)$ (`reverse_mem_cliffordSubalgebra`), and $a^{-1}\kappa a = \pm\kappa$
  for $a \in A^\pm(W)$ invertible (`inv_mul_ι_mul_of_mem`).
-/
import QuadFormsKB.Literature.Shimura2004.Wave3.Splitting
import QuadFormsKB.Citation

open Module CliffordAlgebra

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.Shimura2004

open QuadFormsKB.Cassels QuadFormsKB.OMeara

variable {F V : Type*} [Field F] [Invertible (2 : F)] [AddCommGroup V] [Module F V] [FiniteDimensional F V]
  {Q : QuadraticForm F V}

local notation "A" => CliffordAlgebra Q

/-- An isometry preserves $\varphi(x, y)$. -/
theorem bil_map_of_mem_orth {g : V ≃ₗ[F] V} (hg : g ∈ orth Q) (x y : V) : bil Q (g x) (g y) = bil Q x y := by
  have h := hg (x + y)
  rw [map_add, Q_add, Q_add, hg x, hg y] at h
  have h4 : (2 : F) * bil Q (g x) (g y) = 2 * bil Q x y := by linear_combination h
  exact mul_left_cancel₀ (Invertible.ne_zero (2 : F)) h4

/-- The canonical involution $a \mapsto a^*$ preserves $A(W)$. -/
theorem reverse_mem_cliffordSubalgebra {κ : V} {x : A} (hx : x ∈ cliffordSubalgebra Q κ) :
    reverse x ∈ cliffordSubalgebra Q κ := by
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
    obtain ⟨w, hw, rfl⟩ := hy
    rw [reverse_ι]
    exact ι_mem_cliffordSubalgebra hw
  | algebraMap r => rw [reverse.commutes]; exact Subalgebra.algebraMap_mem _ r
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | mul x y _ _ hx hy => rw [reverse.map_mul]; exact mul_mem hy hx

/-- For $a \in A^\pm(W)$: $\kappa a = \pm a\kappa$ (from (3.14)). -/
theorem ι_mul_eq_sign_mul {κ : V} {a : A} (haW : a ∈ cliffordSubalgebra Q κ) {i : ZMod 2}
    (hai : a ∈ evenOdd Q i) : ι Q κ * a = (if i = 0 then a else -a) * ι Q κ := by
  rw [ι_mul_eq_involute_mul κ haW]
  have hpar : i = 0 ∨ i = 1 := (by decide : ∀ j : ZMod 2, j = 0 ∨ j = 1) i
  rcases hpar with rfl | rfl
  · rw [involute_eq_of_mem_even hai]; simp
  · rw [involute_eq_of_mem_odd hai]; simp

/-- For an invertible $a \in A^\pm(W)$: $a^{-1}\kappa a = \pm\kappa$. -/
theorem inv_mul_ι_mul_of_mem {κ : V} (a : (CliffordAlgebra Q)ˣ) (haW : (a : A) ∈ cliffordSubalgebra Q κ)
    {i : ZMod 2} (hai : (a : A) ∈ evenOdd Q i) :
    ((a⁻¹ : (CliffordAlgebra Q)ˣ) : A) * ι Q κ * (a : A) = ι Q (if i = 0 then κ else -κ) := by
  rw [mul_assoc, ι_mul_eq_sign_mul haW hai]
  split_ifs
  · rw [← mul_assoc, Units.inv_mul, one_mul]
  · rw [neg_mul, mul_neg, ← mul_assoc, Units.inv_mul, one_mul, map_neg]

variable (Q) in
/-- **Shimura's $G^\pm(W)$** for $W = (F\kappa)^\perp$ ((3.1) applied to $W$; §3.4, p. 26): the units $a$ of $A(V)$
with $a \in A(W)$, $a$ of parity $i$ ($i = 0$: $G^+(W)$, $i = 1$: $G^-(W)$), $a^{-1} \in A(W)$, and
$a^{-1}wa \in W$ for every $w \in W$. -/
@[kb "shimura2004" "(3.1) for W, §3.4, p. 26 (G^±(W) for W = (Fκ)^⊥)"]
def subspaceCliffordGroup (κ : V) (i : ZMod 2) : Set (CliffordAlgebra Q)ˣ :=
  {a | (a : A) ∈ cliffordSubalgebra Q κ ∧ (a : A) ∈ evenOdd Q i ∧
    ((a⁻¹ : (CliffordAlgebra Q)ˣ) : A) ∈ cliffordSubalgebra Q κ ∧
    ∀ w : V, Q.IsOrtho κ w → ∃ w' : V, Q.IsOrtho κ w' ∧ ι Q w' = ((a⁻¹ : (CliffordAlgebra Q)ˣ) : A) * ι Q w * a}

/-- An element of $G^\pm(W)$ conjugates $V$ into itself. -/
theorem mem_cliffordGroup_of_mem_subspaceCliffordGroup {κ : V} (hκ : Q κ ≠ 0) {i : ZMod 2}
    {a : (CliffordAlgebra Q)ˣ} (ha : a ∈ subspaceCliffordGroup Q κ i) : a ∈ cliffordGroup Q := by
  rw [mem_cliffordGroup_iff]
  intro v
  obtain ⟨w', -, hw'⟩ := ha.2.2.2 _ (isOrtho_sub_proj hκ v)
  refine ⟨w' + (bil Q v κ / Q κ) • (if i = 0 then κ else -κ), ?_⟩
  have hκa := inv_mul_ι_mul_of_mem a ha.1 ha.2.1
  have hv : ι Q v = ι Q (v - (bil Q v κ / Q κ) • κ) + (bil Q v κ / Q κ) • ι Q κ := by
    rw [map_sub, map_smul, sub_add_cancel]
  rw [map_add, map_smul, hw', ← hκa, hv, mul_add, add_mul, mul_smul_comm, smul_mul_assoc]

/-- Conversely an element of $A(W) \cap G(V)$ of parity $i$ conjugates $W$ into $W$. -/
theorem conj_mem_orthHyperplane {κ : V} {i : ZMod 2} {a : (CliffordAlgebra Q)ˣ} (ha : a ∈ cliffordGroup Q)
    (haW : (a : A) ∈ cliffordSubalgebra Q κ) (hai : (a : A) ∈ evenOdd Q i) {w : V} (hw : Q.IsOrtho κ w) :
    ∃ w' : V, Q.IsOrtho κ w' ∧ ι Q w' = ((a⁻¹ : (CliffordAlgebra Q)ˣ) : A) * ι Q w * a := by
  set t := tau (⟨a, ha⟩ : cliffordGroup Q)
  refine ⟨t w, ?_, tau_spec _ w⟩
  have htκ : t κ = if i = 0 then κ else -κ := by
    apply cliffordι_injective Q
    rw [tau_spec]
    exact inv_mul_ι_mul_of_mem a haW hai
  have hb := bil_map_of_mem_orth (tau_mem_orth (⟨a, ha⟩ : cliffordGroup Q)) κ w
  rw [isOrtho_iff_bil_eq_zero] at hw ⊢
  rw [hw, htκ] at hb
  split_ifs at hb
  · exact hb
  · rw [bil_neg_left, neg_eq_zero] at hb; exact hb

/-- For $a$ in $G'(V) \cap A(W)$, $a^{-1} = \nu(a)^{-1}a^* \in A(W)$. -/
theorem inv_mem_cliffordSubalgebra (hQ : (QuadraticMap.associated Q).Nondegenerate) {κ : V}
    (a : homogeneousCliffordGroup Q) (haW : ((a : (CliffordAlgebra Q)ˣ) : A) ∈ cliffordSubalgebra Q κ) :
    (((a : (CliffordAlgebra Q)ˣ)⁻¹ : (CliffordAlgebra Q)ˣ) : A) ∈ cliffordSubalgebra Q κ := by
  have h := algebraMap_multiplier hQ a
  set c : F := (multiplier hQ a : F)
  have hc : c ≠ 0 := (multiplier hQ a).ne_zero
  have hinv : (((a : (CliffordAlgebra Q)ˣ)⁻¹ : (CliffordAlgebra Q)ˣ) : A) =
      c⁻¹ • reverse ((a : (CliffordAlgebra Q)ˣ) : A) := by
    have e : ((a : (CliffordAlgebra Q)ˣ) : A) * (c⁻¹ • reverse ((a : (CliffordAlgebra Q)ˣ) : A)) = 1 := by
      rw [mul_smul_comm, ← h, Algebra.algebraMap_eq_smul_one, smul_smul, inv_mul_cancel₀ hc, one_smul]
    calc (((a : (CliffordAlgebra Q)ˣ)⁻¹ : (CliffordAlgebra Q)ˣ) : A)
        = (((a : (CliffordAlgebra Q)ˣ)⁻¹ : (CliffordAlgebra Q)ˣ) : A) * (((a : (CliffordAlgebra Q)ˣ) : A) *
            (c⁻¹ • reverse ((a : (CliffordAlgebra Q)ˣ) : A))) := by rw [e, mul_one]
      _ = _ := by rw [← mul_assoc, Units.inv_mul, one_mul]
  rw [hinv]
  exact Subalgebra.smul_mem _ (reverse_mem_cliffordSubalgebra haW) _

/-- $G^\pm(W) = A(W) \cap G(V) \cap A^\pm(V)$, for any parity $i$. -/
theorem mem_subspaceCliffordGroup_iff (hQ : (QuadraticMap.associated Q).Nondegenerate) {κ : V} (hκ : Q κ ≠ 0)
    (i : ZMod 2) (a : (CliffordAlgebra Q)ˣ) :
    a ∈ subspaceCliffordGroup Q κ i ↔
      a ∈ cliffordGroup Q ∧ (a : A) ∈ evenOdd Q i ∧ (a : A) ∈ cliffordSubalgebra Q κ := by
  constructor
  · intro ha
    exact ⟨mem_cliffordGroup_of_mem_subspaceCliffordGroup hκ ha, ha.2.1, ha.1⟩
  · rintro ⟨ha, hai, haW⟩
    have hhom : a ∈ homogeneousCliffordGroup Q := by
      refine ⟨ha, ?_⟩
      have hpar : i = 0 ∨ i = 1 := (by decide : ∀ j : ZMod 2, j = 0 ∨ j = 1) i
      rcases hpar with rfl | rfl
      · exact Or.inl hai
      · exact Or.inr hai
    exact ⟨haW, hai, inv_mem_cliffordSubalgebra hQ ⟨a, hhom⟩ haW,
      fun w hw => conj_mem_orthHyperplane ha haW hai hw⟩

/-- **(3.15)**, second part (Shimura 2004, p. 26): $G^+(W) = A(W) \cap G^+(V)$, for nondegenerate $\varphi$,
$\varphi[\kappa] \ne 0$ and $W = (F\kappa)^\perp$. -/
@[kb "shimura2004" "(3.15), p. 26 (G⁺(W) = A(W) ∩ G⁺(V))"]
theorem mem_subspaceCliffordGroup_zero_iff (hQ : (QuadraticMap.associated Q).Nondegenerate) {κ : V}
    (hκ : Q κ ≠ 0) (a : (CliffordAlgebra Q)ˣ) :
    a ∈ subspaceCliffordGroup Q κ 0 ↔ a ∈ M0 Q ∧ (a : A) ∈ cliffordSubalgebra Q κ := by
  rw [mem_subspaceCliffordGroup_iff hQ hκ, mem_M0_iff]
  tauto

/-- The odd companion of (3.15): $G^-(W) = A(W) \cap G^-(V)$. -/
@[kb "shimura2004" "(3.15), p. 26 (G⁻(W) = A(W) ∩ G⁻(V))"]
theorem mem_subspaceCliffordGroup_one_iff (hQ : (QuadraticMap.associated Q).Nondegenerate) {κ : V}
    (hκ : Q κ ≠ 0) (a : (CliffordAlgebra Q)ˣ) :
    a ∈ subspaceCliffordGroup Q κ 1 ↔ a ∈ cliffordGroupOdd Q ∧ (a : A) ∈ cliffordSubalgebra Q κ := by
  rw [mem_subspaceCliffordGroup_iff hQ hκ]
  simp only [cliffordGroupOdd, Set.mem_ofPred_eq]
  tauto

end QuadFormsKB.Shimura2004
