/-
# Shimura 2004, §13.4: the mass of the solution set $\Lambda[q,\mathfrak b]$ and formula (13.16)

**Source.** G. Shimura, *Arithmetic and Analytic Theories of Quadratic Forms and Clifford Groups*, Mathematical
Surveys and Monographs 109, American Mathematical Society, 2004 (key `shimura2004`), §13.4, definition
(13.14)–(13.15) and formula (13.16) (printed p. 133). Page numbers are printed pages.

**Setting.** $F$ is a number field, $V = F^n$ with the quadratic form `Q : QuadForm F n`, $\Lambda$ a lattice
(`Lat F n`), $q \in F$ and $\mathfrak b$ an $\mathcal O_F$-submodule of $F$. As in `HGenus.lean`, matrices act on the
left (Shimura acts on the right), $\Gamma(\Lambda)$ is `gammaLat Q Λ`, the solution set
$\Lambda[q,\mathfrak b]$ is `solSetLat Q Λ q b` and its orbit set is `solOrbits Q Λ q b`. In the compact (totally
definite) case Shimura's volume (13.12c) of a finite group $G$ is $v(G) = [G:1]^{-1}$, so
$$m(\Lambda[q,\mathfrak b]) = v(\Gamma(\Lambda))^{-1}\sum_{\beta\in B} v(\Lambda_\beta)
  = \#\Gamma(\Lambda)\sum_{\beta\in B}\frac{1}{\#\Lambda_\beta},$$
where $B$ is a set of orbit representatives and $\Lambda_\beta$ is the stabilizer of $\beta$ in $\Gamma(\Lambda)$
(equivalently $SO(W)\cap\beta\Gamma(\Lambda)\beta^{-1}$ with $W = (F\beta)^\perp$).

**Proves** (standard axioms only, no extra hypotheses beyond total positive definiteness)
* `gammaLat_mulAction`: $\Gamma(\Lambda)$ acts on $\Lambda[q,\mathfrak b]$;
* `finite_gammaLat`: $\Gamma(\Lambda)$ is finite for totally positive definite $\varphi$ (it acts faithfully on the
  finite sets of lattice vectors of the norms of a spanning family);
* `formula_13_16`: $m(\Lambda[q,\mathfrak b]) = \#\Lambda[q,\mathfrak b]$, the orbit-stabilizer theorem.
-/
import QuadFormsKB.Literature.Shimura2004.DefiniteFiniteness
import QuadFormsKB.Citation

open NumberField Matrix

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.Shimura2004

open QuadFormsKB.Lattices QuadFormsKB.Tamagawa

variable {F : Type} [Field F] [NumberField F] {n : ℕ} (Q : QuadForm F n) (Λ : Lat F n) (q : F)
  (b : Submodule (𝓞 F) F)

/-- For $\gamma \in \Gamma(\Lambda)$ the image $\gamma\Lambda$ equals $\Lambda$. -/
theorem glImage_gammaLat (γ : gammaLat Q Λ) : glImage (γ.1 : GL (Fin n) F) Λ.1 = Λ.1 := γ.2.2

/-- $\gamma\in\Gamma(\Lambda)$ preserves the bilinear form $\varphi(\cdot,\cdot)$ (Mathlib's `associated`
form of `Q.toQuadraticForm`, written `bil`). -/
theorem bil_mulVec_gammaLat [Invertible (2 : F)] (γ : gammaLat Q Λ) (a c : Fin n → F) :
    QuadFormsKB.OMeara.bil Q.toQuadraticForm ((γ.1 : GL (Fin n) F).val *ᵥ a) ((γ.1 : GL (Fin n) F).val *ᵥ c) =
      QuadFormsKB.OMeara.bil Q.toQuadraticForm a c := by
  have h := fun v : Fin n → F => eval_mulVec_of_mem Q γ.1.2 v
  simp only [QuadFormsKB.OMeara.bil, QuadraticMap.associated_apply, ← Matrix.mulVec_add,
    QuadForm.toQuadraticForm_apply, h]

/-- $\gamma\in\Gamma(\Lambda)$ preserves the ideal $\varphi(x,\Lambda)$ generated by $\varphi(x, \Lambda)$. -/
theorem phiIdeal_mulVec_gammaLat [Invertible (2 : F)] (γ : gammaLat Q Λ) (x : Fin n → F) :
    phiIdeal Q.toQuadraticForm ((γ.1 : GL (Fin n) F).val *ᵥ x) Λ.1 =
      phiIdeal Q.toQuadraticForm x Λ.1 := by
  have hm := glImage_gammaLat Q Λ γ
  unfold phiIdeal
  congr 1
  ext w
  simp only [Set.mem_image, SetLike.mem_coe]
  constructor
  · rintro ⟨y, hy, rfl⟩
    rw [← hm] at hy
    obtain ⟨z, hz, rfl⟩ := hy
    exact ⟨z, hz, (bil_mulVec_gammaLat Q Λ γ x z).symm⟩
  · rintro ⟨z, hz, rfl⟩
    refine ⟨(γ.1 : GL (Fin n) F).val *ᵥ z, ?_, bil_mulVec_gammaLat Q Λ γ x z⟩
    rw [← hm]
    exact mulVec_mem_glImage hz

theorem mulVec_mem_solSetLat (γ : gammaLat Q Λ) {x : Fin n → F} (hx : x ∈ solSetLat Q Λ q b) :
    (γ.1 : GL (Fin n) F).val *ᵥ x ∈ solSetLat Q Λ q b := by
  let _ : Invertible (2 : F) := invertibleOfNonzero two_ne_zero
  obtain ⟨h1, h2⟩ := hx
  refine ⟨?_, ?_⟩
  · rw [QuadForm.toQuadraticForm_apply, eval_mulVec_of_mem Q γ.1.2, ← QuadForm.toQuadraticForm_apply]
    exact h1
  · rw [phiIdeal_mulVec_gammaLat]
    exact h2

/-- **The action of $\Gamma(\Lambda)$ on $\Lambda[q,\mathfrak b]$** (Shimura 2004, §11.4, p. 103), by
$\gamma\cdot x = \gamma x$ (left action; Shimura's $x\gamma$). -/
instance gammaLat_mulAction : MulAction (gammaLat Q Λ) (solSetLat Q Λ q b) where
  smul γ x := ⟨(γ.1 : GL (Fin n) F).val *ᵥ x.1, mulVec_mem_solSetLat Q Λ q b γ x.2⟩
  one_smul x := Subtype.ext (by
    show (1 : Matrix (Fin n) (Fin n) F) *ᵥ x.1 = x.1
    simp)
  mul_smul γ δ x := Subtype.ext (by
    show ((γ.1 : GL (Fin n) F) * (δ.1 : GL (Fin n) F)).val *ᵥ x.1 =
      (γ.1 : GL (Fin n) F).val *ᵥ ((δ.1 : GL (Fin n) F).val *ᵥ x.1)
    rw [Units.val_mul, Matrix.mulVec_mulVec])

theorem gammaLat_smul_val (γ : gammaLat Q Λ) (x : solSetLat Q Λ q b) :
    ((γ • x : solSetLat Q Λ q b) : Fin n → F) = (γ.1 : GL (Fin n) F).val *ᵥ x.1 := rfl

/-- **Finiteness of $\Gamma(\Lambda)$** for a totally positive definite form: $\gamma$ is determined by the images
of the vectors $d\,e_j \in \Lambda$, and these lie in finite sets of lattice vectors of fixed norm
(`finite_solutions_of_totallyPosDef`). -/
theorem finite_gammaLat {Q : QuadForm F n} (hQ : Lattices.IsTotallyPosDef Q) (Λ : Lat F n) :
    Finite (gammaLat Q Λ) := by
  obtain ⟨d, hd0, hdΛ, -⟩ := exists_global_bounds Λ.2
  have hd0' : (d : F) ≠ 0 := by
    intro h; exact hd0 (by exact_mod_cast h)
  set v : Fin n → Fin n → F := fun j => (d : F) • Pi.single j 1 with hv
  have hvΛ : ∀ j, v j ∈ Λ.1 := fun j => by
    have hj : (Pi.single j (1 : F) : Fin n → F) ∈ (intVec : Submodule (𝓞 F) (Fin n → F)) := by
      intro i
      rw [Pi.single_apply]
      split_ifs
      · exact one_mem _
      · exact zero_mem _
    have := hdΛ _ hj
    rwa [show d • (Pi.single j (1 : F) : Fin n → F) = (d : F) • Pi.single j 1 from
      (algebraMap_smul F d _).symm] at this
  have hfin : ∀ j, Finite {x : Fin n → F // x ∈ Λ.1 ∧ Q.eval x = Q.eval (v j)} := fun j =>
    (finite_solutions_of_totallyPosDef hQ Λ (Q.eval (v j))).to_subtype
  let f : gammaLat Q Λ → ∀ j, {x : Fin n → F // x ∈ Λ.1 ∧ Q.eval x = Q.eval (v j)} :=
    fun γ j => ⟨(γ.1 : GL (Fin n) F).val *ᵥ v j, by
      have := mulVec_mem_glImage (γ := (γ.1 : GL (Fin n) F)) (hvΛ j)
      rw [glImage_gammaLat] at this
      exact ⟨this, eval_mulVec_of_mem Q γ.1.2 _⟩⟩
  have hf : Function.Injective f := by
    intro γ δ h
    have hcol : ∀ j, (γ.1 : GL (Fin n) F).val *ᵥ Pi.single j 1 = (δ.1 : GL (Fin n) F).val *ᵥ Pi.single j 1 := by
      intro j
      have h1 : (γ.1 : GL (Fin n) F).val *ᵥ v j = (δ.1 : GL (Fin n) F).val *ᵥ v j :=
        congrArg Subtype.val (congrFun h j)
      simp only [hv, Matrix.mulVec_smul] at h1
      exact smul_right_injective _ hd0' h1
    apply Subtype.ext
    apply Subtype.ext
    apply Units.ext
    ext i j
    have := congrFun (hcol j) i
    simpa [Matrix.mulVec, dotProduct, Pi.single_apply] using this
  have : ∀ j, Finite {x : Fin n → F // x ∈ Λ.1 ∧ Q.eval x = Q.eval (v j)} := hfin
  exact Finite.of_injective f hf

/-- Our polar form `Lattices.bil` is twice Mathlib's associated form `bil`. -/
theorem bil_eq_two_mul [Invertible (2 : F)] (x y : Fin n → F) :
    Lattices.bil Q x y = 2 * QuadFormsKB.OMeara.bil Q.toQuadraticForm x y := by
  have h := QuadForm.polar_eq_hessian F Q x y
  have e : Q.hessian.map (algebraMap F F) = Q.hessian := by ext; simp
  rw [e] at h
  rw [QuadFormsKB.OMeara.bil, QuadraticMap.associated_apply, QuadForm.toQuadraticForm_apply,
    QuadForm.toQuadraticForm_apply, QuadForm.toQuadraticForm_apply]
  change _ = 2 * (⅟2 * (Q.eval (x + y) - Q.eval x - Q.eval y))
  rw [← mul_assoc, mul_invOf_self, one_mul]
  exact h.symm

/-- **Finiteness of $\Lambda[q,\mathfrak b]$** for a totally positive definite form: every solution lies in
the lattice $(ce)^{-1}\Lambda$, where $c$ bounds the denominators of the dual lattice of $\Lambda$ and $e$ those of
$\mathfrak b$, and a lattice has finitely many vectors of a given norm. -/
theorem finite_solSetLat {Q : QuadForm F n} (hQ : Lattices.IsTotallyPosDef Q) (Λ : Lat F n) (q : F)
    (b : Submodule (𝓞 F) F) : (solSetLat Q Λ q b).Finite := by
  classical
  let _ : Invertible (2 : F) := invertibleOfNonzero two_ne_zero
  rcases (solSetLat Q Λ q b).eq_empty_or_nonempty with hE | ⟨x0, hx0⟩
  · rw [hE]; exact Set.finite_empty
  obtain ⟨c, hc0, hc⟩ := exists_dual_zsmul_mem Q hQ.nondegenerate Λ.2
  have hgen : SameGenus Q Λ.1 Λ.1 := fun v => ⟨1, (orthGroup Q _).one_mem, locAct_one _⟩
  -- denominators of b
  obtain ⟨s, hs⟩ := Λ.2.fg
  let f : (Fin n → F) →ₗ[𝓞 F] F :=
    ((QuadraticMap.associated (R := F) Q.toQuadraticForm x0).restrictScalars (𝓞 F))
  have hb : b = Submodule.span (𝓞 F) (↑(s.image f) : Set F) := by
    rw [← hx0.2]
    unfold phiIdeal
    have : QuadFormsKB.OMeara.bil Q.toQuadraticForm x0 '' (Λ.1 : Set (Fin n → F)) = ↑(Λ.1.map f) := by
      rw [Submodule.map_coe]; rfl
    rw [this, Submodule.span_eq, ← hs, Submodule.map_span, Finset.coe_image]
  obtain ⟨e, he0, he⟩ := exists_int_mul_mem (s.image f)
  have hbe : ∀ z ∈ b, (e : F) * z ∈ (algebraMap (𝓞 F) F).range := by
    intro z hz
    rw [hb] at hz
    induction hz using Submodule.span_induction with
    | mem z hz => exact he z (Finset.mem_coe.1 hz)
    | zero => simp
    | add a a' _ _ ha ha' => rw [mul_add]; exact (algebraMap (𝓞 F) F).range.add_mem ha ha'
    | smul r z _ hz =>
      have : (e : F) * (r • z) = (r : F) * ((e : F) * z) := by
        rw [Algebra.smul_def]; ring
      rw [this]; exact (algebraMap (𝓞 F) F).range.mul_mem ⟨r, rfl⟩ hz
  have hmem : ∀ x ∈ solSetLat Q Λ q b, (c * e : ℤ) • x ∈ Λ.1 := by
    intro x hx
    have h1 := hc Λ.1 Λ.2 hgen ((e : F) • x) (by
      intro m hm
      have hz : QuadFormsKB.OMeara.bil Q.toQuadraticForm x m ∈ b := by
        rw [← hx.2]; exact bil_mem_phiIdeal hm
      have := (algebraMap (𝓞 F) F).range.mul_mem ⟨2, map_ofNat _ 2⟩ (hbe _ hz)
      have e2 : Lattices.bil Q ((e : F) • x) m = (e : F) * Lattices.bil Q x m := by
        show ((e : F) • x) ⬝ᵥ (Q.hessian *ᵥ m) = (e : F) * (x ⬝ᵥ (Q.hessian *ᵥ m))
        rw [smul_dotProduct, smul_eq_mul]
      rw [e2, bil_eq_two_mul, show (e : F) * (2 * QuadFormsKB.OMeara.bil Q.toQuadraticForm x m) =
        2 * ((e : F) * QuadFormsKB.OMeara.bil Q.toQuadraticForm x m) by ring]
      exact this)
    rw [Int.cast_smul_eq_zsmul F] at h1
    rwa [mul_smul]
  have hk0 : ((c * e : ℤ) : F) ≠ 0 := by exact_mod_cast mul_ne_zero hc0 he0
  have hfin := finite_solutions_of_totallyPosDef hQ Λ (((c * e : ℤ) : F) ^ 2 * q)
  refine Set.Finite.of_finite_image (f := fun x => ((c * e : ℤ) : F) • x) (hfin.subset ?_) ?_
  · rintro _ ⟨x, hx, rfl⟩
    refine ⟨?_, ?_⟩
    · show ((c * e : ℤ) : F) • x ∈ Λ.1
      rw [Int.cast_smul_eq_zsmul F]; exact hmem x hx
    · show Q.eval (((c * e : ℤ) : F) • x) = _
      rw [ClassFin.eval_smul, ← QuadForm.toQuadraticForm_apply, hx.1]
  · intro x _ y _ h
    exact smul_right_injective _ hk0 h

/-- The orbit relation of $\Gamma(\Lambda)$ on $\Lambda[q,\mathfrak b]$ (the relation defining `solOrbits`). -/
def solRel (x y : solSetLat Q Λ q b) : Prop :=
  ∃ γ ∈ gammaLat Q Λ, (γ : GL (Fin n) F).val *ᵥ x.1 = y.1

/-- A chosen representative $\beta$ of an orbit $\beta\,\Gamma(\Lambda) \in \Lambda[q,\mathfrak b]/\Gamma(\Lambda)$. -/
def orbitRep (o : solOrbits Q Λ q b) : solSetLat Q Λ q b := (Quot.exists_rep (r := solRel Q Λ q b) o).choose

theorem mk_orbitRep (o : solOrbits Q Λ q b) :
    (Quot.mk (solRel Q Λ q b) (orbitRep Q Λ q b o) : solOrbits Q Λ q b) = o :=
  (Quot.exists_rep (r := solRel Q Λ q b) o).choose_spec

/-- **The mass $m(\Lambda[q,\mathfrak b])$ in the totally definite case** (Shimura 2004, (13.14), p. 133, with
the volume $v(G) = [G:1]^{-1}$ of a finite group, (13.12c)):
$$m(\Lambda[q,\mathfrak b]) = v(\Gamma(\Lambda))^{-1}\sum_{\beta\in B} v(\Lambda_\beta)
  = \#\Gamma(\Lambda)\sum_{\beta\in B}\frac{1}{\#\Lambda_\beta},$$
where $B$ is a set of representatives (`orbitRep`) of the orbits `solOrbits Q Λ q b`
of $\Gamma(\Lambda)$ on $\Lambda[q,\mathfrak b]$ and $\Lambda_\beta$ is the stabilizer of $\beta$ in $\Gamma(\Lambda)$
(`MulAction.stabilizer`; equivalently $SO(W)\cap\beta\Gamma(\Lambda)\beta^{-1}$, $W = (F\beta)^\perp$).
Matrices act on the left here (Shimura acts on the right). The sum is a `finsum` over the orbit set. -/
@[kb "shimura2004" "(13.14), p. 133 (mass m(Λ[q,𝔟]), definite case v(G) = 1/#G)"]
def massSolSet : ℝ :=
  (Nat.card (gammaLat Q Λ) : ℝ) *
    ∑ᶠ o : solOrbits Q Λ q b, (1 : ℝ) / Nat.card (MulAction.stabilizer (gammaLat Q Λ) (orbitRep Q Λ q b o))

/-- **Formula (13.16)** (Shimura 2004, p. 133), totally definite case: if $\varphi$ is totally positive definite
(`hQ`, so that $O(V)_{\mathbb R}$ is compact) then $m(\Lambda[q,\mathfrak b]) = \#\Lambda[q,\mathfrak b]$, for
every lattice $\Lambda$, $q\in F$ and $\mathcal O_F$-submodule $\mathfrak b\subseteq F$. Unconditional: the
finiteness of $\Gamma(\Lambda)$ and of $\Lambda[q,\mathfrak b]$ are proved (`finite_gammaLat`, `finite_solSetLat`);
the proof is the orbit-stabilizer theorem $\#\Gamma\sum_{\text{orbits}}1/\#\mathrm{Stab} = \sum_{\text{orbits}}\#\text{orbit}$. -/
@[kb "shimura2004" "(13.16), p. 133 (m(Λ[q,𝔟]) = #Λ[q,𝔟], definite case)"]
theorem formula_13_16 {Q : QuadForm F n} (hQ : Lattices.IsTotallyPosDef Q) (Λ : Lat F n) (q : F)
    (b : Submodule (𝓞 F) F) : massSolSet Q Λ q b = (Nat.card (solSetLat Q Λ q b) : ℝ) := by
  classical
  have hG := finite_gammaLat hQ Λ
  have hX : Finite (solSetLat Q Λ q b) := (finite_solSetLat hQ Λ q b).to_subtype
  have hO : Finite (solOrbits Q Λ q b) :=
    Finite.of_surjective (fun x : solSetLat Q Λ q b => (Quot.mk (solRel Q Λ q b) x : solOrbits Q Λ q b))
      (fun o => Quot.exists_rep (r := solRel Q Λ q b) o)
  let _ : Fintype (solOrbits Q Λ q b) := Fintype.ofFinite _
  let _ : Fintype (Quot (solRel Q Λ q b)) := Fintype.ofFinite _
  have hr : ∀ x y : solSetLat Q Λ q b, solRel Q Λ q b x y ↔ y ∈ MulAction.orbit (gammaLat Q Λ) x := by
    intro x y
    rw [MulAction.mem_orbit_iff]
    constructor
    · rintro ⟨γ, hγ, h⟩; exact ⟨⟨γ, hγ⟩, Subtype.ext h⟩
    · rintro ⟨γ, h⟩; exact ⟨γ.1, γ.2, congrArg Subtype.val h⟩
  have heq : Equivalence (solRel Q Λ q b) :=
    ⟨fun x => (hr x x).2 (MulAction.mem_orbit_self x),
     fun {x y} h => (hr y x).2 (MulAction.mem_orbit_symm.1 ((hr x y).1 h)),
     fun {x y z} h1 h2 => (hr x z).2 (by
       have := MulAction.orbit_eq_iff.2 ((hr x y).1 h1)
       rw [← this]; exact (hr y z).1 h2)⟩
  have hq : ∀ x y : solSetLat Q Λ q b,
      (Quot.mk (solRel Q Λ q b) x : solOrbits Q Λ q b) = Quot.mk (solRel Q Λ q b) y ↔ solRel Q Λ q b x y :=
    fun x y => ⟨fun h => heq.eqvGen_iff.1 (Quot.eqvGen_exact h), fun h => Quot.sound h⟩
  have hfib : ∀ o : solOrbits Q Λ q b,
      Nat.card {x : solSetLat Q Λ q b // (Quot.mk (solRel Q Λ q b) x : solOrbits Q Λ q b) = o} =
        Nat.card (MulAction.orbit (gammaLat Q Λ) (orbitRep Q Λ q b o)) := by
    intro o
    refine Nat.card_congr (Equiv.subtypeEquivRight fun x => ?_)
    have h1 : ((Quot.mk (solRel Q Λ q b) x : solOrbits Q Λ q b) = o) ↔
        (Quot.mk (solRel Q Λ q b) x : solOrbits Q Λ q b) = Quot.mk (solRel Q Λ q b) (orbitRep Q Λ q b o) := by
      rw [mk_orbitRep]
    exact h1.trans ((hq x _).trans ⟨fun h => heq.symm h, fun h => heq.symm h⟩ |>.trans (hr _ x))
  have hcard : Nat.card (solSetLat Q Λ q b) =
      ∑ o : solOrbits Q Λ q b, Nat.card (MulAction.orbit (gammaLat Q Λ) (orbitRep Q Λ q b o)) := by
    rw [← Nat.card_congr (Equiv.sigmaFiberEquiv (fun x : solSetLat Q Λ q b =>
      (Quot.mk (solRel Q Λ q b) x : solOrbits Q Λ q b))), Nat.card_sigma]
    exact Finset.sum_congr rfl fun o _ => hfib o
  rw [hcard, massSolSet, finsum_eq_sum_of_fintype, Finset.mul_sum, Nat.cast_sum]
  refine Finset.sum_congr rfl fun o _ => ?_
  set x := orbitRep Q Λ q b o
  have hos : Nat.card (MulAction.orbit (gammaLat Q Λ) x) * Nat.card (MulAction.stabilizer (gammaLat Q Λ) x) =
      Nat.card (gammaLat Q Λ) := by
    rw [← Nat.card_prod]; exact Nat.card_congr (MulAction.orbitProdStabilizerEquivGroup _ x)
  have hpos : 0 < Nat.card (MulAction.stabilizer (gammaLat Q Λ) x) := Nat.card_pos
  rw [← hos]
  push_cast
  field_simp

end QuadFormsKB.Shimura2004
