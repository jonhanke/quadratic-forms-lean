/-
# Shimura 2004, (3.13)–(3.15): splitting the Clifford algebra along an anisotropic vector

**Source.** G. Shimura, *Arithmetic and Analytic Theories of Quadratic Forms and Clifford Groups*, Mathematical
Surveys and Monographs 109, American Mathematical Society, 2004 (key `shimura2004`), Chapter I, §3.4, formulas
(3.13)–(3.15) (printed pp. 25–26). Page numbers are printed pages.

**Setting and dictionary.** As in `QuadFormsKB/Literature/Shimura2004/CliffordGroups.lean`: $F$ a field of
characteristic $\ne 2$, `Q : QuadraticForm F V` with $Q(x) = \varphi[x]$, $A(V)$ = `CliffordAlgebra Q`,
$A^\pm(V)$ = `evenOdd Q 0`, `evenOdd Q 1`, $a \mapsto a'$ = `involute`. Fix $\kappa \in V$ with
$\kappa^2 = \varphi[\kappa] \ne 0$ and let $W = (F\kappa)^\perp$ (`orthHyperplane Q κ`, the vectors $w$ with
$\varphi(\kappa, w) = 0$). As in `Wave2/Hyperplane.lean`, Shimura's $A(W)$ is the subalgebra of $A(V)$
generated by $W$ (`cliffordSubalgebra Q κ` = `Algebra.adjoin F (ι Q '' W)`), and
$A^\pm(W) = A(W) \cap A^\pm(V)$.

**Proves** (unconditional; standard axioms only):
* (3.13), first part: $A(V) = A(W) \oplus \kappa A(W)$ (`isCompl_cliffordSubalgebra`; existence of the
  decomposition `exists_decomp`, uniqueness `eq_zero_of_add_ι_mul_eq_zero`);
* (3.13), second part: $A^+(V) = A^+(W) \oplus \kappa A^-(W)$ (`evenOdd_zero_eq_sup`, with the sum direct by
  `disjoint_even_part`), and likewise $A^-(V) = A^-(W) \oplus \kappa A^+(W)$ (`evenOdd_one_eq_sup`);
* (3.14): $\kappa a = a'\kappa$ for $a \in A(W)$ (`ι_mul_eq_involute_mul`), in the form $a\kappa = \kappa a'$
  (`mul_ι_eq_ι_mul_involute`);
* (3.15), first part: $A^+(W) = \{a \in A(W) : a\kappa = \kappa a\}$ (`mul_ι_comm_iff_mem_even`).

The second part of (3.15), $G^+(W) = A(W) \cap G^+(V)$, is in `Wave3/SubspaceGroup.lean`.

The uniqueness of the decomposition uses the automorphism of $A(V)$ induced by the symmetry of $V$ in $\kappa$,
which fixes $A(W)$ pointwise and sends $\kappa \mapsto -\kappa$.
-/
import QuadFormsKB.Literature.Shimura2004.Wave2.Hyperplane
import QuadFormsKB.Citation

open Module CliffordAlgebra

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.Shimura2004

open QuadFormsKB.Cassels QuadFormsKB.OMeara

variable {F V : Type*} [Field F] [Invertible (2 : F)] [AddCommGroup V] [Module F V] [FiniteDimensional F V]
  {Q : QuadraticForm F V}

local notation "A" => CliffordAlgebra Q

/-- $x \perp y$ in Mathlib's sense ($Q(x+y) = Q(x) + Q(y)$) if and only if $\varphi(x,y) = 0$. -/
theorem isOrtho_iff_bil_eq_zero {x y : V} : Q.IsOrtho x y ↔ bil Q x y = 0 := by
  rw [QuadraticMap.isOrtho_def, Q_add]
  constructor
  · intro h
    have h2 : (2 : F) * bil Q x y = 0 := by linear_combination h
    exact (mul_eq_zero.1 h2).resolve_left (Invertible.ne_zero (2 : F))
  · intro h
    rw [h]; ring

variable (Q) in
/-- **Shimura's $A(W)$** for $W = (F\kappa)^\perp$ (§3.4, p. 25): the subalgebra of $A(V)$ generated by $W$. -/
@[kb "shimura2004" "§3.4, p. 25 (A(W) ⊂ A(V) for W = (Fκ)^⊥)"]
def cliffordSubalgebra (κ : V) : Subalgebra F (CliffordAlgebra Q) :=
  Algebra.adjoin F (ι Q '' orthHyperplane Q κ)

theorem ι_mem_cliffordSubalgebra {κ w : V} (hw : Q.IsOrtho κ w) : ι Q w ∈ cliffordSubalgebra Q κ :=
  Algebra.subset_adjoin ⟨w, hw, rfl⟩

/-- The grade automorphism preserves $A(W)$. -/
theorem involute_mem_cliffordSubalgebra {κ : V} {x : A} (hx : x ∈ cliffordSubalgebra Q κ) :
    involute x ∈ cliffordSubalgebra Q κ := by
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
    obtain ⟨w, hw, rfl⟩ := hy
    rw [involute_ι]
    exact neg_mem (ι_mem_cliffordSubalgebra hw)
  | algebraMap r => rw [AlgHom.commutes]; exact Subalgebra.algebraMap_mem _ r
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy

/-- **(3.14)** (p. 25) in the form $a\kappa = \kappa a'$ for $a \in A(W)$. -/
theorem mul_ι_eq_ι_mul_involute {κ : V} {a : A} (ha : a ∈ cliffordSubalgebra Q κ) :
    a * ι Q κ = ι Q κ * involute a := by
  have h := ι_mul_eq_involute_mul (Q := Q) κ (involute_mem_cliffordSubalgebra ha)
  rw [involute_involute] at h
  exact h.symm

/-- The component of $v$ along $W = (F\kappa)^\perp$: $v - \frac{\varphi(v,\kappa)}{\varphi[\kappa]}\kappa$. -/
theorem isOrtho_sub_proj {κ : V} (hκ : Q κ ≠ 0) (v : V) :
    Q.IsOrtho κ (v - (bil Q v κ / Q κ) • κ) := by
  rw [isOrtho_iff_bil_eq_zero, bil_sub_right, bil_smul_right, bil_self, bil_comm]
  field_simp
  ring

/-- **(3.13), existence** (p. 25): every $x \in A(V)$ is $p + \kappa q$ with $p, q \in A(W)$. -/
theorem exists_decomp {κ : V} (hκ : Q κ ≠ 0) (x : A) :
    ∃ p ∈ cliffordSubalgebra Q κ, ∃ q ∈ cliffordSubalgebra Q κ, x = p + ι Q κ * q := by
  induction x using CliffordAlgebra.induction with
  | algebraMap r =>
    exact ⟨algebraMap F A r, Subalgebra.algebraMap_mem _ r, 0, zero_mem _, by simp⟩
  | ι v =>
    refine ⟨ι Q (v - (bil Q v κ / Q κ) • κ), ι_mem_cliffordSubalgebra (isOrtho_sub_proj hκ v),
      algebraMap F A (bil Q v κ / Q κ), Subalgebra.algebraMap_mem _ _, ?_⟩
    rw [map_sub, map_smul, ← Algebra.commutes, ← Algebra.smul_def, sub_add_cancel]
  | add x y hx hy =>
    obtain ⟨p₁, hp₁, q₁, hq₁, rfl⟩ := hx
    obtain ⟨p₂, hp₂, q₂, hq₂, rfl⟩ := hy
    exact ⟨p₁ + p₂, add_mem hp₁ hp₂, q₁ + q₂, add_mem hq₁ hq₂, by rw [mul_add]; abel⟩
  | mul x y hx hy =>
    obtain ⟨p₁, hp₁, q₁, hq₁, rfl⟩ := hx
    obtain ⟨p₂, hp₂, q₂, hq₂, rfl⟩ := hy
    refine ⟨p₁ * p₂ + algebraMap F A (Q κ) * (involute q₁ * q₂),
      add_mem (mul_mem hp₁ hp₂) (mul_mem (Subalgebra.algebraMap_mem _ _)
        (mul_mem (involute_mem_cliffordSubalgebra hq₁) hq₂)),
      involute p₁ * q₂ + q₁ * p₂,
      add_mem (mul_mem (involute_mem_cliffordSubalgebra hp₁) hq₂) (mul_mem hq₁ hp₂), ?_⟩
    have e1 : p₁ * (ι Q κ * q₂) = ι Q κ * (involute p₁ * q₂) := by
      rw [← mul_assoc, mul_ι_eq_ι_mul_involute hp₁, mul_assoc]
    have e2 : ι Q κ * q₁ * (ι Q κ * q₂) = algebraMap F A (Q κ) * (involute q₁ * q₂) := by
      rw [mul_assoc, ← mul_assoc q₁, mul_ι_eq_ι_mul_involute hq₁, ← mul_assoc, ← mul_assoc, ι_sq_scalar,
        mul_assoc]
    simp only [add_mul, mul_add]
    rw [e1, e2]
    simp only [mul_assoc]
    abel

/-- The isometry of $V$ given by the symmetry in $\kappa$. -/
def symmetryIsometry {κ : V} (hκ : Q κ ≠ 0) : Q →qᵢ Q where
  toLinearMap := (symmetry Q κ hκ).toLinearMap
  map_app' := symmetry_mem_orth Q hκ

/-- The automorphism of $A(V)$ induced by the symmetry in $\kappa$. -/
def symmetryAlgHom {κ : V} (hκ : Q κ ≠ 0) : A →ₐ[F] A := CliffordAlgebra.map (symmetryIsometry hκ)

theorem symmetryAlgHom_ι_self {κ : V} (hκ : Q κ ≠ 0) : symmetryAlgHom hκ (ι Q κ) = -ι Q κ := by
  rw [symmetryAlgHom, map_apply_ι]
  change ι Q (symmetry Q κ hκ κ) = _
  rw [symmetry_apply, bil_self, ← map_neg]
  congr 1
  field_simp
  rw [show (2 : F) • κ = κ + κ from two_smul F κ]
  abel

theorem symmetryAlgHom_eq_self {κ : V} (hκ : Q κ ≠ 0) {x : A} (hx : x ∈ cliffordSubalgebra Q κ) :
    symmetryAlgHom hκ x = x := by
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
    obtain ⟨w, hw, rfl⟩ := hy
    rw [symmetryAlgHom, map_apply_ι]
    change ι Q (symmetry Q κ hκ w) = _
    rw [symmetry_apply, bil_comm, (isOrtho_iff_bil_eq_zero.1 hw)]
    simp
  | algebraMap r => rw [AlgHom.commutes]
  | add x y _ _ hx hy => rw [map_add, hx, hy]
  | mul x y _ _ hx hy => rw [map_mul, hx, hy]

/-- **(3.13), uniqueness** (p. 25): if $p + \kappa q = 0$ with $p, q \in A(W)$, then $p = q = 0$. -/
theorem eq_zero_of_add_ι_mul_eq_zero {κ : V} (hκ : Q κ ≠ 0) {p q : A}
    (hp : p ∈ cliffordSubalgebra Q κ) (hq : q ∈ cliffordSubalgebra Q κ) (h : p + ι Q κ * q = 0) :
    p = 0 ∧ q = 0 := by
  have h' := congrArg (symmetryAlgHom hκ) h
  rw [map_add, map_mul, symmetryAlgHom_eq_self hκ hp, symmetryAlgHom_eq_self hκ hq,
    symmetryAlgHom_ι_self, map_zero, neg_mul] at h'
  have hp0 : p = 0 := by
    have h2 : p = ι Q κ * q := add_neg_eq_zero.1 h'
    have : p = -p := by
      nth_rewrite 2 [h2]
      exact eq_neg_of_add_eq_zero_left h
    exact Cassels.eq_zero_of_eq_neg Q this
  refine ⟨hp0, ?_⟩
  rw [hp0, zero_add] at h
  have h2 : ι Q κ * (ι Q κ * q) = 0 := by rw [h, mul_zero]
  rw [← mul_assoc, ι_sq_scalar, ← Algebra.smul_def] at h2
  exact (smul_eq_zero.1 h2).resolve_left hκ

/-- **(3.13)** (Shimura 2004, p. 25): $A(V) = A(W) \oplus \kappa A(W)$ for $\kappa^2 \ne 0$ and
$W = (F\kappa)^\perp$, as complementary subspaces of $A(V)$. -/
@[kb "shimura2004" "(3.13), p. 25 (A(V) = A(W) ⊕ κA(W))"]
theorem isCompl_cliffordSubalgebra {κ : V} (hκ : Q κ ≠ 0) :
    IsCompl (Subalgebra.toSubmodule (cliffordSubalgebra Q κ))
      ((Subalgebra.toSubmodule (cliffordSubalgebra Q κ)).map (LinearMap.mulLeft F (ι Q κ))) := by
  constructor
  · rw [Submodule.disjoint_def]
    rintro x hx ⟨q, hq, rfl⟩
    have := eq_zero_of_add_ι_mul_eq_zero hκ (p := ι Q κ * q) (q := -q) hx (neg_mem hq)
      (by simp)
    exact this.1
  · rw [codisjoint_iff, Submodule.eq_top_iff']
    intro x
    obtain ⟨p, hp, q, hq, rfl⟩ := exists_decomp hκ x
    exact Submodule.add_mem_sup hp ⟨q, hq, rfl⟩

/-- $A^+(W) = A(W) \cap A^+(V)$ as a subspace. -/
def evenPartSub (Q : QuadraticForm F V) (κ : V) (i : ZMod 2) : Submodule F (CliffordAlgebra Q) :=
  Subalgebra.toSubmodule (cliffordSubalgebra Q κ) ⊓ evenOdd Q i

/-- Even and odd parts of an element of $A(W)$ stay in $A(W)$: $p = p_0 + p_1$ with
$p_0 = (p + p')/2 \in A^+(W)$ and $p_1 = (p - p')/2 \in A^-(W)$. -/
theorem exists_parts {κ : V} {p : A} (hp : p ∈ cliffordSubalgebra Q κ) :
    ∃ p₀ ∈ evenPartSub Q κ 0, ∃ p₁ ∈ evenPartSub Q κ 1, p = p₀ + p₁ := by
  refine ⟨⅟(2 : F) • (p + involute p), ⟨Subalgebra.smul_mem _ (add_mem hp
    (involute_mem_cliffordSubalgebra hp)) _, Cassels.mem_even_of_involute_eq Q ?_⟩,
    ⅟(2 : F) • (p - involute p), ⟨Subalgebra.smul_mem _ (sub_mem hp
    (involute_mem_cliffordSubalgebra hp)) _, Cassels.mem_odd_of_involute_eq_neg Q ?_⟩, ?_⟩
  · rw [map_smul, map_add, involute_involute, add_comm]
  · rw [map_smul, map_sub, involute_involute, ← smul_neg, neg_sub]
  · rw [← smul_add, add_add_sub_cancel, ← two_smul F p, smul_smul, invOf_mul_self, one_smul]

/-- The two parities in $A(V)$ meet only in $0$. -/
theorem eq_zero_of_mem_even_of_mem_odd {x : A} (h0 : x ∈ evenOdd Q 0) (h1 : x ∈ evenOdd Q 1) : x = 0 :=
  (Submodule.disjoint_def.1 (evenOdd_isCompl Q).disjoint) x h0 h1

/-- The graded form of (3.13): for $i \in \mathbb Z/2$, $A^i(V) = A^i(W) \oplus \kappa A^{i+1}(W)$ (sum part). -/
theorem evenOdd_eq_sup {κ : V} (hκ : Q κ ≠ 0) (i : ZMod 2) :
    evenOdd Q i = evenPartSub Q κ i ⊔ (evenPartSub Q κ (i + 1)).map (LinearMap.mulLeft F (ι Q κ)) := by
  apply le_antisymm
  · intro x hx
    obtain ⟨p, hp, q, hq, rfl⟩ := exists_decomp hκ x
    obtain ⟨p₀, hp₀, p₁, hp₁, rfl⟩ := exists_parts hp
    obtain ⟨q₀, hq₀, q₁, hq₁, rfl⟩ := exists_parts hq
    -- regroup into the part of parity `i` and the part of parity `i + 1`
    have hκ1 : ι Q κ ∈ evenOdd Q 1 := ι_mem_evenOdd_one Q κ
    have key : ∀ j : ZMod 2, (p₀ + p₁ + ι Q κ * (q₀ + q₁)) =
        ((if j = 0 then p₀ else p₁) + ι Q κ * (if j = 0 then q₁ else q₀)) +
        ((if j = 0 then p₁ else p₀) + ι Q κ * (if j = 0 then q₀ else q₁)) := by
      intro j
      split_ifs <;> · rw [mul_add]; abel
    have hpar : ∀ j : ZMod 2, j = 0 ∨ j = 1 := by decide
    rcases hpar i with rfl | rfl
    · rw [key 0] at hx ⊢
      simp only [ite_true] at hx ⊢
      have hA : p₀ + ι Q κ * q₁ ∈ evenOdd Q 0 := add_mem hp₀.2
        (by simpa [show (1 : ZMod 2) + 1 = 0 from rfl] using mul_mem_evenOdd hκ1 hq₁.2)
      have hB : p₁ + ι Q κ * q₀ ∈ evenOdd Q 1 := add_mem hp₁.2 (by simpa using mul_mem_evenOdd hκ1 hq₀.2)
      have hB0 : p₁ + ι Q κ * q₀ ∈ evenOdd Q 0 := by
        have := sub_mem hx hA
        rwa [add_sub_cancel_left] at this
      obtain ⟨rfl, rfl⟩ := eq_zero_of_add_ι_mul_eq_zero hκ hp₁.1 hq₀.1 (eq_zero_of_mem_even_of_mem_odd hB0 hB)
      simp only [mul_zero, add_zero]
      exact Submodule.add_mem_sup hp₀ ⟨q₁, hq₁, rfl⟩
    · rw [key 1] at hx ⊢
      simp only [show (1 : ZMod 2) ≠ 0 from by decide, ite_false] at hx ⊢
      have hA : p₁ + ι Q κ * q₀ ∈ evenOdd Q 1 := add_mem hp₁.2 (by simpa using mul_mem_evenOdd hκ1 hq₀.2)
      have hB : p₀ + ι Q κ * q₁ ∈ evenOdd Q 0 := add_mem hp₀.2
        (by simpa [show (1 : ZMod 2) + 1 = 0 from rfl] using mul_mem_evenOdd hκ1 hq₁.2)
      have hB1 : p₀ + ι Q κ * q₁ ∈ evenOdd Q 1 := by
        have := sub_mem hx hA
        rwa [add_sub_cancel_left] at this
      obtain ⟨rfl, rfl⟩ := eq_zero_of_add_ι_mul_eq_zero hκ hp₀.1 hq₁.1 (eq_zero_of_mem_even_of_mem_odd hB hB1)
      simp only [mul_zero, add_zero]
      exact Submodule.add_mem_sup hp₁ ⟨q₀, by simpa [show (1 : ZMod 2) + 1 = 0 from rfl] using hq₀, rfl⟩
  · refine sup_le inf_le_right ?_
    rintro _ ⟨q, hq, rfl⟩
    have := mul_mem_evenOdd (ι_mem_evenOdd_one Q κ) hq.2
    rw [show (1 : ZMod 2) + (i + 1) = i by ring_nf; rw [show (2 : ZMod 2) = 0 from rfl, zero_add]] at this
    exact this

/-- **(3.13)**, even part (Shimura 2004, p. 25): $A^+(V) = A^+(W) + \kappa A^-(W)$. -/
@[kb "shimura2004" "(3.13), p. 25 (A⁺(V) = A⁺(W) ⊕ κA⁻(W))"]
theorem evenOdd_zero_eq_sup {κ : V} (hκ : Q κ ≠ 0) :
    evenOdd Q 0 = evenPartSub Q κ 0 ⊔ (evenPartSub Q κ 1).map (LinearMap.mulLeft F (ι Q κ)) := by
  simpa using evenOdd_eq_sup hκ 0

/-- $A^-(V) = A^-(W) + \kappa A^+(W)$ (the odd companion of (3.13)). -/
theorem evenOdd_one_eq_sup {κ : V} (hκ : Q κ ≠ 0) :
    evenOdd Q 1 = evenPartSub Q κ 1 ⊔ (evenPartSub Q κ 0).map (LinearMap.mulLeft F (ι Q κ)) := by
  simpa [show (1 : ZMod 2) + 1 = 0 from rfl] using evenOdd_eq_sup hκ 1

/-- The sums in (3.13) are direct: $A^i(W) \cap \kappa A^j(W) = 0$. -/
theorem disjoint_even_part {κ : V} (hκ : Q κ ≠ 0) (i j : ZMod 2) :
    Disjoint (evenPartSub Q κ i) ((evenPartSub Q κ j).map (LinearMap.mulLeft F (ι Q κ))) :=
  (isCompl_cliffordSubalgebra hκ).disjoint.mono inf_le_left (Submodule.map_mono inf_le_left)

/-- **(3.15)**, first part (Shimura 2004, p. 26): $A^+(W) = \{a \in A(W) : a\kappa = \kappa a\}$. -/
@[kb "shimura2004" "(3.15), p. 26 (A⁺(W) = {a ∈ A(W) : aκ = κa})"]
theorem mul_ι_comm_iff_mem_even {κ : V} (hκ : Q κ ≠ 0) {a : A} (ha : a ∈ cliffordSubalgebra Q κ) :
    a * ι Q κ = ι Q κ * a ↔ a ∈ evenOdd Q 0 := by
  constructor
  · intro h
    rw [mul_ι_eq_ι_mul_involute ha] at h
    have h2 : ι Q κ * (ι Q κ * involute a) = ι Q κ * (ι Q κ * a) := by rw [h]
    rw [← mul_assoc, ← mul_assoc, ι_sq_scalar, ← Algebra.smul_def, ← Algebra.smul_def] at h2
    exact Cassels.mem_even_of_involute_eq Q (smul_right_injective _ hκ h2)
  · intro h
    rw [mul_ι_eq_ι_mul_involute ha, involute_eq_of_mem_even h]

end QuadFormsKB.Shimura2004
