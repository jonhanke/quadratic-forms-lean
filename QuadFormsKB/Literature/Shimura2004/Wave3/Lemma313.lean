/-
# Shimura 2004, Lemma 3.13: the elements of $G^+(V)$ relative to a hyperplane

**Source.** G. Shimura, *Arithmetic and Analytic Theories of Quadratic Forms and Clifford Groups*, Mathematical
Surveys and Monographs 109, American Mathematical Society, 2004 (key `shimura2004`), Chapter I, §3.4, Lemma 3.13
(printed p. 26). Page numbers are printed pages.

**Setting and dictionary.** As in `Wave3/Splitting.lean` and `Wave3/SubspaceGroup.lean`: $\varphi$ nondegenerate,
$\kappa \in V$ with $\kappa^2 = \varphi[\kappa] \ne 0$, $W = (F\kappa)^\perp$, $A(W) \subseteq A(V)$ the subalgebra
generated by $W$ (`cliffordSubalgebra Q κ`), $G^\pm(W)$ = `subspaceCliffordGroup Q κ 0`, `subspaceCliffordGroup Q κ 1`,
$G^+(V)$ = `Cassels.M0 Q`. By (3.13) every element of $A^+(V)$ is $p + \kappa q$ with $p \in A^+(W)$,
$q \in A^-(W)$.

**Lemma 3.13** says that $p + \kappa q$ lies in $G^+(V)$ exactly when it is of one of two types:
(1) $p \in G^+(W)$ and $q \in Wp$; (2) $q \in G^-(W)$ and $p \in Wq$; with $pp^* + \kappa^2 qq^* \ne 0$; and then
$\nu(p + \kappa q) = pp^* + \kappa^2 qq^*$.

**Proves** (unconditional; standard axioms only):
* `mem_cliffordSubalgebra_iff`: $A(W) = \{a \in A(V) : a\kappa = \kappa a'\}$ (the converse of (3.14));
* `lemma_3_13`: every $a \in G^+(V)$ is $p + \kappa xp$ with $p \in G^+(W)$, $x \in W$ (type 1), or
  $yq + \kappa q$ with $q \in G^-(W)$, $y \in W$ (type 2);
* `lemma_3_13_type1_mem`, `lemma_3_13_type2_mem`: conversely such elements lie in $G^+(V)$ when
  $pp^* + \kappa^2qq^* \ne 0$;
* `lemma_3_13_type1_norm`, `lemma_3_13_type2_norm`: $(p + \kappa q)(p + \kappa q)^* = pp^* + \kappa^2 qq^*$ for both
  types, with $pp^*$, $qq^*$ the explicit scalars $\nu(p)$, $\nu(p)\varphi[x]$ (type 1) and $\nu(q)\varphi[y]$,
  $\nu(q)$ (type 2).

*Proof idea* (Shimura's): for $a \in G^+(V)$ put $v = a\kappa a^{-1} \in V$, $\varphi[v] = \varphi[\kappa]$, and write
$v = w_0 + t\kappa$ with $w_0 \in W$. If $t \ne -1$, $u = v + \kappa$ is anisotropic, $u\kappa u^{-1} = v$, and
$p = (u\kappa)^{-1}a$ commutes with $\kappa$, so $p \in G^+(W)$ and $a = u\kappa p = (\varphi[\kappa](1+t) - \kappa w_0)p$.
If $t = -1$, $u = v - \kappa = w_0 - 2\kappa$ is anisotropic, $u\kappa u^{-1} = -v$, $p = u^{-1}a$ anticommutes with
$\kappa$, so $p \in G^-(W)$ and $a = w_0 p - 2\kappa p$.
-/
import QuadFormsKB.Literature.Shimura2004.Wave3.SubspaceGroup
import QuadFormsKB.Literature.Shimura2004.Wave2.Multiplier
import QuadFormsKB.Citation

open Module CliffordAlgebra

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.Shimura2004

open QuadFormsKB.Cassels QuadFormsKB.OMeara

variable {F V : Type*} [Field F] [Invertible (2 : F)] [AddCommGroup V] [Module F V] [FiniteDimensional F V]
  {Q : QuadraticForm F V}

local notation "A" => CliffordAlgebra Q

/-- Mathlib's polar form is twice $\varphi$. -/
theorem polar_eq_two_mul_bil (x y : V) : QuadraticMap.polar Q x y = 2 * bil Q x y := by
  rw [QuadraticMap.polar, Q_add]; ring

/-- **Converse of (3.14)**: $A(W) = \{a \in A(V) : a\kappa = \kappa a'\}$ for $\varphi[\kappa] \ne 0$. -/
@[kb "shimura2004" "(3.14), p. 25 (A(W) = {a ∈ A(V) : aκ = κa'})"]
theorem mem_cliffordSubalgebra_iff {κ : V} (hκ : Q κ ≠ 0) (p : A) :
    p ∈ cliffordSubalgebra Q κ ↔ p * ι Q κ = ι Q κ * involute p := by
  refine ⟨mul_ι_eq_ι_mul_involute, fun h => ?_⟩
  obtain ⟨p₁, hp₁, q₁, hq₁, rfl⟩ := exists_decomp hκ p
  rw [add_mul, mul_assoc, mul_ι_eq_ι_mul_involute hq₁, ← mul_assoc, ι_sq_scalar,
    mul_ι_eq_ι_mul_involute hp₁, map_add, map_mul, involute_ι, mul_add, neg_mul, mul_neg,
    ← mul_assoc (ι Q κ) (ι Q κ), ι_sq_scalar, add_right_inj] at h
  have h0 : algebraMap F A (Q κ) * involute q₁ = 0 := Cassels.eq_zero_of_eq_neg Q h
  rw [← Algebra.smul_def] at h0
  have hq : involute q₁ = 0 := (smul_eq_zero.1 h0).resolve_left hκ
  have hq0 : q₁ = 0 := by rw [← involute_involute q₁, hq, map_zero]
  rw [hq0, mul_zero, add_zero]
  exact hp₁

/-- A scalar $r \in F^\times$ times an element of $G^\pm(W)$ is in $G^\pm(W)$. -/
theorem scalar_mul_mem_subspaceCliffordGroup (hQ : (QuadraticMap.associated Q).Nondegenerate) {κ : V}
    (hκ : Q κ ≠ 0) {i : ZMod 2} (r : Fˣ) {p : (CliffordAlgebra Q)ˣ} (hp : p ∈ subspaceCliffordGroup Q κ i) :
    Units.map (algebraMap F A).toMonoidHom r * p ∈ subspaceCliffordGroup Q κ i := by
  rw [mem_subspaceCliffordGroup_iff hQ hκ] at hp ⊢
  obtain ⟨hpG, hpi, hpW⟩ := hp
  refine ⟨(cliffordGroup Q).mul_mem (M0_le (scalar_mem_M0 r)) hpG, ?_, ?_⟩
  · simpa using mul_mem_evenOdd (algebraMap_mem_evenOdd_zero (r : F)) hpi
  · exact mul_mem (Subalgebra.algebraMap_mem _ _) hpW

/-- $ux u^{-1} = y$ in the form $ux = yu$, for an anisotropic $u$ and $y = -(x - \frac{\mathrm{polar}(x,u)}{Q(u)}u)$. -/
theorem ι_mul_ι_eq_of_conj {u x y : V} (hu : Q u ≠ 0)
    (hy : -(x - (QuadraticMap.polar Q x u / Q u) • u) = y) : ι Q u * ι Q x = ι Q y * ι Q u := by
  have h := vecUnit_conj u hu x
  rw [hy] at h
  calc ι Q u * ι Q x = ι Q u * ι Q x * (((vecUnit u hu)⁻¹ : (CliffordAlgebra Q)ˣ) * vecUnit u hu : A) := by
        rw [← Units.val_mul, inv_mul_cancel, Units.val_one, mul_one]
    _ = (ι Q u * ι Q x * ((vecUnit u hu)⁻¹ : (CliffordAlgebra Q)ˣ)) * ι Q u := by
        rw [mul_assoc (ι Q u * ι Q x)]; rfl
    _ = ι Q y * ι Q u := by rw [← h]; rfl

/-- $x \perp y$ is preserved by scaling $y$. -/
theorem isOrtho_smul_right {κ w : V} (hw : Q.IsOrtho κ w) (r : F) : Q.IsOrtho κ (r • w) := by
  rw [isOrtho_iff_bil_eq_zero] at hw ⊢
  rw [bil_smul_right, hw, mul_zero]

/-- **Lemma 3.13** (Shimura 2004, p. 26), the main assertion: for nondegenerate $\varphi$, $\varphi[\kappa] \ne 0$
and $W = (F\kappa)^\perp$, every $a \in G^+(V)$ is either $p + \kappa(xp)$ with $p \in G^+(W)$ and $x \in W$
(type 1: $q = xp \in Wp$), or $yq + \kappa q$ with $q \in G^-(W)$ and $y \in W$ (type 2: $p = yq \in Wq$). -/
@[kb "shimura2004" "Lemma 3.13, p. 26 (G⁺(V) ∋ p + κq with p ∈ G⁺(W), q ∈ Wp, or q ∈ G⁻(W), p ∈ Wq)"]
theorem lemma_3_13 (hQ : (QuadraticMap.associated Q).Nondegenerate) {κ : V} (hκ : Q κ ≠ 0)
    (a : (CliffordAlgebra Q)ˣ) (ha : a ∈ M0 Q) :
    (∃ p ∈ subspaceCliffordGroup Q κ 0, ∃ x : V, Q.IsOrtho κ x ∧
        (a : A) = (p : A) + ι Q κ * (ι Q x * p)) ∨
    (∃ q ∈ subspaceCliffordGroup Q κ 1, ∃ y : V, Q.IsOrtho κ y ∧
        (a : A) = ι Q y * q + ι Q κ * q) := by
  set ag : cliffordGroup Q := ⟨a, ha.2⟩
  set v := conjHom ag κ with hv
  have hvQ : Q v = Q κ := conjHom_isometry ag κ
  have hvspec : ι Q v = (a : A) * ι Q κ * ((a⁻¹ : (CliffordAlgebra Q)ˣ) : A) := conjHom_spec ag κ
  -- `aκ = va`
  have E1 : (a : A) * ι Q κ = ι Q v * a := by
    rw [hvspec, mul_assoc _ _ (a : A), Units.inv_mul, mul_one]
  obtain ⟨t, ht⟩ : ∃ t : F, bil Q v κ = t * Q κ := ⟨bil Q v κ / Q κ, by field_simp⟩
  obtain ⟨w₀, hw₀o, hvdec⟩ : ∃ w₀ : V, Q.IsOrtho κ w₀ ∧ v = w₀ + t • κ := by
    refine ⟨v - t • κ, ?_, (sub_add_cancel _ _).symm⟩
    have := isOrtho_sub_proj hκ v
    rwa [ht, mul_div_cancel_right₀ _ hκ] at this
  have hκb : bil Q κ v = t * Q κ := by rw [bil_comm, ht]
  have h2 : (2 : F) ≠ 0 := Invertible.ne_zero 2
  -- `w₀κ = -κw₀`
  have hw₀κ : ι Q w₀ * ι Q κ = -(ι Q κ * ι Q w₀) := ι_mul_ι_comm_of_isOrtho hw₀o.symm
  have ha0 : (a : A) ∈ evenOdd Q 0 := ha.1
  by_cases ht1 : t = -1
  · -- type 2: `u = v - κ`, `uκu⁻¹ = -v`
    subst ht1
    right
    set u := v - κ with hu
    have huQ : Q u = 4 * Q κ := by
      have hneg : bil Q v (-κ) = -(-1 * Q κ) := by rw [bil_comm, bil_neg_left, hκb]
      rw [hu, sub_eq_add_neg, Q_add, QuadraticMap.map_neg, hneg, hvQ]; ring
    have hc4 : (4 : F) * Q κ ≠ 0 := mul_ne_zero (by
      have : (4 : F) = 2 * 2 := by norm_num
      rw [this]; exact mul_ne_zero h2 h2) hκ
    have hu0 : Q u ≠ 0 := by rw [huQ]; exact hc4
    have E2 : ι Q u * ι Q κ = ι Q (-v) * ι Q u := by
      apply ι_mul_ι_eq_of_conj hu0
      rw [polar_eq_two_mul_bil, hu, bil_sub_right, hκb, bil_self, huQ]
      rw [show 2 * (-1 * Q κ - Q κ) / (4 * Q κ) = (-1 : F) by rw [div_eq_iff hc4]; ring]
      rw [neg_one_smul, sub_neg_eq_add, add_sub_cancel]
    set U := vecUnit u hu0
    set p : (CliffordAlgebra Q)ˣ := U⁻¹ * a
    have hUp : (U : A) * p = a := by simp [p]
    have hpodd : (p : A) ∈ evenOdd Q 1 := by
      have hUi : ((U⁻¹ : (CliffordAlgebra Q)ˣ) : A) ∈ evenOdd Q 1 :=
        mem_evenOdd_of_mul_eq_one Q (ι_mem_evenOdd_one Q u) U.mul_inv
      show ((U⁻¹ * a : (CliffordAlgebra Q)ˣ) : A) ∈ evenOdd Q 1
      rw [Units.val_mul]
      simpa using mul_mem_evenOdd hUi ha0
    have hpG : p ∈ cliffordGroup Q :=
      (cliffordGroup Q).mul_mem ((cliffordGroup Q).inv_mem (vecUnit_mem u hu0)) ha.2
    -- `pκ = -κp = κp'`
    have hpκ : (p : A) * ι Q κ = ι Q κ * involute (p : A) := by
      rw [involute_eq_of_mem_odd hpodd]
      apply (Units.mul_right_inj U).1
      change (U : A) * ((p : A) * ι Q κ) = (U : A) * (ι Q κ * -(p : A))
      have L : (U : A) * ((p : A) * ι Q κ) = ι Q v * a := by rw [← mul_assoc, hUp, E1]
      have R : (U : A) * (ι Q κ * -(p : A)) = ι Q v * a := by
        rw [mul_neg, mul_neg, ← mul_assoc]
        change -(ι Q u * ι Q κ * (p : A)) = _
        rw [E2, map_neg]
        simp only [neg_mul, neg_neg]
        rw [mul_assoc]
        exact congrArg _ hUp
      exact L.trans R.symm
    have hpW : (p : A) ∈ cliffordSubalgebra Q κ := (mem_cliffordSubalgebra_iff hκ _).2 hpκ
    have hpS : p ∈ subspaceCliffordGroup Q κ 1 :=
      (mem_subspaceCliffordGroup_one_iff hQ hκ p).2 ⟨⟨hpG, hpodd⟩, hpW⟩
    have hm2 : (-2 : F) ≠ 0 := neg_ne_zero.2 h2
    refine ⟨Units.map (algebraMap F A).toMonoidHom (Units.mk0 (-2) hm2) * p,
      scalar_mul_mem_subspaceCliffordGroup hQ hκ _ hpS, (-2 : F)⁻¹ • w₀, isOrtho_smul_right hw₀o _, ?_⟩
    have hval : ((Units.map (algebraMap F A).toMonoidHom (Units.mk0 (-2) hm2) * p :
        (CliffordAlgebra Q)ˣ) : A) = (-2 : F) • (p : A) := by
      rw [Units.val_mul, Algebra.smul_def]; rfl
    have hu' : u = w₀ + (-2 : F) • κ := by
      rw [hu, hvdec]; module
    rw [hval, ← hUp]
    change ι Q u * (p : A) = _
    rw [hu', map_add, map_smul, map_smul, add_mul]
    simp only [smul_mul_assoc, mul_smul_comm, smul_smul, mul_inv_cancel₀ hm2, one_smul]
  · -- type 1: `u = v + κ`, `uκu⁻¹ = v`
    left
    have ht1' : 1 + t ≠ 0 := fun h => ht1 (by linear_combination h)
    set u := v + κ with hu
    have huQ : Q u = 2 * Q κ * (1 + t) := by
      rw [hu, Q_add, hvQ, ht]; ring
    have hu0 : Q u ≠ 0 := by rw [huQ]; exact mul_ne_zero (mul_ne_zero h2 hκ) ht1'
    have E2 : ι Q u * ι Q κ = ι Q v * ι Q u := by
      apply ι_mul_ι_eq_of_conj hu0
      rw [polar_eq_two_mul_bil, hu, bil_add_right, hκb, bil_self, huQ]
      rw [show 2 * (t * Q κ + Q κ) / (2 * Q κ * (1 + t)) = (1 : F) by
        rw [div_eq_iff (by rw [← huQ]; exact hu0)]; ring]
      rw [one_smul, neg_sub, add_sub_cancel_right]
    set U := vecUnit u hu0
    set K := vecUnit κ hκ
    set p : (CliffordAlgebra Q)ˣ := (U * K)⁻¹ * a
    have hUKp : ((U * K : (CliffordAlgebra Q)ˣ) : A) * p = a := by
      rw [← Units.val_mul, mul_inv_cancel_left]
    have hUK : ((U * K : (CliffordAlgebra Q)ˣ) : A) = ι Q u * ι Q κ := rfl
    have hUKM : U * K ∈ M0 Q := by
      refine ⟨?_, (cliffordGroup Q).mul_mem (vecUnit_mem u hu0) (vecUnit_mem κ hκ)⟩
      rw [hUK]
      simpa [show (1 : ZMod 2) + 1 = 0 from rfl] using
        mul_mem_evenOdd (ι_mem_evenOdd_one Q u) (ι_mem_evenOdd_one Q κ)
    have hpM : p ∈ M0 Q := (M0 Q).mul_mem ((M0 Q).inv_mem hUKM) ha
    -- `pκ = κp`
    have hpκ : (p : A) * ι Q κ = ι Q κ * involute (p : A) := by
      rw [involute_eq_of_mem_even hpM.1]
      apply (Units.mul_right_inj (U * K)).1
      change ((U * K : (CliffordAlgebra Q)ˣ) : A) * ((p : A) * ι Q κ) =
        ((U * K : (CliffordAlgebra Q)ˣ) : A) * (ι Q κ * (p : A))
      have L : ((U * K : (CliffordAlgebra Q)ˣ) : A) * ((p : A) * ι Q κ) = ι Q v * a := by
        rw [← mul_assoc, hUKp, E1]
      have R : ((U * K : (CliffordAlgebra Q)ˣ) : A) * (ι Q κ * (p : A)) = ι Q v * a := by
        rw [← hUKp, hUK]
        calc ι Q u * ι Q κ * (ι Q κ * (p : A)) = (ι Q u * ι Q κ) * ι Q κ * (p : A) := by
              simp only [mul_assoc]
          _ = ι Q v * (ι Q u * ι Q κ * (p : A)) := by
              conv_lhs => rw [E2]
              simp only [mul_assoc]
      exact L.trans R.symm
    have hpW : (p : A) ∈ cliffordSubalgebra Q κ := (mem_cliffordSubalgebra_iff hκ _).2 hpκ
    have hpS : p ∈ subspaceCliffordGroup Q κ 0 :=
      (mem_subspaceCliffordGroup_zero_iff hQ hκ p).2 ⟨hpM, hpW⟩
    obtain ⟨r, hr⟩ : ∃ r : F, r = Q κ * (1 + t) := ⟨_, rfl⟩
    have hr0 : r ≠ 0 := by rw [hr]; exact mul_ne_zero hκ ht1'
    refine ⟨Units.map (algebraMap F A).toMonoidHom (Units.mk0 r hr0) * p,
      scalar_mul_mem_subspaceCliffordGroup hQ hκ _ hpS, (-r⁻¹) • w₀, isOrtho_smul_right hw₀o _, ?_⟩
    have hval : ((Units.map (algebraMap F A).toMonoidHom (Units.mk0 r hr0) * p :
        (CliffordAlgebra Q)ˣ) : A) = r • (p : A) := by
      rw [Units.val_mul, Algebra.smul_def]; rfl
    rw [hval, ← hUKp, hUK, hu, hvdec]
    simp only [map_add, map_smul, map_neg, add_mul, smul_mul_assoc, mul_smul_comm, neg_mul, mul_neg,
      neg_smul, mul_assoc]
    rw [← mul_assoc (ι Q w₀), hw₀κ, ← mul_assoc (ι Q κ) (ι Q κ), ι_sq_scalar, ← Algebra.smul_def]
    simp only [neg_mul, mul_assoc, smul_smul]
    have hr0' : Q κ + Q κ * t ≠ 0 := by
      intro h; apply hr0; rw [hr]; linear_combination h
    match_scalars
    all_goals first
      | (rw [hr]; ring1)
      | (rw [hr]; field_simp)

/-- The norm computation behind Lemma 3.13: if $pq^* = qp^* = s\,y$ with $y \in W$ and $qq^* = d \in F$, then
$(p + \kappa q)(p + \kappa q)^* = pp^* + \kappa^2 qq^*$. -/
theorem mul_reverse_add_ι_mul {κ y : V} (hy : Q.IsOrtho κ y) (p q : A) (s d : F)
    (h1 : p * reverse q = s • ι Q y) (h2 : q * reverse p = s • ι Q y) (h3 : q * reverse q = algebraMap F A d) :
    (p + ι Q κ * q) * reverse (p + ι Q κ * q) = p * reverse p + algebraMap F A (Q κ * d) := by
  rw [map_add, reverse.map_mul, reverse_ι]
  simp only [add_mul, mul_add]
  have e1 : p * (reverse q * ι Q κ) = s • (ι Q y * ι Q κ) := by rw [← mul_assoc, h1, smul_mul_assoc]
  have e2 : ι Q κ * q * reverse p = s • (ι Q κ * ι Q y) := by rw [mul_assoc, h2, mul_smul_comm]
  have e3 : ι Q κ * q * (reverse q * ι Q κ) = algebraMap F A (Q κ * d) := by
    rw [mul_assoc, ← mul_assoc q, h3, Algebra.commutes, ← mul_assoc, ι_sq_scalar, ← map_mul]
  have e4 : s • (ι Q y * ι Q κ) + s • (ι Q κ * ι Q y) = 0 := by
    rw [← smul_add, ι_mul_ι_add_swap_of_isOrtho hy.symm, smul_zero]
  rw [e1, e2, e3, eq_neg_of_add_eq_zero_left e4]
  abel

/-- **Lemma 3.13**, type 1, norm (Shimura 2004, p. 26): for $x \in W$ and $p$ with $pp^* = c \in F$ (e.g.
$p \in G^+(W)$, $c = \nu(p)$), $q = xp$ satisfies $pq^*, qp^* \in W$, $qq^* = c\,\varphi[x]$, and
$(p + \kappa q)(p + \kappa q)^* = pp^* + \kappa^2 qq^* = c(1 + \varphi[\kappa]\varphi[x])$. -/
@[kb "shimura2004" "Lemma 3.13, p. 26 (type 1: ν(p + κq) = pp* + κ²qq*)"]
theorem lemma_3_13_type1_norm {κ x : V} (hx : Q.IsOrtho κ x) (p : A) (c : F)
    (hp : p * reverse p = algebraMap F A c) :
    p * reverse (ι Q x * p) = c • ι Q x ∧ (ι Q x * p) * reverse p = c • ι Q x ∧
    (ι Q x * p) * reverse (ι Q x * p) = algebraMap F A (c * Q x) ∧
    (p + ι Q κ * (ι Q x * p)) * reverse (p + ι Q κ * (ι Q x * p)) = algebraMap F A (c * (1 + Q κ * Q x)) := by
  have h1 : p * reverse (ι Q x * p) = c • ι Q x := by
    rw [reverse.map_mul, reverse_ι, ← mul_assoc, hp, ← Algebra.smul_def]
  have h2 : (ι Q x * p) * reverse p = c • ι Q x := by
    rw [mul_assoc, hp, ← Algebra.commutes, ← Algebra.smul_def]
  have h3 : (ι Q x * p) * reverse (ι Q x * p) = algebraMap F A (c * Q x) := by
    rw [reverse.map_mul, reverse_ι]
    calc ι Q x * p * (reverse p * ι Q x) = ι Q x * (p * reverse p) * ι Q x := by simp only [mul_assoc]
      _ = algebraMap F A c * (ι Q x * ι Q x) := by rw [hp, ← Algebra.commutes, mul_assoc]
      _ = algebraMap F A (c * Q x) := by rw [ι_sq_scalar, ← map_mul]
  refine ⟨h1, h2, h3, ?_⟩
  rw [mul_reverse_add_ι_mul hx p _ c (c * Q x) h1 h2 h3, hp, ← map_add]
  ring_nf

/-- **Lemma 3.13**, type 2, norm (Shimura 2004, p. 26): for $y \in W$ and $q$ with $qq^* = d \in F$ (e.g.
$q \in G^-(W)$, $d = \nu(q)$), $p = yq$ satisfies $pq^*, qp^* \in W$, $pp^* = d\,\varphi[y]$, and
$(p + \kappa q)(p + \kappa q)^* = pp^* + \kappa^2 qq^* = d(\varphi[y] + \varphi[\kappa])$. -/
@[kb "shimura2004" "Lemma 3.13, p. 26 (type 2: ν(p + κq) = pp* + κ²qq*)"]
theorem lemma_3_13_type2_norm {κ y : V} (hy : Q.IsOrtho κ y) (q : A) (d : F)
    (hq : q * reverse q = algebraMap F A d) :
    (ι Q y * q) * reverse q = d • ι Q y ∧ q * reverse (ι Q y * q) = d • ι Q y ∧
    (ι Q y * q) * reverse (ι Q y * q) = algebraMap F A (d * Q y) ∧
    (ι Q y * q + ι Q κ * q) * reverse (ι Q y * q + ι Q κ * q) = algebraMap F A (d * (Q y + Q κ)) := by
  have h1 : (ι Q y * q) * reverse q = d • ι Q y := by
    rw [mul_assoc, hq, ← Algebra.commutes, ← Algebra.smul_def]
  have h2 : q * reverse (ι Q y * q) = d • ι Q y := by
    rw [reverse.map_mul, reverse_ι, ← mul_assoc, hq, ← Algebra.smul_def]
  have h3 : (ι Q y * q) * reverse (ι Q y * q) = algebraMap F A (d * Q y) := by
    rw [reverse.map_mul, reverse_ι]
    calc ι Q y * q * (reverse q * ι Q y) = ι Q y * (q * reverse q) * ι Q y := by simp only [mul_assoc]
      _ = algebraMap F A d * (ι Q y * ι Q y) := by rw [hq, ← Algebra.commutes, mul_assoc]
      _ = algebraMap F A (d * Q y) := by rw [ι_sq_scalar, ← map_mul]
  refine ⟨h1, h2, h3, ?_⟩
  rw [mul_reverse_add_ι_mul hy _ q d d h1 h2 hq, h3, ← map_add]
  ring_nf

/-- **Lemma 3.13**, converse, type 1 (Shimura 2004, p. 26): if $p \in G^+(W)$, $x \in W$ and
$1 + \varphi[\kappa]\varphi[x] \ne 0$ (equivalently $pp^* + \kappa^2qq^* \ne 0$ for $q = xp$, by
`lemma_3_13_type1_norm`), then $p + \kappa xp \in G^+(V)$. -/
@[kb "shimura2004" "Lemma 3.13, p. 26 (converse, type 1: p + κxp ∈ G⁺(V))"]
theorem lemma_3_13_type1_mem (hQ : (QuadraticMap.associated Q).Nondegenerate) {κ x : V} (hκ : Q κ ≠ 0)
    (hx : Q.IsOrtho κ x) {p : (CliffordAlgebra Q)ˣ} (hp : p ∈ subspaceCliffordGroup Q κ 0)
    (hne : 1 + Q κ * Q x ≠ 0) :
    ∃ u : (CliffordAlgebra Q)ˣ, (u : A) = (p : A) + ι Q κ * (ι Q x * p) ∧ u ∈ M0 Q := by
  have hpM := ((mem_subspaceCliffordGroup_zero_iff hQ hκ p).1 hp).1
  obtain ⟨g, hg, hgM⟩ := rxy_mem_M0 (Q := Q) 1 κ x (by rw [hx.polar_eq_zero]; simpa using hne)
  refine ⟨g * p, ?_, (M0 Q).mul_mem hgM hpM⟩
  rw [Units.val_mul, hg, rxy, map_one, add_mul, one_mul, mul_assoc]

/-- **Lemma 3.13**, converse, type 2 (Shimura 2004, p. 26): if $q \in G^-(W)$, $y \in W$ and
$\varphi[y] + \varphi[\kappa] \ne 0$ (equivalently $pp^* + \kappa^2qq^* \ne 0$ for $p = yq$, by
`lemma_3_13_type2_norm`), then $yq + \kappa q \in G^+(V)$. -/
@[kb "shimura2004" "Lemma 3.13, p. 26 (converse, type 2: yq + κq ∈ G⁺(V))"]
theorem lemma_3_13_type2_mem (hQ : (QuadraticMap.associated Q).Nondegenerate) {κ y : V} (hκ : Q κ ≠ 0)
    (hy : Q.IsOrtho κ y) {q : (CliffordAlgebra Q)ˣ} (hq : q ∈ subspaceCliffordGroup Q κ 1)
    (hne : Q y + Q κ ≠ 0) :
    ∃ u : (CliffordAlgebra Q)ˣ, (u : A) = ι Q y * q + ι Q κ * q ∧ u ∈ M0 Q := by
  have hqo := ((mem_subspaceCliffordGroup_one_iff hQ hκ q).1 hq).1
  have hyκ : Q (y + κ) ≠ 0 := by
    rw [Q_add, bil_comm, (isOrtho_iff_bil_eq_zero.1 hy)]; simpa using hne
  refine ⟨vecUnit (y + κ) hyκ * q, ?_, ?_⟩
  · change ι Q (y + κ) * (q : A) = _
    rw [map_add, add_mul]
  · refine ⟨?_, (cliffordGroup Q).mul_mem (vecUnit_mem _ hyκ) hqo.1⟩
    change ι Q (y + κ) * (q : A) ∈ evenOdd Q 0
    simpa [show (1 : ZMod 2) + 1 = 0 from rfl] using mul_mem_evenOdd (ι_mem_evenOdd_one Q (y + κ)) hqo.2

end QuadFormsKB.Shimura2004
