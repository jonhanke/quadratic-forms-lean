/-
# Shimura 2004, §2.4: the matrix model $\Psi : A(V) \cong M_2(A(U))$

**Source.** G. Shimura, *Arithmetic and Analytic Theories of Quadratic Forms and Clifford Groups*, Mathematical
Surveys and Monographs 109, American Mathematical Society, 2004 (key `shimura2004`), Chapter I, §2.4–Theorem 2.6
(printed pp. 18–19), formulas (2.6a)–(2.13). Page numbers in the tags are printed pages.

**Setting and dictionary.** As in `QuadFormsKB/Literature/Shimura2004/Wave2/CliffordLemmas.lean`: $F$ a field of
characteristic $\ne 2$, `Q : QuadraticForm F V` with $Q(x) = \varphi[x]$, $A(V)$ = `CliffordAlgebra Q`, the canonical
automorphism $a \mapsto a'$ = `involute`, the canonical involution $a \mapsto a^*$ = `reverse`. A weak Witt
decomposition of the simplest type (2.6a,b) is $V = U + Fe + Ff$ with $e^2 = f^2 = 0$, $ef + fe = 1$ and
$U = (Fe + Ff)^\perp$; here `Q e = 0`, `Q f = 0`, `QuadraticMap.polar Q e f = 1` (so $ef + fe = 1$, `ef_add_fe`), and
$U$ is the submodule `uSpace Q e f` of the $u$ with `polar Q u e = 0` and `polar Q u f = 0`. Shimura's $A(U)$ is the
Clifford algebra of the restriction of $\varphi$ to $U$, `CliffordAlgebra (Q.restrict (uSpace Q e f))`, mapped into
$A(V)$ by `incl` (the map induced by the inclusion $U \subseteq V$). Shimura identifies $A(U)$ with the subalgebra of
$A(V)$ generated by $U$ (§2.3); that `incl` is injective is proved here as a consequence of (2.11)
(`incl_injective`).

Shimura does not assume `polar Q e f = 1` to come from a nondegenerate $\varphi$ for the construction; neither do we:
the hypotheses below are only $e^2 = f^2 = 0$ and $ef + fe = 1$.

**Defines**
* (2.8) $\Psi(u + re + sf) = \begin{pmatrix} u & r \\ s & -u\end{pmatrix}$ on $V$ (`psiVec`) and its extension
  $\Psi : A(V) \to M_2(A(U))$ (`psi`), an $F$-algebra homomorphism;
* §2.4: for $\xi = \begin{pmatrix} a & b \\ c & d\end{pmatrix} \in M_2(A(U))$, $\xi^* =
  \begin{pmatrix} a^* & c^* \\ b^* & d^*\end{pmatrix}$ (`matStar`), and $J = \begin{pmatrix} 0 & -1 \\ 1 & 0
  \end{pmatrix}$ (`matJ`).

**Proves** (all unconditional; standard axioms only)
* (2.7) $\Psi$ is an isomorphism of $A(V)$ onto $M_2(A(U))$ (`psiEquiv`, `psi_bijective`), with the explicit
  inverse `psiInv` $\begin{pmatrix} a & b \\ c & d\end{pmatrix} \mapsto a\,ef + b\,e + c'f + d'fe$;
* (2.9) $\Psi(e)$, $\Psi(f)$, $\Psi(ef)$, $\Psi(fe)$ are the four matrix units (`psi_e`, `psi_f`, `psi_ef`,
  `psi_fe`);
* (2.10) $\Psi(\alpha^*) = J\Psi(\alpha')^*J^{-1}$ (`psi_reverse`, with $J^{-1} = -J$, `matJ_mul_neg_matJ`);
* (2.11) $\Psi(b) = \mathrm{diag}[b, b']$ for $b \in A(U)$ (`psi_incl`);
* (2.12) in the form used for (2.13): $\Psi(\xi') = \begin{pmatrix} a' & -b' \\ -c' & d'\end{pmatrix}$ when
  $\Psi(\xi) = \begin{pmatrix} a & b \\ c & d\end{pmatrix}$ (`psi_involute`), and literally
  $\Lambda\Psi(\xi)\Lambda^{-1} = \Psi(\xi')$ with $\Lambda = \mathrm{diag}[\ell, -\ell]$, $\ell = e - f$, as an
  identity of matrices over $A(V)$ (`lambda_conj_psi`);
* (2.13) $\Psi(A^\pm(V)) = \{\begin{pmatrix} a & b \\ c & d\end{pmatrix} : a, d \in A^\pm(U),\ b, c \in A^\mp(U)\}$
  (`psi_mem_evenOdd_zero_iff`, `psi_mem_evenOdd_one_iff`);
* Theorem 2.6 for $s = 1$: $A(V) \cong M_2(A(U))$ (`theorem_2_6_one`).

*Update (clarification) for (2.12).* Shimura's $\Lambda = \mathrm{diag}[\ell, -\ell]$ has $\ell = e - f \in V$, which is
not in $A(U)$; so (2.12) is an identity in $M_2(A(V))$ after embedding $A(U) \subseteq A(V)$, not in $M_2(A(U))$.
The content used later (in (2.13)) is the entrywise formula `psi_involute`.
-/
import QuadFormsKB.Literature.Shimura2004.Wave2.CliffordLemmas
import QuadFormsKB.Literature.Cassels.Ch10.Grading
import Mathlib.LinearAlgebra.Matrix.Notation
import Mathlib.Data.Matrix.Basic
import Mathlib.Tactic.NoncommRing
import QuadFormsKB.Citation

open Module CliffordAlgebra

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.Shimura2004

open QuadFormsKB.Cassels QuadFormsKB.OMeara

namespace MatrixModel

variable {F V : Type*} [Field F] [Invertible (2 : F)] [AddCommGroup V] [Module F V] [FiniteDimensional F V]
  (Q : QuadraticForm F V) (e f : V)

/-! ### The space $U = (Fe + Ff)^\perp$ and its Clifford algebra -/

/-- **Shimura's $U = (Fe+Ff)^\perp$** (2.6b), p. 18: the vectors $u$ with $\varphi(u, e) = \varphi(u, f) = 0$
(stated with $2\varphi$ = `QuadraticMap.polar Q`). -/
@[kb "shimura2004" "(2.6b), p. 18 (U = (Fe + Ff)^⊥ in a weak Witt decomposition V = U + Fe + Ff)"]
def uSpace : Submodule F V :=
  LinearMap.ker ((QuadraticMap.polarBilin Q).flip e) ⊓ LinearMap.ker ((QuadraticMap.polarBilin Q).flip f)

variable {Q e f} in
theorem mem_uSpace {u : V} : u ∈ uSpace Q e f ↔ QuadraticMap.polar Q u e = 0 ∧ QuadraticMap.polar Q u f = 0 := by
  simp [uSpace, QuadraticMap.polarBilin]

/-- The quadratic form $\varphi$ restricted to $U$. -/
abbrev QU : QuadraticForm F (uSpace Q e f) := Q.restrict (uSpace Q e f)

/-- **Shimura's $A(U)$**: the Clifford algebra of $\varphi$ restricted to $U$. -/
abbrev AU := CliffordAlgebra (QU Q e f)

/-- The inclusion $U \subseteq V$ as an isometry. -/
def inclIso : (QU Q e f) →qᵢ Q where
  toLinearMap := (uSpace Q e f).subtype
  map_app' _ := rfl

/-- The map $A(U) \to A(V)$ induced by $U \subseteq V$ (injective by `incl_injective`). -/
def incl : AU Q e f →ₐ[F] CliffordAlgebra Q := CliffordAlgebra.map (inclIso Q e f)

@[simp] theorem incl_ι (u : uSpace Q e f) : incl Q e f (ι (QU Q e f) u) = ι Q (u : V) := by
  rw [incl, CliffordAlgebra.map_apply_ι]; rfl

variable {Q e f}

section Hyp

variable (he : Q e = 0) (hf : Q f = 0) (hef : QuadraticMap.polar Q e f = 1)
include he hf hef

theorem polar_e_e : QuadraticMap.polar Q e e = 0 := by
  rw [QuadraticMap.polar_self, he, smul_zero]

theorem polar_f_f : QuadraticMap.polar Q f f = 0 := by
  rw [QuadraticMap.polar_self, hf, smul_zero]

theorem polar_f_e : QuadraticMap.polar Q f e = 1 := by
  rw [QuadraticMap.polar_comm, hef]

/-- The $U$-component $x - \varphi(x, f)'e - \varphi(x,e)'f$ of $x = u + re + sf$ (with $r = 2\varphi(x, f)$,
$s = 2\varphi(x, e)$) lies in $U$. -/
theorem proj_mem (x : V) :
    x - QuadraticMap.polar Q x f • e - QuadraticMap.polar Q x e • f ∈ uSpace Q e f := by
  rw [mem_uSpace]
  have h1 := polar_e_e he hf hef
  have h2 := polar_f_f he hf hef
  have h3 := polar_f_e he hf hef
  constructor
  · simp only [QuadraticMap.polar_sub_left, QuadraticMap.polar_smul_left, smul_eq_mul, h1, h3]; ring
  · simp only [QuadraticMap.polar_sub_left, QuadraticMap.polar_smul_left, smul_eq_mul, h2, hef]; ring

omit he hf hef in
variable (Q e f) in
/-- The linear map $x \mapsto x - \varphi(x, f)'e - \varphi(x,e)'f$ of $V$ (with $2\varphi$ written $\varphi'$). -/
def projV : V →ₗ[F] V :=
  LinearMap.id - ((QuadraticMap.polarBilin Q).flip f).smulRight e -
    ((QuadraticMap.polarBilin Q).flip e).smulRight f

omit he hf hef in
@[simp] theorem projV_apply (x : V) :
    projV Q e f x = x - QuadraticMap.polar Q x f • e - QuadraticMap.polar Q x e • f := by
  simp [projV, QuadraticMap.polarBilin]

/-- The projection $V \to U$, $u + re + sf \mapsto u$. -/
def proj : V →ₗ[F] uSpace Q e f :=
  (projV Q e f).codRestrict (uSpace Q e f) (fun x => by rw [projV_apply]; exact proj_mem he hf hef x)

theorem coe_proj (x : V) :
    (proj he hf hef x : V) = x - QuadraticMap.polar Q x f • e - QuadraticMap.polar Q x e • f := by
  simp [proj]

/-- Every $x \in V$ is $u + re + sf$ with $u$ = `proj x`, $r = 2\varphi(x, f)$, $s = 2\varphi(x, e)$. -/
theorem decomp (x : V) :
    x = (proj he hf hef x : V) + QuadraticMap.polar Q x f • e + QuadraticMap.polar Q x e • f := by
  rw [coe_proj]; abel

theorem proj_of_mem {u : V} (hu : u ∈ uSpace Q e f) : (proj he hf hef u : V) = u := by
  rw [mem_uSpace] at hu
  rw [coe_proj, hu.1, hu.2, zero_smul, zero_smul, sub_zero, sub_zero]

theorem proj_e : (proj he hf hef e : V) = 0 := by
  rw [coe_proj, hef, polar_e_e he hf hef]; simp

theorem proj_f : (proj he hf hef f : V) = 0 := by
  rw [coe_proj, polar_f_f he hf hef, polar_f_e he hf hef]; simp

/-- $\varphi[u + re + sf] = \varphi[u] + rs$ (the computation after (2.8)). -/
theorem Q_eq_proj_add (x : V) :
    Q x = Q (proj he hf hef x : V) + QuadraticMap.polar Q x f * QuadraticMap.polar Q x e := by
  set r := QuadraticMap.polar Q x f
  set s := QuadraticMap.polar Q x e
  set u : V := (proj he hf hef x : V)
  have hu : u ∈ uSpace Q e f := (proj he hf hef x).2
  rw [mem_uSpace] at hu
  have hx : x = u + (r • e + s • f) := by rw [decomp he hf hef x]; abel
  have hpol : QuadraticMap.polar Q u (r • e + s • f) = 0 := by
    rw [QuadraticMap.polar_add_right, QuadraticMap.polar_smul_right, QuadraticMap.polar_smul_right, hu.1, hu.2]
    simp
  have hQ2 : Q (r • e + s • f) = r * s := by
    rw [QuadraticMap.map_add (⇑Q), QuadraticMap.map_smul, QuadraticMap.map_smul, he, hf,
      QuadraticMap.polar_smul_left, QuadraticMap.polar_smul_right, hef]
    simp
  conv_lhs => rw [hx]
  rw [QuadraticMap.map_add (⇑Q), hpol, hQ2, add_zero]

/-! ### (2.8): $\Psi$ on vectors -/

/-- **Shimura's $\Psi$ on $V$** (2.8), p. 18: $\Psi(u + re + sf) = \begin{pmatrix} u & r \\ s & -u
\end{pmatrix}$. -/
def psiVec : V →ₗ[F] Matrix (Fin 2) (Fin 2) (AU Q e f) where
  toFun x := !![ι (QU Q e f) (proj he hf hef x), algebraMap F _ (QuadraticMap.polar Q x f);
    algebraMap F _ (QuadraticMap.polar Q x e), -ι (QU Q e f) (proj he hf hef x)]
  map_add' x y := by
    ext i j; fin_cases i <;> fin_cases j <;>
      simp [QuadraticMap.polar_add_left, map_add] <;> abel
  map_smul' c x := by
    ext i j; fin_cases i <;> fin_cases j <;>
      simp [QuadraticMap.polar_smul_left, Algebra.smul_def]

theorem psiVec_apply (x : V) : psiVec he hf hef x =
    !![ι (QU Q e f) (proj he hf hef x), algebraMap F _ (QuadraticMap.polar Q x f);
      algebraMap F _ (QuadraticMap.polar Q x e), -ι (QU Q e f) (proj he hf hef x)] := rfl

theorem psiVec_sq (x : V) :
    psiVec he hf hef x * psiVec he hf hef x = algebraMap F _ (Q x) := by
  rw [psiVec_apply, Matrix.mul_fin_two, Q_eq_proj_add he hf hef x]
  have h1 : ι (QU Q e f) (proj he hf hef x) * ι (QU Q e f) (proj he hf hef x) =
      algebraMap F _ (Q (proj he hf hef x : V)) := by
    rw [ι_sq_scalar]; rfl
  set r := QuadraticMap.polar Q x f
  set s := QuadraticMap.polar Q x e
  set w := ι (QU Q e f) (proj he hf hef x)
  have hc : algebraMap F (AU Q e f) r * w = w * algebraMap F (AU Q e f) r := Algebra.commutes r w
  have hc' : algebraMap F (AU Q e f) s * w = w * algebraMap F (AU Q e f) s := Algebra.commutes s w
  rw [Matrix.algebraMap_eq_diagonal]
  ext i j; fin_cases i <;> fin_cases j
  · simp only [Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.empty_val',
      Matrix.cons_val_fin_one, Fin.zero_eta, Fin.isValue, Matrix.diagonal_apply_eq, h1]
    rw [Pi.algebraMap_apply, map_add, map_mul]
  · simp [hc]
  · simp [hc']
  · simp only [Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_one, Matrix.empty_val',
      Matrix.cons_val_fin_one, Fin.mk_one, Fin.isValue, Matrix.diagonal_apply_eq,
      Matrix.head_cons, neg_mul_neg, h1]
    rw [Pi.algebraMap_apply, map_add, map_mul, add_comm]
    congr 1
    exact Algebra.commutes s _

/-- **Shimura's $\Psi : A(V) \to M_2(A(U))$** (2.7), p. 18: the extension of (2.8) to an $F$-algebra
homomorphism (possible since $\Psi(x)^2 = \varphi[x]1_2$). It is an isomorphism (`psiEquiv`). -/
@[kb "shimura2004" "(2.7), (2.8), p. 18 (Ψ : A(V) → M₂(A(U)), Ψ(u + re + sf) = [[u, r], [s, −u]])"]
def psi : CliffordAlgebra Q →ₐ[F] Matrix (Fin 2) (Fin 2) (AU Q e f) :=
  CliffordAlgebra.lift Q ⟨psiVec he hf hef, psiVec_sq he hf hef⟩

theorem psi_ι (x : V) : psi he hf hef (ι Q x) = psiVec he hf hef x := by
  simp [psi]

/-- (2.8) for $u \in U$: $\Psi(u) = \mathrm{diag}[u, -u]$. -/
theorem psi_ι_of_mem (u : uSpace Q e f) :
    psi he hf hef (ι Q (u : V)) = !![ι (QU Q e f) u, 0; 0, -ι (QU Q e f) u] := by
  have hu := mem_uSpace.1 u.2
  have hp : proj he hf hef (u : V) = u := Subtype.ext (proj_of_mem he hf hef u.2)
  rw [psi_ι, psiVec_apply, hp, hu.1, hu.2, map_zero]

/-! ### (2.9): the matrix units -/

/-- (2.9), p. 18: $\Psi(e) = \begin{pmatrix} 0 & 1 \\ 0 & 0\end{pmatrix}$. -/
@[kb "shimura2004" "(2.9), p. 18 (Ψ(e), Ψ(f), Ψ(ef), Ψ(fe) are the matrix units)"]
theorem psi_e : psi he hf hef (ι Q e) = !![0, 1; 0, 0] := by
  have hp : proj he hf hef e = 0 := Subtype.ext (proj_e he hf hef)
  rw [psi_ι, psiVec_apply, hp, hef, polar_e_e he hf hef]
  simp

/-- (2.9), p. 18: $\Psi(f) = \begin{pmatrix} 0 & 0 \\ 1 & 0\end{pmatrix}$. -/
@[kb "shimura2004" "(2.9), p. 18 (Ψ(e), Ψ(f), Ψ(ef), Ψ(fe) are the matrix units)"]
theorem psi_f : psi he hf hef (ι Q f) = !![0, 0; 1, 0] := by
  have hp : proj he hf hef f = 0 := Subtype.ext (proj_f he hf hef)
  rw [psi_ι, psiVec_apply, hp, polar_f_f he hf hef, polar_f_e he hf hef]
  simp

/-- (2.9), p. 18: $\Psi(ef) = \begin{pmatrix} 1 & 0 \\ 0 & 0\end{pmatrix}$. -/
@[kb "shimura2004" "(2.9), p. 18 (Ψ(e), Ψ(f), Ψ(ef), Ψ(fe) are the matrix units)"]
theorem psi_ef : psi he hf hef (ι Q e * ι Q f) = !![1, 0; 0, 0] := by
  rw [map_mul, psi_e, psi_f, Matrix.mul_fin_two]; simp

/-- (2.9), p. 18: $\Psi(fe) = \begin{pmatrix} 0 & 0 \\ 0 & 1\end{pmatrix}$. -/
@[kb "shimura2004" "(2.9), p. 18 (Ψ(e), Ψ(f), Ψ(ef), Ψ(fe) are the matrix units)"]
theorem psi_fe : psi he hf hef (ι Q f * ι Q e) = !![0, 0; 0, 1] := by
  rw [map_mul, psi_e, psi_f, Matrix.mul_fin_two]; simp

/-! ### (2.11): $\Psi(b) = \mathrm{diag}[b, b']$ for $b \in A(U)$ -/

/-- **(2.11)**, p. 18: $\Psi(b) = \mathrm{diag}[b, b']$ for every $b \in A(U)$. -/
@[kb "shimura2004" "(2.11), p. 18 (Ψ(b) = diag[b, b'] for b ∈ A(U))"]
theorem psi_incl (b : AU Q e f) : psi he hf hef (incl Q e f b) = !![b, 0; 0, involute b] := by
  induction b using CliffordAlgebra.induction with
  | algebraMap r =>
    rw [AlgHom.commutes, AlgHom.commutes, Matrix.algebraMap_eq_diagonal]
    ext i j; fin_cases i <;> fin_cases j <;> simp [Pi.algebraMap_apply]
  | ι u => rw [incl_ι, psi_ι_of_mem, involute_ι]
  | mul a b ha hb => rw [map_mul, map_mul, ha, hb, Matrix.mul_fin_two, map_mul]; simp
  | add a b ha hb => rw [map_add, map_add, ha, hb, map_add]; ext i j; fin_cases i <;> fin_cases j <;> simp

/-- $A(U) \to A(V)$ is injective, so $A(U)$ is the subalgebra of $A(V)$ generated by $U$ (Shimura §2.3, p. 18). -/
theorem incl_injective : Function.Injective (incl Q e f) := by
  intro a b h
  have := congrArg (fun x => psi he hf hef x 0 0) h
  simpa [psi_incl] using this

/-! ### The inverse of $\Psi$ -/

omit he hf hef in
/-- $w b = b' w$ for $b \in A(U)$ and $w \perp U$ (for $w = e, f$, (2.6b)). -/
theorem ι_mul_incl {w : V} (hw : ∀ u ∈ uSpace Q e f, QuadraticMap.polar Q u w = 0) (b : AU Q e f) :
    ι Q w * incl Q e f b = incl Q e f (involute b) * ι Q w := by
  induction b using CliffordAlgebra.induction with
  | algebraMap r => simp [Algebra.commutes]
  | ι u =>
    rw [incl_ι, involute_ι, map_neg, incl_ι, neg_mul, eq_neg_iff_add_eq_zero, ι_mul_ι_add_swap,
      QuadraticMap.polar_comm, hw u u.2, map_zero]
  | mul a b ha hb => rw [map_mul, ← mul_assoc, ha, mul_assoc, hb, ← mul_assoc, map_mul, map_mul]
  | add a b ha hb => rw [map_add, mul_add, ha, hb, map_add, map_add, add_mul]

omit he hf hef in
theorem ι_e_mul_incl (b : AU Q e f) :
    ι Q e * incl Q e f b = incl Q e f (involute b) * ι Q e :=
  ι_mul_incl (fun u hu => (mem_uSpace.1 hu).1) b

omit he hf hef in
theorem ι_f_mul_incl (b : AU Q e f) :
    ι Q f * incl Q e f b = incl Q e f (involute b) * ι Q f :=
  ι_mul_incl (fun u hu => (mem_uSpace.1 hu).2) b

omit he hf hef in
variable (Q e f) in
/-- The inverse of $\Psi$: $\begin{pmatrix} a & b \\ c & d\end{pmatrix} \mapsto a\,ef + b\,e + c'f + d'fe$. -/
def psiInv : Matrix (Fin 2) (Fin 2) (AU Q e f) →ₗ[F] CliffordAlgebra Q where
  toFun M := incl Q e f (M 0 0) * (ι Q e * ι Q f) + incl Q e f (M 0 1) * ι Q e +
    incl Q e f (involute (M 1 0)) * ι Q f + incl Q e f (involute (M 1 1)) * (ι Q f * ι Q e)
  map_add' M N := by simp only [Matrix.add_apply, map_add, add_mul]; abel
  map_smul' c M := by simp only [Matrix.smul_apply, map_smul, smul_mul_assoc, smul_add, RingHom.id_apply]

omit he hf hef in
theorem psiInv_apply (M : Matrix (Fin 2) (Fin 2) (AU Q e f)) : psiInv Q e f M =
    incl Q e f (M 0 0) * (ι Q e * ι Q f) + incl Q e f (M 0 1) * ι Q e +
      incl Q e f (involute (M 1 0)) * ι Q f + incl Q e f (involute (M 1 1)) * (ι Q f * ι Q e) := rfl

theorem psi_psiInv (M : Matrix (Fin 2) (Fin 2) (AU Q e f)) : psi he hf hef (psiInv Q e f M) = M := by
  rw [psiInv_apply]
  simp only [map_add, map_mul, psi_incl, psi_e, psi_f]
  ext i j; fin_cases i <;> fin_cases j <;> simp [Matrix.mul_fin_two]

theorem psiInv_psiVec_mul (v : V) (M : Matrix (Fin 2) (Fin 2) (AU Q e f)) :
    psiInv Q e f (psiVec he hf hef v * M) = ι Q v * psiInv Q e f M := by
  have hee : ι Q e * ι Q e = 0 := ι_sq_zero he
  have hff : ι Q f * ι Q f = 0 := ι_sq_zero hf
  have h_efe := efe he hef
  have h_fef := fef hf hef
  have hee' : ∀ y, ι Q e * (ι Q e * y) = 0 := fun y => by rw [← mul_assoc, hee, zero_mul]
  have hff' : ∀ y, ι Q f * (ι Q f * y) = 0 := fun y => by rw [← mul_assoc, hff, zero_mul]
  have h_efe' : ι Q e * (ι Q f * ι Q e) = ι Q e := by rw [← mul_assoc, h_efe]
  have h_fef' : ι Q f * (ι Q e * ι Q f) = ι Q f := by rw [← mul_assoc, h_fef]
  -- the three cases $v = u \in U$, $v = e$, $v = f$
  have caseU : ∀ u : uSpace Q e f,
      psiInv Q e f (psiVec he hf hef u * M) = ι Q (u : V) * psiInv Q e f M := by
    intro u
    rw [← psi_ι, psi_ι_of_mem, M.eta_fin_two, Matrix.mul_fin_two, psiInv_apply, psiInv_apply]
    simp only [Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.head_cons, Matrix.head_fin_const, zero_mul, add_zero,
      zero_add, mul_zero, neg_mul, map_neg, map_mul, involute_ι, involute_involute, incl_ι, neg_neg, mul_add,
      ← mul_assoc]
  have caseE : psiInv Q e f (psiVec he hf hef e * M) = ι Q e * psiInv Q e f M := by
    rw [← psi_ι, psi_e, M.eta_fin_two, Matrix.mul_fin_two, psiInv_apply, psiInv_apply]
    simp only [Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.head_cons, Matrix.head_fin_const, zero_mul, one_mul,
      add_zero, zero_add, map_zero, mul_add]
    simp only [mul_add, ← mul_assoc, ι_e_mul_incl, involute_involute]
    simp only [mul_assoc, hee', h_efe', hee, mul_zero, zero_mul, zero_add, add_zero]
  have caseF : psiInv Q e f (psiVec he hf hef f * M) = ι Q f * psiInv Q e f M := by
    rw [← psi_ι, psi_f, M.eta_fin_two, Matrix.mul_fin_two, psiInv_apply, psiInv_apply]
    simp only [Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.head_cons, Matrix.head_fin_const, zero_mul, one_mul,
      add_zero, zero_add, map_zero, mul_add]
    simp only [mul_add, ← mul_assoc, ι_f_mul_incl, involute_involute]
    simp only [mul_assoc, hff', h_fef', hff, mul_zero, zero_mul, zero_add, add_zero]
  conv_lhs => rw [decomp he hf hef v]
  conv_rhs => rw [decomp he hf hef v]
  simp only [map_add, map_smul, add_mul, smul_mul_assoc, caseU, caseE, caseF]

theorem psiInv_psi (x : CliffordAlgebra Q) : psiInv Q e f (psi he hf hef x) = x := by
  induction x using CliffordAlgebra.left_induction with
  | algebraMap r =>
    rw [AlgHom.commutes, Matrix.algebraMap_eq_diagonal, psiInv_apply]
    simp only [Matrix.diagonal_apply_eq, Matrix.diagonal_apply_ne _ (by decide : (0 : Fin 2) ≠ 1),
      Matrix.diagonal_apply_ne _ (by decide : (1 : Fin 2) ≠ 0), Pi.algebraMap_apply, AlgHom.commutes,
      involute.commutes, map_zero, zero_mul, add_zero, ← mul_add, ef_add_fe hef, mul_one]
  | add x y hx hy => rw [map_add, map_add, hx, hy]
  | ι_mul x v hx => rw [map_mul, psi_ι, psiInv_psiVec_mul, hx]

/-- **(2.7)**, p. 18: $\Psi$ is a bijection of $A(V)$ onto $M_2(A(U))$. -/
@[kb "shimura2004" "(2.7), p. 18 (Ψ is an isomorphism of A(V) onto M₂(A(U)))"]
theorem psi_bijective : Function.Bijective (psi he hf hef) :=
  ⟨Function.LeftInverse.injective (psiInv_psi he hf hef),
    Function.RightInverse.surjective (psi_psiInv he hf hef)⟩

/-- **(2.7)**, p. 18: the $F$-algebra isomorphism $\Psi : A(V) \cong M_2(A(U))$. -/
@[kb "shimura2004" "(2.7), p. 18 (Ψ is an isomorphism of A(V) onto M₂(A(U)))"]
def psiEquiv : CliffordAlgebra Q ≃ₐ[F] Matrix (Fin 2) (Fin 2) (AU Q e f) :=
  AlgEquiv.ofBijective (psi he hf hef) (psi_bijective he hf hef)

theorem psiEquiv_apply (x : CliffordAlgebra Q) : psiEquiv he hf hef x = psi he hf hef x := rfl

/-- **Theorem 2.6** (Shimura 2004, p. 19), case $s = 1$: for a weak Witt decomposition $V = U + Fe + Ff$,
$A(V) \cong M_2(A(U))$ as $F$-algebras. -/
@[kb "shimura2004" "Theorem 2.6, p. 19 (case s = 1: A(V) ≅ M₂(A(U)))"]
theorem theorem_2_6_one : Nonempty (CliffordAlgebra Q ≃ₐ[F] Matrix (Fin 2) (Fin 2) (AU Q e f)) :=
  ⟨psiEquiv he hf hef⟩

end Hyp

/-! ### (2.10): $\Psi(\alpha^*) = J\Psi(\alpha')^*J^{-1}$ -/

/-- **$\xi^*$ for $\xi \in M_2(A(U))$** (§2.4, p. 18; also §3.9, p. 24): the transpose with $^*$ applied to every
entry, $\begin{pmatrix} a & b \\ c & d\end{pmatrix}^* = \begin{pmatrix} a^* & c^* \\ b^* & d^*\end{pmatrix}$. -/
@[kb "shimura2004" "§2.4, p. 18 (ξ* = [[a*, c*], [b*, d*]] for ξ = [[a, b], [c, d]])"]
def matStar {W : Type*} [AddCommGroup W] [Module F W] {Q' : QuadraticForm F W}
    (M : Matrix (Fin 2) (Fin 2) (CliffordAlgebra Q')) : Matrix (Fin 2) (Fin 2) (CliffordAlgebra Q') :=
  M.transpose.map reverse

/-- **Shimura's $J$** (2.10), p. 18: $J = \begin{pmatrix} 0 & -1 \\ 1 & 0\end{pmatrix}$. -/
def matJ {R : Type*} [Ring R] : Matrix (Fin 2) (Fin 2) R := !![0, -1; 1, 0]

/-- $J \cdot (-J) = 1$, so $J^{-1} = -J$. -/
theorem matJ_mul_neg_matJ {R : Type*} [Ring R] : (matJ : Matrix (Fin 2) (Fin 2) R) * -matJ = 1 := by
  rw [matJ, Matrix.one_fin_two]
  ext i j; fin_cases i <;> fin_cases j <;> simp [Matrix.mul_fin_two]

theorem neg_matJ_mul_matJ {R : Type*} [Ring R] : -(matJ : Matrix (Fin 2) (Fin 2) R) * matJ = 1 := by
  rw [matJ, Matrix.one_fin_two]
  ext i j; fin_cases i <;> fin_cases j <;> simp [Matrix.mul_fin_two]

theorem matStar_mul {W : Type*} [AddCommGroup W] [Module F W] {Q' : QuadraticForm F W}
    (M N : Matrix (Fin 2) (Fin 2) (CliffordAlgebra Q')) :
    matStar (M * N) = matStar N * matStar M := by
  ext i j
  simp [matStar, Matrix.mul_apply, map_sum, reverse.map_mul]

theorem matStar_matStar {W : Type*} [AddCommGroup W] [Module F W] {Q' : QuadraticForm F W}
    (M : Matrix (Fin 2) (Fin 2) (CliffordAlgebra Q')) : matStar (matStar M) = M := by
  ext i j; simp [matStar]

/-- $J\xi^*J^{-1}$ is the matrix with rows $(d^*, -b^*)$ and $(-c^*, a^*)$ when $\xi$ has rows $(a, b)$ and
$(c, d)$. -/
theorem matJ_matStar_neg_matJ {W : Type*} [AddCommGroup W] [Module F W] {Q' : QuadraticForm F W}
    (X : Matrix (Fin 2) (Fin 2) (CliffordAlgebra Q')) :
    matJ * matStar X * -matJ = !![reverse (X 1 1), -reverse (X 0 1); -reverse (X 1 0), reverse (X 0 0)] := by
  ext i j
  simp only [Matrix.mul_apply, Fin.sum_univ_two, Matrix.neg_apply, matJ, matStar, Matrix.map_apply,
    Matrix.transpose_apply]
  fin_cases i <;> fin_cases j <;> simp

section Hyp2

variable (he : Q e = 0) (hf : Q f = 0) (hef : QuadraticMap.polar Q e f = 1)
include he hf hef

/-- **(2.10)**, p. 18: $\Psi(\alpha^*) = J\,\Psi(\alpha')^*J^{-1}$ for every $\alpha \in A(V)$, with
$J^{-1} = -J$. -/
@[kb "shimura2004" "(2.10), p. 18 (Ψ(α*) = JΨ(α')*J⁻¹)"]
theorem psi_reverse (α : CliffordAlgebra Q) :
    psi he hf hef (reverse α) = matJ * matStar (psi he hf hef (involute α)) * -matJ := by
  induction α using CliffordAlgebra.induction with
  | algebraMap r =>
    rw [reverse.commutes, involute.commutes, AlgHom.commutes, matJ_matStar_neg_matJ,
      Matrix.algebraMap_eq_diagonal]
    ext i j; fin_cases i <;> fin_cases j <;>
      simp [Pi.algebraMap_apply, reverse.commutes]
  | ι v =>
    rw [reverse_ι, involute_ι, map_neg, psi_ι, matJ_matStar_neg_matJ, psiVec_apply]
    ext i j; fin_cases i <;> fin_cases j <;>
      simp [reverse.commutes, reverse_ι]
  | mul a b ha hb =>
    rw [reverse.map_mul, map_mul, ha, hb, map_mul, map_mul, matStar_mul]
    have h : (-matJ : Matrix (Fin 2) (Fin 2) (AU Q e f)) * matJ = 1 := neg_matJ_mul_matJ
    simp only [mul_assoc]
    rw [← mul_assoc (-matJ) matJ, h, one_mul]
  | add a b ha hb =>
    rw [map_add, map_add, ha, hb, map_add, map_add]
    simp only [matStar, Matrix.transpose_add]
    rw [Matrix.map_add _ (map_add reverse), Matrix.mul_add, Matrix.add_mul]

/-! ### (2.12), (2.13) -/

/-- **(2.12)**, p. 18, entrywise form: if $\Psi(\xi) = \begin{pmatrix} a & b \\ c & d\end{pmatrix}$ then
$\Psi(\xi') = \begin{pmatrix} a' & -b' \\ -c' & d'\end{pmatrix}$ (as in the proof of (2.13), p. 19). -/
@[kb "shimura2004" "(2.12), pp. 18–19 (Ψ(ξ') = [[a', −b'], [−c', d']] for Ψ(ξ) = [[a, b], [c, d]])"]
theorem psi_involute (ξ : CliffordAlgebra Q) :
    psi he hf hef (involute ξ) =
      !![involute (psi he hf hef ξ 0 0), -involute (psi he hf hef ξ 0 1);
        -involute (psi he hf hef ξ 1 0), involute (psi he hf hef ξ 1 1)] := by
  induction ξ using CliffordAlgebra.induction with
  | algebraMap r =>
    rw [involute.commutes, AlgHom.commutes, Matrix.algebraMap_eq_diagonal]
    ext i j; fin_cases i <;> fin_cases j <;> simp [Pi.algebraMap_apply, involute.commutes]
  | ι v =>
    rw [involute_ι, map_neg, psi_ι, psiVec_apply]
    ext i j; fin_cases i <;> fin_cases j <;> simp [involute.commutes, involute_ι]
  | mul a b ha hb =>
    rw [map_mul, map_mul, ha, hb, map_mul]
    rw [(psi he hf hef a).eta_fin_two, (psi he hf hef b).eta_fin_two]
    ext i j; fin_cases i <;> fin_cases j <;> simp [Matrix.mul_fin_two, map_add, map_mul] <;> abel
  | add a b ha hb =>
    rw [map_add, map_add, ha, hb, map_add]
    ext i j; fin_cases i <;> fin_cases j <;> simp [map_add] <;> abel

/-- **(2.12)**, p. 18, literal form: with $\ell = e - f$ and $\Lambda = \mathrm{diag}[\ell, -\ell]$,
$\Lambda\Psi(\xi)\Lambda^{-1} = \Psi(\xi')$, as an identity of matrices over $A(V)$ (the entries of $\Psi(\xi)$
mapped into $A(V)$ by `incl`; $\Lambda^{-1} = -\Lambda$ since $\ell^2 = -1$). -/
@[kb "shimura2004" "(2.12), p. 18 (ΛΨ(ξ)Λ⁻¹ = Ψ(ξ'), Λ = diag[ℓ, −ℓ], ℓ = e − f)"]
theorem lambda_conj_psi (ξ : CliffordAlgebra Q) :
    (!![ι Q (e - f), 0; 0, -ι Q (e - f)] : Matrix (Fin 2) (Fin 2) (CliffordAlgebra Q)) *
        (psi he hf hef ξ).map (incl Q e f) * -!![ι Q (e - f), 0; 0, -ι Q (e - f)] =
      (psi he hf hef (involute ξ)).map (incl Q e f) := by
  -- $\ell b \ell^{-1} = b'$ for $b \in A(U)$, with $\ell^{-1} = -\ell$
  have hl : ∀ b : AU Q e f, ι Q (e - f) * incl Q e f b * -ι Q (e - f) = incl Q e f (involute b) := by
    intro b
    have hw : ∀ u ∈ uSpace Q e f, QuadraticMap.polar Q u (e - f) = 0 := by
      intro u hu
      rw [QuadraticMap.polar_sub_right, (mem_uSpace.1 hu).1, (mem_uSpace.1 hu).2, sub_zero]
    have hsq : ι Q (e - f) * ι Q (e - f) = -1 := by
      have hQ : Q (e - f) = -1 := by
        rw [sub_eq_add_neg, QuadraticMap.map_add (⇑Q), QuadraticMap.map_neg, he, hf,
          QuadraticMap.polar_neg_right, hef]
        ring
      rw [ι_sq_scalar, hQ, map_neg, map_one]
    rw [ι_mul_incl hw, mul_assoc, mul_neg, hsq, neg_neg, mul_one]
  rw [psi_involute he hf hef ξ]
  ext i j
  simp only [Matrix.mul_apply, Fin.sum_univ_two, Matrix.neg_apply, Matrix.map_apply]
  fin_cases i <;> fin_cases j <;> simp [← hl, mul_assoc] <;> noncomm_ring

/-- **(2.13)**, p. 19, even part: $\xi \in A^+(V)$ if and only if $\Psi(\xi) = \begin{pmatrix} a & b \\ c & d
\end{pmatrix}$ with $a, d \in A^+(U)$ and $b, c \in A^-(U)$. -/
@[kb "shimura2004" "(2.13), p. 19 (Ψ(A^±(V)) = {[[a, b], [c, d]] | a, d ∈ A^±(U); b, c ∈ A^∓(U)})"]
theorem psi_mem_evenOdd_zero_iff (ξ : CliffordAlgebra Q) :
    ξ ∈ evenOdd Q 0 ↔ psi he hf hef ξ 0 0 ∈ evenOdd (QU Q e f) 0 ∧ psi he hf hef ξ 0 1 ∈ evenOdd (QU Q e f) 1 ∧
      psi he hf hef ξ 1 0 ∈ evenOdd (QU Q e f) 1 ∧ psi he hf hef ξ 1 1 ∈ evenOdd (QU Q e f) 0 := by
  simp only [mem_evenOdd_zero_iff_involute_eq, mem_evenOdd_one_iff_involute_eq_neg]
  rw [← (psi_bijective he hf hef).1.eq_iff, psi_involute he hf hef ξ]
  conv_lhs => rhs; rw [(psi he hf hef ξ).eta_fin_two]
  simp only [← Matrix.ext_iff, Fin.forall_fin_two]
  simp only [Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.head_cons, Matrix.head_fin_const, neg_eq_iff_eq_neg,
    and_assoc]

/-- **(2.13)**, p. 19, odd part: $\xi \in A^-(V)$ if and only if $\Psi(\xi) = \begin{pmatrix} a & b \\ c & d
\end{pmatrix}$ with $a, d \in A^-(U)$ and $b, c \in A^+(U)$. -/
@[kb "shimura2004" "(2.13), p. 19 (Ψ(A^±(V)) = {[[a, b], [c, d]] | a, d ∈ A^±(U); b, c ∈ A^∓(U)})"]
theorem psi_mem_evenOdd_one_iff (ξ : CliffordAlgebra Q) :
    ξ ∈ evenOdd Q 1 ↔ psi he hf hef ξ 0 0 ∈ evenOdd (QU Q e f) 1 ∧ psi he hf hef ξ 0 1 ∈ evenOdd (QU Q e f) 0 ∧
      psi he hf hef ξ 1 0 ∈ evenOdd (QU Q e f) 0 ∧ psi he hf hef ξ 1 1 ∈ evenOdd (QU Q e f) 1 := by
  simp only [mem_evenOdd_zero_iff_involute_eq, mem_evenOdd_one_iff_involute_eq_neg]
  rw [← (psi_bijective he hf hef).1.eq_iff, psi_involute he hf hef ξ, map_neg]
  conv_lhs => rhs; rw [(psi he hf hef ξ).eta_fin_two]
  simp only [← Matrix.ext_iff, Fin.forall_fin_two]
  simp only [Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.neg_apply,
    Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.head_cons, Matrix.head_fin_const, neg_neg,
    neg_eq_iff_eq_neg, and_assoc]

end Hyp2

end MatrixModel

end QuadFormsKB.Shimura2004
