/-
# Shimura 2004, Lemma 3.16: Clifford group elements fixing a normal vector

**Source.** G. Shimura, *Arithmetic and Analytic Theories of Quadratic Forms and Clifford Groups*, Mathematical
Surveys and Monographs 109, American Mathematical Society, 2004 (key `shimura2004`), Chapter I, Lemma 3.16
(printed p. 27). Page numbers are printed pages.

**Setting and dictionary.** As in `QuadFormsKB/Literature/Shimura2004/CliffordGroups.lean`: $F$ a field of
characteristic $\ne 2$, `Q : QuadraticForm F V` nondegenerate with $Q(x) = \varphi[x]$, $A(V)$ = `CliffordAlgebra Q`,
$a \mapsto a'$ = `involute`, $a \mapsto a^*$ = `reverse`, $G'(V)$ = `homogeneousCliffordGroup Q`,
$G^+(V)$ = `Cassels.M0 Q`, $\nu$ = `multiplier`. Fix $h \in V$ and let $W = (Fh)^\perp$, the set of $w \in V$ with
$\varphi(h, w) = 0$ (`Q.IsOrtho h w`).

**How $G^\pm(W)$ sits in $A(V)$.** Shimura views $A(W)$ as the subalgebra of $A(V)$ generated by $W$, and
$G^\pm(W) \subseteq A(W)$. Here an element "of $G^\pm(W)$" is an element $a$ of $G'(V)$ that lies in the subalgebra
`Algebra.adjoin F (ι Q '' W)` and in $A^\pm(V)$ (`evenOdd Q 0` or `evenOdd Q 1`). Every element of $G^\pm(W)$ in
Shimura's sense is such an element (it is a product of invertible vectors of $W$, Theorem 3.6 for $W$), so the
statements below contain Shimura's.

**Proves** (unconditional; standard axioms only), with $h^2 = \varphi[h]$:
* the key identity $ha = a'h$ for every $a$ in the subalgebra generated by $W$ (`ι_mul_eq_involute_mul`);
* Lemma 3.16, first assertion: $a^*ha = \pm\nu(a)h$ for $a \in G^\pm(W)$ (`lemma_3_16_even`, `lemma_3_16_odd`);
* Lemma 3.16, second assertion: $a^*ha = \mp\nu(a)h$ for $a \in hG^\mp(W)$, together with
  $\nu(hb) = \varphi[h]\nu(b)$ (`lemma_3_16_h_even`, `lemma_3_16_h_odd`);
* the inclusion "$\supseteq$" of (3.20b): $a^{-1}ha = h$ for $a \in G^+(W)$ (`lemma_3_16_conj_eq`).

**Not covered:** the inclusions "$\subseteq$" of (3.20a) and (3.20b), which rest on Lemma 3.13 (the decomposition
$a = (1 + hx)p$ or $a = (y + h)q$ of the elements of $G^+(V)$ for $\dim V = \dim W + 1$), not formalized here.
-/
import QuadFormsKB.Literature.Shimura2004.CliffordGroups
import QuadFormsKB.Citation

open Module CliffordAlgebra

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.Shimura2004

open QuadFormsKB.Cassels QuadFormsKB.OMeara

variable {F V : Type*} [Field F] [Invertible (2 : F)] [AddCommGroup V] [Module F V] [FiniteDimensional F V]
  {Q : QuadraticForm F V}

local notation "A" => CliffordAlgebra Q

/-- The hyperplane $W = (Fh)^\perp$ of Lemma 3.16, as a set of vectors. -/
def orthHyperplane (Q : QuadraticForm F V) (h : V) : Set V := {w | Q.IsOrtho h w}

/-- **$ha = a'h$** for every $a$ in the subalgebra of $A(V)$ generated by $W = (Fh)^\perp$ (the identity behind
Shimura's "$ah = \pm ha$ for $a \in G^\pm(W)$", Lemma 3.16, p. 27). -/
theorem ι_mul_eq_involute_mul (h : V) {x : A}
    (hx : x ∈ Algebra.adjoin F (ι Q '' orthHyperplane Q h)) : ι Q h * x = involute x * ι Q h := by
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
    obtain ⟨w, hw, rfl⟩ := hy
    rw [involute_ι, neg_mul, ι_mul_ι_comm_of_isOrtho hw]
  | algebraMap r => rw [AlgHom.commutes, Algebra.commutes]
  | add x y _ _ ihx ihy => rw [mul_add, ihx, ihy, map_add, add_mul]
  | mul x y _ _ ihx ihy => rw [← mul_assoc, ihx, mul_assoc, ihy, ← mul_assoc, map_mul]

/-- $a^*a = \nu(a)$ on $G'(V)$ (Theorem 3.7 (ii), in the form used below). -/
theorem reverse_mul_self_eq (hQ : (QuadraticMap.associated Q).Nondegenerate) (a : homogeneousCliffordGroup Q) :
    reverse ((a : (CliffordAlgebra Q)ˣ) : A) * ((a : (CliffordAlgebra Q)ˣ) : A) =
      algebraMap F A (multiplier hQ a : F) := by
  simpa only [reverse_reverse] using reverse_mul_self_eq_multiplier hQ a

/-- **Lemma 3.16** (Shimura 2004, p. 27), first assertion, upper sign: $a^*ha = \nu(a)h$ for $a \in G^+(W)$,
$W = (Fh)^\perp$. -/
@[kb "shimura2004" "Lemma 3.16, p. 27 (a*ha = ν(a)h for a ∈ G⁺(W))"]
theorem lemma_3_16_even (hQ : (QuadraticMap.associated Q).Nondegenerate) (h : V)
    (a : homogeneousCliffordGroup Q) (haW : ((a : (CliffordAlgebra Q)ˣ) : A) ∈ Algebra.adjoin F
      (ι Q '' orthHyperplane Q h)) (ha0 : ((a : (CliffordAlgebra Q)ˣ) : A) ∈ evenOdd Q 0) :
    reverse ((a : (CliffordAlgebra Q)ˣ) : A) * ι Q h * ((a : (CliffordAlgebra Q)ˣ) : A) =
      algebraMap F A (multiplier hQ a : F) * ι Q h := by
  rw [mul_assoc, ι_mul_eq_involute_mul h haW, involute_eq_of_mem_even ha0, ← mul_assoc,
    reverse_mul_self_eq]

/-- **Lemma 3.16** (Shimura 2004, p. 27), first assertion, lower sign: $a^*ha = -\nu(a)h$ for $a \in G^-(W)$,
$W = (Fh)^\perp$. -/
@[kb "shimura2004" "Lemma 3.16, p. 27 (a*ha = -ν(a)h for a ∈ G⁻(W))"]
theorem lemma_3_16_odd (hQ : (QuadraticMap.associated Q).Nondegenerate) (h : V)
    (a : homogeneousCliffordGroup Q) (haW : ((a : (CliffordAlgebra Q)ˣ) : A) ∈ Algebra.adjoin F
      (ι Q '' orthHyperplane Q h)) (ha1 : ((a : (CliffordAlgebra Q)ˣ) : A) ∈ evenOdd Q 1) :
    reverse ((a : (CliffordAlgebra Q)ˣ) : A) * ι Q h * ((a : (CliffordAlgebra Q)ˣ) : A) =
      -(algebraMap F A (multiplier hQ a : F) * ι Q h) := by
  rw [mul_assoc, ι_mul_eq_involute_mul h haW, involute_eq_of_mem_odd ha1, neg_mul, mul_neg, ← mul_assoc,
    reverse_mul_self_eq]

/-- $\nu(hb) = \varphi[h]\,\nu(b)$ for $a = hb \in G'(V)$ with $b \in G'(V)$ (from (3.4a) and multiplicativity,
in the form used in Lemma 3.16). -/
theorem multiplier_eq_of_eq_ι_mul (hQ : (QuadraticMap.associated Q).Nondegenerate) (h : V)
    (a b : homogeneousCliffordGroup Q)
    (hab : ((a : (CliffordAlgebra Q)ˣ) : A) = ι Q h * ((b : (CliffordAlgebra Q)ˣ) : A)) :
    (multiplier hQ a : F) = Q h * (multiplier hQ b : F) := by
  apply (algebraMap F A).injective
  rw [algebraMap_multiplier, hab, reverse.map_mul, reverse_ι, mul_assoc, ← mul_assoc _ _ (ι Q h),
    ← algebraMap_multiplier hQ b, Algebra.commutes, ← mul_assoc, ι_sq_scalar, ← map_mul]

/-- The common computation of the second assertion of Lemma 3.16: $(hb)^*h(hb) = \varphi[h]\,b^*hb$. -/
theorem reverse_ι_mul_conj (h : V) (b : A) :
    reverse (ι Q h * b) * ι Q h * (ι Q h * b) = algebraMap F A (Q h) * (reverse b * ι Q h * b) := by
  rw [reverse.map_mul, reverse_ι]
  have : reverse b * ι Q h * ι Q h * (ι Q h * b) = reverse b * (ι Q h * ι Q h) * ι Q h * b := by
    simp only [mul_assoc]
  rw [this, ι_sq_scalar, ← Algebra.commutes, mul_assoc, mul_assoc, mul_assoc]

/-- **Lemma 3.16** (Shimura 2004, p. 27), second assertion, for $a = hb$ with $b \in G^+(W)$ (so
$a \in hG^+(W) \subseteq G^-(V)$, lower sign): $a^*ha = \nu(a)h$, $W = (Fh)^\perp$. -/
@[kb "shimura2004" "Lemma 3.16, p. 27 (a*ha = ν(a)h for a ∈ hG⁺(W))"]
theorem lemma_3_16_h_even (hQ : (QuadraticMap.associated Q).Nondegenerate) (h : V)
    (a b : homogeneousCliffordGroup Q)
    (hab : ((a : (CliffordAlgebra Q)ˣ) : A) = ι Q h * ((b : (CliffordAlgebra Q)ˣ) : A))
    (hbW : ((b : (CliffordAlgebra Q)ˣ) : A) ∈ Algebra.adjoin F (ι Q '' orthHyperplane Q h))
    (hb0 : ((b : (CliffordAlgebra Q)ˣ) : A) ∈ evenOdd Q 0) :
    reverse ((a : (CliffordAlgebra Q)ˣ) : A) * ι Q h * ((a : (CliffordAlgebra Q)ˣ) : A) =
      algebraMap F A (multiplier hQ a : F) * ι Q h := by
  rw [hab, reverse_ι_mul_conj, lemma_3_16_even hQ h b hbW hb0, ← mul_assoc, ← map_mul,
    ← multiplier_eq_of_eq_ι_mul hQ h a b hab]

/-- **Lemma 3.16** (Shimura 2004, p. 27), second assertion, for $a = hb$ with $b \in G^-(W)$ (so
$a \in hG^-(W) \subseteq G^+(V)$, upper sign): $a^*ha = -\nu(a)h$, $W = (Fh)^\perp$. -/
@[kb "shimura2004" "Lemma 3.16, p. 27 (a*ha = -ν(a)h for a ∈ hG⁻(W))"]
theorem lemma_3_16_h_odd (hQ : (QuadraticMap.associated Q).Nondegenerate) (h : V)
    (a b : homogeneousCliffordGroup Q)
    (hab : ((a : (CliffordAlgebra Q)ˣ) : A) = ι Q h * ((b : (CliffordAlgebra Q)ˣ) : A))
    (hbW : ((b : (CliffordAlgebra Q)ˣ) : A) ∈ Algebra.adjoin F (ι Q '' orthHyperplane Q h))
    (hb1 : ((b : (CliffordAlgebra Q)ˣ) : A) ∈ evenOdd Q 1) :
    reverse ((a : (CliffordAlgebra Q)ˣ) : A) * ι Q h * ((a : (CliffordAlgebra Q)ˣ) : A) =
      -(algebraMap F A (multiplier hQ a : F) * ι Q h) := by
  rw [hab, reverse_ι_mul_conj, lemma_3_16_odd hQ h b hbW hb1, mul_neg, ← mul_assoc, ← map_mul,
    ← multiplier_eq_of_eq_ι_mul hQ h a b hab]

/-- **(3.20b)**, inclusion "$\supseteq$" (Shimura 2004, Lemma 3.16, p. 27): $a^{-1}ha = h$ for every
$a \in G^+(W)$, $W = (Fh)^\perp$. -/
@[kb "shimura2004" "Lemma 3.16 (3.20b) ⊇, p. 27 (a⁻¹ha = h for a ∈ G⁺(W))"]
theorem lemma_3_16_conj_eq (h : V) (a : (CliffordAlgebra Q)ˣ)
    (haW : (a : A) ∈ Algebra.adjoin F (ι Q '' orthHyperplane Q h)) (ha0 : (a : A) ∈ evenOdd Q 0) :
    ((a⁻¹ : (CliffordAlgebra Q)ˣ) : A) * ι Q h * (a : A) = ι Q h := by
  rw [mul_assoc, ι_mul_eq_involute_mul h haW, involute_eq_of_mem_even ha0, ← mul_assoc, Units.inv_mul,
    one_mul]

end QuadFormsKB.Shimura2004
