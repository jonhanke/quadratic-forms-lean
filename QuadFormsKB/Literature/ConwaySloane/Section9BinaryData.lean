   ⟨(-1, -1, 15), (1, -1, -15), 4, 3, 0, 1⟩,
   ⟨(2, 0, -8), (0, 4, 0), 4, 2, 1, 0⟩]


/-- Every table entry is a genuine congruence by a unimodular matrix. -/
theorem tbl_ok : ∀ e ∈ tbl, actT e.rep e.M = e.f ∧ (detM e.M = 1 ∨ detM e.M = -1) ∧ e.rep ∈ reps ∧
    detT e.rep = detT e.f := by
  decide +kernel

/-- The table covers all reduced forms of determinant $-16 \le d \le -2$. -/
theorem cover : ∀ a ∈ Finset.Icc (-4 : ℤ) 4, ∀ b ∈ Finset.Icc (-4 : ℤ) 4, ∀ c ∈ Finset.Icc (-16 : ℤ) 16,
    RedT (a, b, c) → -16 ≤ detT (a, b, c) → detT (a, b, c) ≤ -2 → ∃ e ∈ tbl, e.f = (a, b, c) := by
  decide +kernel

/-- All certificates are valid. -/
theorem certs_ok : ∀ c ∈ certs, CertOK c := by
  decide +kernel

/-- Two distinct representatives of one determinant are separated by parity or by a certificate. -/
theorem sep_all : ∀ f ∈ reps, ∀ g ∈ reps, detT f = detT g → f ≠ g →
    ¬ (parT f ↔ parT g) ∨ ∃ c ∈ certs, (c.f = f ∧ c.g = g) ∨ (c.f = g ∧ c.g = f) := by
  decide +kernel

end QuadFormsKB.ConwaySloane.BinSmall
