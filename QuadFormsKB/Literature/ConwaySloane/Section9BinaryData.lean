/-
# Conway–Sloane, Ch. 15, §9.7, Cor. 22, $n = 2$: finite data for binary forms of determinant $-16 \le d \le -2$

**Layer:** Gram triples $(a, b, c)$ of binary forms $ax^2 + 2bxy + cy^2$ (the matrix $\begin{pmatrix}a&b\\b&c\end{pmatrix}$).

**Generated** by a script (outside Lean); every statement is checked by kernel evaluation (`decide +kernel`, no axioms).

* `tbl`: every reduced form $f$ with $-16 \le \det f \le -2$, a class representative `rep` and a matrix $M$,
  $\det M = \pm 1$, with $M^{\mathsf T}(\mathrm{rep})M = f$ (`tbl_ok`); `cover`: the reduced forms of these
  determinants are exactly the entries of `tbl`.
* `certs`: for every two representatives of one determinant not separated by the parity of the diagonal, a modulus $m$
  (a prime power) and a residue $r$ attained by one form mod $m$ and not by the other (`certs_ok`, `sep_all`).
-/
import QuadFormsKB.Literature.ConwaySloane.Section9Binary

namespace QuadFormsKB.ConwaySloane.BinSmall

/-- A binary form $ax^2 + 2bxy + cy^2$ as the triple $(a, b, c)$ of its Gram matrix. -/
abbrev Tri := ℤ × ℤ × ℤ

/-- The determinant $ac - b^2$ of the Gram matrix of $(a, b, c)$. -/
def detT (f : Tri) : ℤ := f.1 * f.2.2 - f.2.1 ^ 2

/-- The value $ax^2 + 2bxy + cy^2$ of the form $(a, b, c)$ at $(x, y)$. -/
def valT (f : Tri) (x y : ℤ) : ℤ := f.1 * x * x + 2 * f.2.1 * x * y + f.2.2 * y * y

/-- The form $M^{\mathsf T}\begin{pmatrix}a&b\\b&c\end{pmatrix}M$ for $M = \begin{pmatrix}p&q\\r&s\end{pmatrix}$,
as a triple. -/
def actT : Tri → ℤ × ℤ × ℤ × ℤ → Tri
  | (a, b, c), (p, q, r, s) =>
    (a * p * p + 2 * b * p * r + c * r * r, a * p * q + b * (p * s + q * r) + c * r * s,
      a * q * q + 2 * b * q * s + c * s * s)

/-- The determinant $ps - qr$ of $\begin{pmatrix}p&q\\r&s\end{pmatrix}$. -/
def detM : ℤ × ℤ × ℤ × ℤ → ℤ
  | (p, q, r, s) => p * s - q * r

/-- **Reduced** binary forms: $a \ne 0$, $2\lvert b\rvert \le \lvert a\rvert$, $a^2 \le \lvert d\rvert$; or
$a = 0$, $b > 0$, $0 \le c < 2b$. -/
def RedT (f : Tri) : Prop :=
  (f.1 ≠ 0 ∧ -|f.1| ≤ 2 * f.2.1 ∧ 2 * f.2.1 ≤ |f.1| ∧ f.1 ^ 2 ≤ |detT f|) ∨
    (f.1 = 0 ∧ 0 < f.2.1 ∧ 0 ≤ f.2.2 ∧ f.2.2 < 2 * f.2.1)

instance : DecidablePred RedT := fun f => by unfold RedT; infer_instance

/-- Both diagonal entries even (the form takes only even values). -/
def parT (f : Tri) : Prop := f.1 % 2 = 0 ∧ f.2.2 % 2 = 0

instance : DecidablePred parT := fun f => by unfold parT; infer_instance

/-- The moduli used to separate genera: prime powers. -/
def ms : List ℕ := [4, 8, 16, 32, 3, 9, 5, 25, 7, 49, 11, 13]

/-- A table entry: a reduced form `f`, its class representative `rep`, and `M` with `M^T rep M = f`. -/
structure Entry where
  f : Tri
  rep : Tri
  M : ℤ × ℤ × ℤ × ℤ

/-- A separating certificate: `f` takes the value `r` mod `m` (at `(x, y)`), `g` never does. -/
structure Cert where
  f : Tri
  g : Tri
  m : ℕ
  r : ℤ
  x : ℤ
  y : ℤ

/-- The certificate is valid. -/
def CertOK (c : Cert) : Prop :=
  c.m ∈ ms ∧ (valT c.f c.x c.y - c.r) % (c.m : ℤ) = 0 ∧
    ∀ x < c.m, ∀ y < c.m, (valT c.g x y - c.r) % (c.m : ℤ) ≠ 0

instance : DecidablePred CertOK := fun c => by unfold CertOK; infer_instance

