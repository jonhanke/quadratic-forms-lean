/-
# Conway–Sloane, Ch. 15, §9.5: root vectors and Theorem 18

J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Ch. 15, §9.5, p. 391
(`conwaysloane1999`).

**Layer.** $V_p = F_\mathfrak p^n$ for a finite prime $\mathfrak p$ of a number field $F$ (Conway–Sloane: $F = \mathbb Q$),
the form $Q$, a lattice $L$ with localization $L_\mathfrak p$, the reflections $\tau_x$ (`symm`), the integral
automorphisms $O(L_\mathfrak p)$ (`locStabV`), and $\theta(O^+(L_\mathfrak p))$ = `localSpinorNormGroup`, the
$p$-adically automorphous numbers of §9.3 (spinor norms of proper $p$-adically integral automorphisms).

**Defines**
* `IsRootVector`: a *$p$-adic root vector* (§9.5, p. 391): $Q(x) \ne 0$ and the reflection in $x$ is a $p$-adically
  integral automorphism.
* `Theorem18Statement`, a **named statement**: Conway–Sloane's Theorem 18 ("based on Theorem 81 of [Wat3]"):
  *a $p$-adic number is $p$-adically automorphous if and only if it is the product of an even number of norms of
  $p$-adic root vectors.* It is quoted in the book without proof. One direction is proved here
  (`mem_localSpinorNormGroup_of_rootVectors`); the other direction ("every proper integral automorphism has the spinor
  norm of a product of reflections in root vectors") is Watson's theorem. For odd $p$ it follows from Cassels Ch. 8,
  Cor. 1 to Lemma 3.3 (`Cassels.intAut_eq_prod_tau`, every integral automorph is a product of integral reflections);
  at $p = 2$ the orthogonal group is not always generated by integral reflections (O'Meara 1958; the book's remark
  p. 391) and the statement needs Watson's or Earnest–Hsia's computation. Theorems 19–21 and Corollary 22 use only the
  proved direction (through explicit root vectors, `Section9Dyadic*.lean` and Cassels' Lemmas 3.7, 3.8).
  *Update:* both directions at odd $p$ are `theorem18_odd` (`Section9Theorem18Odd.lean`);
  `Theorem18Statement` follows from the named statement `Theorem18Dyadic` (the $p = 2$ "only if" direction) by
  `theorem18Statement_of_dyadic`.
-/
import QuadFormsKB.Literature.Cassels.Ch11Sec3Local

open NumberField IsDedekindDomain

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.ConwaySloane

open Lattices

section RootVectors

variable {F : Type} [Field F] [NumberField F] {n : ℕ} (Q : QuadForm F n) (L : Lat F n)
  (v : HeightOneSpectrum (𝓞 F))

local notation "Fv" => v.adicCompletion F

/-- **$p$-adic root vector** (Conway–Sloane §9.5, p. 391): *a vector $x$ is called a $p$-adic root vector for $f$ if and
only if the reflection in $x$ is a $p$-adically integral automorphism of $f$*: $Q(x) \ne 0$ and $\tau_x \in O(L_p)$. -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, p. 391 (p-adic root vector)"]
def IsRootVector (x : Fin n → Fv) : Prop := Q.evalIn Fv x ≠ 0 ∧ symm Q Fv x ∈ locStabV Q v L

variable {Q L v}

/-- The product of the reflections in an even number of root vectors is a proper integral automorphism with spinor
norm the product of their norms. -/
theorem exists_rot_of_rootVectors (hQ : Q.Nondegenerate) :
    ∀ xs : List (Fin n → Fv), Even xs.length → (∀ x ∈ xs, IsRootVector Q L v x) →
      ∃ σ ∈ locStabV Q v L ⊓ Tamagawa.soSub Q Fv, spinorNorm Q Fv σ = sqClassOf (valProd Q Fv xs)
  | [], _, _ => ⟨1, Subgroup.one_mem _, by
      rw [← spinorNormHom_apply Q Fv hQ, map_one]; simp [valProd, sqClassOf]; rfl⟩
  | [_], h, _ => by simp at h
  | x :: y :: rest, h, hr => by
    have hrest : Even rest.length := by
      simp only [List.length_cons] at h
      rcases h with ⟨k, hk⟩
      exact ⟨k - 1, by omega⟩
    obtain ⟨σ, ⟨hσL, hσ1⟩, hσθ⟩ :=
      exists_rot_of_rootVectors hQ rest hrest (fun z hz => hr z (by simp [hz]))
    obtain ⟨hx0, hxs⟩ := hr x (by simp)
    obtain ⟨hy0, hys⟩ := hr y (by simp)
    have hv0 : valProd Q Fv rest ≠ 0 := valProd_ne_zero Q Fv (fun z hz => (hr z (by simp [hz])).1)
    refine ⟨symm Q Fv x * symm Q Fv y * σ, ⟨(locStabV Q v L).mul_mem ((locStabV Q v L).mul_mem hxs hys) hσL, ?_⟩, ?_⟩
    · refine (Tamagawa.soSub Q Fv).mul_mem (Tamagawa.mem_soSub.mpr ?_) hσ1
      change (((symm Q Fv x : GL (Fin n) Fv) * (symm Q Fv y : GL (Fin n) Fv) : GL (Fin n) Fv) :
        Matrix (Fin n) (Fin n) Fv).det = 1
      rw [Units.val_mul, Matrix.det_mul, symm_det Q Fv hx0, symm_det Q Fv hy0]
      norm_num
    · have hxy := spinorNorm_symmProd Q Fv hQ [x, y] (by simp [hx0, hy0])
      simp only [symmProd, valProd, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one] at hxy
      rw [← spinorNormHom_apply Q Fv hQ, map_mul, spinorNormHom_apply, spinorNormHom_apply, hxy, hσθ,
        ← sqClassOf_mul (mul_ne_zero hx0 hy0) hv0]
      simp only [valProd, List.map_cons, List.prod_cons]
      ring_nf

/-- **Theorem 18, the proved direction**: the product of the norms of an even number of $p$-adic root vectors is
$p$-adically automorphous (in $\theta(O^+(L_p))$, up to squares). -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, Thm. 18, p. 391 (the 'if' direction)"]
theorem mem_localSpinorNormGroup_of_rootVectors (hQ : Q.Nondegenerate) (xs : List (Fin n → Fv))
    (hev : Even xs.length) (hr : ∀ x ∈ xs, IsRootVector Q L v x) (A : Fvˣ)
    (hA : SqClass.mk A = sqClassOf (valProd Q Fv xs)) : A ∈ localSpinorNormGroup Q hQ v L := by
  obtain ⟨σ, hσ, hσθ⟩ := exists_rot_of_rootVectors hQ xs hev hr
  rw [mem_localSpinorNormGroup]
  exact ⟨σ, hσ, hσθ.trans hA.symm⟩

end RootVectors

/-- **Conway–Sloane, Theorem 18** (§9.5, p. 391; "based on Theorem 81 of [Wat3]"), as a **named statement** (quoted
without proof in the book; see the module docstring): for every regular form $Q$ over $\mathbb Q$, lattice $L$ and
prime $p$, *a $p$-adic number $A$ is $p$-adically automorphous if and only if it is the product of an even number of
norms of $p$-adic root vectors* (up to squares). Not used as a hypothesis anywhere; the "if" direction is
`mem_localSpinorNormGroup_of_rootVectors`. -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, Thm. 18, p. 391 (stated; Watson 1960, Thm. 81)"]
structure Theorem18Statement : Prop where
  mem_iff : ∀ (n : ℕ) (Q : QuadForm ℚ n) (hQ : Q.Nondegenerate) (L : Lat ℚ n) (v : HeightOneSpectrum (𝓞 ℚ))
    (A : (v.adicCompletion ℚ)ˣ), A ∈ localSpinorNormGroup Q hQ v L ↔
      ∃ xs : List (Fin n → v.adicCompletion ℚ), Even xs.length ∧ (∀ x ∈ xs, IsRootVector Q L v x) ∧
        SqClass.mk A = sqClassOf (valProd Q (v.adicCompletion ℚ) xs)

end QuadFormsKB.ConwaySloane
