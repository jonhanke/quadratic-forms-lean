/-
# Conway–Sloane, Ch. 15, §9.5: Theorem 18 at $p = 2$, the root group

J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Ch. 15, §9.5, p. 391
(`conwaysloane1999`), Theorem 18: *a $p$-adic number is $p$-adically automorphous if and only if it is the product of
an even number of norms of $p$-adic root vectors.* This file starts the case analysis of the "only if" direction at
$p = 2$ (the named statement `Theorem18Dyadic`) by $2$-adic Jordan shape.

**Layer.** As in `Section9Theorem18Odd.lean`: $V_\mathfrak p = F_\mathfrak p^n$, the form $Q$, a lattice $L$ with
localization $L_\mathfrak p$ (`loc v L.1`), a basis $b_k = \gamma e_k$ of $L_\mathfrak p$
(`loc v L.1 = locAct v γ (std v)`) with Gram matrix $G = \gamma^{\mathsf T}H\gamma$ of
$B(x, y) = Q(x + y) - Q(x) - Q(y)$ (`locGram`, so $G_{kk} = 2Q(b_k)$), the $p$-adic root vectors (`IsRootVector`) and
$\theta(O^+(L_\mathfrak p))$ = `localSpinorNormGroup`.

**Defines**
* `rootGroup Q L v`: the subgroup of $F_\mathfrak p^\times/F_\mathfrak p^{\times 2}$ of the classes
  $Q(x_1)\cdots Q(x_r)F_\mathfrak p^{\times 2}$, $r$ even, $x_1, \dots, x_r$ $p$-adic root vectors (a subgroup: lists
  concatenate, and every square class is its own inverse);
* `Theorem18OnlyIf Q L v hQ` (a **condition** on one lattice at one prime): the "only if" direction of Theorem 18 for
  $L$ at $\mathfrak p$, i.e. every $A \in \theta(O^+(L_\mathfrak p))$ is, up to squares, a product of the norms of an
  even number of $p$-adic root vectors. `Theorem18Dyadic` is this condition for every lattice over $\mathbb Q$ at the
  prime over $2$.

**Proves**
* `theorem18OnlyIf_iff`: the condition says $\theta(O^+(L_\mathfrak p)) \subseteq$ `rootGroup` (on square classes);
  `theorem18OnlyIf_of_eq_top` (**the big root group lemma**): it holds when `rootGroup` is everything;
  `theorem18OnlyIf_of_le`: it holds when $\theta(O^+(L_\mathfrak p))$ lies in a subgroup contained in `rootGroup`;
* `theorem18OnlyIf_of_generated`: it holds when the integral automorphisms are generated by integral reflections;
* `theorem18OnlyIf_of_le_one` (**dimension $n \le 1$**): $O^+(V)$ is trivial, so the condition holds;
* over $\mathbb Q$ at $v \mid 2$: `sqClassOf_mem_of_even` (every class of even order is a unit class),
  `rootGroup_eq_top_of_units_of_odd` (if `rootGroup` contains every unit class and one class of odd order, it is
  everything), `isRootVector_basis_of_orth` (a basis vector spanning an orthogonal summand is a root vector),
  `units_le_rootGroup_of_binary` (a binary orthogonal summand of type (i) of Cassels' Lemma 3.8, i.e.
  $\phi = 2^e(ax^2 + xy + cy^2)$, puts every unit class in `rootGroup`), and the shapes
  `rootGroup_eq_top_of_binary_single` (such a binary summand $\perp$ a $1$-dimensional summand
  $\langle Q(b_k)\rangle$ with $G_{ij}Q(b_k)$ of odd order) and `rootGroup_eq_top_of_binary_binary` (two such binary
  summands with $G_{ij}G_{kl}$ of odd order), for which `Theorem18OnlyIf` holds (`theorem18OnlyIf_of_binary_single`,
  `theorem18OnlyIf_of_binary_binary`).
-/
import QuadFormsKB.Literature.ConwaySloane.Section9Theorem18Generated
import QuadFormsKB.Literature.ConwaySloane.Section9RootNorms

open NumberField IsDedekindDomain Matrix WithZero

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.ConwaySloane

open Lattices

section General

variable {F : Type} [Field F] [NumberField F] {n : ℕ} (Q : QuadForm F n) (L : Lat F n)
  (v : HeightOneSpectrum (𝓞 F))

local notation "Fv" => v.adicCompletion F

theorem valProd_append (xs ys : List (Fin n → Fv)) :
    valProd Q Fv (xs ++ ys) = valProd Q Fv xs * valProd Q Fv ys := by
  simp [valProd, List.map_append, List.prod_append]

/-- **The root group** of $L$ at $\mathfrak p$: the square classes $Q(x_1)\cdots Q(x_r)F_\mathfrak p^{\times 2}$ of
products of the norms of an even number $r$ of $p$-adic root vectors $x_1, \dots, x_r$ (Conway–Sloane §9.5, p. 391,
Theorem 18: these are the classes the theorem says make up $\theta(O^+(L_\mathfrak p))$). -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, Thm. 18, p. 391 (products of an even number of norms of p-adic root vectors)"]
def rootGroup : Subgroup (SqClass Fv) where
  carrier := {c | ∃ xs : List (Fin n → Fv), Even xs.length ∧ (∀ x ∈ xs, IsRootVector Q L v x) ∧
    c = sqClassOf (valProd Q Fv xs)}
  mul_mem' := by
    rintro _ _ ⟨xs, hx, hxr, rfl⟩ ⟨ys, hy, hyr, rfl⟩
    refine ⟨xs ++ ys, by rw [List.length_append]; exact hx.add hy, fun z hz => ?_, ?_⟩
    · rcases List.mem_append.mp hz with h | h
      · exact hxr z h
      · exact hyr z h
    · rw [valProd_append, sqClassOf_mul (valProd_ne_zero Q Fv fun z hz => (hxr z hz).1)
        (valProd_ne_zero Q Fv fun z hz => (hyr z hz).1)]
  one_mem' := ⟨[], ⟨0, rfl⟩, by simp, by simp [valProd, sqClassOf_one]⟩
  inv_mem' := by
    rintro _ ⟨xs, hx, hxr, rfl⟩
    exact ⟨xs, hx, hxr, SqClass.inv_eq _⟩

variable {Q L v}

theorem mem_rootGroup {c : SqClass Fv} :
    c ∈ rootGroup Q L v ↔ ∃ xs : List (Fin n → Fv), Even xs.length ∧ (∀ x ∈ xs, IsRootVector Q L v x) ∧
      c = sqClassOf (valProd Q Fv xs) := Iff.rfl

/-- The class of $Q(x)Q(y)$ for two root vectors lies in the root group. -/
theorem sqClassOf_mul_mem_rootGroup {x y : Fin n → Fv} (hx : IsRootVector Q L v x)
    (hy : IsRootVector Q L v y) : sqClassOf (Q.evalIn Fv x * Q.evalIn Fv y) ∈ rootGroup Q L v := by
  refine ⟨[x, y], ⟨1, rfl⟩, fun z hz => ?_, by simp [valProd]⟩
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hz
  rcases hz with rfl | rfl
  exacts [hx, hy]

variable (Q L v) in
/-- **Theorem 18, "only if", for one lattice at one prime** (a condition): every
$A \in \theta(O^+(L_\mathfrak p))$ (`localSpinorNormGroup`) satisfies $AF_\mathfrak p^{\times 2} =
Q(x_1)\cdots Q(x_r)F_\mathfrak p^{\times 2}$ for an even number $r$ of $p$-adic root vectors $x_1, \dots, x_r$
(Conway–Sloane §9.5, p. 391). The named statement `Theorem18Dyadic` is this condition for every regular form and
lattice over $\mathbb Q$ at the prime over $2$. -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, Thm. 18, p. 391 ('only if' for one lattice at one prime)"]
def Theorem18OnlyIf (hQ : Q.Nondegenerate) : Prop :=
  ∀ A : Fvˣ, A ∈ localSpinorNormGroup Q hQ v L →
    ∃ xs : List (Fin n → Fv), Even xs.length ∧ (∀ x ∈ xs, IsRootVector Q L v x) ∧
      SqClass.mk A = sqClassOf (valProd Q Fv xs)

/-- The condition says that $\theta(O^+(L_\mathfrak p))$ lies in the root group (on square classes). -/
theorem theorem18OnlyIf_iff (hQ : Q.Nondegenerate) :
    Theorem18OnlyIf Q L v hQ ↔ ∀ A : Fvˣ, A ∈ localSpinorNormGroup Q hQ v L → SqClass.mk A ∈ rootGroup Q L v :=
  Iff.rfl

/-- **Theorem 18, "only if", when $\theta(O^+(L_\mathfrak p))$ lies in a subgroup $H$ of the root group.** -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, Thm. 18, p. 391 ('only if' from an upper bound inside the root group)"]
theorem theorem18OnlyIf_of_le (hQ : Q.Nondegenerate) (H : Subgroup (SqClass Fv))
    (hθ : ∀ A : Fvˣ, A ∈ localSpinorNormGroup Q hQ v L → SqClass.mk A ∈ H) (hH : H ≤ rootGroup Q L v) :
    Theorem18OnlyIf Q L v hQ :=
  fun A hA => hH (hθ A hA)

/-- **The big root group lemma**: if the products of an even number of norms of root vectors give every square class,
the "only if" direction of Theorem 18 holds for $L$ at $\mathfrak p$. -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, Thm. 18, p. 391 ('only if' when the root group is everything)"]
theorem theorem18OnlyIf_of_eq_top (hQ : Q.Nondegenerate) (h : rootGroup Q L v = ⊤) :
    Theorem18OnlyIf Q L v hQ :=
  fun A _ => by
    have : SqClass.mk A ∈ rootGroup Q L v := by rw [h]; exact Subgroup.mem_top _
    exact this

/-- **Theorem 18, "only if", when the integral automorphisms are products of integral reflections**
(`GeneratedByRootReflections`, the condition of the remark after Theorem 18). -/
theorem theorem18OnlyIf_of_generated (hQ : Q.Nondegenerate) (hgen : GeneratedByRootReflections Q v L) :
    Theorem18OnlyIf Q L v hQ :=
  fun A hA => (theorem18_of_generated Q hQ L hgen A).mp hA

/-- In dimension $n \le 1$ the only rotation is the identity. -/
theorem eq_one_of_mem_soSub_of_le_one (hn : n ≤ 1) {σ : orthGroup Q Fv} (hσ : σ ∈ Tamagawa.soSub Q Fv) :
    σ = 1 := by
  have hdet : ((σ : GL (Fin n) Fv) : Matrix (Fin n) (Fin n) Fv).det = 1 := hσ
  refine Subtype.ext (Units.ext (Matrix.ext fun i j => ?_))
  obtain rfl : n = 1 := by have := i.pos; omega
  obtain rfl : i = 0 := Subsingleton.elim _ _
  obtain rfl : j = 0 := Subsingleton.elim _ _
  rw [Matrix.det_unique] at hdet
  simpa using hdet

/-- **Theorem 18, "only if", in dimension $n \le 1$**: $O^+(V)$ is trivial, so $\theta(O^+(L_\mathfrak p))$ is
trivial. -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, Thm. 18, p. 391 ('only if', dimension at most 1)"]
theorem theorem18OnlyIf_of_le_one (hQ : Q.Nondegenerate) (hn : n ≤ 1) : Theorem18OnlyIf Q L v hQ := by
  intro A hA
  obtain ⟨σ, ⟨-, hσ1⟩, hσθ⟩ := (mem_localSpinorNormGroup Q hQ v L).mp hA
  rw [eq_one_of_mem_soSub_of_le_one hn hσ1, ← spinorNormHom_apply Q Fv hQ, map_one] at hσθ
  exact ⟨[], ⟨0, rfl⟩, by simp, by rw [← hσθ]; simp [valProd, sqClassOf_one]⟩

/-- **A basis vector spanning an orthogonal summand is a root vector**: if $b_k = \gamma e_k$ is orthogonal to the
other basis vectors ($G_{mk} = 0$ for $m \ne k$) and $G_{kk} \ne 0$, then $\tau_{b_k} \in O(L_\mathfrak p)$, because
$\lvert B(b_k, y)\rvert \le \lvert G_{kk}\rvert \le \lvert Q(b_k)\rvert$ on $L_\mathfrak p$ ($\lvert 2\rvert \le 1$). -/
theorem isRootVector_basis_of_orth (γ : GL (Fin n) Fv) (hγ : loc v L.1 = locAct v γ (std v)) (k : Fin n)
    (horth : ∀ m, m ≠ k → locGram Q v γ m k = 0) (hk0 : locGram Q v γ k k ≠ 0) :
    IsRootVector Q L v (γ.val *ᵥ Pi.single k 1) := by
  have h2ne : (2 : Fv) ≠ 0 := two_ne_zero
  have hx0 : Q.evalIn Fv (γ.val *ᵥ Pi.single k 1) ≠ 0 := by
    rw [evalIn_basis_eq]; exact div_ne_zero hk0 h2ne
  refine ⟨hx0, symm_mem_of_gram L γ hγ (single_mem_std k (by simp)) hx0 fun m => ?_⟩
  change Valued.v ((fun l => locGram Q v γ m l) ⬝ᵥ Pi.single k 1) ≤ _
  rw [dotProduct_single, mul_one, evalIn_basis_eq]
  by_cases hm : m = k
  · subst hm
    have h2 : Valued.v (2 : Fv) ≤ 1 := valued_two_le_one
    have e : locGram Q v γ m m = 2 * (locGram Q v γ m m / 2) := by field_simp
    conv_lhs => rw [e]
    rw [map_mul]
    calc _ ≤ 1 * Valued.v (locGram Q v γ m m / 2) := mul_le_mul' h2 le_rfl
      _ = _ := one_mul _
  · rw [horth m hm, map_zero]; exact zero_le

end General

/-! ### Over $\mathbb Q$ at the prime over $2$ -/

section Dyadic

attribute [local instance 2000] HeightOneSpectrum.instAlgebraAdicCompletion

variable {n : ℕ} {Q : QuadForm ℚ n} {L : Lat ℚ n} {v : HeightOneSpectrum (𝓞 ℚ)}

local notation "Fv" => v.adicCompletion ℚ
local notation "𝔬" => v.adicCompletionIntegers ℚ

/-- $\lvert 2^k\rvert = e^{-k}$ for $k \in \mathbb Z$. -/
theorem valued_two_zpow (h2 : (2 : 𝓞 ℚ) ∈ v.asIdeal) (k : ℤ) : Valued.v ((2 : Fv) ^ k) = exp (-k) := by
  rw [map_zpow₀, valued_two_dyadic v h2, ← WithZero.exp_zsmul]
  congr 1
  simp

/-- **Classes of even order are unit classes**: if $\lvert x\rvert = e^{2m}$ then $xF_2^{\times 2} =
uF_2^{\times 2}$ with $u = x \cdot (2^m)^2$ a unit. So a subgroup containing every unit class contains the class of
every element of even order. -/
theorem sqClassOf_mem_of_even (h2 : (2 : 𝓞 ℚ) ∈ v.asIdeal) {H : Subgroup (SqClass Fv)}
    (hunits : ∀ u : Fv, Valued.v u = 1 → sqClassOf u ∈ H) {x : Fv} (hx : x ≠ 0) (m : ℤ)
    (hm : Valued.v x = exp (2 * m)) : sqClassOf x ∈ H := by
  have h2m : ((2 : Fv) ^ m) ≠ 0 := zpow_ne_zero _ two_ne_zero
  have hu : Valued.v (((2 : Fv) ^ m) ^ 2 * x) = 1 := by
    rw [map_mul, map_pow, valued_two_zpow h2, hm, ← WithZero.exp_nsmul, ← exp_add, ← exp_zero]
    congr 1
    simp only [nsmul_eq_mul, Nat.cast_ofNat]
    ring
  have := hunits _ hu
  rwa [sqClassOf_sq_mul h2m hx] at this

/-- **A root group containing every unit class and one class of odd order is everything** ($F_2^\times =
2^{\mathbb Z}\mathbb Z_2^\times$). -/
theorem rootGroup_eq_top_of_units_of_odd (h2 : (2 : 𝓞 ℚ) ∈ v.asIdeal) {H : Subgroup (SqClass Fv)}
    (hunits : ∀ u : Fv, Valued.v u = 1 → sqClassOf u ∈ H) {a : Fv} (k : ℤ)
    (ha : Valued.v a = exp (2 * k + 1)) (haH : sqClassOf a ∈ H) : H = ⊤ := by
  have ha0 : a ≠ 0 := fun h => by rw [h, map_zero] at ha; exact exp_ne_zero.symm ha
  refine eq_top_iff.mpr fun c _ => ?_
  induction c using SqClass.ind with
  | h x =>
  have hx0 : (x : Fv) ≠ 0 := x.ne_zero
  have hmk : SqClass.mk x = sqClassOf (x : Fv) := by
    rw [sqClassOf_of_ne_zero hx0]; exact congrArg SqClass.mk (Units.ext rfl)
  rw [hmk]
  have hv0 : Valued.v (x : Fv) ≠ 0 := (Valuation.ne_zero_iff _).mpr hx0
  set j := log (Valued.v (x : Fv))
  have hj : Valued.v (x : Fv) = exp j := (exp_log hv0).symm
  rcases Int.even_or_odd j with ⟨m, hm⟩ | ⟨m, hm⟩
  · exact sqClassOf_mem_of_even h2 hunits hx0 m (by rw [hj, hm, two_mul])
  · have hxa : sqClassOf ((x : Fv) * a) ∈ H :=
      sqClassOf_mem_of_even h2 hunits (mul_ne_zero hx0 ha0) (m + k + 1)
        (by rw [map_mul, hj, ha, ← exp_add, hm]; congr 1; ring)
    rw [sqClassOf_mul hx0 ha0] at hxa
    have := H.mul_mem hxa haH
    rwa [mul_assoc, SqClass.mul_self, mul_one] at this

/-- **Root vectors of a binary orthogonal summand of type (i)** (Cassels, Lemma 3.8 (i), p. 214): if $b_i, b_j$
($i \ne j$) span an orthogonal summand of $L_2$ with $G_{ij} \ne 0$ and
$\lvert G_{ii}\rvert, \lvert G_{jj}\rvert \le \lvert 2G_{ij}\rvert$ (so $\phi(sb_i + tb_j) = G_{ij}(as^2 + st + ct^2)$
with $a, c \in \mathbb Z_2$), then for every unit $u$ there is a $2$-adic root vector of norm $G_{ij}u$. -/
theorem exists_rootVector_binary (h2 : (2 : 𝓞 ℚ) ∈ v.asIdeal) (γ : GL (Fin n) Fv)
    (hγ : loc v L.1 = locAct v γ (std v)) {i j : Fin n} (hij : i ≠ j)
    (horth : ∀ m, m ≠ i → m ≠ j → locGram Q v γ m i = 0 ∧ locGram Q v γ m j = 0)
    (hij0 : locGram Q v γ i j ≠ 0)
    (hi : Valued.v (locGram Q v γ i i) ≤ Valued.v (2 * locGram Q v γ i j))
    (hj : Valued.v (locGram Q v γ j j) ≤ Valued.v (2 * locGram Q v γ i j)) {u : Fv} (hu : Valued.v u = 1) :
    ∃ x, IsRootVector Q L v x ∧ Q.evalIn Fv x = locGram Q v γ i j * u := by
  have h2ne : (2 : Fv) ≠ 0 := two_ne_zero
  have hpos : 0 < Valued.v ((2 : Fv) * locGram Q v γ i j) :=
    zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr (mul_ne_zero h2ne hij0))
  have hai1 : Valued.v (locGram Q v γ i i / (2 * locGram Q v γ i j)) ≤ 1 := by
    rw [map_div₀, div_le_one₀ hpos]; exact hi
  have hcj1 : Valued.v (locGram Q v γ j j / (2 * locGram Q v γ i j)) ≤ 1 := by
    rw [map_div₀, div_le_one₀ hpos]; exact hj
  have hai : locGram Q v γ i i = 2 * locGram Q v γ i j * ((toO v _ hai1 : 𝔬) : Fv) := by
    show locGram Q v γ i i = 2 * locGram Q v γ i j * (locGram Q v γ i i / (2 * locGram Q v γ i j))
    field_simp
  have hcj : locGram Q v γ j j = 2 * locGram Q v γ i j * ((toO v _ hcj1 : 𝔬) : Fv) := by
    show locGram Q v γ j j = 2 * locGram Q v γ i j * (locGram Q v γ j j / (2 * locGram Q v γ i j))
    field_simp
  have u0 : IsUnit (toO v u hu.le) := HeightOneSpectrum.adicCompletionIntegers.isUnit_iff_valued_eq_one.mpr hu
  obtain ⟨s, t, hst⟩ := exists_binary_value h2 (toO v _ hai1) (toO v _ hcj1) _ u0
  obtain ⟨x, hx, hxs⟩ := binary_adm L γ hγ hij horth hij0 hai hcj s t (by rw [hst]; exact u0)
  rw [hst] at hx
  have hu0 : u ≠ 0 := fun h => by rw [h, map_zero] at hu; exact zero_ne_one hu
  have hx' : Q.evalIn Fv x = locGram Q v γ i j * u := hx
  exact ⟨x, ⟨by rw [hx']; exact mul_ne_zero hij0 hu0, hxs⟩, hx'⟩

/-- **A binary orthogonal summand of type (i) puts every unit class in the root group** (Cassels, Lemma 3.8 (i),
p. 214, for the root group instead of $\theta$): with the root vectors $x, y$ of norms $G_{ij}u$ and $G_{ij}$
(`exists_rootVector_binary`), $Q(x)Q(y)F_2^{\times 2} = uF_2^{\times 2}$. -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, p. 391 (2-adic root vectors of a binary Jordan component)"]
theorem units_le_rootGroup_of_binary (h2 : (2 : 𝓞 ℚ) ∈ v.asIdeal) (γ : GL (Fin n) Fv)
    (hγ : loc v L.1 = locAct v γ (std v)) {i j : Fin n} (hij : i ≠ j)
    (horth : ∀ m, m ≠ i → m ≠ j → locGram Q v γ m i = 0 ∧ locGram Q v γ m j = 0)
    (hij0 : locGram Q v γ i j ≠ 0)
    (hi : Valued.v (locGram Q v γ i i) ≤ Valued.v (2 * locGram Q v γ i j))
    (hj : Valued.v (locGram Q v γ j j) ≤ Valued.v (2 * locGram Q v γ i j)) :
    ∀ u : Fv, Valued.v u = 1 → sqClassOf u ∈ rootGroup Q L v := by
  intro u hu
  obtain ⟨x, hxr, hx⟩ := exists_rootVector_binary h2 γ hγ hij horth hij0 hi hj hu
  obtain ⟨y, hyr, hy⟩ := exists_rootVector_binary h2 γ hγ hij horth hij0 hi hj (map_one Valued.v)
  have hmem := sqClassOf_mul_mem_rootGroup hxr hyr
  have e : Q.evalIn Fv x * Q.evalIn Fv y = locGram Q v γ i j ^ 2 * u := by rw [hx, hy]; ring
  have hu0 : u ≠ 0 := fun h => by rw [h, map_zero] at hu; exact zero_ne_one hu
  rwa [e, sqClassOf_sq_mul hij0 hu0] at hmem

/-- **Shape: a binary summand of type (i) and a $1$-dimensional summand at odd relative order.** If $b_i, b_j$ span a
binary orthogonal summand of type (i) (as in `units_le_rootGroup_of_binary`) and $b_k$ spans a $1$-dimensional
orthogonal summand ($G_{mk} = 0$ for $m \ne k$) with $\lvert G_{ij}\,Q(b_k)\rvert = e^{2m+1}$ (odd order), the
root group is everything. -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, p. 391 (root group of a binary and a unary Jordan component)"]
theorem rootGroup_eq_top_of_binary_single (h2 : (2 : 𝓞 ℚ) ∈ v.asIdeal) (γ : GL (Fin n) Fv)
    (hγ : loc v L.1 = locAct v γ (std v)) {i j k : Fin n} (hij : i ≠ j)
    (horth : ∀ m, m ≠ i → m ≠ j → locGram Q v γ m i = 0 ∧ locGram Q v γ m j = 0)
    (hij0 : locGram Q v γ i j ≠ 0)
    (hi : Valued.v (locGram Q v γ i i) ≤ Valued.v (2 * locGram Q v γ i j))
    (hj : Valued.v (locGram Q v γ j j) ≤ Valued.v (2 * locGram Q v γ i j))
    (hkorth : ∀ m, m ≠ k → locGram Q v γ m k = 0) (m : ℤ)
    (hodd : Valued.v (locGram Q v γ i j * (locGram Q v γ k k / 2)) = exp (2 * m + 1)) :
    rootGroup Q L v = ⊤ := by
  have hunits := units_le_rootGroup_of_binary h2 γ hγ hij horth hij0 hi hj
  have hk0 : locGram Q v γ k k ≠ 0 := fun h => by
    rw [h, zero_div, mul_zero, map_zero] at hodd; exact exp_ne_zero.symm hodd
  have hbk := isRootVector_basis_of_orth γ hγ k hkorth hk0
  obtain ⟨y, hyr, hy⟩ := exists_rootVector_binary h2 γ hγ hij horth hij0 hi hj (map_one Valued.v)
  rw [mul_one] at hy
  have hmem := sqClassOf_mul_mem_rootGroup hyr hbk
  rw [hy, evalIn_basis_eq] at hmem
  exact rootGroup_eq_top_of_units_of_odd h2 hunits m hodd hmem

/-- **Shape: two binary summands of type (i) at odd relative order.** If $b_i, b_j$ and $b_k, b_l$ span two binary
orthogonal summands of type (i) with $\lvert G_{ij}G_{kl}\rvert = e^{2m+1}$, the root group is everything. -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, p. 391 (root group of two binary Jordan components)"]
theorem rootGroup_eq_top_of_binary_binary (h2 : (2 : 𝓞 ℚ) ∈ v.asIdeal) (γ : GL (Fin n) Fv)
    (hγ : loc v L.1 = locAct v γ (std v)) {i j k l : Fin n} (hij : i ≠ j) (hkl : k ≠ l)
    (horth : ∀ m, m ≠ i → m ≠ j → locGram Q v γ m i = 0 ∧ locGram Q v γ m j = 0)
    (hij0 : locGram Q v γ i j ≠ 0)
    (hi : Valued.v (locGram Q v γ i i) ≤ Valued.v (2 * locGram Q v γ i j))
    (hj : Valued.v (locGram Q v γ j j) ≤ Valued.v (2 * locGram Q v γ i j))
    (horth' : ∀ m, m ≠ k → m ≠ l → locGram Q v γ m k = 0 ∧ locGram Q v γ m l = 0)
    (hkl0 : locGram Q v γ k l ≠ 0)
    (hk : Valued.v (locGram Q v γ k k) ≤ Valued.v (2 * locGram Q v γ k l))
    (hl : Valued.v (locGram Q v γ l l) ≤ Valued.v (2 * locGram Q v γ k l)) (m : ℤ)
    (hodd : Valued.v (locGram Q v γ i j * locGram Q v γ k l) = exp (2 * m + 1)) :
    rootGroup Q L v = ⊤ := by
  have hunits := units_le_rootGroup_of_binary h2 γ hγ hij horth hij0 hi hj
  obtain ⟨y, hyr, hy⟩ := exists_rootVector_binary h2 γ hγ hij horth hij0 hi hj (map_one Valued.v)
  obtain ⟨z, hzr, hz⟩ := exists_rootVector_binary h2 γ hγ hkl horth' hkl0 hk hl (map_one Valued.v)
  rw [mul_one] at hy hz
  have hmem := sqClassOf_mul_mem_rootGroup hyr hzr
  rw [hy, hz] at hmem
  exact rootGroup_eq_top_of_units_of_odd h2 hunits m hodd hmem

/-- **Theorem 18, "only if", for the shape binary $\perp$ unary at odd relative order**
(`rootGroup_eq_top_of_binary_single`). -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, Thm. 18, p. 391 (p = 2, 'only if': a binary and a unary Jordan component at odd relative order)"]
theorem theorem18OnlyIf_of_binary_single (hQ : Q.Nondegenerate) (h2 : (2 : 𝓞 ℚ) ∈ v.asIdeal)
    (γ : GL (Fin n) Fv) (hγ : loc v L.1 = locAct v γ (std v)) {i j k : Fin n} (hij : i ≠ j)
    (horth : ∀ m, m ≠ i → m ≠ j → locGram Q v γ m i = 0 ∧ locGram Q v γ m j = 0)
    (hij0 : locGram Q v γ i j ≠ 0)
    (hi : Valued.v (locGram Q v γ i i) ≤ Valued.v (2 * locGram Q v γ i j))
    (hj : Valued.v (locGram Q v γ j j) ≤ Valued.v (2 * locGram Q v γ i j))
    (hkorth : ∀ m, m ≠ k → locGram Q v γ m k = 0) (m : ℤ)
    (hodd : Valued.v (locGram Q v γ i j * (locGram Q v γ k k / 2)) = exp (2 * m + 1)) :
    Theorem18OnlyIf Q L v hQ :=
  theorem18OnlyIf_of_eq_top hQ
    (rootGroup_eq_top_of_binary_single h2 γ hγ hij horth hij0 hi hj hkorth m hodd)

/-- **Theorem 18, "only if", for the shape of two binary components at odd relative order**
(`rootGroup_eq_top_of_binary_binary`). -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, Thm. 18, p. 391 (p = 2, 'only if': two binary Jordan components at odd relative order)"]
theorem theorem18OnlyIf_of_binary_binary (hQ : Q.Nondegenerate) (h2 : (2 : 𝓞 ℚ) ∈ v.asIdeal)
    (γ : GL (Fin n) Fv) (hγ : loc v L.1 = locAct v γ (std v)) {i j k l : Fin n} (hij : i ≠ j) (hkl : k ≠ l)
    (horth : ∀ m, m ≠ i → m ≠ j → locGram Q v γ m i = 0 ∧ locGram Q v γ m j = 0)
    (hij0 : locGram Q v γ i j ≠ 0)
    (hi : Valued.v (locGram Q v γ i i) ≤ Valued.v (2 * locGram Q v γ i j))
    (hj : Valued.v (locGram Q v γ j j) ≤ Valued.v (2 * locGram Q v γ i j))
    (horth' : ∀ m, m ≠ k → m ≠ l → locGram Q v γ m k = 0 ∧ locGram Q v γ m l = 0)
    (hkl0 : locGram Q v γ k l ≠ 0)
    (hk : Valued.v (locGram Q v γ k k) ≤ Valued.v (2 * locGram Q v γ k l))
    (hl : Valued.v (locGram Q v γ l l) ≤ Valued.v (2 * locGram Q v γ k l)) (m : ℤ)
    (hodd : Valued.v (locGram Q v γ i j * locGram Q v γ k l) = exp (2 * m + 1)) :
    Theorem18OnlyIf Q L v hQ :=
  theorem18OnlyIf_of_eq_top hQ
    (rootGroup_eq_top_of_binary_binary h2 γ hγ hij hkl horth hij0 hi hj horth' hkl0 hk hl m hodd)

