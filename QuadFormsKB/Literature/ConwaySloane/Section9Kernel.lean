/-
# Conway–Sloane, Ch. 15, §§9.2–9.6: spinor operators, the spinor kernel, tractable primes

J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Ch. 15, §§9.2–9.6, pp. 389–393
(`conwaysloane1999`).

**Layer.** Over $\mathbb Q$: a regular form `Q : QuadForm ℚ n`, $n \ge 3$, a lattice $\Lambda$ = `L : Lat ℚ n`, a finite
set $P$ of primes (Conway–Sloane's $\Pi$ without $-1$), and Cassels' groups (Cassels, Ch. 11, §3, formalized in
`Literature/Cassels/Ch11Sec3Group*.lean`): $R = \prod_{p\in P}\mathbb Q_p^\times$ (`CasselsR`), $X = \prod_{p \in P}U_p$
(`casselsX`), $S = \prod_{p\in P}\theta(\Lambda_p)$, $T$, the quotient $G = R/ST$ (`CasselsG`), which acts simply
transitively on the spinor genera of the genus of $\Lambda$ (Cassels, Thm. 3.1), and $Y = X \cap ST$ (`casselsY`).

**Dictionary.** Conway–Sloane name a spinor operator by a sequence $(r_p)_{p \in \Pi}$ of unit square classes (§9.4,
p. 390); the operator acts on spinor genera through Cassels' $G$, and it is in the **spinor kernel** when it acts
trivially, i.e. when its image in $G$ is $1$, i.e. (for a family of units) when it lies in $Y = X \cap ST$
(Cassels (3.35): $G = X/Y$). The coordinate at $-1$ is omitted: $-1$ is always tractable (§9.6, p. 392), and the
operator $\Delta_{-1}(-1)$ of an indefinite form, $(+1, -1, -1, \dots)$, is Cassels' $j$ (`casselsJ`) on the finite
coordinates.
* (37) $\Delta(r) = (r, r, \dots)$ for a rational $r$ prime to $P$: `deltaR` ($=$ Cassels' diagonal embedding);
* (38) $\Delta_p(A) = (p^\alpha, \dots, p^\alpha, a, p^\alpha, \dots)$ for $A = p^\alpha a \in \mathbb Q_p^\times$,
  $a$ a unit, with $a$ in the $p$-th place: `deltaP`;
* $p$-adically automorphous (§9.3, p. 390): $A \in \theta(O^+(\Lambda_p))$, the spinor norms of proper $p$-adically
  integral automorphisms (`localSpinorNormGroup`);
* (39) tractable prime (§9.6, p. 392): $\Delta_p(u)$ is in the spinor kernel for every $p$-adic unit $u$
  (`IsTractable`).

**Proves**
* `mk_deltaP`: in $G$, $\Delta_p(A)$ is the class of the family with $A$ at $p$ and $1$ elsewhere.
* **Theorem 17** (`theorem17`): the spinor kernel $Y$ is generated by the $\Delta_p(A)$, $p \in P$, $A$ $p$-adically
  automorphous, together with $\Delta_{-1}(-1)$ when the form is indefinite (Cassels' Lemma 3.6).
* `isTractable_of_units_mem`: if every $p$-adic unit is $p$-adically automorphous, $p$ is tractable;
  `casselsX_le_of_isTractable`: if every $p \in P$ is tractable, the spinor kernel is everything.
* `mulSingle_neg_one_mem_of_isTractable`: for an indefinite form, if every prime of $P$ other than $p$ is tractable,
  then $\Delta_p(-1)$ is in the spinor kernel (§9.6: $\Delta_{-1}(-1)$ is in the kernel).
-/
import QuadFormsKB.Literature.ConwaySloane.Section9Group

open NumberField IsDedekindDomain WithZero

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.ConwaySloane

open Lattices

attribute [local instance 2000] HeightOneSpectrum.instAlgebraAdicCompletion

open scoped Classical

variable {n : ℕ} (Q : QuadForm ℚ n) (hQ : Q.Nondegenerate) (L : Lat ℚ n)
  (P : Finset (HeightOneSpectrum (𝓞 ℚ)))

/-! ### The spinor operators $\Delta(r)$ and $\Delta_p(A)$ -/

/-- **Conway–Sloane (37)** (§9.4, p. 390): the spinor operator $\Delta(r) = (r, r, \dots)$ of a rational $r$, the
family of the images of $r$ in $\mathbb Q_p$, $p \in P$ (Cassels' diagonal embedding). -/
@[kb "conwaysloane1999" "Ch. 15, §9.4, (37), p. 390"]
def deltaR (r : ℚˣ) : CasselsR P := casselsDiag P r

/-- The prime $p$ as a unit of $\mathbb Q_p$ (the $p$-th coordinate of $\Delta(p)$). -/
def primeUnit (p : P) : (p.1.adicCompletion ℚ)ˣ := casselsDiag P (natGenUnit p.1) p

/-- The exponent $\alpha$ of $A = p^\alpha a$ ($a$ a unit): $\lvert A\rvert_p = e^{-\alpha}$. -/
def ordP (p : P) (A : (p.1.adicCompletion ℚ)ˣ) : ℤ := -WithZero.log (Valued.v (A : p.1.adicCompletion ℚ))

/-- **Conway–Sloane (38)** (§9.4, p. 391): for $A = p^\alpha a$ ($a$ a $p$-adic unit), the spinor operator
$\Delta_p(A)$ whose $p_1$-coordinate is $p^\alpha$ for $p_1 \ne p$ and whose $p$-coordinate is $a$. -/
@[kb "conwaysloane1999" "Ch. 15, §9.4, (38), p. 391"]
def deltaP (p : P) (A : (p.1.adicCompletion ℚ)ˣ) : CasselsR P :=
  Pi.mulSingle p (A * primeUnit P p ^ (-2 * ordP P p A)) * casselsDiag P (natGenUnit p.1 ^ ordP P p A)

theorem deltaP_apply_self (p : P) (A : (p.1.adicCompletion ℚ)ˣ) :
    deltaP P p A p = A * primeUnit P p ^ (-ordP P p A) := by
  simp only [deltaP, Pi.mul_apply, Pi.mulSingle_eq_same, map_zpow]
  rw [show ((casselsDiag P (natGenUnit p.1)) ^ ordP P p A) p = primeUnit P p ^ ordP P p A from rfl, mul_assoc,
    ← zpow_add]
  congr 2; ring

theorem deltaP_apply_ne {p q : P} (h : q ≠ p) (A : (p.1.adicCompletion ℚ)ˣ) :
    deltaP P p A q = casselsDiag P (natGenUnit p.1 ^ ordP P p A) q := by
  classical
  simp only [deltaP, Pi.mul_apply, Pi.mulSingle_eq_of_ne h, one_mul]

theorem valued_primeUnit (p : P) :
    Valued.v ((primeUnit P p : (p.1.adicCompletion ℚ)ˣ) : p.1.adicCompletion ℚ) = exp (-1 : ℤ) := by
  rw [primeUnit, casselsDiag_apply]
  exact valued_natGenUnit_self p.1

theorem ordP_of_unit (p : P) {u : (p.1.adicCompletion ℚ)ˣ} (hu : Valued.v (u : p.1.adicCompletion ℚ) = 1) :
    ordP P p u = 0 := by
  rw [ordP, hu]; simp

/-- For a unit $u$, $\Delta_p(u)$ is the family with $u$ at $p$ and $1$ elsewhere. -/
theorem deltaP_of_unit (p : P) {u : (p.1.adicCompletion ℚ)ˣ} (hu : Valued.v (u : p.1.adicCompletion ℚ) = 1) :
    deltaP P p u = Pi.mulSingle p u := by
  classical
  rw [deltaP, ordP_of_unit P p hu]
  simp

/-- $\Delta_p(A)$ is a family of units. -/
theorem deltaP_mem_casselsX (p : P) (A : (p.1.adicCompletion ℚ)ˣ) : deltaP P p A ∈ casselsX P := by
  classical
  intro q
  by_cases hq : q = p
  · subst hq
    rw [deltaP_apply_self, Units.val_mul, map_mul, Units.val_zpow_eq_zpow_val, map_zpow₀, valued_primeUnit]
    have hA : Valued.v (A : q.1.adicCompletion ℚ) = exp (-ordP P q A) := by
      rw [ordP, neg_neg, exp_log]; exact (Valuation.ne_zero_iff _).mpr A.ne_zero
    rw [hA, ← exp_zsmul, ← exp_add]
    simp
  · rw [deltaP_apply_ne P hq, casselsDiag_apply, Units.val_zpow_eq_zpow_val, map_zpow₀, map_zpow₀,
      algebraMap_adic_eq_rat] at *
    have := valued_natGenUnit_of_ne (v := p.1) (w := q.1) (fun h => hq (Subtype.ext h))
    rw [algebraMap_adic_eq_rat] at this
    rw [this, one_zpow]

/-- In $G$, $\Delta_p(A)$ is the class of the family with $A$ at $p$ and $1$ elsewhere: they differ by a square
($R^2 \subseteq S$) and by $\Delta(p^\alpha) \in T$. -/
theorem mk_deltaP (hn : 3 ≤ n) (p : P) (A : (p.1.adicCompletion ℚ)ˣ) :
    (QuotientGroup.mk (deltaP P p A) : CasselsG Q hQ L P) = QuotientGroup.mk (Pi.mulSingle p A) := by
  rw [eq_comm, QuotientGroup.eq]
  have e0 : A * primeUnit P p ^ (-2 * ordP P p A) = A * (primeUnit P p ^ (-ordP P p A)) ^ 2 := by
    rw [← zpow_natCast, ← zpow_mul]; congr 2; push_cast; ring
  have e : (Pi.mulSingle p A : CasselsR P)⁻¹ * deltaP P p A =
      (Pi.mulSingle p (primeUnit P p ^ (-ordP P p A))) ^ 2 * casselsDiag P (natGenUnit p.1 ^ ordP P p A) := by
    rw [deltaP, e0, Pi.mulSingle_mul, Pi.mulSingle_pow, mul_assoc, inv_mul_cancel_left]
  rw [e]
  refine (casselsST Q hQ L P).mul_mem (Subgroup.mem_sup_left (sq_mem_casselsS Q hQ L P _))
    (Subgroup.mem_sup_right (Subgroup.mem_map.mpr ⟨_, (casselsT Q hQ P).zpow_mem
      (natGenUnit_mem_casselsT hn p) _, rfl⟩))

/-! ### Theorem 17: generators of the spinor kernel -/

/-- The generators of Theorem 17: the $\Delta_p(A)$ with $A$ $p$-adically automorphous, and $\Delta_{-1}(-1)$ (on
the finite coordinates: Cassels' $j$, which is $-1$ for an indefinite and $+1$ for a definite form). -/
def thm17Gens : Set (CasselsR P) :=
  {x | ∃ p : P, ∃ A ∈ localSpinorNormGroup Q hQ p.1 L, x = deltaP P p A} ∪ {casselsDiag P (casselsJ Q)}

theorem mem_casselsST_of_deltaP (hn : 3 ≤ n) (p : P) {A : (p.1.adicCompletion ℚ)ˣ}
    (hA : A ∈ localSpinorNormGroup Q hQ p.1 L) : deltaP P p A ∈ casselsST Q hQ L P := by
  have h := mk_deltaP Q hQ L P hn p A
  rw [eq_comm, QuotientGroup.eq] at h
  have hS : (Pi.mulSingle p A : CasselsR P) ∈ casselsST Q hQ L P :=
    Subgroup.mem_sup_left (mulSingle_mem_casselsS p hA)
  have := (casselsST Q hQ L P).mul_mem hS h
  simpa using this

/-- Families of automorphous units lie in the subgroup generated by the $\Delta_p(u)$. -/
theorem casselsS_inf_casselsX_le_closure :
    casselsS Q hQ L P ⊓ casselsX P ≤ Subgroup.closure (thm17Gens Q hQ L P) := by
  intro x ⟨hS, hX⟩
  rw [← Finset.univ_prod_mulSingle x]
  refine Subgroup.prod_mem _ fun p _ => Subgroup.subset_closure (Or.inl ⟨p, x p, ?_, ?_⟩)
  · have hS' : x ∈ casselsS Q hQ L P := hS
    exact hS' p (Set.mem_univ _)
  · exact (deltaP_of_unit P p (hX p)).symm

/-- A representative of $\theta(a_q)$ of order exactly $1$ at $q$, for $q \in P_1$. -/
theorem exists_c_of_mem_casselsP1 {q : P} (hq : q ∈ casselsP1 Q hQ L P) :
    ∃ c ∈ localSpinorNormGroup Q hQ q.1 L,
      Valued.v ((c : (q.1.adicCompletion ℚ)ˣ) : q.1.adicCompletion ℚ) = exp (-1 : ℤ) := by
  obtain ⟨c0, hc0, m, hm⟩ := hq
  refine ⟨c0 * (primeUnit P q ^ (m + 1)) ^ 2, (localSpinorNormGroup Q hQ q.1 L).mul_mem hc0 (sq_mem_T hQ L _), ?_⟩
  rw [Units.val_mul, Units.val_pow_eq_pow_val, Units.val_zpow_eq_zpow_val, map_mul, map_pow, map_zpow₀,
    valued_primeUnit, hm, ← exp_zsmul, ← exp_nsmul, ← exp_add]
  congr 1; simp; ring

/-- **Conway–Sloane, Theorem 17** (§9.3, p. 390; "obtained by translating Cassels's version, Thm. 3.1 of [Cas3,
Chap. 11] and its corollary"): *the spinor kernel is generated by the spinor operators $\Delta_p(A)$ for which
$p \in \Pi$ and $A$ is a $p$-adically automorphous number.* Here the spinor kernel is Cassels' $Y = X \cap ST$ (the
families of units acting trivially on the spinor genera, Cassels (3.35)), $p$ runs over $P$, and the generator for
$p = -1$ is $\Delta_{-1}(-1) = j$ (for a definite form $-1$ is not $(-1)$-adically automorphous and $j = 1$). Proof:
Cassels' Lemma 3.6 (`casselsY_eq_closure`). -/
@[kb "conwaysloane1999" "Ch. 15, §9.3, Thm. 17, p. 390"]
theorem theorem17 (hn : 3 ≤ n) : casselsY Q hQ L P = Subgroup.closure (thm17Gens Q hQ L P) := by
  have hc : ∀ q : P, ∃ c : (q.1.adicCompletion ℚ)ˣ, q ∈ casselsP1 Q hQ L P →
      c ∈ localSpinorNormGroup Q hQ q.1 L ∧
        Valued.v ((c : (q.1.adicCompletion ℚ)ˣ) : q.1.adicCompletion ℚ) = exp (-1 : ℤ) := by
    intro q
    by_cases hq : q ∈ casselsP1 Q hQ L P
    · obtain ⟨c, h1, h2⟩ := exists_c_of_mem_casselsP1 Q hQ L P hq
      exact ⟨c, fun _ => ⟨h1, h2⟩⟩
    · exact ⟨1, fun h => absurd h hq⟩
  choose c hc using hc
  apply le_antisymm
  · rw [casselsY_eq_closure Q hQ L P hn c (fun q hq => hc q hq), Subgroup.closure_le]
    rintro x ((hx | hx) | ⟨q, hq, rfl⟩)
    · exact casselsS_inf_casselsX_le_closure Q hQ L P hx
    · rw [Set.mem_singleton_iff] at hx
      exact Subgroup.subset_closure (Or.inr hx)
    · obtain ⟨hcθ, hcv⟩ := hc q hq
      set y : CasselsR P := Pi.mulSingle q (primeUnit P q) * (casselsDiag P (natGenUnit q.1))⁻¹ with hy
      have hyX : y ∈ casselsX P := by
        intro r
        by_cases hr : r = q
        · subst hr
          simp only [hy, Pi.mul_apply, Pi.mulSingle_eq_same, Pi.inv_apply]
          rw [show (casselsDiag P (natGenUnit r.1)) r = primeUnit P r from rfl, mul_inv_cancel]
          simp
        · simp only [hy, Pi.mul_apply, Pi.mulSingle_eq_of_ne hr, one_mul, Pi.inv_apply, Units.val_inv_eq_inv_val,
            map_inv₀, casselsDiag_apply]
          have := valued_natGenUnit_of_ne (v := q.1) (w := r.1) (fun h => hr (Subtype.ext h))
          rw [inv_eq_one]
          convert this using 3
      have hord : ordP P q (c q) = 1 := by rw [ordP, hcv]; simp
      have e : casselsSq P q (c q) = deltaP P q (c q) * y ^ 2 := by
        rw [casselsSq, deltaP, hord, hy]
        ext r : 1
        by_cases hr : r = q
        · subst hr
          simp only [Pi.mul_apply, Pi.mulSingle_eq_same, Pi.inv_apply, Pi.pow_apply, zpow_one]
          rw [show (casselsDiag P (natGenUnit r.1)) r = primeUnit P r from rfl]
          group
        · simp only [Pi.mul_apply, Pi.mulSingle_eq_of_ne hr, Pi.inv_apply, Pi.pow_apply, one_mul, zpow_one]
          group
      show casselsSq P q (c q) ∈ _
      rw [e]
      refine Subgroup.mul_mem _ (Subgroup.subset_closure (Or.inl ⟨q, c q, hcθ, rfl⟩))
        (casselsS_inf_casselsX_le_closure Q hQ L P ⟨sq_mem_casselsS Q hQ L P y, (casselsX P).pow_mem hyX 2⟩)
  · rw [Subgroup.closure_le]
    rintro x (⟨p, A, hA, rfl⟩ | hx)
    · exact ⟨deltaP_mem_casselsX P p A, mem_casselsST_of_deltaP Q hQ L P hn p hA⟩
    · rw [Set.mem_singleton_iff] at hx
      subst hx
      refine ⟨casselsDiag_sign_mem_casselsX ?_, Subgroup.mem_sup_right
        (Subgroup.mem_map.mpr ⟨_, casselsJ_mem_casselsT hn, rfl⟩)⟩
      unfold casselsJ; split_ifs <;> simp

/-! ### Tractable primes -/

/-- **Tractable prime** (Conway–Sloane (39), §9.6, p. 392): $p$ is tractable if for every $p$-adic unit $u$ the
spinor operator $\Delta_p(u) = (1, \dots, 1, u, 1, \dots)$ lies in the spinor kernel. -/
@[kb "conwaysloane1999" "Ch. 15, §9.6, (39), p. 392 (tractable prime)"]
def IsTractable (p : P) : Prop :=
  ∀ u : (p.1.adicCompletion ℚ)ˣ, Valued.v (u : p.1.adicCompletion ℚ) = 1 →
    (Pi.mulSingle p u : CasselsR P) ∈ casselsST Q hQ L P

/-- If every $p$-adic unit is $p$-adically automorphous, $p$ is tractable. -/
theorem isTractable_of_units_mem (p : P)
    (h : ∀ u : (p.1.adicCompletion ℚ)ˣ, Valued.v (u : p.1.adicCompletion ℚ) = 1 →
      u ∈ localSpinorNormGroup Q hQ p.1 L) : IsTractable Q hQ L P p :=
  fun u hu => Subgroup.mem_sup_left (mulSingle_mem_casselsS p (h u hu))

/-- If every $p \in P$ is tractable, then every family of units is in the spinor kernel ($Y = X$). -/
theorem casselsX_le_of_isTractable (h : ∀ p : P, IsTractable Q hQ L P p) :
    casselsX P ≤ casselsST Q hQ L P := by
  intro x hx
  rw [← Finset.univ_prod_mulSingle x]
  exact Subgroup.prod_mem _ fun p _ => h p (x p) (hx p)

/-- **$\Delta_p(-1)$ is in the kernel** (§9.6, p. 392: for an indefinite form, $\Delta_{-1}(-1)$ is in the spinor
kernel): for an indefinite form, if every prime of $P$ other than $p$ is tractable, then the family with $-1$ at $p$
and $1$ elsewhere is in the spinor kernel. -/
@[kb "conwaysloane1999" "Ch. 15, §9.6, p. 392 (f indefinite: -1 is (-1)-adically automorphous and Δ_{-1}(-1) is in the kernel)"]
theorem mulSingle_neg_one_mem_of_isTractable (hn : 3 ≤ n) (hind : IsIndefinite Q) (p : P)
    (h : ∀ q : P, q ≠ p → IsTractable Q hQ L P q) :
    (Pi.mulSingle p (-1) : CasselsR P) ∈ casselsST Q hQ L P := by
  have hj : casselsDiag P (-1) ∈ casselsST Q hQ L P := by
    have := casselsJ_mem_casselsT (Q := Q) (hQ := hQ) (P := P) hn
    simp only [casselsJ, hind, ite_true] at this
    exact Subgroup.mem_sup_right (Subgroup.mem_map.mpr ⟨_, this, rfl⟩)
  have e : (Pi.mulSingle p (-1) : CasselsR P) =
      casselsDiag P (-1) * (∏ q ∈ Finset.univ.erase p, Pi.mulSingle q (-1 : (q.1.adicCompletion ℚ)ˣ))⁻¹ := by
    rw [eq_mul_inv_iff_mul_eq, Finset.mul_prod_erase Finset.univ (fun q => (Pi.mulSingle q (-1) : CasselsR P))
      (Finset.mem_univ p)]
    show ∏ x, Pi.mulSingle x ((fun q : P => (-1 : (q.1.adicCompletion ℚ)ˣ)) x) = _
    rw [Finset.univ_prod_mulSingle]
    ext q : 1
    apply Units.ext
    rw [casselsDiag_apply]
    simp
  rw [e]
  refine (casselsST Q hQ L P).mul_mem hj ((casselsST Q hQ L P).inv_mem
    (Subgroup.prod_mem _ fun q hq => h q (Finset.ne_of_mem_erase hq) _ (by simp)))

end QuadFormsKB.ConwaySloane
