/-
# Conway–Sloane, Ch. 15, §9.5: Theorem 18 at $p = 2$ for $L_2 = 2^k(E \perp \langle 2a, 2b\rangle)$, $a + b \equiv 0 \pmod 4$

J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Ch. 15, §9.5, p. 391
(`conwaysloane1999`), Theorem 18, the "only if" direction at $p = 2$, for the $2$-adic Jordan shape "an even
unimodular constituent $E$ of any rank $\ge 1$, followed by an odd binary constituent $2\langle a, b\rangle$ at the next
scale with $a + b \equiv 0 \pmod 4$" (scaled by any $2^k$). In Conway–Sloane's $2$-adic symbols (with the form
$Q(x) = x^{\mathsf T}Mx$) these are e.g. $1^{2}_{II}\,2^{2}_{\ldots}$ with $M = H \perp 2\langle 1, 3\rangle$ or
$E_2 \perp 2\langle 1, 7\rangle$ ($H = \begin{psmallmatrix}0&1\\1&0\end{psmallmatrix}$,
$E_2 = \begin{psmallmatrix}2&1\\1&2\end{psmallmatrix}$). Here the root group is the group of unit classes; the
integral automorphisms need not be generated by integral reflections.

**Layer.** As in `Section9Theorem18DyadicOverlattice.lean`: over $\mathbb Q$ at the prime $v$ over $2$, a basis
$b_k = \gamma e_k$ of $L_2$ with Gram matrix $G$ = `locGram Q v γ` of $B(x, y) = Q(x + y) - Q(x) - Q(y)$
($G_{kk} = 2Q(b_k)$), a scalar $c \ne 0$ and $A = cG$.

**Defines** `IsScaledEvenUnimodularPerpTwoPair Q L v` (the shape): for some basis $\gamma$ of $L_2$, scalar $c$ and
indices $l_1 \ne l_2$: $A$ integral with $A_{kk}/2$ integral; $b_{l_1}$, $b_{l_2}$ orthogonal to all other basis
vectors; $a = A_{l_1l_1}/2$ and $b = A_{l_2l_2}/2$ units with $\lvert a + b\rvert \le \lvert 4\rvert$; and
$\lvert\det A\rvert = \lvert 4\rvert$ (so the complement $E$ of $\{l_1, l_2\}$ is even unimodular for $cB$).

**Proves**
* `det_W`, `W_mulVec`: the basis change $W$ (identity except column $l_1$, which is $\tfrac12(e_{l_1} + e_{l_2})$);
* `pair_congr`: if $a$ is a unit, $\lvert a + b\rvert \le \lvert 4\rvert$, $h_1, h_2$ integral and
  $\lvert ah_1^2 + bh_2^2\rvert \le \lvert 4\rvert$, then $h_1 \equiv h_2 \pmod 2$;
* `pairGlue_canonPred_basis`, `pairGlue_mem_of_canonPred`: the overlattice
  $L^+ = L_2 + \mathbb Z_2\tfrac12(b_{l_1} + b_{l_2})$ (basis $\gamma W$) is exactly the set of $x$ with $2x \in L_2$,
  $cB(x, L_2) \subseteq \mathbb Z_2$ and $cQ(x) \in \mathbb Z_2$ (`CanonPred Q L v 2 c`), so $O(L_2)$ preserves it;
* `pairGlue_gram_integral`, `pairGlue_gram_even`, `pairGlue_gram_det`: $L^+$ with the form $cB$ is even unimodular;
* `evenSpinor_of_pairGlue`: every proper $\sigma \in O(L_2)$ has a spinor norm of even order;
* `units_le_rootGroup_of_pairGlue`: every unit class lies in the root group (rank $\ge 3$);
* `theorem18OnlyIf_of_pairGlue` (**Theorem 18, "only if", at $p = 2$ for this shape**, unconditional).
-/
import QuadFormsKB.Literature.ConwaySloane.Section9Theorem18DyadicOverlattice

open NumberField IsDedekindDomain Matrix WithZero

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.ConwaySloane

open Lattices Wall Levels EvenUnimodular

attribute [local instance 2000] HeightOneSpectrum.instAlgebraAdicCompletion

namespace PairGlue

/-! ### The basis change -/

section Matrices

variable {K : Type*} [Field K] {N : ℕ}

/-- The column $\tfrac12(e_{l_1} + e_{l_2})$. -/
def wvec (l₁ l₂ : Fin N) : Fin N → K := (1 / 2 : K) • (Pi.single l₁ 1 + Pi.single l₂ 1)

/-- The basis change $W$: the identity matrix with column $l_1$ replaced by $\tfrac12(e_{l_1} + e_{l_2})$. -/
def W (l₁ l₂ : Fin N) : Matrix (Fin N) (Fin N) K := (1 : Matrix (Fin N) (Fin N) K).updateCol l₁ (wvec l₁ l₂)

theorem updateCol_mulVec' (M : Matrix (Fin N) (Fin N) K) (j : Fin N) (c y : Fin N → K) :
    (M.updateCol j c) *ᵥ y = M *ᵥ y + y j • (c - fun i => M i j) := by
  ext i
  simp only [mulVec, dotProduct, updateCol_apply, Pi.add_apply, Pi.smul_apply, Pi.sub_apply, smul_eq_mul]
  have : ∀ k, (if k = j then c i else M i k) * y k = M i k * y k + (if k = j then (c i - M i k) * y k else 0) := by
    intro k; split_ifs with h
    · subst h; ring
    · ring
  rw [Finset.sum_congr rfl fun k _ => this k, Finset.sum_add_distrib, Finset.sum_ite_eq' Finset.univ j]
  simp only [Finset.mem_univ, ite_true]
  ring

theorem W_mulVec (l₁ l₂ : Fin N) (y : Fin N → K) :
    W l₁ l₂ *ᵥ y = y + y l₁ • (wvec l₁ l₂ - Pi.single l₁ 1) := by
  rw [W, updateCol_mulVec', one_mulVec]
  congr 2
  ext i
  simp [one_apply, Pi.single_apply, eq_comm]

theorem W_mulVec_apply {l₁ l₂ : Fin N} (hl : l₁ ≠ l₂) (y : Fin N → K) (i : Fin N) :
    (W l₁ l₂ *ᵥ y) i = if i = l₁ then y l₁ / 2 else if i = l₂ then y l₂ + y l₁ / 2 else y i := by
  rw [W_mulVec]
  by_cases h1 : i = l₁
  · subst h1; simp [wvec, Pi.single_apply, hl]; ring
  · by_cases h2 : i = l₂
    · subst h2; simp [wvec, Pi.single_apply, h1, Ne.symm h1]; ring
    · simp [wvec, Pi.single_apply, h1, h2]

theorem W_mulVec_single (l₁ l₂ k : Fin N) :
    W l₁ l₂ *ᵥ (Pi.single k 1 : Fin N → K) = if k = l₁ then wvec l₁ l₂ else Pi.single k 1 := by
  rw [W_mulVec]
  by_cases hk : k = l₁
  · subst hk; simp
  · simp [hk, Pi.single_apply, Ne.symm hk]

theorem det_W {l₁ l₂ : Fin N} (hl : l₁ ≠ l₂) : (W (K := K) l₁ l₂).det = 1 / 2 := by
  have h1 : (1 : Matrix (Fin N) (Fin N) K).updateCol l₁ (Pi.single l₁ 1) = 1 := by
    ext i j
    by_cases hj : j = l₁
    · subst hj; simp [updateCol_apply, one_apply, Pi.single_apply, eq_comm]
    · simp [updateCol_apply, hj]
  have h2 : ((1 : Matrix (Fin N) (Fin N) K).updateCol l₁ (Pi.single l₂ 1)).det = 0 := by
    refine det_zero_of_column_eq hl fun k => ?_
    simp [updateCol_apply, one_apply, Pi.single_apply, Ne.symm hl, eq_comm]
  rw [W, wvec, det_updateCol_smul, det_updateCol_add, h1, h2, det_one]
  ring

end Matrices

/-! ### A valuation lemma -/

section Val

variable {v : HeightOneSpectrum (𝓞 ℚ)}

local notation "Fv" => v.adicCompletion ℚ

/-- **The congruence $h_1 \equiv h_2 \pmod 2$**: if $\lvert a\rvert = 1$, $\lvert a + b\rvert \le \lvert 4\rvert$,
$h_1, h_2$ are integral and $\lvert ah_1^2 + bh_2^2\rvert \le \lvert 4\rvert$, then
$\lvert h_1 - h_2\rvert \le \lvert 2\rvert$. *Proof.* $a(h_1 - h_2)(h_1 + h_2) = (ah_1^2 + bh_2^2) - (a + b)h_2^2$
has absolute value $\le \lvert 4\rvert$; if $\lvert h_1 - h_2\rvert = 1$ then $\lvert h_1 + h_2\rvert < 1$, and
$h_1 - h_2 = 2h_1 - (h_1 + h_2)$ would have absolute value $< 1$. -/
theorem pair_congr (h2 : (2 : 𝓞 ℚ) ∈ v.asIdeal) {a b h₁ h₂ : Fv} (ha : Valued.v a = 1)
    (hab : Valued.v (a + b) ≤ Valued.v (4 : Fv)) (hh₁ : Valued.v h₁ ≤ 1) (hh₂ : Valued.v h₂ ≤ 1)
    (hq : Valued.v (a * h₁ ^ 2 + b * h₂ ^ 2) ≤ Valued.v (4 : Fv)) : Valued.v (h₁ - h₂) ≤ Valued.v (2 : Fv) := by
  have hlt2 := valued_two_lt_one (v := v) h2
  have h4 : Valued.v (4 : Fv) = Valued.v (2 : Fv) * Valued.v (2 : Fv) := by
    rw [← map_mul]; norm_num
  have h4lt : Valued.v (4 : Fv) < 1 := by
    rw [h4]
    calc Valued.v (2 : Fv) * Valued.v (2 : Fv) ≤ Valued.v (2 : Fv) * 1 := mul_le_mul' le_rfl hlt2.le
      _ < 1 := by rw [mul_one]; exact hlt2
  have e : a * ((h₁ - h₂) * (h₁ + h₂)) = (a * h₁ ^ 2 + b * h₂ ^ 2) - (a + b) * h₂ ^ 2 := by ring
  have hprod : Valued.v ((h₁ - h₂) * (h₁ + h₂)) ≤ Valued.v (4 : Fv) := by
    have h' : Valued.v (a * ((h₁ - h₂) * (h₁ + h₂))) ≤ Valued.v (4 : Fv) := by
      rw [e]
      refine Valuation.map_sub_le _ hq ?_
      rw [map_mul, map_pow]
      calc Valued.v (a + b) * Valued.v h₂ ^ 2 ≤ Valued.v (4 : Fv) * 1 :=
            mul_le_mul' hab (pow_le_one' hh₂ 2)
        _ = _ := mul_one _
    rwa [map_mul, ha, one_mul] at h'
  refine valued_le_two_of_lt_one h2 ?_
  by_contra hcon
  have hd1 : Valued.v (h₁ - h₂) = 1 :=
    le_antisymm (Valuation.map_sub_le _ hh₁ hh₂) (not_lt.mp hcon)
  rw [map_mul, hd1, one_mul] at hprod
  have hs : Valued.v (h₁ + h₂) < 1 := lt_of_le_of_lt hprod h4lt
  have h2h : Valued.v (2 * h₁) < 1 := by
    rw [map_mul]
    calc Valued.v (2 : Fv) * Valued.v h₁ ≤ Valued.v (2 : Fv) * 1 := mul_le_mul' le_rfl hh₁
      _ < 1 := by rw [mul_one]; exact hlt2
  have : Valued.v (h₁ - h₂) < 1 := by
    rw [show h₁ - h₂ = 2 * h₁ - (h₁ + h₂) by ring]
    exact valued_sub_lt_one h2h hs
  rw [hd1] at this
  exact lt_irrefl _ this

end Val

/-! ### The overlattice of the shape -/

section Shape

variable {n : ℕ} {Q : QuadForm ℚ n} {L : Lat ℚ n} {v : HeightOneSpectrum (𝓞 ℚ)}

local notation "Fv" => v.adicCompletion ℚ

/-- The hypotheses of the shape, for a fixed basis $\gamma$, scalar $c$ and indices $l_1 \ne l_2$. -/
structure Data (Q : QuadForm ℚ n) (v : HeightOneSpectrum (𝓞 ℚ)) (γ : GL (Fin n) (v.adicCompletion ℚ))
    (c : v.adicCompletion ℚ) (l₁ l₂ : Fin n) : Prop where
  hc : c ≠ 0
  hl : l₁ ≠ l₂
  hint : ∀ i j, Valued.v (c * locGram Q v γ i j) ≤ 1
  heven : ∀ i, Valued.v (c * locGram Q v γ i i / 2) ≤ 1
  hcol₁ : ∀ i, i ≠ l₁ → locGram Q v γ i l₁ = 0
  hcol₂ : ∀ i, i ≠ l₂ → locGram Q v γ i l₂ = 0
  ha : Valued.v (c * locGram Q v γ l₁ l₁ / 2) = 1
  hb : Valued.v (c * locGram Q v γ l₂ l₂ / 2) = 1
  hab : Valued.v (c * (locGram Q v γ l₁ l₁ + locGram Q v γ l₂ l₂) / 2) ≤ Valued.v (4 : v.adicCompletion ℚ)
  hdet : Valued.v (c • locGram Q v γ).det = Valued.v (4 : v.adicCompletion ℚ)

variable {γ : GL (Fin n) (v.adicCompletion ℚ)} {c : v.adicCompletion ℚ} {l₁ l₂ : Fin n}

theorem Data.row₁ (hD : Data Q v γ c l₁ l₂) {j : Fin n} (hj : j ≠ l₁) : locGram Q v γ l₁ j = 0 := by
  rw [locGram_symm']; exact hD.hcol₁ j hj

theorem Data.row₂ (hD : Data Q v γ c l₁ l₂) {j : Fin n} (hj : j ≠ l₂) : locGram Q v γ l₂ j = 0 := by
  rw [locGram_symm']; exact hD.hcol₂ j hj

/-- The basis change as an element of $GL_n(\mathbb Q_2)$. -/
def Wg (hl : l₁ ≠ l₂) : GL (Fin n) Fv :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero (W l₁ l₂) (by rw [det_W hl]; norm_num)

theorem Wg_val (hl : l₁ ≠ l₂) : ((Wg (v := v) hl : GL (Fin n) Fv) : Matrix (Fin n) (Fin n) Fv) = W l₁ l₂ := rfl

/-- The basis $\gamma W$ of $L^+$. -/
def gam (γ : GL (Fin n) Fv) (hl : l₁ ≠ l₂) : GL (Fin n) Fv := γ * Wg hl

theorem gam_val (hl : l₁ ≠ l₂) : (gam γ hl).val = γ.val * W l₁ l₂ := by
  rw [gam, Units.val_mul, Wg_val]

/-- $B(\gamma p, \gamma q) = p^{\mathsf T}Gq$, specialised. -/
theorem gram_gam_apply (hl : l₁ ≠ l₂) (i j : Fin n) :
    locGram Q v (gam γ hl) i j =
      (W l₁ l₂ *ᵥ Pi.single i 1) ⬝ᵥ (locGram Q v γ *ᵥ (W l₁ l₂ *ᵥ Pi.single j 1)) := by
  rw [← locGram_apply_eq, gam_val, ← mulVec_mulVec, ← mulVec_mulVec, qbil_mulVec_locGram]

theorem gram_single_single (i j : Fin n) :
    (Pi.single i 1 : Fin n → Fv) ⬝ᵥ (locGram Q v γ *ᵥ Pi.single j 1) = locGram Q v γ i j := by
  rw [single_dotProduct, one_mul, mulVec_single_one_apply]

theorem gram_vec_single (p : Fin n → Fv) (j : Fin n) :
    p ⬝ᵥ (locGram Q v γ *ᵥ Pi.single j 1) = ∑ i, p i * locGram Q v γ i j := by
  simp only [dotProduct, mulVec_single_one_apply]

/-- The entries of the Gram matrix $G^+ = W^{\mathsf T}GW$ of $L^+$. -/
theorem gram_gam (hD : Data Q v γ c l₁ l₂) (i j : Fin n) :
    locGram Q v (gam γ hD.hl) i j =
      if i = l₁ then (if j = l₁ then (locGram Q v γ l₁ l₁ + locGram Q v γ l₂ l₂) / 4
        else locGram Q v γ l₂ j / 2)
      else (if j = l₁ then locGram Q v γ i l₂ / 2 else locGram Q v γ i j) := by
  have hl := hD.hl
  have h12 : locGram Q v γ l₁ l₂ = 0 := hD.row₁ (Ne.symm hl)
  have h21 : locGram Q v γ l₂ l₁ = 0 := hD.hcol₁ l₂ (Ne.symm hl)
  rw [gram_gam_apply, W_mulVec_single, W_mulVec_single]
  by_cases hi : i = l₁ <;> by_cases hj : j = l₁
  · subst hi hj
    simp only [ite_true, wvec, smul_add, mulVec_add, mulVec_smul, dotProduct_add, add_dotProduct, smul_dotProduct,
      dotProduct_smul, gram_single_single, smul_eq_mul, h12, h21]
    ring
  · subst hi
    simp only [ite_true, hj, ite_false, wvec, smul_add, add_dotProduct, smul_dotProduct, gram_single_single,
      smul_eq_mul, hD.row₁ hj]
    ring
  · subst hj
    simp only [ite_true, hi, ite_false, wvec, smul_add, mulVec_add, mulVec_smul, dotProduct_add, dotProduct_smul,
      gram_single_single, smul_eq_mul, hD.hcol₁ i hi]
    ring
  · simp only [hi, hj, ite_false, gram_single_single]

theorem valued_four_eq (h2 : (2 : 𝓞 ℚ) ∈ v.asIdeal) : Valued.v (4 : Fv) = exp (-2 : ℤ) := by
  rw [show (4 : Fv) = 2 * 2 by norm_num, map_mul, valued_two_dyadic v h2, ← exp_add]; norm_num

/-- $L^+$ with the form $cB$ is integral. -/
theorem pairGlue_gram_integral (h2 : (2 : 𝓞 ℚ) ∈ v.asIdeal) (hD : Data Q v γ c l₁ l₂) (i j : Fin n) :
    Valued.v (c * locGram Q v (gam γ hD.hl) i j) ≤ 1 := by
  have hv2 := valued_two_dyadic v h2
  have hhalf : ∀ x : Fv, c * (x / 2) = c * x / 2 := fun x => by ring
  rw [gram_gam hD]
  by_cases hi : i = l₁ <;> by_cases hj : j = l₁ <;> simp only [hi, hj, ite_true, ite_false]
  · -- $(a + b)/2$
    have e : c * ((locGram Q v γ l₁ l₁ + locGram Q v γ l₂ l₂) / 4) =
        (c * (locGram Q v γ l₁ l₁ + locGram Q v γ l₂ l₂) / 2) / 2 := by ring
    rw [e, map_div₀, div_le_one₀ (by rw [hv2]; exact exp_pos), hv2]
    refine hD.hab.trans ?_
    rw [valued_four_eq h2, exp_le_exp]; norm_num
  · rw [hhalf]
    by_cases hj2 : j = l₂
    · subst hj2; rw [hD.hb]
    · rw [hD.row₂ hj2, mul_zero, zero_div, map_zero]; exact zero_le
  · rw [hhalf]
    by_cases hi2 : i = l₂
    · subst hi2; rw [hD.hb]
    · rw [hD.hcol₂ i hi2, mul_zero, zero_div, map_zero]; exact zero_le
  · exact hD.hint i j

/-- $L^+$ with the form $cB$ is even. -/
theorem pairGlue_gram_even (hD : Data Q v γ c l₁ l₂) (i : Fin n) :
    Valued.v (c * locGram Q v (gam γ hD.hl) i i / 2) ≤ 1 := by
  rw [gram_gam hD]
  by_cases hi : i = l₁
  · subst hi
    simp only [ite_true]
    have e : c * ((locGram Q v γ i i + locGram Q v γ l₂ l₂) / 4) / 2 =
        (c * (locGram Q v γ i i + locGram Q v γ l₂ l₂) / 2) / 4 := by ring
    rw [e, map_div₀]
    have h4 : (0 : ℤᵐ⁰) < Valued.v (4 : Fv) :=
      zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr (by norm_num))
    rw [div_le_one₀ h4]
    exact hD.hab
  · simp only [hi, ite_false]; exact hD.heven i

/-- $L^+$ with the form $cB$ is unimodular: $\det(cG^+) = \tfrac14\det(cG)$. -/
theorem pairGlue_gram_det (h2 : (2 : 𝓞 ℚ) ∈ v.asIdeal) (hD : Data Q v γ c l₁ l₂) :
    Valued.v (c • locGram Q v (gam γ hD.hl)).det = 1 := by
  have hmul : locGram Q v (gam γ hD.hl) = (W l₁ l₂)ᵀ * locGram Q v γ * W l₁ l₂ := by
    rw [gam, locGram_mul, Wg_val]
  have e : (c • locGram Q v (gam γ hD.hl)).det = (1 / 4) * (c • locGram Q v γ).det := by
    rw [hmul, det_smul, det_smul, det_mul, det_mul, det_transpose, det_W hD.hl]; ring
  rw [e, map_mul, hD.hdet, ← map_mul]
  norm_num

/-- **The basis vectors of $L^+$ satisfy the canonical predicate** `CanonPred Q L v 2 c`. -/
theorem pairGlue_canonPred_basis (h2 : (2 : 𝓞 ℚ) ∈ v.asIdeal) (hγ : loc v L.1 = locAct v γ (std v))
    (hD : Data Q v γ c l₁ l₂) (k : Fin n) :
    CanonPred Q L v 2 c ((gam γ hD.hl).val *ᵥ Pi.single k 1) := by
  have hv2 := valued_two_dyadic v h2
  rw [gam_val, ← mulVec_mulVec, W_mulVec_single]
  have hLe : ∀ y ∈ loc v L.1, ∃ e : Fin n → Fv, (∀ i, Valued.v (e i) ≤ 1) ∧ y = γ.val *ᵥ e := by
    intro y hy
    rw [hγ] at hy
    obtain ⟨e, he, rfl⟩ := hy
    exact ⟨e, mem_std_iff.mp he, rfl⟩
  have hGe : ∀ (e : Fin n → Fv) (j : Fin n), (∀ i, Valued.v (e i) ≤ 1) →
      Valued.v (c * (locGram Q v γ *ᵥ e) j) ≤ 1 := by
    intro e j he
    simp only [mulVec, dotProduct, Finset.mul_sum]
    refine valued_sum_le_one _ _ fun i _ => ?_
    rw [← mul_assoc, map_mul]
    exact mul_le_one' (hD.hint j i) (he i)
  by_cases hk : k = l₁
  · subst hk
    simp only [ite_true]
    refine ⟨?_, fun y hy => ?_, ?_⟩
    · rw [← mulVec_smul, wvec, smul_smul, show (2 : Fv) * (1 / 2) = 1 by norm_num, one_smul, hγ]
      exact ⟨_, (std v).add_mem (single_mem_std _ (by simp)) (single_mem_std _ (by simp)), rfl⟩
    · obtain ⟨e, he, rfl⟩ := hLe y hy
      rw [qbil_mulVec_locGram, wvec, smul_dotProduct, add_dotProduct, single_dotProduct, single_dotProduct,
        one_mul, one_mul, smul_eq_mul]
      have e1 : (locGram Q v γ *ᵥ e) k = locGram Q v γ k k * e k := by
        simp only [mulVec, dotProduct]
        rw [Finset.sum_eq_single k (fun i _ hi => by rw [hD.row₁ hi, zero_mul]) (by simp)]
      have e2 : (locGram Q v γ *ᵥ e) l₂ = locGram Q v γ l₂ l₂ * e l₂ := by
        simp only [mulVec, dotProduct]
        rw [Finset.sum_eq_single l₂ (fun i _ hi => by rw [hD.row₂ hi, zero_mul]) (by simp)]
      rw [e1, e2]
      have : c * (1 / 2 * (locGram Q v γ k k * e k + locGram Q v γ l₂ l₂ * e l₂)) =
          (c * locGram Q v γ k k / 2) * e k + (c * locGram Q v γ l₂ l₂ / 2) * e l₂ := by ring
      rw [this]
      refine Valuation.map_add_le _ ?_ ?_
      · rw [map_mul, hD.ha, one_mul]; exact he k
      · rw [map_mul, hD.hb, one_mul]; exact he l₂
    · have hQ2 := two_mul_evalIn_locGram (Q := Q) (v := v) γ (wvec k l₂)
      have hval : (wvec k l₂ : Fin n → Fv) ⬝ᵥ (locGram Q v γ *ᵥ wvec k l₂) =
          (locGram Q v γ k k + locGram Q v γ l₂ l₂) / 4 := by
        have h12 : locGram Q v γ k l₂ = 0 := hD.row₁ (Ne.symm hD.hl)
        have h21 : locGram Q v γ l₂ k = 0 := hD.hcol₁ l₂ (Ne.symm hD.hl)
        simp only [wvec, smul_add, mulVec_add, mulVec_smul, dotProduct_add, add_dotProduct, smul_dotProduct,
          dotProduct_smul, gram_single_single, smul_eq_mul, h12, h21]
        ring
      have e : c * Q.evalIn Fv (γ.val *ᵥ wvec k l₂) =
          (c * (locGram Q v γ k k + locGram Q v γ l₂ l₂) / 2) / 4 := by
        have : Q.evalIn Fv (γ.val *ᵥ wvec k l₂) = (locGram Q v γ k k + locGram Q v γ l₂ l₂) / 8 := by
          rw [hval] at hQ2
          linear_combination hQ2 / 2
        rw [this]; ring
      rw [e, map_div₀]
      have h4 : (0 : ℤᵐ⁰) < Valued.v (4 : Fv) :=
        zero_lt_iff.mpr ((Valuation.ne_zero_iff _).mpr (by norm_num))
      rw [div_le_one₀ h4]
      exact hD.hab
  · simp only [hk, ite_false]
    refine ⟨?_, fun y hy => ?_, ?_⟩
    · have hbk : γ.val *ᵥ Pi.single k 1 ∈ loc v L.1 := by
        rw [hγ]; exact ⟨_, single_mem_std k (by simp), rfl⟩
      rw [two_smul]; exact (loc v L.1).add_mem hbk hbk
    · obtain ⟨e, he, rfl⟩ := hLe y hy
      rw [qbil_mulVec_locGram, single_dotProduct, one_mul]
      exact hGe e k he
    · have h := two_mul_evalIn_locGram (Q := Q) (v := v) γ (Pi.single k 1)
      rw [gram_single_single] at h
      have : c * Q.evalIn Fv (γ.val *ᵥ Pi.single k 1) = c * locGram Q v γ k k / 2 := by
        rw [← h]; ring
      rw [this]; exact hD.heven k

/-- The matrix $A$ with columns $l_1, l_2$ replaced by $e_{l_1}, e_{l_2}$ (the even unimodular block $E$ and an
identity block). -/
def Acirc (A : Matrix (Fin n) (Fin n) Fv) (l₁ l₂ : Fin n) : Matrix (Fin n) (Fin n) Fv :=
  Glue2.colOne (Glue2.colOne A l₁) l₂

theorem Acirc_det (h2 : (2 : 𝓞 ℚ) ∈ v.asIdeal) (hD : Data Q v γ c l₁ l₂) :
    Valued.v (Acirc (c • locGram Q v γ) l₁ l₂).det = 1 := by
  set A := c • locGram Q v γ
  have hv2 := valued_two_dyadic v h2
  have hA1 : ∀ i, i ≠ l₁ → A i l₁ = 0 := fun i hi => by simp [A, hD.hcol₁ i hi]
  have hA2 : ∀ i, i ≠ l₂ → Glue2.colOne A l₁ i l₂ = 0 := fun i hi => by
    simp [Glue2.colOne, updateCol_ne (Ne.symm hD.hl), A, hD.hcol₂ i hi]
  have hd := hD.hdet
  rw [Glue2.det_eq_mul_colOne A l₁ hA1, Glue2.det_eq_mul_colOne _ l₂ hA2] at hd
  have e1 : A l₁ l₁ = 2 * (c * locGram Q v γ l₁ l₁ / 2) := by simp only [A, Matrix.smul_apply, smul_eq_mul]; ring
  have e2 : Glue2.colOne A l₁ l₂ l₂ = 2 * (c * locGram Q v γ l₂ l₂ / 2) := by
    simp only [Glue2.colOne, updateCol_ne (Ne.symm hD.hl), A, Matrix.smul_apply, smul_eq_mul]; ring
  rw [e1, e2] at hd
  simp only [map_mul] at hd
  rw [hD.ha, hD.hb, hv2, valued_four_eq h2] at hd
  try simp only [mul_one] at hd
  rw [← mul_assoc, ← exp_add] at hd
  change Valued.v (Glue2.colOne (Glue2.colOne A l₁) l₂).det = 1
  norm_num at hd
  exact hd

theorem Acirc_integral (hD : Data Q v γ c l₁ l₂) :
    ∀ i j, Valued.v (Acirc (c • locGram Q v γ) l₁ l₂ i j) ≤ 1 :=
  Glue2.colOne_integral _ _ (Glue2.colOne_integral _ _ fun i j => by simpa using hD.hint i j)

/-- **$L^+$ is characterized by the canonical predicate**: every $x$ with $2x \in L_2$, $cB(x, L_2) \subseteq
\mathbb Z_2$ and $cQ(x) \in \mathbb Z_2$ lies in $L^+ = \gamma W\mathbb Z_2^n$. -/
theorem pairGlue_mem_of_canonPred (h2 : (2 : 𝓞 ℚ) ∈ v.asIdeal) (hγ : loc v L.1 = locAct v γ (std v))
    (hD : Data Q v γ c l₁ l₂) (x : Fin n → Fv) (hx : CanonPred Q L v 2 c x) :
    x ∈ locAct v (gam γ hD.hl) (std v) := by
  obtain ⟨hx2, hxB, hxQ⟩ := hx
  set G := locGram Q v γ
  set A := c • G
  set d := (γ⁻¹ : GL (Fin n) Fv).val *ᵥ x with hd
  have hxd : γ.val *ᵥ d = x := by
    rw [hd, mulVec_mulVec, ← Units.val_mul, mul_inv_cancel, Units.val_one, one_mulVec]
  -- (1) $2d$ is integral
  have h2d : ∀ i, Valued.v (2 * d i) ≤ 1 := by
    intro i
    have := ((mem_locAct_std_iff γ _).mp (hγ ▸ hx2)) i
    rwa [mulVec_smul, Pi.smul_apply, smul_eq_mul] at this
  -- (2) $Ad$ is integral
  have hA : Aᵀ = A := by simp only [A, transpose_smul, G, locGram_transpose]
  have hAd : ∀ j, Valued.v ((A *ᵥ d) j) ≤ 1 := by
    intro j
    have hbj : γ.val *ᵥ Pi.single j 1 ∈ loc v L.1 := by rw [hγ]; exact ⟨_, single_mem_std j (by simp), rfl⟩
    have := hxB _ hbj
    rw [← hxd, qbil_mulVec_locGram, gram_vec_single] at this
    have e : (A *ᵥ d) j = c * ∑ i, d i * G i j := by
      simp only [A, mulVec, dotProduct, Matrix.smul_apply, smul_eq_mul, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      have hsym : G j i = G i j := locGram_symm' γ j i
      rw [hsym]; ring
    rw [e]; exact this
  -- (3) the part of $d$ off $\{l_1, l_2\}$ is integral
  set d0 : Fin n → Fv := fun i => if i = l₁ ∨ i = l₂ then 0 else d i with hd0
  have hd0l₁ : d0 l₁ = 0 := by simp [hd0]
  have hd0l₂ : d0 l₂ = 0 := by simp [hd0]
  have hdsplit : d = (d0 + Pi.single l₁ (d l₁)) + Pi.single l₂ (d l₂) := by
    ext i
    by_cases h1 : i = l₁
    · subst h1; simp [hd0, Pi.single_apply, hD.hl]
    · by_cases h2' : i = l₂
      · subst h2'; simp [hd0, Pi.single_apply, h1]
      · simp [hd0, h1, h2']
  have hAd0 : ∀ j, Valued.v ((A *ᵥ d0) j) ≤ 1 := by
    intro j
    by_cases hj1 : j = l₁
    · have : (A *ᵥ d0) j = 0 := by
        simp only [mulVec, dotProduct]
        refine Finset.sum_eq_zero fun i _ => ?_
        by_cases hi : i = l₁
        · rw [hi, hd0l₁, mul_zero]
        · have : A j i = 0 := by
            have h0 : G l₁ i = 0 := hD.row₁ hi
            simp only [A, Matrix.smul_apply, smul_eq_mul]; rw [hj1, h0, mul_zero]
          rw [this, zero_mul]
      rw [this, map_zero]; exact zero_le
    by_cases hj2 : j = l₂
    · have : (A *ᵥ d0) j = 0 := by
        simp only [mulVec, dotProduct]
        refine Finset.sum_eq_zero fun i _ => ?_
        by_cases hi : i = l₂
        · rw [hi, hd0l₂, mul_zero]
        · have : A j i = 0 := by
            have h0 : G l₂ i = 0 := hD.row₂ hi
            simp only [A, Matrix.smul_apply, smul_eq_mul]; rw [hj2, h0, mul_zero]
          rw [this, zero_mul]
      rw [this, map_zero]; exact zero_le
    have hj1' : G j l₁ = 0 := hD.hcol₁ j hj1
    have hj2' : G j l₂ = 0 := hD.hcol₂ j hj2
    have z1 : (A *ᵥ Pi.single l₁ (d l₁)) j = 0 := by
      simp [A, mulVec, dotProduct, Pi.single_apply, hj1']
    have z2 : (A *ᵥ Pi.single l₂ (d l₂)) j = 0 := by
      simp [A, mulVec, dotProduct, Pi.single_apply, hj2']
    have e : (A *ᵥ d) j = (A *ᵥ d0) j := by
      conv_lhs => rw [hdsplit]
      rw [mulVec_add, mulVec_add, Pi.add_apply, Pi.add_apply, z1, z2, add_zero, add_zero]
    rw [← e]; exact hAd j
  have hcirc : Acirc A l₁ l₂ *ᵥ d0 = A *ᵥ d0 := by
    rw [Acirc, Glue2.colOne, updateCol_mulVec', hd0l₂, zero_smul, add_zero, Glue2.colOne, updateCol_mulVec',
      hd0l₁, zero_smul, add_zero]
  have hdet0 : (Acirc A l₁ l₂).det ≠ 0 := by
    intro h0; have := Acirc_det h2 hD; rw [h0, map_zero] at this; exact zero_ne_one this
  have hd0int : ∀ i, Valued.v (d0 i) ≤ 1 := by
    have hinv : (Acirc A l₁ l₂)⁻¹ *ᵥ (Acirc A l₁ l₂ *ᵥ d0) = d0 := by
      rw [mulVec_mulVec, Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hdet0), one_mulVec]
    intro i
    rw [← hinv, hcirc]
    exact mulVec_integral _ _ (Glue.inv_integral _ (Acirc_integral hD) (Acirc_det h2 hD)) hAd0 i
  -- (4) the quadratic condition gives $2d_{l_1} \equiv 2d_{l_2} \pmod 2$
  have hquad : d ⬝ᵥ (G *ᵥ d) = d0 ⬝ᵥ (G *ᵥ d0) + G l₁ l₁ * d l₁ ^ 2 + G l₂ l₂ * d l₂ ^ 2 := by
    have hz2 : ((d0 + Pi.single l₁ (d l₁) : Fin n → Fv)) l₂ = 0 := by simp [hd0l₂, Pi.single_apply, Ne.symm hD.hl]
    conv_lhs => rw [hdsplit]
    rw [dot_gram_split γ hD.hcol₂ _ hz2, dot_gram_split γ hD.hcol₁ _ hd0l₁]
  have hhalf : Valued.v ((d0 ⬝ᵥ (A *ᵥ d0)) / 2) ≤ 1 :=
    valued_half_quad_le_one' A hA (fun i j => by simpa [A] using hD.hint i j)
      (fun i => by simpa [A, mul_div_assoc] using hD.heven i) d0 hd0int
  set a := c * G l₁ l₁ / 2
  set b := c * G l₂ l₂ / 2
  have hcQ : c * Q.evalIn Fv x = (d0 ⬝ᵥ (A *ᵥ d0)) / 2 + (a * d l₁ ^ 2 + b * d l₂ ^ 2) := by
    have h := two_mul_evalIn_locGram (Q := Q) (v := v) γ d
    rw [hxd, hquad] at h
    have hA0 : d0 ⬝ᵥ (A *ᵥ d0) = c * (d0 ⬝ᵥ (G *ᵥ d0)) := by
      simp only [A, smul_mulVec, dotProduct_smul, smul_eq_mul]
    rw [hA0]
    have : Q.evalIn Fv x = (d0 ⬝ᵥ (G *ᵥ d0) + G l₁ l₁ * d l₁ ^ 2 + G l₂ l₂ * d l₂ ^ 2) / 2 := by
      rw [← h]; ring
    rw [this]; ring
  have hab1 : Valued.v (a * d l₁ ^ 2 + b * d l₂ ^ 2) ≤ 1 := by
    have : a * d l₁ ^ 2 + b * d l₂ ^ 2 = c * Q.evalIn Fv x - (d0 ⬝ᵥ (A *ᵥ d0)) / 2 := by rw [hcQ]; ring
    rw [this]; exact Valuation.map_sub_le _ hxQ hhalf
  have hcong : Valued.v (2 * d l₂ - 2 * d l₁) ≤ Valued.v (2 : Fv) := by
    have hab' : Valued.v (b + a) ≤ Valued.v (4 : Fv) := by
      rw [show b + a = c * (G l₁ l₁ + G l₂ l₂) / 2 by simp only [a, b]; ring]; exact hD.hab
    refine pair_congr h2 hD.hb hab' (h2d l₂) (h2d l₁) ?_
    have : b * (2 * d l₂) ^ 2 + a * (2 * d l₁) ^ 2 = 4 * (a * d l₁ ^ 2 + b * d l₂ ^ 2) := by ring
    rw [this, map_mul]
    calc Valued.v (4 : Fv) * Valued.v (a * d l₁ ^ 2 + b * d l₂ ^ 2) ≤ Valued.v (4 : Fv) * 1 :=
          mul_le_mul' le_rfl hab1
      _ = _ := mul_one _
  -- (5) the coordinates in the basis $\gamma W$
  set d' : Fin n → Fv := fun i => if i = l₁ then 2 * d l₁ else if i = l₂ then d l₂ - d l₁ else d i with hd'
  have hd'int : ∀ i, Valued.v (d' i) ≤ 1 := by
    intro i
    by_cases h1 : i = l₁
    · simp only [hd', h1, ite_true]; exact h2d l₁
    · by_cases h2' : i = l₂
      · simp only [hd', h1, h2', hD.hl.symm, ite_true, ite_false]
        have e : d l₂ - d l₁ = (2 * d l₂ - 2 * d l₁) / 2 := by ring
        rw [e, map_div₀, div_le_one₀ (by rw [valued_two_dyadic v h2]; exact exp_pos)]
        exact hcong
      · have := hd0int i
        simp only [hd0, h1, h2', or_self, ite_false] at this
        simp only [hd', h1, h2', ite_false]; exact this
  have hWd' : W l₁ l₂ *ᵥ d' = d := by
    ext i
    rw [W_mulVec_apply hD.hl]
    by_cases h1 : i = l₁
    · subst h1; simp only [hd', ite_true]; ring
    · by_cases h2' : i = l₂
      · subst h2'; simp only [hd', h1, ite_true, ite_false, Ne.symm hD.hl]; ring
      · simp only [hd', h1, h2', ite_false]
  refine ⟨d', mem_std_iff.mpr hd'int, ?_⟩
  show (gam γ hD.hl).val *ᵥ d' = x
  rw [gam_val, ← mulVec_mulVec, hWd', hxd]

/-- **Every proper integral automorphism has a spinor norm of even order**: it preserves $L^+$
(`conj_integral_of_canonPred`), which with the form $cB$ is even unimodular. -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, p. 391 (2-adically automorphous numbers of a scaled E ⊥ ⟨2a, 2b⟩, a + b ≡ 0 mod 4, have even order)"]
theorem evenSpinor_of_pairGlue (hQ : Q.Nondegenerate) (h2 : (2 : 𝓞 ℚ) ∈ v.asIdeal)
    (hγ : loc v L.1 = locAct v γ (std v)) (hD : Data Q v γ c l₁ l₂) (σ : orthGroup Q Fv)
    (hσ : σ ∈ locStabV Q v L) (hσ1 : σ ∈ Tamagawa.soSub Q Fv) : EvenSpinor Q σ :=
  evenSpinor_of_conj_scaledEvenUnimodular hQ (gam γ hD.hl) hD.hc (pairGlue_gram_integral h2 hD)
    (pairGlue_gram_det h2 hD) (pairGlue_gram_even hD) σ hσ1
    (conj_integral_of_canonPred (gam γ hD.hl) (pairGlue_canonPred_basis h2 hγ hD)
      (pairGlue_mem_of_canonPred h2 hγ hD) hσ)

/-- **Every unit class lies in the root group** when there is an index $i_0 \notin \{l_1, l_2\}$: row $i_0$ of the
unimodular block $E$ has a unit entry (`exists_unit_entry` for `Acirc`), and `units_le_rootGroup_of_unit_entry`
applies. -/
theorem units_le_rootGroup_of_pairGlue (h2 : (2 : 𝓞 ℚ) ∈ v.asIdeal) (hγ : loc v L.1 = locAct v γ (std v))
    (hD : Data Q v γ c l₁ l₂) {i0 : Fin n} (hi1 : i0 ≠ l₁) (hi2 : i0 ≠ l₂) :
    ∀ u : Fv, Valued.v u = 1 → sqClassOf u ∈ rootGroup Q L v := by
  obtain ⟨j, hj⟩ := exists_unit_entry (Acirc (c • locGram Q v γ) l₁ l₂) (Acirc_integral hD) (Acirc_det h2 hD) i0
  have hj2 : j ≠ l₂ := by
    rintro rfl
    simp [Acirc, Glue2.colOne, updateCol_apply, Pi.single_apply, hi2] at hj
  have hj1 : j ≠ l₁ := by
    rintro rfl
    simp [Acirc, Glue2.colOne, updateCol_apply, Pi.single_apply, hi1, hD.hl] at hj
  have hj' : Valued.v (c * locGram Q v γ i0 j) = 1 := by
    simpa [Acirc, Glue2.colOne, updateCol_ne hj2, updateCol_ne hj1] using hj
  exact units_le_rootGroup_of_unit_entry h2 γ hγ hD.hc hD.hint hD.heven i0 j hj'

end Shape

end PairGlue

section PairGlueShape

variable {n : ℕ} {Q : QuadForm ℚ n} {L : Lat ℚ n} {v : HeightOneSpectrum (𝓞 ℚ)}

open PairGlue

/-- **The shape $L_2 = 2^k(E \perp \langle 2a, 2b\rangle)$, $a + b \equiv 0 \pmod 4$** (a **condition**): for some
basis $\gamma$ of $L_2$, scalar $c$ and indices $l_1 \ne l_2$ the hypotheses `PairGlue.Data Q v γ c l₁ l₂` hold:
$A = cG$ integral with $A_{kk}/2$ integral, $b_{l_1}, b_{l_2}$ orthogonal to all other basis vectors,
$a = A_{l_1l_1}/2$ and $b = A_{l_2l_2}/2$ units with $\lvert a + b\rvert \le \lvert 4\rvert$, and
$\lvert\det A\rvert = \lvert 4\rvert$. -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, p. 391 (2-adic Jordan shape: an even unimodular constituent and 2⟨a, b⟩ with a + b ≡ 0 mod 4, scaled)"]
def IsScaledEvenUnimodularPerpTwoPair (Q : QuadForm ℚ n) (L : Lat ℚ n) (v : HeightOneSpectrum (𝓞 ℚ)) : Prop :=
  ∃ (γ : GL (Fin n) (v.adicCompletion ℚ)) (c : v.adicCompletion ℚ) (l₁ l₂ : Fin n),
    loc v L.1 = locAct v γ (std v) ∧ Data Q v γ c l₁ l₂

/-- **Theorem 18, "only if", at $p = 2$ for $L_2 = 2^k(E \perp \langle 2a, 2b\rangle)$, $a + b \equiv 0 \pmod 4$**
(Conway–Sloane §9.5, p. 391; unconditional): $\theta(O^+(L_2))$ consists of classes of even order
(`evenSpinor_of_pairGlue`), and these are all in the root group (`units_le_rootGroup_of_pairGlue`); in rank $2$ the
binary case applies. -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, Thm. 18, p. 391 (p = 2, 'only if': L₂ a scaled E ⊥ ⟨2a, 2b⟩ with a + b ≡ 0 mod 4)"]
theorem theorem18OnlyIf_of_pairGlue (hQ : Q.Nondegenerate) (h2 : (2 : 𝓞 ℚ) ∈ v.asIdeal)
    (hshape : IsScaledEvenUnimodularPerpTwoPair Q L v) : Theorem18OnlyIf Q L v hQ := by
  obtain ⟨γ, c, l₁, l₂, hγ, hD⟩ := hshape
  by_cases hn : n = 2
  · exact theorem18OnlyIf_of_binary hQ hn
  have hn3 : 3 ≤ n := by
    have := l₁.isLt; have := l₂.isLt
    have : l₁.val ≠ l₂.val := Fin.val_ne_of_ne hD.hl
    omega
  obtain ⟨i0, hi1, hi2⟩ : ∃ i0 : Fin n, i0 ≠ l₁ ∧ i0 ≠ l₂ := by
    by_contra h
    push Not at h
    have hsub : (Finset.univ : Finset (Fin n)) ⊆ {l₁, l₂} := fun i _ => by
      by_cases hi : i = l₁
      · simp [hi]
      · simp [h i hi]
    have hc := Finset.card_le_card hsub
    rw [Finset.card_univ, Fintype.card_fin] at hc
    have := Finset.card_insert_le l₁ ({l₂} : Finset (Fin n))
    rw [Finset.card_singleton] at this
    omega
  exact theorem18OnlyIf_of_evenSpinor hQ h2 (fun σ hσ hσ1 => evenSpinor_of_pairGlue hQ h2 hγ hD σ hσ hσ1)
    (units_le_rootGroup_of_pairGlue h2 hγ hD hi1 hi2)

end PairGlueShape

end QuadFormsKB.ConwaySloane
