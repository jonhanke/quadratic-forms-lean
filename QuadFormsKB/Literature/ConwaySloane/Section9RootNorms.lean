/-
# Conway–Sloane, Ch. 15, §9.5: norms of root vectors and the algorithm at odd primes

J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Ch. 15, §9.5, pp. 391–392
(`conwaysloane1999`): the algorithm for the $p$-adically automorphous numbers, "which can be justified using
Theorem 18".

**Layer.** As in `Section9Algorithm.lean`: $V_\mathfrak p = F_\mathfrak p^n$ at a finite prime $\mathfrak p \nmid 2$,
a lattice $L$ whose localization has a basis $b_k = \gamma e_k$ (the columns of $\gamma$, `loc v L.1 = locAct v γ
(std v)`) that is orthogonal (the Gram matrix $G = \gamma^tH\gamma$ of $B$ is diagonal, `horth`); then
$G_{kk} = 2Q(b_k)$ and the book's list (I) is $Q(b_0), \dots, Q(b_{n-1})$ (the book's diagonal entries; Conway–Sloane's
$f(x) = xAx^{\mathrm t}$ is $Q$).

**Proves**
* `exists_rootNorm_eq` (Kneser's computation; cf. the proof of O'Meara 92:5, p. 249): for every $p$-adic root vector
  $x$ there are $k$, $t \ne 0$ and a unit $e$ with $Q(x) = t^2Q(b_k)e$; if no other basis vector $b_l$ has
  $\lvert Q(b_l)\rvert_p = \lvert Q(b_k)\rvert_p$ (the Jordan constituent of $b_k$ is $1$-dimensional), $e$ is a square.
* `algorithm_odd_upper` (**the reverse inclusion of the algorithm at odd $p$**): every $p$-adically automorphous number
  lies in any subgroup of square classes that contains the classes $Q(b_k)Q(b_l)$ of all pairs from list (I) and,
  when some two entries have the same absolute value (rule (i): a constituent $f_q$ of dimension $\ge 2$), all unit
  classes.
* `algorithm_odd` (**the algorithm at odd $p$, both directions**): $\theta(O^+(L_\mathfrak p))$ is exactly the group
  generated by these classes (with `algorithm_odd_pairs`, `algorithm_odd_units` for the inclusion "listed numbers are
  automorphous").
-/
import QuadFormsKB.Literature.ConwaySloane.Section9Theorem18Odd
import QuadFormsKB.Literature.ConwaySloane.Section9Algorithm
import QuadFormsKB.Literature.HasseNorm.SquareClasses

open NumberField IsDedekindDomain Matrix WithZero

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.ConwaySloane

open Lattices

section RootNorms

variable {F : Type} [Field F] [NumberField F] {n : ℕ} {Q : QuadForm F n} {v : HeightOneSpectrum (𝓞 F)}

local notation "Fv" => v.adicCompletion F
local notation "𝔬" => v.adicCompletionIntegers F

/-- Membership in $\gamma\,\mathfrak o_\mathfrak p^n$ in coordinates: $z \in \gamma\mathfrak o_\mathfrak p^n$ iff
$\gamma^{-1}z$ has integral entries. -/
theorem mem_locAct_std_iff (γ : GL (Fin n) Fv) (z : Fin n → Fv) :
    z ∈ locAct v γ (std v) ↔ ∀ i, Valued.v (((γ⁻¹ : GL (Fin n) Fv).val *ᵥ z) i) ≤ 1 := by
  rw [← mem_std_iff, mem_locAct]
  constructor
  · rintro ⟨y, hy, rfl⟩
    rwa [mulVec_mulVec, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_mulVec]
  · intro h
    exact ⟨_, h, by rw [mulVec_mulVec, ← Units.val_mul, mul_inv_cancel, Units.val_one, one_mulVec]⟩

/-- $c \cdot (Ge_j) = c_jG_{jj}$ for a diagonal Gram matrix. -/
theorem dotProduct_locGram_single {γ : GL (Fin n) Fv} (horth : ∀ k l, k ≠ l → locGram Q v γ k l = 0)
    (c : Fin n → Fv) (j : Fin n) :
    c ⬝ᵥ (locGram Q v γ *ᵥ Pi.single j 1) = c j * locGram Q v γ j j := by
  rw [dotProduct, Finset.sum_eq_single j]
  · rw [locGram_mulVec_diag horth, Pi.single_eq_same, mul_one]
  · intro l _ hl
    rw [locGram_mulVec_diag horth, Pi.single_eq_of_ne hl, mul_zero, mul_zero]
  · simp

/-- $2Q(\gamma c) = \sum_k c_k^2G_{kk}$ for a diagonal Gram matrix. -/
theorem two_mul_evalIn_diag {γ : GL (Fin n) Fv} (horth : ∀ k l, k ≠ l → locGram Q v γ k l = 0)
    (c : Fin n → Fv) : 2 * Q.evalIn Fv (γ.val *ᵥ c) = ∑ k, c k ^ 2 * locGram Q v γ k k := by
  rw [two_mul_evalIn_locGram, dotProduct]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [locGram_mulVec_diag horth]
  ring

/-- **The root-vector inequalities, any basis**: if $x = \gamma c$ is a $p$-adic root vector ($p$ arbitrary, the
basis $b_j = \gamma e_j$ of $L_\mathfrak p$ arbitrary) then $\lvert B(x, b_j)\rvert\,\lvert c_i\rvert \le
\lvert Q(x)\rvert$ for all $i, j$: the reflection maps $b_j$ to $b_j - \frac{B(x, b_j)}{Q(x)}x \in L_\mathfrak p$. -/
theorem rootVector_ineq_gen (L : Lat F n) {γ : GL (Fin n) Fv} (hγ : loc v L.1 = locAct v γ (std v))
    {c : Fin n → Fv} (hx : IsRootVector Q L v (γ.val *ᵥ c)) (i j : Fin n) :
    Valued.v (c ⬝ᵥ (locGram Q v γ *ᵥ Pi.single j 1)) * Valued.v (c i) ≤
      Valued.v (Q.evalIn Fv (γ.val *ᵥ c)) := by
  obtain ⟨hx0, hxs⟩ := hx
  set x := γ.val *ᵥ c with hxdef
  have hbj : γ.val *ᵥ Pi.single j 1 ∈ loc v L.1 := by
    rw [hγ]; exact ⟨Pi.single j 1, single_mem_std j (by simp), rfl⟩
  have hτ : ((symm Q Fv x : GL (Fin n) Fv) : Matrix (Fin n) (Fin n) Fv) *ᵥ (γ.val *ᵥ Pi.single j 1) ∈ loc v L.1 := by
    have : locAct v (symm Q Fv x : GL (Fin n) Fv) (loc v L.1) = loc v L.1 := hxs
    rw [← this]; exact ⟨_, hbj, rfl⟩
  rw [symm_mulVec_bil Q Fv hx0] at hτ
  have hdiff := (loc v L.1).sub_mem hbj hτ
  rw [sub_sub_cancel] at hdiff
  have hb : qbil Q Fv x (γ.val *ᵥ Pi.single j 1) = c ⬝ᵥ (locGram Q v γ *ᵥ Pi.single j 1) := by
    rw [hxdef, qbil_mulVec_locGram]
  rw [hb, hγ, mem_locAct_std_iff] at hdiff
  have hi := hdiff i
  rw [mulVec_smul, Pi.smul_apply, smul_eq_mul, hxdef, mulVec_mulVec, ← Units.val_mul, inv_mul_cancel,
    Units.val_one, one_mulVec, map_mul, map_div₀] at hi
  have hQ0 : Valued.v (Q.evalIn Fv x) ≠ 0 := (Valuation.ne_zero_iff _).mpr hx0
  rw [div_mul_eq_mul_div, div_le_one₀ (zero_lt_iff.mpr hQ0)] at hi
  exact hi

/-- **The root-vector inequalities**: if $x = \gamma c$ is a $p$-adic root vector then
$\lvert c_jG_{jj}\rvert\,\lvert c_i\rvert \le \lvert Q(x)\rvert$ for all $i, j$ (the reflection maps $b_j$ to
$b_j - \frac{B(x, b_j)}{Q(x)}x \in L_\mathfrak p$, and $B(x, b_j) = c_jG_{jj}$). -/
theorem rootVector_ineq (L : Lat F n) {γ : GL (Fin n) Fv} (hγ : loc v L.1 = locAct v γ (std v))
    (horth : ∀ k l, k ≠ l → locGram Q v γ k l = 0) {c : Fin n → Fv}
    (hx : IsRootVector Q L v (γ.val *ᵥ c)) (i j : Fin n) :
    Valued.v (c j * locGram Q v γ j j) * Valued.v (c i) ≤ Valued.v (Q.evalIn Fv (γ.val *ᵥ c)) := by
  have h := rootVector_ineq_gen L hγ hx i j
  rwa [dotProduct_locGram_single horth] at h

/-- Cancellation in $\mathbb Z_{\le}^{\times 0}$-valued inequalities: if $a w \le T$, $b \le a$ and $b w = T$ with
$w \ne 0$ then $b = a$. -/
theorem eq_of_mul_le_of_le {a b w T : ℤᵐ⁰} (hw : w ≠ 0) (h1 : w * a ≤ T) (h2 : b ≤ a) (h3 : b * w = T) : b = a := by
  have h4 : a * w ≤ b * w := by rw [h3, mul_comm]; exact h1
  have h5 : a ≤ b := (mul_le_mul_iff_left₀ (zero_lt_iff.mpr hw)).mp h4
  exact le_antisymm h2 h5

/-- **Norms of root vectors** (Kneser's computation, the argument of O'Meara 92:5, p. 249; Conway–Sloane's algorithm,
§9.5, p. 391, "can be justified using Theorem 18"): let $\mathfrak p \nmid 2$ and let $b_k = \gamma e_k$ be an
orthogonal basis of $L_\mathfrak p$. For every $p$-adic root vector $x$ there are an index $k$, $t \ne 0$ and a unit
$e$ with $Q(x) = t^2\,Q(b_k)\,e$; if moreover no $b_l$, $l \ne k$, has $\lvert G_{ll}\rvert = \lvert G_{kk}\rvert$
(the Jordan constituent of $b_k$ is $1$-dimensional), then $e$ is a square. -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, pp. 391–392 (algorithm, p odd: norms of root vectors)"]
theorem exists_rootNorm_eq (h2 : (2 : 𝓞 F) ∉ v.asIdeal) (L : Lat F n) {γ : GL (Fin n) Fv}
    (hγ : loc v L.1 = locAct v γ (std v)) (horth : ∀ k l, k ≠ l → locGram Q v γ k l = 0)
    {x : Fin n → Fv} (hx : IsRootVector Q L v x) :
    ∃ k : Fin n, ∃ t : Fv, t ≠ 0 ∧ ∃ e : Fv, Valued.v e = 1 ∧
      Q.evalIn Fv x = t ^ 2 * Q.evalIn Fv (γ.val *ᵥ Pi.single k 1) * e ∧
      ((∀ l, l ≠ k → Valued.v (locGram Q v γ l l) ≠ Valued.v (locGram Q v γ k k)) → IsSquare e) := by
  set c : Fin n → Fv := (γ⁻¹ : GL (Fin n) Fv).val *ᵥ x with hcdef
  have hxc : x = γ.val *ᵥ c := by
    rw [hcdef, mulVec_mulVec, ← Units.val_mul, mul_inv_cancel, Units.val_one, one_mulVec]
  rw [hxc] at hx ⊢
  set G : Fin n → Fv := fun k => locGram Q v γ k k with hG
  have hx0 : Q.evalIn Fv (γ.val *ᵥ c) ≠ 0 := hx.1
  have hv2 : Valued.v (2 : Fv) = 1 := valued_two h2
  have hsum : 2 * Q.evalIn Fv (γ.val *ᵥ c) = ∑ k, c k ^ 2 * G k := two_mul_evalIn_diag horth c
  have hv2Q : Valued.v (2 * Q.evalIn Fv (γ.val *ᵥ c)) = Valued.v (Q.evalIn Fv (γ.val *ᵥ c)) := by
    rw [map_mul, hv2, one_mul]
  have hQ0 : Valued.v (Q.evalIn Fv (γ.val *ᵥ c)) ≠ 0 := (Valuation.ne_zero_iff _).mpr hx0
  have hne : (Finset.univ : Finset (Fin n)).Nonempty := by
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · exfalso
      apply hx0
      have : 2 * Q.evalIn Fv (γ.val *ᵥ c) = 0 := by rw [hsum]; simp
      simpa using this
    · exact ⟨⟨0, hn⟩, Finset.mem_univ _⟩
  obtain ⟨i0, -, hi0⟩ := Finset.exists_max_image Finset.univ (fun i => Valued.v (c i)) hne
  obtain ⟨k, -, hk⟩ := Finset.exists_max_image Finset.univ (fun i => Valued.v (c i ^ 2 * G i)) hne
  set T := Valued.v (c k ^ 2 * G k) with hT
  have hle : Valued.v (Q.evalIn Fv (γ.val *ᵥ c)) ≤ T := by
    rw [← hv2Q, hsum]
    exact Valuation.map_sum_le _ fun i _ => hk i (Finset.mem_univ _)
  have hTj : ∀ j, Valued.v (c j ^ 2 * G j) = Valued.v (c j) * Valued.v (c j * G j) := fun j => by
    rw [← map_mul]; ring_nf
  have hge : T ≤ Valued.v (Q.evalIn Fv (γ.val *ᵥ c)) := by
    rw [hT, hTj k, mul_comm]
    exact (mul_le_mul_right (hi0 k (Finset.mem_univ _)) _).trans (rootVector_ineq L hγ horth hx i0 k)
  have hQT : Valued.v (Q.evalIn Fv (γ.val *ᵥ c)) = T := le_antisymm hle hge
  have hT0 : T ≠ 0 := hQT ▸ hQ0
  have hck : c k ≠ 0 ∧ G k ≠ 0 := by
    have : c k ^ 2 * G k ≠ 0 := (Valuation.ne_zero_iff _).mp hT0
    exact ⟨fun h => this (by simp [h]), fun h => this (by simp [h])⟩
  have hbk : Q.evalIn Fv (γ.val *ᵥ Pi.single k 1) = G k / 2 := evalIn_basis_eq γ k
  set e : Fv := 2 * Q.evalIn Fv (γ.val *ᵥ c) / (c k ^ 2 * G k) with he
  have hck2 : c k ^ 2 * G k ≠ 0 := mul_ne_zero (pow_ne_zero _ hck.1) hck.2
  refine ⟨k, c k, hck.1, e, ?_, ?_, ?_⟩
  · rw [he, map_div₀, hv2Q, hQT, div_self hT0]
  · rw [hbk, he]
    field_simp
    rw [div_self (mul_ne_zero hck.1 hck.2)]
  · intro halone
    -- every term other than the `k`-th is strictly smaller than `T`
    have hM : ∀ j, Valued.v (c j ^ 2 * G j) = T → Valued.v (c j) = Valued.v (c i0) := by
      intro j hj
      have hw : Valued.v (c j * G j) ≠ 0 := by
        intro h0; rw [hTj j, h0, mul_zero] at hj; exact hT0 hj.symm
      refine eq_of_mul_le_of_le hw ?_ (hi0 j (Finset.mem_univ _)) (by rw [← hTj j, hj])
      rw [← hQT]; exact rootVector_ineq L hγ horth hx i0 j
    have hlt : ∀ l ∈ Finset.univ.erase k, Valued.v (c l ^ 2 * G l) < T := by
      intro l hl
      have hlk : l ≠ k := Finset.ne_of_mem_erase hl
      refine lt_of_le_of_ne (hk l (Finset.mem_univ _)) fun heq => halone l hlk ?_
      have h1 := hM l heq
      have h2' := hM k rfl
      have e1 : Valued.v (c l) ^ 2 * Valued.v (G l) = Valued.v (c k) ^ 2 * Valued.v (G k) := by
        rw [← map_pow, ← map_pow, ← map_mul, ← map_mul]; exact heq
      rw [h1, h2'] at e1
      have hM0 : Valued.v (c i0) ^ 2 ≠ 0 := by
        rw [← h2']; exact pow_ne_zero _ ((Valuation.ne_zero_iff _).mpr hck.1)
      exact mul_left_cancel₀ hM0 e1
    set r := ∑ l ∈ Finset.univ.erase k, c l ^ 2 * G l with hr
    have hrT : Valued.v r < T := Valuation.map_sum_lt _ hT0 hlt
    have hsplit : 2 * Q.evalIn Fv (γ.val *ᵥ c) = c k ^ 2 * G k + r := by
      rw [hsum, hr, Finset.add_sum_erase Finset.univ (fun l => c l ^ 2 * G l) (Finset.mem_univ k)]
    have he1 : e - 1 = r / (c k ^ 2 * G k) := by
      rw [he, hsplit, add_div, div_self hck2]; ring
    have h4 : Valued.v (4 : Fv) = 1 := by
      rw [show (4 : Fv) = 2 * 2 by norm_num, map_mul, hv2, one_mul]
    apply HN.isSquare_of_valued_sub_one_lt v e
    rw [h4, he1, map_div₀, ← hT, div_lt_one₀ (zero_lt_iff.mpr hT0)]
    exact hrT

/-- $\theta(r^2a) = \theta(a)$ on square classes of field elements. -/
theorem sqClassOf_sq_mul {K : Type*} [Field K] [CharZero K] {r a : K} (hr : r ≠ 0) (ha : a ≠ 0) :
    sqClassOf (r ^ 2 * a) = sqClassOf a := by
  rw [sqClassOf_mul (pow_ne_zero 2 hr) ha, (sqClassOf_eq_one_iff (pow_ne_zero 2 hr)).mpr ⟨r, sq r⟩, one_mul]

/-- **A pair of root vectors** ($\mathfrak p \nmid 2$, orthogonal basis $b_k = \gamma e_k$): the class of
$Q(x)Q(y)$ lies in every subgroup $H$ of square classes containing the classes $Q(b_k)Q(b_l)$ of list (I) and, when two
entries of list (I) have the same absolute value, all unit classes. -/
theorem sqClassOf_rootPair_mem (h2 : (2 : 𝓞 F) ∉ v.asIdeal) (L : Lat F n) {γ : GL (Fin n) Fv}
    (hγ : loc v L.1 = locAct v γ (std v)) (horth : ∀ k l, k ≠ l → locGram Q v γ k l = 0)
    (H : Subgroup (SqClass Fv))
    (hpair : ∀ k l, sqClassOf (Q.evalIn Fv (γ.val *ᵥ Pi.single k 1) * Q.evalIn Fv (γ.val *ᵥ Pi.single l 1)) ∈ H)
    (hunits : (∃ k l, k ≠ l ∧ Valued.v (Q.evalIn Fv (γ.val *ᵥ Pi.single k 1)) =
        Valued.v (Q.evalIn Fv (γ.val *ᵥ Pi.single l 1))) → ∀ u : Fv, Valued.v u = 1 → sqClassOf u ∈ H)
    {x y : Fin n → Fv} (hx : IsRootVector Q L v x) (hy : IsRootVector Q L v y) :
    sqClassOf (Q.evalIn Fv x * Q.evalIn Fv y) ∈ H := by
  obtain ⟨k, t, ht, e, he, hxe, hek⟩ := exists_rootNorm_eq h2 L hγ horth hx
  obtain ⟨l, s, hs, e', he', hye, hel⟩ := exists_rootNorm_eq h2 L hγ horth hy
  have hv2 : Valued.v (2 : Fv) = 1 := valued_two h2
  have he0 : e ≠ 0 := fun h => by simp [h] at he
  have he'0 : e' ≠ 0 := fun h => by simp [h] at he'
  have hbk : Q.evalIn Fv (γ.val *ᵥ Pi.single k 1) ≠ 0 := fun h => hx.1 (by rw [hxe, h]; ring)
  have hbl : Q.evalIn Fv (γ.val *ᵥ Pi.single l 1) ≠ 0 := fun h => hy.1 (by rw [hye, h]; ring)
  have hprod : Q.evalIn Fv x * Q.evalIn Fv y = (t * s) ^ 2 *
      ((Q.evalIn Fv (γ.val *ᵥ Pi.single k 1) * Q.evalIn Fv (γ.val *ᵥ Pi.single l 1)) * (e * e')) := by
    rw [hxe, hye]; ring
  rw [hprod, sqClassOf_sq_mul (mul_ne_zero ht hs) (mul_ne_zero (mul_ne_zero hbk hbl) (mul_ne_zero he0 he'0)),
    sqClassOf_mul (mul_ne_zero hbk hbl) (mul_ne_zero he0 he'0)]
  refine H.mul_mem (hpair k l) ?_
  -- the unit part
  have hQb : ∀ i j, Valued.v (locGram Q v γ i i) = Valued.v (locGram Q v γ j j) →
      Valued.v (Q.evalIn Fv (γ.val *ᵥ Pi.single i 1)) = Valued.v (Q.evalIn Fv (γ.val *ᵥ Pi.single j 1)) := by
    intro i j hij
    rw [evalIn_basis_eq, evalIn_basis_eq, map_div₀, map_div₀, hij]
  by_cases hsq : IsSquare e ∧ IsSquare e'
  · rw [(sqClassOf_eq_one_iff (mul_ne_zero he0 he'0)).mpr (hsq.1.mul hsq.2)]
    exact H.one_mem
  · have hex : ∃ i j, i ≠ j ∧ Valued.v (Q.evalIn Fv (γ.val *ᵥ Pi.single i 1)) =
        Valued.v (Q.evalIn Fv (γ.val *ᵥ Pi.single j 1)) := by
      by_contra hno
      push Not at hno
      apply hsq
      refine ⟨hek fun i hi heq => hno i k hi (hQb i k heq), hel fun i hi heq => hno i l hi (hQb i l heq)⟩
    exact hunits hex _ (by rw [map_mul, he, he', one_mul])

/-- **The reverse inclusion of Conway–Sloane's algorithm at odd $p$** (§9.5, p. 391: "the group of $p$-adically
automorphous numbers is generated by the $p$-adic square classes of the ratios (or products) of all pairs of numbers
from the total list, supplemented by (i) all $p$-adic units if $p \ge 3$ and $f_q$ has dimension $\ge 2$ for any
$q$"): with an orthogonal basis $b_k = \gamma e_k$ of $L_\mathfrak p$, $\mathfrak p \nmid 2$, every $A \in
\theta(O^+(L_\mathfrak p))$ lies, up to squares, in every subgroup $H$ containing the classes $Q(b_k)Q(b_l)$ and,
when two entries of list (I) have the same absolute value, all unit classes. Proof: Theorem 18 at odd $p$
(`theorem18_odd`) and the norms of root vectors (`exists_rootNorm_eq`). -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, p. 391 (algorithm, p odd: nothing else is automorphous)"]
theorem algorithm_odd_upper (hQ : Q.Nondegenerate) (h2 : (2 : 𝓞 F) ∉ v.asIdeal) (L : Lat F n)
    {γ : GL (Fin n) Fv} (hγ : loc v L.1 = locAct v γ (std v)) (horth : ∀ k l, k ≠ l → locGram Q v γ k l = 0)
    (H : Subgroup (SqClass Fv))
    (hpair : ∀ k l, sqClassOf (Q.evalIn Fv (γ.val *ᵥ Pi.single k 1) * Q.evalIn Fv (γ.val *ᵥ Pi.single l 1)) ∈ H)
    (hunits : (∃ k l, k ≠ l ∧ Valued.v (Q.evalIn Fv (γ.val *ᵥ Pi.single k 1)) =
        Valued.v (Q.evalIn Fv (γ.val *ᵥ Pi.single l 1))) → ∀ u : Fv, Valued.v u = 1 → sqClassOf u ∈ H)
    {A : Fvˣ} (hA : A ∈ localSpinorNormGroup Q hQ v L) : SqClass.mk A ∈ H := by
  obtain ⟨xs, hev, hr, hAx⟩ := (theorem18_odd Q hQ h2 L A).mp hA
  rw [hAx]
  suffices key : ∀ m (xs : List (Fin n → Fv)), xs.length = 2 * m → (∀ x ∈ xs, IsRootVector Q L v x) →
      sqClassOf (valProd Q Fv xs) ∈ H by
    obtain ⟨m, hm⟩ := hev
    exact key m xs (by omega) hr
  intro m
  induction m with
  | zero =>
    intro xs hl _
    obtain rfl : xs = [] := List.length_eq_zero_iff.mp (by omega)
    simp only [valProd, List.map_nil, List.prod_nil, sqClassOf_one]
    exact H.one_mem
  | succ m ih =>
    intro xs hl hr
    match xs, hl with
    | x :: y :: rest, hl =>
      have hrx := hr x (by simp)
      have hry := hr y (by simp)
      have hrest : ∀ z ∈ rest, IsRootVector Q L v z := fun z hz => hr z (by simp [hz])
      have hv0 : valProd Q Fv rest ≠ 0 := valProd_ne_zero Q Fv (fun z hz => (hrest z hz).1)
      have hxy : Q.evalIn Fv x * Q.evalIn Fv y ≠ 0 := mul_ne_zero hrx.1 hry.1
      have e : valProd Q Fv (x :: y :: rest) = (Q.evalIn Fv x * Q.evalIn Fv y) * valProd Q Fv rest := by
        simp only [valProd, List.map_cons, List.prod_cons]; ring
      rw [e, sqClassOf_mul hxy hv0]
      exact H.mul_mem (sqClassOf_rootPair_mem h2 L hγ horth H hpair hunits hrx hry)
        (ih rest (by simp at hl; omega) hrest)

/-- The group generated by the book's list for odd $p$: the classes $Q(b_k)Q(b_l)$ of all pairs from list (I),
together with all unit classes when two entries of list (I) have the same absolute value (rule (i)). -/
def algorithmGroupOdd (γ : GL (Fin n) Fv) (Q : QuadForm F n) : Subgroup (SqClass Fv) :=
  Subgroup.closure ({c | ∃ k l, c = sqClassOf (Q.evalIn Fv (γ.val *ᵥ Pi.single k 1) *
      Q.evalIn Fv (γ.val *ᵥ Pi.single l 1))} ∪
    {c | (∃ k l, k ≠ l ∧ Valued.v (Q.evalIn Fv (γ.val *ᵥ Pi.single k 1)) =
        Valued.v (Q.evalIn Fv (γ.val *ᵥ Pi.single l 1))) ∧ ∃ u : Fv, Valued.v u = 1 ∧ c = sqClassOf u})

/-- **Conway–Sloane's algorithm at odd $p$** (§9.5, p. 391), both directions: for $\mathfrak p \nmid 2$ and an
orthogonal basis $b_k = \gamma e_k$ of $L_\mathfrak p$, $A$ is $p$-adically automorphous if and only if its square
class lies in the group generated by the classes $Q(b_k)Q(b_l)$ (pairs from list (I)) and, if two entries of list (I)
have the same absolute value, all unit classes (`algorithmGroupOdd`). -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, p. 391 (algorithm for the p-adically automorphous numbers, p odd)"]
theorem algorithm_odd (hQ : Q.Nondegenerate) (h2 : (2 : 𝓞 F) ∉ v.asIdeal) (L : Lat F n)
    {γ : GL (Fin n) Fv} (hγ : loc v L.1 = locAct v γ (std v)) (horth : ∀ k l, k ≠ l → locGram Q v γ k l = 0)
    (A : Fvˣ) : A ∈ localSpinorNormGroup Q hQ v L ↔ SqClass.mk A ∈ algorithmGroupOdd γ Q := by
  constructor
  · intro hA
    refine algorithm_odd_upper hQ h2 L hγ horth _ (fun k l => Subgroup.subset_closure (Or.inl ⟨k, l, rfl⟩))
      (fun hex u hu => Subgroup.subset_closure (Or.inr ⟨hex, u, hu, rfl⟩)) hA
  · intro hA
    set Θ : Subgroup (SqClass Fv) :=
      (locStabV Q v L ⊓ Tamagawa.soSub Q Fv).map (spinorNormHom Q Fv hQ) with hΘ
    have hmem : ∀ B : Fvˣ, B ∈ localSpinorNormGroup Q hQ v L ↔ SqClass.mk B ∈ Θ := fun B => Iff.rfl
    have hle : algorithmGroupOdd γ Q ≤ Θ := by
      refine (Subgroup.closure_le _).mpr ?_
      rintro c (⟨k, l, rfl⟩ | ⟨⟨k, l, hkl, heq⟩, u, hu, rfl⟩)
      · have hk0 : Q.evalIn Fv (γ.val *ᵥ Pi.single k 1) ≠ 0 :=
          (isRootVector_diag_basis hQ h2 L γ hγ horth k).1
        have hl0 : Q.evalIn Fv (γ.val *ᵥ Pi.single l 1) ≠ 0 :=
          (isRootVector_diag_basis hQ h2 L γ hγ horth l).1
        have h0 := mul_ne_zero hk0 hl0
        rw [sqClassOf_of_ne_zero h0]
        exact (hmem _).mp (algorithm_odd_pairs hQ h2 L γ hγ horth k l _ rfl)
      · have hu0 : u ≠ 0 := fun h => by simp [h] at hu
        rw [sqClassOf_of_ne_zero hu0]
        exact (hmem _).mp (algorithm_odd_units hQ h2 L γ hγ horth hkl heq _ hu)
    exact (hmem A).mpr (hle hA)

end RootNorms

end QuadFormsKB.ConwaySloane
