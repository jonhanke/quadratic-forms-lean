/-
# Conway–Sloane, Ch. 15, §9.5: the algorithm for the $p$-adically automorphous numbers

J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Ch. 15, §9.5, pp. 391–392
(`conwaysloane1999`).

**The algorithm (p. 391).** For $p \ne 2$ diagonalize $f$ over $\mathbb Z_p$ and list the diagonal entries (list (I)).
The group of $p$-adically automorphous numbers is generated by the $p$-adic square classes of the products of all
pairs of numbers from the list, supplemented by all $p$-adic units if $p \ge 3$ and some Jordan constituent has
dimension $\ge 2$.

**Proved here (the "listed numbers are automorphous" inclusion).**
* `algorithm_odd_pairs`: for odd $p$ and a diagonal basis of $L_p$, every basis vector is a $p$-adic root vector, so
  each product $Q(b_k)Q(b_l)$ is $p$-adically automorphous (Theorem 18, proved direction).
* `algorithm_odd_units`: two diagonal entries of equal absolute value (rule (i)) make every unit automorphous.
* `example_diag_3_16`: the worked example $f = \mathrm{diag}(3, 16)$, $p = 2$ (p. 392): all $2$-adic units are
  $2$-adically automorphous.
* `example_root_vector_I2`: $e_1 + e_2$ is a $2$-adic root vector for $I_2$ (p. 392).

The reverse inclusion (nothing else is automorphous) at odd $p$ is `algorithm_odd_upper`, and the algorithm at odd $p$
in both directions is `algorithm_odd` (`Section9RootNorms.lean`, from Theorem 18 at odd $p$ and Kneser's computation).
-/
import QuadFormsKB.Literature.ConwaySloane.Section9Theorem18
import QuadFormsKB.Literature.ConwaySloane.Section9DyadicPatterns
import QuadFormsKB.Lattices.SpinorGlobal

open NumberField IsDedekindDomain Matrix WithZero

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.ConwaySloane

open Lattices

section Odd

variable {F : Type} [Field F] [NumberField F] {n : ℕ} {Q : QuadForm F n} {v : HeightOneSpectrum (𝓞 F)}

local notation "Fv" => v.adicCompletion F

/-- For a basis $\gamma$ of $L_p$ with Gram matrix $G$: $Q(b_k) = G_{kk}/2$ for $b_k = \gamma e_k$. -/
theorem evalIn_basis_eq (γ : GL (Fin n) Fv) (k : Fin n) :
    Q.evalIn Fv (γ.val *ᵥ Pi.single k 1) = locGram Q v γ k k / 2 := by
  rw [eq_div_iff two_ne_zero, mul_comm, ← qbil_self, locGram_apply_eq]

/-- **Each vector of a diagonal basis is a $p$-adic root vector** ($p$ odd): the reflection in $b_k$ preserves $L_p$
because $\lvert B(b_k, y)\rvert \le \lvert Q(b_k)\rvert$ for all $y \in L_p$. -/
theorem isRootVector_diag_basis (hQ : Q.Nondegenerate) (h2 : (2 : 𝓞 F) ∉ v.asIdeal) (L : Lat F n)
    (γ : GL (Fin n) Fv) (hγ : loc v L.1 = locAct v γ (std v))
    (horth : ∀ k l, k ≠ l → locGram Q v γ k l = 0) (k : Fin n) :
    IsRootVector Q L v (γ.val *ᵥ Pi.single k 1) := by
  have h2ne : (2 : Fv) ≠ 0 := two_ne_zero
  have hk0 := locGram_ne_zero_of_diag hQ horth k
  have hx0 : Q.evalIn Fv (γ.val *ᵥ Pi.single k 1) ≠ 0 := by
    rw [evalIn_basis_eq]; exact div_ne_zero hk0 h2ne
  refine ⟨hx0, ?_⟩
  have hxM : γ.val *ᵥ Pi.single k 1 ∈ loc v L.1 := by
    rw [hγ]; exact ⟨Pi.single k 1, single_mem_std k (by simp), rfl⟩
  show locAct v (symm Q Fv (γ.val *ᵥ Pi.single k 1) : GL (Fin n) Fv) (loc v L.1) = loc v L.1
  refine locAct_symm_eq hxM hx0 fun y hy => ?_
  rw [hγ, mem_locAct] at hy
  obtain ⟨d, hd, rfl⟩ := hy
  rw [qbil_mulVec_locGram, single_dotProduct, one_mul, locGram_mulVec_diag horth, evalIn_basis_eq, map_div₀,
    valued_two h2, div_one, map_mul]
  calc _ ≤ Valued.v (locGram Q v γ k k) * 1 := mul_le_mul' le_rfl (mem_std_iff.mp hd k)
    _ = _ := mul_one _

/-- **Conway–Sloane §9.5, p. 391, algorithm for $p$ odd (the "listed numbers are automorphous" inclusion).**
Let $p$ be an odd prime, $Q$ integral on $L_p$, and $b_0, \dots, b_{n-1}$ a diagonal basis of $L_p$ (the diagonal
entries $Q(b_k)$ form the book's list (I)). Then the product $Q(b_k)Q(b_l)$ of any two entries is
$p$-adically automorphous, i.e. the $p$-adic square class of every pair-product lies in $\theta(O^+(L_p))$. Proof:
each $b_k$ is a $p$-adic root vector (`isRootVector_diag_basis`) and Theorem 18's proved direction applies to
$[b_k, b_l]$. The reverse inclusion (the group is *generated* by these) is Theorem 18 with Kneser's theorem and is not
formalized. -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, p. 391 (algorithm, p odd: the inclusion)"]
theorem algorithm_odd_pairs (hQ : Q.Nondegenerate) (h2 : (2 : 𝓞 F) ∉ v.asIdeal) (L : Lat F n)
    (γ : GL (Fin n) Fv) (hγ : loc v L.1 = locAct v γ (std v))
    (horth : ∀ k l, k ≠ l → locGram Q v γ k l = 0) (k l : Fin n) (A : Fvˣ)
    (hA : (A : Fv) = Q.evalIn Fv (γ.val *ᵥ Pi.single k 1) * Q.evalIn Fv (γ.val *ᵥ Pi.single l 1)) :
    A ∈ localSpinorNormGroup Q hQ v L := by
  have hk := (isRootVector_diag_basis hQ h2 L γ hγ horth k)
  have hl := (isRootVector_diag_basis hQ h2 L γ hγ horth l)
  refine mem_localSpinorNormGroup_of_rootVectors hQ [γ.val *ᵥ Pi.single k 1, γ.val *ᵥ Pi.single l 1] (by simp) ?_ A ?_
  · intro x hx
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl
    exacts [hk, hl]
  · have h0 : (A : Fv) ≠ 0 := A.ne_zero
    have : valProd Q Fv [γ.val *ᵥ Pi.single k 1, γ.val *ᵥ Pi.single l 1] = A := by
      simp [valProd, hA]
    rw [this, sqClassOf_of_ne_zero A.ne_zero]
    exact congrArg SqClass.mk (Units.ext rfl)

/-- **Conway–Sloane §9.5, p. 391, rule (i) for $p$ odd:** if two diagonal entries $Q(b_k), Q(b_l)$, $k \ne l$, of a
diagonal basis of $L_p$ have the same $p$-adic absolute value (e.g. a Jordan constituent of dimension $\ge 2$), then
every $p$-adic unit is $p$-adically automorphous. (Cassels Ch. 11, Lemma 3.7.) -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, p. 391 (algorithm, p odd: all units, rule (i))"]
theorem algorithm_odd_units (hQ : Q.Nondegenerate) (h2 : (2 : 𝓞 F) ∉ v.asIdeal) (L : Lat F n)
    (γ : GL (Fin n) Fv) (hγ : loc v L.1 = locAct v γ (std v))
    (horth : ∀ k l, k ≠ l → locGram Q v γ k l = 0) {k l : Fin n} (hkl : k ≠ l)
    (heq : Valued.v (Q.evalIn Fv (γ.val *ᵥ Pi.single k 1)) = Valued.v (Q.evalIn Fv (γ.val *ᵥ Pi.single l 1)))
    (u : Fvˣ) (hu : Valued.v (u : Fv) = 1) : u ∈ localSpinorNormGroup Q hQ v L := by
  refine units_mem_localSpinorNormGroup_of_orthogonal Q v hQ h2 L γ hγ horth hkl ?_ u hu
  rw [evalIn_basis_eq, evalIn_basis_eq, map_div₀, map_div₀, valued_two h2] at heq
  simpa using heq

end Odd

section Examples

attribute [local instance 2000] HeightOneSpectrum.instAlgebraAdicCompletion

variable {v : HeightOneSpectrum (𝓞 ℚ)}

local notation "Fv" => v.adicCompletion ℚ
local notation "𝔬" => v.adicCompletionIntegers ℚ

theorem hessian_diag_gen {R : Type*} [CommRing R] {n : ℕ} (a : Fin n → R) :
    (QuadForm.diag a).hessian = Matrix.diagonal fun i => 2 * a i := by
  rw [QuadForm.hessian, QuadForm.diag, Matrix.diagonal_transpose, Matrix.diagonal_add]
  congr 1; funext i; ring

theorem evalIn_diag_two_gen (K : Type*) [Field K] [Algebra ℚ K] (a b : ℚ) (x : Fin 2 → K) :
    (QuadForm.diag ![a, b]).evalIn K x = algebraMap ℚ K a * x 0 ^ 2 + algebraMap ℚ K b * x 1 ^ 2 := by
  simp [QuadForm.evalIn, QuadForm.diag, Fin.sum_univ_two, Matrix.diagonal]
  ring

theorem locGram_one_diag (a b : ℚ) (k l : Fin 2) :
    locGram (QuadForm.diag ![a, b]) v 1 k l =
      if k = l then algebraMap ℚ Fv (2 * (![a, b] k)) else 0 := by
  simp only [locGram, hessian_diag_gen, Units.val_one, Matrix.transpose_one, Matrix.one_mul, Matrix.mul_one,
    Matrix.map_apply, Matrix.diagonal_apply]
  split_ifs <;> simp

/-- The standard lattice satisfies the hypothesis `loc v L = locAct v 1 (std v)` (basis $\gamma = 1$). -/
theorem loc_stdLat_eq (v : HeightOneSpectrum (𝓞 ℚ)) :
    loc v (stdLat : Lat ℚ 2).1 = locAct v (1 : GL (Fin 2) (v.adicCompletion ℚ)) (std v) := by
  rw [locAct_one]; exact loc_intVec v

/-- **Conway–Sloane §9.5, p. 392: $e_1 + e_2$ is a $2$-adic root vector for $I_2$.** For $f = x_0^2 + x_1^2$ over
$\mathbb Q$, $L = \mathbb Z^2$ and a place $v \mid 2$, the vector $e_0 + e_1$ (the book's $e_1 + e_2$, shifted to
0-based indices) has norm $Q(e_0 + e_1) = 2 = 2u_1$ and the reflection in it is a $2$-adically integral automorphism of
$f$ (it swaps $e_0 \mapsto -e_1$, $e_1 \mapsto -e_0$). -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, p. 392 (e₁ + e₂ is a 2-adic root vector of I₂)"]
theorem example_root_vector_I2 :
    IsRootVector (QuadForm.diag (![1, 1] : Fin 2 → ℚ)) (stdLat : Lat ℚ 2) v (![1, 1] : Fin 2 → Fv) := by
  have hev : ∀ y : Fin 2 → Fv, (QuadForm.diag (![1, 1] : Fin 2 → ℚ)).evalIn Fv y = y 0 ^ 2 + y 1 ^ 2 := by
    intro y
    have := evalIn_diag_two_gen (Fv) 1 1 y
    simpa using this
  have hx0 : (QuadForm.diag (![1, 1] : Fin 2 → ℚ)).evalIn Fv (![1, 1] : Fin 2 → Fv) = 2 := by
    rw [hev]; simp; norm_num
  have hx0' : (QuadForm.diag (![1, 1] : Fin 2 → ℚ)).evalIn Fv (![1, 1] : Fin 2 → Fv) ≠ 0 :=
    fun h => two_ne_zero (hx0.symm.trans h)
  refine ⟨hx0', ?_⟩
  have hloc : loc v (stdLat : Lat ℚ 2).1 = std v := loc_intVec v
  have hxM : (![1, 1] : Fin 2 → Fv) ∈ loc v (stdLat : Lat ℚ 2).1 := by
    rw [hloc, mem_std_iff]; intro i; fin_cases i <;> simp
  refine locAct_symm_eq hxM hx0' fun y hy => ?_
  rw [hloc, mem_std_iff] at hy
  rw [qbil_eq_polar, hx0, hev, hev]
  have e : ((![1, 1] : Fin 2 → Fv) + y) 0 ^ 2 + ((![1, 1] : Fin 2 → Fv) + y) 1 ^ 2 - 2 -
      ((y 0) ^ 2 + (y 1) ^ 2) = 2 * (y 0 + y 1) := by
    have h0 : ((![1, 1] : Fin 2 → Fv) + y) 0 = 1 + y 0 := by simp
    have h1 : ((![1, 1] : Fin 2 → Fv) + y) 1 = 1 + y 1 := by simp
    rw [h0, h1]; ring
  rw [e, map_mul]
  calc _ ≤ Valued.v (2 : Fv) * 1 := mul_le_mul' le_rfl (Valuation.map_add_le _ (hy 0) (hy 1))
    _ = _ := mul_one _

local notation "Qf" => (QuadForm.diag (![3, 16] : Fin 2 → ℚ))
local notation "Lf" => (stdLat : Lat ℚ 2)

/-- **Conway–Sloane §9.5, p. 392, worked example: $f = \mathrm{diag}(3, 16)$ at $p = 2$.** For the form
$Q = 3x_0^2 + 16x_1^2$ over $\mathbb Q$ (the book's list (I) $= \{3, 16\}$, with $3 = u_3$ and $16 = 16u_1$), the
standard lattice $\mathbb Z^2$ and a place $v \mid 2$, *every $2$-adic unit is $2$-adically automorphous* (the book:
"the $2$-adically automorphous numbers are generated by $16u_1 \cdot u_3 \sim u_3$ and $u_5$, i.e. $u_1, u_3, u_5,
u_7$"). Proof: the root vector $2e_0 + e_1$ of norm $4\cdot 3 + 16 = 28 = 4 \cdot 7$ together with $e_0$ gives a
number $\equiv 5 \pmod 8$ (rule (ii); `five_bin_4`, applied to $f \sim 6\,\langle 1, 2^4 \cdot 3^{-1}\rangle$), and the pair
$e_0, e_1$ gives $Q(e_0)Q(e_1) = 48 = 3 \cdot 4^2 \sim 3$; then `units_of_pair`. -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, p. 392 (example diag(3,16), p = 2)"]
theorem example_diag_3_16 (h2 : (2 : 𝓞 ℚ) ∈ v.asIdeal)
    (hQ : (QuadForm.diag (![3, 16] : Fin 2 → ℚ)).Nondegenerate) (u : Fvˣ) (hu : Valued.v (u : Fv) = 1) :
    u ∈ localSpinorNormGroup (QuadForm.diag (![3, 16] : Fin 2 → ℚ)) hQ v (stdLat : Lat ℚ 2) := by
  have hγ := loc_stdLat_eq v
  -- 3 is a unit of the 2-adic integers, with inverse b
  have h3 : IsUnit (3 : 𝔬) := by
    have := (Rl.natCast (v := v) 3).od_unit h2 (a := ((3 : ℕ) : ZMod 8)) (by decide)
    simpa using this
  obtain ⟨b, hb⟩ := h3.exists_right_inv
  have e3 : ((3 : 𝔬) : Fv) = 3 := by
    have : (3 : 𝔬) = 2 + 1 := by norm_num
    rw [this]; push_cast; rw [coe_two_eq]; norm_num
  have hb' : (3 : Fv) * (b : Fv) = 1 := by
    have := congrArg (fun z : 𝔬 => (z : Fv)) hb
    push_cast at this
    rwa [e3] at this
  have hbu : IsUnit b := IsUnit.of_mul_eq_one (3 : 𝔬) (by rw [mul_comm]; exact hb)
  -- the Gram matrix is diagonal
  have hG : ∀ l m : Fin 2, l ≠ m → (l = 0 ∨ l = 1) → locGram Qf v 1 l m = 0 := fun l m h _ => by
    rw [locGram_one_diag]; simp [h]
  have hg0 : locGram Qf v 1 0 0 = 6 * ((1 : 𝔬) : Fv) := by
    rw [locGram_one_diag]; simp; norm_num
  have hg1 : locGram Qf v 1 1 1 = 6 * (((2 ^ 4 * b : 𝔬)) : Fv) := by
    rw [locGram_one_diag]
    simp only [ite_true]
    push_cast
    simp [coe_two_eq]
    linear_combination (-32 : Fv) * hb'
  have hR : RootPair hQ Lf 1 (2 ^ 4 * b) 0 :=
    rootPair_binary hQ Lf 1 hγ (i := 0) (j := 1) (by decide) hG (w := 6) (by norm_num) hg0 hg1
  obtain ⟨α, hαT, hα5⟩ := five_bin_4 hQ Lf h2 hbu hR
  -- the pair e₀, e₁ gives b ~ 3⁻¹ ~ 3
  obtain ⟨ab, hab1, hab2⟩ := Rl.unit_exists h2 hbu
  have hA0 : Adm (1 : 𝔬) (2 ^ 4 * b) 0 1 0 0 := adm0 h2 1 0 0 r1 (Or.inl rfl) (by bfr)
  have hA1 : Adm (1 : 𝔬) (2 ^ 4 * b) 0 0 1 0 :=
    admm h2 0 1 0 4 hab1 hab2 (by bfr) ⟨0, by ring⟩ ⟨2 * b, by ring⟩ ⟨0, by ring⟩
  have hbT : InT hQ Lf ((1 * b : 𝔬) : Fv) :=
    rp_prod hQ Lf hR hA0 hA1 2 (y := 1) (y' := b) (by unfold Bf; ring)
  have h3T : InT hQ Lf (((3 : 𝔬)) : Fv) := by
    have := (InT.sq_mul_iff hQ Lf (a := ((1 * b : 𝔬) : Fv)) (b := 3) three_ne_zero).mpr hbT
    convert this using 1
    push_cast
    rw [e3]
    linear_combination (-3 : Fv) * hb'
  have r3 : Rl (3 : 𝔬) 3 := by simpa using Rl.natCast (v := v) 3
  exact units_of_pair hQ Lf h2 hαT hα5 h3T (Or.inl r3) u hu

end Examples

end QuadFormsKB.ConwaySloane
