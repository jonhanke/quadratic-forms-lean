import QuadFormsKB.Literature.ConwaySloane.NormedIdeals
import QuadFormsKB.Literature.ConwaySloane.Binary

/-!
# Conway–Sloane, Ch. 15, §3.4: proper classes of forms and normed ideal classes

**Source.** J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Ch. 15, §3.4,
printed p. 365 (bibliography key `conwaysloane1999`; printed page = PDF page of the chapter file $+ 351$). The book
states the correspondence without proof.

**Statement (the book's).** Let $-d$ be squarefree and $\not\equiv 1 \pmod 4$ (`SquarefreeDet d`). The proper
(determinant $+1$) equivalence classes of properly primitive forms $ax^2 + 2bxy + cy^2$ of determinant
$ac - b^2 = d$ correspond to the normed ideal classes (`NormedIdeals.lean`) via
$$f \longmapsto \langle a,\ -b + \sqrt{-d}\rangle_a ,$$
the normed ideal whose ideal is generated by $a$ and $-b + \sqrt{-d}$ and whose signed norm is $a$ (`formNormed`).

**Formalization.** Forms are the book's `Binary.BinForm` (`BinForm.det`, `ProperEquiv` from
`ConwaySloane/Binary.lean`); `toBinQF` sends $a^{b}c$ to the library form $(a, 2b, c)$ of discriminant $-4d$
(`disc_toBinQF`), and `properEquiv_iff_sLEquiv` identifies the book's proper equivalence $B = MAM^{\mathrm t}$,
$\det M = 1$, with the library's $\mathrm{SL}_2(\mathbb{Z})$-equivalence `Binary.SLEquiv`. The book's ideal
$\langle a, -b + \sqrt{-d}\rangle$ is the library's $\mathfrak a_f$ (`bookIdeal_eq_formIdeal`).

**Proved (for every such $d$, definite or indefinite).**
* Every form of determinant $d$ is properly primitive ($\gcd(a, 2b, c) = 1$, `isPrimitive_toBinQF`) and has
  $a \ne 0$ (`a_ne_zero`), so $\langle a, -b+\sqrt{-d}\rangle_a$ is a normed ideal (its norm is $\lvert a\rvert$).
* **Comparison with oriented bases** (`NormedIdeal.exists_orientedBasis`, `classCon_of_isFormOf`): a normed ideal
  $\mathcal I_N$ has a $\mathbb{Z}$-basis $(\alpha, \beta)$ of oriented index $\operatorname{odet}(\alpha, \beta) = N$, i.e.
  the sign of $N$ is the orientation of the basis used by the library (`Binary.IsFormOf`); the form
  $N(x\alpha + y\beta)/N$ of such a basis is a form of discriminant $-4d$ whose normed ideal is in the class of
  $\mathcal I_N$.
* **The correspondence** `formClassEquiv`: $f \mapsto [\langle a, -b+\sqrt{-d}\rangle_a]$ is a well-defined bijection
  from the proper classes of forms of determinant $d$ onto the normed ideal class group (`formClass_eq_iff`:
  properly equivalent iff same normed class; `formClass_surjective`).
* The worked example of (13) on p. 365 for $d = -7$: $\langle 3, -2+\sqrt7\rangle_3^2 = \langle 9, -5+\sqrt7\rangle_9$
  as normed ideals (`det7_normed_square`).

The book's composition of forms ("pass to normed ideals, multiply by (13), reduce") is, by this bijection, the
transport of the group structure of `NormedClassGroup d`; comparison with Gauss composition is not formalized here.
-/

open QuadraticAlgebra
open QuadFormsKB.Binary (QOrder qa qb odet IsQuadDisc formIdeal fα fβ kf IsFormOf SLEquiv)

set_option linter.unusedSectionVars false

namespace QuadFormsKB.ConwaySloane

variable {d : ℤ}

/-! ### Book forms as library forms -/

/-- **The library form of $a^{b}c$:** $ax^2 + 2bxy + cy^2$ as the `BinQF` with coefficients $(a, 2b, c)$. -/
def toBinQF (f : Binary.BinForm) : BinQF := BinQF.mk f.a (2 * f.b) f.c

@[simp] theorem toBinQF_a (f : Binary.BinForm) : (toBinQF f).a = f.a := by simp [toBinQF]
@[simp] theorem toBinQF_b (f : Binary.BinForm) : (toBinQF f).b = 2 * f.b := by simp [toBinQF]
@[simp] theorem toBinQF_c (f : Binary.BinForm) : (toBinQF f).c = f.c := by simp [toBinQF]

/-- The discriminant of $(a, 2b, c)$ is $-4d$, $d = ac - b^2$. -/
theorem disc_toBinQF (f : Binary.BinForm) : (toBinQF f).disc = 4 * -f.det := by
  simp [BinQF.disc, Binary.BinForm.det]; ring

/-- **The book's proper equivalence is the library's $\mathrm{SL}_2(\mathbb{Z})$-equivalence:** $B = MAM^{\mathrm t}$ with
$\det M = 1$ (Ch. 15, (4), p. 356) iff $(a', 2b', c') = (a, 2b, c) \circ M^{\mathrm t}$. -/
theorem properEquiv_iff_sLEquiv (f g : Binary.BinForm) :
    Binary.ProperEquiv f g ↔ SLEquiv (toBinQF f) (toBinQF g) := by
  rw [Binary.sLEquiv_iff]
  constructor
  · rintro ⟨M, hM, hg⟩
    have e00 := congrFun (congrFun hg 0) 0
    have e01 := congrFun (congrFun hg 0) 1
    have e11 := congrFun (congrFun hg 1) 1
    simp [Binary.BinForm.gram, Matrix.mul_apply, Fin.sum_univ_two] at e00 e01 e11
    rw [Matrix.det_fin_two] at hM
    refine ⟨M 0 0, M 1 0, M 0 1, M 1 1, by linarith, BinQF.ext_abc ?_ ?_ ?_⟩
    · simp; linarith
    · simp; linarith
    · simp; linarith
  · rintro ⟨p, q, r, s, hd, hsub⟩
    have ha := congrArg BinQF.a hsub
    have hb := congrArg BinQF.b hsub
    have hc := congrArg BinQF.c hsub
    simp at ha hb hc
    refine ⟨!![p, r; q, s], by rw [Matrix.det_fin_two_of]; linarith, ?_⟩
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Binary.BinForm.gram, Matrix.mul_apply, Fin.sum_univ_two] <;> linarith

variable [SquarefreeDet d]

/-- A library form of discriminant $-4d$ has $a \ne 0$ ($-4d$ is not a square). -/
theorem a_ne_zero_of_disc {g : BinQF} (hg : g.disc = 4 * -d) : g.a ≠ 0 := by
  intro ha
  apply Binary.not_isSquare_of_isQuadDisc (D := 4 * -d)
  rw [← hg, BinQF.disc, ha]
  exact ⟨g.b, by ring⟩

/-- **Forms of determinant $d$ have $a \ne 0$.** -/
theorem a_ne_zero {f : Binary.BinForm} (hf : f.det = d) : f.a ≠ 0 := by
  have := a_ne_zero_of_disc (d := d) (g := toBinQF f) (by rw [disc_toBinQF, hf])
  simpa using this

/-- **Forms of determinant $d$ are properly primitive** (Ch. 15, §3.4, p. 364): $\gcd(a, 2b, c) = 1$, because $-4d$ is a
fundamental discriminant (`Binary.isPrimitive_of_fund`). So the book's restriction to properly primitive forms is
automatic here. -/
@[kb "conwaysloane1999" "Ch. 15, §3.4, p. 364"]
theorem isPrimitive_toBinQF {f : Binary.BinForm} (hf : f.det = d) : (toBinQF f).IsPrimitive :=
  Binary.isPrimitive_of_fund (IsQuadDisc.fund (D := 4 * -d)) (by rw [disc_toBinQF, hf])

/-! ### The normed ideal of a form -/

/-- **The normed ideal of a library form** $g = (a, b, c)$ of discriminant $-4d$: $(\mathfrak a_g)_a$, with
$N(\mathfrak a_g) = \lvert a\rvert$ (`Binary.absNorm_formIdeal`). -/
noncomputable def ofForm (g : BinQF) (hg : g.disc = 4 * -d) : NormedIdeal d :=
  ⟨formIdeal _ g, g.a, (Binary.absNorm_formIdeal hg (a_ne_zero_of_disc hg)).symm, a_ne_zero_of_disc hg⟩

/-- **The book's ideal** $\langle a,\ -b + \sqrt{-d}\rangle$ of $a^{b}c$ (Ch. 15, §3.4, p. 365): generated by $a$ and
$-b + \sqrt{-d}$ (`⟨-b, 1⟩`). -/
@[kb "conwaysloane1999" "Ch. 15, §3.4, p. 365"]
def bookIdeal (d : ℤ) (f : Binary.BinForm) : Ideal (SqrtRing d) :=
  Ideal.span {(f.a : SqrtRing d), (⟨-f.b, 1⟩ : SqrtRing d)}

omit [SquarefreeDet d] in
/-- **The book's ideal is the library's $\mathfrak a_f$:** $\langle a, -b+\sqrt{-d}\rangle = \langle a, b - \sqrt{-d}\rangle
= \mathfrak a_{(a, 2b, c)}$ (here $k_f = b$). -/
theorem bookIdeal_eq_formIdeal (f : Binary.BinForm) : bookIdeal d f = formIdeal _ (toBinQF f) := by
  have hk : kf (4 * -d) (toBinQF f) = f.b := by
    unfold kf; rw [qb_eq, toBinQF_b]; omega
  have h1 : (f.a : SqrtRing d) = fα _ (toBinQF f) := by ext <;> simp [fα]
  have h2 : (⟨-f.b, 1⟩ : SqrtRing d) = -fβ _ (toBinQF f) := by
    rw [show fβ (4 * -d) (toBinQF f) = ⟨f.b, -1⟩ by simp only [fβ, hk]]
    ext <;> simp
  unfold bookIdeal formIdeal
  rw [Ideal.span_insert, Ideal.span_insert, h1, h2, Ideal.span_singleton_neg]

/-- **The normed ideal $\langle a, -b + \sqrt{-d}\rangle_a$ corresponding to $f$** (Ch. 15, §3.4, p. 365): the ideal
`bookIdeal d f` with the signed norm $a$ (its norm is $\lvert a\rvert$). -/
@[kb "conwaysloane1999" "Ch. 15, §3.4, p. 365"]
noncomputable def formNormed (f : Binary.BinForm) (hf : f.det = d) : NormedIdeal d :=
  ⟨bookIdeal d f, f.a, by
      rw [bookIdeal_eq_formIdeal, Binary.absNorm_formIdeal (by rw [disc_toBinQF, hf]) (by simpa using a_ne_zero hf),
        toBinQF_a],
    a_ne_zero hf⟩

theorem formNormed_eq_ofForm (f : Binary.BinForm) (hf : f.det = d) :
    formNormed f hf = ofForm (toBinQF f) (by rw [disc_toBinQF, hf]) :=
  NormedIdeal.ext (bookIdeal_eq_formIdeal f) (by simp [formNormed, ofForm])

/-! ### Normed ideals and oriented bases -/

/-- **An oriented basis of a normed ideal and its form are in the class:** if $(\alpha, \beta)$ is a $\mathbb{Z}$-basis of
$\mathcal I$ with oriented index $\operatorname{odet}(\alpha, \beta) = N$ and $g$ (discriminant $-4d$) is its form,
$N g(x, y) = N(x\alpha + y\beta)$, then $\mathcal I_N \sim (\mathfrak a_g)_{g_a}$. *Proof:*
$(\alpha)\,\mathfrak a_g = (g_a)\,\mathcal I$ (`Binary.span_mul_formIdeal`) and $N(\alpha) = N g_a$, so
$\mathcal I_N \langle g_a\rangle_{g_a^2} = (\mathfrak a_g)_{g_a}\langle\alpha\rangle_{N(\alpha)}$. -/
@[kb "conwaysloane1999" "Ch. 15, §3.4, p. 365"]
theorem classCon_of_isFormOf (I : NormedIdeal d) {g : BinQF} (hg : g.disc = 4 * -d) {α β : SqrtRing d}
    (hb : ∀ z, z ∈ I.ideal ↔ ∃ x y : ℤ, z = x • α + y • β) (hn : odet α β = I.norm) (h : IsFormOf g α β) :
    NormedIdeal.classCon d I (ofForm g hg) := by
  have hn0 : odet α β ≠ 0 := hn ▸ I.norm_ne_zero
  have ga := a_ne_zero_of_disc hg
  have key := Binary.span_mul_formIdeal hg ga h hn0 I.ideal hb
  have hα := Binary.ne_zero_of_odet hn0
  have hNα := h.coeffs.1
  have hga : (g.a : SqrtRing d) ≠ 0 := by exact_mod_cast ga
  refine ⟨NormedIdeal.principal _ hga, NormedIdeal.principal_mem _ hga,
    NormedIdeal.principal α hα, NormedIdeal.principal_mem _ hα, NormedIdeal.ext ?_ ?_⟩
  · simp only [NormedIdeal.mul_ideal, NormedIdeal.principal_ideal, ofForm]
    rw [mul_comm I.ideal, ← key, mul_comm (Ideal.span {α})]
  · simp only [NormedIdeal.mul_norm, NormedIdeal.principal_norm, ofForm, norm_intCast, Int.cast_id]
    rw [← hNα, hn]; ring

/-- **Normed ideals are oriented ideals** (Ch. 15, §3.4, p. 364; comparison with the library's `Binary.IsFormOf`):
every normed ideal $\mathcal I_N$ has a $\mathbb{Z}$-basis $(\alpha, \beta)$ with oriented index
$\operatorname{odet}(\alpha, \beta) = N$ (the sign of $N$ picks the orientation; $\lvert N\rvert$ is the index), and the form
of this basis, $g(x, y) = N(x\alpha + y\beta)/N$, is an integral form of discriminant $-4d$. -/
@[kb "conwaysloane1999" "Ch. 15, §3.4, p. 364"]
theorem NormedIdeal.exists_orientedBasis (I : NormedIdeal d) :
    ∃ α β : SqrtRing d, (∀ z, z ∈ I.ideal ↔ ∃ x y : ℤ, z = x • α + y • β) ∧ odet α β = I.norm ∧
      ∃ g : BinQF, g.disc = 4 * -d ∧ IsFormOf g α β := by
  obtain ⟨α, β, hb, hn⟩ := exists_basis I.ideal I.ideal_ne_bot
  have habs := absNorm_eq_natAbs_odet I.ideal hb hn
  have e : α.re * β.im - α.im * β.re = -odet α β := by simp only [odet]; ring
  rw [e, Int.natAbs_neg, ← I.natAbs_norm] at habs
  rcases Int.natAbs_eq_natAbs_iff.mp habs with h | h
  · obtain ⟨g, hg, hgf⟩ := Binary.exists_isFormOf I.ideal I.ideal_ne_bot hb hn
    exact ⟨α, β, hb, h.symm, g, hgf, hg⟩
  · have hb' : ∀ z, z ∈ I.ideal ↔ ∃ x y : ℤ, z = x • β + y • α := fun z => by
      rw [hb]
      exact ⟨fun ⟨x, y, h⟩ => ⟨y, x, by rw [h, add_comm]⟩, fun ⟨x, y, h⟩ => ⟨y, x, by rw [h, add_comm]⟩⟩
    have hswap : odet β α = -odet α β := by simp only [odet]; ring
    have hn' : odet β α ≠ 0 := by rw [hswap]; exact neg_ne_zero.mpr hn
    obtain ⟨g, hg, hgf⟩ := Binary.exists_isFormOf I.ideal I.ideal_ne_bot hb' hn'
    exact ⟨β, α, hb', by rw [hswap, h], g, hgf, hg⟩

/-- **Every normed ideal class contains the normed ideal of a form** of discriminant $-4d$ (`exists_orientedBasis`
and `classCon_of_isFormOf`). -/
theorem exists_classCon_ofForm (I : NormedIdeal d) :
    ∃ (g : BinQF) (hg : g.disc = 4 * -d), NormedIdeal.classCon d I (ofForm g hg) := by
  obtain ⟨α, β, hb, hn, g, hg, h⟩ := I.exists_orientedBasis
  exact ⟨g, hg, classCon_of_isFormOf I hg hb hn h⟩

/-- **Properly equivalent forms give the same normed ideal class:** if $g' = g \circ \gamma$ with $\det\gamma = 1$, the
basis $\gamma$-transform of $(a, k_g - \omega)$ of $\mathfrak a_g$ has oriented index $g_a$ and form $g'$. -/
theorem classCon_ofForm_of_sLEquiv {g g' : BinQF} (hg : g.disc = 4 * -d) (hg' : g'.disc = 4 * -d)
    (h : SLEquiv g g') : NormedIdeal.classCon d (ofForm g hg) (ofForm g' hg') := by
  obtain ⟨p, q, r, s, hd, hsub⟩ := (Binary.sLEquiv_iff _ _).mp h
  have hf := (Binary.isFormOf_formIdeal hg).subst hd
  rw [hsub] at hf
  refine classCon_of_isFormOf (ofForm g hg) hg' (fun z => ?_) ?_ hf
  · simp only [ofForm]
    rw [Binary.mem_formIdeal_iff_exists hg, Binary.lattice_eq_of_det hd]
  · rw [Binary.odet_comb, hd, one_mul, Binary.odet_fα_fβ hg]; rfl

/-- **Forms with the same normed ideal class are properly equivalent:** from
$(\mathfrak a_g)_{g_a}\langle x\rangle = (\mathfrak a_{g'})_{g'_a}\langle y\rangle$, the bases $(x a, x(k_g - \omega))$ and
$(y a', y(k_{g'} - \omega))$ span one lattice and have the same oriented index $N(x) g_a = N(y) g'_a$ (the norm
part of the equation), so they differ by $\mathrm{SL}_2(\mathbb{Z})$ and their forms $g$, $g'$ are properly
equivalent. This is where the sign of the norm matters: without it only $\mathrm{GL}_2(\mathbb{Z})$-equivalence
would follow for $d < 0$. -/
theorem sLEquiv_of_classCon {g g' : BinQF} (hg : g.disc = 4 * -d) (hg' : g'.disc = 4 * -d)
    (h : NormedIdeal.classCon d (ofForm g hg) (ofForm g' hg')) : SLEquiv g g' := by
  obtain ⟨_, ⟨x, hx, rfl⟩, _, ⟨y, hy, rfl⟩, h⟩ := h
  have hI := congrArg NormedIdeal.ideal h
  have hN := congrArg NormedIdeal.norm h
  simp only [NormedIdeal.mul_ideal, NormedIdeal.mul_norm, NormedIdeal.principal_ideal,
    NormedIdeal.principal_norm, ofForm] at hI hN
  have hf := (Binary.isFormOf_formIdeal hg).mul x
  have hf' := (Binary.isFormOf_formIdeal hg').mul y
  have hlat : ∀ z, (∃ u v : ℤ, z = u • (x * fα _ g) + v • (x * fβ _ g)) ↔
      (∃ u v : ℤ, z = u • (y * fα _ g') + v • (y * fβ _ g')) := fun z => by
    rw [← Binary.mem_span_mul_formIdeal_iff hg, ← Binary.mem_span_mul_formIdeal_iff hg',
      mul_comm (Ideal.span {x}), hI, mul_comm _ (Ideal.span {y})]
  have hn : odet (x * fα _ g) (x * fβ _ g) = QuadraticAlgebra.norm x * g.a := by
    rw [Binary.odet_mul, Binary.odet_fα_fβ hg]
  have hn' : odet (y * fα _ g') (y * fβ _ g') = QuadraticAlgebra.norm y * g'.a := by
    rw [Binary.odet_mul, Binary.odet_fα_fβ hg']
  have hne : odet (x * fα _ g) (x * fβ _ g) ≠ 0 := by
    rw [hn]; exact mul_ne_zero (Binary.norm_ne_zero hx) (a_ne_zero_of_disc hg)
  obtain ⟨p, q, r, s, h1, h2, e, hd⟩ := Binary.exists_basis_change hlat hne
  have hd1 : p * s - q * r = 1 := by
    have : odet (y * fα _ g') (y * fβ _ g') = odet (x * fα _ g) (x * fβ _ g) := by
      rw [hn, hn']; linarith
    rw [this] at e
    have := mul_right_cancel₀ hne (e.symm.trans (one_mul _).symm)
    exact this
  have hsub := hf.subst hd1
  rw [← h1, ← h2] at hsub
  have hne' : odet (y * fα _ g') (y * fβ _ g') ≠ 0 := by
    rw [hn']; exact mul_ne_zero (Binary.norm_ne_zero hy) (a_ne_zero_of_disc hg')
  exact (Binary.sLEquiv_iff _ _).mpr ⟨p, q, r, s, hd1, hsub.unique hf' hne'⟩

/-! ### The correspondence (Ch. 15, §3.4, p. 365) -/

/-- **Forms of determinant $d$**, the book's $a^{b}c$ with $ac - b^2 = d$ (all properly primitive,
`isPrimitive_toBinQF`), with proper equivalence ((4), p. 356) as a setoid. -/
def properSetoid (d : ℤ) : Setoid {f : Binary.BinForm // f.det = d} where
  r f g := Binary.ProperEquiv f.1 g.1
  iseqv := ⟨fun f => Binary.ProperEquiv.refl f.1, Binary.ProperEquiv.symm, Binary.ProperEquiv.trans⟩

/-- **Properly equivalent iff the same normed ideal class** (Ch. 15, §3.4, p. 365): for forms $f$, $g$ of
determinant $d$, $f \sim g$ properly iff $\langle a, -b+\sqrt{-d}\rangle_a$ and $\langle a', -b'+\sqrt{-d}\rangle_{a'}$
are in the same normed ideal class. -/
@[kb "conwaysloane1999" "Ch. 15, §3.4, p. 365"]
theorem formClass_eq_iff {f g : Binary.BinForm} (hf : f.det = d) (hg : g.det = d) :
    Binary.ProperEquiv f g ↔
      ((formNormed f hf : NormedIdeal d) : NormedClassGroup d) = (formNormed g hg : NormedClassGroup d) := by
  rw [Con.eq, formNormed_eq_ofForm, formNormed_eq_ofForm, properEquiv_iff_sLEquiv]
  exact ⟨classCon_ofForm_of_sLEquiv _ _, sLEquiv_of_classCon _ _⟩

/-- **The class map** $[f] \mapsto [\langle a, -b+\sqrt{-d}\rangle_a]$ on proper classes of forms of determinant $d$. -/
noncomputable def formClass (d : ℤ) [SquarefreeDet d] :
    Quotient (properSetoid d) → NormedClassGroup d :=
  Quotient.lift (fun f => ((formNormed f.1 f.2 : NormedIdeal d) : NormedClassGroup d))
    fun f g h => (formClass_eq_iff f.2 g.2).mp h

/-- **Every normed ideal class comes from a form of determinant $d$** (Ch. 15, §3.4, p. 365). A form of
discriminant $-4d$ has even middle coefficient, so it is $(a, 2b, c)$ for the book's $a^{b}c$ of determinant $d$. -/
@[kb "conwaysloane1999" "Ch. 15, §3.4, p. 365"]
theorem formClass_surjective : Function.Surjective (formClass d) := by
  intro x
  induction x using Con.induction_on with
  | H I =>
    obtain ⟨g, hg, h⟩ := exists_classCon_ofForm I
    have hb : (2 : ℤ) ∣ g.b := by
      have : g.b ^ 2 - 4 * g.a * g.c = 4 * -d := hg
      rcases Int.even_or_odd g.b with ⟨k, hk⟩ | ⟨k, hk⟩
      · exact ⟨k, by omega⟩
      · exfalso
        have e : 4 * (k * k + k - g.a * g.c + d) + 1 = 0 := by rw [hk] at this; linear_combination this
        generalize k * k + k - g.a * g.c + d = t at e
        omega
    obtain ⟨k, hk⟩ := hb
    let f : Binary.BinForm := ⟨g.a, k, g.c⟩
    have hfg : toBinQF f = g := BinQF.ext_abc (by simp [f]) (by simp [f, hk]) (by simp [f])
    have hf : f.det = d := by
      have : g.b ^ 2 - 4 * g.a * g.c = 4 * -d := hg
      simp only [Binary.BinForm.det, f]
      rw [hk] at this; linarith
    refine ⟨Quotient.mk _ ⟨f, hf⟩, ?_⟩
    change ((formNormed f hf : NormedIdeal d) : NormedClassGroup d) = I
    rw [formNormed_eq_ofForm, Con.eq]
    have : ofForm (toBinQF f) (by rw [disc_toBinQF, hf]) = ofForm g hg := by
      refine NormedIdeal.ext ?_ ?_
      · show formIdeal _ (toBinQF f) = formIdeal _ g; rw [hfg]
      · show (toBinQF f).a = g.a; rw [hfg]
    rw [this]
    exact (NormedIdeal.classCon d).symm h

/-- **Proper classes of forms of determinant $d$ $\simeq$ normed ideal classes** (Ch. 15, §3.4, p. 365): for $-d$
squarefree and $\not\equiv 1 \pmod 4$, $[f] \mapsto [\langle a, -b+\sqrt{-d}\rangle_a]$ is a bijection from the proper
equivalence classes of (properly primitive) forms $ax^2 + 2bxy + cy^2$ of determinant $d$ onto the normed ideal class
group. Both definite ($d > 0$; positive and negative definite forms) and indefinite ($d < 0$) forms are covered. -/
@[kb "conwaysloane1999" "Ch. 15, §3.4, p. 365"]
noncomputable def formClassEquiv (d : ℤ) [SquarefreeDet d] : Quotient (properSetoid d) ≃ NormedClassGroup d :=
  Equiv.ofBijective (formClass d)
    ⟨fun x y => Quotient.inductionOn₂ x y fun f g h => Quotient.sound ((formClass_eq_iff f.2 g.2).mpr h),
      formClass_surjective⟩

/-! ### The example of p. 365: determinant $-7$ -/

section Det7

open scoped Pointwise

attribute [local simp] QuadFormsKB.Binary.qa QuadFormsKB.Binary.qb

/-- $d = -7$ satisfies the book's hypothesis: $7$ is squarefree and $7 \equiv 3 \pmod 4$. -/
instance squarefreeDet_neg_seven : SquarefreeDet (-7) :=
  ⟨by rw [neg_neg]; exact (Int.prime_iff_natAbs_prime.mpr (by norm_num)).irreducible.squarefree, by decide⟩

/-- **The square of $\langle 3, -2+\sqrt 7\rangle_3$ is $\langle 9, -5+\sqrt 7\rangle_9$** (Ch. 15, §3.4, p. 365, the
worked example of (13)): for the forms $3^{2}(-1) = \begin{pmatrix}3&2\\2&-1\end{pmatrix}$ and
$9^{5}2 = \begin{pmatrix}9&5\\5&2\end{pmatrix}$ of determinant $-7$, the normed ideal of the first squared by (13)
is the normed ideal of the second: the ideal part is generated by $9$, $-6+3\sqrt7$, $11-4\sqrt7$, which give
$-5+\sqrt 7 = 3(-6+3\sqrt7) + 2(11-4\sqrt7) - 9$, and the norm part is $3 \cdot 3 = 9$. (The ideal part alone, in
Mathlib's `Zsqrtd 7`, is `Binary.det7_ideal_square`.) -/
@[kb "conwaysloane1999" "Ch. 15, §3.4, (13), p. 365"]
theorem det7_normed_square :
    formNormed (d := -7) ⟨3, 2, -1⟩ (by decide) ^ 2 = formNormed (d := -7) ⟨9, 5, 2⟩ (by decide) := by
  refine NormedIdeal.ext ?_ (by simp [pow_two, formNormed])
  rw [pow_two, NormedIdeal.mul_ideal]
  simp only [formNormed, bookIdeal]
  rw [Ideal.span_mul_span]
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro x ⟨y, hy, z, hz, rfl⟩
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hy hz
    rcases hy with rfl | rfl <;> rcases hz with rfl | rfl
    · exact Ideal.mem_span_pair.2 ⟨1, 0, by ext <;> simp⟩
    · exact Ideal.mem_span_pair.2 ⟨1, 3, by ext <;> simp⟩
    · exact Ideal.mem_span_pair.2 ⟨1, 3, by ext <;> simp⟩
    · exact Ideal.mem_span_pair.2 ⟨-1, -4, by ext <;> simp⟩
  · rw [Ideal.span_le]
    set S : Set (SqrtRing (-7)) := {((3 : ℤ) : SqrtRing (-7)), ⟨-2, 1⟩} with hS
    have g1 : (((9 : ℤ)) : SqrtRing (-7)) ∈ Ideal.span (S * S) :=
      Ideal.subset_span ⟨((3 : ℤ) : SqrtRing (-7)), by simp [hS], ((3 : ℤ) : SqrtRing (-7)), by simp [hS],
        by ext <;> simp⟩
    have g2 : (⟨-6, 3⟩ : SqrtRing (-7)) ∈ Ideal.span (S * S) :=
      Ideal.subset_span ⟨((3 : ℤ) : SqrtRing (-7)), by simp [hS], ⟨-2, 1⟩, by simp [hS], by ext <;> simp⟩
    have g3 : (⟨11, -4⟩ : SqrtRing (-7)) ∈ Ideal.span (S * S) :=
      Ideal.subset_span ⟨⟨-2, 1⟩, by simp [hS], ⟨-2, 1⟩, by simp [hS], by ext <;> simp⟩
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact g1
    · have : (⟨-5, 1⟩ : SqrtRing (-7)) = 3 * ⟨-6, 3⟩ + 2 * ⟨11, -4⟩ - ((9 : ℤ) : SqrtRing (-7)) := by
        ext <;> simp
      rw [SetLike.mem_coe, this]
      exact Ideal.sub_mem _ (Ideal.add_mem _ (Ideal.mul_mem_left _ _ g2) (Ideal.mul_mem_left _ _ g3)) g1

end Det7

end QuadFormsKB.ConwaySloane
