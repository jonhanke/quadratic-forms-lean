/-
# Conway–Sloane, Ch. 15, §9.5–9.6: gluing $E \perp \langle 2c\rangle$ to an even unimodular lattice over $\mathbb Z_2$

J. H. Conway and N. J. A. Sloane, *Sphere Packings, Lattices and Groups*, 3rd ed., Ch. 15, §9.5–9.6, pp. 391–393
(`conwaysloane1999`).

**Setting.** $A = E \perp \langle 2c\rangle$ an integer Gram matrix of size $n + 1$ (last row and column zero except
$A_{nn} = 2c$), with $E$ even unimodular at a prime $v \mid 2$ and $c$ a $2$-adic unit; $S$ an integral matrix with
$S^{\mathsf T}AS = A$ and $\det S = 1$ (a proper integral automorph of $L = \mathbb Z_2^{n+1}$).

**Proves**
* `congr_last_col`: $Se_n \equiv e_n \pmod 2$. (The discriminant group $L^\#/L$ has order $2$, generated by $e_n/2$,
  so every automorph fixes it; in coordinates: $(AS e_n)_j = 2c\,(S^{-1})_{nj}$ gives $Se_n \equiv 0$ off the last
  coordinate, and $Q(Se_n) = Q(e_n)$ forces the last coordinate to be odd.)
* `exists_sq_valued_wallDet_glue`: the Wall determinants $\det(P^{\mathsf T}AR)$ of $S$ have square valuation. *Proof:*
  glue $L$ to $\langle -2c\rangle$: in $L \perp \langle -2c\rangle$ with basis $e_0, \dots, e_n, f$, the lattice $K$ with
  basis $e_0, \dots, e_n, (e_n + f)/2$ is even unimodular (Gram matrix `glueA`), and $S \oplus 1$ preserves $K$
  because $Se_n \equiv e_n \pmod 2$; its matrix in the new basis is `glueS`. A Wall frame $(P, R)$ of $S$ padded with
  a zero row is a Wall frame of `glueS` with the same Gram matrix, so the core lemma
  (`EvenUnimodular.exists_sq_valued_wallDet`) applies.
-/
import QuadFormsKB.Literature.ConwaySloane.Section9EvenUnimodular

open Matrix IsDedekindDomain NumberField WithZero

set_option linter.unusedSectionVars false

noncomputable section

namespace QuadFormsKB.ConwaySloane.Glue

open Wall EvenUnimodular

variable {v : HeightOneSpectrum (𝓞 ℚ)}

local notation "Fv" => v.adicCompletion ℚ

theorem le_exp_neg_one_of_lt_one' {x : ℤᵐ⁰} (h : x < 1) : x ≤ exp (-1 : ℤ) := by
  rcases eq_or_ne x 0 with rfl | hx
  · exact zero_le'
  · obtain ⟨k, rfl⟩ : ∃ k : ℤ, x = exp k := ⟨log x, (exp_log hx).symm⟩
    rw [← exp_zero, exp_lt_exp] at h
    rw [exp_le_exp]
    omega

/-- Integral matrices have integral adjugates. -/
theorem adjugate_integral {m : ℕ} (M : Matrix (Fin m) (Fin m) Fv) (hM : ∀ i j, Valued.v (M i j) ≤ 1) :
    ∀ i j, Valued.v (M.adjugate i j) ≤ 1 := by
  intro i j
  rw [adjugate_apply]
  refine valued_det_le_one _ fun k l => ?_
  rw [updateRow_apply]
  split_ifs
  · simp only [Pi.single_apply]; split_ifs <;> simp
  · exact hM k l

/-- The inverse of an integral matrix with unit determinant is integral. -/
theorem inv_integral {m : ℕ} (M : Matrix (Fin m) (Fin m) Fv) (hM : ∀ i j, Valued.v (M i j) ≤ 1)
    (hdet : Valued.v M.det = 1) : ∀ i j, Valued.v (M⁻¹ i j) ≤ 1 := by
  intro i j
  rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
  refine valued_mul_le_one ?_ (adjugate_integral M hM i j)
  rw [map_inv₀, hdet, inv_one]

section Congr

variable {n : ℕ} (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℤ) (c : ℤ)

/-- **$Se_n \equiv e_n \pmod 2$** for a proper integral automorph $S$ of $E \perp \langle 2c\rangle$ over
$\mathbb Z_2$. -/
theorem congr_last_col (hA : Aᵀ = A) (hlast : ∀ i, i ≠ Fin.last n → A i (Fin.last n) = 0)
    (hll : A (Fin.last n) (Fin.last n) = 2 * c) (hc : Valued.v ((c : ℤ) : Fv) = 1)
    (hE : Valued.v (((A.submatrix Fin.castSucc Fin.castSucc).det : ℤ) : Fv) = 1)
    (heven : ∀ i, Even (A i i)) (hv2 : Valued.v (2 : Fv) = exp (-1 : ℤ))
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) Fv) (hS : ∀ i j, Valued.v (S i j) ≤ 1)
    (hSA : Sᵀ * A.map (Int.cast : ℤ → Fv) * S = A.map (Int.cast : ℤ → Fv)) (hdet : S.det = 1) :
    ∀ i, Valued.v ((S i (Fin.last n) - if i = Fin.last n then 1 else 0) / 2) ≤ 1 := by
  classical
  set l := Fin.last n
  set Af := A.map (Int.cast : ℤ → Fv)
  set E := A.submatrix Fin.castSucc Fin.castSucc
  set Ef := E.map (Int.cast : ℤ → Fv)
  have hEsym : Eᵀ = E := by
    ext i j; simp only [E, transpose_apply, submatrix_apply]; exact (congrFun (congrFun hA j.castSucc) i.castSucc).symm
  have hEeven : ∀ i, Even (E i i) := fun i => heven _
  have hsymA : ∀ i j, A j i = A i j := fun i j => congrFun (congrFun hA i) j
  have hAl : ∀ k, A l k = if k = l then 2 * c else 0 := by
    intro k
    split_ifs with h
    · rw [h, hll]
    · rw [hsymA]; exact hlast k h
  set s : Fin (n + 1) → Fv := fun k => S k l
  set Sinv := S.adjugate
  have hSinv : ∀ i j, Valued.v (Sinv i j) ≤ 1 := adjugate_integral S hS
  have hSSinv : S * Sinv = 1 := by rw [mul_adjugate, hdet, one_smul]
  -- Step 1: `(A s)_j = 2c (S⁻¹)_{l j}`
  have hstep1 : ∀ j, (Af *ᵥ s) j = 2 * (c : Fv) * Sinv l j := by
    intro j
    have h1 : Sᵀ * Af = Af * Sinv := by
      calc Sᵀ * Af = Sᵀ * Af * (S * Sinv) := by rw [hSSinv, Matrix.mul_one]
        _ = Af * Sinv := by rw [← Matrix.mul_assoc, hSA]
    have h2 := congrFun (congrFun h1 l) j
    simp only [Matrix.mul_apply, transpose_apply] at h2
    have h3 : ∑ k, Af l k * Sinv k j = 2 * (c : Fv) * Sinv l j := by
      rw [Finset.sum_eq_single l]
      · simp [Af, hll]
      · intro k _ hk; simp [Af, hAl k, hk]
      · simp
    rw [← h3, ← h2]
    simp only [mulVec, dotProduct, s, Af, map_apply]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [hsymA]; ring
  -- Step 2: `E s' = 2c (S⁻¹)_{l,·}` on the first `n` coordinates
  set s' : Fin n → Fv := fun k => s k.castSucc
  have hstep2 : ∀ j : Fin n, (Ef *ᵥ s') j = 2 * (c : Fv) * Sinv l j.castSucc := by
    intro j
    rw [← hstep1]
    simp only [mulVec, dotProduct, Fin.sum_univ_castSucc, s', Ef, E, Af, map_apply, submatrix_apply]
    rw [hlast _ (Fin.castSucc_lt_last j).ne]
    simp
  -- Step 3: `s' = 2t` with `t` integral
  have hEdet : Ef.det = ((E.det : ℤ) : Fv) := by
    have := RingHom.map_det (Int.castRingHom Fv) E
    rw [RingHom.mapMatrix_apply] at this
    exact this.symm
  have hEf : ∀ i j, Valued.v (Ef i j) ≤ 1 := fun i j => valued_intCast_le_one _
  have hEinv := inv_integral Ef hEf (by rw [hEdet]; exact hE)
  have hEunit : IsUnit Ef.det := isUnit_iff_ne_zero.mpr (by
    intro h0; rw [hEdet] at h0; rw [h0, map_zero] at hE; exact zero_ne_one hE)
  set t : Fin n → Fv := fun k => (c : Fv) * (Ef⁻¹ *ᵥ fun j => Sinv l j.castSucc) k
  have ht : ∀ k, Valued.v (t k) ≤ 1 := fun k =>
    valued_mul_le_one (valued_intCast_le_one _) (mulVec_integral _ _ hEinv (fun j => hSinv _ _) k)
  have hs't : s' = (2 : Fv) • t := by
    have e1 : Ef *ᵥ s' = (2 * (c : Fv)) • fun j : Fin n => Sinv l j.castSucc := by
      ext j; rw [hstep2]; rfl
    have e2 : s' = Ef⁻¹ *ᵥ (Ef *ᵥ s') := by
      rw [mulVec_mulVec, Matrix.nonsing_inv_mul _ hEunit, one_mulVec]
    rw [e2, e1, mulVec_smul]
    ext k
    simp only [t, Pi.smul_apply, smul_eq_mul]
    ring
  -- Step 4: `Q(s) = 2c` gives `v(s_l² - 1) ≤ exp(-2)`
  have hQs : s ⬝ᵥ (Af *ᵥ s) = 2 * (c : Fv) := by
    have := congrFun (congrFun hSA l) l
    simp only [Matrix.mul_apply, transpose_apply] at this
    rw [show (2 * (c : Fv)) = Af l l by simp [Af, hll]]
    rw [← this]
    simp only [dotProduct, mulVec, s, Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
    ring
  have hAs_l : (Af *ᵥ s) l = 2 * (c : Fv) * s l := by
    simp only [mulVec, dotProduct, Af, map_apply]
    rw [Finset.sum_eq_single l]
    · simp [hll]
    · intro k _ hk; simp [hAl k, hk]
    · simp
  have hsplit : s ⬝ᵥ (Af *ᵥ s) = s' ⬝ᵥ (Ef *ᵥ s') + s l * (2 * (c : Fv) * s l) := by
    rw [dotProduct, Fin.sum_univ_castSucc, hAs_l]
    congr 1
    simp only [dotProduct, s']
    refine Finset.sum_congr rfl fun j _ => ?_
    congr 1
    simp only [mulVec, dotProduct, Fin.sum_univ_castSucc, Ef, E, Af, map_apply, submatrix_apply]
    rw [hlast _ (Fin.castSucc_lt_last j).ne]
    simp
  have hc0 : (c : Fv) ≠ 0 := by intro h0; rw [h0, map_zero] at hc; exact zero_ne_one hc
  have hhalf := valued_half_quad_le_one (v := v) E hEsym hEeven t ht
  set h := (t ⬝ᵥ (Ef *ᵥ t)) / 2
  have hsl2 : s l ^ 2 - 1 = -(4 * h) / (c : Fv) := by
    have e := hQs
    rw [hsplit, hs't, mulVec_smul, smul_dotProduct, dotProduct_smul] at e
    simp only [smul_eq_mul] at e
    field_simp
    simp only [h]
    linear_combination e / 2
  have hv4 : Valued.v (s l ^ 2 - 1) ≤ exp (-2 : ℤ) := by
    rw [hsl2, map_div₀, hc, div_one, Valuation.map_neg, map_mul]
    have : Valued.v (4 : Fv) = exp (-2 : ℤ) := by
      rw [show (4 : Fv) = 2 * 2 by norm_num, map_mul, hv2, ← exp_add]; norm_num
    rw [this]
    exact mul_le_of_le_one_right' hhalf
  -- Step 5: `s_l ≡ 1 (mod 2)`
  have hsl1 : Valued.v (s l - 1) ≤ exp (-1 : ℤ) := by
    by_contra hgt
    have hle : Valued.v (s l - 1) ≤ 1 :=
      le_trans (Valuation.map_sub _ _ _) (max_le (hS l l) (by simp))
    have h1 : Valued.v (s l - 1) = 1 := by
      by_contra hne; exact hgt (le_exp_neg_one_of_lt_one' (lt_of_le_of_ne hle hne))
    have h2 : Valued.v (s l + 1) = 1 := by
      have e : s l + 1 = (s l - 1) + 2 := by ring
      rw [e, Valuation.map_add_eq_of_lt_left _ (by rw [h1, hv2, ← exp_zero, exp_lt_exp]; norm_num), h1]
    have h3 : Valued.v (s l ^ 2 - 1) = 1 := by
      rw [show s l ^ 2 - 1 = (s l - 1) * (s l + 1) by ring, map_mul, h1, h2, one_mul]
    rw [h3, ← exp_zero, exp_le_exp] at hv4
    norm_num at hv4
  -- conclusion
  intro i
  have h2ne : (2 : Fv) ≠ 0 := two_ne_zero
  have hv2inv : Valued.v ((2 : Fv)⁻¹) = exp (1 : ℤ) := by rw [map_inv₀, hv2, ← WithZero.exp_neg]; norm_num
  induction i using Fin.lastCases with
  | last =>
    rw [if_pos rfl, div_eq_mul_inv, map_mul, hv2inv]
    calc Valued.v (S l l - 1) * exp (1 : ℤ) ≤ exp (-1 : ℤ) * exp (1 : ℤ) := mul_le_mul' hsl1 le_rfl
      _ = 1 := by rw [← exp_add]; norm_num
  | cast i =>
    rw [ite_eq_right_iff.mpr (fun h => absurd h (Fin.castSucc_lt_last i).ne), sub_zero]
    have : S i.castSucc l = 2 * t i := by
      have := congrFun hs't i
      simpa [s'] using this
    rw [this, mul_div_cancel_left₀ _ h2ne]
    exact ht i

end Congr

/-! ### The glued lattice -/

section GlueLattice

variable {n : ℕ}

/-- The column with entry $c$ in the last row. -/
def lastCol {R : Type*} [Zero R] (c : R) : Matrix (Fin (n + 1)) (Fin 1) R :=
  Matrix.of fun i _ => if i = Fin.last n then c else 0

/-- The Gram matrix of the glued lattice $K$ (basis $e_0, \dots, e_n, (e_n + f)/2$ of
$L \perp \langle -2c\rangle$). -/
def glueA (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℤ) (c : ℤ) :
    Matrix (Fin (n + 1) ⊕ Fin 1) (Fin (n + 1) ⊕ Fin 1) ℤ :=
  fromBlocks A (lastCol c) (lastCol c)ᵀ 0

/-- The change of basis from $K$ to $L \perp \langle -2c\rangle$. -/
def gam : Matrix (Fin (n + 1) ⊕ Fin 1) (Fin (n + 1) ⊕ Fin 1) Fv :=
  fromBlocks 1 (lastCol (1 / 2 : Fv)) 0 (Matrix.of fun _ _ => (1 / 2 : Fv))

/-- Its inverse. -/
def gamInv : Matrix (Fin (n + 1) ⊕ Fin 1) (Fin (n + 1) ⊕ Fin 1) Fv :=
  fromBlocks 1 (lastCol (-1 : Fv)) 0 (Matrix.of fun _ _ => (2 : Fv))

/-- The Gram matrix of $L \perp \langle -2c\rangle$. -/
def tildeA (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℤ) (c : ℤ) :
    Matrix (Fin (n + 1) ⊕ Fin 1) (Fin (n + 1) ⊕ Fin 1) Fv :=
  fromBlocks (A.map (Int.cast : ℤ → Fv)) 0 0 (Matrix.of fun _ _ => -(2 * (c : Fv)))

/-- $S \oplus 1$. -/
def tildeS (S : Matrix (Fin (n + 1)) (Fin (n + 1)) Fv) : Matrix (Fin (n + 1) ⊕ Fin 1) (Fin (n + 1) ⊕ Fin 1) Fv :=
  fromBlocks S 0 0 1

/-- The matrix of $S \oplus 1$ in the basis of $K$. -/
def glueS (S : Matrix (Fin (n + 1)) (Fin (n + 1)) Fv) :
    Matrix (Fin (n + 1) ⊕ Fin 1) (Fin (n + 1) ⊕ Fin 1) Fv :=
  fromBlocks S (Matrix.of fun i _ => (S i (Fin.last n) - if i = Fin.last n then 1 else 0) / 2) 0 1

theorem gam_mul_gamInv : (gam (v := v) (n := n)) * gamInv = 1 := by
  ext a b
  rcases a with i | i <;> rcases b with j | j <;> simp only [gam, gamInv] <;>
    simp only [Matrix.mul_apply, Fintype.sum_sum_type, fromBlocks_apply₁₁, fromBlocks_apply₁₂,
      fromBlocks_apply₂₁, fromBlocks_apply₂₂, lastCol, Matrix.of_apply, Matrix.one_apply, Matrix.zero_apply,
      mul_ite, ite_mul, mul_zero, zero_mul, mul_one, one_mul, Finset.sum_ite_eq', Finset.sum_ite_eq, Finset.mem_univ, if_true,
      Finset.sum_const_zero, add_zero, zero_add, Finset.univ_unique, Finset.sum_singleton, Fin.fin_one_eq_zero,
      Sum.inl.injEq, Sum.inr.injEq, reduceCtorEq, if_false]
  all_goals (try split_ifs)
  all_goals (first | rfl | ring | norm_num)

theorem gamInv_mul_gam : (gamInv (v := v) (n := n)) * gam = 1 := by
  ext a b
  rcases a with i | i <;> rcases b with j | j <;> simp only [gam, gamInv] <;>
    simp only [Matrix.mul_apply, Fintype.sum_sum_type, fromBlocks_apply₁₁, fromBlocks_apply₁₂,
      fromBlocks_apply₂₁, fromBlocks_apply₂₂, lastCol, Matrix.of_apply, Matrix.one_apply, Matrix.zero_apply,
      mul_ite, ite_mul, mul_zero, zero_mul, mul_one, one_mul, Finset.sum_ite_eq', Finset.sum_ite_eq, Finset.mem_univ, if_true,
      Finset.sum_const_zero, add_zero, zero_add, Finset.univ_unique, Finset.sum_singleton, Fin.fin_one_eq_zero,
      Sum.inl.injEq, Sum.inr.injEq, reduceCtorEq, if_false]
  all_goals (try split_ifs)
  all_goals (first | rfl | ring | norm_num)

theorem glueS_eq (S : Matrix (Fin (n + 1)) (Fin (n + 1)) Fv) : gamInv * tildeS S * gam = glueS S := by
  ext a b
  rcases a with i | i <;> rcases b with j | j <;> simp only [gam, gamInv, tildeS, glueS] <;>
    simp only [Matrix.mul_apply, Fintype.sum_sum_type, fromBlocks_apply₁₁, fromBlocks_apply₁₂,
      fromBlocks_apply₂₁, fromBlocks_apply₂₂, lastCol, Matrix.of_apply, Matrix.one_apply, Matrix.zero_apply,
      mul_ite, ite_mul, mul_zero, zero_mul, mul_one, one_mul, Finset.sum_ite_eq', Finset.sum_ite_eq, Finset.mem_univ, if_true,
      Finset.sum_const_zero, add_zero, zero_add, Finset.univ_unique, Finset.sum_singleton, Fin.fin_one_eq_zero,
      Sum.inl.injEq, Sum.inr.injEq, reduceCtorEq, if_false]
  all_goals (try split_ifs)
  all_goals (first | rfl | ring | norm_num)

end GlueLattice

section GlueAlgebra

variable {n : ℕ} (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℤ) (c : ℤ)

theorem glueA_eq (hA : Aᵀ = A) (hlast : ∀ i, i ≠ Fin.last n → A i (Fin.last n) = 0)
    (hll : A (Fin.last n) (Fin.last n) = 2 * c) :
    gamᵀ * tildeA A c * gam = (glueA A c).map (Int.cast : ℤ → Fv) := by
  have hsymA : ∀ i j, A j i = A i j := fun i j => congrFun (congrFun hA i) j
  have hlast' : ∀ j, j ≠ Fin.last n → A (Fin.last n) j = 0 := fun j hj => by rw [hsymA]; exact hlast j hj
  ext a b
  rcases a with i | i <;> rcases b with j | j <;> simp only [gam, tildeA, glueA] <;>
    simp only [Matrix.mul_apply, Fintype.sum_sum_type, fromBlocks_apply₁₁, fromBlocks_apply₁₂,
      fromBlocks_apply₂₁, fromBlocks_apply₂₂, lastCol, Matrix.of_apply, Matrix.one_apply, Matrix.zero_apply,
      mul_ite, ite_mul, mul_zero, zero_mul, mul_one, one_mul, Finset.sum_ite_eq', Finset.sum_ite_eq, Finset.mem_univ, if_true,
      Finset.sum_const_zero, add_zero, zero_add, Finset.univ_unique, Finset.sum_singleton, Fin.fin_one_eq_zero,
      Sum.inl.injEq, Sum.inr.injEq, reduceCtorEq, if_false, transpose_apply, Matrix.map_apply]
  all_goals (try split_ifs)
  all_goals (try subst_vars)
  all_goals (try rw [hll])
  all_goals (try rw [hlast _ (by assumption)])
  all_goals (try rw [hlast' _ (by assumption)])
  all_goals (first | rfl | (push_cast; ring) | norm_num | simp)

theorem tildeS_orth (S : Matrix (Fin (n + 1)) (Fin (n + 1)) Fv)
    (hSA : Sᵀ * A.map (Int.cast : ℤ → Fv) * S = A.map (Int.cast : ℤ → Fv)) :
    (tildeS S)ᵀ * tildeA A c * tildeS S = tildeA A c := by
  rw [tildeS, tildeA, fromBlocks_transpose, fromBlocks_multiply, fromBlocks_multiply]
  simp only [Matrix.mul_zero, Matrix.zero_mul, add_zero, zero_add, transpose_zero, transpose_one,
    Matrix.one_mul, Matrix.mul_one, hSA]

theorem glueS_orth (hA : Aᵀ = A) (hlast : ∀ i, i ≠ Fin.last n → A i (Fin.last n) = 0)
    (hll : A (Fin.last n) (Fin.last n) = 2 * c) (S : Matrix (Fin (n + 1)) (Fin (n + 1)) Fv)
    (hSA : Sᵀ * A.map (Int.cast : ℤ → Fv) * S = A.map (Int.cast : ℤ → Fv)) :
    (glueS S)ᵀ * (glueA A c).map (Int.cast : ℤ → Fv) * glueS S = (glueA A c).map (Int.cast : ℤ → Fv) := by
  rw [← glueS_eq, ← glueA_eq A c hA hlast hll]
  have h1 : (gamInv (v := v) (n := n))ᵀ * gamᵀ = 1 := by
    rw [← transpose_mul, gam_mul_gamInv, transpose_one]
  have h2 : (gam (v := v) (n := n)) * gamInv = 1 := gam_mul_gamInv
  calc (gamInv * tildeS S * gam)ᵀ * (gamᵀ * tildeA A c * gam) * (gamInv * tildeS S * gam)
      = gamᵀ * (tildeS S)ᵀ * (gamInvᵀ * gamᵀ) * tildeA A c * (gam * gamInv) * tildeS S * gam := by
        simp only [transpose_mul, Matrix.mul_assoc]
    _ = gamᵀ * ((tildeS S)ᵀ * tildeA A c * tildeS S) * gam := by
        rw [h1, h2]; simp only [Matrix.mul_one, Matrix.mul_assoc]
    _ = gamᵀ * tildeA A c * gam := by rw [tildeS_orth A c S hSA]

end GlueAlgebra

section GlueFinal

variable {n : ℕ} (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℤ) (c : ℤ)

/-- $\det A = 2c\det E$ for $A = E \perp \langle 2c\rangle$. -/
theorem det_eq_two_c_mul (hlast : ∀ i, i ≠ Fin.last n → A i (Fin.last n) = 0)
    (hll : A (Fin.last n) (Fin.last n) = 2 * c) :
    A.det = 2 * c * (A.submatrix Fin.castSucc Fin.castSucc).det := by
  rw [det_succ_column A (Fin.last n), Fin.sum_univ_castSucc]
  simp only [hlast _ (Fin.castSucc_lt_last _).ne, mul_zero, zero_mul, Finset.sum_const_zero, zero_add, hll,
    Fin.succAbove_last]
  rw [show ((Fin.last n : Fin (n + 1)) : ℕ) + ((Fin.last n : Fin (n + 1)) : ℕ) = 2 * n by simp; ring, pow_mul]
  simp

theorem glueA_det_valued (hA : Aᵀ = A) (hlast : ∀ i, i ≠ Fin.last n → A i (Fin.last n) = 0)
    (hll : A (Fin.last n) (Fin.last n) = 2 * c) (hc : Valued.v ((c : ℤ) : Fv) = 1)
    (hE : Valued.v (((A.submatrix Fin.castSucc Fin.castSucc).det : ℤ) : Fv) = 1) :
    Valued.v (((glueA A c).det : ℤ) : Fv) = 1 := by
  have h1 : (((glueA A c).det : ℤ) : Fv) = ((glueA A c).map (Int.cast : ℤ → Fv)).det := by
    have := RingHom.map_det (Int.castRingHom Fv) (glueA A c)
    rw [RingHom.mapMatrix_apply] at this
    exact this
  have hgam : (gam (v := v) (n := n)).det = 1 / 2 := by
    rw [gam, det_fromBlocks_zero₂₁, det_one, one_mul, det_unique]; rfl
  have hd1 : (Matrix.of fun _ _ => -(2 * (c : Fv)) : Matrix (Fin 1) (Fin 1) Fv).det = -(2 * (c : Fv)) := by
    rw [det_unique]; rfl
  have htil : (tildeA (v := v) A c).det = ((A.det : ℤ) : Fv) * (-(2 * (c : Fv))) := by
    rw [tildeA, det_fromBlocks_zero₂₁, hd1]
    congr 1
    have := RingHom.map_det (Int.castRingHom Fv) A
    rw [RingHom.mapMatrix_apply] at this
    exact this.symm
  rw [h1, ← glueA_eq A c hA hlast hll, det_mul, det_mul, det_transpose, hgam, htil,
    det_eq_two_c_mul A c hlast hll]
  simp only [Int.cast_mul, Int.cast_ofNat]
  have e : (1 / 2 : Fv) * (((2 : Fv) * c * ((A.submatrix Fin.castSucc Fin.castSucc).det : Fv)) *
      -(2 * (c : Fv))) * (1 / 2) = -((c : Fv) * c * ((A.submatrix Fin.castSucc Fin.castSucc).det : Fv)) := by
    ring
  rw [e, Valuation.map_neg, map_mul, map_mul, hc, hE, one_mul, one_mul]

/-- The padded frame matrix. -/
def padM {m : ℕ} (P : Matrix (Fin (n + 1)) (Fin m) Fv) : Matrix (Fin (n + 1) ⊕ Fin 1) (Fin m) Fv :=
  Matrix.of fun a j => Sum.elim (fun i => P i j) (fun _ => 0) a

/-- The reindexing $\mathrm{Fin}(n+1) \oplus \mathrm{Fin}\,1 \simeq \mathrm{Fin}(n+2)$. -/
abbrev eGlue : Fin (n + 1) ⊕ Fin 1 ≃ Fin (n + 1 + 1) := finSumFinEquiv

theorem glue_frame (S : Matrix (Fin (n + 1)) (Fin (n + 1)) Fv) {m : ℕ} {P R : Matrix (Fin (n + 1)) (Fin m) Fv}
    (hf : IsWallFrame Fv S P R) :
    IsWallFrame Fv ((glueS S).submatrix eGlue.symm eGlue.symm) ((padM P).submatrix eGlue.symm id)
      ((padM R).submatrix eGlue.symm id) := by
  obtain ⟨hTR, hinj, hspan⟩ := hf
  have hone : (1 : Matrix (Fin (n + 1 + 1)) (Fin (n + 1 + 1)) Fv) - (glueS S).submatrix eGlue.symm eGlue.symm =
      (1 - glueS S).submatrix eGlue.symm eGlue.symm := by
    ext a b
    simp [Matrix.one_apply, Matrix.sub_apply, submatrix_apply, eGlue.symm.injective.eq_iff]
  have hpad : (1 - glueS S) * padM R = padM P := by
    ext a j
    rcases a with i | i
    · rw [← hTR]
      simp only [Matrix.mul_apply, Fintype.sum_sum_type, padM, Matrix.of_apply, Sum.elim_inl, Sum.elim_inr,
        mul_zero, Finset.sum_const_zero, add_zero, Matrix.sub_apply, glueS, fromBlocks_apply₁₁,
        Matrix.one_apply, Sum.inl.injEq]
    · simp only [Matrix.mul_apply, Fintype.sum_sum_type, padM, Matrix.of_apply, Sum.elim_inl, Sum.elim_inr,
        mul_zero, Finset.sum_const_zero, add_zero, Matrix.sub_apply, glueS, fromBlocks_apply₂₁,
        Matrix.one_apply, Matrix.zero_apply, reduceCtorEq, if_false, sub_zero, zero_mul, sub_self]
  have hPv : ∀ (c : Fin m → Fv) k, ((padM P).submatrix eGlue.symm id *ᵥ c) k = (padM P *ᵥ c) (eGlue.symm k) :=
    fun c k => rfl
  refine ⟨?_, ?_, ?_⟩
  · rw [hone, submatrix_mul_equiv, hpad]
  · intro c hc
    apply hinj c
    funext i
    have := congrFun hc (eGlue (Sum.inl i))
    rw [hPv, Equiv.symm_apply_apply] at this
    simpa [padM, mulVec, dotProduct] using this
  · intro z
    set x : Fin (n + 1) → Fv := fun i => z (eGlue (Sum.inl i))
    set t : Fv := z (eGlue (Sum.inr 0))
    obtain ⟨c, hc⟩ := hspan (x + (t / 2) • Pi.single (Fin.last n) 1)
    refine ⟨c, ?_⟩
    rw [hone, submatrix_mulVec_equiv]
    funext k
    rw [hPv]
    obtain ⟨a, rfl⟩ := eGlue.surjective k
    simp only [Function.comp_apply, Equiv.symm_apply_apply]
    rcases a with i | i
    · have h1 := congrFun hc i
      simp only [padM, mulVec, dotProduct, Matrix.of_apply, Sum.elim_inl] at h1 ⊢
      rw [← h1]
      simp only [Fintype.sum_sum_type, Matrix.sub_apply, glueS, fromBlocks_apply₁₁, fromBlocks_apply₁₂,
        Matrix.one_apply, Sum.inl.injEq, reduceCtorEq, if_false, Function.comp_apply, Equiv.symm_symm,
        Matrix.of_apply, Finset.univ_unique, Finset.sum_singleton, Fin.fin_one_eq_zero, zero_sub]
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, mul_add, Finset.sum_add_distrib, Pi.single_apply,
        mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, if_true, Matrix.sub_apply,
        Matrix.one_apply, x, t]
      split_ifs <;> ring
    · simp only [padM, mulVec, dotProduct, Matrix.of_apply, Sum.elim_inr, zero_mul, Finset.sum_const_zero,
        Fintype.sum_sum_type, Matrix.sub_apply, glueS, fromBlocks_apply₂₁, fromBlocks_apply₂₂, Matrix.one_apply,
        reduceCtorEq, if_false, Matrix.zero_apply, sub_zero, Finset.univ_unique, Finset.sum_singleton,
        Fin.fin_one_eq_zero, Sum.inr.injEq, if_true, sub_self, add_zero]

theorem glue_gram {m : ℕ} (P R : Matrix (Fin (n + 1)) (Fin m) Fv) :
    ((padM P).submatrix eGlue.symm id)ᵀ * ((glueA A c).submatrix eGlue.symm eGlue.symm).map (Int.cast : ℤ → Fv) *
      (padM R).submatrix eGlue.symm id = Pᵀ * A.map (Int.cast : ℤ → Fv) * R := by
  rw [transpose_submatrix, ← submatrix_map, submatrix_mul_equiv, submatrix_mul_equiv, submatrix_id_id]
  ext i j
  simp only [Matrix.mul_apply, Fintype.sum_sum_type, transpose_apply, padM, Matrix.of_apply, Sum.elim_inl,
    Sum.elim_inr, zero_mul, mul_zero, Finset.sum_const_zero, add_zero, Matrix.map_apply, glueA,
    fromBlocks_apply₁₁]

/-- **The glue lemma**: for $A = E \perp \langle 2c\rangle$ with $E$ even unimodular at $v \mid 2$ and $c$ a unit,
every Wall determinant $\det(P^{\mathsf T}AR)$ of a proper integral automorph has square valuation. -/
@[kb "conwaysloane1999" "Ch. 15, §9.5, p. 391 (2-adically automorphous numbers of E ⊥ ⟨2c⟩)"]
theorem exists_sq_valued_wallDet_glue (hA : Aᵀ = A) (hlast : ∀ i, i ≠ Fin.last n → A i (Fin.last n) = 0)
    (hll : A (Fin.last n) (Fin.last n) = 2 * c) (hc : Valued.v ((c : ℤ) : Fv) = 1)
    (hE : Valued.v (((A.submatrix Fin.castSucc Fin.castSucc).det : ℤ) : Fv) = 1)
    (heven : ∀ i, Even (A i i)) (hv2 : Valued.v (2 : Fv) = exp (-1 : ℤ))
    (S : Matrix (Fin (n + 1)) (Fin (n + 1)) Fv) (hS : ∀ i j, Valued.v (S i j) ≤ 1)
    (hSA : Sᵀ * A.map (Int.cast : ℤ → Fv) * S = A.map (Int.cast : ℤ → Fv)) (hdet : S.det = 1)
    {m : ℕ} {P R : Matrix (Fin (n + 1)) (Fin m) Fv} (hf : IsWallFrame Fv S P R) :
    ∃ γ : ℤᵐ⁰, Valued.v (Pᵀ * A.map (Int.cast : ℤ → Fv) * R).det = γ ^ 2 := by
  set A2 := (glueA A c).submatrix eGlue.symm eGlue.symm
  set S2 := (glueS S).submatrix eGlue.symm eGlue.symm
  have hA2 : A2ᵀ = A2 := by
    simp only [A2, transpose_submatrix, glueA, fromBlocks_transpose, hA, transpose_transpose, transpose_zero]
  have hdet2 : Valued.v ((A2.det : ℤ) : Fv) = 1 := by
    rw [det_submatrix_equiv_self]; exact glueA_det_valued A c hA hlast hll hc hE
  have heven2 : ∀ k, Even (A2 k k) := by
    intro k
    obtain ⟨a, rfl⟩ := eGlue.surjective k
    rcases a with i | i
    · simpa [A2, glueA] using heven i
    · simp [A2, glueA]
  have hcong := congr_last_col A c hA hlast hll hc hE heven hv2 S hS hSA hdet
  have hS2 : ∀ i j, Valued.v (S2 i j) ≤ 1 := by
    intro i j
    obtain ⟨a, rfl⟩ := eGlue.surjective i
    obtain ⟨b, rfl⟩ := eGlue.surjective j
    rcases a with i | i <;> rcases b with j | j <;> simp only [S2, glueS, submatrix_apply,
      Equiv.symm_apply_apply, fromBlocks_apply₁₁, fromBlocks_apply₁₂, fromBlocks_apply₂₁, fromBlocks_apply₂₂,
      Matrix.of_apply, Matrix.zero_apply, Matrix.one_apply]
    · exact hS i j
    · exact hcong i
    · simp
    · split_ifs <;> simp
  have hSA2 : S2ᵀ * A2.map (Int.cast : ℤ → Fv) * S2 = A2.map (Int.cast : ℤ → Fv) := by
    simp only [S2, A2, transpose_submatrix, ← submatrix_map, submatrix_mul_equiv,
      glueS_orth A c hA hlast hll S hSA]
  obtain ⟨γ, hγ⟩ := EvenUnimodular.exists_sq_valued_wallDet A2 hA2 hdet2 heven2 S2 hS2 hSA2 (glue_frame S hf)
  exact ⟨γ, by rw [← glue_gram A c P R]; exact hγ⟩

end GlueFinal

end QuadFormsKB.ConwaySloane.Glue
